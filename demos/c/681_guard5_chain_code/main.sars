@import "sa_std/io/print.sai"

@const OUT = utf8:"681\n"

// 681 - Guard chain of 5 steps, 600 + 81 == 681.
@hstep(fail: i64) -> i64:
L_ENTRY:
    bad = eq fail, 1
    br bad -> L_FAIL, L_SUCC
L_SUCC:
    !fail
    !bad
    return 0
L_FAIL:
    !fail
    !bad
    return 7

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    c0 = call @hstep(z)
    c1 = call @hstep(c0)
    c2 = call @hstep(c1)
    c3 = call @hstep(c2)
    c4 = call @hstep(c3)
    x = 600 as i64
    y = 81 as i64
    v = add x, y
    want = 681 as i64
    ok_v = eq v, want
    ok0 = eq c0, 0
    ok1 = eq c1, 0
    ok2 = eq c2, 0
    ok3 = eq c3, 0
    ok4 = eq c4, 0
    t0 = and ok_v, ok0
    t1 = and ok1, ok2
    t2 = and ok3, ok4
    t3 = and t0, t1
    ok = and t3, t2
    !z
    !c0
    !c1
    !c2
    !c3
    !c4
    !x
    !y
    !v
    !want
    !ok_v
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !t0
    !t1
    !t2
    !t3
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
