@import "sa_std/io/print.sai"

@const OUT = utf8:"570\n"

// 570 - Mem float pair: 1.5 and 2.5 spill and reload, sum == 4.0.
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    five = 5 as i32
    four_i = 4 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    five_f = sitofp five as f64
    four = sitofp four_i as f64
    one_half = fdiv three_f, two_f
    two_half = fdiv five_f, two_f
    buf = alloc 16
    store buf+0, one_half as f64
    store buf+8, two_half as f64
    a = load buf+0 as f64
    b = load buf+8 as f64
    got = fadd a, b
    ok = fcmp_eq got, four
    !three
    !two_i
    !five
    !four_i
    !three_f
    !two_f
    !five_f
    !four
    !one_half
    !two_half
    !buf
    !a
    !b
    !got
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
