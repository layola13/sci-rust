@import "sa_std/io/print.sai"

@const OUT = utf8:"697\n"

// 697 - Powers of two: 1+2+4+8+16 == 31, plus 666 == 697.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 1 as i64
    jmp L_COND
L_COND:
    done = eq i, 32
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, i
    jmp L_COND
L_DONE:
    !done
    want_sum = 31 as i64
    ok_sum = eq acc, want_sum
    base = 666 as i64
    got = add acc, base
    want = 697 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !want_sum
    !ok_sum
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
