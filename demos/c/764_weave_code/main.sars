@import "sa_std/io/print.sai"

@const OUT = utf8:"764\n"

// 764 - Weave: alternate two helpers, 700+64 == 764.
@even764(x: i64) -> i64:
L_ENTRY:
    e = 32 as i64
    r = add x, e
    !x
    !e
    return r

@odd764(x: i64) -> i64:
L_ENTRY:
    o = 32 as i64
    r = add x, o
    !x
    !o
    return r

@main() -> i32:
L_ENTRY:
    base = 700 as i64
    a = call @even764(base)
    v = call @odd764(a)
    want = 764 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !a
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
