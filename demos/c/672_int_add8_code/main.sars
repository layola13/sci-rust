@import "sa_std/io/print.sai"

@const OUT = utf8:"672\n"

// 672 - Int add: 600 + 72 == 672 with code 0.
@main() -> i32:
L_ENTRY:
    x = 600 as i64
    y = 72 as i64
    v = add x, y
    want = 672 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
