@import "sa_std/io/print.sai"

@const OUT = utf8:"381\n"

// 381 - pointer memory roundtrip (stored base loads back identical).
@main() -> i32:
L_ENTRY:
    inner = alloc 8
    slot = alloc 8
    store slot+0, inner as ptr
    q = load slot+0 as ptr
    ok = eq q, inner
    !inner
    !slot
    !q
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
