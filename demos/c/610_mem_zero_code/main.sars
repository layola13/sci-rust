@import "sa_std/io/print.sai"

@const OUT = utf8:"610\n"

// 610 - Zeroed alloc: fresh 16 bytes read as (0, 0), plus 610 == 610.
@main() -> i32:
L_ENTRY:
    buf = alloc 16
    z0 = load buf+0 as i64
    z1 = load buf+8 as i64
    zero = 0 as i64
    ok0 = eq z0, zero
    ok1 = eq z1, zero
    base = 610 as i64
    got = add z0, base
    want = 610 as i64
    ok2 = eq got, want
    t0 = and ok0, ok1
    ok = and t0, ok2
    !buf
    !z0
    !z1
    !zero
    !ok0
    !ok1
    !base
    !got
    !want
    !ok2
    !t0
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
