@import "sa_std/io/print.sai"

@const OUT = utf8:"624\n"

// 624 - Chain of 7 calls returns 624 with code 0.
@p7(x: i64) -> i64:
L_ENTRY:
    !x
    return 624

@p6(x: i64) -> i64:
L_ENTRY:
    v = call @p7(x)
    !x
    return v

@p5(x: i64) -> i64:
L_ENTRY:
    v = call @p6(x)
    !x
    return v

@p4(x: i64) -> i64:
L_ENTRY:
    v = call @p5(x)
    !x
    return v

@p3(x: i64) -> i64:
L_ENTRY:
    v = call @p4(x)
    !x
    return v

@p2(x: i64) -> i64:
L_ENTRY:
    v = call @p3(x)
    !x
    return v

@p1(x: i64) -> i64:
L_ENTRY:
    v = call @p2(x)
    !x
    return v

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    v = call @p1(z)
    want = 624 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !z
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
