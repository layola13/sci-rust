@import "sa_std/io/print.sai"

@const OUT = utf8:"850\n"

// 850 - Shelf: 850 = 800 + 50 across shelf slots, code 0.
@main() -> i32:
L_ENTRY:
    sh = alloc 16
    store sh+0, 800 as i64
    store sh+8, 50 as i64
    a = load sh+0 as i64
    b = load sh+8 as i64
    got = add a, b
    want = 850 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !sh
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
