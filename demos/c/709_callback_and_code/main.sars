@import "sa_std/io/print.sai"

@const OUT = utf8:"709\n"
@const AND_VT = vtable { invoke = @and_fn }

// 709 - Callback and-combine: both nonzero yields 709.
@and_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    za = eq a, 0
    zb = eq b, 0
    ok_a = eq za, 0
    ok_b = eq zb, 0
    both = and ok_a, ok_b
    br both -> L_HIT, L_MISS
L_HIT:
    !a
    !b
    !za
    !zb
    !ok_a
    !ok_b
    !both
    return 709
L_MISS:
    !a
    !b
    !za
    !zb
    !ok_a
    !ok_b
    !both
    return 0

@main() -> i32:
L_ENTRY:
    t = &AND_VT
    fp = load t + 0 as ptr
    x = 700 as i64
    y = 9 as i64
    v = call_indirect fp(x, y)
    want = 709 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
