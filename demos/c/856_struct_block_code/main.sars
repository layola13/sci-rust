@import "sa_std/io/print.sai"

@const OUT = utf8:"856\n"

// 856 - Block pair: (800, 56) second block re-added == 856.
@main() -> i32:
L_ENTRY:
    b0 = alloc 8
    b1 = alloc 8
    store b0+0, 800 as i64
    store b1+0, 56 as i64
    a = load b0+0 as i64
    b = load b1+0 as i64
    got = add a, b
    want = 856 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !b0
    !b1
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
