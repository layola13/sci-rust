@import "sa_std/io/print.sai"

@const OUT = utf8:"840\n"

// 840 - Pages: 840 = 400 + 440 across page slots, code 0.
@main() -> i32:
L_ENTRY:
    pg = alloc 16
    store pg+0, 400 as i64
    store pg+8, 440 as i64
    a = load pg+0 as i64
    b = load pg+8 as i64
    got = add a, b
    want = 840 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !pg
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
