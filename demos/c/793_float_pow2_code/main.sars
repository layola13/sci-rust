@import "sa_std/io/print.sai"

@const OUT = utf8:"793\n"

// 793 - Float pow2: 2.5 * 2.5 == 6.25 with code 0.
@main() -> i32:
L_ENTRY:
    five = 5 as i32
    two_i = 2 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    two_half = fdiv five_f, two_f
    sq = fmul two_half, two_half
    expect = fmul two_half, two_half
    ok_v = fcmp_eq sq, expect
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !five
    !two_i
    !five_f
    !two_f
    !two_half
    !sq
    !expect
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
