@import "sa_std/io/print.sai"

@const OUT = utf8:"526\n"

// 526 - Loop over a fallible float step that stamps code 0 per call;
// 0.5 added 4 times with a clean code trail (== 2.0).
@halfstep(code_slot: ptr) -> f64!:
L_ENTRY:
    one_i = 1 as i32
    two_i = 2 as i32
    one_f = sitofp one_i as f64
    two_f = sitofp two_i as f64
    h = fdiv one_f, two_f
    store code_slot+0, 0 as i64
    !code_slot
    !one_i
    !two_i
    !one_f
    !two_f
    return h

@main() -> i32:
L_ENTRY:
    zero_i = 0 as i32
    one_i = 1 as i64
    code_slot = alloc 8
    acc = sitofp zero_i as f64
    i = 0 as i64
    jmp L_LOOP
L_LOOP:
    c = slt i, 4
    br c -> L_BODY, L_DONE
L_BODY:
    r = call @halfstep(code_slot)
    v = ?r
    acc = fadd acc, v
    i = add i, one_i
    !c
    !r
    !v
    jmp L_LOOP
L_DONE:
    !c
    two_i = 2 as i32
    expect = sitofp two_i as f64
    ok_v = fcmp_eq acc, expect
    code = load code_slot+0 as i64
    ok_c = eq code, 0
    ok = and ok_v, ok_c
    !zero_i
    !one_i
    !code_slot
    !acc
    !i
    !two_i
    !expect
    !ok_v
    !code
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
