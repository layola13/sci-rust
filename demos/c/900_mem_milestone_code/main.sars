@import "sa_std/io/print.sai"

@const OUT = utf8:"900\n"

// 900 - Milestone: 9 slots of 100 sum == 900 with code 0.
@main() -> i32:
L_ENTRY:
    buf = alloc 72
    store buf+0, 100 as i64
    store buf+8, 100 as i64
    store buf+16, 100 as i64
    store buf+24, 100 as i64
    store buf+32, 100 as i64
    store buf+40, 100 as i64
    store buf+48, 100 as i64
    store buf+56, 100 as i64
    store buf+64, 100 as i64
    a = load buf+0 as i64
    b = load buf+8 as i64
    c = load buf+16 as i64
    d = load buf+24 as i64
    e = load buf+32 as i64
    f = load buf+40 as i64
    g = load buf+48 as i64
    h = load buf+56 as i64
    k = load buf+64 as i64
    ab = add a, b
    cd = add c, d
    ef = add e, f
    gh = add g, h
    s0 = add ab, cd
    s1 = add ef, gh
    s2 = add s0, s1
    got = add s2, k
    want = 900 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !buf
    !a
    !b
    !c
    !d
    !e
    !f
    !g
    !h
    !k
    !ab
    !cd
    !ef
    !gh
    !s0
    !s1
    !s2
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
