@import "sa_std/io/print.sai"

@const OUT = utf8:"887\n"

// 887 - Accum5: 800 + (1+2+3+4+5) + 872... check: 15 + 872 == 887.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 1 as i64
    one = 1 as i64
    jmp L_COND
L_COND:
    done = eq i, 6
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, one
    jmp L_COND
L_DONE:
    !done
    want_sum = 15 as i64
    ok_sum = eq acc, want_sum
    base = 872 as i64
    got = add acc, base
    want = 887 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !one
    !want_sum
    !ok_sum
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
