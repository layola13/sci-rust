@import "sa_std/io/print.sai"
@import "parts/index.sars"

@const OUT = utf8:"514\n"

// 514 - Fallible barrel: the index unpacks three fallible leaves
// (400 + 60 + 54) behind one entry point.
@main() -> i32:
L_ENTRY:
    r = call @barrel_sum()
    v = ?r
    ok = eq v, 514
    !r
    !v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
