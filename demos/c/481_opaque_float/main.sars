@import "sa_std/io/print.sai"
@import "consumer/opaque_float_consumer.sars"

@const OUT = utf8:"481\n"

// 481 - Contract Opaque Struct (float): the consumer only sees
// layout/public.sal (size); field offsets stay private to the
// bridge, which stores tag 1 and payload 2.5.
@main() -> i32:
L_ENTRY:
    value = call @opaque_float_consumer_value()
    five = 5 as i32
    two_i = 2 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    expect = fdiv five_f, two_f
    ok = fcmp_eq value, expect
    !value
    !five
    !two_i
    !five_f
    !two_f
    !expect
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
