@import "sa_std/io/print.sai"

@const OUT = utf8:"448\n"

// 448 - struct fields are independent: overwriting {1.5, _} to
// {1.5, 3.5} leaves x at 1.5 and sums to 5.0.
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    five = 5 as i32
    seven = 7 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    five_f = sitofp five as f64
    two_half = fdiv five_f, two_f
    seven_f = sitofp seven as f64
    three_half = fdiv seven_f, two_f
    buf = alloc 16
    store buf+0, one_half as f64
    store buf+8, two_half as f64
    store buf+8, three_half as f64
    x = load buf+0 as f64
    y = load buf+8 as f64
    ok_x = fcmp_eq x, one_half
    s = fadd x, y
    five_whole = sitofp five as f64
    ok_s = fcmp_eq s, five_whole
    ok = and ok_x, ok_s
    !three
    !two_i
    !five
    !seven
    !three_f
    !two_f
    !one_half
    !five_f
    !two_half
    !seven_f
    !three_half
    !buf
    !x
    !y
    !ok_x
    !s
    !five_whole
    !ok_s
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
