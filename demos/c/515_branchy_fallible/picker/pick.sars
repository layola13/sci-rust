@import "picker/../small/small.sars"
@import "picker/../big/big.sars"

@export pick_value(which: i64) -> i32!:
L_ENTRY:
    c = eq which, 0
    br c -> L_SMALL, L_BIG
L_SMALL:
    r = call @small_value()
    v = ?r
    !which
    !c
    !r
    return v
L_BIG:
    r = call @big_value()
    v = ?r
    !which
    !c
    !r
    return v
