@import "sa_std/io/print.sai"

@const OUT = utf8:"929\n"
@const ODD_VT = vtable { invoke = @odd_fn }

// 929 - Callback odd: 929 is odd yields 929 through indirect call.
@odd_fn(x: i64) -> i64:
L_ENTRY:
    two = 2 as i64
    h0 = sub x, two
    h1 = sub h0, two
    h2 = sub h1, two
    want_h = 923 as i64
    is1 = eq h2, want_h
    br is1 -> L_HIT, L_MISS
L_HIT:
    !x
    !two
    !h0
    !h1
    !h2
    !want_h
    !is1
    return 929
L_MISS:
    !x
    !two
    !h0
    !h1
    !h2
    !want_h
    !is1
    return 0

@main() -> i32:
L_ENTRY:
    t = &ODD_VT
    fp = load t + 0 as ptr
    v0 = 929 as i64
    v = call_indirect fp(v0)
    want = 929 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !v0
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
