@import "sa_std/io/print.sai"

@const OUT = utf8:"342\n"

// 342 - uitofp/fptosi roundtrip preserves large unsigned values (2^32).
@main() -> i32:
L_ENTRY:
    big = 4294967296 as u64
    f = uitofp big as f64
    y = fptosi f as i64
    ok = eq y, 4294967296
    !big
    !f
    !y
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
