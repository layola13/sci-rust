@import "sa_std/io/print.sai"

@const OUT = utf8:"716\n"

// 716 - Avg2: (700 + 732) - 716 == 716 via round-trip, code 0.
@main() -> i32:
L_ENTRY:
    p = alloc 16
    store p+0, 700 as i64
    store p+8, 732 as i64
    a = load p+0 as i64
    b = load p+8 as i64
    s = add a, b
    want_sum = 1432 as i64
    ok_sum = eq s, want_sum
    half = 716 as i64
    got = sub s, half
    ok_v = eq got, half
    ok = and ok_sum, ok_v
    !p
    !a
    !b
    !s
    !want_sum
    !ok_sum
    !half
    !got
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
