@import "sa_std/io/print.sai"

@const OUT = utf8:"623\n"

// 623 - Float div: 9.0 / 3.0 == 3.0 with code 0.
@main() -> i32:
L_ENTRY:
    nine = 9 as i32
    three = 3 as i32
    nine_f = sitofp nine as f64
    three_f = sitofp three as f64
    got = fdiv nine_f, three_f
    ok_v = fcmp_eq got, three_f
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !nine
    !three
    !nine_f
    !three_f
    !got
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
