@import "east/alpha.sars"

// 502 - Bare Cross-Dir Import Reject
// east/alpha.sa imports west/beta.sa with a bare cross-directory path
// (no `east/../` anchor). Nested imports must anchor at their own
// directory, so this fails import resolution on every backend; the
// working form lives in 488 (`east/../west/beta.sa`).

@main() -> i32:
L_ENTRY:
    value = call @alpha_value()
    return value
