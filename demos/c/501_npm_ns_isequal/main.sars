@import "sa_std/io/print.sai"

@extern npm_ns_iseq(&a: ptr, a_len: u64, &b: ptr, b_len: u64) -> u32
#npm_bind npm_ns_iseq "node:util#util.isDeepStrictEqual"

@const QA = utf8:"ab"
@const QB = utf8:"ab"
@const QC = utf8:"cd"
@const OUT = utf8:"501\n"

// 501 - npm namespace import with two UTF8 pairs (node:util
// util.isDeepStrictEqual; 'ab' vs 'ab' -> 1, 'ab' vs 'cd' -> 0).
// Same semantics as the named-import twin 499.
@main() -> i32:
L_ENTRY:
    q1 = call @npm_ns_iseq(&QA, 2, &QB, 2)
    q2 = call @npm_ns_iseq(&QA, 2, &QC, 2)
    ok1 = eq q1, 1
    ok2 = eq q2, 0
    ok = and ok1, ok2
    !q1
    !q2
    !ok1
    !ok2
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
