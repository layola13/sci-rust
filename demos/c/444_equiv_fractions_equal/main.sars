@import "sa_std/io/print.sai"

@const OUT = utf8:"444\n"

// 444 - equivalent fractions compare equal (1/3 == 2/6, both
// correctly rounded to the same f64).
@main() -> i32:
L_ENTRY:
    one_i = 1 as i32
    two_i = 2 as i32
    three_i = 3 as i32
    six_i = 6 as i32
    one = sitofp one_i as f64
    two = sitofp two_i as f64
    three = sitofp three_i as f64
    six = sitofp six_i as f64
    a = fdiv one, three
    b = fdiv two, six
    ok = fcmp_eq a, b
    !one_i
    !two_i
    !three_i
    !six_i
    !one
    !two
    !three
    !six
    !a
    !b
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
