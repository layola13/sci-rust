@import "sa_std/io/print.sai"
@import "consumer/reader.sars"

@const OUT = utf8:"520\n"

// 520 - Memory plus fallible split across files: the bridge allocates
// a slot holding 520 and transfers the handle through a fallible
// boundary; the consumer reads it and releases it.
@main() -> i32:
L_ENTRY:
    r = call @read_slot()
    v = ?r
    vv = add v, 0
    ok = eq vv, 520
    !r
    !v
    !vv
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
