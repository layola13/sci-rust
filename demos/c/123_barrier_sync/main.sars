@import "sa_std/io/print.sai"

@const RESULT_OK = utf8:"3\n"
@const RESULT_ERR = utf8:"error\n"

#def Barrier_SIZE = 8
#def Barrier_total = +0
#def Barrier_arrived = +4

@main() -> i32:
L_ENTRY:
    bar = alloc Barrier_SIZE
    store bar+Barrier_total, 3 as i32
    store bar+Barrier_arrived, 0 as i32
    jmp L_WORKER_0

L_WORKER_0:
    arrived0 = load bar+Barrier_arrived as i32
    next0 = add arrived0, 1
    store bar+Barrier_arrived, next0 as i32
    !arrived0
    !next0
    jmp L_WORKER_1

L_WORKER_1:
    arrived1 = load bar+Barrier_arrived as i32
    next1 = add arrived1, 1
    store bar+Barrier_arrived, next1 as i32
    !arrived1
    !next1
    jmp L_WORKER_2

L_WORKER_2:
    arrived2 = load bar+Barrier_arrived as i32
    next2 = add arrived2, 1
    store bar+Barrier_arrived, next2 as i32
    !arrived2
    !next2
    jmp L_WAIT

L_WAIT:
    arrived = load bar+Barrier_arrived as i32
    complete = eq arrived, 3
    br complete -> L_DONE, L_WAIT_AGAIN

L_WAIT_AGAIN:
    !arrived
    !complete
    jmp L_WAIT

L_DONE:
    total = load bar+Barrier_total as i32
    ok = eq total, 3
    !arrived
    !complete
    !total
    !bar
    br ok -> L_OK, L_ERR

L_OK:
    !ok
    call @sa_print_bytes(&RESULT_OK, 2)
    return 0

L_ERR:
    !ok
    call @sa_print_bytes(&RESULT_ERR, 6)
    return 1
