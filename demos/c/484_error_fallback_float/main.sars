@import "sa_std/io/print.sai"
@import "consumer/error_float_fallback_consumer.sars"

@const OUT = utf8:"484\n"

// 484 - Contract Error Code Mapping fallback path: unmapped code 3
// falls back to 0.5 through bridge/error_float_map.sa.
@main() -> i32:
L_ENTRY:
    value = call @error_float_fallback_consumer_value()
    one_i = 1 as i32
    two_i = 2 as i32
    one_f = sitofp one_i as f64
    two_f = sitofp two_i as f64
    expect = fdiv one_f, two_f
    ok = fcmp_eq value, expect
    !value
    !one_i
    !two_i
    !one_f
    !two_f
    !expect
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
