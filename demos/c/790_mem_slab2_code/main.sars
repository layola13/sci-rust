@import "sa_std/io/print.sai"

@const OUT = utf8:"790\n"

// 790 - Slab2: 5 slots of 158 sum == 790 with code 0.
@main() -> i32:
L_ENTRY:
    buf = alloc 40
    store buf+0, 158 as i64
    store buf+8, 158 as i64
    store buf+16, 158 as i64
    store buf+24, 158 as i64
    store buf+32, 158 as i64
    a = load buf+0 as i64
    b = load buf+8 as i64
    c = load buf+16 as i64
    d = load buf+24 as i64
    e = load buf+32 as i64
    ab = add a, b
    cd = add c, d
    s0 = add ab, cd
    got = add s0, e
    want = 790 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !buf
    !a
    !b
    !c
    !d
    !e
    !ab
    !cd
    !s0
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
