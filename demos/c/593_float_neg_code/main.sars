@import "sa_std/io/print.sai"

@const OUT = utf8:"593\n"

// 593 - Float neg: fneg(1.5) == -1.5 round-trip with code 0.
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    neg = fneg one_half
    back = fneg neg
    ok_v = fcmp_eq back, one_half
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !three
    !two_i
    !three_f
    !two_f
    !one_half
    !neg
    !back
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
