@import "sa_std/io/print.sai"

@const OUT = utf8:"574\n"

// 574 - Nested 2-deep calls return 574 with code 0.
@inner(x: i64) -> i64:
L_ENTRY:
    !x
    return 574

@outer(x: i64) -> i64:
L_ENTRY:
    v = call @inner(x)
    !x
    return v

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    v = call @outer(z)
    want = 574 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !z
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
