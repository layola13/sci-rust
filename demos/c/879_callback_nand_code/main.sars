@import "sa_std/io/print.sai"

@const OUT = utf8:"879\n"
@const ND_VT = vtable { invoke = @nand_fn }

// 879 - Callback nand: not(1 and 0) yields 879.
@nand_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    za = eq a, 0
    zb = eq b, 0
    oka = eq za, 0
    okb = eq zb, 0
    both = and oka, okb
    nand = eq both, 0
    br nand -> L_HIT, L_MISS
L_HIT:
    !a
    !b
    !za
    !zb
    !oka
    !okb
    !both
    !nand
    return 879
L_MISS:
    !a
    !b
    !za
    !zb
    !oka
    !okb
    !both
    !nand
    return 0

@main() -> i32:
L_ENTRY:
    t = &ND_VT
    fp = load t + 0 as ptr
    x = 1 as i64
    y = 0 as i64
    v = call_indirect fp(x, y)
    want = 879 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
