@import "sa_std/io/print.sai"

@const OUT = utf8:"733\n"

// 733 - Float abs: fneg(fneg(2.5)) == 2.5 with code 0.
@main() -> i32:
L_ENTRY:
    five = 5 as i32
    two_i = 2 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    two_half = fdiv five_f, two_f
    n = fneg two_half
    back = fneg n
    ok_v = fcmp_eq back, two_half
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !five
    !two_i
    !five_f
    !two_f
    !two_half
    !n
    !back
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
