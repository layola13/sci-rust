@import "sa_std/io/print.sai"
@import "f1/top.sars"

@const OUT = utf8:"493\n"

// 493 - Float deep chain: main -> f1/top -> f1/f2/mid ->
// f1/f2/f3/seed (0.5 + 1.0 + 2.5 == 4.0).
@main() -> i32:
L_ENTRY:
    value = call @top_value()
    four_i = 4 as i32
    four = sitofp four_i as f64
    ok = fcmp_eq value, four
    !value
    !four_i
    !four
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
