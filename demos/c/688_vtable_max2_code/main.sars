@import "sa_std/io/print.sai"

@const OUT = utf8:"688\n"
@const MX_VT = vtable { pick = @pick_max2 }

// 688 - Vtable max: max(600, 688) == 688 through indirect call.
@pick_max2(a: i64, b: i64) -> i64:
L_ENTRY:
    big = slt a, b
    br big -> L_B, L_A
L_B:
    !a
    !big
    m = add b, 0
    !b
    jmp L_OUT
L_A:
    !b
    !big
    m = add a, 0
    !a
    jmp L_OUT
L_OUT:
    ret2 = add m, 0
    !m
    return ret2

@main() -> i32:
L_ENTRY:
    t = &MX_VT
    fp = load t + 0 as ptr
    x = 600 as i64
    y = 688 as i64
    v = call_indirect fp(x, y)
    want = 688 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
