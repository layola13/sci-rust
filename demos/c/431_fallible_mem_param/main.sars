@import "sa_std/io/print.sai"

@const OUT = utf8:"431\n"

// 431 - fallible fn spills its f64 parameter, reloads, doubles it
// (1.5 * 2 == 3.0).
@double(x: f64) -> f64!:
L_ENTRY:
    buf = alloc 8
    store buf+0, x as f64
    g = load buf+0 as f64
    d = fadd g, g
    !x
    !buf
    !g
    return d

@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    r = call @double(one_half)
    v = ?r
    three_whole = sitofp three as f64
    ok = fcmp_eq v, three_whole
    !three
    !two_i
    !three_f
    !two_f
    !one_half
    !r
    !v
    !three_whole
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
