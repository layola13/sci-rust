@import "sa_std/io/print.sai"

@const OUT = utf8:"406\n"

// 406 - fadd adds exactly (1.5 + 2.5 == 4.0).
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    five = 5 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    five_f = sitofp five as f64
    two_half = fdiv five_f, two_f
    s = fadd one_half, two_half
    four_i = 4 as i32
    four = sitofp four_i as f64
    ok = fcmp_eq s, four
    !three
    !two_i
    !five
    !three_f
    !two_f
    !one_half
    !five_f
    !two_half
    !s
    !four_i
    !four
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
