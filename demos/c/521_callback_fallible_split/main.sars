@import "sa_std/io/print.sai"
@import "consumer/invoke.sars"

@const OUT = utf8:"521\n"

// 521 - Callback plus fallible split across files: the bridge callback
// adds 21, the consumer owns the registry and wraps the indirect call
// (500 + 21).
@main() -> i32:
L_ENTRY:
    r = call @invoke_add()
    v = ?r
    vv = add v, 0
    ok = eq vv, 521
    !r
    !v
    !vv
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
