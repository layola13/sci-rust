@import "sa_std/io/print.sai"
@import "sa_std/quic.sars"

@const OK962 = utf8:"962\n"

// 962 - QUIC/HTTP3 std surface smoke: capability probes + capability/
// constants JSON + buffer-handle release. No network, no native libs
// required; endpoint/session create stays out (TODO in quic.sai).
@main() -> i32:
L_ENTRY:
    EXPAND QUIC_SUPPORTED st1, sup1
    EXPAND HTTP3_SUPPORTED st2, sup2
    EXPAND QUIC_CAPABILITIES_JSON st3, caps
    EXPAND QUIC_BUFFER_LEN blen, caps
    has = gt blen, 0
    br has -> L_PRINT, L_ERR
L_PRINT:
    EXPAND QUIC_CONSTANTS_JSON st4, c1
    EXPAND HTTP3_CONSTANTS_JSON st5, c2
    EXPAND QUIC_BUFFER_FREE st6, caps
    EXPAND QUIC_BUFFER_FREE st7, c1
    EXPAND QUIC_BUFFER_FREE st8, c2
    call @sa_print_bytes(&OK962, 4)
    !st1
    !sup1
    !st2
    !sup2
    !st3
    !blen
    !has
    !st4
    !st5
    !st6
    !st7
    !st8
    return 0
L_ERR:
    !st1
    !sup1
    !st2
    !sup2
    !st3
    !caps
    !blen
    !has
    return 1
