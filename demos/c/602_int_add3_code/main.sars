@import "sa_std/io/print.sai"

@const OUT = utf8:"602\n"

// 602 - Int add: 500 + 102 == 602 with code 0.
@main() -> i32:
L_ENTRY:
    x = 500 as i64
    y = 102 as i64
    v = add x, y
    want = 602 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
