@import "sa_std/io/print.sai"

@extern sa_b64dec_simd(in_ptr: ptr, in_len: u64, out_ptr: ptr) -> u64

@const B64_OK = utf8:"B64BIG OK\n"
@const B64_FAIL = utf8:"FAIL\n"

@main() -> i32:
L_ENTRY:
    in = alloc 4194304
    out = alloc 3145728
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u32
    acc_slot = stack_alloc 8
    store acc_slot+0, 0 as u64
    jmp L_FILL_COND
L_FILL_COND:
    i = load i_slot+0 as u32
    more = ult i, 4194304
    br more -> L_FILL_BODY, L_FILL_END
L_FILL_BODY:
    slot = ptr_add in, i
    store slot+0, 66 as u8
    next = add i, 1
    store i_slot+0, next as u32
    !slot
    !next
    !i
    !more
    jmp L_FILL_COND
L_FILL_END:
    !i
    !more
    n = call @sa_b64dec_simd(&in, 4194304, &out)
    oklen = eq n, 3145728
    br oklen -> L_SPOTS, L_DFAIL
L_DFAIL:
    !n
    !oklen
    !in
    !out
    call @sa_print_bytes(&B64_FAIL, 5)
    return 1
L_SPOTS:
    !oklen
    b0 = load out+0 as u8
    b1 = load out+1 as u8
    b2 = load out+2 as u8
    e0 = load out+3145725 as u8
    e1 = load out+3145726 as u8
    e2 = load out+3145727 as u8
    acc = load acc_slot+0 as u64
    a1 = add acc, b0
    a2 = add a1, b1
    a3 = add a2, b2
    a4 = add a3, e0
    a5 = add a4, e1
    a6 = add a5, e2
    store acc_slot+0, a6 as u64
    !n
    !b0
    !b1
    !b2
    !e0
    !e1
    !e2
    !acc
    !a1
    !a2
    !a3
    !a4
    !a5
    !a6
    total = load acc_slot+0 as u64
    ok = eq total, 170
    br ok -> L_OK, L_FAIL
L_OK:
    !total
    !ok
    !in
    !out
    call @sa_print_bytes(&B64_OK, 9)
    return 0
L_FAIL:
    !total
    !ok
    !in
    !out
    call @sa_print_bytes(&B64_FAIL, 5)
    return 1
