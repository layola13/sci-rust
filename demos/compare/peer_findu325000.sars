@import "sa_std/io/print.sai"

@extern sa_mfind_u32(ptr: ptr, len: u64, needle: u64) -> u64

@const FIND_OK = utf8:"FINDU OK\n"
@const FIND_FAIL = utf8:"FAIL\n"

@main() -> i32:
L_ENTRY:
    buf = alloc 16384
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u32
    rep_slot = stack_alloc 8
    store rep_slot+0, 0 as u64
    acc_slot = stack_alloc 8
    store acc_slot+0, 0 as u64
    jmp L_FILL_COND
L_FILL_COND:
    i = load i_slot+0 as u32
    more = ult i, 4096
    br more -> L_FILL_BODY, L_FILL_END
L_FILL_BODY:
    t1 = mul i, 37
    w = add t1, 11
    o = mul i, 4
    slot = ptr_add buf, o
    store slot+0, w as u32
    !t1
    !w
    !o
    !slot
    next = add i, 1
    store i_slot+0, next as u32
    !next
    !i
    !more
    jmp L_FILL_COND
L_FILL_END:
    !i
    !more
    jmp L_REP_COND
L_REP_COND:
    rep = load rep_slot+0 as u64
    more3 = ult rep, 5000
    br more3 -> L_REP_BODY, L_REP_END
L_REP_BODY:
    !rep
    !more3
    f = call @sa_mfind_u32(&buf, 4096, 3711)
    oklen = eq f, 100
    br oklen -> L_SPOTS, L_DFAIL
L_DFAIL:
    !f
    !oklen
    !buf
    call @sa_print_bytes(&FIND_FAIL, 5)
    return 1
L_SPOTS:
    !oklen
    acc = load acc_slot+0 as u64
    acc2 = add acc, f
    store acc_slot+0, acc2 as u64
    rep3 = load rep_slot+0 as u64
    rep4 = add rep3, 1
    store rep_slot+0, rep4 as u64
    !f
    !acc
    !acc2
    !rep3
    !rep4
    jmp L_REP_COND
L_REP_END:
    !rep
    !more3
    total = load acc_slot+0 as u64
    ok = eq total, 500000
    br ok -> L_OK, L_FAIL
L_OK:
    !total
    !ok
    !buf
    call @sa_print_bytes(&FIND_OK, 9)
    return 0
L_FAIL:
    !total
    !ok
    !buf
    call @sa_print_bytes(&FIND_FAIL, 5)
    return 1
