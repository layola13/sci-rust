@import "sa_std/io/print.sai"

@extern sa_esc_html(in_ptr: ptr, in_len: u64, out_ptr: ptr) -> u64

@const ESC_OK = utf8:"ESC OK\n"
@const ESC_FAIL = utf8:"FAIL\n"

@main() -> i32:
L_ENTRY:
    in = alloc 65536
    out = alloc 393216
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u32
    rep_slot = stack_alloc 8
    store rep_slot+0, 0 as u64
    acc_slot = stack_alloc 8
    store acc_slot+0, 0 as u64
    jmp L_FILL_COND
L_FILL_COND:
    i = load i_slot+0 as u32
    more = ult i, 65536
    br more -> L_FILL_BODY, L_FILL_END
L_FILL_BODY:
    r = and i, 63
    ismeta = ult r, 5
    br ismeta -> L_META, L_PLAIN
L_PLAIN:
    t = and r, 15
    c = add t, 97
    !r
    !ismeta
    !t
    !i
    !more
    jmp L_STORE
L_META:
    !ismeta
    is0 = eq r, 0
    br is0 -> L_C0, L_N0
L_C0:
    c = add r, 60
    !is0
    !r
    !i
    !more
    jmp L_STORE
L_N0:
    !is0
    is1 = eq r, 1
    br is1 -> L_C1, L_N1
L_C1:
    c = add r, 61
    !is1
    !r
    !i
    !more
    jmp L_STORE
L_N1:
    !is1
    is2 = eq r, 2
    br is2 -> L_C2, L_N2
L_C2:
    c = add r, 36
    !is2
    !r
    !i
    !more
    jmp L_STORE
L_N2:
    !is2
    is3 = eq r, 3
    br is3 -> L_C3, L_N3
L_C3:
    c = add r, 31
    !is3
    !r
    !i
    !more
    jmp L_STORE
L_N3:
    c = add r, 35
    !is3
    !r
    !i
    !more
    jmp L_STORE
L_STORE:
    slot = ptr_add in, i
    store slot+0, c as u8
    next = add i, 1
    store i_slot+0, next as u32
    !slot
    !next
    !c
    jmp L_FILL_COND
L_FILL_END:
    !i
    !more
    jmp L_REP_COND
L_REP_COND:
    rep = load rep_slot+0 as u64
    more3 = ult rep, 100
    br more3 -> L_REP_BODY, L_REP_END
L_REP_BODY:
    !rep
    !more3
    n = call @sa_esc_html(&in, 65536, &out)
    oklen = eq n, 84992
    br oklen -> L_SPOTS, L_DFAIL
L_DFAIL:
    !n
    !oklen
    !in
    !out
    call @sa_print_bytes(&ESC_FAIL, 5)
    return 1
L_SPOTS:
    !oklen
    b0 = load out+0 as u8
    b1 = load out+1 as u8
    b2 = load out+2 as u8
    b3 = load out+3 as u8
    elast = load out+84991 as u8
    acc = load acc_slot+0 as u64
    a1 = add acc, b0
    a2 = add a1, b1
    a3 = add a2, b2
    a4 = add a3, b3
    a5 = add a4, elast
    store acc_slot+0, a5 as u64
    rep3 = load rep_slot+0 as u64
    rep4 = add rep3, 1
    store rep_slot+0, rep4 as u64
    !n
    !b0
    !b1
    !b2
    !b3
    !elast
    !acc
    !a1
    !a2
    !a3
    !a4
    !a5
    !rep3
    !rep4
    jmp L_REP_COND
L_REP_END:
    !rep
    !more3
    total = load acc_slot+0 as u64
    ok = eq total, 43300
    br ok -> L_OK, L_FAIL
L_OK:
    !total
    !ok
    !in
    !out
    call @sa_print_bytes(&ESC_OK, 7)
    return 0
L_FAIL:
    !total
    !ok
    !in
    !out
    call @sa_print_bytes(&ESC_FAIL, 5)
    return 1
