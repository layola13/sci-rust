@import "sa_std/io/print.sai"

@const OUT = utf8:"944\n"

// 944 - Route4: 800 + 60 + 50 + 34 == 944 via staged adds.
@rt60(x: i64) -> i64:
L_ENTRY:
    k = 60 as i64
    r = add x, k
    !x
    !k
    return r

@rt50(x: i64) -> i64:
L_ENTRY:
    k = 50 as i64
    r = add x, k
    !x
    !k
    return r

@rt34(x: i64) -> i64:
L_ENTRY:
    k = 34 as i64
    r = add x, k
    !x
    !k
    return r

@main() -> i32:
L_ENTRY:
    base = 800 as i64
    v1 = call @rt60(base)
    v2 = call @rt50(v1)
    v = call @rt34(v2)
    want = 944 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v1
    !v2
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
