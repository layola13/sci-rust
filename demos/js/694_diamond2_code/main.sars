@import "sa_std/io/print.sai"

@const OUT = utf8:"694\n"

// 694 - Diamond merge: both arms yield 347, sum == 694.
@arm() -> i64:
L_ENTRY:
    return 347

@main() -> i32:
L_ENTRY:
    x = call @arm()
    y = call @arm()
    got = add x, y
    want = 694 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !x
    !y
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
