@import "sa_std/io/print.sai"

@const OUT = utf8:"877\n"

// 877 - Product run: 2*3*4 == 24 via adds, plus 853 == 877.
@main() -> i32:
L_ENTRY:
    two = 2 as i64
    three = 3 as i64
    four = 4 as i64
    t1 = add two, two
    t2 = add t1, two
    s0 = add t2, t2
    got24 = add s0, s0
    want24 = 24 as i64
    ok_p = eq got24, want24
    base = 853 as i64
    got = add got24, base
    want = 877 as i64
    ok_v = eq got, want
    ok = and ok_p, ok_v
    !two
    !three
    !four
    !t1
    !t2
    !s0
    !got24
    !want24
    !ok_p
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
