@import "sa_std/core/mem.sars"
@import "sa_std/io/print.sai"

@const VT_LT = vtable { call = @lt_fn }
@const VT_GT = vtable { call = @gt_fn }
@const OUT = utf8:"334\n"

// 334 - Indirect calls shadowed by an early import.
//
// Two same-shape closure vtables plus an @import inlined ahead of them.
// The LLVM backend used to type `call_indirect` by first-match on arity
// (picking void sa_mem_set) and crash codegen; valued indirect calls must
// never resolve to a void callee.
@lt_fn(a: i32, b: i32, ctx: ptr) -> i32:
    r = slt a, b
    !ctx
    !b
    !a
    return r

@gt_fn(a: i32, b: i32, ctx: ptr) -> i32:
    r = sgt a, b
    !ctx
    !b
    !a
    return r

@main() -> i32:
    buf = alloc 16
    call @sa_mem_set(&buf, 0, 16)
    !buf
    t0 = &VT_LT
    fp0 = load t0 + 0 as ptr
    ctx0 = alloc 8
    r0 = call_indirect fp0(3, 5, ctx0)
    !ctx0
    !fp0
    !t0
    t1 = &VT_GT
    fp1 = load t1 + 0 as ptr
    ctx1 = alloc 8
    r1 = call_indirect fp1(3, 5, ctx1)
    !ctx1
    !fp1
    !t1
    s = add r0, r1
    !r1
    !r0
    ok = eq s, 1
    !s
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
