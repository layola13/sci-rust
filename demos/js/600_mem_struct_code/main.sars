@import "sa_std/io/print.sai"

@const OUT = utf8:"600\n"

// 600 - Mem struct: (code 0, 300, 300) fields sum == 600.
@main() -> i32:
L_ENTRY:
    p = alloc 24
    store p+0, 0 as i64
    store p+8, 300 as i64
    store p+16, 300 as i64
    c0 = load p+0 as i64
    a = load p+8 as i64
    b = load p+16 as i64
    s = add a, b
    want = 600 as i64
    ok_v = eq s, want
    ok_c = eq c0, 0
    ok = and ok_v, ok_c
    !p
    !c0
    !a
    !b
    !s
    !want
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
