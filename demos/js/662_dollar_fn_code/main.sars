@import "sa_std/io/print.sai"

@const OUT = utf8:"662\n"

// 662 - Runtime-namespace guard regression: a function starting with
// __sa must not clobber the runtime (see isEmitterReserved).
@__sa_probe662(x: i64) -> i64:
L_ENTRY:
    two = 2 as i64
    r = add x, two
    !x
    !two
    return r

@main() -> i32:
L_ENTRY:
    base = 660 as i64
    v = call @__sa_probe662(base)
    want = 662 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
