@import "sa_std/io/print.sai"

@const OUT = utf8:"926\n"

// 926 - Deck: (900, 26) top-plus-bottom == 926, code 0.
@main() -> i32:
L_ENTRY:
    dk = alloc 16
    store dk+0, 900 as i64
    store dk+8, 26 as i64
    top = load dk+0 as i64
    bot = load dk+8 as i64
    got = add top, bot
    want = 926 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !dk
    !top
    !bot
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
