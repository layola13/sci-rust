@import "sa_std/io/print.sai"

@const OUT = utf8:"557\n"

// 557 - And chain of three eq checks with code 0.
@main() -> i32:
L_ENTRY:
    a = 5 as i64
    b = 5 as i64
    c = 7 as i64
    d = 7 as i64
    e = 9 as i64
    f = 9 as i64
    ok0 = eq a, b
    ok1 = eq c, d
    ok2 = eq e, f
    t0 = and ok0, ok1
    ok = and t0, ok2
    !a
    !b
    !c
    !d
    !e
    !f
    !ok0
    !ok1
    !ok2
    !t0
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
