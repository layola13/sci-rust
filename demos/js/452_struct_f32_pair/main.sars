@import "sa_std/io/print.sai"

@const OUT = utf8:"452\n"

// 452 - f32 field pair: {1.5f @0, 2.5f @4} adds to 4.0f.
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    five = 5 as i32
    four_i = 4 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    five_f = sitofp five as f64
    two_half = fdiv five_f, two_f
    a32 = fptrunc one_half as f32
    b32 = fptrunc two_half as f32
    buf = alloc 8
    store buf+0, a32 as f32
    store buf+4, b32 as f32
    x = load buf+0 as f32
    y = load buf+4 as f32
    s = fadd x, y
    four_f = sitofp four_i as f64
    four32 = fptrunc four_f as f32
    ok = fcmp_eq s, four32
    !three
    !two_i
    !five
    !four_i
    !three_f
    !two_f
    !one_half
    !five_f
    !two_half
    !a32
    !b32
    !buf
    !x
    !y
    !s
    !four_f
    !four32
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
