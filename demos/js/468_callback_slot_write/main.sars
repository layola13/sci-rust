@import "sa_std/io/print.sai"

@const OUT = utf8:"468\n"
@const WR_VT = vtable { call = @write_cb }

// 468 - callback writes its result to the caller slot and returns it
// (1.5 + 2.5 == 4.0 on both paths).
@write_cb(x: f64, ctx: ptr) -> f64:
    five = 5 as i32
    two_i = 2 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    two_half = fdiv five_f, two_f
    s = fadd x, two_half
    store ctx+0, s as f64
    !x
    !five
    !two_i
    !five_f
    !two_f
    !two_half
    return s

@main() -> i32:
    three = 3 as i32
    two_i = 2 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    t = &WR_VT
    fp = load t + 0 as ptr
    reg = alloc 8
    store reg+0, fp as ptr
    cb = load reg+0 as ptr
    out = alloc 8
    r = call_indirect cb(one_half, out)
    mem = load out+0 as f64
    four_i = 4 as i32
    four = sitofp four_i as f64
    ok_r = fcmp_eq r, four
    ok_m = fcmp_eq mem, four
    ok = and ok_r, ok_m
    !three
    !two_i
    !three_f
    !two_f
    !one_half
    !t
    !fp
    !reg
    !cb
    !out
    !r
    !mem
    !four_i
    !four
    !ok_r
    !ok_m
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
