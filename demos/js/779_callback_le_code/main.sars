@import "sa_std/io/print.sai"

@const OUT = utf8:"779\n"
@const LE_VT = vtable { invoke = @le_fn }

// 779 - Callback le: 700 <= 779 yields 779 through indirect call.
@le_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    gt = slt b, a
    small = eq gt, 0
    br small -> L_YES, L_NO
L_YES:
    !a
    !b
    !gt
    !small
    return 779
L_NO:
    !a
    !b
    !gt
    !small
    return 0

@main() -> i32:
L_ENTRY:
    t = &LE_VT
    fp = load t + 0 as ptr
    x = 700 as i64
    y = 779 as i64
    v = call_indirect fp(x, y)
    want = 779 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
