@import "sa_std/io/print.sai"

@const OUT = utf8:"407\n"

// 407 - fsub subtracts exactly (5.5 - 2.25 == 3.25).
@main() -> i32:
L_ENTRY:
    eleven = 11 as i32
    two_i = 2 as i32
    nine = 9 as i32
    four_i = 4 as i32
    eleven_f = sitofp eleven as f64
    two_f = sitofp two_i as f64
    five_half = fdiv eleven_f, two_f
    nine_f = sitofp nine as f64
    four_f = sitofp four_i as f64
    two_quarter = fdiv nine_f, four_f
    d = fsub five_half, two_quarter
    thirteen = 13 as i32
    thirteen_f = sitofp thirteen as f64
    three_quarter = fdiv thirteen_f, four_f
    ok = fcmp_eq d, three_quarter
    !eleven
    !two_i
    !nine
    !four_i
    !eleven_f
    !two_f
    !five_half
    !nine_f
    !four_f
    !two_quarter
    !d
    !thirteen
    !thirteen_f
    !three_quarter
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
