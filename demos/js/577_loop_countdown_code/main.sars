@import "sa_std/io/print.sai"

@const OUT = utf8:"577\n"

// 577 - Countdown loop: 5+4+3+2+1 == 15 with code 0.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    n = 5 as i64
    one = 1 as i64
    jmp L_COND
L_COND:
    done = eq n, 0
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, n
    n = sub n, one
    jmp L_COND
L_DONE:
    !done
    want = 15 as i64
    ok_sum = eq acc, want
    zero = 0 as i64
    ok_code = eq zero, 0
    ok = and ok_sum, ok_code
    !acc
    !n
    !one
    !want
    !zero
    !ok_sum
    !ok_code
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
