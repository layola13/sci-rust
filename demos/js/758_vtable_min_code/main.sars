@import "sa_std/io/print.sai"

@const OUT = utf8:"758\n"
@const MN_VT = vtable { pick = @pick_min2 }

// 758 - Vtable min: min(758, 900) == 758 through indirect call.
@pick_min2(a: i64, b: i64) -> i64:
L_ENTRY:
    big = slt a, b
    br big -> L_A, L_B
L_A:
    !b
    !big
    m = add a, 0
    !a
    jmp L_OUT
L_B:
    !a
    !big
    m = add b, 0
    !b
    jmp L_OUT
L_OUT:
    ret4 = add m, 0
    !m
    return ret4

@main() -> i32:
L_ENTRY:
    t = &MN_VT
    fp = load t + 0 as ptr
    x = 758 as i64
    y = 900 as i64
    v = call_indirect fp(x, y)
    want = 758 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
