@import "sa_std/io/print.sai"

@const OUT = utf8:"742\n"

// 742 - Seq add: 700 + 40 + 2 == 742 with code 0.
@main() -> i32:
L_ENTRY:
    x = 700 as i64
    y = 40 as i64
    z = 2 as i64
    xy = add x, y
    v = add xy, z
    want = 742 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !x
    !y
    !z
    !xy
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
