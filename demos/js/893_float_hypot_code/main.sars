@import "sa_std/io/print.sai"

@const OUT = utf8:"893\n"

// 893 - Hypot-walk: 3.0^2 + 4.0^2 == 25.0 with code 0.
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    four_i = 4 as i32
    five = 5 as i32
    two_i = 2 as i32
    three_f = sitofp three as f64
    four = sitofp four_i as f64
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    q3 = fmul three_f, three_f
    q4 = fmul four, four
    h2 = fadd q3, q4
    q5 = fmul five_f, five_f
    ok_v = fcmp_eq h2, q5
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !three
    !four_i
    !five
    !two_i
    !three_f
    !four
    !five_f
    !two_f
    !q3
    !q4
    !h2
    !q5
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
