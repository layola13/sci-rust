@import "sa_std/io/print.sai"

@const OUT = utf8:"824\n"

// 824 - Scatter: 700 + 60 + 40 + 20 + 4 == 824 via 4 helpers.
@h60() -> i64:
L_ENTRY:
    return 60

@h40() -> i64:
L_ENTRY:
    return 40

@h20() -> i64:
L_ENTRY:
    return 20

@h4() -> i64:
L_ENTRY:
    return 4

@main() -> i32:
L_ENTRY:
    base = 700 as i64
    a = call @h60()
    b = call @h40()
    c = call @h20()
    d = call @h4()
    ab = add a, b
    cd = add c, d
    arms = add ab, cd
    got = add base, arms
    want = 824 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !a
    !b
    !c
    !d
    !ab
    !cd
    !arms
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
