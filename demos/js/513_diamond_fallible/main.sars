@import "sa_std/io/print.sai"
@import "left/a.sars"
@import "right/b.sars"

@const OUT = utf8:"513\n"

// 513 - Fallible diamond: both branches unpack the shared fallible
// leaf (250) and add their share (256 + 257).
@main() -> i32:
L_ENTRY:
    r0 = call @left_value()
    v0 = ?r0
    r1 = call @right_value()
    v1 = ?r1
    s = add v0, v1
    ok = eq s, 513
    !r0
    !v0
    !r1
    !v1
    !s
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
