@import "sa_std/io/print.sai"

@const OUT = utf8:"960\n"

// 960 - Arena2: 960 = 900 + 60 across arena slots, code 0.
@main() -> i32:
L_ENTRY:
    ar = alloc 16
    store ar+0, 900 as i64
    store ar+8, 60 as i64
    a = load ar+0 as i64
    b = load ar+8 as i64
    got = add a, b
    want = 960 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !ar
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
