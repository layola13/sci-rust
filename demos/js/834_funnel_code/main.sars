@import "sa_std/io/print.sai"

@const OUT = utf8:"834\n"

// 834 - Funnel: 800 + 20 + 10 + 4 == 834 via staged adds.
@f20(x: i64) -> i64:
L_ENTRY:
    k = 20 as i64
    r = add x, k
    !x
    !k
    return r

@f10(x: i64) -> i64:
L_ENTRY:
    k = 10 as i64
    r = add x, k
    !x
    !k
    return r

@f4(x: i64) -> i64:
L_ENTRY:
    k = 4 as i64
    r = add x, k
    !x
    !k
    return r

@main() -> i32:
L_ENTRY:
    base = 800 as i64
    v1 = call @f20(base)
    v2 = call @f10(v1)
    v = call @f4(v2)
    want = 834 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v1
    !v2
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
