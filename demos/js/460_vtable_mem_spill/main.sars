@import "sa_std/io/print.sai"

@const OUT = utf8:"460\n"
@const SPILL_VT = vtable { call = @spill_fn }

// 460 - vtable method spills its result through the ctx slot and
// returns it too (1.5 + 2.5 == 4.0, both paths agree).
@spill_fn(x: f64, ctx: ptr) -> f64:
    three = 3 as i32
    two_i = 2 as i32
    five = 5 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    five_f = sitofp five as f64
    two_half = fdiv five_f, two_f
    s = fadd one_half, two_half
    store ctx+0, s as f64
    !x
    !three
    !two_i
    !five
    !three_f
    !two_f
    !one_half
    !five_f
    !two_half
    return s

@main() -> i32:
    three = 3 as i32
    two_i = 2 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    t0 = &SPILL_VT
    fp0 = load t0 + 0 as ptr
    ctx0 = alloc 8
    r0 = call_indirect fp0(one_half, ctx0)
    mem = load ctx0+0 as f64
    four_i = 4 as i32
    four = sitofp four_i as f64
    ok_r = fcmp_eq r0, four
    ok_m = fcmp_eq mem, four
    ok = and ok_r, ok_m
    !three
    !two_i
    !three_f
    !two_f
    !one_half
    !fp0
    !t0
    !ctx0
    !r0
    !mem
    !four_i
    !four
    !ok_r
    !ok_m
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
