@import "sa_std/io/print.sai"

@const OUT = utf8:"782\n"

// 782 - Deep and: 4 eq pairs chained, code 0.
@main() -> i32:
L_ENTRY:
    a = 782 as i64
    b = 782 as i64
    c = 3 as i64
    d = 3 as i64
    e = 5 as i64
    f = 5 as i64
    g = 9 as i64
    h = 9 as i64
    ok0 = eq a, b
    ok1 = eq c, d
    ok2 = eq e, f
    ok3 = eq g, h
    t0 = and ok0, ok1
    t1 = and ok2, ok3
    ok = and t0, t1
    !a
    !b
    !c
    !d
    !e
    !f
    !g
    !h
    !ok0
    !ok1
    !ok2
    !ok3
    !t0
    !t1
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
