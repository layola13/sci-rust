@import "sa_std/io/print.sai"

@const OUT = utf8:"884\n"

// 884 - Cascade: 800 -> +40 -> +20 -> +12 -> +12 == 884.
@k40(x: i64) -> i64:
L_ENTRY:
    k = 40 as i64
    r = add x, k
    !x
    !k
    return r

@k20(x: i64) -> i64:
L_ENTRY:
    k = 20 as i64
    r = add x, k
    !x
    !k
    return r

@k12(x: i64) -> i64:
L_ENTRY:
    k = 12 as i64
    r = add x, k
    !x
    !k
    return r

@main() -> i32:
L_ENTRY:
    base = 800 as i64
    v1 = call @k40(base)
    v2 = call @k20(v1)
    v3 = call @k12(v2)
    v = call @k12(v3)
    want = 884 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v1
    !v2
    !v3
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
