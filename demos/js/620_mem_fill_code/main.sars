@import "sa_std/io/print.sai"

@const OUT = utf8:"620\n"

// 620 - Fill four slots with 155, sum == 620 with code 0.
@main() -> i32:
L_ENTRY:
    buf = alloc 32
    store buf+0, 155 as i64
    store buf+8, 155 as i64
    store buf+16, 155 as i64
    store buf+24, 155 as i64
    a = load buf+0 as i64
    b = load buf+8 as i64
    c = load buf+16 as i64
    d = load buf+24 as i64
    ab = add a, b
    cd = add c, d
    got = add ab, cd
    want = 620 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !buf
    !a
    !b
    !c
    !d
    !ab
    !cd
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
