@import "sa_std/io/print.sai"

@const OUT = utf8:"594\n"

// 594 - Nested 3-deep calls return 594 with code 0.
@c3(x: i64) -> i64:
L_ENTRY:
    !x
    return 594

@c2(x: i64) -> i64:
L_ENTRY:
    v = call @c3(x)
    !x
    return v

@c1(x: i64) -> i64:
L_ENTRY:
    v = call @c2(x)
    !x
    return v

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    v = call @c1(z)
    want = 594 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !z
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
