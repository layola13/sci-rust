@import "sa_std/io/print.sai"

@const OUT = utf8:"415\n"

// 415 - a value plus its negation is zero (2.5 + fneg(2.5) == 0.0).
@main() -> i32:
L_ENTRY:
    five = 5 as i32
    two_i = 2 as i32
    zero_i = 0 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    f = fdiv five_f, two_f
    n = fneg f
    s = fadd f, n
    zero = sitofp zero_i as f64
    ok = fcmp_eq s, zero
    !five
    !two_i
    !zero_i
    !five_f
    !two_f
    !f
    !n
    !s
    !zero
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
