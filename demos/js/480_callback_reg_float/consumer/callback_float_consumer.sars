@import "consumer/../bridge/callback_float_vtable.sars"

@callback_float_consumer_value() -> f64:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    t = &CALLBACK_FLOAT_VT
    fp = load t + 0 as ptr
    reg = alloc 8
    store reg+0, fp as ptr
    cb = load reg+0 as ptr
    ctx = alloc 8
    v = call_indirect cb(one_half, ctx)
    !three
    !two_i
    !three_f
    !two_f
    !one_half
    !t
    !fp
    !reg
    !cb
    !ctx
    return v
