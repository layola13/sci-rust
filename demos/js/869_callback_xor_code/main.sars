@import "sa_std/io/print.sai"

@const OUT = utf8:"869\n"
@const XOR_VT = vtable { invoke = @xor_fn }

// 869 - Callback xor: exactly-one-nonzero yields 869.
@xor_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    za = eq a, 0
    zb = eq b, 0
    same = eq za, zb
    diff = eq same, 0
    br diff -> L_HIT, L_MISS
L_HIT:
    !a
    !b
    !za
    !zb
    !same
    !diff
    return 869
L_MISS:
    !a
    !b
    !za
    !zb
    !same
    !diff
    return 0

@main() -> i32:
L_ENTRY:
    t = &XOR_VT
    fp = load t + 0 as ptr
    x = 869 as i64
    y = 0 as i64
    v = call_indirect fp(x, y)
    want = 869 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
