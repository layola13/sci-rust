@import "sa_std/io/print.sai"

@const OUT = utf8:"729\n"
@const NOT_VT = vtable { invoke = @not_fn }

// 729 - Callback not-zero: 729 nonzero yields 729 through indirect call.
@not_fn(x: i64) -> i64:
L_ENTRY:
    z = eq x, 0
    nz = eq z, 0
    br nz -> L_YES, L_NO
L_YES:
    !x
    !z
    !nz
    return 729
L_NO:
    !x
    !z
    !nz
    return 0

@main() -> i32:
L_ENTRY:
    t = &NOT_VT
    fp = load t + 0 as ptr
    v0 = 729 as i64
    v = call_indirect fp(v0)
    want = 729 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !v0
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
