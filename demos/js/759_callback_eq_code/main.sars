@import "sa_std/io/print.sai"

@const OUT = utf8:"759\n"
@const EQ_VT = vtable { invoke = @eq_fn }

// 759 - Callback eq: 759 == 759 yields 759 through indirect call.
@eq_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    same = eq a, b
    br same -> L_YES, L_NO
L_YES:
    !a
    !b
    !same
    return 759
L_NO:
    !a
    !b
    !same
    return 0

@main() -> i32:
L_ENTRY:
    t = &EQ_VT
    fp = load t + 0 as ptr
    x = 759 as i64
    y = 759 as i64
    v = call_indirect fp(x, y)
    want = 759 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
