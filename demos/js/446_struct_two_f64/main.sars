@import "sa_std/io/print.sai"

@const OUT = utf8:"446\n"

// 446 - two-field f64 struct: {1.5 @0, 2.5 @8} sums to 4.0.
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    five = 5 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    five_f = sitofp five as f64
    two_half = fdiv five_f, two_f
    buf = alloc 16
    store buf+0, one_half as f64
    store buf+8, two_half as f64
    x = load buf+0 as f64
    y = load buf+8 as f64
    s = fadd x, y
    four_i = 4 as i32
    four = sitofp four_i as f64
    ok = fcmp_eq s, four
    !three
    !two_i
    !five
    !three_f
    !two_f
    !one_half
    !five_f
    !two_half
    !buf
    !x
    !y
    !s
    !four_i
    !four
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
