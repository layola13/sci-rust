@import "sa_std/io/print.sai"

@const OUT = utf8:"827\n"

// 827 - Stride5 sum 0+5+10 == 15, plus 812 == 827.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 0 as i64
    five = 5 as i64
    jmp L_COND
L_COND:
    done = eq i, 15
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, five
    jmp L_COND
L_DONE:
    !done
    want_sum = 15 as i64
    ok_sum = eq acc, want_sum
    base = 812 as i64
    got = add acc, base
    want = 827 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !five
    !want_sum
    !ok_sum
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
