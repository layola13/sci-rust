@import "sa_std/io/print.sai"

@const OUT = utf8:"643\n"

// 643 - Float gt: 4.0 > 2.5 holds with code 0.
@main() -> i32:
L_ENTRY:
    four_i = 4 as i32
    five = 5 as i32
    two_i = 2 as i32
    four = sitofp four_i as f64
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    two_half = fdiv five_f, two_f
    gt = fcmp_gt four, two_half
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and gt, ok_c
    !four_i
    !five
    !two_i
    !four
    !five_f
    !two_f
    !two_half
    !zero
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
