@import "sa_std/io/print.sai"

@const OUT = utf8:"752\n"

// 752 - Mixed or: (0==1) or (752==752) holds, code 0.
@main() -> i32:
L_ENTRY:
    a = 0 as i64
    b = 1 as i64
    c = 752 as i64
    d = 752 as i64
    f = eq a, b
    t = eq c, d
    ok = or f, t
    !a
    !b
    !c
    !d
    !f
    !t
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
