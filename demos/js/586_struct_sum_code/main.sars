@import "sa_std/io/print.sai"

@const OUT = utf8:"586\n"

// 586 - Struct sum: fields 100 + 200 + 286 == 586, code 0.
@main() -> i32:
L_ENTRY:
    p = alloc 24
    store p+0, 100 as i64
    store p+8, 200 as i64
    store p+16, 286 as i64
    a = load p+0 as i64
    b = load p+8 as i64
    c = load p+16 as i64
    ab = add a, b
    got = add ab, c
    want = 586 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !p
    !a
    !b
    !c
    !ab
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
