@import "sa_std/io/print.sai"

@const OUT = utf8:"904\n"

// 904 - Tiered: 800 + 50 + 30 + 24 == 904 via staged adds.
@ta50(x: i64) -> i64:
L_ENTRY:
    k = 50 as i64
    r = add x, k
    !x
    !k
    return r

@ta30(x: i64) -> i64:
L_ENTRY:
    k = 30 as i64
    r = add x, k
    !x
    !k
    return r

@ta24(x: i64) -> i64:
L_ENTRY:
    k = 24 as i64
    r = add x, k
    !x
    !k
    return r

@main() -> i32:
L_ENTRY:
    base = 800 as i64
    v1 = call @ta50(base)
    v2 = call @ta30(v1)
    v = call @ta24(v2)
    want = 904 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v1
    !v2
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
