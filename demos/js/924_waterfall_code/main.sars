@import "sa_std/io/print.sai"

@const OUT = utf8:"924\n"

// 924 - Waterfall: 800 + 60 + 40 + 24 == 924 via 3 stages.
@wf60(x: i64) -> i64:
L_ENTRY:
    k = 60 as i64
    r = add x, k
    !x
    !k
    return r

@wf40(x: i64) -> i64:
L_ENTRY:
    k = 40 as i64
    r = add x, k
    !x
    !k
    return r

@wf24(x: i64) -> i64:
L_ENTRY:
    k = 24 as i64
    r = add x, k
    !x
    !k
    return r

@main() -> i32:
L_ENTRY:
    base = 800 as i64
    v1 = call @wf60(base)
    v2 = call @wf40(v1)
    v = call @wf24(v2)
    want = 924 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v1
    !v2
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
