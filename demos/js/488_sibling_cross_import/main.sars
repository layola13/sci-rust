@import "sa_std/io/print.sai"
@import "east/alpha.sars"

@const OUT = utf8:"488\n"

// 488 - Sibling cross-import: east/alpha imports west/beta across
// peer directories (400 + 88). The nested import anchors at its
// own directory (east/../west); a bare cross-directory path does
// not resolve.
@main() -> i32:
L_ENTRY:
    value = call @alpha_value()
    ok = eq value, 488
    !value
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
