@import "sa_std/io/print.sai"

@const OUT = utf8:"368\n"

// 368 - chained `?`: two fallible calls unpacked in sequence.
@add1(x: i64) -> i64!:
L_ENTRY:
    one = 1 as i64
    s = add x, one
    !x
    !one
    return s

@main() -> i32:
L_ENTRY:
    zero = 0 as i64
    r1 = call @add1(zero)
    v1 = ?r1
    r2 = call @add1(v1)
    v2 = ?r2
    ok = eq v2, 2
    !zero
    !r1
    !v1
    !r2
    !v2
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
