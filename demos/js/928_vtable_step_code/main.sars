@import "sa_std/io/print.sai"

@const OUT = utf8:"928\n"
@const STP_VT = vtable { step = @step_fn }

// 928 - Vtable step: 900 + 28 == 928 through indirect call.
@step_fn(x: i64) -> i64:
L_ENTRY:
    k = 28 as i64
    r = add x, k
    !x
    !k
    return r

@main() -> i32:
L_ENTRY:
    t = &STP_VT
    fp = load t + 0 as ptr
    v0 = 900 as i64
    v = call_indirect fp(v0)
    want = 928 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !v0
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
