@import "sa_std/io/print.sai"

@const OUT = utf8:"718\n"
@const WR_VT = vtable { wrap = @wrap_fn }

// 718 - Vtable wrap: 700 + 18 == 718 through indirect call.
@wrap_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    r = add a, b
    !a
    !b
    return r

@main() -> i32:
L_ENTRY:
    t = &WR_VT
    fp = load t + 0 as ptr
    x = 700 as i64
    y = 18 as i64
    v = call_indirect fp(x, y)
    want = 718 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
