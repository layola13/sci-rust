@import "sa_std/io/print.sai"

@const OUT = utf8:"684\n"

// 684 - Fan-out: 4 leaves each return 171, sum == 684.
@leaf() -> i64:
L_ENTRY:
    return 171

@main() -> i32:
L_ENTRY:
    a = call @leaf()
    b = call @leaf()
    c = call @leaf()
    d = call @leaf()
    ab = add a, b
    cd = add c, d
    got = add ab, cd
    want = 684 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !a
    !b
    !c
    !d
    !ab
    !cd
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
