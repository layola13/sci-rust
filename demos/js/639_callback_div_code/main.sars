@import "sa_std/io/print.sai"

@const OUT = utf8:"639\n"
@const D2_VT = vtable { invoke = @half_fn }

// 639 - Callback halve: 1278 - 639 == 639 through indirect call.
@half_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    r = sub a, b
    !a
    !b
    return r

@main() -> i32:
L_ENTRY:
    t = &D2_VT
    fp = load t + 0 as ptr
    x = 1278 as i64
    y = 639 as i64
    v = call_indirect fp(x, y)
    want = 639 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
