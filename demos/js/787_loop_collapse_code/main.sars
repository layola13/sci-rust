@import "sa_std/io/print.sai"

@const OUT = utf8:"787\n"

// 787 - Collapse: sum 1..9 step 2 (1+3+5+7+9 == 25), plus 762.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 1 as i64
    two = 2 as i64
    jmp L_COND
L_COND:
    done = eq i, 11
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, two
    jmp L_COND
L_DONE:
    !done
    want_sum = 25 as i64
    ok_sum = eq acc, want_sum
    base = 762 as i64
    got = add acc, base
    want = 787 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !two
    !want_sum
    !ok_sum
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
