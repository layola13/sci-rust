@import "sa_std/io/print.sai"

@const OUT = utf8:"528\n"

// 528 - Comparisons drive codes: 2.5 vs 3.0 -> -1, 3.0 vs 2.5 -> 1,
// 2.5 vs 2.5 -> 0 (value passes through untouched).
@cmp_code(a: f64, b: f64) -> i64:
L_ENTRY:
    lt = fcmp_lt a, b
    br lt -> L_LT, L_GE
L_LT:
    !a
    !b
    !lt
    neg_one = sub 0, 1
    return neg_one
L_GE:
    gt = fcmp_gt a, b
    br gt -> L_GT, L_EQ
L_GT:
    !a
    !b
    !lt
    !gt
    return 1
L_EQ:
    !a
    !b
    !lt
    !gt
    return 0

@main() -> i32:
L_ENTRY:
    five = 5 as i32
    two_i = 2 as i32
    three_i = 3 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    three_f = sitofp three_i as f64
    two_half = fdiv five_f, two_f
    three_whole = sitofp three_i as f64
    c0 = call @cmp_code(two_half, three_whole)
    c1 = call @cmp_code(three_whole, two_half)
    c2 = call @cmp_code(two_half, two_half)
    ok0 = eq c0, -1
    ok1 = eq c1, 1
    ok2 = eq c2, 0
    t = and ok0, ok1
    ok = and t, ok2
    !five
    !two_i
    !three_i
    !five_f
    !two_f
    !three_f
    !two_half
    !three_whole
    !c0
    !c1
    !c2
    !ok0
    !ok1
    !ok2
    !t
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
