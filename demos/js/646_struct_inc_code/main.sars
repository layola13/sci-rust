@import "sa_std/io/print.sai"

@const OUT = utf8:"646\n"

// 646 - Struct inc: load 645, add 1 == 646, code 0.
@main() -> i32:
L_ENTRY:
    p = alloc 8
    store p+0, 645 as i64
    v0 = load p+0 as i64
    one = 1 as i64
    got = add v0, one
    want = 646 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !p
    !v0
    !one
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
