@import "sa_std/io/print.sai"

@const OUT = utf8:"953\n"

// 953 - Float step: 0.5 * 4.0 + 1.5 == 3.5 with code 0.
@main() -> i32:
L_ENTRY:
    one = 1 as i32
    two_i = 2 as i32
    three = 3 as i32
    four_i = 4 as i32
    seven = 7 as i32
    one_f = sitofp one as f64
    two_f = sitofp two_i as f64
    three_f = sitofp three as f64
    four = sitofp four_i as f64
    seven_f = sitofp seven as f64
    half = fdiv one_f, two_f
    step = fmul half, four
    one_half = fdiv three_f, two_f
    got = fadd step, one_half
    expect = fdiv seven_f, two_f
    ok_v = fcmp_eq got, expect
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !one
    !two_i
    !three
    !four_i
    !seven
    !one_f
    !two_f
    !three_f
    !four
    !seven_f
    !half
    !step
    !one_half
    !got
    !expect
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
