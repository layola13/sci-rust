@import "sa_std/io/print.sai"
@import "sa_std/ts_string.sars"

@const WORD = utf8:"abcd"
@const OUT = utf8:"335\n"

// 335 - ts_str_slice with inverted bounds returns empty.
//
// slice(3,1) must clamp to an empty handle (f = s) instead of
// underflowing nlen (f - s wraps to a huge u64 and aborts downstream).
@main() -> i32:
L_ENTRY:
    h = call @ts_str_slice(&WORD, 4, 3, 1, 0)
    nlen = load h+8 as u64
    ok = eq nlen, 0
    !h
    !nlen
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
