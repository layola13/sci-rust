@import "sa_std/io/print.sai"

@const OUT = utf8:"867\n"

// 867 - Range sum 5..9 == 35, plus 832 == 867.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 5 as i64
    one = 1 as i64
    jmp L_COND
L_COND:
    done = eq i, 10
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, one
    jmp L_COND
L_DONE:
    !done
    want_sum = 35 as i64
    ok_sum = eq acc, want_sum
    base = 832 as i64
    got = add acc, base
    want = 867 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !one
    !want_sum
    !ok_sum
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
