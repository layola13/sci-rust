@import "sa_std/io/print.sai"
@import "left/a.sars"
@import "right/b.sars"

@const OUT = utf8:"486\n"

// 486 - Diamond dependency: left/a and right/b both import the
// shared leaf (200); 240 + 246 == 486. Nested imports anchor at
// their own directory (left/../shared), matching repo convention.
@main() -> i32:
L_ENTRY:
    a = call @a_value()
    b = call @b_value()
    s = add a, b
    ok = eq s, 486
    !a
    !b
    !s
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
