@import "sa_std/io/print.sai"

@const OUT = utf8:"804\n"

// 804 - Gather: 5 sources (700,50,30,20,4) sum == 804.
@g1() -> i64:
L_ENTRY:
    return 700

@g2() -> i64:
L_ENTRY:
    return 50

@g3() -> i64:
L_ENTRY:
    return 30

@g4() -> i64:
L_ENTRY:
    return 20

@g5() -> i64:
L_ENTRY:
    return 4

@main() -> i32:
L_ENTRY:
    a = call @g1()
    b = call @g2()
    c = call @g3()
    d = call @g4()
    e = call @g5()
    ab = add a, b
    cd = add c, d
    s0 = add ab, cd
    got = add s0, e
    want = 804 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !a
    !b
    !c
    !d
    !e
    !ab
    !cd
    !s0
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
