@import "sa_std/io/print.sai"

@const OUT = utf8:"732\n"

// 732 - Xor-chain via eq-pairs: (700==700) != (1==0) holds, code 0.
@main() -> i32:
L_ENTRY:
    a = 700 as i64
    b = 700 as i64
    c = 1 as i64
    d = 0 as i64
    e = 32 as i64
    f = 32 as i64
    ok0 = eq a, b
    ok1 = eq c, d
    ok2 = eq e, f
    same = eq ok0, ok1
    diff = eq same, 0
    ok = and diff, ok2
    !a
    !b
    !c
    !d
    !e
    !f
    !ok0
    !ok1
    !ok2
    !same
    !diff
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
