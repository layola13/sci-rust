@import "sa_std/io/print.sai"

@const OUT = utf8:"536\n"

// 536 - Loop accumulates 1+2+3+4 = 10 with code 0 on exit.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 1 as i64
    jmp L_COND
L_COND:
    done = eq i, 5
    br done -> L_DONE, L_BODY
L_BODY:
    acc = add acc, i
    i = add i, 1
    !done
    jmp L_COND
L_DONE:
    !done
    ten = 10 as i64
    ok_sum = eq acc, ten
    zero = 0 as i64
    ok_code = eq zero, 0
    ok = and ok_sum, ok_code
    !acc
    !i
    !ten
    !zero
    !ok_sum
    !ok_code
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
