@import "sa_std/io/print.sai"

@const OUT = utf8:"771\n"

// 771 - Chain13: 758 + 13 == 771 with code 0.
@add13(x: i64) -> i64:
L_ENTRY:
    t = 13 as i64
    r = add x, t
    !x
    !t
    return r

@main() -> i32:
L_ENTRY:
    base = 758 as i64
    v = call @add13(base)
    want = 771 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
