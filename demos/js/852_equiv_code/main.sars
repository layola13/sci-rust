@import "sa_std/io/print.sai"

@const OUT = utf8:"852\n"

// 852 - Equiv: (0==0) iff (852==852) holds, code 0.
@main() -> i32:
L_ENTRY:
    a = 0 as i64
    b = 0 as i64
    c = 852 as i64
    d = 852 as i64
    p = eq a, b
    q = eq c, d
    iff = eq p, q
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and iff, ok_c
    !a
    !b
    !c
    !d
    !p
    !q
    !iff
    !zero
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
