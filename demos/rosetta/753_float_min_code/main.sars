@import "sa_std/io/print.sai"

@const OUT = utf8:"753\n"

// 753 - Float min: min(2.5, 4.0) == 2.5 via lt-select, code 0.
@main() -> i32:
L_ENTRY:
    five = 5 as i32
    two_i = 2 as i32
    four_i = 4 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    four = sitofp four_i as f64
    two_half = fdiv five_f, two_f
    small = fcmp_lt two_half, four
    z0 = 0 as i32
    zf = sitofp z0 as f64
    br small -> L_TAKE_S, L_TAKE_B
L_TAKE_S:
    !small
    m = fadd two_half, zf
    jmp L_OUT
L_TAKE_B:
    !small
    m = fadd four, zf
    jmp L_OUT
L_OUT:
    ok_v = fcmp_eq m, two_half
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !five
    !two_i
    !four_i
    !five_f
    !two_f
    !two_half
    !four
    !z0
    !zf
    !m
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
