@import "sa_std/io/print.sai"

@const OUT = utf8:"597\n"

// 597 - Loop sums 0..10 step 1 then checks 55 + 542 == 597.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 0 as i64
    one = 1 as i64
    jmp L_COND
L_COND:
    done = eq i, 11
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, one
    jmp L_COND
L_DONE:
    !done
    fifty = 55 as i64
    ok_sum = eq acc, fifty
    extra = 542 as i64
    got = add acc, extra
    want = 597 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !one
    !fifty
    !ok_sum
    !extra
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
