@import "sa_std/io/print.sai"

@const OUT = utf8:"638\n"
@const S2_VT = vtable { calc = @calc_sub2 }

// 638 - Vtable sub: 700 - 62 == 638 through indirect call.
@calc_sub2(a: i64, b: i64) -> i64:
L_ENTRY:
    r = sub a, b
    !a
    !b
    return r

@main() -> i32:
L_ENTRY:
    t = &S2_VT
    fp = load t + 0 as ptr
    x = 700 as i64
    y = 62 as i64
    v = call_indirect fp(x, y)
    want = 638 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
