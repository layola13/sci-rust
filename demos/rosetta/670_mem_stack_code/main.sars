@import "sa_std/io/print.sai"

@const OUT = utf8:"670\n"

// 670 - Stack walk: bump 4 slots, sum 100+170+200+200 == 670.
@main() -> i32:
L_ENTRY:
    s0 = alloc 8
    s1 = alloc 8
    s2 = alloc 8
    s3 = alloc 8
    store s0+0, 100 as i64
    store s1+0, 170 as i64
    store s2+0, 200 as i64
    store s3+0, 200 as i64
    a = load s0+0 as i64
    b = load s1+0 as i64
    c = load s2+0 as i64
    d = load s3+0 as i64
    ab = add a, b
    cd = add c, d
    got = add ab, cd
    want = 670 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !s0
    !s1
    !s2
    !s3
    !a
    !b
    !c
    !d
    !ab
    !cd
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
