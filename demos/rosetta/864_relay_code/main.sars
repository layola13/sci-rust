@import "sa_std/io/print.sai"

@const OUT = utf8:"864\n"

// 864 - Relay: 800 -> +32 -> +32 == 864 via two stages.
@stg_a(x: i64) -> i64:
L_ENTRY:
    k = 32 as i64
    r = add x, k
    !x
    !k
    return r

@stg_b(x: i64) -> i64:
L_ENTRY:
    k = 32 as i64
    r = add x, k
    !x
    !k
    return r

@main() -> i32:
L_ENTRY:
    base = 800 as i64
    v1 = call @stg_a(base)
    v = call @stg_b(v1)
    want = 864 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v1
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
