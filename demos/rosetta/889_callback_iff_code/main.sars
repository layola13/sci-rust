@import "sa_std/io/print.sai"

@const OUT = utf8:"889\n"
@const IF2_VT = vtable { invoke = @iff_fn }

// 889 - Callback iff: (889==889) iff (2==2) yields 889.
@iff_fn(a: i64, b: i64) -> i64:
L_ENTRY:
    pa = eq a, 889
    pb = eq b, 2
    iff = eq pa, pb
    br iff -> L_HIT, L_MISS
L_HIT:
    !a
    !b
    !pa
    !pb
    !iff
    return 889
L_MISS:
    !a
    !b
    !pa
    !pb
    !iff
    return 0

@main() -> i32:
L_ENTRY:
    t = &IF2_VT
    fp = load t + 0 as ptr
    x = 889 as i64
    y = 2 as i64
    v = call_indirect fp(x, y)
    want = 889 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !x
    !y
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
