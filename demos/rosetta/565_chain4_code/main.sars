@import "sa_std/io/print.sai"

@const OUT = utf8:"565\n"

// 565 - Chain of 4 calls returns 565 with code 0.
@k4(x: i64) -> i64:
L_ENTRY:
    !x
    return 565

@k3(x: i64) -> i64:
L_ENTRY:
    v = call @k4(x)
    !x
    return v

@k2(x: i64) -> i64:
L_ENTRY:
    v = call @k3(x)
    !x
    return v

@k1(x: i64) -> i64:
L_ENTRY:
    v = call @k2(x)
    !x
    return v

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    v = call @k1(z)
    want = 565 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !z
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
