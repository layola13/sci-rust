@import "sa_std/io/print.sai"

@const OUT = utf8:"751\n"

// 751 - Chain11: 740 + 11 == 751 with code 0.
@add11(x: i64) -> i64:
L_ENTRY:
    e = 11 as i64
    r = add x, e
    !x
    !e
    return r

@main() -> i32:
L_ENTRY:
    base = 740 as i64
    v = call @add11(base)
    want = 751 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
