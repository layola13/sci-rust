@import "sa_std/io/print.sai"

@const OUT = utf8:"630\n"

// 630 - Swap two slots: (600, 30) exchanged and re-added == 630.
@main() -> i32:
L_ENTRY:
    buf = alloc 16
    store buf+0, 600 as i64
    store buf+8, 30 as i64
    a = load buf+0 as i64
    b = load buf+8 as i64
    store buf+0, b as i64
    store buf+8, a as i64
    c = load buf+0 as i64
    d = load buf+8 as i64
    got = add c, d
    want = 630 as i64
    ok_v = eq got, want
    ok_swap = eq c, 30
    ok = and ok_v, ok_swap
    !buf
    !a
    !b
    !c
    !d
    !got
    !want
    !ok_v
    !ok_swap
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
