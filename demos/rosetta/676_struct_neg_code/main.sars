@import "sa_std/io/print.sai"

@const OUT = utf8:"676\n"

// 676 - Neg struct: 700 - 24 == 676 via fields, code 0.
@main() -> i32:
L_ENTRY:
    p = alloc 16
    store p+0, 700 as i64
    store p+8, 24 as i64
    a = load p+0 as i64
    b = load p+8 as i64
    got = sub a, b
    want = 676 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !p
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
