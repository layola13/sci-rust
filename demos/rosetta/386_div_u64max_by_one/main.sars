@import "sa_std/io/print.sai"

@const OUT = utf8:"386\n"

// 386 - the `div` alias follows operand signedness: u64-max / 1 stays
// u64-max (unsigned). Forced-signed lowering would wrap it to -1.
// (The u64 divisor is trunc-forced: bare `1 as u64` folds to i64,
// which would force the signed path on both backends.)
@main() -> i32:
L_ENTRY:
    max = 18446744073709551615 as u64
    o = 1 as i64
    one64 = trunc o as u64
    d = div max, one64
    ok = eq d, max
    !max
    !o
    !one64
    !d
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
