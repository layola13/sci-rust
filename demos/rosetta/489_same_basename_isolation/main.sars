@import "sa_std/io/print.sai"
@import "foo/common.sars"
@import "bar/common.sars"

@const OUT = utf8:"489\n"

// 489 - Same-basename isolation: foo/common.sa and bar/common.sa
// coexist; directory-prefixed symbols keep them apart (400 + 89).
@main() -> i32:
L_ENTRY:
    a = call @foo_common_value()
    b = call @bar_common_value()
    s = add a, b
    ok = eq s, 489
    !a
    !b
    !s
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
