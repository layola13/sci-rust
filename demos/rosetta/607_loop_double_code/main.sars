@import "sa_std/io/print.sai"

@const OUT = utf8:"607\n"

// 607 - Loop doubles: 1+2+4 == 7, plus 600 == 607 with code 0.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 1 as i64
    jmp L_COND
L_COND:
    done = eq i, 8
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, i
    jmp L_COND
L_DONE:
    !done
    seven = 7 as i64
    ok_sum = eq acc, seven
    base = 600 as i64
    got = add acc, base
    want = 607 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !seven
    !base
    !ok_sum
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
