@import "sa_std/io/print.sai"

@const OUT = utf8:"562\n"

// 562 - slt int compare: 3 < 5 holds with code 0.
@main() -> i32:
L_ENTRY:
    a = 3 as i64
    b = 5 as i64
    lt = slt a, b
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and lt, ok_c
    !a
    !b
    !zero
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
