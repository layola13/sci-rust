@import "sa_std/io/print.sai"

@const OUT = utf8:"560\n"
@const DUAL_VT = vtable { first = @ret_zero, second = @ret_one }

// 560 - Dual vtable slots return 0 and 1, combined code check.
@ret_zero(dummy: i64) -> i64:
L_ENTRY:
    !dummy
    return 0

@ret_one(dummy: i64) -> i64:
L_ENTRY:
    !dummy
    return 1

@main() -> i32:
L_ENTRY:
    t = &DUAL_VT
    fp0 = load t + 0 as ptr
    fp1 = load t + 8 as ptr
    z = 0 as i64
    c0 = call_indirect fp0(z)
    c1 = call_indirect fp1(z)
    ok0 = eq c0, 0
    ok1 = eq c1, 1
    ok = and ok0, ok1
    !t
    !fp0
    !fp1
    !z
    !c0
    !c1
    !ok0
    !ok1
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
