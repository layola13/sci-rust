@import "sa_std/io/print.sai"

@const OUT = utf8:"552\n"

// 552 - Nested call chain depth 4 threads value 552 with code 0.
@l3(x: i64) -> i64:
L_ENTRY:
    !x
    return 552

@l2(x: i64) -> i64:
L_ENTRY:
    v = call @l3(x)
    !x
    return v

@l1(x: i64) -> i64:
L_ENTRY:
    v = call @l2(x)
    !x
    return v

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    v = call @l1(z)
    want = 552 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !z
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
