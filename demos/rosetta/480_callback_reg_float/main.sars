@import "sa_std/io/print.sai"
@import "consumer/callback_float_consumer.sars"

@const OUT = utf8:"480\n"

// 480 - Contract Callback Registration (float): the callback vtable
// lives in bridge/callback_float_vtable.sa; the consumer owns the
// registry slot and the indirect call (2 x 1.5 == 3.0).
@main() -> i32:
L_ENTRY:
    value = call @callback_float_consumer_value()
    three_i = 3 as i32
    three = sitofp three_i as f64
    ok = fcmp_eq value, three
    !value
    !three_i
    !three
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
