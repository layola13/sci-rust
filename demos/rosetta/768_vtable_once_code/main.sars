@import "sa_std/io/print.sai"

@const OUT = utf8:"768\n"
@const ON_VT = vtable { once = @once_fn }

// 768 - Vtable once: single slot returns 768, code 0.
@once_fn(dummy: i64) -> i64:
L_ENTRY:
    !dummy
    return 768

@main() -> i32:
L_ENTRY:
    t = &ON_VT
    fp = load t + 0 as ptr
    z = 0 as i64
    v = call_indirect fp(z)
    want = 768 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !z
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
