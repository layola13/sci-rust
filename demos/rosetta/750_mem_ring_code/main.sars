@import "sa_std/io/print.sai"

@const OUT = utf8:"750\n"

// 750 - Ring: rotate (700, 30, 20) -> (30, 20, 700), sum == 750.
@main() -> i32:
L_ENTRY:
    buf = alloc 24
    store buf+0, 700 as i64
    store buf+8, 30 as i64
    store buf+16, 20 as i64
    a = load buf+0 as i64
    b = load buf+8 as i64
    c = load buf+16 as i64
    store buf+0, b as i64
    store buf+8, c as i64
    store buf+16, a as i64
    x = load buf+0 as i64
    y = load buf+8 as i64
    z = load buf+16 as i64
    xy = add x, y
    got = add xy, z
    want = 750 as i64
    ok_v = eq got, want
    ok_rot = eq x, 30
    ok = and ok_v, ok_rot
    !buf
    !a
    !b
    !c
    !x
    !y
    !z
    !xy
    !got
    !want
    !ok_v
    !ok_rot
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
