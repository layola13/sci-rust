@import "sa_std/io/print.sai"

@const OUT = utf8:"379\n"

// 379 - f32 memory roundtrip (1.5 is exact in f32; bits survive the
// store/load through the DataView).
@main() -> i32:
L_ENTRY:
    a = 3 as i32
    b = 2 as i32
    fa = sitofp a as f64
    fb = sitofp b as f64
    f = fdiv fa, fb
    t = fptrunc f as f32
    buf = alloc 8
    store buf+0, t as f32
    g = load buf+0 as f32
    ok = fcmp_eq g, t
    !a
    !b
    !fa
    !fb
    !f
    !t
    !buf
    !g
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
