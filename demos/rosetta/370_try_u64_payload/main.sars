@import "sa_std/io/print.sai"

@const OUT = utf8:"370\n"

// 370 - `?` carries 64-bit payloads (BigInt through {s, v} objects).
@big() -> u64!:
L_ENTRY:
    return 4294967296

@main() -> i32:
L_ENTRY:
    r = call @big()
    v = ?r
    ok = eq v, 4294967296
    !r
    !v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
