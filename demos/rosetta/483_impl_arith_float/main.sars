@import "sa_std/io/print.sai"
@import "consumer/impl_arith_consumer.sars"

@const OUT = utf8:"483\n"

// 483 - Contract Const Export with impl-side arithmetic: the impl
// computes 1.5 + 2.5 behind the export boundary (4.0); the consumer
// passes it through.
@main() -> i32:
L_ENTRY:
    value = call @impl_arith_consumer_value()
    four_i = 4 as i32
    four = sitofp four_i as f64
    ok = fcmp_eq value, four
    !value
    !four_i
    !four
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
