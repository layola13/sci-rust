@import "consumer/../bridge/cb.sars"

// Same rule as 519/464: the indirect call stays plain, the direct
// wrapper carries the fallible contract.
@export invoke_add() -> i64!:
L_ENTRY:
    t = &CB_VT
    fp = load t + 0 as ptr
    reg = alloc 8
    store reg+0, fp as ptr
    cb = load reg+0 as ptr
    ctx = alloc 8
    base = add 500, 0
    v = call_indirect cb(base, ctx)
    !t
    !fp
    !reg
    !cb
    !ctx
    !base
    return v
