@import "sa_std/io/print.sai"

@const OUT = utf8:"810\n"

// 810 - Blocks: 810 = 400 + 410 across two allocs, code 0.
@main() -> i32:
L_ENTRY:
    p = alloc 8
    q = alloc 8
    store p+0, 400 as i64
    store q+0, 410 as i64
    a = load p+0 as i64
    b = load q+0 as i64
    got = add a, b
    want = 810 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !p
    !q
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
