@import "sa_std/io/print.sai"

@const OUT = utf8:"702\n"

// 702 - Call through helper: 700 + 2 == 702 with code 0.
@plus2(x: i64) -> i64:
L_ENTRY:
    two = 2 as i64
    r = add x, two
    !x
    !two
    return r

@main() -> i32:
L_ENTRY:
    base = 700 as i64
    v = call @plus2(base)
    want = 702 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
