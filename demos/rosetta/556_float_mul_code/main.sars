@import "sa_std/io/print.sai"

@const OUT = utf8:"556\n"

// 556 - Float mul: 1.5 * 4.0 == 6.0 with code 0 (value family).
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    four_i = 4 as i32
    six_i = 6 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    four = sitofp four_i as f64
    six = sitofp six_i as f64
    one_half = fdiv three_f, two_f
    got = fmul one_half, four
    ok_v = fcmp_eq got, six
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !three
    !two_i
    !four_i
    !six_i
    !three_f
    !two_f
    !four
    !six
    !one_half
    !got
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
