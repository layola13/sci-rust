@import "sa_std/io/print.sai"

@const OUT = utf8:"927\n"

// 927 - Stride8 sum 0+8 == 8, plus 919 == 927.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 0 as i64
    eight = 8 as i64
    jmp L_COND
L_COND:
    done = eq i, 16
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, eight
    jmp L_COND
L_DONE:
    !done
    want_sum = 8 as i64
    ok_sum = eq acc, want_sum
    base = 919 as i64
    got = add acc, base
    want = 927 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !eight
    !want_sum
    !ok_sum
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
