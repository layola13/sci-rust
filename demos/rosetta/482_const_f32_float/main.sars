@import "sa_std/io/print.sai"
@import "consumer/float32_consumer.sars"

@const OUT = utf8:"482\n"

// 482 - Contract Const Export (f32): the exported const lives in
// impl/float32_const_impl.sa (1.5f); the consumer doubles it (3.0f).
@main() -> i32:
L_ENTRY:
    value = call @float32_consumer_value()
    three_i = 3 as i32
    three_whole = sitofp three_i as f64
    three = fptrunc three_whole as f32
    ok = fcmp_eq value, three
    !value
    !three_i
    !three_whole
    !three
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
