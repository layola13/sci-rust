@export map_code_to_float(code: i64) -> f64:
L_ENTRY:
    c = eq code, 7
    br c -> L_HIT, L_MISS
L_HIT:
    five = 5 as i32
    two = 2 as i32
    five_f = sitofp five as f64
    two_f = sitofp two as f64
    h = fdiv five_f, two_f
    !code
    !c
    !five
    !two
    !five_f
    !two_f
    return h
L_MISS:
    one_i = 1 as i32
    two_i = 2 as i32
    one_f = sitofp one_i as f64
    two_f = sitofp two_i as f64
    h = fdiv one_f, two_f
    !code
    !c
    !one_i
    !two_i
    !one_f
    !two_f
    return h
