@import "sa_std/io/print.sai"

@const OUT = utf8:"535\n"

// 535 - Branchy int codes: tag 0 -> 0, tag 1 -> 7, both mapped.
@pick(tag: i64) -> i64:
L_ENTRY:
    c = eq tag, 0
    br c -> L_SMALL, L_BIG
L_SMALL:
    !tag
    !c
    return 0
L_BIG:
    !tag
    !c
    return 7

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    o = 1 as i64
    c0 = call @pick(z)
    c1 = call @pick(o)
    ok0 = eq c0, 0
    ok1 = eq c1, 7
    ok = and ok0, ok1
    !z
    !o
    !c0
    !c1
    !ok0
    !ok1
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
