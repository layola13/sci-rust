@import "sa_std/io/print.sai"
@import "consumer/param_vtable_consumer.sars"

@const OUT = utf8:"485\n"

// 485 - Contract Vtable Export with parameter: the bridge vtable
// method doubles its f64 argument (2 x 1.5 == 3.0); the consumer
// owns the indirect call.
@main() -> i32:
L_ENTRY:
    three = 3 as i32
    two_i = 2 as i32
    three_f = sitofp three as f64
    two_f = sitofp two_i as f64
    one_half = fdiv three_f, two_f
    value = call @param_vtable_consumer_value(one_half)
    ok = fcmp_eq value, three_f
    !three
    !two_i
    !three_f
    !two_f
    !one_half
    !value
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
