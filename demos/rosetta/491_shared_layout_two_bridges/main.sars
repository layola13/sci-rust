@import "sa_std/io/print.sai"
@import "consumer/sum.sars"

@const OUT = utf8:"491\n"

// 491 - Shared layout: left and right bridges import the same
// layout/dims.sal; the consumer allocates one struct, each bridge
// fills its own field (1.5 + 2.5 == 4.0).
@main() -> i32:
L_ENTRY:
    value = call @consumer_sum()
    four_i = 4 as i32
    four = sitofp four_i as f64
    ok = fcmp_eq value, four
    !value
    !four_i
    !four
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
