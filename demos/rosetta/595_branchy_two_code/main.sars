@import "sa_std/io/print.sai"

@const OUT = utf8:"595\n"

// 595 - Branchy two tags: 0 -> 0, 4 -> 7, both verified.
@pick(tag: i64) -> i64:
L_ENTRY:
    c = eq tag, 0
    br c -> L_SMALL, L_BIG
L_SMALL:
    !tag
    !c
    return 0
L_BIG:
    !tag
    !c
    return 7

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    f = 4 as i64
    c0 = call @pick(z)
    c1 = call @pick(f)
    ok0 = eq c0, 0
    ok1 = eq c1, 7
    ok = and ok0, ok1
    !z
    !f
    !c0
    !c1
    !ok0
    !ok1
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
