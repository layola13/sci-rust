@import "sa_std/io/print.sai"

@const OUT = utf8:"871\n"

// 871 - Chain23: 848 + 23 == 871 with code 0.
@add23(x: i64) -> i64:
L_ENTRY:
    t = 23 as i64
    r = add x, t
    !x
    !t
    return r

@main() -> i32:
L_ENTRY:
    base = 848 as i64
    v = call @add23(base)
    want = 871 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !base
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
