@import "sa_std/io/print.sai"

@const OUT = utf8:"580\n"

// 580 - Single f64 spill: 2.5 round-trips through slot, code 0.
@main() -> i32:
L_ENTRY:
    five = 5 as i32
    two_i = 2 as i32
    five_f = sitofp five as f64
    two_f = sitofp two_i as f64
    expect = fdiv five_f, two_f
    slot = alloc 8
    store slot+0, expect as f64
    back = load slot+0 as f64
    ok_v = fcmp_eq back, expect
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !five
    !two_i
    !five_f
    !two_f
    !expect
    !slot
    !back
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
