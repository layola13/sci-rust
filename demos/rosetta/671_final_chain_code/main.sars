@import "sa_std/io/print.sai"

@const OUT = utf8:"671\n"

// 671 - Final chain: base 660 plus step 11 == 671, code 0.
@step11(x: i64) -> i64:
L_ENTRY:
    e = 11 as i64
    r = add x, e
    !x
    !e
    return r

@guard671(fail: i64) -> i64:
L_ENTRY:
    bad = eq fail, 1
    br bad -> L_FAIL, L_SUCC
L_SUCC:
    !fail
    !bad
    return 0
L_FAIL:
    !fail
    !bad
    return 7

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    code = call @guard671(z)
    base = 660 as i64
    v = call @step11(base)
    want = 671 as i64
    ok_v = eq v, want
    ok_c = eq code, 0
    ok = and ok_v, ok_c
    !z
    !code
    !base
    !v
    !want
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
