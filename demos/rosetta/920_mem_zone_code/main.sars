@import "sa_std/io/print.sai"

@const OUT = utf8:"920\n"

// 920 - Zone: 920 = 800 + 120 across zone slots, code 0.
@main() -> i32:
L_ENTRY:
    zn = alloc 16
    store zn+0, 800 as i64
    store zn+8, 120 as i64
    a = load zn+0 as i64
    b = load zn+8 as i64
    got = add a, b
    want = 920 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !zn
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
