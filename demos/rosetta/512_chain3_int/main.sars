@import "sa_std/io/print.sai"
@import "c/top.sars"

@const OUT = utf8:"512\n"

// 512 - Fallible chain across three files (500 + 10 + 2); each layer
// unpacks with `?` and re-wraps its return.
@main() -> i32:
L_ENTRY:
    r = call @chain_c()
    v = ?r
    ok = eq v, 512
    !r
    !v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
