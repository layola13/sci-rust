@import "sa_std/io/print.sai"

@const OUT = utf8:"644\n"

// 644 - Chain of 9 calls returns 644 with code 0.
@r9(x: i64) -> i64:
L_ENTRY:
    !x
    return 644

@r7(x: i64) -> i64:
L_ENTRY:
    v = call @r9(x)
    !x
    return v

@r5(x: i64) -> i64:
L_ENTRY:
    v = call @r7(x)
    !x
    return v

@r3(x: i64) -> i64:
L_ENTRY:
    v = call @r5(x)
    !x
    return v

@r1(x: i64) -> i64:
L_ENTRY:
    v = call @r3(x)
    !x
    return v

@main() -> i32:
L_ENTRY:
    z = 0 as i64
    v = call @r1(z)
    want = 644 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !z
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
