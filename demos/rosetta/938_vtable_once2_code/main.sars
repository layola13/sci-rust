@import "sa_std/io/print.sai"

@const OUT = utf8:"938\n"
@const ON2_VT = vtable { once = @once2_fn }

// 938 - Vtable once2: slot returns 938 via arg echo, code 0.
@once2_fn(x: i64) -> i64:
L_ENTRY:
    base = 900 as i64
    d = sub x, base
    got = add base, d
    !x
    !base
    !d
    return got

@main() -> i32:
L_ENTRY:
    t = &ON2_VT
    fp = load t + 0 as ptr
    v0 = 938 as i64
    v = call_indirect fp(v0)
    want = 938 as i64
    ok_v = eq v, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !t
    !fp
    !v0
    !v
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
