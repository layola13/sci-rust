@import "sa_std/io/print.sai"
@import "l1/top.sars"

@const OUT = utf8:"518\n"

// 518 - Three-deep nested fallible unpacking across directories
// (500 + 10 + 8).
@main() -> i32:
L_ENTRY:
    r = call @l1_value()
    v = ?r
    ok = eq v, 518
    !r
    !v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
