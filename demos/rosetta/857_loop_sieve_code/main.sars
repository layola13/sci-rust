@import "sa_std/io/print.sai"

@const OUT = utf8:"857\n"

// 857 - Sieve count: odds in 1..9 are 1,3,5,7,9 (5 odds),
// 5 * 100 + 357 == 857.
@main() -> i32:
L_ENTRY:
    cnt = 0 as i64
    i = 1 as i64
    two = 2 as i64
    jmp L_COND
L_COND:
    done = eq i, 11
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    cnt = add cnt, 1
    i = add i, two
    jmp L_COND
L_DONE:
    !done
    five = 5 as i64
    ok_cnt = eq cnt, five
    hund = 100 as i64
    s0 = add cnt, hund
    s1 = add s0, hund
    s2 = add s1, hund
    s3 = add s2, hund
    s4 = add s3, hund
    rest = 352 as i64
    got = add s4, rest
    want = 857 as i64
    ok_v = eq got, want
    ok = and ok_cnt, ok_v
    !cnt
    !i
    !two
    !five
    !ok_cnt
    !hund
    !s0
    !s1
    !s2
    !s3
    !s4
    !rest
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
