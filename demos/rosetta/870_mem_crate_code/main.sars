@import "sa_std/io/print.sai"

@const OUT = utf8:"870\n"

// 870 - Crate: 870 = 800 + 70 across crate slots, code 0.
@main() -> i32:
L_ENTRY:
    cr = alloc 16
    store cr+0, 800 as i64
    store cr+8, 70 as i64
    a = load cr+0 as i64
    b = load cr+8 as i64
    got = add a, b
    want = 870 as i64
    ok_v = eq got, want
    zero = 0 as i64
    ok_c = eq zero, 0
    ok = and ok_v, ok_c
    !cr
    !a
    !b
    !got
    !want
    !zero
    !ok_v
    !ok_c
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
