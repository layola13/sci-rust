@import "sa_std/io/print.sai"

@const OUT = utf8:"947\n"

// 947 - Stride9 sum 0+9 == 9, plus 938 == 947.
@main() -> i32:
L_ENTRY:
    acc = 0 as i64
    i = 0 as i64
    nine = 9 as i64
    jmp L_COND
L_COND:
    done = eq i, 18
    br done -> L_DONE, L_BODY
L_BODY:
    !done
    acc = add acc, i
    i = add i, nine
    jmp L_COND
L_DONE:
    !done
    want_sum = 9 as i64
    ok_sum = eq acc, want_sum
    base = 938 as i64
    got = add acc, base
    want = 947 as i64
    ok_v = eq got, want
    ok = and ok_sum, ok_v
    !acc
    !i
    !nine
    !want_sum
    !ok_sum
    !base
    !got
    !want
    !ok_v
    br ok -> L_OK, L_ERR
L_OK:
    !ok
    call @sa_print_bytes(&OUT, 4)
    return 0
L_ERR:
    !ok
    return 1
