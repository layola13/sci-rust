@import "sa_std/vec.sars"

@test "sa_std vec into_iter bare alias macro surface"():
L_ENTRY:
    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_PUSH_U64 vec, 40

    EXPAND VEC_INTO_ITER iter, backing_vec, vec
    EXPAND VEC_INTO_ITER_SIZE_HINT hint_lower, hint_upper, iter
    EXPAND VEC_INTO_ITER_NEXT first_ok, first, iter
    EXPAND VEC_INTO_ITER_NEXT second_ok, second, iter
    EXPAND VEC_INTO_ITER_COLLECT collected_vec, iter
    EXPAND VEC_LEN collected_len, collected_vec
    EXPAND VEC_GET_U64 collected_0, collected_vec, 0
    EXPAND VEC_GET_U64 collected_1, collected_vec, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY collect_empty, iter

    EXPAND VEC_FREE backing_vec
    EXPAND VEC_FREE collected_vec

    ok_hint_lower = eq hint_lower, 4
    ok_hint_upper = eq hint_upper, 4
    ok_first_flag = eq first_ok, 1
    ok_first = eq first, 10
    ok_second_flag = eq second_ok, 1
    ok_second = eq second, 20
    ok_collected_len = eq collected_len, 2
    ok_collected_0 = eq collected_0, 30
    ok_collected_1 = eq collected_1, 40
    ok_collect_empty = eq collect_empty, 1

    ok = and ok_hint_lower, ok_hint_upper
    ok = and ok, ok_first_flag
    ok = and ok, ok_first
    ok = and ok, ok_second_flag
    ok = and ok, ok_second
    ok = and ok, ok_collected_len
    ok = and ok, ok_collected_0
    ok = and ok, ok_collected_1
    ok = and ok, ok_collect_empty

    !hint_lower
    !hint_upper
    !first_ok
    !first
    !second_ok
    !second
    !collected_len
    !collected_0
    !collected_1
    !collect_empty
    !ok_hint_lower
    !ok_hint_upper
    !ok_first_flag
    !ok_first
    !ok_second_flag
    !ok_second
    !ok_collected_len
    !ok_collected_0
    !ok_collected_1
    !ok_collect_empty
    !iter
    br ok -> L_VEC_INTO_ITER_BARE_ALIAS_OK, L_VEC_INTO_ITER_BARE_ALIAS_FAIL

L_VEC_INTO_ITER_BARE_ALIAS_FAIL:
    !ok
    panic(10841)

L_VEC_INTO_ITER_BARE_ALIAS_OK:
    !ok
    return
