@import "sa_std/env.sars"

@test "sa_std env temp_dir non-empty"():
L_ENTRY:
    EXPAND ENV_TEMP_DIR buf
    EXPAND ENV_BUFFER_LEN ln, buf
    EXPAND ENV_BUFFER_FREE free_st, buf
    EXPAND ENV_STATUS_IS_OK free_ok, free_st
    a = ugt ln, 0
    b = eq free_ok, 1
    ok = and a, b
    !ln
    !free_st
    !free_ok
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10949)
