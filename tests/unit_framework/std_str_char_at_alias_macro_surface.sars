@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const S = utf8:"abc"

@test "sa_std str char_at alias"():
L_ENTRY:
    EXPAND STR_FROM_PARTS s, &S, 3
    EXPAND STR_CHAR_AT ok0, c0, s, 0
    EXPAND STR_CHAR_AT ok1, c1, s, 1
    EXPAND STR_CHAR_AT ok2, c2, s, 2
    EXPAND STR_CHAR_AT miss, cm, s, 3
    a = eq ok0, 1
    b = eq c0, 97
    c = eq ok1, 1
    d = eq c1, 98
    e = eq ok2, 1
    f = eq c2, 99
    g = eq miss, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok04 = and ok03, e
    ok05 = and ok04, f
    ok_all = and ok05, g
    !ok0
    !c0
    !ok1
    !c1
    !ok2
    !c2
    !miss
    !cm
    !a
    !b
    !c
    !d
    !e
    !f
    !g
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(10906)
