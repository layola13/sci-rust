@import "sa_std/cmp.sars"

@cmp_test_ordering_greater() -> i64:
L_ENTRY:
    return CMP_ORDERING_GREATER

@cmp_test_compare_u64(left: u64, right: u64) -> i64:
L_ENTRY:
    is_lt = ult left, right
    br is_lt -> L_LESS, L_CHECK_GT

L_LESS:
    !is_lt
    !left
    !right
    return CMP_ORDERING_LESS

L_CHECK_GT:
    is_gt = ugt left, right
    br is_gt -> L_GREATER, L_EQUAL

L_GREATER:
    !is_gt
    !is_lt
    !left
    !right
    return CMP_ORDERING_GREATER

L_EQUAL:
    !is_gt
    !is_lt
    !left
    !right
    return CMP_ORDERING_EQUAL

@cmp_test_key_ones(value: u64) -> u64:
L_ENTRY:
    key = urem value, 10
    !value
    return key

@test "sa_std cmp ordering and primitive macros"():
L_ENTRY:
    EXPAND CMP_COMPARE_U64 u64_less, 3, 7
    EXPAND CMP_COMPARE_U64 u64_equal, 7, 7
    EXPAND CMP_COMPARE_U64 u64_greater, 9, 7
    EXPAND CMP_ORDERING_IS_LT u64_less_is_lt, u64_less
    EXPAND CMP_ORDERING_IS_EQ u64_equal_is_eq, u64_equal
    EXPAND CMP_ORDERING_IS_GT u64_greater_is_gt, u64_greater
    EXPAND CMP_ORDERING_IS_NE u64_less_is_ne, u64_less
    EXPAND CMP_ORDERING_IS_LE u64_less_is_le, u64_less
    EXPAND CMP_ORDERING_IS_GE u64_greater_is_ge, u64_greater
    EXPAND CMP_ORDERING_THEN then_from_less, u64_less, CMP_ORDERING_GREATER
    EXPAND CMP_ORDERING_THEN then_from_equal, u64_equal, CMP_ORDERING_GREATER
    EXPAND CMP_ORDERING_THEN_WITH then_with_less, u64_less, @cmp_test_ordering_greater
    EXPAND CMP_ORDERING_THEN_WITH then_with_equal, u64_equal, @cmp_test_ordering_greater
    EXPAND CMP_ORDERING_REVERSE reverse_less, u64_less
    EXPAND CMP_ORDERING_REVERSE reverse_equal, u64_equal
    EXPAND CMP_ORDERING_REVERSE reverse_greater, u64_greater

    EXPAND CMP_MIN_U64 min_u64, 9, 7
    EXPAND CMP_MAX_U64 max_u64, 9, 7
    EXPAND CMP_MIN_BY_U64 min_by_u64, 9, 7, @cmp_test_compare_u64
    EXPAND CMP_MAX_BY_U64 max_by_u64, 9, 7, @cmp_test_compare_u64
    EXPAND CMP_MIN_BY_KEY_U64 min_by_key_u64, 24, 31, @cmp_test_key_ones
    EXPAND CMP_MAX_BY_KEY_U64 max_by_key_u64, 24, 31, @cmp_test_key_ones
    EXPAND CMP_CLAMP_U64 clamp_u64_low, 2, 5, 10
    EXPAND CMP_CLAMP_U64 clamp_u64_mid, 7, 5, 10
    EXPAND CMP_CLAMP_U64 clamp_u64_high, 12, 5, 10
    EXPAND CMP_TRY_CLAMP_U64 try_clamp_u64_ok, try_clamp_u64_value, 12, 5, 10
    EXPAND CMP_TRY_CLAMP_U64 try_clamp_u64_bad_ok, try_clamp_u64_bad_value, 7, 10, 5

    neg_seven = sub 0, 7
    neg_two = sub 0, 2
    EXPAND CMP_COMPARE_I64 i64_less, neg_seven, neg_two
    EXPAND CMP_COMPARE_I64 i64_equal, neg_seven, neg_seven
    EXPAND CMP_COMPARE_I64 i64_greater, 4, neg_two
    EXPAND CMP_MIN_I64 min_i64, neg_seven, 4
    EXPAND CMP_MAX_I64 max_i64, neg_seven, 4
    EXPAND CMP_CLAMP_I64 clamp_i64_low, neg_seven, neg_two, 5
    EXPAND CMP_CLAMP_I64 clamp_i64_mid, 4, neg_two, 5
    EXPAND CMP_CLAMP_I64 clamp_i64_high, 9, neg_two, 5
    EXPAND CMP_TRY_CLAMP_I64 try_clamp_i64_ok, try_clamp_i64_value, neg_seven, neg_two, 5
    EXPAND CMP_TRY_CLAMP_I64 try_clamp_i64_bad_ok, try_clamp_i64_bad_value, 4, 5, neg_two

    ok_u64_less = eq u64_less, CMP_ORDERING_LESS
    ok_u64_equal = eq u64_equal, CMP_ORDERING_EQUAL
    ok_u64_greater = eq u64_greater, CMP_ORDERING_GREATER
    ok_ordering_default = eq CMP_ORDERING_DEFAULT_VALUE, CMP_ORDERING_EQUAL
    ok_u64_less_is_lt = eq u64_less_is_lt, 1
    ok_u64_equal_is_eq = eq u64_equal_is_eq, 1
    ok_u64_greater_is_gt = eq u64_greater_is_gt, 1
    ok_u64_less_is_ne = eq u64_less_is_ne, 1
    ok_u64_less_is_le = eq u64_less_is_le, 1
    ok_u64_greater_is_ge = eq u64_greater_is_ge, 1
    ok_then_from_less = eq then_from_less, CMP_ORDERING_LESS
    ok_then_from_equal = eq then_from_equal, CMP_ORDERING_GREATER
    ok_then_with_less = eq then_with_less, CMP_ORDERING_LESS
    ok_then_with_equal = eq then_with_equal, CMP_ORDERING_GREATER
    ok_reverse_less = eq reverse_less, CMP_ORDERING_GREATER
    ok_reverse_equal = eq reverse_equal, CMP_ORDERING_EQUAL
    ok_reverse_greater = eq reverse_greater, CMP_ORDERING_LESS
    ok_min_u64 = eq min_u64, 7
    ok_max_u64 = eq max_u64, 9
    ok_min_by_u64 = eq min_by_u64, 7
    ok_max_by_u64 = eq max_by_u64, 9
    ok_min_by_key_u64 = eq min_by_key_u64, 31
    ok_max_by_key_u64 = eq max_by_key_u64, 24
    ok_clamp_u64_low = eq clamp_u64_low, 5
    ok_clamp_u64_mid = eq clamp_u64_mid, 7
    ok_clamp_u64_high = eq clamp_u64_high, 10
    ok_try_clamp_u64_ok = eq try_clamp_u64_ok, 1
    ok_try_clamp_u64_value = eq try_clamp_u64_value, 10
    ok_try_clamp_u64_bad_ok = eq try_clamp_u64_bad_ok, 0
    ok_try_clamp_u64_bad_value = eq try_clamp_u64_bad_value, 0
    ok_i64_less = eq i64_less, CMP_ORDERING_LESS
    ok_i64_equal = eq i64_equal, CMP_ORDERING_EQUAL
    ok_i64_greater = eq i64_greater, CMP_ORDERING_GREATER
    ok_min_i64 = eq min_i64, neg_seven
    ok_max_i64 = eq max_i64, 4
    ok_clamp_i64_low = eq clamp_i64_low, neg_two
    ok_clamp_i64_mid = eq clamp_i64_mid, 4
    ok_clamp_i64_high = eq clamp_i64_high, 5
    ok_try_clamp_i64_ok = eq try_clamp_i64_ok, 1
    ok_try_clamp_i64_value = eq try_clamp_i64_value, neg_two
    ok_try_clamp_i64_bad_ok = eq try_clamp_i64_bad_ok, 0
    ok_try_clamp_i64_bad_value = eq try_clamp_i64_bad_value, 0

    ok01 = and ok_u64_less, ok_u64_equal
    ok02 = and ok01, ok_u64_greater
    ok02a = and ok02, ok_ordering_default
    ok03 = and ok02a, ok_u64_less_is_lt
    ok04 = and ok03, ok_u64_equal_is_eq
    ok05 = and ok04, ok_u64_greater_is_gt
    ok05a = and ok05, ok_u64_less_is_ne
    ok05b = and ok05a, ok_u64_less_is_le
    ok05c = and ok05b, ok_u64_greater_is_ge
    ok05d = and ok05c, ok_then_from_less
    ok05e = and ok05d, ok_then_from_equal
    ok05f = and ok05e, ok_then_with_less
    ok06 = and ok05f, ok_then_with_equal
    ok07 = and ok06, ok_reverse_less
    ok08 = and ok07, ok_reverse_equal
    ok09 = and ok08, ok_reverse_greater
    ok10 = and ok09, ok_min_u64
    ok10a = and ok10, ok_max_u64
    ok10b = and ok10a, ok_min_by_u64
    ok10c = and ok10b, ok_max_by_u64
    ok10d = and ok10c, ok_min_by_key_u64
    ok10e = and ok10d, ok_max_by_key_u64
    ok11 = and ok10e, ok_clamp_u64_low
    ok12 = and ok11, ok_clamp_u64_mid
    ok13 = and ok12, ok_clamp_u64_high
    ok13a = and ok13, ok_try_clamp_u64_ok
    ok13b = and ok13a, ok_try_clamp_u64_value
    ok13c = and ok13b, ok_try_clamp_u64_bad_ok
    ok13d = and ok13c, ok_try_clamp_u64_bad_value
    ok14 = and ok13d, ok_i64_less
    ok15 = and ok14, ok_i64_equal
    ok16 = and ok15, ok_i64_greater
    ok17 = and ok16, ok_min_i64
    ok18 = and ok17, ok_max_i64
    ok19 = and ok18, ok_clamp_i64_low
    ok20 = and ok19, ok_clamp_i64_mid
    ok21 = and ok20, ok_clamp_i64_high
    ok22 = and ok21, ok_try_clamp_i64_ok
    ok23 = and ok22, ok_try_clamp_i64_value
    ok24 = and ok23, ok_try_clamp_i64_bad_ok
    ok = and ok24, ok_try_clamp_i64_bad_value

    !u64_less
    !u64_equal
    !u64_greater
    !u64_less_is_lt
    !u64_equal_is_eq
    !u64_greater_is_gt
    !u64_less_is_ne
    !u64_less_is_le
    !u64_greater_is_ge
    !then_from_less
    !then_from_equal
    !then_with_less
    !then_with_equal
    !reverse_less
    !reverse_equal
    !reverse_greater
    !min_u64
    !max_u64
    !min_by_u64
    !max_by_u64
    !min_by_key_u64
    !max_by_key_u64
    !clamp_u64_low
    !clamp_u64_mid
    !clamp_u64_high
    !try_clamp_u64_ok
    !try_clamp_u64_value
    !try_clamp_u64_bad_ok
    !try_clamp_u64_bad_value
    !neg_seven
    !neg_two
    !i64_less
    !i64_equal
    !i64_greater
    !min_i64
    !max_i64
    !clamp_i64_low
    !clamp_i64_mid
    !clamp_i64_high
    !try_clamp_i64_ok
    !try_clamp_i64_value
    !try_clamp_i64_bad_ok
    !try_clamp_i64_bad_value
    !ok_u64_less
    !ok_u64_equal
    !ok_u64_greater
    !ok_ordering_default
    !ok_u64_less_is_lt
    !ok_u64_equal_is_eq
    !ok_u64_greater_is_gt
    !ok_u64_less_is_ne
    !ok_u64_less_is_le
    !ok_u64_greater_is_ge
    !ok_then_from_less
    !ok_then_from_equal
    !ok_then_with_less
    !ok_then_with_equal
    !ok_reverse_less
    !ok_reverse_equal
    !ok_reverse_greater
    !ok_min_u64
    !ok_max_u64
    !ok_min_by_u64
    !ok_max_by_u64
    !ok_min_by_key_u64
    !ok_max_by_key_u64
    !ok_clamp_u64_low
    !ok_clamp_u64_mid
    !ok_clamp_u64_high
    !ok_try_clamp_u64_ok
    !ok_try_clamp_u64_value
    !ok_try_clamp_u64_bad_ok
    !ok_try_clamp_u64_bad_value
    !ok_i64_less
    !ok_i64_equal
    !ok_i64_greater
    !ok_min_i64
    !ok_max_i64
    !ok_clamp_i64_low
    !ok_clamp_i64_mid
    !ok_clamp_i64_high
    !ok_try_clamp_i64_ok
    !ok_try_clamp_i64_value
    !ok_try_clamp_i64_bad_ok
    !ok_try_clamp_i64_bad_value
    !ok01
    !ok02
    !ok02a
    !ok03
    !ok04
    !ok05
    !ok05a
    !ok05b
    !ok05c
    !ok05d
    !ok05e
    !ok05f
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok10a
    !ok10b
    !ok10c
    !ok10d
    !ok10e
    !ok11
    !ok12
    !ok13
    !ok13a
    !ok13b
    !ok13c
    !ok13d
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(910)

L_PASS:
    !ok
    return 0

@test "sa_std cmp reverse primitive macros"():
L_ENTRY:
    rev_u64_a = stack_alloc CmpReverseU64_SIZE
    rev_u64_b = stack_alloc CmpReverseU64_SIZE
    rev_u64_copy = stack_alloc CmpReverseU64_SIZE
    rev_i64_a = stack_alloc CmpReverseI64_SIZE
    rev_i64_b = stack_alloc CmpReverseI64_SIZE
    rev_i64_copy = stack_alloc CmpReverseI64_SIZE

    EXPAND CMP_REVERSE_U64_NEW rev_u64_a, 3
    EXPAND CMP_REVERSE_U64_NEW rev_u64_b, 7
    EXPAND CMP_REVERSE_U64_GET u64_a_value, rev_u64_a
    EXPAND CMP_REVERSE_U64_COMPARE u64_cmp_ab, rev_u64_a, rev_u64_b
    EXPAND CMP_REVERSE_U64_COMPARE u64_cmp_ba, rev_u64_b, rev_u64_a
    EXPAND CMP_REVERSE_U64_MIN_VALUE u64_min_value, rev_u64_a, rev_u64_b
    EXPAND CMP_REVERSE_U64_MAX_VALUE u64_max_value, rev_u64_a, rev_u64_b
    EXPAND CMP_REVERSE_U64_COPY rev_u64_copy, rev_u64_b
    EXPAND CMP_REVERSE_U64_GET u64_copy_value, rev_u64_copy
    EXPAND CMP_REVERSE_U64_SET rev_u64_copy, 11
    EXPAND CMP_REVERSE_U64_GET u64_set_value, rev_u64_copy

    neg_seven = sub 0, 7
    neg_two = sub 0, 2
    EXPAND CMP_REVERSE_I64_NEW rev_i64_a, neg_seven
    EXPAND CMP_REVERSE_I64_NEW rev_i64_b, neg_two
    EXPAND CMP_REVERSE_I64_GET i64_a_value, rev_i64_a
    EXPAND CMP_REVERSE_I64_COMPARE i64_cmp_ab, rev_i64_a, rev_i64_b
    EXPAND CMP_REVERSE_I64_COMPARE i64_cmp_ba, rev_i64_b, rev_i64_a
    EXPAND CMP_REVERSE_I64_MIN_VALUE i64_min_value, rev_i64_a, rev_i64_b
    EXPAND CMP_REVERSE_I64_MAX_VALUE i64_max_value, rev_i64_a, rev_i64_b
    EXPAND CMP_REVERSE_I64_COPY rev_i64_copy, rev_i64_a
    EXPAND CMP_REVERSE_I64_GET i64_copy_value, rev_i64_copy
    EXPAND CMP_REVERSE_I64_SET rev_i64_copy, 5
    EXPAND CMP_REVERSE_I64_GET i64_set_value, rev_i64_copy

    ok01 = eq u64_a_value, 3
    ok02 = eq u64_cmp_ab, CMP_ORDERING_GREATER
    ok03 = eq u64_cmp_ba, CMP_ORDERING_LESS
    ok04 = eq u64_min_value, 7
    ok05 = eq u64_max_value, 3
    ok06 = eq u64_copy_value, 7
    ok07 = eq u64_set_value, 11
    ok08 = eq i64_a_value, neg_seven
    ok09 = eq i64_cmp_ab, CMP_ORDERING_GREATER
    ok10 = eq i64_cmp_ba, CMP_ORDERING_LESS
    ok11 = eq i64_min_value, neg_two
    ok12 = eq i64_max_value, neg_seven
    ok13 = eq i64_copy_value, neg_seven
    ok14 = eq i64_set_value, 5

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    ok = and chain12, ok14

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(911)

L_PASS:
    return 0
