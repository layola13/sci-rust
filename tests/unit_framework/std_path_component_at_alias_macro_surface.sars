@import "sa_std/path.sars"
@import "sa_std/core/slice.sars"

@const P = utf8:"a/b/c"

@test "sa_std path component_at alias"():
L_ENTRY:
    EXPAND STR_FROM_PARTS path, &P, 5
    EXPAND PATH_COMPONENT_AT ok, comp, path, 1
    EXPAND SLICE_GET_LEN ln, comp
    a = eq ok, 1
    b = eq ln, 1
    ok_all = and a, b
    !ok
    !ln
    !a
    !b
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(10904)
