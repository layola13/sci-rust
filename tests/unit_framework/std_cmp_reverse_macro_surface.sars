@import "sa_std/cmp.sars"
@import "sa_std/cmp.sal"

@test "sa_std cmp reverse"():
L_ENTRY:
    rev = stack_alloc CmpReverseU64_SIZE
    EXPAND CMP_REVERSE_U64_NEW rev, 5
    EXPAND CMP_REVERSE_U64_GET v, rev
    ok = eq v, 5
    !v
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10971)
