@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@iter_map_while_lt_four(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_MAP_WHILE_KEEP, L_MAP_WHILE_STOP
L_MAP_WHILE_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !out_mapped
    !value
    return keep
L_MAP_WHILE_STOP:
    !out_mapped
    !value
    return keep

@iter_map_while_all(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    mapped = add value, 100
    store out_mapped+0, mapped as u64
    !mapped
    !out_mapped
    !value
    return 1

@test "sa_std iter map_while collect macro surface"():
L_ENTRY:
    values = stack_alloc 40
    all_values = stack_alloc 24
    empty_values = stack_alloc 8

    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64
    store all_values+0, 6 as u64
    store all_values+8, 7 as u64
    store all_values+16, 8 as u64

    slice = alloc Slice_SIZE
    all_slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW all_slice, all_values, 3
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_MAP_WHILE_COLLECT_U64 mapped_vec, iter, @iter_map_while_lt_four
    EXPAND ITER_LEN iter_remaining, iter
    EXPAND ITER_NEXT_U64 tail_ok, tail_value, iter
    EXPAND ITER_IS_EMPTY iter_empty_after_tail, iter

    EXPAND VEC_LEN mapped_len, mapped_vec
    EXPAND VEC_GET_U64 mapped_0, mapped_vec, 0
    EXPAND VEC_GET_U64 mapped_1, mapped_vec, 1
    EXPAND VEC_GET_U64 mapped_2, mapped_vec, 2

    EXPAND ITER_FROM_SLICE all_iter, all_slice
    EXPAND ITER_MAP_WHILE_COLLECT_U64 all_vec, all_iter, @iter_map_while_all
    EXPAND ITER_IS_EMPTY all_iter_empty, all_iter
    EXPAND VEC_LEN all_len, all_vec
    EXPAND VEC_GET_U64 all_0, all_vec, 0
    EXPAND VEC_GET_U64 all_2, all_vec, 2

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_MAP_WHILE_COLLECT_U64 empty_vec, empty_iter, @iter_map_while_lt_four
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter
    EXPAND VEC_LEN empty_len, empty_vec

    ok_mapped_len = eq mapped_len, 3
    ok_mapped_0 = eq mapped_0, 10
    ok_mapped_1 = eq mapped_1, 20
    ok_mapped_2 = eq mapped_2, 30
    ok_remaining = eq iter_remaining, 1
    ok_tail_flag = eq tail_ok, 1
    ok_tail_value = eq tail_value, 5
    ok_empty_after_tail = eq iter_empty_after_tail, 1
    ok_all_empty = eq all_iter_empty, 1
    ok_all_len = eq all_len, 3
    ok_all_0 = eq all_0, 106
    ok_all_2 = eq all_2, 108
    ok_empty_iter = eq empty_iter_empty, 1
    ok_empty_len = eq empty_len, 0

    c01 = and ok_mapped_len, ok_mapped_0
    c02 = and c01, ok_mapped_1
    c03 = and c02, ok_mapped_2
    c04 = and c03, ok_remaining
    c05 = and c04, ok_tail_flag
    c06 = and c05, ok_tail_value
    c07 = and c06, ok_empty_after_tail
    c08 = and c07, ok_all_empty
    c09 = and c08, ok_all_len
    c10 = and c09, ok_all_0
    c11 = and c10, ok_all_2
    c12 = and c11, ok_empty_iter
    ok = and c12, ok_empty_len

    !iter_remaining
    !tail_ok
    !tail_value
    !iter_empty_after_tail
    !mapped_len
    !mapped_0
    !mapped_1
    !mapped_2
    !all_iter_empty
    !all_len
    !all_0
    !all_2
    !empty_iter_empty
    !empty_len
    !ok_mapped_len
    !ok_mapped_0
    !ok_mapped_1
    !ok_mapped_2
    !ok_remaining
    !ok_tail_flag
    !ok_tail_value
    !ok_empty_after_tail
    !ok_all_empty
    !ok_all_len
    !ok_all_0
    !ok_all_2
    !ok_empty_iter
    !ok_empty_len
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !empty_iter
    !all_iter
    !iter
    !empty_slice
    !all_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE all_vec
    EXPAND VEC_FREE mapped_vec
    panic(10537)

L_PASS:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE all_vec
    EXPAND VEC_FREE mapped_vec
    return 0
