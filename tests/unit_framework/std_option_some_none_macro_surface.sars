@import "sa_std/option.sars"

@test "sa_std option some none unwrap_or"():
L_ENTRY:
    EXPAND OPTION_SOME some, 11
    EXPAND OPTION_NONE none
    EXPAND OPTION_IS_SOME is_s, some
    EXPAND OPTION_IS_NONE is_n, none
    EXPAND OPTION_UNWRAP_OR u1, some, 99
    EXPAND OPTION_UNWRAP_OR u2, none, 99
    a = eq is_s, 1
    b = eq is_n, 1
    c = eq u1, 11
    d = eq u2, 99
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !is_s
    !is_n
    !u1
    !u2
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10931)
