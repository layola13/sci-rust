@test "sa_std btree_set rust parity macros"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_SET_NEW set
    EXPAND BTREE_SET_NEW other
    EXPAND BTREE_SET_NEW disjoint
    EXPAND BTREE_SET_INSERT ins_alpha, set, alpha
    EXPAND BTREE_SET_INSERT ins_bravo, set, bravo
    EXPAND BTREE_SET_GET get_alpha_ok, get_alpha_key, set, alpha
    get_alpha_key_len = load get_alpha_key+Slice_len as u64
    EXPAND BTREE_SET_GET get_charlie_ok, get_charlie_key, set, charlie
    get_charlie_key_ptr = load get_charlie_key+Slice_ptr as ptr
    EXPAND BTREE_SET_FIRST first_ok, first_key, set
    first_key_len = load first_key+Slice_len as u64
    EXPAND BTREE_SET_LAST last_ok, last_key, set
    last_key_len = load last_key+Slice_len as u64
    EXPAND BTREE_SET_REPLACE replace_alpha_ok, replace_alpha_key, set, alpha
    replace_alpha_key_len = load replace_alpha_key+Slice_len as u64
    EXPAND BTREE_SET_TAKE take_alpha_ok, take_alpha_key, set, alpha
    take_alpha_key_len = load take_alpha_key+Slice_len as u64
    EXPAND BTREE_SET_TAKE take_alpha_miss_ok, take_alpha_miss_key, set, alpha
    take_alpha_miss_key_ptr = load take_alpha_miss_key+Slice_ptr as ptr

    EXPAND BTREE_SET_INSERT other_ins_bravo, other, bravo
    EXPAND BTREE_SET_INSERT other_ins_charlie, other, charlie
    EXPAND BTREE_SET_IS_SUBSET subset0, set, other
    EXPAND BTREE_SET_IS_SUPERSET superset0, set, other
    EXPAND BTREE_SET_IS_DISJOINT disjoint0, set, other
    EXPAND BTREE_SET_INSERT disjoint_ins_charlie, disjoint, charlie
    EXPAND BTREE_SET_IS_DISJOINT disjoint1, set, disjoint
    EXPAND BTREE_SET_APPEND set, disjoint
    EXPAND BTREE_SET_LEN set_len_after_append, set
    EXPAND BTREE_SET_LEN disjoint_len_after_append, disjoint
    EXPAND BTREE_SET_SPLIT_OFF tail, set, charlie
    EXPAND BTREE_SET_LEN set_len_after_split, set
    EXPAND BTREE_SET_LEN tail_len_after_split, tail
    EXPAND BTREE_SET_POP_FIRST pop_first_ok, pop_first_key, set
    pop_first_key_len = load pop_first_key+Slice_len as u64
    EXPAND BTREE_SET_POP_LAST pop_last_ok, pop_last_key, tail
    pop_last_key_len = load pop_last_key+Slice_len as u64

    EXPAND BTREE_SET_NEW entry_set
    EXPAND BTREE_SET_INSERT entry_ins_bravo, entry_set, bravo
    EXPAND BTREE_SET_GET_OR_INSERT get_or_insert_existing, get_or_insert_existing_key, entry_set, bravo
    get_or_insert_existing_len = load get_or_insert_existing_key+Slice_len as u64
    EXPAND BTREE_SET_GET_OR_INSERT get_or_insert_new, get_or_insert_new_key, entry_set, charlie
    get_or_insert_new_len = load get_or_insert_new_key+Slice_len as u64
    EXPAND BTREE_SET_LEN entry_set_len, entry_set

    ok_ins_alpha = eq ins_alpha, 1
    ok_ins_bravo = eq ins_bravo, 1
    ok_get_alpha_flag = eq get_alpha_ok, 1
    ok_get_alpha_len = eq get_alpha_key_len, 5
    ok_get_charlie_flag = eq get_charlie_ok, 0
    ok_get_charlie_ptr = eq get_charlie_key_ptr, 0
    ok_first_flag = eq first_ok, 1
    ok_first_len = eq first_key_len, 5
    ok_last_flag = eq last_ok, 1
    ok_last_len = eq last_key_len, 5
    ok_replace_flag = eq replace_alpha_ok, 1
    ok_replace_len = eq replace_alpha_key_len, 5
    ok_take_flag = eq take_alpha_ok, 1
    ok_take_len = eq take_alpha_key_len, 5
    ok_take_miss_flag = eq take_alpha_miss_ok, 0
    ok_take_miss_ptr = eq take_alpha_miss_key_ptr, 0
    ok_other_ins_bravo = eq other_ins_bravo, 1
    ok_other_ins_charlie = eq other_ins_charlie, 1
    ok_subset0 = eq subset0, 1
    ok_superset0 = eq superset0, 0
    ok_disjoint0 = eq disjoint0, 0
    ok_disjoint_insert = eq disjoint_ins_charlie, 1
    ok_disjoint1 = eq disjoint1, 1
    ok_set_len_after_append = eq set_len_after_append, 2
    ok_disjoint_len_after_append = eq disjoint_len_after_append, 0
    ok_set_len_after_split = eq set_len_after_split, 1
    ok_tail_len_after_split = eq tail_len_after_split, 1
    ok_pop_first_flag = eq pop_first_ok, 1
    ok_pop_first_len = eq pop_first_key_len, 5
    ok_pop_last_flag = eq pop_last_ok, 1
    ok_pop_last_len = eq pop_last_key_len, 7
    ok_entry_ins_bravo = eq entry_ins_bravo, 1
    ok_get_or_insert_existing = eq get_or_insert_existing, 0
    ok_get_or_insert_existing_len = eq get_or_insert_existing_len, 5
    ok_get_or_insert_new = eq get_or_insert_new, 1
    ok_get_or_insert_new_len = eq get_or_insert_new_len, 7
    ok_entry_set_len = eq entry_set_len, 2

    ok01 = and ok_ins_alpha, ok_ins_bravo
    ok02 = and ok01, ok_get_alpha_flag
    ok03 = and ok02, ok_get_alpha_len
    ok04 = and ok03, ok_get_charlie_flag
    ok05 = and ok04, ok_get_charlie_ptr
    ok06 = and ok05, ok_first_flag
    ok07 = and ok06, ok_first_len
    ok08 = and ok07, ok_last_flag
    ok09 = and ok08, ok_last_len
    ok10 = and ok09, ok_replace_flag
    ok11 = and ok10, ok_replace_len
    ok12 = and ok11, ok_take_flag
    ok13 = and ok12, ok_take_len
    ok14 = and ok13, ok_take_miss_flag
    ok15 = and ok14, ok_take_miss_ptr
    ok16 = and ok15, ok_other_ins_bravo
    ok17 = and ok16, ok_other_ins_charlie
    ok18 = and ok17, ok_subset0
    ok19 = and ok18, ok_superset0
    ok20 = and ok19, ok_disjoint0
    ok21 = and ok20, ok_disjoint_insert
    ok22 = and ok21, ok_disjoint1
    ok23 = and ok22, ok_set_len_after_append
    ok24 = and ok23, ok_disjoint_len_after_append
    ok25 = and ok24, ok_set_len_after_split
    ok26 = and ok25, ok_tail_len_after_split
    ok27 = and ok26, ok_pop_first_flag
    ok28 = and ok27, ok_pop_first_len
    ok29 = and ok28, ok_pop_last_flag
    ok30 = and ok29, ok_pop_last_len
    ok31 = and ok30, ok_entry_ins_bravo
    ok32 = and ok31, ok_get_or_insert_existing
    ok33 = and ok32, ok_get_or_insert_existing_len
    ok34 = and ok33, ok_get_or_insert_new
    ok35 = and ok34, ok_get_or_insert_new_len
    ok = and ok35, ok_entry_set_len

    !ins_alpha
    !ins_bravo
    !get_alpha_ok
    !get_alpha_key_len
    !get_charlie_ok
    !get_charlie_key_ptr
    !first_ok
    !first_key_len
