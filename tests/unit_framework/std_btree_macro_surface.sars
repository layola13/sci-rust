    ok_has_alpha = eq has_alpha, 1
    ok_has_bravo = eq has_bravo, 0
    ok_has_charlie = eq has_charlie, 1
    ok_alpha_value = eq alpha_value, 10
    ok_charlie_value = eq charlie_value, 30
    ok_first = eq first_ok, 1
    ok_first_key = eq first_key_ptr, alpha_ptr
    ok_first_value = eq first_value, 10
    ok_last = eq last_ok, 1
    ok_last_key = eq last_key_ptr, charlie_ptr
    ok_last_value = eq last_value, 30

