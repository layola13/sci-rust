@test "sa_std btree_set range and algebra macros"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    delta = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7
    EXPAND SLICE_NEW delta, &KEY_DELTA, 5

    EXPAND BTREE_SET_NEW left
    EXPAND BTREE_SET_NEW right
    EXPAND BTREE_SET_INSERT left_ins_alpha, left, alpha
    EXPAND BTREE_SET_INSERT left_ins_bravo, left, bravo
    EXPAND BTREE_SET_INSERT left_ins_charlie, left, charlie
    EXPAND BTREE_SET_INSERT right_ins_bravo, right, bravo
    EXPAND BTREE_SET_INSERT right_ins_delta, right, delta

    EXPAND BTREE_SET_RANGE range_set, left, bravo, delta
    EXPAND BTREE_SET_UNION union_set, left, right
    EXPAND BTREE_SET_INTERSECTION intersection_set, left, right
    EXPAND BTREE_SET_DIFFERENCE difference_set, left, right
    EXPAND BTREE_SET_SYMMETRIC_DIFFERENCE symmetric_set, left, right

    EXPAND BTREE_SET_LEN range_len, range_set
    EXPAND BTREE_SET_CONTAINS range_has_alpha, range_set, alpha
    EXPAND BTREE_SET_CONTAINS range_has_bravo, range_set, bravo
    EXPAND BTREE_SET_CONTAINS range_has_charlie, range_set, charlie
    EXPAND BTREE_SET_CONTAINS range_has_delta, range_set, delta

    EXPAND BTREE_SET_LEN union_len, union_set
    EXPAND BTREE_SET_CONTAINS union_has_alpha, union_set, alpha
    EXPAND BTREE_SET_CONTAINS union_has_bravo, union_set, bravo
    EXPAND BTREE_SET_CONTAINS union_has_charlie, union_set, charlie
    EXPAND BTREE_SET_CONTAINS union_has_delta, union_set, delta

    EXPAND BTREE_SET_LEN intersection_len, intersection_set
    EXPAND BTREE_SET_CONTAINS intersection_has_alpha, intersection_set, alpha
    EXPAND BTREE_SET_CONTAINS intersection_has_bravo, intersection_set, bravo
    EXPAND BTREE_SET_CONTAINS intersection_has_charlie, intersection_set, charlie
    EXPAND BTREE_SET_CONTAINS intersection_has_delta, intersection_set, delta

    EXPAND BTREE_SET_LEN difference_len, difference_set
    EXPAND BTREE_SET_CONTAINS difference_has_alpha, difference_set, alpha
    EXPAND BTREE_SET_CONTAINS difference_has_bravo, difference_set, bravo
    EXPAND BTREE_SET_CONTAINS difference_has_charlie, difference_set, charlie
    EXPAND BTREE_SET_CONTAINS difference_has_delta, difference_set, delta

    EXPAND BTREE_SET_LEN symmetric_len, symmetric_set
    EXPAND BTREE_SET_CONTAINS symmetric_has_alpha, symmetric_set, alpha
    EXPAND BTREE_SET_CONTAINS symmetric_has_bravo, symmetric_set, bravo
    EXPAND BTREE_SET_CONTAINS symmetric_has_charlie, symmetric_set, charlie
    EXPAND BTREE_SET_CONTAINS symmetric_has_delta, symmetric_set, delta

    ok_left_ins_alpha = eq left_ins_alpha, 1
    ok_left_ins_bravo = eq left_ins_bravo, 1
    ok_left_ins_charlie = eq left_ins_charlie, 1
    ok_right_ins_bravo = eq right_ins_bravo, 1
    ok_right_ins_delta = eq right_ins_delta, 1
    ok_range_len = eq range_len, 2
    ok_range_has_alpha = eq range_has_alpha, 0
    ok_range_has_bravo = eq range_has_bravo, 1
    ok_range_has_charlie = eq range_has_charlie, 1
    ok_range_has_delta = eq range_has_delta, 0
    ok_union_len = eq union_len, 4
    ok_union_has_alpha = eq union_has_alpha, 1
    ok_union_has_bravo = eq union_has_bravo, 1
    ok_union_has_charlie = eq union_has_charlie, 1
    ok_union_has_delta = eq union_has_delta, 1
    ok_intersection_len = eq intersection_len, 1
    ok_intersection_has_alpha = eq intersection_has_alpha, 0
    ok_intersection_has_bravo = eq intersection_has_bravo, 1
    ok_intersection_has_charlie = eq intersection_has_charlie, 0
    ok_intersection_has_delta = eq intersection_has_delta, 0
    ok_difference_len = eq difference_len, 2
    ok_difference_has_alpha = eq difference_has_alpha, 1
    ok_difference_has_bravo = eq difference_has_bravo, 0
    ok_difference_has_charlie = eq difference_has_charlie, 1
    ok_difference_has_delta = eq difference_has_delta, 0
    ok_symmetric_len = eq symmetric_len, 3
    ok_symmetric_has_alpha = eq symmetric_has_alpha, 1
    ok_symmetric_has_bravo = eq symmetric_has_bravo, 0
    ok_symmetric_has_charlie = eq symmetric_has_charlie, 1
    ok_symmetric_has_delta = eq symmetric_has_delta, 1

    ok01 = and ok_left_ins_alpha, ok_left_ins_bravo
    ok02 = and ok01, ok_left_ins_charlie
    ok03 = and ok02, ok_right_ins_bravo
    ok04 = and ok03, ok_right_ins_delta
    ok05 = and ok04, ok_range_len
    ok06 = and ok05, ok_range_has_alpha
    ok07 = and ok06, ok_range_has_bravo
    ok08 = and ok07, ok_range_has_charlie
    ok09 = and ok08, ok_range_has_delta
    ok10 = and ok09, ok_union_len
    ok11 = and ok10, ok_union_has_alpha
    ok12 = and ok11, ok_union_has_bravo
    ok13 = and ok12, ok_union_has_charlie
    ok14 = and ok13, ok_union_has_delta
    ok15 = and ok14, ok_intersection_len
    ok16 = and ok15, ok_intersection_has_alpha
    ok17 = and ok16, ok_intersection_has_bravo
    ok18 = and ok17, ok_intersection_has_charlie
    ok19 = and ok18, ok_intersection_has_delta
    ok20 = and ok19, ok_difference_len
    ok21 = and ok20, ok_difference_has_alpha
    ok22 = and ok21, ok_difference_has_bravo
    ok23 = and ok22, ok_difference_has_charlie
    ok24 = and ok23, ok_difference_has_delta
    ok25 = and ok24, ok_symmetric_len
    ok26 = and ok25, ok_symmetric_has_alpha
    ok27 = and ok26, ok_symmetric_has_bravo
    ok28 = and ok27, ok_symmetric_has_charlie
    ok = and ok28, ok_symmetric_has_delta

    !left_ins_alpha
    !left_ins_bravo
    !left_ins_charlie
    !right_ins_bravo
    !right_ins_delta
    !range_len
    !range_has_alpha
    !range_has_bravo
    !range_has_charlie
    !range_has_delta
    !union_len
    !union_has_alpha
    !union_has_bravo
    !union_has_charlie
    !union_has_delta
    !intersection_len
    !intersection_has_alpha
    !intersection_has_bravo
    !intersection_has_charlie
    !intersection_has_delta
    !difference_len
    !difference_has_alpha
    !difference_has_bravo
    !difference_has_charlie
    !difference_has_delta
    !symmetric_len
    !symmetric_has_alpha
    !symmetric_has_bravo
    !symmetric_has_charlie
    !symmetric_has_delta
    !ok_left_ins_alpha
    !ok_left_ins_bravo
    !ok_left_ins_charlie
    !ok_right_ins_bravo
    !ok_right_ins_delta
    !ok_range_len
    !ok_range_has_alpha
    !ok_range_has_bravo
    !ok_range_has_charlie
    !ok_range_has_delta
    !ok_union_len
    !ok_union_has_alpha
    !ok_union_has_bravo
    !ok_union_has_charlie
    !ok_union_has_delta
    !ok_intersection_len
    !ok_intersection_has_alpha
    !ok_intersection_has_bravo
    !ok_intersection_has_charlie
    !ok_intersection_has_delta
    !ok_difference_len
    !ok_difference_has_alpha
    !ok_difference_has_bravo
    !ok_difference_has_charlie
    !ok_difference_has_delta
    !ok_symmetric_len
    !ok_symmetric_has_alpha
    !ok_symmetric_has_bravo
    !ok_symmetric_has_charlie
    !ok_symmetric_has_delta
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !delta
    !charlie
    !bravo
    !alpha
    EXPAND BTREE_SET_FREE symmetric_set
    EXPAND BTREE_SET_FREE difference_set
    EXPAND BTREE_SET_FREE intersection_set
    EXPAND BTREE_SET_FREE union_set
    EXPAND BTREE_SET_FREE range_set
    EXPAND BTREE_SET_FREE right
    EXPAND BTREE_SET_FREE left
    br ok -> L_SET_ALGEBRA_OK, L_SET_ALGEBRA_FAIL

L_SET_ALGEBRA_FAIL:
    !ok
    panic(926)

L_SET_ALGEBRA_OK:
    !ok
    return

@test "sa_std btree_map entry and_modify/or_default aliases"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_ENTRY_AND_MODIFY miss_ok, map, alpha, 11
    miss_ok_ok = eq miss_ok, 0
    EXPAND BTREE_MAP_CONTAINS_KEY has_after_miss, map, alpha
    has_after_miss_ok = eq has_after_miss, 0

    EXPAND BTREE_MAP_ENTRY_OR_DEFAULT def_ins, def_ptr, map, alpha
    def_ins_ok = eq def_ins, 1
    def_val = load def_ptr+0 as u64
    def_val_ok = eq def_val, 0

    EXPAND BTREE_MAP_OR_INSERT or_ins, or_ptr, map, bravo, 7
    or_ins_ok = eq or_ins, 1
    or_val = load or_ptr+0 as u64
    or_val_ok = eq or_val, 7

    EXPAND BTREE_MAP_ENTRY_AND_MODIFY mod_ok, map, bravo, 42
    mod_ok_ok = eq mod_ok, 1
    EXPAND BTREE_MAP_GET after_mod, map, bravo
    after_mod_ok = eq after_mod, 42

    EXPAND BTREE_MAP_FREE map
    !alpha
    !bravo

    ok = and miss_ok_ok, has_after_miss_ok
    ok = and ok, def_ins_ok
    ok = and ok, def_val_ok
    ok = and ok, or_ins_ok
    ok = and ok, or_val_ok
    ok = and ok, mod_ok_ok
    ok = and ok, after_mod_ok

    !miss_ok
    !has_after_miss
    !def_ins
    !def_ptr
    !def_val
    !or_ins
    !or_ptr
    !or_val
    !mod_ok
    !after_mod
    !miss_ok_ok
    !has_after_miss_ok
    !def_ins_ok
    !def_val_ok
    !or_ins_ok
    !or_val_ok
    !mod_ok_ok
    !after_mod_ok
    br ok -> L_BTREE_ENTRY_ALIAS_OK, L_BTREE_ENTRY_ALIAS_FAIL

L_BTREE_ENTRY_ALIAS_FAIL:
    !ok
    panic(927)

L_BTREE_ENTRY_ALIAS_OK:
    !ok
    return

@test "sa_std btree_set entry get_or_insert aliases"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5

    EXPAND BTREE_SET_NEW set
    EXPAND BTREE_SET_ENTRY_GET_OR_INSERT ins_a, stored_a, set, alpha
    ins_a_ok = eq ins_a, 1
    stored_a_ptr = load stored_a+Slice_ptr as ptr
    alpha_ptr = load alpha+Slice_ptr as ptr
    stored_a_ok = eq stored_a_ptr, alpha_ptr
    EXPAND BTREE_SET_OR_INSERT ins_a2, stored_a2, set, alpha
    ins_a2_ok = eq ins_a2, 0
    EXPAND BTREE_SET_OR_INSERT ins_b, stored_b, set, bravo
    ins_b_ok = eq ins_b, 1
    EXPAND BTREE_SET_LEN len1, set
    len1_ok = eq len1, 2

    EXPAND BTREE_SET_FREE set
    !alpha
    !bravo

    ok = and ins_a_ok, stored_a_ok
    ok = and ok, ins_a2_ok
    ok = and ok, ins_b_ok
    ok = and ok, len1_ok

    !ins_a
    !stored_a
    !stored_a_ptr
    !alpha_ptr
    !ins_a2
    !stored_a2
    !ins_b
    !stored_b
    !len1
    !ins_a_ok
    !stored_a_ok
    !ins_a2_ok
    !ins_b_ok
    !len1_ok
    br ok -> L_BTREE_SET_ENTRY_OK, L_BTREE_SET_ENTRY_FAIL

L_BTREE_SET_ENTRY_FAIL:
    !ok
    panic(928)

L_BTREE_SET_ENTRY_OK:
    !ok
    return

@test "sa_std btree literal arity macros"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_MAP_LIT1 map1, alpha, 1
    EXPAND BTREE_MAP_LEN mlen1, map1
    EXPAND BTREE_MAP_GET mg1, map1, alpha
    mlen1_ok = eq mlen1, 1
    mg1_ok = eq mg1, 1

    EXPAND BTREE_MAP_LIT2 map2, alpha, 1, bravo, 2
    EXPAND BTREE_MAP_LEN mlen2, map2
    EXPAND BTREE_MAP_GET mg2a, map2, alpha
    EXPAND BTREE_MAP_GET mg2b, map2, bravo
    mlen2_ok = eq mlen2, 2
    mg2a_ok = eq mg2a, 1
    mg2b_ok = eq mg2b, 2

    EXPAND BTREE_MAP_LIT3 map3, alpha, 1, bravo, 2, charlie, 3
    EXPAND BTREE_MAP_LEN mlen3, map3
    EXPAND BTREE_MAP_GET mg3a, map3, alpha
    EXPAND BTREE_MAP_GET mg3b, map3, bravo
    EXPAND BTREE_MAP_GET mg3c, map3, charlie
    mlen3_ok = eq mlen3, 3
    mg3a_ok = eq mg3a, 1
    mg3b_ok = eq mg3b, 2
    mg3c_ok = eq mg3c, 3

    EXPAND BTREE_SET_LIT1 set1, alpha
    EXPAND BTREE_SET_LEN slen1, set1
    EXPAND BTREE_SET_CONTAINS shas1, set1, alpha
    slen1_ok = eq slen1, 1
    shas1_ok = eq shas1, 1

    EXPAND BTREE_SET_LIT2 set2, alpha, bravo
    EXPAND BTREE_SET_LEN slen2, set2
    EXPAND BTREE_SET_CONTAINS shas2a, set2, alpha
    EXPAND BTREE_SET_CONTAINS shas2b, set2, bravo
    slen2_ok = eq slen2, 2
    shas2a_ok = eq shas2a, 1
    shas2b_ok = eq shas2b, 1

    EXPAND BTREE_SET_LIT3 set3, alpha, bravo, charlie
    EXPAND BTREE_SET_LEN slen3, set3
    EXPAND BTREE_SET_CONTAINS shas3a, set3, alpha
    EXPAND BTREE_SET_CONTAINS shas3b, set3, bravo
    EXPAND BTREE_SET_CONTAINS shas3c, set3, charlie
    slen3_ok = eq slen3, 3
    shas3a_ok = eq shas3a, 1
    shas3b_ok = eq shas3b, 1
    shas3c_ok = eq shas3c, 1

    EXPAND BTREE_MAP_FREE map1
    EXPAND BTREE_MAP_FREE map2
    EXPAND BTREE_MAP_FREE map3
    EXPAND BTREE_SET_FREE set1
    EXPAND BTREE_SET_FREE set2
    EXPAND BTREE_SET_FREE set3
    !alpha
    !bravo
    !charlie

    ok = and mlen1_ok, mg1_ok
    ok = and ok, mlen2_ok
    ok = and ok, mg2a_ok
    ok = and ok, mg2b_ok
    ok = and ok, mlen3_ok
    ok = and ok, mg3a_ok
    ok = and ok, mg3b_ok
    ok = and ok, mg3c_ok
    ok = and ok, slen1_ok
    ok = and ok, shas1_ok
    ok = and ok, slen2_ok
    ok = and ok, shas2a_ok
    ok = and ok, shas2b_ok
    ok = and ok, slen3_ok
    ok = and ok, shas3a_ok
    ok = and ok, shas3b_ok
    ok = and ok, shas3c_ok

    !mlen1
    !mg1
    !mlen2
    !mg2a
    !mg2b
    !mlen3
    !mg3a
    !mg3b
    !mg3c
    !slen1
    !shas1
    !slen2
    !shas2a
    !shas2b
    !slen3
    !shas3a
    !shas3b
    !shas3c
    !mlen1_ok
    !mg1_ok
    !mlen2_ok
    !mg2a_ok
    !mg2b_ok
    !mlen3_ok
    !mg3a_ok
    !mg3b_ok
    !mg3c_ok
    !slen1_ok
    !shas1_ok
    !slen2_ok
    !shas2a_ok
    !shas2b_ok
    !slen3_ok
    !shas3a_ok
    !shas3b_ok
    !shas3c_ok
    br ok -> L_BTREE_LIT_OK, L_BTREE_LIT_FAIL

L_BTREE_LIT_FAIL:
    !ok
    panic(929)

L_BTREE_LIT_OK:
    !ok
    return


@test "sa_std btree default aliases"():
L_ENTRY:
    EXPAND BTREE_MAP_DEFAULT map
    EXPAND BTREE_SET_DEFAULT set
    EXPAND BTREE_MAP_LEN map_len, map
    EXPAND BTREE_MAP_IS_EMPTY map_empty, map
    EXPAND BTREE_SET_LEN set_len, set
    EXPAND BTREE_SET_IS_EMPTY set_empty, set
    EXPAND BTREE_MAP_FREE map
    EXPAND BTREE_SET_FREE set

    ok_ml = eq map_len, 0
    ok_me = eq map_empty, 1
    ok_sl = eq set_len, 0
    ok_se = eq set_empty, 1
    ok01 = and ok_ml, ok_me
    ok02 = and ok01, ok_sl
    ok = and ok02, ok_se

    !map_len
    !map_empty
    !set_len
    !set_empty
    !ok_ml
    !ok_me
    !ok_sl
    !ok_se
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10433)
L_OK:
    !ok
    return
