@test "sa_std btree_map retain macro"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, bravo, 20
    EXPAND BTREE_MAP_INSERT map, charlie, 30
    EXPAND BTREE_MAP_RETAIN retain_len, map, @btree_map_retain_not_bravo
    EXPAND BTREE_MAP_LEN len_after_retain, map
    EXPAND BTREE_MAP_CONTAINS_KEY has_alpha, map, alpha
    EXPAND BTREE_MAP_CONTAINS_KEY has_bravo, map, bravo
    EXPAND BTREE_MAP_CONTAINS_KEY has_charlie, map, charlie
    EXPAND BTREE_MAP_GET alpha_value, map, alpha
    EXPAND BTREE_MAP_GET charlie_value, map, charlie
    EXPAND BTREE_MAP_FIRST_KEY_VALUE first_ok, first_key, first_value, map
    EXPAND BTREE_MAP_LAST_KEY_VALUE last_ok, last_key, last_value, map
    first_key_ptr = load first_key+Slice_ptr as ptr
    last_key_ptr = load last_key+Slice_ptr as ptr
    alpha_ptr = load alpha+Slice_ptr as ptr
    charlie_ptr = load charlie+Slice_ptr as ptr

