    !ok40
    !ok41
    !pop_last_key
    !pop_first_key
    !remove_bravo_key
    !last_key
    !first_key
    !kv_key
    !charlie
    !bravo
    !alpha
    EXPAND BTREE_MAP_FREE tail
    EXPAND BTREE_MAP_FREE map
    br ok -> L_MAP_OK, L_MAP_FAIL

L_MAP_FAIL:
    !ok
    panic(920)

L_MAP_OK:
    !ok
    return

@test "sa_std btree_map collection view macros"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    delta = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7
    EXPAND SLICE_NEW delta, &KEY_DELTA, 5

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, bravo, 20
    EXPAND BTREE_MAP_TRY_INSERT try_insert_new_ok, try_insert_new_ptr, map, charlie, 30
    try_insert_new_value = load try_insert_new_ptr+0 as u64
    EXPAND BTREE_MAP_TRY_INSERT try_insert_existing_ok, try_insert_existing_ptr, map, alpha, 99
    try_insert_existing_value = load try_insert_existing_ptr+0 as u64
    EXPAND BTREE_MAP_ENTRY_OR_INSERT entry_new_inserted, entry_new_ptr, map, delta, 40
    entry_new_value = load entry_new_ptr+0 as u64
    EXPAND BTREE_MAP_ENTRY_OR_INSERT entry_existing_inserted, entry_existing_ptr, map, bravo, 77
    entry_existing_value = load entry_existing_ptr+0 as u64

    EXPAND BTREE_MAP_FIRST_ENTRY_MUT_PTR first_entry_ok, first_entry_key, first_entry_ptr, map
    first_entry_key_len = load first_entry_key+Slice_len as u64
    store first_entry_ptr+0, 12 as u64
    EXPAND BTREE_MAP_LAST_ENTRY_MUT_PTR last_entry_ok, last_entry_key, last_entry_ptr, map
    last_entry_key_len = load last_entry_key+Slice_len as u64
    store last_entry_ptr+0, 33 as u64
    EXPAND BTREE_MAP_TRY_GET_DISJOINT_MUT_PTRS disjoint_ok, disjoint_alpha_ptr, disjoint_bravo_ptr, map, alpha, bravo
    store disjoint_alpha_ptr+0, 13 as u64
    store disjoint_bravo_ptr+0, 21 as u64
    EXPAND BTREE_MAP_TRY_GET_DISJOINT_MUT_PTRS same_key_ok, same_alpha_ptr, same_alpha_ptr2, map, alpha, alpha

    EXPAND BTREE_MAP_GET alpha_value, map, alpha
    EXPAND BTREE_MAP_GET bravo_value, map, bravo
    EXPAND BTREE_MAP_GET charlie_value, map, charlie
    EXPAND BTREE_MAP_GET delta_value, map, delta
    EXPAND BTREE_MAP_KEYS key_set, map
    EXPAND BTREE_SET_LEN key_set_len, key_set
    EXPAND BTREE_SET_CONTAINS key_set_has_alpha, key_set, alpha
    EXPAND BTREE_SET_CONTAINS key_set_has_bravo, key_set, bravo
    EXPAND BTREE_SET_CONTAINS key_set_has_charlie, key_set, charlie
    EXPAND BTREE_SET_CONTAINS key_set_has_delta, key_set, delta
    EXPAND BTREE_MAP_VALUES values_vec, map
    EXPAND VEC_LEN values_len, values_vec
    EXPAND VEC_CONTAINS_U64 values_has_alpha, values_vec, 13
    EXPAND VEC_CONTAINS_U64 values_has_bravo, values_vec, 21
    EXPAND VEC_CONTAINS_U64 values_has_charlie, values_vec, 30
    EXPAND VEC_CONTAINS_U64 values_has_delta, values_vec, 33
    EXPAND BTREE_MAP_VALUES_MUT_PTRS value_ptrs_vec, map
    EXPAND VEC_LEN value_ptrs_len, value_ptrs_vec
    disjoint_alpha_ptr_bits = bitcast disjoint_alpha_ptr as u64
    disjoint_bravo_ptr_bits = bitcast disjoint_bravo_ptr as u64
    try_insert_new_ptr_bits = bitcast try_insert_new_ptr as u64
    last_entry_ptr_bits = bitcast last_entry_ptr as u64
    EXPAND VEC_CONTAINS_U64 ptrs_has_alpha, value_ptrs_vec, disjoint_alpha_ptr_bits
    EXPAND VEC_CONTAINS_U64 ptrs_has_bravo, value_ptrs_vec, disjoint_bravo_ptr_bits
    EXPAND VEC_CONTAINS_U64 ptrs_has_charlie, value_ptrs_vec, try_insert_new_ptr_bits
    EXPAND VEC_CONTAINS_U64 ptrs_has_delta, value_ptrs_vec, last_entry_ptr_bits

    EXPAND BTREE_MAP_RANGE range_map, map, bravo, delta
    EXPAND BTREE_MAP_LEN range_len, range_map
    EXPAND BTREE_MAP_CONTAINS_KEY range_has_alpha, range_map, alpha
    EXPAND BTREE_MAP_CONTAINS_KEY range_has_bravo, range_map, bravo
    EXPAND BTREE_MAP_CONTAINS_KEY range_has_charlie, range_map, charlie
    EXPAND BTREE_MAP_CONTAINS_KEY range_has_delta, range_map, delta

    ok_try_insert_new = eq try_insert_new_ok, 1
    ok_try_insert_new_value = eq try_insert_new_value, 30
    ok_try_insert_existing_flag = eq try_insert_existing_ok, 0
    ok_try_insert_existing_value = eq try_insert_existing_value, 10
    ok_entry_new_inserted = eq entry_new_inserted, 1
    ok_entry_new_value = eq entry_new_value, 40
    ok_entry_existing_inserted = eq entry_existing_inserted, 0
    ok_entry_existing_value = eq entry_existing_value, 20
    ok_first_entry = eq first_entry_ok, 1
    ok_first_entry_len = eq first_entry_key_len, 5
    ok_last_entry = eq last_entry_ok, 1
    ok_last_entry_len = eq last_entry_key_len, 5
    ok_disjoint = eq disjoint_ok, 1
    ok_same_key = eq same_key_ok, 0
    ok_same_alpha_ptr = eq same_alpha_ptr, 0
    ok_same_alpha_ptr2 = eq same_alpha_ptr2, 0
    ok_alpha_value = eq alpha_value, 13
    ok_bravo_value = eq bravo_value, 21
    ok_charlie_value = eq charlie_value, 30
    ok_delta_value = eq delta_value, 33
    ok_key_set_len = eq key_set_len, 4
    ok_key_set_has_alpha = eq key_set_has_alpha, 1
    ok_key_set_has_bravo = eq key_set_has_bravo, 1
    ok_key_set_has_charlie = eq key_set_has_charlie, 1
    ok_key_set_has_delta = eq key_set_has_delta, 1
    ok_values_len = eq values_len, 4
    ok_values_has_alpha = eq values_has_alpha, 1
    ok_values_has_bravo = eq values_has_bravo, 1
    ok_values_has_charlie = eq values_has_charlie, 1
    ok_values_has_delta = eq values_has_delta, 1
    ok_value_ptrs_len = eq value_ptrs_len, 4
    ok_ptrs_has_alpha = eq ptrs_has_alpha, 1
    ok_ptrs_has_bravo = eq ptrs_has_bravo, 1
    ok_ptrs_has_charlie = eq ptrs_has_charlie, 1
    ok_ptrs_has_delta = eq ptrs_has_delta, 1
    ok_range_len = eq range_len, 2
    ok_range_has_alpha = eq range_has_alpha, 0
    ok_range_has_bravo = eq range_has_bravo, 1
    ok_range_has_charlie = eq range_has_charlie, 1
    ok_range_has_delta = eq range_has_delta, 0

    ok01 = and ok_try_insert_new, ok_try_insert_new_value
    ok02 = and ok01, ok_try_insert_existing_flag
    ok03 = and ok02, ok_try_insert_existing_value
    ok04 = and ok03, ok_entry_new_inserted
    ok05 = and ok04, ok_entry_new_value
    ok06 = and ok05, ok_entry_existing_inserted
    ok07 = and ok06, ok_entry_existing_value
    ok08 = and ok07, ok_first_entry
    ok09 = and ok08, ok_first_entry_len
    ok10 = and ok09, ok_last_entry
    ok11 = and ok10, ok_last_entry_len
    ok12 = and ok11, ok_disjoint
    ok13 = and ok12, ok_same_key
    ok14 = and ok13, ok_same_alpha_ptr
    ok15 = and ok14, ok_same_alpha_ptr2
    ok16 = and ok15, ok_alpha_value
    ok17 = and ok16, ok_bravo_value
    ok18 = and ok17, ok_charlie_value
    ok19 = and ok18, ok_delta_value
    ok20 = and ok19, ok_key_set_len
    ok21 = and ok20, ok_key_set_has_alpha
    ok22 = and ok21, ok_key_set_has_bravo
    ok23 = and ok22, ok_key_set_has_charlie
    ok24 = and ok23, ok_key_set_has_delta
    ok25 = and ok24, ok_values_len
    ok26 = and ok25, ok_values_has_alpha
    ok27 = and ok26, ok_values_has_bravo
    ok28 = and ok27, ok_values_has_charlie
    ok29 = and ok28, ok_values_has_delta
    ok30 = and ok29, ok_value_ptrs_len
    ok31 = and ok30, ok_ptrs_has_alpha
    ok32 = and ok31, ok_ptrs_has_bravo
    ok33 = and ok32, ok_ptrs_has_charlie
    ok34 = and ok33, ok_ptrs_has_delta
    ok35 = and ok34, ok_range_len
    ok36 = and ok35, ok_range_has_alpha
    ok37 = and ok36, ok_range_has_bravo
    ok38 = and ok37, ok_range_has_charlie
    ok = and ok38, ok_range_has_delta

    !try_insert_new_ok
    !try_insert_new_ptr
    !try_insert_new_value
    !try_insert_existing_ok
    !try_insert_existing_ptr
    !try_insert_existing_value
    !entry_new_inserted
    !entry_new_ptr
