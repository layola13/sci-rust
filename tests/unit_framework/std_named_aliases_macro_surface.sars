@import "sa_std/time/duration.sars"
@import "sa_std/time/instant.sars"
@import "sa_std/ffi/cstring.sars"
@import "sa_std/num/nonzero.sars"
@import "sa_std/thread/join_handle.sars"
@import "sa_std/core/slice.sars"
@import "sa_std/testing/assert.sai"

@test "sa_std named aliases"():
L_ENTRY:
    EXPAND DURATION_FROM_SECS duration, 2
    EXPAND DURATION_AS_MILLIS millis, duration
    EXPAND DURATION_CHECKED_ADD add_ok, sum, duration, duration
    EXPAND DURATION_ABS_DIFF diff, sum, duration
    EXPAND INSTANT_NOW instant
    EXPAND INSTANT_CHECKED_DURATION_SINCE since_ok, since, instant, instant

    cbuf = stack_alloc 4
    store cbuf+0, 104 as u8
    store cbuf+1, 105 as u8
    store cbuf+2, 0 as u8
    input = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW input, cbuf, 2
    cstring = stack_alloc CString_SIZE
    EXPAND CSTRING_FROM_SLICE cstr_ok, cstring, input
    no_nul = stack_alloc Slice_SIZE
    EXPAND CSTRING_AS_BYTES no_nul, cstring
    EXPAND SLICE_GET_LEN cstr_len, no_nul

    nz = stack_alloc NonZeroU64_SIZE
    EXPAND NONZERO_U64_NEW nz_ok, nz, 9
    EXPAND NONZERO_U64_GET nz_value, nz

    a = eq millis, 2000
    b = eq add_ok, 1
    c = eq sum, 4000000000
    d = eq diff, 2000000000
    e = eq since_ok, 1
    f = eq cstr_ok, CSTRING_NEW_OK
    g = eq cstr_len, 2
    h = eq nz_ok, 1
    i = eq nz_value, 9
    call @sa_assert_eq_i64(millis, 2000, 11142)
    call @sa_assert_eq_i64(add_ok, 1, 11143)
    call @sa_assert_eq_i64(sum, 4000000000, 11144)
    call @sa_assert_eq_i64(diff, 2000000000, 11145)
    call @sa_assert_eq_i64(since_ok, 1, 11146)
    call @sa_assert_eq_i64(cstr_ok, CSTRING_NEW_OK, 11147)
    call @sa_assert_eq_i64(cstr_len, 2, 11148)
    call @sa_assert_eq_i64(nz_ok, 1, 11149)
    call @sa_assert_eq_i64(nz_value, 9, 11150)
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok04 = and ok03, e
    ok05 = and ok04, f
    ok06 = and ok05, g
    ok07 = and ok06, h
    ok = and ok07, i

    !duration
    !millis
    !add_ok
    !sum
    !diff
    !instant
    !since_ok
    !since
    !cstr_ok
    !cstr_len
    !nz_ok
    !nz_value
    !a
    !b
    !c
    !d
    !e
    !f
    !g
    !h
    !i
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    br ok -> L_PASS, L_FAIL
L_PASS:
    !ok
    return 0
L_FAIL:
    !ok
    panic(11141)