@import "sa_std/num.sars"

[MACRO] TEST_NARROW_CARRY_BORROW_EQ %out_acc, %prev_acc, %value, %expected
    __test_narrow_carry_borrow_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_narrow_carry_borrow_eq_%out_acc
    !__test_narrow_carry_borrow_eq_%out_acc
[END_MACRO]

@test "sa_std narrow unsigned primitive carrying_add and borrowing_sub macro surface"():
L_ENTRY:
    EXPAND NUM_U8_CARRYING_ADD u8_sum0, u8_carry0, NUM_U8_MAX, 7, 0
    EXPAND NUM_U8_CARRYING_ADD u8_sum1, u8_carry1, 3, 5, u8_carry0
    EXPAND NUM_U16_CARRYING_ADD u16_sum0, u16_carry0, NUM_U16_MAX, 7, 0
    EXPAND NUM_U16_CARRYING_ADD u16_sum1, u16_carry1, 3, 5, u16_carry0
    EXPAND NUM_U32_CARRYING_ADD u32_sum0, u32_carry0, NUM_U32_MAX, 7, 0
    EXPAND NUM_U32_CARRYING_ADD u32_sum1, u32_carry1, 3, 5, u32_carry0

    EXPAND NUM_U8_BORROWING_SUB u8_diff0, u8_borrow0, 6, 7, 0
    EXPAND NUM_U8_BORROWING_SUB u8_diff1, u8_borrow1, 9, 5, u8_borrow0
    EXPAND NUM_U16_BORROWING_SUB u16_diff0, u16_borrow0, 6, 7, 0
    EXPAND NUM_U16_BORROWING_SUB u16_diff1, u16_borrow1, 9, 5, u16_borrow0
    EXPAND NUM_U32_BORROWING_SUB u32_diff0, u32_borrow0, 6, 7, 0
    EXPAND NUM_U32_BORROWING_SUB u32_diff1, u32_borrow1, 9, 5, u32_borrow0

    EXPAND NUM_U8_CARRYING_ADD u8_carry_in_value, u8_carry_in_flag, NUM_U8_MAX, 0, 1
    EXPAND NUM_U16_CARRYING_ADD u16_carry_in_value, u16_carry_in_flag, NUM_U16_MAX, 0, 1
    EXPAND NUM_U32_CARRYING_ADD u32_carry_in_value, u32_carry_in_flag, NUM_U32_MAX, 0, 1
    EXPAND NUM_U8_BORROWING_SUB u8_borrow_in_value, u8_borrow_in_flag, 0, 0, 1
    EXPAND NUM_U16_BORROWING_SUB u16_borrow_in_value, u16_borrow_in_flag, 0, 0, 1
    EXPAND NUM_U32_BORROWING_SUB u32_borrow_in_value, u32_borrow_in_flag, 0, 0, 1

    acc_00 = eq 0, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_01, acc_00, u8_sum0, 6
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_02, acc_01, u8_carry0, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_03, acc_02, u8_sum1, 9
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_04, acc_03, u8_carry1, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_05, acc_04, u16_sum0, 6
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_06, acc_05, u16_carry0, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_07, acc_06, u16_sum1, 9
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_08, acc_07, u16_carry1, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_09, acc_08, u32_sum0, 6
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_10, acc_09, u32_carry0, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_11, acc_10, u32_sum1, 9
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_12, acc_11, u32_carry1, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_13, acc_12, u8_diff0, NUM_U8_MAX
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_14, acc_13, u8_borrow0, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_15, acc_14, u8_diff1, 3
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_16, acc_15, u8_borrow1, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_17, acc_16, u16_diff0, NUM_U16_MAX
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_18, acc_17, u16_borrow0, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_19, acc_18, u16_diff1, 3
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_20, acc_19, u16_borrow1, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_21, acc_20, u32_diff0, NUM_U32_MAX
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_22, acc_21, u32_borrow0, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_23, acc_22, u32_diff1, 3
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_24, acc_23, u32_borrow1, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_25, acc_24, u8_carry_in_value, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_26, acc_25, u8_carry_in_flag, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_27, acc_26, u16_carry_in_value, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_28, acc_27, u16_carry_in_flag, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_29, acc_28, u32_carry_in_value, 0
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_30, acc_29, u32_carry_in_flag, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_31, acc_30, u8_borrow_in_value, NUM_U8_MAX
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_32, acc_31, u8_borrow_in_flag, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_33, acc_32, u16_borrow_in_value, NUM_U16_MAX
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_34, acc_33, u16_borrow_in_flag, 1
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_35, acc_34, u32_borrow_in_value, NUM_U32_MAX
    EXPAND TEST_NARROW_CARRY_BORROW_EQ acc_36, acc_35, u32_borrow_in_flag, 1
    br acc_36 -> L_PASS, L_FAIL

L_FAIL:
    !acc_36
    panic(10651)

L_PASS:
    !acc_36
    return 0
