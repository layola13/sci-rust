@import "sa_std/num.sars"

@test "sa_std nonzero count_ones NonZeroU32 macro surface"():
L_ENTRY:
    u8_nz = stack_alloc NonZeroU8_SIZE
    u16_nz = stack_alloc NonZeroU16_SIZE
    u32_nz = stack_alloc NonZeroU32_SIZE
    u64_nz = stack_alloc NonZeroU64_SIZE
    usize_nz = stack_alloc NonZeroUsize_SIZE
    i8_nz = stack_alloc NonZeroI8_SIZE
    i16_nz = stack_alloc NonZeroI16_SIZE
    i32_nz = stack_alloc NonZeroI32_SIZE
    i64_nz = stack_alloc NonZeroI64_SIZE
    isize_nz = stack_alloc NonZeroIsize_SIZE

    u8_count = stack_alloc NonZeroU32_SIZE
    u16_count = stack_alloc NonZeroU32_SIZE
    u32_count = stack_alloc NonZeroU32_SIZE
    u64_count = stack_alloc NonZeroU32_SIZE
    usize_count = stack_alloc NonZeroU32_SIZE
    i8_count = stack_alloc NonZeroU32_SIZE
    i16_count = stack_alloc NonZeroU32_SIZE
    i32_count = stack_alloc NonZeroU32_SIZE
    i64_count = stack_alloc NonZeroU32_SIZE
    isize_count = stack_alloc NonZeroU32_SIZE

    EXPAND NONZERO_U8_NEW ok_u8, u8_nz, 176
    EXPAND NONZERO_U16_NEW ok_u16, u16_nz, 61680
    EXPAND NONZERO_U32_NEW ok_u32, u32_nz, 2147483649
    EXPAND NONZERO_U64_NEW ok_u64, u64_nz, NUM_U64_MAX
    EXPAND NONZERO_USIZE_NEW ok_usize, usize_nz, NUM_U64_MAX
    EXPAND NONZERO_I8_NEW ok_i8, i8_nz, -1
    EXPAND NONZERO_I16_NEW ok_i16, i16_nz, NUM_I16_MIN
    EXPAND NONZERO_I32_NEW ok_i32, i32_nz, -1
    EXPAND NONZERO_I64_NEW ok_i64, i64_nz, -1
    EXPAND NONZERO_ISIZE_NEW ok_isize, isize_nz, NUM_I64_MIN

    EXPAND NONZERO_U8_COUNT_ONES_NZ_U32 u8_count, u8_nz
    EXPAND NONZERO_U16_COUNT_ONES_NZ_U32 u16_count, u16_nz
    EXPAND NONZERO_U32_COUNT_ONES_NZ_U32 u32_count, u32_nz
    EXPAND NONZERO_U64_COUNT_ONES_NZ_U32 u64_count, u64_nz
    EXPAND NONZERO_USIZE_COUNT_ONES_NZ_U32 usize_count, usize_nz
    EXPAND NONZERO_I8_COUNT_ONES_NZ_U32 i8_count, i8_nz
    EXPAND NONZERO_I16_COUNT_ONES_NZ_U32 i16_count, i16_nz
    EXPAND NONZERO_I32_COUNT_ONES_NZ_U32 i32_count, i32_nz
    EXPAND NONZERO_I64_COUNT_ONES_NZ_U32 i64_count, i64_nz
    EXPAND NONZERO_ISIZE_COUNT_ONES_NZ_U32 isize_count, isize_nz

    EXPAND NONZERO_U32_GET u8_value, u8_count
    EXPAND NONZERO_U32_GET u16_value, u16_count
    EXPAND NONZERO_U32_GET u32_value, u32_count
    EXPAND NONZERO_U32_GET u64_value, u64_count
    EXPAND NONZERO_U32_GET usize_value, usize_count
    EXPAND NONZERO_U32_GET i8_value, i8_count
    EXPAND NONZERO_U32_GET i16_value, i16_count
    EXPAND NONZERO_U32_GET i32_value, i32_count
    EXPAND NONZERO_U32_GET i64_value, i64_count
    EXPAND NONZERO_U32_GET isize_value, isize_count

    ok_new_01 = and ok_u8, ok_u16
    ok_new_02 = and ok_new_01, ok_u32
    ok_new_03 = and ok_new_02, ok_u64
    ok_new_04 = and ok_new_03, ok_usize
    ok_new_05 = and ok_new_04, ok_i8
    ok_new_06 = and ok_new_05, ok_i16
    ok_new_07 = and ok_new_06, ok_i32
    ok_new_08 = and ok_new_07, ok_i64
    ok_new_all = and ok_new_08, ok_isize

    ok_u8_value = eq u8_value, 3
    ok_u16_value = eq u16_value, 8
    ok_u32_value = eq u32_value, 2
    ok_u64_value = eq u64_value, 64
    ok_usize_value = eq usize_value, 64
    ok_i8_value = eq i8_value, 8
    ok_i16_value = eq i16_value, 1
    ok_i32_value = eq i32_value, 32
    ok_i64_value = eq i64_value, 64
    ok_isize_value = eq isize_value, 1

    ok_value_01 = and ok_new_all, ok_u8_value
    ok_value_02 = and ok_value_01, ok_u16_value
    ok_value_03 = and ok_value_02, ok_u32_value
    ok_value_04 = and ok_value_03, ok_u64_value
    ok_value_05 = and ok_value_04, ok_usize_value
    ok_value_06 = and ok_value_05, ok_i8_value
    ok_value_07 = and ok_value_06, ok_i16_value
    ok_value_08 = and ok_value_07, ok_i32_value
    ok_value_09 = and ok_value_08, ok_i64_value
    ok = and ok_value_09, ok_isize_value
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10616)

L_PASS:
    !ok
    return 0
