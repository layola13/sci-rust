@import "sa_std/num.sars"

@test "sa_std primitive checked and strict neg abs macro surface"():
L_ENTRY:
    EXPAND NUM_U8_CHECKED_NEG u8_checked_zero_ok, u8_checked_zero, 0
    EXPAND NUM_U16_CHECKED_NEG u16_checked_zero_ok, u16_checked_zero, 0
    EXPAND NUM_U32_CHECKED_NEG u32_checked_zero_ok, u32_checked_zero, 0
    EXPAND NUM_U64_CHECKED_NEG u64_checked_zero_ok, u64_checked_zero, 0
    EXPAND NUM_USIZE_CHECKED_NEG usize_checked_zero_ok, usize_checked_zero, 0
    EXPAND NUM_U8_CHECKED_NEG u8_checked_one_ok, u8_checked_one, 1
    EXPAND NUM_U16_CHECKED_NEG u16_checked_one_ok, u16_checked_one, 1
    EXPAND NUM_U32_CHECKED_NEG u32_checked_one_ok, u32_checked_one, 1
    EXPAND NUM_U64_CHECKED_NEG u64_checked_one_ok, u64_checked_one, 1
    EXPAND NUM_USIZE_CHECKED_NEG usize_checked_one_ok, usize_checked_one, 1

    EXPAND NUM_U8_STRICT_NEG u8_strict_neg, 0
    EXPAND NUM_U16_STRICT_NEG u16_strict_neg, 0
    EXPAND NUM_U32_STRICT_NEG u32_strict_neg, 0
    EXPAND NUM_U64_STRICT_NEG u64_strict_neg, 0
    EXPAND NUM_USIZE_STRICT_NEG usize_strict_neg, 0

    EXPAND NUM_I8_STRICT_NEG i8_strict_neg, -7
    EXPAND NUM_I16_STRICT_NEG i16_strict_neg, -7
    EXPAND NUM_I32_STRICT_NEG i32_strict_neg, -7
    EXPAND NUM_I64_STRICT_NEG i64_strict_neg, -7
    EXPAND NUM_ISIZE_STRICT_NEG isize_strict_neg, -7

    EXPAND NUM_I8_STRICT_ABS i8_strict_abs_neg, -7
    EXPAND NUM_I16_STRICT_ABS i16_strict_abs_neg, -7
    EXPAND NUM_I32_STRICT_ABS i32_strict_abs_neg, -7
    EXPAND NUM_I64_STRICT_ABS i64_strict_abs_neg, -7
    EXPAND NUM_ISIZE_STRICT_ABS isize_strict_abs_neg, -7
    EXPAND NUM_I64_STRICT_ABS i64_strict_abs_pos, 7

    ok_01 = eq u8_checked_zero_ok, 1
    ok_02 = eq u16_checked_zero_ok, 1
    ok_03 = eq u32_checked_zero_ok, 1
    ok_04 = eq u64_checked_zero_ok, 1
    ok_05 = eq usize_checked_zero_ok, 1
    ok_06 = eq u8_checked_zero, 0
    ok_07 = eq u16_checked_zero, 0
    ok_08 = eq u32_checked_zero, 0
    ok_09 = eq u64_checked_zero, 0
    ok_10 = eq usize_checked_zero, 0
    ok_11 = eq u8_checked_one_ok, 0
    ok_12 = eq u16_checked_one_ok, 0
    ok_13 = eq u32_checked_one_ok, 0
    ok_14 = eq u64_checked_one_ok, 0
    ok_15 = eq usize_checked_one_ok, 0
    ok_16 = eq u8_checked_one, 0
    ok_17 = eq u16_checked_one, 0
    ok_18 = eq u32_checked_one, 0
    ok_19 = eq u64_checked_one, 0
    ok_20 = eq usize_checked_one, 0
    ok_21 = eq u8_strict_neg, 0
    ok_22 = eq u16_strict_neg, 0
    ok_23 = eq u32_strict_neg, 0
    ok_24 = eq u64_strict_neg, 0
    ok_25 = eq usize_strict_neg, 0
    ok_26 = eq i8_strict_neg, 7
    ok_27 = eq i16_strict_neg, 7
    ok_28 = eq i32_strict_neg, 7
    ok_29 = eq i64_strict_neg, 7
    ok_30 = eq isize_strict_neg, 7
    ok_31 = eq i8_strict_abs_neg, 7
    ok_32 = eq i16_strict_abs_neg, 7
    ok_33 = eq i32_strict_abs_neg, 7
    ok_34 = eq i64_strict_abs_neg, 7
    ok_35 = eq isize_strict_abs_neg, 7
    ok_36 = eq i64_strict_abs_pos, 7

    acc_01 = and ok_01, ok_02
    acc_02 = and acc_01, ok_03
    acc_03 = and acc_02, ok_04
    acc_04 = and acc_03, ok_05
    acc_05 = and acc_04, ok_06
    acc_06 = and acc_05, ok_07
    acc_07 = and acc_06, ok_08
    acc_08 = and acc_07, ok_09
    acc_09 = and acc_08, ok_10
    acc_10 = and acc_09, ok_11
    acc_11 = and acc_10, ok_12
    acc_12 = and acc_11, ok_13
    acc_13 = and acc_12, ok_14
    acc_14 = and acc_13, ok_15
    acc_15 = and acc_14, ok_16
    acc_16 = and acc_15, ok_17
    acc_17 = and acc_16, ok_18
    acc_18 = and acc_17, ok_19
    acc_19 = and acc_18, ok_20
    acc_20 = and acc_19, ok_21
    acc_21 = and acc_20, ok_22
    acc_22 = and acc_21, ok_23
    acc_23 = and acc_22, ok_24
    acc_24 = and acc_23, ok_25
    acc_25 = and acc_24, ok_26
    acc_26 = and acc_25, ok_27
    acc_27 = and acc_26, ok_28
    acc_28 = and acc_27, ok_29
    acc_29 = and acc_28, ok_30
    acc_30 = and acc_29, ok_31
    acc_31 = and acc_30, ok_32
    acc_32 = and acc_31, ok_33
    acc_33 = and acc_32, ok_34
    acc_34 = and acc_33, ok_35
    ok = and acc_34, ok_36
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10637)

L_PASS:
    !ok
    return 0

@test should_panic "sa_std unsigned strict_neg panics on nonzero"():
L_ENTRY:
    EXPAND NUM_U8_STRICT_NEG value, 1
    !value
    return 0

@test should_panic "sa_std signed strict_neg panics on minimum"():
L_ENTRY:
    EXPAND NUM_I64_STRICT_NEG value, NUM_I64_MIN
    !value
    return 0

@test should_panic "sa_std signed strict_abs panics on minimum"():
L_ENTRY:
    EXPAND NUM_I8_STRICT_ABS value, NUM_I8_MIN
    !value
    return 0
