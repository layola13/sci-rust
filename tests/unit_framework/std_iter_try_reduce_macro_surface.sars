@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"

@iter_try_reduce_sum_until_ten(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    next = add acc, value
    keep = ule next, 10
    br keep -> L_KEEP, L_STOP
L_KEEP:
    store out_next+0, next as u64
    !keep
    !next
    !out_next
    !value
    !acc
    return 1
L_STOP:
    !keep
    !next
    !out_next
    !value
    !acc
    return 0

@iter_try_reduce_sum_all(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    next = add acc, value
    store out_next+0, next as u64
    !next
    !out_next
    !value
    !acc
    return 1

@test "sa_std iter try_reduce macro surface"():
L_ENTRY:
    values = stack_alloc 40
    empty_values = stack_alloc 8

    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 8 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE stop_iter, slice
    EXPAND ITER_TRY_REDUCE_U64 stop_ok, stop_has, stop_value, stop_iter, @iter_try_reduce_sum_until_ten
    EXPAND ITER_LEN stop_remaining, stop_iter
    EXPAND ITER_NEXT_U64 stop_tail_ok, stop_tail_value, stop_iter
    EXPAND ITER_IS_EMPTY stop_empty_after_tail, stop_iter

    EXPAND ITER_FROM_SLICE all_iter, slice
    EXPAND ITER_TRY_REDUCE_U64 all_ok, all_has, all_value, all_iter, @iter_try_reduce_sum_all
    EXPAND ITER_IS_EMPTY all_empty, all_iter

    EXPAND ITER_FROM_SLICE tail_iter, slice
    EXPAND ITER_NEXT_U64 tail_first_ok, tail_first_value, tail_iter
    EXPAND ITER_TRY_REDUCE_U64 tail_ok, tail_has, tail_value, tail_iter, @iter_try_reduce_sum_all
    EXPAND ITER_IS_EMPTY tail_empty, tail_iter

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_TRY_REDUCE_U64 empty_ok, empty_has, empty_value, empty_iter, @iter_try_reduce_sum_until_ten
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter

    ok_stop_ok = eq stop_ok, 0
    ok_stop_has = eq stop_has, 0
    ok_stop_value = eq stop_value, 6
    ok_stop_remaining = eq stop_remaining, 1
    ok_stop_tail_ok = eq stop_tail_ok, 1
    ok_stop_tail_value = eq stop_tail_value, 5
    ok_stop_empty_after_tail = eq stop_empty_after_tail, 1
    ok_all_ok = eq all_ok, 1
    ok_all_has = eq all_has, 1
    ok_all_value = eq all_value, 19
    ok_all_empty = eq all_empty, 1
    ok_tail_first_ok = eq tail_first_ok, 1
    ok_tail_first_value = eq tail_first_value, 1
    ok_tail_ok = eq tail_ok, 1
    ok_tail_has = eq tail_has, 1
    ok_tail_value = eq tail_value, 18
    ok_tail_empty = eq tail_empty, 1
    ok_empty_ok = eq empty_ok, 1
    ok_empty_has = eq empty_has, 0
    ok_empty_value = eq empty_value, 0
    ok_empty_iter_empty = eq empty_iter_empty, 1

    c01 = and ok_stop_ok, ok_stop_has
    c02 = and c01, ok_stop_value
    c03 = and c02, ok_stop_remaining
    c04 = and c03, ok_stop_tail_ok
    c05 = and c04, ok_stop_tail_value
    c06 = and c05, ok_stop_empty_after_tail
    c07 = and c06, ok_all_ok
    c08 = and c07, ok_all_has
    c09 = and c08, ok_all_value
    c10 = and c09, ok_all_empty
    c11 = and c10, ok_tail_first_ok
    c12 = and c11, ok_tail_first_value
    c13 = and c12, ok_tail_ok
    c14 = and c13, ok_tail_has
    c15 = and c14, ok_tail_value
    c16 = and c15, ok_tail_empty
    c17 = and c16, ok_empty_ok
    c18 = and c17, ok_empty_has
    c19 = and c18, ok_empty_value
    ok = and c19, ok_empty_iter_empty

    !stop_ok
    !stop_has
    !stop_value
    !stop_remaining
    !stop_tail_ok
    !stop_tail_value
    !stop_empty_after_tail
    !all_ok
    !all_has
    !all_value
    !all_empty
    !tail_first_ok
    !tail_first_value
    !tail_ok
    !tail_has
    !tail_value
    !tail_empty
    !empty_ok
    !empty_has
    !empty_value
    !empty_iter_empty
    !ok_stop_ok
    !ok_stop_has
    !ok_stop_value
    !ok_stop_remaining
    !ok_stop_tail_ok
    !ok_stop_tail_value
    !ok_stop_empty_after_tail
    !ok_all_ok
    !ok_all_has
    !ok_all_value
    !ok_all_empty
    !ok_tail_first_ok
    !ok_tail_first_value
    !ok_tail_ok
    !ok_tail_has
    !ok_tail_value
    !ok_tail_empty
    !ok_empty_ok
    !ok_empty_has
    !ok_empty_value
    !ok_empty_iter_empty
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !c19
    !empty_iter
    !tail_iter
    !all_iter
    !stop_iter
    !empty_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10544)

L_PASS:
    !ok
    return 0
