@import "sa_std/collections/hashset.sars"

@const A = utf8:"alpha"

@test "sa_std hashset remove"():
L_ENTRY:
    EXPAND SET_NEW set
    key = &A
    EXPAND SET_INSERT ins, set, key
    EXPAND SET_CONTAINS c0, set, key
    EXPAND SET_REMOVE rem, set, key
    EXPAND SET_CONTAINS c1, set, key
    EXPAND SET_FREE set
    a = eq ins, 1
    b = eq c0, 1
    c = eq rem, 1
    d = eq c1, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !ins
    !c0
    !rem
    !c1
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10984)
