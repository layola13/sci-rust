@import "sa_std/vec_deque.sars"

@test "sa_std vec_deque iterator pair collect macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY enumerate_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK enumerate_deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK enumerate_deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK enumerate_deque, 7
    EXPAND VEC_DEQUE_ITER_U64 enumerate_iter, enumerate_backing, enumerate_deque
    EXPAND VEC_DEQUE_ITER_NEXT_U64 enumerate_skip_has, enumerate_skip, enumerate_iter
    EXPAND VEC_DEQUE_ITER_ENUMERATE_COLLECT_U64 enumerate_vec, enumerate_iter
    EXPAND VEC_LEN enumerate_len, enumerate_vec
    EXPAND VEC_GET_U64 enumerate_0, enumerate_vec, 0
    EXPAND VEC_GET_U64 enumerate_1, enumerate_vec, 1
    EXPAND VEC_GET_U64 enumerate_2, enumerate_vec, 2
    EXPAND VEC_GET_U64 enumerate_3, enumerate_vec, 3
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 enumerate_empty, enumerate_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY zip_left_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK zip_left_deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK zip_left_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK zip_left_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK zip_left_deque, 3
    EXPAND VEC_DEQUE_TRY_POP_FRONT zip_left_pop_ok, zip_left_pop, zip_left_deque
    EXPAND VEC_DEQUE_PUSH_BACK zip_left_deque, 4
    EXPAND VEC_DEQUE_WITH_CAPACITY zip_right_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK zip_right_deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK zip_right_deque, 20
    EXPAND VEC_DEQUE_ITER_U64 zip_left_iter, zip_left_backing, zip_left_deque
    EXPAND VEC_DEQUE_ITER_U64 zip_right_iter, zip_right_backing, zip_right_deque
    EXPAND VEC_DEQUE_ITER_ZIP_COLLECT_U64 zip_vec, zip_left_iter, zip_right_iter
    EXPAND VEC_LEN zip_len, zip_vec
    EXPAND VEC_GET_U64 zip_0, zip_vec, 0
    EXPAND VEC_GET_U64 zip_1, zip_vec, 1
    EXPAND VEC_GET_U64 zip_2, zip_vec, 2
    EXPAND VEC_GET_U64 zip_3, zip_vec, 3
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 zip_left_remaining, zip_left_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 zip_left_tail_has, zip_left_tail, zip_left_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 zip_right_empty, zip_right_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY chain_left_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK chain_left_deque, 8
    EXPAND VEC_DEQUE_PUSH_BACK chain_left_deque, 9
    EXPAND VEC_DEQUE_WITH_CAPACITY chain_right_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK chain_right_deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK chain_right_deque, 40
    EXPAND VEC_DEQUE_PUSH_BACK chain_right_deque, 50
    EXPAND VEC_DEQUE_ITER_U64 chain_left_iter, chain_left_backing, chain_left_deque
    EXPAND VEC_DEQUE_ITER_U64 chain_right_iter, chain_right_backing, chain_right_deque
    EXPAND VEC_DEQUE_ITER_CHAIN_COLLECT_U64 chain_vec, chain_left_iter, chain_right_iter
    EXPAND VEC_LEN chain_len, chain_vec
    EXPAND VEC_GET_U64 chain_0, chain_vec, 0
    EXPAND VEC_GET_U64 chain_1, chain_vec, 1
    EXPAND VEC_GET_U64 chain_2, chain_vec, 2
    EXPAND VEC_GET_U64 chain_4, chain_vec, 4
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 chain_left_empty, chain_left_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 chain_right_empty, chain_right_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 11
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 12
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 13
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_ENUMERATE_COLLECT_U64 into_vec, into_iter
    EXPAND VEC_LEN into_len, into_vec
    EXPAND VEC_GET_U64 into_0, into_vec, 0
    EXPAND VEC_GET_U64 into_1, into_vec, 1
    EXPAND VEC_GET_U64 into_4, into_vec, 4
    EXPAND VEC_GET_U64 into_5, into_vec, 5
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_FREE enumerate_backing
    EXPAND VEC_FREE enumerate_vec
    EXPAND VEC_FREE zip_left_backing
    EXPAND VEC_FREE zip_right_backing
    EXPAND VEC_FREE zip_vec
    EXPAND VEC_FREE chain_left_backing
    EXPAND VEC_FREE chain_right_backing
    EXPAND VEC_FREE chain_vec
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_vec
    EXPAND VEC_DEQUE_FREE enumerate_deque
    EXPAND VEC_DEQUE_FREE zip_left_deque
    EXPAND VEC_DEQUE_FREE zip_right_deque
    EXPAND VEC_DEQUE_FREE chain_left_deque
    EXPAND VEC_DEQUE_FREE chain_right_deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq enumerate_skip_has, 1
    check = eq enumerate_skip, 5
    ok = and ok, check
    check = eq enumerate_len, 4
    ok = and ok, check
    check = eq enumerate_0, 0
    ok = and ok, check
    check = eq enumerate_1, 6
    ok = and ok, check
    check = eq enumerate_2, 1
    ok = and ok, check
    check = eq enumerate_3, 7
    ok = and ok, check
    check = eq enumerate_empty, 1
    ok = and ok, check
    check = eq zip_left_pop_ok, 1
    ok = and ok, check
    check = eq zip_left_pop, 10
    ok = and ok, check
    check = eq zip_len, 4
    ok = and ok, check
    check = eq zip_0, 1
    ok = and ok, check
    check = eq zip_1, 10
    ok = and ok, check
    check = eq zip_2, 2
    ok = and ok, check
    check = eq zip_3, 20
    ok = and ok, check
    check = eq zip_left_remaining, 1
    ok = and ok, check
    check = eq zip_left_tail_has, 1
    ok = and ok, check
    check = eq zip_left_tail, 4
    ok = and ok, check
    check = eq zip_right_empty, 1
    ok = and ok, check
    check = eq chain_len, 5
    ok = and ok, check
    check = eq chain_0, 8
    ok = and ok, check
    check = eq chain_1, 9
    ok = and ok, check
    check = eq chain_2, 30
    ok = and ok, check
    check = eq chain_4, 50
    ok = and ok, check
    check = eq chain_left_empty, 1
    ok = and ok, check
    check = eq chain_right_empty, 1
    ok = and ok, check
    check = eq into_len, 6
    ok = and ok, check
    check = eq into_0, 0
    ok = and ok, check
    check = eq into_1, 11
    ok = and ok, check
    check = eq into_4, 2
    ok = and ok, check
    check = eq into_5, 13
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check

    !enumerate_skip_has
    !enumerate_skip
    !enumerate_len
    !enumerate_0
    !enumerate_1
    !enumerate_2
    !enumerate_3
    !enumerate_empty
    !zip_left_pop_ok
    !zip_left_pop
    !zip_len
    !zip_0
    !zip_1
    !zip_2
    !zip_3
    !zip_left_remaining
    !zip_left_tail_has
    !zip_left_tail
    !zip_right_empty
    !chain_len
    !chain_0
    !chain_1
    !chain_2
    !chain_4
    !chain_left_empty
    !chain_right_empty
    !into_len
    !into_0
    !into_1
    !into_4
    !into_5
    !into_empty
    !into_deque_empty
    !check
    !enumerate_iter
    !zip_left_iter
    !zip_right_iter
    !chain_left_iter
    !chain_right_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_PAIR_COLLECT_OK, L_VEC_DEQUE_ITER_PAIR_COLLECT_FAIL

L_VEC_DEQUE_ITER_PAIR_COLLECT_FAIL:
    !ok
    panic(10796)

L_VEC_DEQUE_ITER_PAIR_COLLECT_OK:
    !ok
    return
