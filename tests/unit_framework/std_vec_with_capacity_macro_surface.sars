@import "sa_std/vec.sars"

@test "sa_std vec with_capacity"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 v, 8
    EXPAND VEC_CAPACITY cap, v
    EXPAND VEC_LEN ln, v
    EXPAND VEC_FREE v
    a = uge cap, 8
    b = eq ln, 0
    ok = and a, b
    !cap
    !ln
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10951)
