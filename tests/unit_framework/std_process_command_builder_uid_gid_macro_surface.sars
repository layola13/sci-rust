@import "sa_std/process.sars"

@const TRUE_BIN = utf8:"/bin/true"

#def TRUE_BIN_LEN = 9
#def TRUE_ARGV1_SIZE = 16

@test "sa_std process Command builder uid gid macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV1_SIZE
    dummy = stack_alloc 1
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, TRUE_BIN, TRUE_BIN_LEN
    EXPAND PROCESS_USER_ID current_uid
    EXPAND PROCESS_GROUP_ID current_gid

    EXPAND PROCESS_COMMAND_BUILDER_NEW cwd_len0, has_cwd0, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0
    EXPAND PROCESS_COMMAND_BUILDER_STATUS_UID_GID run_status, run_process, argv, 1, dummy, cwd_len0, has_cwd0, dummy, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0, current_uid, 1, current_gid, 1
    run_status_ok = eq run_status, SA_PROCESS_OK
    run_process_ok = ne run_process, 0
    run_ok = and run_status_ok, run_process_ok
    br run_ok -> L_RUN_WAIT, L_FAIL_RUN

L_FAIL_RUN:
    !run_ok
    !run_process_ok
    !run_status_ok
    !run_process
    !run_status
    !current_uid
    !current_gid
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    panic(10685)

L_RUN_WAIT:
    EXPAND PROCESS_WAIT run_wait_status, run_code, run_process
    EXPAND PROCESS_CLOSE run_close_status, run_process
    run_wait_ok = eq run_wait_status, SA_PROCESS_OK
    run_code_ok = eq run_code, 0
    run_close_ok = eq run_close_status, SA_PROCESS_OK
    run_all = and run_wait_ok, run_code_ok
    run_all = and run_all, run_close_ok
    br run_all -> L_SPAWN, L_FAIL_RUN_WAIT

L_FAIL_RUN_WAIT:
    !run_all
    !run_close_ok
    !run_code_ok
    !run_wait_ok
    !run_close_status
    !run_code
    !run_wait_status
    !run_ok
    !run_process_ok
    !run_status_ok
    !run_process
    !run_status
    !current_uid
    !current_gid
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    panic(10685)

L_SPAWN:
    EXPAND PROCESS_COMMAND_BUILDER_SPAWN_UID_GID spawn_status, spawn_process, argv, 1, dummy, cwd_len0, has_cwd0, dummy, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0, current_uid, 1, current_gid, 1
    spawn_status_ok = eq spawn_status, SA_PROCESS_OK
    spawn_process_ok = ne spawn_process, 0
    spawn_ok = and spawn_status_ok, spawn_process_ok
    br spawn_ok -> L_SPAWN_WAIT, L_FAIL_SPAWN

L_FAIL_SPAWN:
    !spawn_ok
    !spawn_process_ok
    !spawn_status_ok
    !spawn_process
    !spawn_status
    !run_all
    !run_close_ok
    !run_code_ok
    !run_wait_ok
    !run_close_status
    !run_code
    !run_wait_status
    !run_ok
    !run_process_ok
    !run_status_ok
    !run_process
    !run_status
    !current_uid
    !current_gid
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    panic(10685)

L_SPAWN_WAIT:
    EXPAND PROCESS_WAIT spawn_wait_status, spawn_code, spawn_process
    EXPAND PROCESS_CLOSE spawn_close_status, spawn_process
    spawn_wait_ok = eq spawn_wait_status, SA_PROCESS_OK
    spawn_code_ok = eq spawn_code, 0
    spawn_close_ok = eq spawn_close_status, SA_PROCESS_OK
    ok00 = and spawn_ok, spawn_wait_ok
    ok01 = and ok00, spawn_code_ok
    ok = and ok01, spawn_close_ok

    !spawn_wait_status
    !spawn_code
    !spawn_close_status
    !spawn_wait_ok
    !spawn_code_ok
    !spawn_close_ok
    !ok00
    !ok01
    !spawn_ok
    !spawn_process_ok
    !spawn_status_ok
    !spawn_process
    !spawn_status
    !run_all
    !run_close_ok
    !run_code_ok
    !run_wait_ok
    !run_close_status
    !run_code
    !run_wait_status
    !run_ok
    !run_process_ok
    !run_status_ok
    !run_process
    !run_status
    !current_uid
    !current_gid
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10685)

L_PASS:
    !ok
    return 0
