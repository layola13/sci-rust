@import "sa_std/collections/vec_deque.sars"

@keep_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    !value
    return out

@keep_odd_mut(value_ptr: ptr) -> u64:
L_ENTRY:
    value = load value_ptr+0 as u64
    rem = urem value, 2
    keep = eq rem, 1
    !rem
    !value
    !value_ptr
    return keep

@test "sa_std vec_deque retain/retain_mut aliases"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK deque, 6
    EXPAND VEC_DEQUE_RETAIN remain_len, deque, @keep_even
    EXPAND VEC_DEQUE_TRY_GET v0_ok, v0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET v1_ok, v1, deque, 1
    EXPAND VEC_DEQUE_TRY_GET v2_ok, v2, deque, 2
    EXPAND VEC_DEQUE_LEN len_after_retain, deque

    EXPAND VEC_DEQUE_NEW empty
    EXPAND VEC_DEQUE_RETAIN empty_remain_len, empty, @keep_even
    EXPAND VEC_DEQUE_IS_EMPTY empty_still_empty, empty

    EXPAND VEC_DEQUE_WITH_CAPACITY mut_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK mut_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK mut_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK mut_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK mut_deque, 4
    EXPAND VEC_DEQUE_RETAIN_MUT mut_remain_len, mut_deque, @keep_odd_mut
    EXPAND VEC_DEQUE_TRY_GET m0_ok, m0, mut_deque, 0
    EXPAND VEC_DEQUE_TRY_GET m1_ok, m1, mut_deque, 1
    EXPAND VEC_DEQUE_TRY_GET m2_ok, m2, mut_deque, 2
    EXPAND VEC_DEQUE_LEN mut_len, mut_deque

    ok_remain = eq remain_len, 3
    ok_len = eq len_after_retain, 3
    ok_v0_flag = eq v0_ok, 1
    ok_v0 = eq v0, 2
    ok_v1_flag = eq v1_ok, 1
    ok_v1 = eq v1, 4
    ok_v2_flag = eq v2_ok, 1
    ok_v2 = eq v2, 6
    ok_empty_remain = eq empty_remain_len, 0
    ok_empty = eq empty_still_empty, 1
    ok_mut_remain = eq mut_remain_len, 2
    ok_mut_len = eq mut_len, 2
    ok_m0_flag = eq m0_ok, 1
    ok_m0 = eq m0, 1
    ok_m1_flag = eq m1_ok, 1
    ok_m1 = eq m1, 3
    ok_m2_flag = eq m2_ok, 0

    ok = and ok_remain, ok_len
    ok = and ok, ok_v0_flag
    ok = and ok, ok_v0
    ok = and ok, ok_v1_flag
    ok = and ok, ok_v1
    ok = and ok, ok_v2_flag
    ok = and ok, ok_v2
    ok = and ok, ok_empty_remain
    ok = and ok, ok_empty
    ok = and ok, ok_mut_remain
    ok = and ok, ok_mut_len
    ok = and ok, ok_m0_flag
    ok = and ok, ok_m0
    ok = and ok, ok_m1_flag
    ok = and ok, ok_m1
    ok = and ok, ok_m2_flag

    EXPAND VEC_DEQUE_FREE deque
    EXPAND VEC_DEQUE_FREE empty
    EXPAND VEC_DEQUE_FREE mut_deque
    !remain_len
    !v0_ok
    !v0
    !v1_ok
    !v1
    !v2_ok
    !v2
    !len_after_retain
    !empty_remain_len
    !empty_still_empty
    !mut_remain_len
    !m0_ok
    !m0
    !m1_ok
    !m1
    !m2_ok
    !m2
    !mut_len
    !ok_remain
    !ok_len
    !ok_v0_flag
    !ok_v0
    !ok_v1_flag
    !ok_v1
    !ok_v2_flag
    !ok_v2
    !ok_empty_remain
    !ok_empty
    !ok_mut_remain
    !ok_mut_len
    !ok_m0_flag
    !ok_m0
    !ok_m1_flag
    !ok_m1
    !ok_m2_flag
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10825)

L_OK:
    !ok
    return
