@import "sa_std/array.sars"

@test "sa_std array ref and borrow macro surface"():
L_ENTRY:
    arr = stack_alloc 24
    store arr+0, 10 as u64
    store arr+8, 20 as u64
    store arr+16, 30 as u64

    as_ref = stack_alloc Slice_SIZE
    EXPAND ARRAY_AS_REF_SLICE_U64 as_ref, arr, 3
    as_ref_ptr = load as_ref+Slice_ptr as ptr
    as_ref_len = load as_ref+Slice_len as u64
    as_ref_second = load as_ref_ptr+8 as u64

    as_mut = stack_alloc Slice_SIZE
    EXPAND ARRAY_AS_MUT_REF_SLICE_U64 as_mut, arr, 3
    as_mut_ptr = load as_mut+Slice_ptr as ptr
    as_mut_len = load as_mut+Slice_len as u64
    store as_mut_ptr+16, 33 as u64
    after_as_mut = load arr+16 as u64

    borrowed = stack_alloc Slice_SIZE
    EXPAND ARRAY_BORROW_SLICE_U64 borrowed, arr, 3
    borrowed_ptr = load borrowed+Slice_ptr as ptr
    borrowed_len = load borrowed+Slice_len as u64

    borrowed_mut = stack_alloc Slice_SIZE
    EXPAND ARRAY_BORROW_MUT_SLICE_U64 borrowed_mut, arr, 3
    borrowed_mut_ptr = load borrowed_mut+Slice_ptr as ptr
    borrowed_mut_len = load borrowed_mut+Slice_len as u64
    store borrowed_mut_ptr+0, 11 as u64
    after_borrow_mut = load arr+0 as u64

    ok_as_ref_ptr = eq as_ref_ptr, arr
    ok_as_ref_len = eq as_ref_len, 3
    ok_as_ref_second = eq as_ref_second, 20
    ok_as_mut_ptr = eq as_mut_ptr, arr
    ok_as_mut_len = eq as_mut_len, 3
    ok_after_as_mut = eq after_as_mut, 33
    ok_borrowed_ptr = eq borrowed_ptr, arr
    ok_borrowed_len = eq borrowed_len, 3
    ok_borrowed_mut_ptr = eq borrowed_mut_ptr, arr
    ok_borrowed_mut_len = eq borrowed_mut_len, 3
    ok_after_borrow_mut = eq after_borrow_mut, 11

    !borrowed_mut_ptr
    !borrowed_ptr
    !as_mut_ptr
    !as_ref_ptr

    c01 = and ok_as_ref_ptr, ok_as_ref_len
    c02 = and c01, ok_as_ref_second
    c03 = and c02, ok_as_mut_ptr
    c04 = and c03, ok_as_mut_len
    c05 = and c04, ok_after_as_mut
    c06 = and c05, ok_borrowed_ptr
    c07 = and c06, ok_borrowed_len
    c08 = and c07, ok_borrowed_mut_ptr
    c09 = and c08, ok_borrowed_mut_len
    ok = and c09, ok_after_borrow_mut

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10519)

L_PASS:
    return 0
