@import "sa_std/num.sal"

@test "sa_std IntErrorKind and ParseIntError layout constants"():
L_ENTRY:
    ok_empty = eq NUM_INT_ERROR_EMPTY, 0
    ok_invalid = eq NUM_INT_ERROR_INVALID_DIGIT, 1
    ok_pos = eq NUM_INT_ERROR_POS_OVERFLOW, 2
    ok_neg = eq NUM_INT_ERROR_NEG_OVERFLOW, 3
    ok_zero = eq NUM_INT_ERROR_ZERO, 4

    ok_size = eq ParseIntError_SIZE, 24
    ok_code = eq ParseIntError_code, +0
    ok_msg = eq ParseIntError_msg, +8

    c01 = and ok_empty, ok_invalid
    c02 = and c01, ok_pos
    c03 = and c02, ok_neg
    c04 = and c03, ok_zero
    c05 = and c04, ok_size
    c06 = and c05, ok_code
    c07 = and c06, ok_msg

    br c07 -> L_PASS, L_FAIL

L_FAIL:
    panic(10486)

L_PASS:
    return 0
