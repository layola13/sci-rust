@import "sa_std/hash.sars"

@test "sa_std hash usize macro surface"():
L_ENTRY:
    usize_hasher = stack_alloc DefaultHasher_SIZE
    u64_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW usize_hasher
    EXPAND DEFAULT_HASHER_WRITE_USIZE usize_hasher, 12345
    EXPAND DEFAULT_HASHER_FINISH usize_manual, usize_hasher

    EXPAND DEFAULT_HASHER_NEW u64_hasher
    EXPAND DEFAULT_HASHER_WRITE_U64 u64_hasher, 12345
    EXPAND DEFAULT_HASHER_FINISH u64_manual, u64_hasher

    EXPAND HASH_USIZE usize_hash, 12345
    EXPAND HASH_U64 u64_hash, 12345
    EXPAND HASH_USIZE other_hash, 12346

    usize_matches_manual = eq usize_hash, usize_manual
    usize_matches_u64 = eq usize_hash, u64_hash
    manual_matches_u64 = eq usize_manual, u64_manual
    different_values_differ = ne usize_hash, other_hash
    changed = ne usize_hash, HASHER_DEFAULT_SEED

    c01 = and usize_matches_manual, usize_matches_u64
    c02 = and c01, manual_matches_u64
    c03 = and c02, different_values_differ
    ok = and c03, changed

    !usize_manual
    !u64_manual
    !usize_hash
    !u64_hash
    !other_hash
    !usize_matches_manual
    !usize_matches_u64
    !manual_matches_u64
    !different_values_differ
    !changed
    !c01
    !c02
    !c03
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10559)

L_PASS:
    !ok
    return 0
