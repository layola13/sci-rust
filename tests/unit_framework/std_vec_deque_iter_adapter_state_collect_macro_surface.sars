@import "sa_std/vec_deque.sars"

@test "sa_std vec_deque iterator adapter state collect macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY by_ref_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK by_ref_deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK by_ref_deque, 8
    EXPAND VEC_DEQUE_PUSH_BACK by_ref_deque, 13
    EXPAND VEC_DEQUE_PUSH_BACK by_ref_deque, 21
    EXPAND VEC_DEQUE_ITER_U64 by_ref_iter, by_ref_backing, by_ref_deque
    EXPAND VEC_DEQUE_ITER_NEXT_U64 by_ref_first_has, by_ref_first, by_ref_iter
    EXPAND VEC_DEQUE_ITER_BY_REF_COLLECT_U64 by_ref_vec, by_ref_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 by_ref_empty, by_ref_iter
    EXPAND VEC_LEN by_ref_len, by_ref_vec
    EXPAND VEC_GET_U64 by_ref_0, by_ref_vec, 0
    EXPAND VEC_GET_U64 by_ref_1, by_ref_vec, 1
    EXPAND VEC_GET_U64 by_ref_2, by_ref_vec, 2

    EXPAND VEC_DEQUE_WITH_CAPACITY fuse_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK fuse_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK fuse_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK fuse_deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK fuse_deque, 8
    EXPAND VEC_DEQUE_ITER_U64 fuse_iter, fuse_backing, fuse_deque
    EXPAND VEC_DEQUE_ITER_NEXT_U64 fuse_first_has, fuse_first, fuse_iter
    EXPAND VEC_DEQUE_ITER_FUSE_COLLECT_U64 fuse_vec, fuse_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 fuse_after_has, fuse_after, fuse_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 fuse_after_again_has, fuse_after_again, fuse_iter
    EXPAND VEC_LEN fuse_len, fuse_vec
    EXPAND VEC_GET_U64 fuse_0, fuse_vec, 0
    EXPAND VEC_GET_U64 fuse_1, fuse_vec, 1
    EXPAND VEC_GET_U64 fuse_2, fuse_vec, 2

    EXPAND VEC_DEQUE_WITH_CAPACITY empty_fuse_deque, 0
    EXPAND VEC_DEQUE_ITER_U64 empty_fuse_iter, empty_fuse_backing, empty_fuse_deque
    EXPAND VEC_DEQUE_ITER_NEXT_U64 empty_fuse_before_has, empty_fuse_before, empty_fuse_iter
    EXPAND VEC_DEQUE_ITER_FUSE_COLLECT_U64 empty_fuse_vec, empty_fuse_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 empty_fuse_after_has, empty_fuse_after, empty_fuse_iter
    EXPAND VEC_LEN empty_fuse_len, empty_fuse_vec

    EXPAND VEC_DEQUE_WITH_CAPACITY peek_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK peek_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK peek_deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK peek_deque, 8
    EXPAND VEC_DEQUE_ITER_U64 peek_iter, peek_backing, peek_deque
    EXPAND ITER_TRY_PEEK_U64 peek1_has, peek1_value, peek_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 peek_len_after_peek1, peek_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 peek_next1_has, peek_next1, peek_iter
    EXPAND ITER_TRY_PEEK_U64 peek2_has, peek2_value, peek_iter
    EXPAND VEC_DEQUE_ITER_PEEKABLE_COLLECT_U64 peek_vec, peek_iter
    EXPAND ITER_TRY_PEEK_U64 peek_after_has, peek_after_value, peek_iter
    EXPAND VEC_LEN peek_len, peek_vec
    EXPAND VEC_GET_U64 peek_0, peek_vec, 0
    EXPAND VEC_GET_U64 peek_1, peek_vec, 1

    EXPAND VEC_DEQUE_WITH_CAPACITY empty_peek_deque, 0
    EXPAND VEC_DEQUE_ITER_U64 empty_peek_iter, empty_peek_backing, empty_peek_deque
    EXPAND ITER_TRY_PEEK_U64 empty_peek_before_has, empty_peek_before, empty_peek_iter
    EXPAND VEC_DEQUE_ITER_PEEKABLE_COLLECT_U64 empty_peek_vec, empty_peek_iter
    EXPAND ITER_TRY_PEEK_U64 empty_peek_after_has, empty_peek_after, empty_peek_iter
    EXPAND VEC_LEN empty_peek_len, empty_peek_vec

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 11
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 12
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 13
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_first_has, into_first, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_BY_REF_COLLECT_U64 into_vec, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque
    EXPAND VEC_LEN into_len, into_vec
    EXPAND VEC_GET_U64 into_0, into_vec, 0
    EXPAND VEC_GET_U64 into_1, into_vec, 1

    EXPAND VEC_FREE by_ref_backing
    EXPAND VEC_FREE by_ref_vec
    EXPAND VEC_FREE fuse_backing
    EXPAND VEC_FREE fuse_vec
    EXPAND VEC_FREE empty_fuse_backing
    EXPAND VEC_FREE empty_fuse_vec
    EXPAND VEC_FREE peek_backing
    EXPAND VEC_FREE peek_vec
    EXPAND VEC_FREE empty_peek_backing
    EXPAND VEC_FREE empty_peek_vec
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_vec
    EXPAND VEC_DEQUE_FREE by_ref_deque
    EXPAND VEC_DEQUE_FREE fuse_deque
    EXPAND VEC_DEQUE_FREE empty_fuse_deque
    EXPAND VEC_DEQUE_FREE peek_deque
    EXPAND VEC_DEQUE_FREE empty_peek_deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq by_ref_first_has, 1
    check = eq by_ref_first, 5
    ok = and ok, check
    check = eq by_ref_empty, 1
    ok = and ok, check
    check = eq by_ref_len, 3
    ok = and ok, check
    check = eq by_ref_0, 8
    ok = and ok, check
    check = eq by_ref_1, 13
    ok = and ok, check
    check = eq by_ref_2, 21
    ok = and ok, check
    check = eq fuse_first_has, 1
    ok = and ok, check
    check = eq fuse_first, 2
    ok = and ok, check
    check = eq fuse_after_has, 0
    ok = and ok, check
    check = eq fuse_after, 0
    ok = and ok, check
    check = eq fuse_after_again_has, 0
    ok = and ok, check
    check = eq fuse_after_again, 0
    ok = and ok, check
    check = eq fuse_len, 3
    ok = and ok, check
    check = eq fuse_0, 4
    ok = and ok, check
    check = eq fuse_1, 6
    ok = and ok, check
    check = eq fuse_2, 8
    ok = and ok, check
    check = eq empty_fuse_before_has, 0
    ok = and ok, check
    check = eq empty_fuse_before, 0
    ok = and ok, check
    check = eq empty_fuse_after_has, 0
    ok = and ok, check
    check = eq empty_fuse_after, 0
    ok = and ok, check
    check = eq empty_fuse_len, 0
    ok = and ok, check
    check = eq peek1_has, 1
    ok = and ok, check
    check = eq peek1_value, 3
    ok = and ok, check
    check = eq peek_len_after_peek1, 3
    ok = and ok, check
    check = eq peek_next1_has, 1
    ok = and ok, check
    check = eq peek_next1, 3
    ok = and ok, check
    check = eq peek2_has, 1
    ok = and ok, check
    check = eq peek2_value, 5
    ok = and ok, check
    check = eq peek_after_has, 0
    ok = and ok, check
    check = eq peek_after_value, 0
    ok = and ok, check
    check = eq peek_len, 2
    ok = and ok, check
    check = eq peek_0, 5
    ok = and ok, check
    check = eq peek_1, 8
    ok = and ok, check
    check = eq empty_peek_before_has, 0
    ok = and ok, check
    check = eq empty_peek_before, 0
    ok = and ok, check
    check = eq empty_peek_after_has, 0
    ok = and ok, check
    check = eq empty_peek_after, 0
    ok = and ok, check
    check = eq empty_peek_len, 0
    ok = and ok, check
    check = eq into_first_has, 1
    ok = and ok, check
    check = eq into_first, 11
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check
    check = eq into_len, 2
    ok = and ok, check
    check = eq into_0, 12
    ok = and ok, check
    check = eq into_1, 13
    ok = and ok, check

    !by_ref_first_has
    !by_ref_first
    !by_ref_empty
    !by_ref_len
    !by_ref_0
    !by_ref_1
    !by_ref_2
    !fuse_first_has
    !fuse_first
    !fuse_after_has
    !fuse_after
    !fuse_after_again_has
    !fuse_after_again
    !fuse_len
    !fuse_0
    !fuse_1
    !fuse_2
    !empty_fuse_before_has
    !empty_fuse_before
    !empty_fuse_after_has
    !empty_fuse_after
    !empty_fuse_len
    !peek1_has
    !peek1_value
    !peek_len_after_peek1
    !peek_next1_has
    !peek_next1
    !peek2_has
    !peek2_value
    !peek_after_has
    !peek_after_value
    !peek_len
    !peek_0
    !peek_1
    !empty_peek_before_has
    !empty_peek_before
    !empty_peek_after_has
    !empty_peek_after
    !empty_peek_len
    !into_first_has
    !into_first
    !into_empty
    !into_deque_empty
    !into_len
    !into_0
    !into_1
    !check
    !by_ref_iter
    !fuse_iter
    !empty_fuse_iter
    !peek_iter
    !empty_peek_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_ADAPTER_STATE_COLLECT_OK, L_VEC_DEQUE_ITER_ADAPTER_STATE_COLLECT_FAIL

L_VEC_DEQUE_ITER_ADAPTER_STATE_COLLECT_FAIL:
    !ok
    panic(10797)

L_VEC_DEQUE_ITER_ADAPTER_STATE_COLLECT_OK:
    !ok
    return
