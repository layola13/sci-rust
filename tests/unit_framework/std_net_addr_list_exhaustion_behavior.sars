@import "sa_std/net.sars"

@const NET_EXHAUST_HOST = utf8:"127.0.0.1"

@test "sa_std address list exhaustion returns empty next"():
L_ENTRY:
    EXPAND NET_TO_SOCKET_ADDR_LIST open_status, list, NET_EXHAUST_HOST, 9, 0
    EXPAND NET_ADDR_LIST_NEXT first_status, first_ok, first_addr, list
    EXPAND NET_ADDR_FREE first_free_status, first_addr
    EXPAND NET_ADDR_LIST_REMAINING remaining_status, remaining, list
    EXPAND NET_ADDR_LIST_NEXT exhausted_status, exhausted_ok, exhausted_addr, list
    EXPAND NET_ADDR_LIST_FREE list_free_status, list

    ok_open = eq open_status, SA_NET_OK
    ok_list = ne list, 0
    ok_first_status = eq first_status, SA_NET_OK
    ok_first = eq first_ok, 1
    ok_first_addr = ne first_addr, 0
    ok_first_free = eq first_free_status, SA_NET_OK
    ok_remaining_status = eq remaining_status, SA_NET_OK
    ok_remaining = eq remaining, 0
    ok_exhausted_status = eq exhausted_status, SA_NET_OK
    ok_exhausted = eq exhausted_ok, 0
    ok_exhausted_addr = eq exhausted_addr, 0
    ok_list_free = eq list_free_status, SA_NET_OK

    ok1 = and ok_open, ok_list
    ok2 = and ok1, ok_first_status
    ok3 = and ok2, ok_first
    ok4 = and ok3, ok_first_addr
    ok5 = and ok4, ok_first_free
    ok6 = and ok5, ok_remaining_status
    ok7 = and ok6, ok_remaining
    ok8 = and ok7, ok_exhausted_status
    ok9 = and ok8, ok_exhausted
    ok10 = and ok9, ok_exhausted_addr
    ok = and ok10, ok_list_free
    br ok -> L_PASS, L_FAIL
L_FAIL:
    !ok
    !ok10
    !ok9
    !ok8
    !ok7
    !ok6
    !ok5
    !ok4
    !ok3
    !ok2
    !ok1
    !ok_list_free
    !ok_exhausted_addr
    !ok_exhausted
    !ok_exhausted_status
    !ok_remaining
    !ok_remaining_status
    !ok_first_free
    !ok_first_addr
    !ok_first
    !ok_first_status
    !ok_list
    !ok_open
    !list_free_status
    !exhausted_addr
    !exhausted_ok
    !exhausted_status
    !remaining
    !remaining_status
    !first_free_status
    !first_addr
    !first_ok
    !first_status
    !list
    !open_status
    panic(10110)
L_PASS:
    !ok
    !ok10
    !ok9
    !ok8
    !ok7
    !ok6
    !ok5
    !ok4
    !ok3
    !ok2
    !ok1
    !ok_list_free
    !ok_exhausted_addr
    !ok_exhausted
    !ok_exhausted_status
    !ok_remaining
    !ok_remaining_status
    !ok_first_free
    !ok_first_addr
    !ok_first
    !ok_first_status
    !ok_list
    !ok_open
    !list_free_status
    !exhausted_addr
    !exhausted_ok
    !exhausted_status
    !remaining
    !remaining_status
    !first_free_status
    !first_addr
    !first_ok
    !first_status
    !list
    !open_status
    return 0