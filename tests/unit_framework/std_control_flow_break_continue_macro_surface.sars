@import "sa_std/ops.sars"
@import "sa_std/ops.sal"

@test "sa_std control_flow break continue"():
L_ENTRY:
    cf = stack_alloc ControlFlowU64_SIZE
    EXPAND CONTROL_FLOW_CONTINUE cf, 11
    EXPAND CONTROL_FLOW_TAG t1, cf
    EXPAND CONTROL_FLOW_VALUE v1, cf
    EXPAND CONTROL_FLOW_BREAK cf, 22
    EXPAND CONTROL_FLOW_TAG t2, cf
    EXPAND CONTROL_FLOW_VALUE v2, cf
    a = eq t1, CONTROL_FLOW_CONTINUE
    b = eq v1, 11
    c = eq t2, CONTROL_FLOW_BREAK
    d = eq v2, 22
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !t1
    !v1
    !t2
    !v2
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10942)
