@import "sa_std/net.sars"

@const NET_TEST_LOOPBACK = utf8:"127.0.0.1"
@const NET_TEST_ANY_V4 = utf8:"0.0.0.0"
@const NET_TEST_MULTICAST_V4 = utf8:"224.0.0.251"
@const NET_TEST_LOOPBACK_V6 = utf8:"::1"
@const NET_TEST_MULTICAST_V6 = utf8:"ff01::114"

#def NET_TEST_LOOPBACK_LEN = 9
#def NET_TEST_ANY_V4_LEN = 7
#def NET_TEST_MULTICAST_V4_LEN = 11
#def NET_TEST_LOOPBACK_V6_LEN = 3
#def NET_TEST_MULTICAST_V6_LEN = 9

@test "sa_std net udp multicast v6 macro surface"():
L_V6_ENTRY:
    EXPAND NET_UDP_BIND bind_status, socket, NET_TEST_LOOPBACK_V6, NET_TEST_LOOPBACK_V6_LEN, 0
    bind_status_ok = eq bind_status, 0
    socket_ok = ne socket, 0
    bind_ok = and bind_status_ok, socket_ok
    br bind_ok -> L_V6_LOCAL_ADDR, L_V6_FAIL_BIND

L_V6_FAIL_BIND:
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10116)

L_V6_LOCAL_ADDR:
    EXPAND NET_UDP_LOCAL_ADDR addr_status, addr, socket
    addr_status_ok = eq addr_status, 0
    addr_ok = ne addr, 0
    addr_fetch_ok = and addr_status_ok, addr_ok
    br addr_fetch_ok -> L_V6_ADDR_FIELDS, L_V6_FAIL_LOCAL_ADDR

L_V6_FAIL_LOCAL_ADDR:
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !addr
    !addr_status
    EXPAND NET_UDP_CLOSE close_socket_status_a, socket
    !close_socket_status_a
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10117)

L_V6_ADDR_FIELDS:
    EXPAND NET_ADDR_IS_IPV6 addr_is_ipv6, addr
    EXPAND NET_ADDR_SCOPE_ID addr_scope_id, addr
    addr_ipv6_ok = eq addr_is_ipv6, 1
    addr_scope_ok = eq addr_scope_id, 0
    addr_fields_ok = and addr_ipv6_ok, addr_scope_ok
    EXPAND NET_ADDR_FREE addr_free_status, addr
    addr_free_ok = eq addr_free_status, 0
    addr_all_ok = and addr_fields_ok, addr_free_ok
    !addr_is_ipv6
    !addr_scope_id
    !addr_ipv6_ok
    !addr_scope_ok
    !addr_fields_ok
    !addr_free_status
    br addr_all_ok -> L_V6_JOIN, L_V6_FAIL_ADDR_FIELDS

L_V6_FAIL_ADDR_FIELDS:
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    EXPAND NET_UDP_CLOSE close_socket_status_b, socket
    !close_socket_status_b
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10118)

L_V6_JOIN:
    EXPAND NET_UDP_JOIN_MULTICAST_V6 join_status, socket, NET_TEST_MULTICAST_V6, NET_TEST_MULTICAST_V6_LEN, 0
    join_ok = eq join_status, 0
    br join_ok -> L_V6_LEAVE, L_V6_FAIL_JOIN

L_V6_FAIL_JOIN:
    !join_ok
    !join_status
    EXPAND NET_UDP_CLOSE close_socket_status_c, socket
    !close_socket_status_c
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10119)

L_V6_LEAVE:
    EXPAND NET_UDP_LEAVE_MULTICAST_V6 leave_status, socket, NET_TEST_MULTICAST_V6, NET_TEST_MULTICAST_V6_LEN, 0
    leave_ok = eq leave_status, 0
    EXPAND NET_UDP_CLOSE close_socket_status, socket
    close_socket_ok = eq close_socket_status, 0
    ok0 = and bind_ok, addr_all_ok
    ok1 = and ok0, join_ok
    ok2 = and ok1, leave_ok
    ok = and ok2, close_socket_ok
    !leave_status
    !leave_ok
    !close_socket_status
    !close_socket_ok
    !ok0
    !ok1
    !ok2
    !join_ok
    !join_status
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    br ok -> L_V6_OK, L_V6_FAIL_DONE

L_V6_FAIL_DONE:
    !ok
    panic(10120)

L_V6_OK:
    !ok
    return
