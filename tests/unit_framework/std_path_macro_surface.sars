    EXPAND STR_EQ b64_eq, b64_view, b64_expected
    EXPAND FS_READ_BUFFER_FREE b64_free, b64_buffer

    EXPAND PATH_BUF_WRITE_FILE_BASE64 write_b64, open_buf, &PATH_BUF_B64_EXPECTED, 4
    EXPAND PATH_BUF_OPEN_FLAGS open_status, open_file, open_buf, SA_FS_OPEN_READ
    EXPAND FS_CLOSE close_status, open_file
    EXPAND PATH_BUF_OPEN_WITH_OPTIONS open2_status, open2_file, open_buf, SA_FS_OPEN_READ, SA_FS_OPEN_MODE_DEFAULT, 0
