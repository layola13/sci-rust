    !try_flag
    !exists_flag
    !is_file_flag
    !is_dir_flag
    !is_symlink_flag
    !meta_status
    !meta_is_file
    !meta_free_status
    !canon_status
    !canon_free_status
    !cleanup1
    !view0_len
    !view0_ptr
    !view0
    EXPAND PATH_BUF_FREE path_buf
    !path_slice
    !ok_write
    !ok_try_status
    !ok_try_flag
    !ok_exists
    !ok_file
    !ok_dir
    !ok_symlink
    !ok_meta_status
    !ok_meta_is_file
    !ok_meta_free
    !ok_canon
    !ok_canon_free
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10412)
L_OK:
    !ok
    return

