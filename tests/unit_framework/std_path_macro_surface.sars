    ok02 = and ok01, ok_open
    ok03 = and ok02, ok_write
    ok04 = and ok03, ok_close
    ok05 = and ok04, ok_exists
    ok06 = and ok05, ok_rm_file
    ok = and ok06, ok_rm_dir

    !cleanup_dir0
    !cleanup_file0
    !rec0
    !mode0
    !rec1
    !mode1
    !mkdir_status
    !dir_flag
    !flags0
    !omode0
    !custom0
    !flags1
    !omode1
    !custom1
    !flags2
    !omode2
    !custom2
    !flags3
    !omode3
    !custom3
    !open_status
    !write_status
    !close_status
    !file_exists
    !rm_file
    !rm_dir
    EXPAND PATH_BUF_FREE dir_buf
    EXPAND PATH_BUF_FREE file_buf
    !dir_slice
    !file_slice
