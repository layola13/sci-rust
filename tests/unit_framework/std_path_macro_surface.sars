    ok_len_status = eq len_status, SA_FS_OK
    ok_len = eq file_len, 4
    ok_remove = eq remove_status, SA_FS_OK
    ok_gone = eq exists_after_remove, 0
    ok_mkdir = eq mkdir_status, SA_FS_OK
    ok_mkdir_all = eq mkdir_all_status, SA_FS_OK
    ok_dir = eq is_dir, 1
    ok_nest = eq is_nest, 1
    ok_rm_dir = eq cleanup_dir1, SA_FS_OK
    ok_rm_file = eq cleanup_file1, SA_FS_OK

    ok01 = and ok_write_meta, ok_meta
    ok02 = and ok01, ok_meta_len
    ok03 = and ok02, ok_meta_free
    ok04 = and ok03, ok_write_len
    ok05 = and ok04, ok_len_status
    ok06 = and ok05, ok_len
    ok07 = and ok06, ok_remove
    ok08 = and ok07, ok_gone
    ok09 = and ok08, ok_mkdir
    ok10 = and ok09, ok_mkdir_all
    ok11 = and ok10, ok_dir
    ok12 = and ok11, ok_nest
    ok13 = and ok12, ok_rm_dir
    ok = and ok13, ok_rm_file

