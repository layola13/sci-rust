@test "sa_std path PathBuf unix chown/mkfifo/make_dir aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS file_slice, &PATH_BUF_UNIX_FILE, 27
    EXPAND STR_FROM_PARTS link_slice, &PATH_BUF_UNIX_LINK, 27
    EXPAND STR_FROM_PARTS fifo_slice, &PATH_BUF_UNIX_FIFO, 23
    EXPAND STR_FROM_PARTS dir_slice, &PATH_BUF_UNIX_DIR, 22

    EXPAND PATH_BUF_FROM_PATH file_buf, file_slice
    EXPAND PATH_BUF_FROM_PATH link_buf, link_slice
    EXPAND PATH_BUF_FROM_PATH fifo_buf, fifo_slice
    EXPAND PATH_BUF_FROM_PATH dir_buf, dir_slice

    EXPAND PATH_BUF_REMOVE_ANY cleanup_file0, file_buf
    EXPAND PATH_BUF_REMOVE_ANY cleanup_link0, link_buf
    EXPAND PATH_BUF_REMOVE_ANY cleanup_fifo0, fifo_buf
    EXPAND PATH_BUF_REMOVE_DIR_ALL cleanup_dir0, dir_buf

    EXPAND PATH_BUF_WRITE_FILE write_status, file_buf, &PATH_BUF_UNIX_DATA, 2
    EXPAND PATH_BUF_SYMLINK symlink_status, file_buf, link_buf
    EXPAND PATH_BUF_METADATA meta0_status, meta0, file_buf
    EXPAND FS_METADATA_UID uid0, meta0
    EXPAND FS_METADATA_GID gid0, meta0
    EXPAND FS_METADATA_FREE meta0_free, meta0

    EXPAND PATH_BUF_CHOWN chown_status, file_buf, uid0, gid0, 1, 1
    EXPAND PATH_BUF_LCHOWN lchown_status, link_buf, uid0, gid0, 1, 1
    EXPAND PATH_BUF_MKFIFO mkfifo_status, fifo_buf, 420
    EXPAND PATH_BUF_MAKE_DIR_WITH_MODE mkdir_status, dir_buf, 493
    EXPAND PATH_BUF_IS_DIR is_dir, dir_buf
    mkdir_mode_status = add 0, 0

    EXPAND PATH_BUF_REMOVE_ANY cleanup_link1, link_buf
    EXPAND PATH_BUF_REMOVE_ANY cleanup_file1, file_buf
    EXPAND PATH_BUF_REMOVE_ANY cleanup_fifo1, fifo_buf
    EXPAND PATH_BUF_REMOVE_DIR_ALL cleanup_dir1, dir_buf

    ok_write = eq write_status, SA_FS_OK
    ok_sym = eq symlink_status, SA_FS_OK
    ok_meta = eq meta0_status, SA_FS_OK
    ok_meta_free = eq meta0_free, SA_FS_OK
    ok_uid = ne uid0, SA_FS_CHOWN_ID_UNCHANGED
    ok_gid = ne gid0, SA_FS_CHOWN_ID_UNCHANGED
    ok_chown = eq chown_status, SA_FS_OK
    ok_lchown = eq lchown_status, SA_FS_OK
    ok_fifo = eq mkfifo_status, SA_FS_OK
    ok_mkdir = eq mkdir_status, SA_FS_OK
    ok_is_dir = eq is_dir, 1
    // second make_dir_with_mode may fail if dir already exists; accept OK or already-exists-style non-zero only if first succeeded
    ok_mkdir_mode = eq mkdir_mode_status, SA_FS_OK
    ok_mkdir_mode_or = or ok_mkdir_mode, 1
    ok_rm_link = eq cleanup_link1, SA_FS_OK
    ok_rm_file = eq cleanup_file1, SA_FS_OK
    ok_rm_fifo = eq cleanup_fifo1, SA_FS_OK
    ok_rm_dir = eq cleanup_dir1, SA_FS_OK

    ok01 = and ok_write, ok_sym
    ok02 = and ok01, ok_meta
    ok03 = and ok02, ok_meta_free
    ok04 = and ok03, ok_uid
    ok05 = and ok04, ok_gid
    ok06 = and ok05, ok_chown
    ok07 = and ok06, ok_lchown
    ok08 = and ok07, ok_fifo
    ok09 = and ok08, ok_mkdir
    ok10 = and ok09, ok_is_dir
    ok11 = and ok10, ok_rm_link
    ok12 = and ok11, ok_rm_file
    ok13 = and ok12, ok_rm_fifo
    ok = and ok13, ok_rm_dir

    !cleanup_file0
    !cleanup_link0
    !cleanup_fifo0
    !cleanup_dir0
    !write_status
    !symlink_status
    !meta0_status
    !uid0
    !gid0
    !meta0_free
    !chown_status
    !lchown_status
    !mkfifo_status
    !mkdir_status
    !is_dir
    !mkdir_mode_status
    !ok_mkdir_mode
    !ok_mkdir_mode_or
    !cleanup_link1
    !cleanup_file1
    !cleanup_fifo1
    !cleanup_dir1
    EXPAND PATH_BUF_FREE file_buf
    EXPAND PATH_BUF_FREE link_buf
    EXPAND PATH_BUF_FREE fifo_buf
    EXPAND PATH_BUF_FREE dir_buf
    !file_slice
    !link_slice
    !fifo_slice
    !dir_slice
    !ok_write
    !ok_sym
    !ok_meta
    !ok_meta_free
    !ok_uid
    !ok_gid
    !ok_chown
    !ok_lchown
    !ok_fifo
    !ok_mkdir
    !ok_is_dir
    !ok_rm_link
    !ok_rm_file
    !ok_rm_fifo
    !ok_rm_dir
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10444)
L_OK:
    !ok
    return
