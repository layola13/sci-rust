    EXPAND PATH_BUF_FROM_PATH file_buf, file_slice

    EXPAND PATH_BUF_REMOVE_DIR_ALL cleanup_dir0, dir_buf
    EXPAND PATH_BUF_REMOVE_FILE cleanup_file0, file_buf

    EXPAND FS_DIR_BUILDER_NEW rec0, mode0
    EXPAND FS_DIR_BUILDER_WITH_RECURSIVE rec1, mode1, rec0, mode0, 1
    EXPAND PATH_BUF_DIR_BUILDER_CREATE mkdir_status, rec1, mode1, dir_buf
    EXPAND PATH_BUF_IS_DIR dir_flag, dir_buf

    EXPAND FS_OPEN_OPTIONS_BUILDER_NEW flags0, omode0, custom0
    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_WRITE flags1, omode1, custom1, flags0, omode0, custom0, 1
    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_CREATE flags2, omode2, custom2, flags1, omode1, custom1, 1
    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_TRUNCATE flags3, omode3, custom3, flags2, omode2, custom2, 1
    EXPAND PATH_BUF_OPEN_OPTIONS_BUILDER_OPEN open_status, file, flags3, omode3, custom3, file_buf
    EXPAND FS_WRITE_ALL write_status, file, &PATH_BUF_BUILDER_DATA, 2
    EXPAND FS_CLOSE close_status, file
    EXPAND PATH_BUF_EXISTS file_exists, file_buf
    EXPAND PATH_BUF_REMOVE_FILE rm_file, file_buf
    EXPAND PATH_BUF_REMOVE_DIR_ALL rm_dir, dir_buf

    ok_mkdir = eq mkdir_status, SA_FS_OK
    ok_dir = eq dir_flag, 1
    ok_open = eq open_status, SA_FS_OK
    ok_write = eq write_status, SA_FS_OK
    ok_close = eq close_status, SA_FS_OK
    ok_exists = eq file_exists, 1
    ok_rm_file = eq rm_file, SA_FS_OK
    ok_rm_dir = eq rm_dir, SA_FS_OK

