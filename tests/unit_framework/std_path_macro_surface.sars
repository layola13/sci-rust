    !full_a1_ok
    !full_a2_ok
    !full_a3_ok
    !full_a4_ok
    !rel_a1_ok
    !rel_a2_ok
    !full_prefix_eq
    !hidden_prefix_eq
    !full_a0_eq
    !full_a1_eq
    !full_a2_eq
    !full_a3_eq
    !full_a4_empty
    !rel_a1_eq
    !rel_a2_empty
    !ok_full_rel
    !ok_rel_rel
    !ok_full_empty
    !ok_empty_empty
    !ok_ends_resolv
    !ok_ends_etc_resolv
    !ok_ends_abs_self
