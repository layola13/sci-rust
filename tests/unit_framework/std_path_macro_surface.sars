    EXPAND FS_METADATA_FREE meta_free_status, meta
    EXPAND PATH_BUF_CANONICALIZE canon_status, canon_buf, path_buf
    EXPAND FS_READ_BUFFER_FREE canon_free_status, canon_buf
    EXPAND FS_REMOVE_PATH cleanup1, view0_ptr, view0_len

    ok_write = eq write_status, SA_FS_OK
    ok_try_status = eq try_status, SA_FS_OK
    ok_try_flag = eq try_flag, 1
    ok_exists = eq exists_flag, 1
    ok_file = eq is_file_flag, 1
    ok_dir = eq is_dir_flag, 0
    ok_symlink = eq is_symlink_flag, 0
    ok_meta_status = eq meta_status, SA_FS_OK
    ok_meta_is_file = eq meta_is_file, 1
    ok_meta_free = eq meta_free_status, SA_FS_OK
    ok_canon = eq canon_status, SA_FS_OK
    ok_canon_free = eq canon_free_status, SA_FS_OK

    ok01 = and ok_write, ok_try_status
