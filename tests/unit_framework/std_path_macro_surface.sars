@const PATH_BUF_META_JSON_DATA = utf8:"mj"
@const PATH_BUF_LEN_REMOVE_TEST = utf8:"_tmp_path_buf_len_remove.txt"
@const PATH_BUF_LEN_REMOVE_DATA = utf8:"abcd"
@const PATH_BUF_MODE_DIR = utf8:"_tmp_path_buf_mode_dir"
@const PATH_BUF_MODE_NEST = utf8:"_tmp_path_buf_mode_dir/nested"
@const PATH_BUF_B64_TEST = utf8:"_tmp_path_buf_b64.txt"
@const PATH_BUF_B64_DATA = utf8:"hey"
@const PATH_BUF_B64_EXPECTED = utf8:"aGV5"
@const PATH_BUF_OPEN_FLAGS_TEST = utf8:"_tmp_path_buf_open_flags.txt"
@const PATH_BUF_OPEN_FLAGS_DATA = utf8:"of"
@const PATH_BUF_UNIX_FILE = utf8:"_tmp_path_buf_unix_file.txt"
@const PATH_BUF_UNIX_LINK = utf8:"_tmp_path_buf_unix_link.txt"
@const PATH_BUF_UNIX_FIFO = utf8:"_tmp_path_buf_unix_fifo"
@const PATH_BUF_UNIX_DIR = utf8:"_tmp_path_buf_unix_dir"
@const PATH_BUF_UNIX_DATA = utf8:"ux"
@const PATH_REL = utf8:"tmp/demo"
@const PATH_ROOT = utf8:"/"
@const PATH_PREFIX = utf8:"/tmp/demo"
@const PATH_PREFIX_SLASH = utf8:"/tmp/demo/"
@const PATH_PREFIX_PARENT = utf8:"/tmp"
@const PATH_PREFIX_PARTIAL = utf8:"/tmp/de"
@const PATH_PREFIX_BAD = utf8:"/var"
@const PATH_CHILD = utf8:"child"
@const PATH_ABS_CHILD = utf8:"/var/log"
@const PATH_NEW_FILE = utf8:"other.bin"
@const PATH_NEW_EXT = utf8:"md"
@const PATH_NO_EXT = utf8:"/tmp/demo/file"
@const PATH_MULTI_SEP = utf8:"//tmp//demo/"
@const EXPECT_BASE = utf8:"file.txt"
@const EXPECT_DIR = utf8:"/tmp/demo"
@const EXPECT_STEM = utf8:"file"
@const EXPECT_EXT = utf8:"txt"
@const EXPECT_JOINED = utf8:"/tmp/demo/child"
@const EXPECT_RENAMED = utf8:"/tmp/demo/other.bin"
@const EXPECT_WITH_EXT = utf8:"/tmp/demo/file.md"
@const EXPECT_ADDED_EXT = utf8:"/tmp/demo/file.txt.md"
@const EXPECT_COMPONENT_TMP = utf8:"tmp"
@const EXPECT_COMPONENT_DEMO = utf8:"demo"
@const EXPECT_COMPONENT_FILE = utf8:"file.txt"
@const EXPECT_PREFIX_TMP = utf8:"/tmp"
@const EXPECT_PREFIX_DEMO = utf8:"/tmp/demo"
@const PATH_ETC = utf8:"/etc/resolv.conf"
@const PATH_RESOLV = utf8:"resolv.conf"
