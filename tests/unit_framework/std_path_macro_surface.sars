    view0_len = load view0+Slice_len as u64
    EXPAND FS_REMOVE_PATH cleanup0, view0_ptr, view0_len
    EXPAND FS_WRITE_FILE write_status, view0_ptr, view0_len, &PATH_BUF_FS_HELLO, 7
    EXPAND PATH_BUF_TRY_EXISTS try_status, try_flag, path_buf
    EXPAND PATH_BUF_EXISTS exists_flag, path_buf
    EXPAND PATH_BUF_IS_FILE is_file_flag, path_buf
