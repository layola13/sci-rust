    EXPAND PATH_BUF_METADATA_JSON meta_status, meta_json, file_buf
    EXPAND FS_READ_BUFFER_LEN meta_len, meta_json
    EXPAND FS_READ_BUFFER_FREE meta_free, meta_json

    EXPAND PATH_BUF_WRITE_FILE write_len, len_buf, &PATH_BUF_LEN_REMOVE_DATA, 4
    EXPAND PATH_BUF_FS_SIZE len_status, file_len, len_buf
    EXPAND PATH_BUF_REMOVE_ENTRY remove_status, len_buf
    EXPAND PATH_BUF_EXISTS exists_after_remove, len_buf

    EXPAND PATH_BUF_CREATE_DIR_WITH_MODE mkdir_status, dir_buf, 493
    EXPAND PATH_BUF_CREATE_DIR_ALL_WITH_MODE mkdir_all_status, nest_buf, 493
    EXPAND PATH_BUF_IS_DIR is_dir, dir_buf
    EXPAND PATH_BUF_IS_DIR is_nest, nest_buf
