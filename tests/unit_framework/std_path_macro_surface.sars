    EXPAND PATH_BUF_REMOVE_ANY cleanup_file1, file_buf

    ok_write_meta = eq write_meta, SA_FS_OK
    ok_meta = eq meta_status, SA_FS_OK
    ok_meta_len = ne meta_len, 0
    ok_meta_free = eq meta_free, SA_FS_OK
