    EXPAND PATH_BUF_FROM_PATH root_buf, root_slice
    EXPAND PATH_BUF_FROM_PATH file_buf, file_slice

    EXPAND PATH_BUF_REMOVE_DIR_ALL cleanup0, root_buf
    EXPAND PATH_BUF_CREATE_DIR mkdir_status, root_buf
    EXPAND PATH_BUF_WRITE_FILE write_status, file_buf, &PATH_BUF_READDIR_DATA, 1
    EXPAND PATH_BUF_READ_DIR_ENTRIES entries_status, entries, root_buf, 16
    EXPAND FS_DIR_ENTRIES_LEN entry_count, entries
    EXPAND PATH_BUF_READ_DIR_JSON json_status, json_buf, root_buf, 16
    EXPAND FS_DIR_BUFFER_LEN json_len, json_buf
    EXPAND FS_DIR_BUFFER_FREE json_free, json_buf
    EXPAND FS_DIR_ENTRIES_FREE entries_free, entries
    EXPAND PATH_BUF_REMOVE_DIR_ALL cleanup1, root_buf

    ok_mkdir = eq mkdir_status, SA_FS_OK
    ok_write = eq write_status, SA_FS_OK
    ok_entries = eq entries_status, SA_FS_OK
    ok_count = ugt entry_count, 0
    ok_json = eq json_status, SA_FS_OK
    ok_json_len = ugt json_len, 0
    ok_json_free = eq json_free, SA_FS_OK
    ok_entries_free = eq entries_free, SA_FS_OK
    ok_cleanup = eq cleanup1, SA_FS_OK

    ok01 = and ok_mkdir, ok_write
    ok02 = and ok01, ok_entries
    ok03 = and ok02, ok_count
    ok04 = and ok03, ok_json
    ok05 = and ok04, ok_json_len
    ok06 = and ok05, ok_json_free
    ok07 = and ok06, ok_entries_free
    ok = and ok07, ok_cleanup

    !cleanup0
    !mkdir_status
    !write_status
    !entries_status
    !entry_count
    !json_status
    !json_len
    !json_free
    !entries_free
    !cleanup1
    EXPAND PATH_BUF_FREE root_buf
    EXPAND PATH_BUF_FREE file_buf
    !root_slice
    !file_slice
    !ok_mkdir
    !ok_write
    !ok_entries
    !ok_count
    !ok_json
    !ok_json_len
    !ok_json_free
    !ok_entries_free
    !ok_cleanup
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10425)
L_OK:
    !ok
    return


