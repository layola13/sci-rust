    return


@test "sa_std path PathBuf permissions/file_times object aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS path_slice, &PATH_BUF_PERM_TEST, 26
    EXPAND PATH_BUF_FROM_PATH path_buf, path_slice
    EXPAND PATH_BUF_REMOVE_FILE cleanup0, path_buf
    EXPAND PATH_BUF_WRITE_FILE write_status, path_buf, &PATH_BUF_PERM_DATA, 1

    perm_slot = stack_alloc SaFsPermissions_SIZE
    EXPAND FS_PERMISSIONS_FROM_MODE perm_slot, 420
    EXPAND PATH_BUF_SET_PERMISSIONS_OBJ perm_status, path_buf, perm_slot

    EXPAND FS_FILE_TIMES_NEW t0_acc, t0_mod
    EXPAND FS_FILE_TIMES_WITH_ACCESSED t1_acc, t1_mod, t0_acc, t0_mod, 1700000001000
    EXPAND FS_FILE_TIMES_WITH_MODIFIED t2_acc, t2_mod, t1_acc, t1_mod, 1700000002000
    EXPAND PATH_BUF_FILE_TIMES_SET times_status, path_buf, t2_acc, t2_mod

    EXPAND PATH_BUF_METADATA meta_status, meta, path_buf
    EXPAND FS_METADATA_FILE_TIMES got_acc, got_mod, meta
    EXPAND FS_METADATA_FREE meta_free, meta
    EXPAND PATH_BUF_REMOVE_FILE cleanup1, path_buf

    ok_write = eq write_status, SA_FS_OK
    ok_perm = eq perm_status, SA_FS_OK
    ok_times = eq times_status, SA_FS_OK
    ok_meta = eq meta_status, SA_FS_OK
    ok_acc = eq got_acc, 1700000001000
    ok_mod = eq got_mod, 1700000002000
    ok_free = eq meta_free, SA_FS_OK
    ok_rm = eq cleanup1, SA_FS_OK

    ok01 = and ok_write, ok_perm
    ok02 = and ok01, ok_times
    ok03 = and ok02, ok_meta
    ok04 = and ok03, ok_acc
    ok05 = and ok04, ok_mod
    ok06 = and ok05, ok_free
    ok = and ok06, ok_rm

    !cleanup0
    !write_status
    !perm_status
    !t0_acc
    !t0_mod
    !t1_acc
    !t1_mod
    !t2_acc
    !t2_mod
    !times_status
    !meta_status
    !got_acc
    !got_mod
    !meta_free
    !cleanup1
    EXPAND PATH_BUF_FREE path_buf
    !path_slice
    !ok_write
    !ok_perm
    !ok_times
    !ok_meta
    !ok_acc
    !ok_mod
    !ok_free
    !ok_rm
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10437)
L_OK:
    !ok
    return


