    EXPAND STR_FROM_PARTS dir_slice, &PATH_BUF_MODE_DIR, 22
    EXPAND STR_FROM_PARTS nest_slice, &PATH_BUF_MODE_NEST, 29

    EXPAND PATH_BUF_FROM_PATH file_buf, file_slice
    EXPAND PATH_BUF_FROM_PATH len_buf, len_slice
    EXPAND PATH_BUF_FROM_PATH dir_buf, dir_slice
    EXPAND PATH_BUF_FROM_PATH nest_buf, nest_slice

    EXPAND PATH_BUF_REMOVE_ANY cleanup_file0, file_buf
    EXPAND PATH_BUF_REMOVE_ANY cleanup_len0, len_buf
    EXPAND PATH_BUF_REMOVE_DIR_ALL cleanup_dir0, dir_buf

