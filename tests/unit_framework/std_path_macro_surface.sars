    br ok -> L_PATH_TRY_OK, L_PATH_TRY_FAIL

L_PATH_TRY_FAIL:
    !ok
    panic(10186)

L_PATH_TRY_OK:
    !ok
    return

@test "sa_std path filesystem query macros"():
L_PATH_FS_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_file_status, PATH_TEST_FILE, PATH_TEST_FILE_LEN
    EXPAND FS_REMOVE_PATH cleanup_dir_status, PATH_TEST_DIR, PATH_TEST_DIR_LEN
    EXPAND FS_REMOVE_PATH cleanup_link_status, PATH_TEST_MISSING, PATH_TEST_MISSING_LEN
    EXPAND FS_REMOVE_PATH cleanup_absent_status, PATH_TEST_ABSENT, PATH_TEST_ABSENT_LEN

    EXPAND FS_WRITE_FILE write_status, PATH_TEST_FILE, PATH_TEST_FILE_LEN, PATH_TEST_DATA, PATH_TEST_DATA_LEN
    EXPAND FS_MAKE_DIR mkdir_status, PATH_TEST_DIR, PATH_TEST_DIR_LEN
    EXPAND FS_SYMLINK symlink_status, PATH_TEST_FILE, PATH_TEST_FILE_LEN, PATH_TEST_MISSING, PATH_TEST_MISSING_LEN

    EXPAND STR_FROM_PARTS file_path, &PATH_TEST_FILE, PATH_TEST_FILE_LEN
    EXPAND STR_FROM_PARTS dir_path, &PATH_TEST_DIR, PATH_TEST_DIR_LEN
    EXPAND STR_FROM_PARTS link_path, &PATH_TEST_MISSING, PATH_TEST_MISSING_LEN
    EXPAND STR_FROM_PARTS absent_path, &PATH_TEST_ABSENT, PATH_TEST_ABSENT_LEN

    EXPAND PATH_EXISTS file_exists, file_path
    EXPAND PATH_EXISTS dir_exists, dir_path
    EXPAND PATH_EXISTS missing_exists, absent_path
    EXPAND PATH_TRY_EXISTS file_try_status, file_try_exists, file_path
    EXPAND PATH_TRY_EXISTS missing_try_status, missing_try_exists, absent_path
    EXPAND PATH_METADATA file_metadata_status, file_metadata, file_path
    EXPAND FS_METADATA_IS_FILE file_metadata_is_file, file_metadata
    EXPAND FS_METADATA_FREE file_metadata_free_status, file_metadata
    EXPAND PATH_CANONICALIZE canonical_status, canonical_buffer, file_path
    EXPAND FS_READ_BUFFER_LEN canonical_len, canonical_buffer
    EXPAND FS_READ_BUFFER_FREE canonical_free_status, canonical_buffer
    EXPAND PATH_READ_LINK read_link_status, read_link_buffer, link_path
    EXPAND FS_READ_BUFFER_LEN read_link_len, read_link_buffer
    EXPAND FS_READ_BUFFER_FREE read_link_free_status, read_link_buffer
    EXPAND PATH_IS_FILE file_is_file, file_path
    EXPAND PATH_IS_DIR file_is_dir, file_path
    EXPAND PATH_IS_SYMLINK file_is_symlink, file_path
    EXPAND PATH_IS_FILE dir_is_file, dir_path
    EXPAND PATH_IS_DIR dir_is_dir, dir_path
    EXPAND PATH_IS_SYMLINK dir_is_symlink, dir_path
    EXPAND PATH_IS_FILE missing_is_file, absent_path
    EXPAND PATH_IS_DIR missing_is_dir, absent_path
    EXPAND PATH_IS_SYMLINK missing_is_symlink, absent_path

    ok_write_status = eq write_status, 0
    ok_mkdir_status = eq mkdir_status, 0
    ok_symlink_status = eq symlink_status, 0
    ok_file_exists = eq file_exists, 1
    ok_dir_exists = eq dir_exists, 1
    ok_missing_exists = eq missing_exists, 0
    ok_file_try_status = eq file_try_status, 0
    ok_file_try_exists = eq file_try_exists, 1
    ok_missing_try_status = eq missing_try_status, 0
    ok_missing_try_exists = eq missing_try_exists, 0
    ok_file_metadata_status = eq file_metadata_status, 0
    ok_file_metadata_is_file = eq file_metadata_is_file, 1
    ok_file_metadata_free_status = eq file_metadata_free_status, 0
    ok_canonical_status = eq canonical_status, 0
    ok_canonical_len = ne canonical_len, 0
    ok_canonical_free_status = eq canonical_free_status, 0
    ok_read_link_status = eq read_link_status, 0
    ok_read_link_len = eq read_link_len, PATH_TEST_FILE_LEN
    ok_read_link_free_status = eq read_link_free_status, 0
    ok_file_is_file = eq file_is_file, 1
    ok_file_is_dir = eq file_is_dir, 0
    ok_file_is_symlink = eq file_is_symlink, 0
    ok_dir_is_file = eq dir_is_file, 0
    ok_dir_is_dir = eq dir_is_dir, 1
    ok_dir_is_symlink = eq dir_is_symlink, 0
    ok_missing_is_file = eq missing_is_file, 0
    ok_missing_is_dir = eq missing_is_dir, 0
    ok_missing_is_symlink = eq missing_is_symlink, 0

    q01 = and ok_write_status, ok_mkdir_status
    q02 = and q01, ok_symlink_status
    q03 = and q02, ok_file_exists
    q04 = and q03, ok_dir_exists
    q05 = and q04, ok_missing_exists
    q06 = and q05, ok_file_try_status
    q07 = and q06, ok_file_try_exists
    q08 = and q07, ok_missing_try_status
    q09 = and q08, ok_missing_try_exists
    q10 = and q09, ok_file_metadata_status
    q11 = and q10, ok_file_metadata_is_file
    q12 = and q11, ok_file_metadata_free_status
    q13 = and q12, ok_canonical_status
    q14 = and q13, ok_canonical_len
    q15 = and q14, ok_canonical_free_status
    q16 = and q15, ok_read_link_status
    q17 = and q16, ok_read_link_len
    q18 = and q17, ok_read_link_free_status
    q19 = and q18, ok_file_is_file
    q20 = and q19, ok_file_is_dir
    q21 = and q20, ok_file_is_symlink
    q22 = and q21, ok_dir_is_file
    q23 = and q22, ok_dir_is_dir
    q24 = and q23, ok_dir_is_symlink
    q25 = and q24, ok_missing_is_file
    q26 = and q25, ok_missing_is_dir
    ok = and q26, ok_missing_is_symlink

    EXPAND FS_REMOVE_PATH remove_file_status, PATH_TEST_FILE, PATH_TEST_FILE_LEN
    EXPAND FS_REMOVE_PATH remove_dir_status, PATH_TEST_DIR, PATH_TEST_DIR_LEN
    EXPAND FS_REMOVE_PATH remove_link_status, PATH_TEST_MISSING, PATH_TEST_MISSING_LEN

    !cleanup_file_status
    !cleanup_dir_status
    !cleanup_link_status
    !cleanup_absent_status
    !write_status
    !mkdir_status
    !symlink_status
    !file_exists
    !dir_exists
    !missing_exists
    !file_try_status
    !file_try_exists
    !missing_try_status
    !missing_try_exists
    !file_metadata_status
    !file_metadata
    !file_metadata_is_file
    !file_metadata_free_status
    !canonical_status
    !canonical_len
    !canonical_free_status
    !read_link_status
    !read_link_len
    !read_link_free_status
    !file_is_file
    !file_is_dir
    !file_is_symlink
    !dir_is_file
    !dir_is_dir
    !dir_is_symlink
    !missing_is_file
    !missing_is_dir
    !missing_is_symlink
    !ok_write_status
    !ok_mkdir_status
    !ok_symlink_status
    !ok_file_exists
    !ok_dir_exists
    !ok_missing_exists
    !ok_file_try_status
    !ok_file_try_exists
    !ok_missing_try_status
    !ok_missing_try_exists
    !ok_file_metadata_status
    !ok_file_metadata_is_file
    !ok_file_metadata_free_status
    !ok_canonical_status
    !ok_canonical_len
    !ok_canonical_free_status
    !ok_read_link_status
    !ok_read_link_len
    !ok_read_link_free_status
    !ok_file_is_file
    !ok_file_is_dir
    !ok_file_is_symlink
    !ok_dir_is_file
    !ok_dir_is_dir
    !ok_dir_is_symlink
    !ok_missing_is_file
    !ok_missing_is_dir
    !ok_missing_is_symlink
    !q01
    !q02
    !q03
    !q04
    !q05
    !q06
    !q07
    !q08
    !q09
    !q10
    !q11
    !q12
    !q13
    !q14
    !q15
    !q16
    !q17
    !q18
    !q19
    !q20
    !q21
    !q22
    !q23
    !q24
    !q25
    !q26
    !remove_file_status
    !remove_dir_status
    !remove_link_status
    !absent_path
    !link_path
    !dir_path
    !file_path
    br ok -> L_PATH_FS_OK, L_PATH_FS_FAIL

L_PATH_FS_FAIL:
    !ok
    panic(10187)

L_PATH_FS_OK:
    !ok
    return

@test "sa_std path PathBuf owned macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS base, &PATH_PREFIX, 9
    EXPAND STR_FROM_PARTS child, &PATH_CHILD, 5
    EXPAND STR_FROM_PARTS abs_child, &PATH_ABS_CHILD, 8
    EXPAND STR_FROM_PARTS new_file, &PATH_NEW_FILE, 9
    EXPAND STR_FROM_PARTS new_ext, &PATH_NEW_EXT, 2
    EXPAND STR_FROM_PARTS expect_joined, &EXPECT_JOINED, 15
    EXPAND STR_FROM_PARTS expect_renamed, &EXPECT_RENAMED, 19
    EXPAND STR_FROM_PARTS expect_with_ext, &EXPECT_WITH_EXT, 17
    EXPAND STR_FROM_PARTS expect_dir, &EXPECT_DIR, 9
    EXPAND STR_FROM_PARTS full, &PATH_FULL, 18

    EXPAND PATH_BUF_NEW empty_buf
    EXPAND PATH_BUF_IS_EMPTY empty0, empty_buf
    empty0_ok = eq empty0, 1
    EXPAND PATH_BUF_LEN len0, empty_buf
    len0_ok = eq len0, 0

    EXPAND PATH_BUF_FROM_PATH buf, base
    EXPAND PATH_BUF_LEN len1, buf
    len1_ok = eq len1, 9
    EXPAND PATH_BUF_AS_PATH view1, buf
    EXPAND STR_EQ eq1, view1, base
    eq1_ok = eq eq1, 1
    !view1

    EXPAND PATH_BUF_PUSH buf, child
    EXPAND PATH_BUF_AS_PATH view2, buf
    EXPAND STR_EQ eq2, view2, expect_joined
    eq2_ok = eq eq2, 1
    !view2

    EXPAND PATH_BUF_POP pop_ok, buf
    pop_ok_ok = eq pop_ok, 1
    EXPAND PATH_BUF_AS_PATH view3, buf
    EXPAND STR_EQ eq3, view3, expect_dir
    eq3_ok = eq eq3, 1
    !view3

    EXPAND PATH_BUF_PUSH buf, child
    EXPAND PATH_BUF_SET_FILE_NAME buf, new_file
    EXPAND PATH_BUF_AS_PATH view4, buf
    EXPAND STR_EQ eq4, view4, expect_renamed
    eq4_ok = eq eq4, 1
    !view4

    EXPAND PATH_BUF_CLEAR buf
    EXPAND PATH_BUF_PUSH buf, full
    EXPAND PATH_BUF_SET_EXTENSION buf, new_ext
    EXPAND PATH_BUF_AS_PATH view5, buf
    EXPAND STR_EQ eq5, view5, expect_with_ext
    eq5_ok = eq eq5, 1
    !view5

    EXPAND PATH_BUF_PUSH buf, abs_child
    EXPAND PATH_BUF_AS_PATH view6, buf
    EXPAND STR_EQ eq6, view6, abs_child
    eq6_ok = eq eq6, 1
    !view6

    EXPAND PATH_BUF_CLONE clone_buf, buf
    EXPAND PATH_BUF_AS_PATH view7, clone_buf
    EXPAND STR_EQ eq7, view7, abs_child
    eq7_ok = eq eq7, 1
    !view7

    EXPAND PATH_BUF_PUSH_TRAILING_SEPARATOR clone_buf
    EXPAND PATH_BUF_AS_PATH view8, clone_buf
    EXPAND PATH_ENDS_WITH_SEPARATOR has_sep, view8
    has_sep_ok = eq has_sep, 1
    !view8

    EXPAND PATH_BUF_CAPACITY cap_buf, buf
    cap_ok = uge cap_buf, 8

    EXPAND PATH_BUF_FREE empty_buf
    EXPAND PATH_BUF_FREE buf
    EXPAND PATH_BUF_FREE clone_buf

    ok = and empty0_ok, len0_ok
    ok = and ok, len1_ok
    ok = and ok, eq1_ok
    ok = and ok, eq2_ok
    ok = and ok, pop_ok_ok
    ok = and ok, eq3_ok
    ok = and ok, eq4_ok
    ok = and ok, eq5_ok
    ok = and ok, eq6_ok
    ok = and ok, eq7_ok
    ok = and ok, has_sep_ok
    ok = and ok, cap_ok

    !base
    !child
    !abs_child
    !new_file
    !new_ext
    !expect_joined
    !expect_renamed
    !expect_with_ext
    !expect_dir
    !full
    !empty0
    !len0
    !len1
    !eq1
    !eq2
    !pop_ok
    !eq3
    !eq4
    !eq5
    !eq6
    !eq7
    !has_sep
    !cap_buf
    !empty0_ok
    !len0_ok
    !len1_ok
    !eq1_ok
    !eq2_ok
    !pop_ok_ok
    !eq3_ok
    !eq4_ok
    !eq5_ok
    !eq6_ok
    !eq7_ok
    !has_sep_ok
    !cap_ok
    br ok -> L_PATH_BUF_OK, L_PATH_BUF_FAIL

L_PATH_BUF_FAIL:
    !ok
    panic(10188)

L_PATH_BUF_OK:
    !ok
    return

@test "sa_std path PathBuf lit/capacity macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS root, &PATH_ROOT, 1
    EXPAND STR_FROM_PARTS child, &PATH_CHILD, 5
    EXPAND STR_FROM_PARTS new_file, &PATH_NEW_FILE, 9
    EXPAND PATH_BUF_LIT1 lit1, root
    EXPAND PATH_BUF_LEN lit1_len, lit1
    EXPAND PATH_BUF_LIT2 lit2, root, child
    EXPAND PATH_BUF_LEN lit2_len, lit2
    EXPAND PATH_BUF_LIT3 lit3, root, child, new_file
    EXPAND PATH_BUF_LEN lit3_len, lit3
    EXPAND PATH_BUF_WITH_CAPACITY cap_buf, 32
    EXPAND PATH_BUF_CAPACITY cap0, cap_buf
    EXPAND PATH_BUF_CAPACITY_REMAINING rem0, cap_buf
    EXPAND PATH_BUF_EXTRA_CAPACITY extra0, cap_buf
    EXPAND PATH_BUF_REMAINING_CAPACITY rem1, cap_buf

    ok_lit1_len = eq lit1_len, 1
    ok_lit2_len = ugt lit2_len, lit1_len
    ok_lit3_len = ugt lit3_len, lit2_len
    ok_cap = uge cap0, 32
    ok_rem = eq rem0, cap0
    ok_extra = eq extra0, rem0
    ok_rem1 = eq rem1, rem0

    ok = and ok_lit1_len, ok_lit2_len
    ok = and ok, ok_lit3_len
    ok = and ok, ok_cap
    ok = and ok, ok_rem
    ok = and ok, ok_extra
    ok = and ok, ok_rem1

    !ok_lit1_len
    !ok_lit2_len
    !ok_lit3_len
    !ok_cap
    !ok_rem
    !ok_extra
    !ok_rem1
    !lit1_len
    !lit2_len
    !lit3_len
    !cap0
    !rem0
    !extra0
    !rem1
    EXPAND PATH_BUF_FREE lit1
    EXPAND PATH_BUF_FREE lit2
    EXPAND PATH_BUF_FREE lit3
    EXPAND PATH_BUF_FREE cap_buf
    !root
    !child
    !new_file
    br ok -> L_PATH_BUF_LIT_OK, L_PATH_BUF_LIT_FAIL
L_PATH_BUF_LIT_FAIL:
    !ok
    panic(10189)
L_PATH_BUF_LIT_OK:
    !ok
    return

