@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/vec.sars"
@import "sa_std/collections/btree_set.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"
@const KEY_DELTA = utf8:"delta"

@test "sa_std btree_set bit-operator aliases"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    delta = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7
    EXPAND SLICE_NEW delta, &KEY_DELTA, 5

    EXPAND BTREE_SET_NEW left
    EXPAND BTREE_SET_NEW right
    EXPAND BTREE_SET_INSERT left_ins_alpha, left, alpha
    EXPAND BTREE_SET_INSERT left_ins_bravo, left, bravo
    EXPAND BTREE_SET_INSERT left_ins_charlie, left, charlie
    EXPAND BTREE_SET_INSERT right_ins_bravo, right, bravo
    EXPAND BTREE_SET_INSERT right_ins_delta, right, delta

    EXPAND BTREE_SET_BITOR bitor_set, left, right
    EXPAND BTREE_SET_BITAND bitand_set, left, right
    EXPAND BTREE_SET_SUB sub_set, left, right
    EXPAND BTREE_SET_BITXOR bitxor_set, left, right

    EXPAND BTREE_SET_LEN bitor_len, bitor_set
    EXPAND BTREE_SET_LEN bitand_len, bitand_set
    EXPAND BTREE_SET_LEN sub_len, sub_set
    EXPAND BTREE_SET_LEN bitxor_len, bitxor_set

    EXPAND BTREE_SET_CONTAINS bitor_has_alpha, bitor_set, alpha
    EXPAND BTREE_SET_CONTAINS bitor_has_bravo, bitor_set, bravo
    EXPAND BTREE_SET_CONTAINS bitor_has_charlie, bitor_set, charlie
    EXPAND BTREE_SET_CONTAINS bitor_has_delta, bitor_set, delta

    EXPAND BTREE_SET_CONTAINS bitand_has_alpha, bitand_set, alpha
    EXPAND BTREE_SET_CONTAINS bitand_has_bravo, bitand_set, bravo
    EXPAND BTREE_SET_CONTAINS bitand_has_charlie, bitand_set, charlie
    EXPAND BTREE_SET_CONTAINS bitand_has_delta, bitand_set, delta

    EXPAND BTREE_SET_CONTAINS sub_has_alpha, sub_set, alpha
    EXPAND BTREE_SET_CONTAINS sub_has_bravo, sub_set, bravo
    EXPAND BTREE_SET_CONTAINS sub_has_charlie, sub_set, charlie
    EXPAND BTREE_SET_CONTAINS sub_has_delta, sub_set, delta

    EXPAND BTREE_SET_CONTAINS bitxor_has_alpha, bitxor_set, alpha
    EXPAND BTREE_SET_CONTAINS bitxor_has_bravo, bitxor_set, bravo
    EXPAND BTREE_SET_CONTAINS bitxor_has_charlie, bitxor_set, charlie
    EXPAND BTREE_SET_CONTAINS bitxor_has_delta, bitxor_set, delta

    EXPAND BTREE_SET_LEN left_len_after, left
    EXPAND BTREE_SET_LEN right_len_after, right

    ok_left_ins_alpha = eq left_ins_alpha, 1
    ok_left_ins_bravo = eq left_ins_bravo, 1
    ok_left_ins_charlie = eq left_ins_charlie, 1
    ok_right_ins_bravo = eq right_ins_bravo, 1
    ok_right_ins_delta = eq right_ins_delta, 1
    ok_bitor_len = eq bitor_len, 4
    ok_bitand_len = eq bitand_len, 1
    ok_sub_len = eq sub_len, 2
    ok_bitxor_len = eq bitxor_len, 3
    ok_bitor_has_alpha = eq bitor_has_alpha, 1
    ok_bitor_has_bravo = eq bitor_has_bravo, 1
    ok_bitor_has_charlie = eq bitor_has_charlie, 1
    ok_bitor_has_delta = eq bitor_has_delta, 1
    ok_bitand_has_alpha = eq bitand_has_alpha, 0
    ok_bitand_has_bravo = eq bitand_has_bravo, 1
    ok_bitand_has_charlie = eq bitand_has_charlie, 0
    ok_bitand_has_delta = eq bitand_has_delta, 0
    ok_sub_has_alpha = eq sub_has_alpha, 1
    ok_sub_has_bravo = eq sub_has_bravo, 0
    ok_sub_has_charlie = eq sub_has_charlie, 1
    ok_sub_has_delta = eq sub_has_delta, 0
    ok_bitxor_has_alpha = eq bitxor_has_alpha, 1
    ok_bitxor_has_bravo = eq bitxor_has_bravo, 0
    ok_bitxor_has_charlie = eq bitxor_has_charlie, 1
    ok_bitxor_has_delta = eq bitxor_has_delta, 1
    ok_left_len_after = eq left_len_after, 3
    ok_right_len_after = eq right_len_after, 2

    ok01 = and ok_left_ins_alpha, ok_left_ins_bravo
    ok02 = and ok01, ok_left_ins_charlie
    ok03 = and ok02, ok_right_ins_bravo
    ok04 = and ok03, ok_right_ins_delta
    ok05 = and ok04, ok_bitor_len
    ok06 = and ok05, ok_bitand_len
    ok07 = and ok06, ok_sub_len
    ok08 = and ok07, ok_bitxor_len
    ok09 = and ok08, ok_bitor_has_alpha
    ok10 = and ok09, ok_bitor_has_bravo
    ok11 = and ok10, ok_bitor_has_charlie
    ok12 = and ok11, ok_bitor_has_delta
    ok13 = and ok12, ok_bitand_has_alpha
    ok14 = and ok13, ok_bitand_has_bravo
    ok15 = and ok14, ok_bitand_has_charlie
    ok16 = and ok15, ok_bitand_has_delta
    ok17 = and ok16, ok_sub_has_alpha
    ok18 = and ok17, ok_sub_has_bravo
    ok19 = and ok18, ok_sub_has_charlie
    ok20 = and ok19, ok_sub_has_delta
    ok21 = and ok20, ok_bitxor_has_alpha
    ok22 = and ok21, ok_bitxor_has_bravo
    ok23 = and ok22, ok_bitxor_has_charlie
    ok24 = and ok23, ok_bitxor_has_delta
    ok25 = and ok24, ok_left_len_after
    ok = and ok25, ok_right_len_after

    !left_ins_alpha
    !left_ins_bravo
    !left_ins_charlie
    !right_ins_bravo
    !right_ins_delta
    !bitor_len
    !bitand_len
    !sub_len
    !bitxor_len
    !bitor_has_alpha
    !bitor_has_bravo
    !bitor_has_charlie
    !bitor_has_delta
    !bitand_has_alpha
    !bitand_has_bravo
    !bitand_has_charlie
    !bitand_has_delta
    !sub_has_alpha
    !sub_has_bravo
    !sub_has_charlie
    !sub_has_delta
    !bitxor_has_alpha
    !bitxor_has_bravo
    !bitxor_has_charlie
    !bitxor_has_delta
    !left_len_after
    !right_len_after
    !ok_left_ins_alpha
    !ok_left_ins_bravo
    !ok_left_ins_charlie
    !ok_right_ins_bravo
    !ok_right_ins_delta
    !ok_bitor_len
    !ok_bitand_len
    !ok_sub_len
    !ok_bitxor_len
    !ok_bitor_has_alpha
    !ok_bitor_has_bravo
    !ok_bitor_has_charlie
    !ok_bitor_has_delta
    !ok_bitand_has_alpha
    !ok_bitand_has_bravo
    !ok_bitand_has_charlie
    !ok_bitand_has_delta
    !ok_sub_has_alpha
    !ok_sub_has_bravo
    !ok_sub_has_charlie
    !ok_sub_has_delta
    !ok_bitxor_has_alpha
    !ok_bitxor_has_bravo
    !ok_bitxor_has_charlie
    !ok_bitxor_has_delta
    !ok_left_len_after
    !ok_right_len_after
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_SET_FREE bitxor_set
    EXPAND BTREE_SET_FREE sub_set
    EXPAND BTREE_SET_FREE bitand_set
    EXPAND BTREE_SET_FREE bitor_set
    EXPAND BTREE_SET_FREE right
    EXPAND BTREE_SET_FREE left
    return 0

L_FAIL:
    panic(10810)
