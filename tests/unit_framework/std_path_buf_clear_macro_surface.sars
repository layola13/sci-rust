@import "sa_std/path.sars"
@import "sa_std/core/slice.sars"

@const S = utf8:"x"

@test "sa_std path_buf clear"():
L_ENTRY:
    EXPAND PATH_BUF_NEW pb
    child = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW child, &S, 1
    EXPAND PATH_BUF_PUSH pb, child
    EXPAND PATH_BUF_CLEAR pb
    EXPAND PATH_BUF_IS_EMPTY e, pb
    EXPAND PATH_BUF_LEN ln, pb
    EXPAND PATH_BUF_FREE pb
    a = eq e, 1
    b = eq ln, 0
    ok = and a, b
    !e
    !ln
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10987)
