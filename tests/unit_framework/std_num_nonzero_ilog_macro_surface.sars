@import "sa_std/num.sars"

@test "sa_std nonzero unsigned ilog macro surface"():
L_ENTRY:
    u8_nz = stack_alloc NonZeroU8_SIZE
    u16_nz = stack_alloc NonZeroU16_SIZE
    u32_nz = stack_alloc NonZeroU32_SIZE
    u64_nz = stack_alloc NonZeroU64_SIZE
    usize_nz = stack_alloc NonZeroUsize_SIZE

    EXPAND NONZERO_U8_NEW ok_u8_new, u8_nz, 99
    EXPAND NONZERO_U16_NEW ok_u16_new, u16_nz, 100
    EXPAND NONZERO_U32_NEW ok_u32_new, u32_nz, 65535
    EXPAND NONZERO_U64_NEW ok_u64_new, u64_nz, 1000000000000
    EXPAND NONZERO_USIZE_NEW ok_usize_new, usize_nz, 1000000000000000000

    EXPAND NONZERO_U8_ILOG2 u8_ilog2, u8_nz
    EXPAND NONZERO_U8_ILOG10 u8_ilog10, u8_nz
    EXPAND NONZERO_U16_ILOG2 u16_ilog2, u16_nz
    EXPAND NONZERO_U16_ILOG10 u16_ilog10, u16_nz
    EXPAND NONZERO_U32_ILOG2 u32_ilog2, u32_nz
    EXPAND NONZERO_U32_ILOG10 u32_ilog10, u32_nz
    EXPAND NONZERO_U64_ILOG2 u64_ilog2, u64_nz
    EXPAND NONZERO_U64_ILOG10 u64_ilog10, u64_nz
    EXPAND NONZERO_USIZE_ILOG2 usize_ilog2, usize_nz
    EXPAND NONZERO_USIZE_ILOG10 usize_ilog10, usize_nz

    ok_new_01 = and ok_u8_new, ok_u16_new
    ok_new_02 = and ok_new_01, ok_u32_new
    ok_new_03 = and ok_new_02, ok_u64_new
    ok_new_all = and ok_new_03, ok_usize_new

    ok_u8_ilog2 = eq u8_ilog2, 6
    ok_u8_ilog10 = eq u8_ilog10, 1
    ok_u16_ilog2 = eq u16_ilog2, 6
    ok_u16_ilog10 = eq u16_ilog10, 2
    ok_u32_ilog2 = eq u32_ilog2, 15
    ok_u32_ilog10 = eq u32_ilog10, 4
    ok_u64_ilog2 = eq u64_ilog2, 39
    ok_u64_ilog10 = eq u64_ilog10, 12
    ok_usize_ilog2 = eq usize_ilog2, 59
    ok_usize_ilog10 = eq usize_ilog10, 18

    ok_value_01 = and ok_new_all, ok_u8_ilog2
    ok_value_02 = and ok_value_01, ok_u8_ilog10
    ok_value_03 = and ok_value_02, ok_u16_ilog2
    ok_value_04 = and ok_value_03, ok_u16_ilog10
    ok_value_05 = and ok_value_04, ok_u32_ilog2
    ok_value_06 = and ok_value_05, ok_u32_ilog10
    ok_value_07 = and ok_value_06, ok_u64_ilog2
    ok_value_08 = and ok_value_07, ok_u64_ilog10
    ok_value_09 = and ok_value_08, ok_usize_ilog2
    ok = and ok_value_09, ok_usize_ilog10
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10612)

L_PASS:
    !ok
    return 0
