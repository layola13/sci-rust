@import "sa_std/collections/binary_heap.sars"

@binary_heap_into_iter_compare_u64(left: u64, right: u64) -> i64:
L_ENTRY:
    is_less = ult left, right
    br is_less -> L_BINARY_HEAP_INTO_ITER_COMPARE_LESS, L_BINARY_HEAP_INTO_ITER_COMPARE_CHECK_GREATER
L_BINARY_HEAP_INTO_ITER_COMPARE_LESS:
    out_less = sub 0, 1
    !is_less
    !right
    !left
    return out_less
L_BINARY_HEAP_INTO_ITER_COMPARE_CHECK_GREATER:
    is_greater = ugt left, right
    br is_greater -> L_BINARY_HEAP_INTO_ITER_COMPARE_GREATER, L_BINARY_HEAP_INTO_ITER_COMPARE_EQUAL
L_BINARY_HEAP_INTO_ITER_COMPARE_GREATER:
    out_greater = add 0, 1
    !is_greater
    !is_less
    !right
    !left
    return out_greater
L_BINARY_HEAP_INTO_ITER_COMPARE_EQUAL:
    out_equal = add 0, 0
    !is_greater
    !is_less
    !right
    !left
    return out_equal

@binary_heap_into_iter_key_ones(value: u64) -> u64:
L_ENTRY:
    out = urem value, 10
    !value
    return out

@binary_heap_into_iter_partial_none_on_99(left: u64, right: u64, &out_order: ptr) -> u64:
L_ENTRY:
    left_bad = eq left, 99
    right_bad = eq right, 99
    bad = or left_bad, right_bad
    br bad -> L_BINARY_HEAP_INTO_ITER_PARTIAL_CMP_NONE, L_BINARY_HEAP_INTO_ITER_PARTIAL_CMP_SOME
L_BINARY_HEAP_INTO_ITER_PARTIAL_CMP_SOME:
    order = call @binary_heap_into_iter_compare_u64(left, right)
    store out_order+0, order as i64
    !order
    !bad
    !right_bad
    !left_bad
    !out_order
    !right
    !left
    return 1
L_BINARY_HEAP_INTO_ITER_PARTIAL_CMP_NONE:
    !bad
    !right_bad
    !left_bad
    !out_order
    !right
    !left
    return 0

@binary_heap_into_iter_eq_mod10(left: u64, right: u64) -> u64:
L_ENTRY:
    left_key = urem left, 10
    right_key = urem right, 10
    out = eq left_key, right_key
    !right_key
    !left_key
    !right
    !left
    return out

