    call @sa_test_debug_i64(&FS_DBG_READ_LEN, FS_DBG_READ_LEN_LEN, string_len)
    call @sa_test_debug_i64(&FS_DBG_READ_TO_STRING_EQ, FS_DBG_READ_TO_STRING_EQ_LEN, string_eq)
    call @sa_test_debug_i64(&FS_DBG_INVALID_UTF8_STATUS, FS_DBG_INVALID_UTF8_STATUS_LEN, invalid_utf8_status)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_STATUS, FS_DBG_REMOVE_STATUS_LEN, cleanup_end_status)
    call @sa_assert_eq_i64(write_utf8_status, SA_FS_OK, 947)
    call @sa_assert_eq_i64(read_string_status, SA_FS_OK, 947)
    call @sa_assert_eq_i64(string_len, FS_TEST_HELLO_LEN, 947)
    call @sa_assert_eq_i64(string_eq, 1, 947)
    call @sa_assert_eq_i64(string_free_status, SA_FS_OK, 947)
    call @sa_assert_eq_i64(write_invalid_status, SA_FS_OK, 947)
    call @sa_assert_eq_i64(invalid_failed, 1, 947)
    call @sa_assert_eq_i64(cleanup_end_status, SA_FS_OK, 947)
    !ok
    !ok06
    !ok05
    !ok04
    !ok03
    !ok02
    !ok01
    !cleanup_ok
    !invalid_failed
    !write_invalid_ok
    !free_ok
    !eq_ok
    !len_ok
    !read_ok
    !write_ok
    !cleanup_end_status
    !invalid_string_buffer
    !invalid_utf8_status
    !write_invalid_status
    !invalid_buf
    !string_free_status
    !string_eq
    !hello_view
    !string_view
    !string_len
    !string_data
    !read_string_status
    !write_utf8_status
    !cleanup_utf8_status
    panic(947)

L_OK:
