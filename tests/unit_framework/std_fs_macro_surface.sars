L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_utf8_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN
    EXPAND FS_WRITE_FILE write_utf8_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND FS_READ_TO_STRING read_string_status, string_buffer, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, 64
    EXPAND FS_READ_BUFFER_DATA string_data, string_buffer
    EXPAND FS_READ_BUFFER_LEN string_len, string_buffer
    EXPAND STR_FROM_PARTS string_view, string_data, string_len
    EXPAND STR_FROM_PARTS hello_view, &FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND STR_EQ string_eq, string_view, hello_view
    EXPAND FS_READ_BUFFER_FREE string_free_status, string_buffer

    invalid_buf = alloc 1
    store invalid_buf+0, 255 as u8
    EXPAND FS_WRITE_FILE write_invalid_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, invalid_buf, 1
    EXPAND FS_READ_TO_STRING invalid_utf8_status, invalid_string_buffer, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, 64
    EXPAND FS_REMOVE_PATH cleanup_end_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN

    write_ok = eq write_utf8_status, SA_FS_OK
    read_ok = eq read_string_status, SA_FS_OK
    len_ok = eq string_len, FS_TEST_HELLO_LEN
    eq_ok = eq string_eq, 1
    free_ok = eq string_free_status, SA_FS_OK
    write_invalid_ok = eq write_invalid_status, SA_FS_OK
    invalid_failed = ne invalid_utf8_status, SA_FS_OK
    cleanup_ok = eq cleanup_end_status, SA_FS_OK
    ok01 = and write_ok, read_ok
    ok02 = and ok01, len_ok
    ok03 = and ok02, eq_ok
    ok04 = and ok03, free_ok
