    EXPAND FS_REMOVE_PATH cleanup_recursive_status, FS_DB_BASE, FS_DB_BASE_LEN
    EXPAND FS_REMOVE_PATH cleanup_single_status, FS_DB_SINGLE, FS_DB_SINGLE_LEN

    EXPAND FS_DIR_BUILDER_NEW b_recursive, b_mode
    new_recursive_ok = eq b_recursive, 0
    new_mode_ok = eq b_mode, 493

    EXPAND FS_DIR_BUILDER_WITH_RECURSIVE b_rec2, b_mode2, b_recursive, b_mode, 1
    rec_flag_ok = eq b_rec2, 1
    rec_mode_ok = eq b_mode2, 493

    EXPAND FS_DIR_BUILDER_WITH_MODE b_rec3, b_mode3, b_rec2, b_mode2, 448
