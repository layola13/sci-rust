    ok = and ok, nonblock_mode_ok
    ok = and ok, nonblock_custom_ok
    ok = and ok, nofollow_flags_ok
    ok = and ok, nofollow_mode_ok
    ok = and ok, nofollow_custom_ok
    ok = and ok, direct_flags_ok
    ok = and ok, direct_mode_ok
    ok = and ok, direct_custom_ok
    ok = and ok, directory_flags_ok
    ok = and ok, directory_mode_ok
    ok = and ok, directory_custom_ok
