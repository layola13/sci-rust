@test "sa_std fs OpenOptions builder custom-flags members macro surface"():
L_ENTRY:
    EXPAND FS_OPEN_OPTIONS_BUILDER_NEW b_flags, b_mode, b_custom
    new_flags_ok = eq b_flags, 0
    new_mode_ok = eq b_mode, SA_FS_OPEN_MODE_DEFAULT
    new_custom_ok = eq b_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_SYNC sy_flags, sy_mode, sy_custom, b_flags, b_mode, b_custom, 1
    sync_flags_ok = eq sy_flags, 0
    sync_mode_ok = eq sy_mode, SA_FS_OPEN_MODE_DEFAULT
    sync_custom_ok = eq sy_custom, SA_FS_CUSTOM_SYNC

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_DSYNC ds_flags, ds_mode, ds_custom, sy_flags, sy_mode, sy_custom, 1
    dsync_flags_ok = eq ds_flags, 0
    dsync_mode_ok = eq ds_mode, SA_FS_OPEN_MODE_DEFAULT
    dsync_custom_ok = eq ds_custom, 1052672

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_NONBLOCK nb_flags, nb_mode, nb_custom, ds_flags, ds_mode, ds_custom, 1
    nonblock_flags_ok = eq nb_flags, 0
    nonblock_mode_ok = eq nb_mode, SA_FS_OPEN_MODE_DEFAULT
    nonblock_custom_ok = eq nb_custom, 1054720

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_NOFOLLOW nf_flags, nf_mode, nf_custom, nb_flags, nb_mode, nb_custom, 1
    nofollow_flags_ok = eq nf_flags, 0
    nofollow_mode_ok = eq nf_mode, SA_FS_OPEN_MODE_DEFAULT
    nofollow_custom_ok = eq nf_custom, 1185792

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_DIRECT di_flags, di_mode, di_custom, nf_flags, nf_mode, nf_custom, 1
