@test "sa_std fs remove_dir_all macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_remove_all_status, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN
    EXPAND FS_CREATE_DIR_ALL create_nested_status, FS_TEST_REMOVE_ALL_CHILD, FS_TEST_REMOVE_ALL_CHILD_LEN
    EXPAND FS_REMOVE_DIR remove_nonempty_status, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN
    EXPAND FS_REMOVE_DIR_ALL remove_all_status, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN
    EXPAND FS_EXISTS gone_after_remove_all, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN

    create_nested_ok = eq create_nested_status, SA_FS_OK
    nonempty_failed = ne remove_nonempty_status, SA_FS_OK
    remove_all_ok = eq remove_all_status, SA_FS_OK
    gone_ok = eq gone_after_remove_all, 0
    ok01 = and create_nested_ok, nonempty_failed
    ok02 = and ok01, remove_all_ok
    ok = and ok02, gone_ok
    br ok -> L_OK, L_FAIL

L_FAIL:
    call @sa_test_debug_i64(&FS_DBG_MKDIR_STATUS, FS_DBG_MKDIR_STATUS_LEN, create_nested_status)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_NONEMPTY_STATUS, FS_DBG_REMOVE_NONEMPTY_STATUS_LEN, remove_nonempty_status)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_DIR_ALL_STATUS, FS_DBG_REMOVE_DIR_ALL_STATUS_LEN, remove_all_status)
    call @sa_test_debug_i64(&FS_DBG_GONE_AFTER_REMOVE_ALL, FS_DBG_GONE_AFTER_REMOVE_ALL_LEN, gone_after_remove_all)
    call @sa_assert_eq_i64(create_nested_status, SA_FS_OK, 10034)
    call @sa_assert_eq_i64(nonempty_failed, 1, 10034)
    call @sa_assert_eq_i64(remove_all_status, SA_FS_OK, 10034)
    call @sa_assert_eq_i64(gone_after_remove_all, 0, 10034)
    !ok
    !ok02
    !ok01
    !gone_ok
    !remove_all_ok
    !nonempty_failed
    !create_nested_ok
    !gone_after_remove_all
    !remove_all_status
    !remove_nonempty_status
    !create_nested_status
    !cleanup_remove_all_status
    panic(10034)

L_OK:
    !ok
    !ok02
    !ok01
    !gone_ok
    !remove_all_ok
    !nonempty_failed
    !create_nested_ok
    !gone_after_remove_all
    !remove_all_status
    !remove_nonempty_status
    !create_nested_status
    !cleanup_remove_all_status
    return

