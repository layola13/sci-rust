@test "sa_std fs Permissions object macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FS_PERM_TEST_PATH, FS_PERM_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FS_PERM_TEST_PATH, FS_PERM_TEST_PATH_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    write_ok = eq write_status, SA_FS_OK

    perm_slot = stack_alloc SaFsPermissions_SIZE
    EXPAND FS_PERMISSIONS_NEW perm_slot
    EXPAND FS_PERMISSIONS_MODE mode0, perm_slot
    mode0_ok = eq mode0, 0

    EXPAND FS_PERMISSIONS_FROM_MODE perm_slot, 420
    EXPAND FS_PERMISSIONS_MODE mode420, perm_slot
    mode420_ok = eq mode420, 420
    EXPAND FS_PERMISSIONS_READONLY ro_after_420, perm_slot
    ro_after_420_ok = eq ro_after_420, 0

    EXPAND FS_PERMISSIONS_SET_READONLY perm_slot, 1
    EXPAND FS_PERMISSIONS_MODE mode_ro, perm_slot
    EXPAND FS_PERMISSIONS_READONLY ro_flag, perm_slot
    write_mask = SA_FS_PERM_WRITE_BITS
    write_mask_inv = xor write_mask, 4294967295
    expected_ro_mode = and 420, write_mask_inv
    mode_ro_ok = eq mode_ro, expected_ro_mode
    ro_flag_ok = eq ro_flag, 1

    EXPAND FS_PERMISSIONS_SET_READONLY perm_slot, 0
    EXPAND FS_PERMISSIONS_MODE mode_rw, perm_slot
    EXPAND FS_PERMISSIONS_READONLY ro_after_rw, perm_slot
    expected_rw_mode = or expected_ro_mode, SA_FS_PERM_OWNER_WRITE
    mode_rw_ok = eq mode_rw, expected_rw_mode
    ro_after_rw_ok = eq ro_after_rw, 0

    EXPAND FS_PERMISSIONS_FROM_MODE perm_slot, 292
    EXPAND FS_SET_PERMISSIONS_OBJ set_obj_status, FS_PERM_TEST_PATH, FS_PERM_TEST_PATH_LEN, perm_slot
    set_obj_ok = eq set_obj_status, SA_FS_OK
    EXPAND FS_METADATA meta_status, meta, FS_PERM_TEST_PATH, FS_PERM_TEST_PATH_LEN
    meta_ok = eq meta_status, SA_FS_OK
    meta_perm_slot = stack_alloc SaFsPermissions_SIZE
    EXPAND FS_METADATA_PERMISSIONS meta_perm_slot, meta
    EXPAND FS_PERMISSIONS_MODE meta_mode_raw, meta_perm_slot
    meta_mode = and meta_mode_raw, 511
    EXPAND FS_PERMISSIONS_READONLY meta_ro, meta_perm_slot
    meta_mode_ok = eq meta_mode, 292
    meta_ro_ok = eq meta_ro, 1
    EXPAND FS_METADATA_FREE meta_free_status, meta
    meta_free_ok = eq meta_free_status, SA_FS_OK

    EXPAND FS_REMOVE_PATH cleanup_final_status, FS_PERM_TEST_PATH, FS_PERM_TEST_PATH_LEN

    ok = and write_ok, mode0_ok
    ok = and ok, mode420_ok
    ok = and ok, ro_after_420_ok
    ok = and ok, mode_ro_ok
    ok = and ok, ro_flag_ok
    ok = and ok, mode_rw_ok
    ok = and ok, ro_after_rw_ok
    ok = and ok, set_obj_ok
    ok = and ok, meta_ok
    ok = and ok, meta_mode_ok
    ok = and ok, meta_ro_ok
    ok = and ok, meta_free_ok

    !cleanup_status
    !write_status
    !mode0
    !mode420
    !ro_after_420
    !mode_ro
    !ro_flag
    !write_mask
    !write_mask_inv
    !expected_ro_mode
    !mode_rw
    !ro_after_rw
    !expected_rw_mode
    !set_obj_status
    !meta_status
    !meta
    !meta_mode_raw
    !meta_mode
    !meta_ro
    !meta_free_status
    !cleanup_final_status
    !write_ok
    !mode0_ok
    !mode420_ok
    !ro_after_420_ok
    !mode_ro_ok
    !ro_flag_ok
    !mode_rw_ok
    !ro_after_rw_ok
    !set_obj_ok
    !meta_ok
    !meta_mode_ok
    !meta_ro_ok
    !meta_free_ok
    br ok -> L_PERM_OBJ_OK, L_PERM_OBJ_FAIL

L_PERM_OBJ_FAIL:
    !ok
    panic(953)

L_PERM_OBJ_OK:
    !ok
    return

@test "sa_std fs FileTimes object macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FS_FTIMES_TEST_PATH, FS_FTIMES_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FS_FTIMES_TEST_PATH, FS_FTIMES_TEST_PATH_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    write_ok = eq write_status, SA_FS_OK

    EXPAND FS_FILE_TIMES_NEW t0_acc, t0_mod
    t0_acc_ok = eq t0_acc, 0
    t0_mod_ok = eq t0_mod, 0

    EXPAND FS_FILE_TIMES_WITH_ACCESSED t1_acc, t1_mod, t0_acc, t0_mod, 1700000001000
    EXPAND FS_FILE_TIMES_WITH_MODIFIED t2_acc, t2_mod, t1_acc, t1_mod, 1700000002000
    t2_acc_ok = eq t2_acc, 1700000001000
    t2_mod_ok = eq t2_mod, 1700000002000

    EXPAND FS_FILE_TIMES_SET set_status, FS_FTIMES_TEST_PATH, FS_FTIMES_TEST_PATH_LEN, t2_acc, t2_mod
    set_ok = eq set_status, SA_FS_OK

    EXPAND FS_METADATA meta_status, meta, FS_FTIMES_TEST_PATH, FS_FTIMES_TEST_PATH_LEN
    meta_ok = eq meta_status, SA_FS_OK
    EXPAND FS_METADATA_FILE_TIMES got_acc, got_mod, meta
    got_acc_ok = eq got_acc, 1700000001000
    got_mod_ok = eq got_mod, 1700000002000
    EXPAND FS_METADATA_FREE free_status, meta
    free_ok = eq free_status, SA_FS_OK

    EXPAND FS_REMOVE_PATH cleanup_final_status, FS_FTIMES_TEST_PATH, FS_FTIMES_TEST_PATH_LEN

    ok = and write_ok, t0_acc_ok
    ok = and ok, t0_mod_ok
    ok = and ok, t2_acc_ok
    ok = and ok, t2_mod_ok
    ok = and ok, set_ok
    ok = and ok, meta_ok
    ok = and ok, got_acc_ok
    ok = and ok, got_mod_ok
    ok = and ok, free_ok

    !cleanup_status
    !write_status
    !t0_acc
    !t0_mod
    !t1_acc
    !t1_mod
    !t2_acc
    !t2_mod
    !set_status
    !meta_status
    !meta
    !got_acc
    !got_mod
    !free_status
    !cleanup_final_status
    !write_ok
    !t0_acc_ok
    !t0_mod_ok
    !t2_acc_ok
    !t2_mod_ok
    !set_ok
    !meta_ok
    !got_acc_ok
    !got_mod_ok
    !free_ok
    br ok -> L_FTIMES_OK, L_FTIMES_FAIL

L_FTIMES_FAIL:
    !ok
    panic(954)

L_FTIMES_OK:
    !ok
    return


@test "sa_std fs permissions/file_times default helpers"():
L_ENTRY:
    perms_new = stack_alloc SaFsPermissions_SIZE
    perms_def = stack_alloc SaFsPermissions_SIZE
    EXPAND FS_PERMISSIONS_NEW perms_new
    EXPAND FS_PERMISSIONS_DEFAULT perms_def
    EXPAND FS_PERMISSIONS_MODE mode_new, perms_new
    EXPAND FS_PERMISSIONS_MODE mode_def, perms_def
    EXPAND FS_FILE_TIMES_NEW a_new, m_new
    EXPAND FS_FILE_TIMES_DEFAULT a_def, m_def

    ok_mode = eq mode_new, mode_def
    ok_a = eq a_new, a_def
    ok_m = eq m_new, m_def
    ok_a0 = eq a_def, 0
    ok_m0 = eq m_def, 0
    ok01 = and ok_mode, ok_a
    ok02 = and ok01, ok_m
    ok03 = and ok02, ok_a0
    ok = and ok03, ok_m0

    !mode_new
    !mode_def
    !a_new
    !m_new
    !a_def
    !m_def
    !ok_mode
    !ok_a
    !ok_m
    !ok_a0
    !ok_m0
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10458)
L_OK:
    !ok
    return
