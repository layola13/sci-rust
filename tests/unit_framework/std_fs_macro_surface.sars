@test "sa_std fs file io macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_path_status, FS_TEST_PATH, FS_TEST_PATH_LEN
    EXPAND FS_REMOVE_PATH cleanup_copy_status, FS_TEST_COPY_PATH, FS_TEST_COPY_PATH_LEN
    EXPAND FS_REMOVE_PATH cleanup_renamed_status, FS_TEST_RENAMED_PATH, FS_TEST_RENAMED_PATH_LEN

    EXPAND FS_WRITE_FILE write_file_status, FS_TEST_PATH, FS_TEST_PATH_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND FS_SET_PERMISSIONS perm_status, FS_TEST_PATH, FS_TEST_PATH_LEN, 420
    EXPAND FS_SET_TIMES_MS times_status, FS_TEST_PATH, FS_TEST_PATH_LEN, 1700000000000, 1700000000000
    EXPAND FS_EXISTS exists_after_write, FS_TEST_PATH, FS_TEST_PATH_LEN
    EXPAND FS_LEN len_status, file_len, FS_TEST_PATH, FS_TEST_PATH_LEN
    EXPAND FS_OPEN_READ open_read_status, read_file, FS_TEST_PATH, FS_TEST_PATH_LEN
    read_buf = alloc 8
    EXPAND FS_READ read_status, read_len, read_file, read_buf, 8
    EXPAND FS_CLOSE close_read_status, read_file
    EXPAND STR_FROM_PARTS read_view, read_buf, read_len
    EXPAND STR_FROM_PARTS hello_view, &FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND STR_EQ read_eq, read_view, hello_view

    write_file_ok = eq write_file_status, SA_FS_OK
    exists_ok = eq exists_after_write, 1
    len_status_ok = eq len_status, SA_FS_OK
    len_value_ok = eq file_len, FS_TEST_HELLO_LEN
    open_read_ok = eq open_read_status, SA_FS_OK
    read_status_ok = eq read_status, SA_FS_OK
    read_len_ok = eq read_len, FS_TEST_HELLO_LEN
    close_read_ok = eq close_read_status, SA_FS_OK
    read_eq_ok = eq read_eq, 1
    ok01 = and write_file_ok, exists_ok
    perm_ok = eq perm_status, SA_FS_OK
    times_ok = eq times_status, SA_FS_OK
    ok02a = and ok01, perm_ok
    ok02 = and ok02a, times_ok
    ok02b = and ok02, len_status_ok
    ok03 = and ok02b, len_value_ok
    ok04 = and ok03, open_read_ok
    ok05 = and ok04, read_status_ok
    ok06 = and ok05, read_len_ok
    ok07 = and ok06, close_read_ok
    read_phase_ok = and ok07, read_eq_ok
    br read_phase_ok -> L_TRUNCATE, L_FAIL_READ

L_FAIL_READ:
    call @sa_test_debug_i64(&FS_DBG_WRITE_STATUS, FS_DBG_WRITE_STATUS_LEN, write_file_status)
    call @sa_test_debug_i64(&FS_DBG_PERM_STATUS, FS_DBG_PERM_STATUS_LEN, perm_status)
    call @sa_test_debug_i64(&FS_DBG_TIMES_STATUS, FS_DBG_TIMES_STATUS_LEN, times_status)
    call @sa_test_debug_i64(&FS_DBG_EXISTS, FS_DBG_EXISTS_LEN, exists_after_write)
    call @sa_test_debug_i64(&FS_DBG_LEN_STATUS, FS_DBG_LEN_STATUS_LEN, len_status)
    call @sa_test_debug_i64(&FS_DBG_FILE_LEN, FS_DBG_FILE_LEN_LEN, file_len)
    call @sa_test_debug_i64(&FS_DBG_OPEN_STATUS, FS_DBG_OPEN_STATUS_LEN, open_read_status)
    call @sa_test_debug_i64(&FS_DBG_READ_STATUS, FS_DBG_READ_STATUS_LEN, read_status)
    call @sa_test_debug_i64(&FS_DBG_READ_LEN, FS_DBG_READ_LEN_LEN, read_len)
    call @sa_test_debug_i64(&FS_DBG_CLOSE_STATUS, FS_DBG_CLOSE_STATUS_LEN, close_read_status)
    call @sa_test_debug_i64(&FS_DBG_READ_EQ, FS_DBG_READ_EQ_LEN, read_eq)
    call @sa_assert_eq_i64(write_file_status, SA_FS_OK, 940)
    call @sa_assert_eq_i64(perm_status, SA_FS_OK, 940)
    call @sa_assert_eq_i64(times_status, SA_FS_OK, 940)
    call @sa_assert_eq_i64(exists_after_write, 1, 940)
    call @sa_assert_eq_i64(len_status, SA_FS_OK, 940)
    call @sa_assert_eq_i64(file_len, FS_TEST_HELLO_LEN, 940)
    call @sa_assert_eq_i64(open_read_status, SA_FS_OK, 940)
    call @sa_assert_eq_i64(read_status, SA_FS_OK, 940)
    call @sa_assert_eq_i64(read_len, FS_TEST_HELLO_LEN, 940)
    call @sa_assert_eq_i64(close_read_status, SA_FS_OK, 940)
    call @sa_assert_eq_i64(read_eq, 1, 940)
    !read_phase_ok
    !read_eq_ok
    !close_read_ok
    !read_len_ok
    !read_status_ok
    !open_read_ok
    !len_value_ok
    !len_status_ok
    !ok02b
    !ok02a
    !times_ok
    !perm_ok
    !exists_ok
    !write_file_ok
    !read_eq
    !hello_view
    !read_view
    !close_read_status
    !read_len
    !read_status
    !read_file
    !file_len
    !len_status
    !exists_after_write
    !perm_status
    !times_status
    !write_file_status
    !cleanup_renamed_status
    !cleanup_copy_status
    !cleanup_path_status
    panic(940)

L_TRUNCATE:
    !read_phase_ok
    !read_eq_ok
    !close_read_ok
    !read_len_ok
    !read_status_ok
    !open_read_ok
    !len_value_ok
    !len_status_ok
    !ok02b
    !ok02a
    !times_ok
    !perm_ok
    !exists_ok
    !write_file_ok
    !read_eq
    !hello_view
    !read_view
    !close_read_status
    !read_len
    !read_status
    !read_file
    !file_len
    !len_status
    !exists_after_write
    !perm_status
    !times_status
    !write_file_status
    EXPAND FS_CREATE create_status, write_file, FS_TEST_PATH, FS_TEST_PATH_LEN
    EXPAND FS_WRITE write_status, written_len, write_file, FS_TEST_HEY, FS_TEST_HEY_LEN
    EXPAND FS_FLUSH flush_status, write_file
    EXPAND FS_SYNC_DATA sync_data_status, write_file
    EXPAND FS_SYNC_ALL sync_status, write_file
    EXPAND FS_SET_LEN set_len_status, write_file, FS_TEST_HEY_LEN
    EXPAND FS_SEEK seek_status, seek_pos, write_file, SA_FS_SEEK_START, 0
    exact_buf = alloc 4
    EXPAND FS_READ_EXACT exact_status, write_file, exact_buf, FS_TEST_HEY_LEN
    EXPAND FS_CLOSE close_write_status, write_file
    EXPAND FS_LEN len2_status, file_len2, FS_TEST_PATH, FS_TEST_PATH_LEN
    EXPAND STR_FROM_PARTS exact_view, exact_buf, FS_TEST_HEY_LEN
    EXPAND STR_FROM_PARTS hey_view, &FS_TEST_HEY, FS_TEST_HEY_LEN
    EXPAND STR_EQ exact_eq, exact_view, hey_view

    create_ok = eq create_status, SA_FS_OK
    write_ok = eq write_status, SA_FS_OK
    written_len_ok = eq written_len, FS_TEST_HEY_LEN
    flush_ok = eq flush_status, SA_FS_OK
    sync_data_ok = eq sync_data_status, SA_FS_OK
    sync_ok = eq sync_status, SA_FS_OK
    set_len_ok = eq set_len_status, SA_FS_OK
    seek_status_ok = eq seek_status, SA_FS_OK
    seek_pos_ok = eq seek_pos, 0
    exact_ok = eq exact_status, SA_FS_OK
    close_write_ok = eq close_write_status, SA_FS_OK
    len2_status_ok = eq len2_status, SA_FS_OK
    len2_value_ok = eq file_len2, FS_TEST_HEY_LEN
    exact_eq_ok = eq exact_eq, 1
    ok11 = and create_ok, write_ok
    ok12 = and ok11, written_len_ok
    ok13 = and ok12, flush_ok
    ok14 = and ok13, sync_data_ok
    ok15 = and ok14, sync_ok
    ok16 = and ok15, set_len_ok
    ok17 = and ok16, seek_status_ok
    ok18 = and ok17, seek_pos_ok
    ok19 = and ok18, exact_ok
    ok20 = and ok19, close_write_ok
    ok21 = and ok20, len2_status_ok
    ok22 = and ok21, len2_value_ok
    ok = and ok22, exact_eq_ok
    br ok -> L_OK, L_FAIL_TRUNCATE

L_FAIL_TRUNCATE:
    call @sa_test_debug_i64(&FS_DBG_CREATE_STATUS, FS_DBG_CREATE_STATUS_LEN, create_status)
    call @sa_test_debug_i64(&FS_DBG_WRITE_STATUS, FS_DBG_WRITE_STATUS_LEN, write_status)
    call @sa_test_debug_i64(&FS_DBG_WRITTEN_LEN, FS_DBG_WRITTEN_LEN_LEN, written_len)
    call @sa_test_debug_i64(&FS_DBG_FLUSH_STATUS, FS_DBG_FLUSH_STATUS_LEN, flush_status)
    call @sa_test_debug_i64(&FS_DBG_SYNC_DATA_STATUS, FS_DBG_SYNC_DATA_STATUS_LEN, sync_data_status)
    call @sa_test_debug_i64(&FS_DBG_SYNC_STATUS, FS_DBG_SYNC_STATUS_LEN, sync_status)
    call @sa_test_debug_i64(&FS_DBG_SET_LEN_STATUS, FS_DBG_SET_LEN_STATUS_LEN, set_len_status)
    call @sa_test_debug_i64(&FS_DBG_SEEK_STATUS, FS_DBG_SEEK_STATUS_LEN, seek_status)
    call @sa_test_debug_i64(&FS_DBG_SEEK_POS, FS_DBG_SEEK_POS_LEN, seek_pos)
    call @sa_test_debug_i64(&FS_DBG_EXACT_STATUS, FS_DBG_EXACT_STATUS_LEN, exact_status)
    call @sa_test_debug_i64(&FS_DBG_CLOSE_STATUS, FS_DBG_CLOSE_STATUS_LEN, close_write_status)
    call @sa_test_debug_i64(&FS_DBG_LEN2_STATUS, FS_DBG_LEN2_STATUS_LEN, len2_status)
    call @sa_test_debug_i64(&FS_DBG_FILE_LEN2, FS_DBG_FILE_LEN2_LEN, file_len2)
    call @sa_test_debug_i64(&FS_DBG_EXACT_EQ, FS_DBG_EXACT_EQ_LEN, exact_eq)
    call @sa_assert_eq_i64(create_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(write_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(written_len, FS_TEST_HEY_LEN, 941)
    call @sa_assert_eq_i64(flush_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(sync_data_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(sync_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(set_len_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(seek_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(seek_pos, 0, 941)
    call @sa_assert_eq_i64(exact_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(close_write_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(len2_status, SA_FS_OK, 941)
    call @sa_assert_eq_i64(file_len2, FS_TEST_HEY_LEN, 941)
    call @sa_assert_eq_i64(exact_eq, 1, 941)
    !ok
    !exact_eq_ok
    !ok22
    !len2_value_ok
    !len2_status_ok
    !close_write_ok
    !exact_ok
    !seek_pos_ok
    !seek_status_ok
    !set_len_ok
    !sync_ok
    !sync_data_ok
    !flush_ok
    !written_len_ok
    !write_ok
    !create_ok
    !exact_eq
    !hey_view
    !exact_view
    !file_len2
    !len2_status
    !close_write_status
    !exact_status
    !seek_pos
    !seek_status
    !set_len_status
    !sync_status
    !sync_data_status
    !flush_status
    !written_len
    !write_status
    !write_file
    !cleanup_renamed_status
    !cleanup_copy_status
    !cleanup_path_status
    panic(941)

L_OK:
    !ok
    !exact_eq_ok
    !ok22
    !len2_value_ok
    !len2_status_ok
    !close_write_ok
    !exact_ok
    !seek_pos_ok
    !seek_status_ok
    !set_len_ok
    !sync_ok
    !sync_data_ok
    !flush_ok
    !written_len_ok
    !write_ok
    !create_ok
    !exact_eq
    !hey_view
    !exact_view
    !file_len2
    !len2_status
    !close_write_status
    !exact_status
    !seek_pos
    !seek_status
    !set_len_status
    !sync_status
    !sync_data_status
    !flush_status
    !written_len
    !write_status
    !write_file
    EXPAND FS_REMOVE_PATH cleanup_end_status, FS_TEST_PATH, FS_TEST_PATH_LEN
    !cleanup_end_status
    !cleanup_renamed_status
    !cleanup_copy_status
    !cleanup_path_status
    return

@test "sa_std fs hard link macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_path_status, FS_HARD_PATH, FS_HARD_PATH_LEN
    EXPAND FS_REMOVE_PATH cleanup_link_status, FS_HARD_LINK_PATH, FS_HARD_LINK_PATH_LEN

    EXPAND FS_WRITE_FILE write_status, FS_HARD_PATH, FS_HARD_PATH_LEN, FS_TEST_HEY, FS_TEST_HEY_LEN
    EXPAND FS_HARD_LINK link_status, FS_HARD_PATH, FS_HARD_PATH_LEN, FS_HARD_LINK_PATH, FS_HARD_LINK_PATH_LEN
    EXPAND FS_EXISTS link_exists, FS_HARD_LINK_PATH, FS_HARD_LINK_PATH_LEN
    EXPAND FS_LEN link_len_status, link_len, FS_HARD_LINK_PATH, FS_HARD_LINK_PATH_LEN
