    !dir_meta_status
    !d0
    !d1
    !d2
    !db0
    !dc0
    !df0
    !dsk0
    !file_meta_free
    !dir_meta_free
    !cleanup_final_file_status
    !cleanup_final_dir_status
    !write_ok
    !file_meta_ok
    !file_is_file_ok
    !file_is_dir_ok
    !file_is_symlink_ok
    !file_is_blk_ok
    !file_is_chr_ok
    !file_is_fifo_ok
    !file_is_sock_ok
