    dir_is_dir_ok = eq d1, 1
    dir_is_symlink_ok = eq d2, 0
    dir_is_blk_ok = eq db0, 0
    dir_is_chr_ok = eq dc0, 0
    dir_is_fifo_ok = eq df0, 0
    dir_is_sock_ok = eq dsk0, 0

    EXPAND FS_METADATA_FREE file_meta_free, file_meta
    file_meta_free_ok = eq file_meta_free, SA_FS_OK
    EXPAND FS_METADATA_FREE dir_meta_free, dir_meta
    dir_meta_free_ok = eq dir_meta_free, SA_FS_OK

    EXPAND FS_REMOVE_PATH cleanup_final_file_status, FS_FT_TEST_FILE, FS_FT_TEST_FILE_LEN
    EXPAND FS_REMOVE_PATH cleanup_final_dir_status, FS_FT_TEST_DIR, FS_FT_TEST_DIR_LEN

    ok = and write_ok, file_meta_ok
    ok = and ok, file_is_file_ok
    ok = and ok, file_is_dir_ok
    ok = and ok, file_is_symlink_ok
    ok = and ok, file_is_blk_ok
    ok = and ok, file_is_chr_ok
    ok = and ok, file_is_fifo_ok
    ok = and ok, file_is_sock_ok
    ok = and ok, create_dir_ok
    ok = and ok, dir_meta_ok
    ok = and ok, dir_is_file_ok
    ok = and ok, dir_is_dir_ok
    ok = and ok, dir_is_symlink_ok
    ok = and ok, dir_is_blk_ok
    ok = and ok, dir_is_chr_ok
    ok = and ok, dir_is_fifo_ok
    ok = and ok, dir_is_sock_ok
    ok = and ok, file_meta_free_ok
    ok = and ok, dir_meta_free_ok

    !file_meta
    !dir_meta
    !cleanup_file_status
    !cleanup_dir_status
