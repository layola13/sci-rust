@test "sa_std fs try_exists macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_path_status, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN
    EXPAND FS_TRY_EXISTS missing_status, missing_exists, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND FS_TRY_EXISTS present_status, present_exists, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN
    EXPAND FS_REMOVE_PATH cleanup_end_status, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN

    missing_status_ok = eq missing_status, SA_FS_OK
    missing_value_ok = eq missing_exists, 0
    write_ok = eq write_status, SA_FS_OK
    present_status_ok = eq present_status, SA_FS_OK
    present_value_ok = eq present_exists, 1
    cleanup_ok = eq cleanup_end_status, SA_FS_OK
    ok01 = and missing_status_ok, missing_value_ok
    ok02 = and ok01, write_ok
    ok03 = and ok02, present_status_ok
    ok04 = and ok03, present_value_ok
    ok = and ok04, cleanup_ok
    br ok -> L_OK, L_FAIL

L_FAIL:
    call @sa_test_debug_i64(&FS_DBG_TRY_EXISTS_STATUS, FS_DBG_TRY_EXISTS_STATUS_LEN, missing_status)
    call @sa_test_debug_i64(&FS_DBG_EXISTS, FS_DBG_EXISTS_LEN, missing_exists)
    call @sa_test_debug_i64(&FS_DBG_WRITE_STATUS, FS_DBG_WRITE_STATUS_LEN, write_status)
    call @sa_test_debug_i64(&FS_DBG_TRY_EXISTS_STATUS, FS_DBG_TRY_EXISTS_STATUS_LEN, present_status)
    call @sa_test_debug_i64(&FS_DBG_EXISTS, FS_DBG_EXISTS_LEN, present_exists)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_STATUS, FS_DBG_REMOVE_STATUS_LEN, cleanup_end_status)
    call @sa_assert_eq_i64(missing_status, SA_FS_OK, 948)
    call @sa_assert_eq_i64(missing_exists, 0, 948)
    call @sa_assert_eq_i64(write_status, SA_FS_OK, 948)
    call @sa_assert_eq_i64(present_status, SA_FS_OK, 948)
    call @sa_assert_eq_i64(present_exists, 1, 948)
    call @sa_assert_eq_i64(cleanup_end_status, SA_FS_OK, 948)
    !ok
    !ok04
    !ok03
    !ok02
    !ok01
    !cleanup_ok
    !present_value_ok
    !present_status_ok
    !write_ok
    !missing_value_ok
    !missing_status_ok
    !cleanup_end_status
    !present_exists
    !present_status
    !write_status
    !missing_exists
    !missing_status
    !cleanup_path_status
    panic(948)

L_OK:
    !ok
    !ok04
    !ok03
    !ok02
    !ok01
    !cleanup_ok
    !present_value_ok
    !present_status_ok
    !write_ok
    !missing_value_ok
    !missing_status_ok
    !cleanup_end_status
    !present_exists
    !present_status
    !write_status
    !missing_exists
    !missing_status
    !cleanup_path_status
    return

