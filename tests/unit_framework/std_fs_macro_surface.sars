    !keepread_flags_ok
    !keepread_mode_ok
    !keepread_custom_ok
    !append_flags_ok
    !append_mode_ok
    !append_custom_ok
    !open_ok
    !write_ok
    !write_len_ok
    !close_ok
    !open_read_ok
    !read_ok
    !read_len_val_ok
    !read_eq_ok
    !close_read_ok
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10036)
L_OK:
    !ok
    return

@test "sa_std fs FileType macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_file_status, FS_FT_TEST_FILE, FS_FT_TEST_FILE_LEN
    EXPAND FS_REMOVE_PATH cleanup_dir_status, FS_FT_TEST_DIR, FS_FT_TEST_DIR_LEN

    EXPAND FS_WRITE_FILE write_file_status, FS_FT_TEST_FILE, FS_FT_TEST_FILE_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    write_ok = eq write_file_status, SA_FS_OK
    EXPAND FS_METADATA file_meta_status, file_meta, FS_FT_TEST_FILE, FS_FT_TEST_FILE_LEN
    file_meta_ok = eq file_meta_status, SA_FS_OK
