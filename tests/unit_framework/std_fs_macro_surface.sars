    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10035)
L_OK:
    !ok
    return

@test "sa_std fs OpenOptions builder macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FS_OOB_TEST_PATH, FS_OOB_TEST_PATH_LEN

    EXPAND FS_OPEN_OPTIONS_BUILDER_NEW s_flags, s_mode, s_custom
    new_flags_ok = eq s_flags, 0
    new_mode_ok = eq s_mode, SA_FS_OPEN_MODE_DEFAULT
    new_custom_ok = eq s_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_READ r_flags, r_mode, r_custom, s_flags, s_mode, s_custom, 1
    read_flags_ok = eq r_flags, SA_FS_OPEN_READ
    read_mode_ok = eq r_mode, SA_FS_OPEN_MODE_DEFAULT
    read_custom_ok = eq r_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_WRITE w_flags, w_mode, w_custom, r_flags, r_mode, r_custom, 1
    write_flags_ok = eq w_flags, 3
    write_mode_ok = eq w_mode, SA_FS_OPEN_MODE_DEFAULT
    write_custom_ok = eq w_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_TRUNCATE t_flags, t_mode, t_custom, w_flags, w_mode, w_custom, 1
    truncate_flags_ok = eq t_flags, 11
    truncate_mode_ok = eq t_mode, SA_FS_OPEN_MODE_DEFAULT
    truncate_custom_ok = eq t_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_CREATE c_flags, c_mode, c_custom, t_flags, t_mode, t_custom, 1
    create_flags_ok = eq c_flags, 15
    create_mode_ok = eq c_mode, SA_FS_OPEN_MODE_DEFAULT
    create_custom_ok = eq c_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_MODE m_flags, m_mode, m_custom, c_flags, c_mode, c_custom, 420
    mode_flags_ok = eq m_flags, 15
    mode_val_ok = eq m_mode, 420
    mode_custom_ok = eq m_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_CUSTOM_FLAGS x_flags, x_mode, x_custom, m_flags, m_mode, m_custom, SA_FS_CUSTOM_CLOEXEC
    custom_flags_ok = eq x_flags, 15
    custom_mode_ok = eq x_mode, 420
    custom_val_ok = eq x_custom, SA_FS_CUSTOM_CLOEXEC

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_READ x2_flags, x2_mode, x2_custom, x_flags, x_mode, x_custom, 0
    keepread_flags_ok = eq x2_flags, 15
    keepread_mode_ok = eq x2_mode, 420
    keepread_custom_ok = eq x2_custom, SA_FS_CUSTOM_CLOEXEC

    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_APPEND a_flags, a_mode, a_custom, c_flags, c_mode, c_custom, 1
    append_flags_ok = eq a_flags, 31
    append_mode_ok = eq a_mode, SA_FS_OPEN_MODE_DEFAULT
    append_custom_ok = eq a_custom, 0

    EXPAND FS_OPEN_OPTIONS_BUILDER_NEW ow_flags, ow_mode, ow_custom
    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_WRITE ow_flags, ow_mode, ow_custom, ow_flags, ow_mode, ow_custom, 1
    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_CREATE ow_flags, ow_mode, ow_custom, ow_flags, ow_mode, ow_custom, 1
    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_TRUNCATE ow_flags, ow_mode, ow_custom, ow_flags, ow_mode, ow_custom, 0
    EXPAND FS_OPEN_OPTIONS_BUILDER_OPEN open_status, wf, ow_flags, ow_mode, ow_custom, FS_OOB_TEST_PATH, FS_OOB_TEST_PATH_LEN
    open_ok = eq open_status, SA_FS_OK
    EXPAND FS_WRITE w_status, wlen, wf, &FS_OOB_TEST_DATA, FS_OOB_TEST_DATA_LEN
    write_ok = eq w_status, SA_FS_OK
    write_len_ok = eq wlen, FS_OOB_TEST_DATA_LEN
    EXPAND FS_CLOSE close_status, wf
    close_ok = eq close_status, SA_FS_OK

    EXPAND FS_OPEN_OPTIONS_BUILDER_NEW or_flags, or_mode, or_custom
    EXPAND FS_OPEN_OPTIONS_BUILDER_WITH_READ or_flags, or_mode, or_custom, or_flags, or_mode, or_custom, 1
    EXPAND FS_OPEN_OPTIONS_BUILDER_OPEN open_read_status, rf, or_flags, or_mode, or_custom, FS_OOB_TEST_PATH, FS_OOB_TEST_PATH_LEN
