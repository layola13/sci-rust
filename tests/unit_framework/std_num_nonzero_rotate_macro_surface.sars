@import "sa_std/num.sars"

@test "sa_std nonzero integer rotate macro surface"():
L_ENTRY:
    u8_nz = stack_alloc NonZeroU8_SIZE
    u8_left = stack_alloc NonZeroU8_SIZE
    u8_right = stack_alloc NonZeroU8_SIZE
    u16_nz = stack_alloc NonZeroU16_SIZE
    u16_left = stack_alloc NonZeroU16_SIZE
    u16_right = stack_alloc NonZeroU16_SIZE
    u32_nz = stack_alloc NonZeroU32_SIZE
    u32_left = stack_alloc NonZeroU32_SIZE
    u32_right = stack_alloc NonZeroU32_SIZE
    u64_nz = stack_alloc NonZeroU64_SIZE
    u64_left = stack_alloc NonZeroU64_SIZE
    u64_right = stack_alloc NonZeroU64_SIZE
    usize_nz = stack_alloc NonZeroUsize_SIZE
    usize_left = stack_alloc NonZeroUsize_SIZE
    usize_right = stack_alloc NonZeroUsize_SIZE
    i8_nz = stack_alloc NonZeroI8_SIZE
    i8_left = stack_alloc NonZeroI8_SIZE
    i8_right = stack_alloc NonZeroI8_SIZE
    i8_one = stack_alloc NonZeroI8_SIZE
    i8_one_right = stack_alloc NonZeroI8_SIZE
    i16_nz = stack_alloc NonZeroI16_SIZE
    i16_left = stack_alloc NonZeroI16_SIZE
    i16_right = stack_alloc NonZeroI16_SIZE
    i16_one = stack_alloc NonZeroI16_SIZE
    i16_one_right = stack_alloc NonZeroI16_SIZE
    i32_nz = stack_alloc NonZeroI32_SIZE
    i32_left = stack_alloc NonZeroI32_SIZE
    i32_right = stack_alloc NonZeroI32_SIZE
    i32_one = stack_alloc NonZeroI32_SIZE
    i32_one_right = stack_alloc NonZeroI32_SIZE
    i64_nz = stack_alloc NonZeroI64_SIZE
    i64_left = stack_alloc NonZeroI64_SIZE
    i64_right = stack_alloc NonZeroI64_SIZE
    i64_one = stack_alloc NonZeroI64_SIZE
    i64_one_right = stack_alloc NonZeroI64_SIZE
    isize_nz = stack_alloc NonZeroIsize_SIZE
    isize_left = stack_alloc NonZeroIsize_SIZE
    isize_right = stack_alloc NonZeroIsize_SIZE
    isize_one = stack_alloc NonZeroIsize_SIZE
    isize_one_right = stack_alloc NonZeroIsize_SIZE

    EXPAND NONZERO_U8_NEW ok_u8_new, u8_nz, 18
    EXPAND NONZERO_U16_NEW ok_u16_new, u16_nz, 4660
    EXPAND NONZERO_U32_NEW ok_u32_new, u32_nz, 305419896
    EXPAND NONZERO_U64_NEW ok_u64_new, u64_nz, 78187493376
    EXPAND NONZERO_USIZE_NEW ok_usize_new, usize_nz, 78187493376
    EXPAND NONZERO_I8_NEW ok_i8_new, i8_nz, 18
    EXPAND NONZERO_I8_NEW ok_i8_one_new, i8_one, 1
    EXPAND NONZERO_I16_NEW ok_i16_new, i16_nz, 4660
    EXPAND NONZERO_I16_NEW ok_i16_one_new, i16_one, 1
    EXPAND NONZERO_I32_NEW ok_i32_new, i32_nz, 305419896
    EXPAND NONZERO_I32_NEW ok_i32_one_new, i32_one, 1
    EXPAND NONZERO_I64_NEW ok_i64_new, i64_nz, 78187493376
    EXPAND NONZERO_I64_NEW ok_i64_one_new, i64_one, 1
    EXPAND NONZERO_ISIZE_NEW ok_isize_new, isize_nz, 78187493376
    EXPAND NONZERO_ISIZE_NEW ok_isize_one_new, isize_one, 1

    EXPAND NONZERO_U8_ROTATE_LEFT ok_u8_left, u8_left, u8_nz, 4
    EXPAND NONZERO_U8_ROTATE_RIGHT ok_u8_right, u8_right, u8_nz, 4
    EXPAND NONZERO_U16_ROTATE_LEFT ok_u16_left, u16_left, u16_nz, 4
    EXPAND NONZERO_U16_ROTATE_RIGHT ok_u16_right, u16_right, u16_nz, 4
    EXPAND NONZERO_U32_ROTATE_LEFT ok_u32_left, u32_left, u32_nz, 8
    EXPAND NONZERO_U32_ROTATE_RIGHT ok_u32_right, u32_right, u32_nz, 8
    EXPAND NONZERO_U64_ROTATE_LEFT ok_u64_left, u64_left, u64_nz, 8
    EXPAND NONZERO_U64_ROTATE_RIGHT ok_u64_right, u64_right, u64_nz, 8
    EXPAND NONZERO_USIZE_ROTATE_LEFT ok_usize_left, usize_left, usize_nz, 8
    EXPAND NONZERO_USIZE_ROTATE_RIGHT ok_usize_right, usize_right, usize_nz, 8
    EXPAND NONZERO_I8_ROTATE_LEFT ok_i8_left, i8_left, i8_nz, 4
    EXPAND NONZERO_I8_ROTATE_RIGHT ok_i8_right, i8_right, i8_nz, 4
    EXPAND NONZERO_I8_ROTATE_RIGHT ok_i8_one_right, i8_one_right, i8_one, 1
    EXPAND NONZERO_I16_ROTATE_LEFT ok_i16_left, i16_left, i16_nz, 4
    EXPAND NONZERO_I16_ROTATE_RIGHT ok_i16_right, i16_right, i16_nz, 4
    EXPAND NONZERO_I16_ROTATE_RIGHT ok_i16_one_right, i16_one_right, i16_one, 1
    EXPAND NONZERO_I32_ROTATE_LEFT ok_i32_left, i32_left, i32_nz, 8
    EXPAND NONZERO_I32_ROTATE_RIGHT ok_i32_right, i32_right, i32_nz, 8
    EXPAND NONZERO_I32_ROTATE_RIGHT ok_i32_one_right, i32_one_right, i32_one, 1
    EXPAND NONZERO_I64_ROTATE_LEFT ok_i64_left, i64_left, i64_nz, 8
    EXPAND NONZERO_I64_ROTATE_RIGHT ok_i64_right, i64_right, i64_nz, 8
    EXPAND NONZERO_I64_ROTATE_RIGHT ok_i64_one_right, i64_one_right, i64_one, 1
    EXPAND NONZERO_ISIZE_ROTATE_LEFT ok_isize_left, isize_left, isize_nz, 8
    EXPAND NONZERO_ISIZE_ROTATE_RIGHT ok_isize_right, isize_right, isize_nz, 8
    EXPAND NONZERO_ISIZE_ROTATE_RIGHT ok_isize_one_right, isize_one_right, isize_one, 1

    EXPAND NONZERO_U8_GET u8_left_value, u8_left
    EXPAND NONZERO_U8_GET u8_right_value, u8_right
    EXPAND NONZERO_U16_GET u16_left_value, u16_left
    EXPAND NONZERO_U16_GET u16_right_value, u16_right
    EXPAND NONZERO_U32_GET u32_left_value, u32_left
    EXPAND NONZERO_U32_GET u32_right_value, u32_right
    EXPAND NONZERO_U64_GET u64_left_value, u64_left
    EXPAND NONZERO_U64_GET u64_right_value, u64_right
    EXPAND NONZERO_USIZE_GET usize_left_value, usize_left
    EXPAND NONZERO_USIZE_GET usize_right_value, usize_right
    EXPAND NONZERO_I8_GET i8_left_value, i8_left
    EXPAND NONZERO_I8_GET i8_right_value, i8_right
    EXPAND NONZERO_I8_GET i8_one_right_value, i8_one_right
    EXPAND NONZERO_I16_GET i16_left_value, i16_left
    EXPAND NONZERO_I16_GET i16_right_value, i16_right
    EXPAND NONZERO_I16_GET i16_one_right_value, i16_one_right
    EXPAND NONZERO_I32_GET i32_left_value, i32_left
    EXPAND NONZERO_I32_GET i32_right_value, i32_right
    EXPAND NONZERO_I32_GET i32_one_right_value, i32_one_right
    EXPAND NONZERO_I64_GET i64_left_value, i64_left
    EXPAND NONZERO_I64_GET i64_right_value, i64_right
    EXPAND NONZERO_I64_GET i64_one_right_value, i64_one_right
    EXPAND NONZERO_ISIZE_GET isize_left_value, isize_left
    EXPAND NONZERO_ISIZE_GET isize_right_value, isize_right
    EXPAND NONZERO_ISIZE_GET isize_one_right_value, isize_one_right

    ok_new_01 = and ok_u8_new, ok_u16_new
    ok_new_02 = and ok_new_01, ok_u32_new
    ok_new_03 = and ok_new_02, ok_u64_new
    ok_new_04 = and ok_new_03, ok_usize_new
    ok_new_05 = and ok_new_04, ok_i8_new
    ok_new_06 = and ok_new_05, ok_i8_one_new
    ok_new_07 = and ok_new_06, ok_i16_new
    ok_new_08 = and ok_new_07, ok_i16_one_new
    ok_new_09 = and ok_new_08, ok_i32_new
    ok_new_10 = and ok_new_09, ok_i32_one_new
    ok_new_11 = and ok_new_10, ok_i64_new
    ok_new_12 = and ok_new_11, ok_i64_one_new
    ok_new_13 = and ok_new_12, ok_isize_new
    ok_new_all = and ok_new_13, ok_isize_one_new

    ok_rot_01 = and ok_u8_left, ok_u8_right
    ok_rot_02 = and ok_rot_01, ok_u16_left
    ok_rot_03 = and ok_rot_02, ok_u16_right
    ok_rot_04 = and ok_rot_03, ok_u32_left
    ok_rot_05 = and ok_rot_04, ok_u32_right
    ok_rot_06 = and ok_rot_05, ok_u64_left
    ok_rot_07 = and ok_rot_06, ok_u64_right
    ok_rot_08 = and ok_rot_07, ok_usize_left
    ok_rot_09 = and ok_rot_08, ok_usize_right
    ok_rot_10 = and ok_rot_09, ok_i8_left
    ok_rot_11 = and ok_rot_10, ok_i8_right
    ok_rot_12 = and ok_rot_11, ok_i8_one_right
    ok_rot_13 = and ok_rot_12, ok_i16_left
    ok_rot_14 = and ok_rot_13, ok_i16_right
    ok_rot_15 = and ok_rot_14, ok_i16_one_right
    ok_rot_16 = and ok_rot_15, ok_i32_left
    ok_rot_17 = and ok_rot_16, ok_i32_right
    ok_rot_18 = and ok_rot_17, ok_i32_one_right
    ok_rot_19 = and ok_rot_18, ok_i64_left
    ok_rot_20 = and ok_rot_19, ok_i64_right
    ok_rot_21 = and ok_rot_20, ok_i64_one_right
    ok_rot_22 = and ok_rot_21, ok_isize_left
    ok_rot_23 = and ok_rot_22, ok_isize_right
    ok_rot_all = and ok_rot_23, ok_isize_one_right

    ok_u8_left_value = eq u8_left_value, 33
    ok_u8_right_value = eq u8_right_value, 33
    ok_u16_left_value = eq u16_left_value, 9025
    ok_u16_right_value = eq u16_right_value, 16675
    ok_u32_left_value = eq u32_left_value, 878082066
    ok_u32_right_value = eq u32_right_value, 2014458966
    ok_u64_left_value = eq u64_left_value, 20015998304256
    ok_u64_right_value = eq u64_right_value, 305419896
    ok_usize_left_value = eq usize_left_value, 20015998304256
    ok_usize_right_value = eq usize_right_value, 305419896
    ok_i8_left_value = eq i8_left_value, 33
    ok_i8_right_value = eq i8_right_value, 33
    ok_i8_one_right_value = eq i8_one_right_value, NUM_I8_MIN
    ok_i16_left_value = eq i16_left_value, 9025
    ok_i16_right_value = eq i16_right_value, 16675
    ok_i16_one_right_value = eq i16_one_right_value, NUM_I16_MIN
    ok_i32_left_value = eq i32_left_value, 878082066
    ok_i32_right_value = eq i32_right_value, 2014458966
    ok_i32_one_right_value = eq i32_one_right_value, NUM_I32_MIN
    ok_i64_left_value = eq i64_left_value, 20015998304256
    ok_i64_right_value = eq i64_right_value, 305419896
    ok_i64_one_right_value = eq i64_one_right_value, NUM_I64_MIN
    ok_isize_left_value = eq isize_left_value, 20015998304256
    ok_isize_right_value = eq isize_right_value, 305419896
    ok_isize_one_right_value = eq isize_one_right_value, NUM_ISIZE_MIN

    ok_value_01 = and ok_new_all, ok_rot_all
    ok_value_02 = and ok_value_01, ok_u8_left_value
    ok_value_03 = and ok_value_02, ok_u8_right_value
    ok_value_04 = and ok_value_03, ok_u16_left_value
    ok_value_05 = and ok_value_04, ok_u16_right_value
    ok_value_06 = and ok_value_05, ok_u32_left_value
    ok_value_07 = and ok_value_06, ok_u32_right_value
    ok_value_08 = and ok_value_07, ok_u64_left_value
    ok_value_09 = and ok_value_08, ok_u64_right_value
    ok_value_10 = and ok_value_09, ok_usize_left_value
    ok_value_11 = and ok_value_10, ok_usize_right_value
    ok_value_12 = and ok_value_11, ok_i8_left_value
    ok_value_13 = and ok_value_12, ok_i8_right_value
    ok_value_14 = and ok_value_13, ok_i8_one_right_value
    ok_value_15 = and ok_value_14, ok_i16_left_value
    ok_value_16 = and ok_value_15, ok_i16_right_value
    ok_value_17 = and ok_value_16, ok_i16_one_right_value
    ok_value_18 = and ok_value_17, ok_i32_left_value
    ok_value_19 = and ok_value_18, ok_i32_right_value
    ok_value_20 = and ok_value_19, ok_i32_one_right_value
    ok_value_21 = and ok_value_20, ok_i64_left_value
    ok_value_22 = and ok_value_21, ok_i64_right_value
    ok_value_23 = and ok_value_22, ok_i64_one_right_value
    ok_value_24 = and ok_value_23, ok_isize_left_value
    ok_value_25 = and ok_value_24, ok_isize_right_value
    ok = and ok_value_25, ok_isize_one_right_value
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10609)

L_PASS:
    !ok
    return 0
