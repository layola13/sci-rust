@import "sa_std/ffi.sars"
@import "sa_std/core/slice.sars"

@test "sa_std cstring is_empty"():
L_ENTRY:
    empty_buf = stack_alloc 1
    store empty_buf+0, 0 as u8
    empty_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW empty_slice, empty_buf, 1
    cstring = stack_alloc CString_SIZE
    EXPAND CSTRING_FROM_BYTES_WITH_NUL st, cstring, empty_slice
    EXPAND CSTRING_IS_EMPTY empty, cstring
    a = eq st, CSTR_FROM_BYTES_OK
    b = eq empty, 1
    ok = and a, b
    !st
    !empty
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10964)
