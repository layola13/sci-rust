@import "sa_std/core/cell.sars"

@cell_add_three(value: u64) -> u64:
L_ENTRY:
    out = add value, 3
    return out

@test "sa_std cell primitive i32 compatibility macros"():
L_ENTRY:
    EXPAND CELL_NEW cell
    EXPAND CELL_GET initial, cell
    EXPAND CELL_SET cell, 12
    EXPAND CELL_REPLACE old_value, cell, 19
    EXPAND CELL_GET final_value, cell

    ok01 = eq initial, 0
    ok02 = eq old_value, 12
    ok03 = eq final_value, 19
    ok12 = and ok01, ok02
    ok = and ok12, ok03

    !cell
    !initial
    !old_value
    !final_value
    !ok01
    !ok02
    !ok03
    !ok12

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(945)

L_PASS:
    !ok
    return 0

@test "sa_std cell u64 rust-style macros"():
L_ENTRY:
    EXPAND CELL_U64_NEW left, 10
    EXPAND CELL_U64_DEFAULT right
    EXPAND CELL_U64_GET left_initial, left
    EXPAND CELL_U64_GET right_initial, right
    EXPAND CELL_U64_SET right, 30
    EXPAND CELL_U64_REPLACE left_old, left, 20
    EXPAND CELL_U64_GET left_after_replace, left
    EXPAND CELL_U64_SWAP left, right
    EXPAND CELL_U64_GET left_after_swap, left
    EXPAND CELL_U64_GET right_after_swap, right
    EXPAND CELL_U64_UPDATE update_old, update_new, left, @cell_add_three
    EXPAND CELL_U64_GET left_after_update, left
    EXPAND CELL_U64_REPLACE_WITH replace_with_old, replace_with_new, left, @cell_add_three
    EXPAND CELL_U64_GET left_after_replace_with, left
    EXPAND CELL_U64_TAKE taken_value, left
    EXPAND CELL_U64_GET left_after_take, left
    EXPAND CELL_U64_INTO_INNER inner_value, right
    EXPAND CELL_U64_AS_PTR left_ptr, left
    ptr_value = load left_ptr+0 as u64
    EXPAND CELL_U64_GET_MUT_PTR left_mut_ptr, left
    store left_mut_ptr+0, 88 as u64
    EXPAND CELL_U64_GET left_after_mut_ptr, left
    EXPAND CELL_U64_FROM_MUT_PTR cell_from_mut, left_mut_ptr
    from_mut_value = load cell_from_mut+0 as u64

    ok01 = eq left_initial, 10
    ok02 = eq right_initial, 0
    ok03 = eq left_old, 10
    ok04 = eq left_after_replace, 20
    ok05 = eq left_after_swap, 30
    ok06 = eq right_after_swap, 20
    ok07 = eq update_old, 30
    ok08 = eq update_new, 33
    ok09 = eq left_after_update, 33
    ok10 = eq replace_with_old, 33
    ok11 = eq replace_with_new, 36
    ok12 = eq left_after_replace_with, 36
    ok13 = eq taken_value, 36
    ok14 = eq left_after_take, 0
    ok15 = eq inner_value, 20
    ok16 = eq ptr_value, 0
    ok17 = eq left_after_mut_ptr, 88
    ok18 = eq from_mut_value, 88

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok09
    all09 = and all08, ok10
    all10 = and all09, ok11
    all11 = and all10, ok12
    all12 = and all11, ok13
    all13 = and all12, ok14
    all14 = and all13, ok15
    all15 = and all14, ok16
    all16 = and all15, ok17
    all = and all16, ok18

    !left
    !right
    !left_initial
    !right_initial
    !left_old
    !left_after_replace
    !left_after_swap
    !right_after_swap
    !update_old
    !update_new
    !left_after_update
    !replace_with_old
    !replace_with_new
    !left_after_replace_with
    !taken_value
    !left_after_take
    !inner_value
    !left_ptr
    !ptr_value
    !left_mut_ptr
    !left_after_mut_ptr
    !cell_from_mut
    !from_mut_value
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !all11
    !all12
    !all13
    !all14
    !all15
    !all16

    br all -> L_PASS, L_FAIL

L_FAIL:
    !all
    panic(946)

L_PASS:
    !all
    return 0
