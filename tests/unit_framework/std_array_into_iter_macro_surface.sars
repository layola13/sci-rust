@import "sa_std/array.sars"

@test "sa_std array into_iter macro surface"():
L_ENTRY:
    arr = stack_alloc 32
    store arr+0, 10 as u64
    store arr+8, 20 as u64
    store arr+16, 30 as u64
    store arr+24, 40 as u64

    EXPAND ARRAY_INTO_ITER_U64 iter, backing, arr, 4
    store arr+8, 99 as u64
    EXPAND ARRAY_INTO_ITER_SIZE_HINT_U64 hint_lower_initial, hint_upper_initial, iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 exact_len_initial, iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_initial, iter
    ref_slice = stack_alloc Slice_SIZE
    EXPAND ARRAY_INTO_ITER_AS_REF_SLICE_U64 ref_slice, iter
    EXPAND SLICE_GET_LEN ref_slice_len, ref_slice
    EXPAND SLICE_GET_U64 ref_slice_first, ref_slice, 0
    EXPAND ARRAY_INTO_ITER_NEXT_U64 first_has, first, iter
    mut_slice = stack_alloc Slice_SIZE
    EXPAND ARRAY_INTO_ITER_AS_MUT_SLICE_U64 mut_slice, iter
    EXPAND SLICE_GET_LEN mut_slice_len, mut_slice
    EXPAND SLICE_GET_MUT_PTR_U64 mut_second_ptr, mut_slice, 0
    store mut_second_ptr+0, 25 as u64
    EXPAND ARRAY_INTO_ITER_NEXT_U64 second_has, second, iter
    EXPAND ARRAY_INTO_ITER_CLONE_U64 clone_iter, clone_backing, iter
    clone_mut_slice = stack_alloc Slice_SIZE
    EXPAND ARRAY_INTO_ITER_AS_MUT_SLICE_U64 clone_mut_slice, clone_iter
    EXPAND SLICE_GET_MUT_PTR_U64 clone_first_ptr, clone_mut_slice, 0
    store clone_first_ptr+0, 35 as u64
    EXPAND ARRAY_INTO_ITER_NEXT_U64 clone_first_has, clone_first, clone_iter
    EXPAND ARRAY_INTO_ITER_NEXT_BACK_U64 clone_back_has, clone_back, clone_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 clone_done_has, clone_done, clone_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 original_len_after_clone, iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 original_next_has, original_next, iter
    EXPAND ARRAY_INTO_ITER_NEXT_BACK_U64 original_back_has, original_back, iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 original_empty_done, iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 original_done_has, original_done, iter
    EXPAND VEC_GET_U64 backing_second_after_mut_slice, backing, 1
    source_second_after_copy = load arr+8 as u64

    EXPAND ARRAY_INTO_ITER_NEW_U64 new_iter, new_backing, arr, 2
    EXPAND ARRAY_INTO_ITER_NEXT_U64 new_first_has, new_first, new_iter
    EXPAND ARRAY_INTO_ITER_NEXT_BACK_U64 new_back_has, new_back, new_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 new_empty_done, new_iter

    EXPAND ARRAY_INTO_ITER_DEFAULT_U64 default_iter, default_backing
    EXPAND ARRAY_INTO_ITER_SIZE_HINT_U64 default_hint_lower, default_hint_upper, default_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 default_empty, default_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 default_next_has, default_next, default_iter
    EXPAND ARRAY_INTO_ITER_NEXT_BACK_U64 default_back_has, default_back, default_iter

    EXPAND VEC_FREE backing
    EXPAND VEC_FREE clone_backing
    EXPAND VEC_FREE new_backing
    EXPAND VEC_FREE default_backing

    ok_hint_lower_initial = eq hint_lower_initial, 4
    ok_hint_upper_initial = eq hint_upper_initial, 4
    ok_exact_len_initial = eq exact_len_initial, 4
    ok_empty_initial = eq empty_initial, 0
    ok_ref_slice_len = eq ref_slice_len, 4
    ok_ref_slice_first = eq ref_slice_first, 10
    ok_first_has = eq first_has, 1
    ok_first = eq first, 10
    ok_mut_slice_len = eq mut_slice_len, 3
    ok_second_has = eq second_has, 1
    ok_second = eq second, 25
    ok_clone_first_has = eq clone_first_has, 1
    ok_clone_first = eq clone_first, 35
    ok_clone_back_has = eq clone_back_has, 1
    ok_clone_back = eq clone_back, 40
    ok_clone_done_has = eq clone_done_has, 0
    ok_clone_done = eq clone_done, 0
    ok_original_len_after_clone = eq original_len_after_clone, 2
    ok_original_next_has = eq original_next_has, 1
    ok_original_next = eq original_next, 30
    ok_original_back_has = eq original_back_has, 1
    ok_original_back = eq original_back, 40
    ok_original_empty_done = eq original_empty_done, 1
    ok_original_done_has = eq original_done_has, 0
    ok_original_done = eq original_done, 0
    ok_backing_second = eq backing_second_after_mut_slice, 25
    ok_source_second = eq source_second_after_copy, 99
    ok_new_first_has = eq new_first_has, 1
    ok_new_first = eq new_first, 10
    ok_new_back_has = eq new_back_has, 1
    ok_new_back = eq new_back, 99
    ok_new_empty_done = eq new_empty_done, 1
    ok_default_hint_lower = eq default_hint_lower, 0
    ok_default_hint_upper = eq default_hint_upper, 0
    ok_default_empty = eq default_empty, 1
    ok_default_next_has = eq default_next_has, 0
    ok_default_next = eq default_next, 0
    ok_default_back_has = eq default_back_has, 0
    ok_default_back = eq default_back, 0

    ok = and ok_hint_lower_initial, ok_hint_upper_initial
    ok = and ok, ok_exact_len_initial
    ok = and ok, ok_empty_initial
    ok = and ok, ok_ref_slice_len
    ok = and ok, ok_ref_slice_first
    ok = and ok, ok_first_has
    ok = and ok, ok_first
    ok = and ok, ok_mut_slice_len
    ok = and ok, ok_second_has
    ok = and ok, ok_second
    ok = and ok, ok_clone_first_has
    ok = and ok, ok_clone_first
    ok = and ok, ok_clone_back_has
    ok = and ok, ok_clone_back
    ok = and ok, ok_clone_done_has
    ok = and ok, ok_clone_done
    ok = and ok, ok_original_len_after_clone
    ok = and ok, ok_original_next_has
    ok = and ok, ok_original_next
    ok = and ok, ok_original_back_has
    ok = and ok, ok_original_back
    ok = and ok, ok_original_empty_done
    ok = and ok, ok_original_done_has
    ok = and ok, ok_original_done
    ok = and ok, ok_backing_second
    ok = and ok, ok_source_second
    ok = and ok, ok_new_first_has
    ok = and ok, ok_new_first
    ok = and ok, ok_new_back_has
    ok = and ok, ok_new_back
    ok = and ok, ok_new_empty_done
    ok = and ok, ok_default_hint_lower
    ok = and ok, ok_default_hint_upper
    ok = and ok, ok_default_empty
    ok = and ok, ok_default_next_has
    ok = and ok, ok_default_next
    ok = and ok, ok_default_back_has
    ok = and ok, ok_default_back

    !hint_lower_initial
    !hint_upper_initial
    !exact_len_initial
    !empty_initial
    !ref_slice_len
    !ref_slice_first
    !first_has
    !first
    !mut_slice_len
    !mut_second_ptr
    !second_has
    !second
    !clone_first_ptr
    !clone_first_has
    !clone_first
    !clone_back_has
    !clone_back
    !clone_done_has
    !clone_done
    !original_len_after_clone
    !original_next_has
    !original_next
    !original_back_has
    !original_back
    !original_empty_done
    !original_done_has
    !original_done
    !backing_second_after_mut_slice
    !source_second_after_copy
    !new_first_has
    !new_first
    !new_back_has
    !new_back
    !new_empty_done
    !default_hint_lower
    !default_hint_upper
    !default_empty
    !default_next_has
    !default_next
    !default_back_has
    !default_back
    !ok_hint_lower_initial
    !ok_hint_upper_initial
    !ok_exact_len_initial
    !ok_empty_initial
    !ok_ref_slice_len
    !ok_ref_slice_first
    !ok_first_has
    !ok_first
    !ok_mut_slice_len
    !ok_second_has
    !ok_second
    !ok_clone_first_has
    !ok_clone_first
    !ok_clone_back_has
    !ok_clone_back
    !ok_clone_done_has
    !ok_clone_done
    !ok_original_len_after_clone
    !ok_original_next_has
    !ok_original_next
    !ok_original_back_has
    !ok_original_back
    !ok_original_empty_done
    !ok_original_done_has
    !ok_original_done
    !ok_backing_second
    !ok_source_second
    !ok_new_first_has
    !ok_new_first
    !ok_new_back_has
    !ok_new_back
    !ok_new_empty_done
    !ok_default_hint_lower
    !ok_default_hint_upper
    !ok_default_empty
    !ok_default_next_has
    !ok_default_next
    !ok_default_back_has
    !ok_default_back
    !iter
    !clone_iter
    !new_iter
    !default_iter
    br ok -> L_ARRAY_INTO_ITER_OK, L_ARRAY_INTO_ITER_FAIL

L_ARRAY_INTO_ITER_FAIL:
    !ok
    panic(10737)

L_ARRAY_INTO_ITER_OK:
    !ok
    return
