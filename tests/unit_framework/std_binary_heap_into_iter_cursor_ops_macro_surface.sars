@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap into_iter cursor ops macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW cursor_heap
    EXPAND BINARY_HEAP_PUSH_U64 cursor_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 cursor_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 cursor_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 cursor_iter, cursor_backing, cursor_heap
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 next_has, next_value, cursor_iter
    EXPAND BINARY_HEAP_INTO_ITER_NTH_U64 nth_has, nth_value, cursor_iter, 0
    EXPAND BINARY_HEAP_INTO_ITER_NTH_BACK_U64 nth_back_has, nth_back_value, cursor_iter, 0
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 done_has, done_value, cursor_iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_cursor, cursor_iter
    EXPAND VEC_LEN cursor_backing_len, cursor_backing

    EXPAND BINARY_HEAP_NEW last_heap
    EXPAND BINARY_HEAP_PUSH_U64 last_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 last_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 last_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 last_iter, last_backing, last_heap
    EXPAND BINARY_HEAP_INTO_ITER_LAST_U64 last_has, last_value, last_iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_last, last_iter
    EXPAND VEC_LEN last_backing_len, last_backing

    EXPAND BINARY_HEAP_NEW count_heap
    EXPAND BINARY_HEAP_PUSH_U64 count_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 count_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 count_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 count_iter, count_backing, count_heap
    EXPAND BINARY_HEAP_INTO_ITER_COUNT_U64 count_value, count_iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_count, count_iter
    EXPAND VEC_LEN count_backing_len, count_backing

    EXPAND BINARY_HEAP_NEW nth_miss_heap
    EXPAND BINARY_HEAP_PUSH_U64 nth_miss_heap, 8
    EXPAND BINARY_HEAP_PUSH_U64 nth_miss_heap, 3
    EXPAND BINARY_HEAP_INTO_ITER_U64 nth_miss_iter, nth_miss_backing, nth_miss_heap
    EXPAND BINARY_HEAP_INTO_ITER_NTH_U64 nth_miss_has, nth_miss_value, nth_miss_iter, 9
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 nth_miss_len_after, nth_miss_iter

    EXPAND BINARY_HEAP_NEW nth_back_miss_heap
    EXPAND BINARY_HEAP_PUSH_U64 nth_back_miss_heap, 8
    EXPAND BINARY_HEAP_PUSH_U64 nth_back_miss_heap, 3
    EXPAND BINARY_HEAP_INTO_ITER_U64 nth_back_miss_iter, nth_back_miss_backing, nth_back_miss_heap
    EXPAND BINARY_HEAP_INTO_ITER_NTH_BACK_U64 nth_back_miss_has, nth_back_miss_value, nth_back_miss_iter, 9
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 nth_back_miss_len_after, nth_back_miss_iter

    EXPAND VEC_FREE cursor_backing
    EXPAND VEC_FREE last_backing
    EXPAND VEC_FREE count_backing
    EXPAND VEC_FREE nth_miss_backing
    EXPAND VEC_FREE nth_back_miss_backing

    ok_next_has = eq next_has, 1
    ok_next_value = eq next_value, 9
    ok_nth_has = eq nth_has, 1
    ok_nth_value = eq nth_value, 4
    ok_nth_back_has = eq nth_back_has, 1
    ok_nth_back_value = eq nth_back_value, 1
    ok_done_has = eq done_has, 0
    ok_done_value = eq done_value, 0
    ok_len_after_cursor = eq len_after_cursor, 0
    ok_cursor_backing_len = eq cursor_backing_len, 3
    ok_last_has = eq last_has, 1
    ok_last_value = eq last_value, 1
    ok_len_after_last = eq len_after_last, 0
    ok_last_backing_len = eq last_backing_len, 3
    ok_count_value = eq count_value, 3
    ok_len_after_count = eq len_after_count, 0
    ok_count_backing_len = eq count_backing_len, 3
    ok_nth_miss_has = eq nth_miss_has, 0
    ok_nth_miss_value = eq nth_miss_value, 0
    ok_nth_miss_len_after = eq nth_miss_len_after, 0
    ok_nth_back_miss_has = eq nth_back_miss_has, 0
    ok_nth_back_miss_value = eq nth_back_miss_value, 0
    ok_nth_back_miss_len_after = eq nth_back_miss_len_after, 0

    ok = and ok_next_has, ok_next_value
    ok = and ok, ok_nth_has
    ok = and ok, ok_nth_value
    ok = and ok, ok_nth_back_has
    ok = and ok, ok_nth_back_value
    ok = and ok, ok_done_has
    ok = and ok, ok_done_value
    ok = and ok, ok_len_after_cursor
    ok = and ok, ok_cursor_backing_len
    ok = and ok, ok_last_has
    ok = and ok, ok_last_value
    ok = and ok, ok_len_after_last
    ok = and ok, ok_last_backing_len
    ok = and ok, ok_count_value
    ok = and ok, ok_len_after_count
    ok = and ok, ok_count_backing_len
    ok = and ok, ok_nth_miss_has
    ok = and ok, ok_nth_miss_value
    ok = and ok, ok_nth_miss_len_after
    ok = and ok, ok_nth_back_miss_has
    ok = and ok, ok_nth_back_miss_value
    ok = and ok, ok_nth_back_miss_len_after

    !next_has
    !next_value
    !nth_has
    !nth_value
    !nth_back_has
    !nth_back_value
    !done_has
    !done_value
    !len_after_cursor
    !cursor_backing_len
    !last_has
    !last_value
    !len_after_last
    !last_backing_len
    !count_value
    !len_after_count
    !count_backing_len
    !nth_miss_has
    !nth_miss_value
    !nth_miss_len_after
    !nth_back_miss_has
    !nth_back_miss_value
    !nth_back_miss_len_after
    !ok_next_has
    !ok_next_value
    !ok_nth_has
    !ok_nth_value
    !ok_nth_back_has
    !ok_nth_back_value
    !ok_done_has
    !ok_done_value
    !ok_len_after_cursor
    !ok_cursor_backing_len
    !ok_last_has
    !ok_last_value
    !ok_len_after_last
    !ok_last_backing_len
    !ok_count_value
    !ok_len_after_count
    !ok_count_backing_len
    !ok_nth_miss_has
    !ok_nth_miss_value
    !ok_nth_miss_len_after
    !ok_nth_back_miss_has
    !ok_nth_back_miss_value
    !ok_nth_back_miss_len_after
    !cursor_iter
    !last_iter
    !count_iter
    !nth_miss_iter
    !nth_back_miss_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_CURSOR_OPS_OK, L_BINARY_HEAP_INTO_ITER_CURSOR_OPS_FAIL

L_BINARY_HEAP_INTO_ITER_CURSOR_OPS_FAIL:
    !ok
    panic(10767)

L_BINARY_HEAP_INTO_ITER_CURSOR_OPS_OK:
    !ok
    return
