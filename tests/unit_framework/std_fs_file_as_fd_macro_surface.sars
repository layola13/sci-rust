@import "sa_std/fs.sars"
@import "sa_std/os/fd.sars"

@const FS_FILE_AS_FD_TEST_PATH = utf8:"_tmp_fs_file_as_fd_surface.txt"
@const FS_FILE_AS_FD_TEST_DATA = utf8:"fileasfd"

#def FS_FILE_AS_FD_TEST_PATH_LEN = 30
#def FS_FILE_AS_FD_TEST_DATA_LEN = 8

@test "sa_std fs File AsFd alias"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FS_FILE_AS_FD_TEST_PATH, FS_FILE_AS_FD_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FS_FILE_AS_FD_TEST_PATH, FS_FILE_AS_FD_TEST_PATH_LEN, FS_FILE_AS_FD_TEST_DATA, FS_FILE_AS_FD_TEST_DATA_LEN
    EXPAND FS_OPEN_READ open_status, file_handle, FS_FILE_AS_FD_TEST_PATH, FS_FILE_AS_FD_TEST_PATH_LEN
    EXPAND FS_FILE_AS_FD as_fd_status, borrowed_fd, file_handle
    EXPAND FS_FILE_AS_RAW_FD as_raw_status, raw_fd, file_handle
    EXPAND FD_BORROWED_AS_RAW_FD borrowed_raw_status, borrowed_raw_fd, borrowed_fd
    EXPAND FD_BORROWED_TRY_CLONE_TO_OWNED clone_status, cloned_owned_fd, borrowed_fd
    EXPAND FS_CLOSE file_close_status, file_handle

    read_buf = stack_alloc 8
    EXPAND FS_READ read_status, read_len, cloned_owned_fd, read_buf, 8
    b0 = load read_buf+0 as u8
    b7 = load read_buf+7 as u8
    EXPAND FS_CLOSE clone_close_status, cloned_owned_fd
    EXPAND FS_REMOVE_PATH remove_status, FS_FILE_AS_FD_TEST_PATH, FS_FILE_AS_FD_TEST_PATH_LEN

    write_ok = eq write_status, SA_FS_OK
    open_ok = eq open_status, SA_FS_OK
    as_fd_ok = eq as_fd_status, SA_FD_OK
    borrowed_fd_ok = ne borrowed_fd, 0
    as_raw_ok = eq as_raw_status, SA_FD_OK
    raw_fd_ok = eq raw_fd, borrowed_fd
    borrowed_raw_ok = eq borrowed_raw_status, SA_FD_OK
    borrowed_raw_same_ok = eq borrowed_raw_fd, borrowed_fd
    clone_ok = eq clone_status, SA_FD_OK
    cloned_owned_ok = ne cloned_owned_fd, 0
    file_close_ok = eq file_close_status, SA_FS_OK
    read_ok = eq read_status, SA_FS_OK
    read_len_ok = eq read_len, 8
    b0_ok = eq b0, 102
    b7_ok = eq b7, 100
    clone_close_ok = eq clone_close_status, SA_FS_OK
    remove_ok = eq remove_status, SA_FS_OK

    ok01 = and write_ok, open_ok
    ok02 = and ok01, as_fd_ok
    ok03 = and ok02, borrowed_fd_ok
    ok04 = and ok03, as_raw_ok
    ok05 = and ok04, raw_fd_ok
    ok06 = and ok05, borrowed_raw_ok
    ok07 = and ok06, borrowed_raw_same_ok
    ok08 = and ok07, clone_ok
    ok09 = and ok08, cloned_owned_ok
    ok10 = and ok09, file_close_ok
    ok11 = and ok10, read_ok
    ok12 = and ok11, read_len_ok
    ok13 = and ok12, b0_ok
    ok14 = and ok13, b7_ok
    ok15 = and ok14, clone_close_ok
    ok = and ok15, remove_ok

    !cleanup_status
    !write_status
    !open_status
    !file_handle
    !as_fd_status
    !borrowed_fd
    !as_raw_status
    !raw_fd
    !borrowed_raw_status
    !borrowed_raw_fd
    !clone_status
    !cloned_owned_fd
    !file_close_status
    !read_status
    !read_len
    !b0
    !b7
    !clone_close_status
    !remove_status
    !write_ok
    !open_ok
    !as_fd_ok
    !borrowed_fd_ok
    !as_raw_ok
    !raw_fd_ok
    !borrowed_raw_ok
    !borrowed_raw_same_ok
    !clone_ok
    !cloned_owned_ok
    !file_close_ok
    !read_ok
    !read_len_ok
    !b0_ok
    !b7_ok
    !clone_close_ok
    !remove_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10694)

L_PASS:
    !ok
    return 0
