@import "sa_std/sync/condvar.sars"
@import "sa_std/sync/mutex.sars"

@test "sa_std condvar wait_timeout_ms"():
L_ENTRY:
    EXPAND CONDVAR_NEW cond
    EXPAND MUTEX_NEW mutex
    EXPAND MUTEX_LOCK mutex
    EXPAND CONDVAR_WAIT_TIMEOUT_MS notified, cond, mutex, 1
    EXPAND MUTEX_UNLOCK mutex
    ok = eq notified, 0
    !notified
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10893)

@test "sa_std condvar wait_timeout_ms overflow fails deterministically"():
L_ENTRY:
    EXPAND CONDVAR_NEW cond
    EXPAND MUTEX_NEW mutex
    EXPAND MUTEX_LOCK mutex
    EXPAND CONDVAR_WAIT_TIMEOUT_MS notified, cond, mutex, 18446744073709551615
    EXPAND MUTEX_IS_LOCKED locked, mutex
    EXPAND MUTEX_UNLOCK mutex
    ok0 = eq notified, 0
    ok1 = eq locked, 1
    ok = and ok0, ok1
    !notified
    !locked
    !ok0
    !ok1
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10994)
