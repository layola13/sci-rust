@import "sa_std/os/unix_ffi.sars"
@import "sa_std/core/slice.sars"
@import "sa_std/vec.sars"
@import "sa_std/string.sars"

@test "sa_std os unix ffi OsStr byte view macros"():
L_ENTRY:
    bytes = stack_alloc 4
    store bytes+0, 102 as u8
    store bytes+1, 111 as u8
    store bytes+2, 111 as u8
    store bytes+3, 255 as u8

    byte_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW byte_slice, bytes, 4
    EXPAND OS_STR_FROM_BYTES os_str, byte_slice
    EXPAND OS_STR_AS_BYTES bytes_again, os_str
    EXPAND OS_STR_FROM_BYTES_SLICE os_str_alias, byte_slice
    EXPAND OS_STR_AS_BYTES_SLICE bytes_alias, os_str_alias

    EXPAND SLICE_GET_LEN source_len, byte_slice
    EXPAND SLICE_GET_PTR source_ptr, byte_slice
    EXPAND SLICE_GET_LEN os_len, os_str
    EXPAND SLICE_GET_PTR os_ptr, os_str
    EXPAND SLICE_GET_LEN bytes_len, bytes_again
    EXPAND SLICE_GET_PTR bytes_ptr, bytes_again
    EXPAND SLICE_TRY_GET_TYPED_U8 first_ok, first_byte, bytes_again, 0, 1
    EXPAND SLICE_TRY_GET_TYPED_U8 last_ok, last_byte, bytes_again, 3, 1
    EXPAND SLICE_GET_LEN alias_len, bytes_alias
    EXPAND SLICE_GET_PTR alias_ptr, bytes_alias

    null_ptr = 0 as ptr
    source_len_ok = eq source_len, 4
    source_ptr_ok = ne source_ptr, null_ptr
    os_len_ok = eq os_len, 4
    os_ptr_ok = eq os_ptr, source_ptr
    bytes_len_ok = eq bytes_len, 4
    bytes_ptr_ok = eq bytes_ptr, source_ptr
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first_byte, 102
    last_flag_ok = eq last_ok, 1
    last_value_ok = eq last_byte, 255
    alias_len_ok = eq alias_len, 4
    alias_ptr_ok = eq alias_ptr, source_ptr

    ok01 = and source_len_ok, source_ptr_ok
    ok02 = and ok01, os_len_ok
    ok03 = and ok02, os_ptr_ok
    ok04 = and ok03, bytes_len_ok
    ok05 = and ok04, bytes_ptr_ok
    ok06 = and ok05, first_flag_ok
    ok07 = and ok06, first_value_ok
    ok08 = and ok07, last_flag_ok
    ok09 = and ok08, last_value_ok
    ok10 = and ok09, alias_len_ok
    ok = and ok10, alias_ptr_ok

    !source_len
    !source_ptr
    !os_len
    !os_ptr
    !bytes_len
    !bytes_ptr
    !first_ok
    !first_byte
    !last_ok
    !last_byte
    !alias_len
    !alias_ptr
    !null_ptr
    !source_len_ok
    !source_ptr_ok
    !os_len_ok
    !os_ptr_ok
    !bytes_len_ok
    !bytes_ptr_ok
    !first_flag_ok
    !first_value_ok
    !last_flag_ok
    !last_value_ok
    !alias_len_ok
    !alias_ptr_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !bytes_alias
    !os_str_alias
    !bytes_again
    !os_str
    br ok -> L_OS_STR_OK, L_OS_STR_FAIL

L_OS_STR_FAIL:
    !ok
    panic(10179)

L_OS_STR_OK:
    !ok
    return

@test "sa_std os unix ffi OsString byte vec macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY bytes_vec, 4, 1
    EXPAND VEC_PUSH bytes_vec, 102, 1
    EXPAND VEC_PUSH bytes_vec, 111, 1
    EXPAND VEC_PUSH bytes_vec, 111, 1
    EXPAND VEC_PUSH bytes_vec, 255, 1
    EXPAND OS_STRING_FROM_VEC os_string, bytes_vec
    EXPAND OS_STRING_INTO_VEC roundtrip_vec, os_string
    EXPAND VEC_LEN roundtrip_len, roundtrip_vec
    EXPAND VEC_TRY_GET_TYPED_U8 first_ok, first_byte, roundtrip_vec, 0, 1
    EXPAND VEC_TRY_GET_TYPED_U8 last_ok, last_byte, roundtrip_vec, 3, 1

    EXPAND VEC_WITH_CAPACITY alias_vec, 1, 1
    EXPAND VEC_PUSH alias_vec, 120, 1
    EXPAND OS_STRING_FROM_VEC_U8 alias_os_string, alias_vec
    EXPAND OS_STRING_INTO_VEC_U8 alias_roundtrip_vec, alias_os_string
    EXPAND VEC_LEN alias_len, alias_roundtrip_vec
    EXPAND VEC_TRY_GET_TYPED_U8 alias_ok, alias_byte, alias_roundtrip_vec, 0, 1

    len_ok = eq roundtrip_len, 4
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first_byte, 102
    last_flag_ok = eq last_ok, 1
    last_value_ok = eq last_byte, 255
    alias_len_ok = eq alias_len, 1
    alias_flag_ok = eq alias_ok, 1
    alias_value_ok = eq alias_byte, 120

    ok01 = and len_ok, first_flag_ok
    ok02 = and ok01, first_value_ok
    ok03 = and ok02, last_flag_ok
    ok04 = and ok03, last_value_ok
    ok05 = and ok04, alias_len_ok
    ok06 = and ok05, alias_flag_ok
    ok = and ok06, alias_value_ok

    !roundtrip_len
    !first_ok
    !first_byte
    !last_ok
    !last_byte
    !alias_len
    !alias_ok
    !alias_byte
    !len_ok
    !first_flag_ok
    !first_value_ok
    !last_flag_ok
    !last_value_ok
    !alias_len_ok
    !alias_flag_ok
    !alias_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    EXPAND VEC_FREE alias_roundtrip_vec
    EXPAND VEC_FREE roundtrip_vec
    br ok -> L_OS_STRING_OK, L_OS_STRING_FAIL

L_OS_STRING_FAIL:
    !ok
    panic(10180)

L_OS_STRING_OK:
    !ok
    return

@test "sa_std os unix ffi OsString owned macros"():
L_ENTRY:
    hello = stack_alloc 5
    store hello+0, 104 as u8
    store hello+1, 101 as u8
    store hello+2, 108 as u8
    store hello+3, 108 as u8
    store hello+4, 111 as u8
    hello_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW hello_slice, hello, 5

    EXPAND OS_STRING_NEW empty
    EXPAND OS_STRING_IS_EMPTY empty0, empty
    empty0_ok = eq empty0, 1
    EXPAND OS_STRING_LEN len0, empty
    len0_ok = eq len0, 0

    EXPAND OS_STRING_FROM_STR owned, hello_slice
    EXPAND OS_STRING_LEN len1, owned
    len1_ok = eq len1, 5
    EXPAND OS_STRING_AS_OS_STR view1, owned
    EXPAND OS_STR_LEN vlen1, view1
    vlen1_ok = eq vlen1, 5
    EXPAND OS_STR_IS_EMPTY vis1, view1
    vis1_ok = eq vis1, 0

    bang = stack_alloc 1
    store bang+0, 33 as u8
    bang_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW bang_slice, bang, 1
    EXPAND OS_STRING_PUSH_STR owned, bang_slice
    EXPAND OS_STRING_LEN len2, owned
    len2_ok = eq len2, 6

    EXPAND OS_STRING_CLONE clone, owned
    EXPAND OS_STRING_LEN clen, clone
    clen_ok = eq clen, 6

    EXPAND OS_STRING_TO_STRING_CHECKED ok_utf8, sbuf, owned
    ok_utf8_ok = eq ok_utf8, 1
    EXPAND STRING_BUF_LEN sblen, sbuf
    sblen_ok = eq sblen, 6

    bad = stack_alloc 1
    store bad+0, 255 as u8
    bad_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW bad_slice, bad, 1
    EXPAND OS_STRING_FROM_STR bad_owned, bad_slice
    EXPAND OS_STR_FROM_BYTES bad_os_str, bad_slice
    EXPAND OS_STR_TO_STR_CHECKED bad_ok, bad_str, bad_os_str
    bad_ok_ok = eq bad_ok, 0
    EXPAND OS_STRING_TO_STRING_CHECKED bad_s_ok, bad_sbuf, bad_owned
    bad_s_ok_ok = eq bad_s_ok, 0

    EXPAND OS_STRING_FREE empty
    EXPAND OS_STRING_FREE owned
    EXPAND OS_STRING_FREE clone
    EXPAND OS_STRING_FREE bad_owned
    EXPAND STRING_BUF_FREE sbuf
    EXPAND STRING_BUF_FREE bad_sbuf
    !view1
    !bad_os_str
    !bad_str

    ok = and empty0_ok, len0_ok
    ok = and ok, len1_ok
    ok = and ok, vlen1_ok
    ok = and ok, vis1_ok
    ok = and ok, len2_ok
    ok = and ok, clen_ok
    ok = and ok, ok_utf8_ok
    ok = and ok, sblen_ok
    ok = and ok, bad_ok_ok
    ok = and ok, bad_s_ok_ok

    !empty0
    !len0
    !len1
    !vlen1
    !vis1
    !len2
    !clen
    !ok_utf8
    !sblen
    !bad_ok
    !bad_s_ok
    !empty0_ok
    !len0_ok
    !len1_ok
    !vlen1_ok
    !vis1_ok
    !len2_ok
    !clen_ok
    !ok_utf8_ok
    !sblen_ok
    !bad_ok_ok
    !bad_s_ok_ok
    br ok -> L_OS_STRING_OWNED_OK, L_OS_STRING_OWNED_FAIL

L_OS_STRING_OWNED_FAIL:
    !ok
    panic(10181)

L_OS_STRING_OWNED_OK:
    !ok
    return

@test "sa_std os OsString lit/capacity macros"():
L_ENTRY:
    a_bytes = stack_alloc 2
    store a_bytes+0, 97 as u8
    store a_bytes+1, 98 as u8
    a = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW a, a_bytes, 2

    b_bytes = stack_alloc 2
    store b_bytes+0, 99 as u8
    store b_bytes+1, 100 as u8
    b = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW b, b_bytes, 2

    c_bytes = stack_alloc 1
    store c_bytes+0, 101 as u8
    c = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW c, c_bytes, 1

    EXPAND OS_STRING_LIT1 lit1, a
    EXPAND OS_STRING_LEN lit1_len, lit1
    EXPAND OS_STRING_LIT2 lit2, a, b
    EXPAND OS_STRING_LEN lit2_len, lit2
    EXPAND OS_STRING_LIT3 lit3, a, b, c
    EXPAND OS_STRING_LEN lit3_len, lit3
    EXPAND OS_STRING_WITH_CAPACITY cap_os, 24
    EXPAND OS_STRING_CAPACITY cap0, cap_os
    EXPAND OS_STRING_CAPACITY_REMAINING rem0, cap_os
    EXPAND OS_STRING_EXTRA_CAPACITY extra0, cap_os
    EXPAND OS_STRING_REMAINING_CAPACITY rem1, cap_os

    ok_lit1 = eq lit1_len, 2
    ok_lit2 = eq lit2_len, 4
    ok_lit3 = eq lit3_len, 5
    ok_cap = uge cap0, 24
    ok_rem = eq rem0, cap0
    ok_extra = eq extra0, rem0
    ok_rem1 = eq rem1, rem0

    ok = and ok_lit1, ok_lit2
    ok = and ok, ok_lit3
    ok = and ok, ok_cap
    ok = and ok, ok_rem
    ok = and ok, ok_extra
    ok = and ok, ok_rem1

    !ok_lit1
    !ok_lit2
    !ok_lit3
    !ok_cap
    !ok_rem
    !ok_extra
    !ok_rem1
    !lit1_len
    !lit2_len
    !lit3_len
    !cap0
    !rem0
    !extra0
    !rem1
    EXPAND OS_STRING_FREE lit1
    EXPAND OS_STRING_FREE lit2
    EXPAND OS_STRING_FREE lit3
    EXPAND OS_STRING_FREE cap_os
    br ok -> L_OS_STRING_LIT_OK, L_OS_STRING_LIT_FAIL
L_OS_STRING_LIT_FAIL:
    !ok
    panic(10182)
L_OS_STRING_LIT_OK:
    !ok
    return

@test "sa_std os OsString to_string_lossy macros"():
L_ENTRY:
    a_bytes = stack_alloc 3
    store a_bytes+0, 97 as u8
    store a_bytes+1, 98 as u8
    store a_bytes+2, 99 as u8
    a = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW a, a_bytes, 3
    EXPAND OS_STRING_FROM_STR os, a
    EXPAND OS_STRING_TO_STRING_LOSSY lossy, os
    EXPAND STRING_BUF_LEN lossy_len, lossy
    EXPAND OS_STRING_AS_OS_STR os_str, os
    EXPAND OS_STR_TO_STRING_LOSSY lossy2, os_str
    EXPAND STRING_BUF_LEN lossy2_len, lossy2

    ok_len = eq lossy_len, 3
    ok_len2 = eq lossy2_len, 3
    ok = and ok_len, ok_len2

    !ok_len
    !ok_len2
    !lossy_len
    !lossy2_len
    EXPAND STRING_BUF_FREE lossy
    EXPAND STRING_BUF_FREE lossy2
    EXPAND OS_STRING_FREE os
    !os_str
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10183)
L_OK:
    !ok
    return

