@import "sa_std/num.sars"

[MACRO] TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ %out_acc, %prev_acc, %value, %expected
    __test_signed_overflowing_neg_shift_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_signed_overflowing_neg_shift_eq_%out_acc
    !__test_signed_overflowing_neg_shift_eq_%out_acc
[END_MACRO]

@test "sa_std signed primitive overflowing neg and shift macro surface"():
L_ENTRY:
    EXPAND NUM_I8_OVERFLOWING_NEG i8_neg_value, i8_neg_over, 2
    EXPAND NUM_I16_OVERFLOWING_NEG i16_neg_value, i16_neg_over, 2
    EXPAND NUM_I32_OVERFLOWING_NEG i32_neg_value, i32_neg_over, 2
    EXPAND NUM_I64_OVERFLOWING_NEG i64_neg_value, i64_neg_over, 2
    EXPAND NUM_ISIZE_OVERFLOWING_NEG isize_neg_value, isize_neg_over, 2

    EXPAND NUM_I8_OVERFLOWING_NEG i8_neg_min_value, i8_neg_min_over, NUM_I8_MIN
    EXPAND NUM_I16_OVERFLOWING_NEG i16_neg_min_value, i16_neg_min_over, NUM_I16_MIN
    EXPAND NUM_I32_OVERFLOWING_NEG i32_neg_min_value, i32_neg_min_over, NUM_I32_MIN
    EXPAND NUM_I64_OVERFLOWING_NEG i64_neg_min_value, i64_neg_min_over, NUM_I64_MIN
    EXPAND NUM_ISIZE_OVERFLOWING_NEG isize_neg_min_value, isize_neg_min_over, NUM_ISIZE_MIN

    EXPAND NUM_I8_OVERFLOWING_SHL i8_shl_value, i8_shl_over, 1, 4
    EXPAND NUM_I16_OVERFLOWING_SHL i16_shl_value, i16_shl_over, 1, 4
    EXPAND NUM_I32_OVERFLOWING_SHL i32_shl_value, i32_shl_over, 1, 4
    EXPAND NUM_I64_OVERFLOWING_SHL i64_shl_value, i64_shl_over, 1, 4
    EXPAND NUM_ISIZE_OVERFLOWING_SHL isize_shl_value, isize_shl_over, 1, 4

    EXPAND NUM_I8_OVERFLOWING_SHL i8_shl_wrap_value, i8_shl_wrap_over, 1, 12
    EXPAND NUM_I16_OVERFLOWING_SHL i16_shl_wrap_value, i16_shl_wrap_over, 1, 20
    EXPAND NUM_I32_OVERFLOWING_SHL i32_shl_wrap_value, i32_shl_wrap_over, 1, 36
    EXPAND NUM_I64_OVERFLOWING_SHL i64_shl_wrap_value, i64_shl_wrap_over, 1, 68
    EXPAND NUM_ISIZE_OVERFLOWING_SHL isize_shl_wrap_value, isize_shl_wrap_over, 1, 68

    EXPAND NUM_I8_OVERFLOWING_SHR i8_shr_value, i8_shr_over, 16, 4
    EXPAND NUM_I16_OVERFLOWING_SHR i16_shr_value, i16_shr_over, 16, 4
    EXPAND NUM_I32_OVERFLOWING_SHR i32_shr_value, i32_shr_over, 16, 4
    EXPAND NUM_I64_OVERFLOWING_SHR i64_shr_value, i64_shr_over, 16, 4
    EXPAND NUM_ISIZE_OVERFLOWING_SHR isize_shr_value, isize_shr_over, 16, 4

    EXPAND NUM_I8_OVERFLOWING_SHR i8_shr_wrap_value, i8_shr_wrap_over, 16, 12
    EXPAND NUM_I16_OVERFLOWING_SHR i16_shr_wrap_value, i16_shr_wrap_over, 16, 20
    EXPAND NUM_I32_OVERFLOWING_SHR i32_shr_wrap_value, i32_shr_wrap_over, 16, 36
    EXPAND NUM_I64_OVERFLOWING_SHR i64_shr_wrap_value, i64_shr_wrap_over, 16, 68
    EXPAND NUM_ISIZE_OVERFLOWING_SHR isize_shr_wrap_value, isize_shr_wrap_over, 16, 68
    EXPAND NUM_I8_OVERFLOWING_SHR i8_shr_neg_wrap_value, i8_shr_neg_wrap_over, -16, 10

    acc_00 = eq 0, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_01, acc_00, i8_neg_value, -2
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_02, acc_01, i8_neg_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_03, acc_02, i16_neg_value, -2
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_04, acc_03, i16_neg_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_05, acc_04, i32_neg_value, -2
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_06, acc_05, i32_neg_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_07, acc_06, i64_neg_value, -2
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_08, acc_07, i64_neg_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_09, acc_08, isize_neg_value, -2
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_10, acc_09, isize_neg_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_11, acc_10, i8_neg_min_value, NUM_I8_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_12, acc_11, i8_neg_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_13, acc_12, i16_neg_min_value, NUM_I16_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_14, acc_13, i16_neg_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_15, acc_14, i32_neg_min_value, NUM_I32_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_16, acc_15, i32_neg_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_17, acc_16, i64_neg_min_value, NUM_I64_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_18, acc_17, i64_neg_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_19, acc_18, isize_neg_min_value, NUM_ISIZE_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_20, acc_19, isize_neg_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_21, acc_20, i8_shl_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_22, acc_21, i8_shl_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_23, acc_22, i16_shl_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_24, acc_23, i16_shl_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_25, acc_24, i32_shl_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_26, acc_25, i32_shl_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_27, acc_26, i64_shl_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_28, acc_27, i64_shl_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_29, acc_28, isize_shl_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_30, acc_29, isize_shl_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_31, acc_30, i8_shl_wrap_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_32, acc_31, i8_shl_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_33, acc_32, i16_shl_wrap_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_34, acc_33, i16_shl_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_35, acc_34, i32_shl_wrap_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_36, acc_35, i32_shl_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_37, acc_36, i64_shl_wrap_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_38, acc_37, i64_shl_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_39, acc_38, isize_shl_wrap_value, 16
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_40, acc_39, isize_shl_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_41, acc_40, i8_shr_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_42, acc_41, i8_shr_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_43, acc_42, i16_shr_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_44, acc_43, i16_shr_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_45, acc_44, i32_shr_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_46, acc_45, i32_shr_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_47, acc_46, i64_shr_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_48, acc_47, i64_shr_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_49, acc_48, isize_shr_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_50, acc_49, isize_shr_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_51, acc_50, i8_shr_wrap_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_52, acc_51, i8_shr_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_53, acc_52, i16_shr_wrap_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_54, acc_53, i16_shr_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_55, acc_54, i32_shr_wrap_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_56, acc_55, i32_shr_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_57, acc_56, i64_shr_wrap_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_58, acc_57, i64_shr_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_59, acc_58, isize_shr_wrap_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_60, acc_59, isize_shr_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_61, acc_60, i8_shr_neg_wrap_value, -4
    EXPAND TEST_SIGNED_OVERFLOWING_NEG_SHIFT_EQ acc_62, acc_61, i8_shr_neg_wrap_over, 1
    br acc_62 -> L_PASS, L_FAIL

L_FAIL:
    !acc_62
    panic(10656)

L_PASS:
    !acc_62
    return 0
