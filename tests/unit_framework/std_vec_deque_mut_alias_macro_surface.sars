@import "sa_std/collections/vec_deque.sars"

@test "sa_std vec_deque get_mut and insert_mut aliases"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_GET_MUT get_mut_ok, get_mut_ptr, deque, 1
    store get_mut_ptr+0, 31 as u64

    EXPAND VEC_DEQUE_INSERT_MUT insert_mut_ok, insert_mut_ptr, deque, 1, 20
    store insert_mut_ptr+0, 21 as u64
    EXPAND VEC_DEQUE_GET_MUT_PTR get_mut_ptr_ok, get_mut_ptr_alias, deque, 0
    store get_mut_ptr_alias+0, 9 as u64
    EXPAND VEC_DEQUE_INSERT_MUT insert_miss_ok, insert_miss_ptr, deque, 9, 99
    EXPAND VEC_DEQUE_GET_MUT get_miss_ok, get_miss_ptr, deque, 9

    EXPAND VEC_DEQUE_LEN len, deque
    EXPAND VEC_DEQUE_TRY_GET v0_ok, v0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET v1_ok, v1, deque, 1
    EXPAND VEC_DEQUE_TRY_GET v2_ok, v2, deque, 2
    null_ptr = 0 as ptr

    ok_get_mut = eq get_mut_ok, 1
    ok_insert_mut = eq insert_mut_ok, 1
    ok_get_mut_ptr = eq get_mut_ptr_ok, 1
    ok_insert_miss = eq insert_miss_ok, 0
    ok_insert_miss_ptr = eq insert_miss_ptr, null_ptr
    ok_get_miss = eq get_miss_ok, 0
    ok_get_miss_ptr = eq get_miss_ptr, null_ptr
    ok_len = eq len, 3
    ok_v0_flag = eq v0_ok, 1
    ok_v0 = eq v0, 9
    ok_v1_flag = eq v1_ok, 1
    ok_v1 = eq v1, 21
    ok_v2_flag = eq v2_ok, 1
    ok_v2 = eq v2, 31

    ok = and ok_get_mut, ok_insert_mut
    ok = and ok, ok_get_mut_ptr
    ok = and ok, ok_insert_miss
    ok = and ok, ok_insert_miss_ptr
    ok = and ok, ok_get_miss
    ok = and ok, ok_get_miss_ptr
    ok = and ok, ok_len
    ok = and ok, ok_v0_flag
    ok = and ok, ok_v0
    ok = and ok, ok_v1_flag
    ok = and ok, ok_v1
    ok = and ok, ok_v2_flag
    ok = and ok, ok_v2

    EXPAND VEC_DEQUE_FREE deque
    !get_mut_ok
    !get_mut_ptr
    !insert_mut_ok
    !insert_mut_ptr
    !get_mut_ptr_ok
    !get_mut_ptr_alias
    !insert_miss_ok
    !insert_miss_ptr
    !get_miss_ok
    !get_miss_ptr
    !len
    !v0_ok
    !v0
    !v1_ok
    !v1
    !v2_ok
    !v2
    !null_ptr
    !ok_get_mut
    !ok_insert_mut
    !ok_get_mut_ptr
    !ok_insert_miss
    !ok_insert_miss_ptr
    !ok_get_miss
    !ok_get_miss_ptr
    !ok_len
    !ok_v0_flag
    !ok_v0
    !ok_v1_flag
    !ok_v1
    !ok_v2_flag
    !ok_v2
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10700)

L_OK:
    !ok
    return
