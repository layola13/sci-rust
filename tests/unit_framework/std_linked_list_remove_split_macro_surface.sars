@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list remove and split_off"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 10
    EXPAND LINKED_LIST_PUSH_BACK list, 20
    EXPAND LINKED_LIST_PUSH_BACK list, 30
    EXPAND LINKED_LIST_PUSH_BACK list, 40
    EXPAND LINKED_LIST_TRY_REMOVE rem_ok, rem_val, list, 1
    EXPAND LINKED_LIST_LEN len3, list
    EXPAND LINKED_LIST_CONTAINS has_20, list, 20
    EXPAND LINKED_LIST_CONTAINS has_30, list, 30
    EXPAND LINKED_LIST_TRY_REMOVE oob_ok, oob_val, list, 9
    EXPAND LINKED_LIST_SPLIT_OFF tail, list, 1
    EXPAND LINKED_LIST_LEN head_len, list
    EXPAND LINKED_LIST_LEN tail_len, tail
    EXPAND LINKED_LIST_TRY_FRONT head_front_ok, head_front, list
    EXPAND LINKED_LIST_TRY_FRONT tail_front_ok, tail_front, tail
    EXPAND LINKED_LIST_TRY_BACK tail_back_ok, tail_back, tail
    EXPAND LINKED_LIST_FREE list
    EXPAND LINKED_LIST_FREE tail

    ok_rem = eq rem_ok, 1
    ok_rem_val = eq rem_val, 20
    ok_len3 = eq len3, 3
    ok_no_20 = eq has_20, 0
    ok_has_30 = eq has_30, 1
    ok_oob = eq oob_ok, 0
    ok_head_len = eq head_len, 1
    ok_tail_len = eq tail_len, 2
    ok_hf = eq head_front_ok, 1
    ok_hf_v = eq head_front, 10
    ok_tf = eq tail_front_ok, 1
    ok_tf_v = eq tail_front, 30
    ok_tb = eq tail_back_ok, 1
    ok_tb_v = eq tail_back, 40

    ok01 = and ok_rem, ok_rem_val
    ok02 = and ok01, ok_len3
    ok03 = and ok02, ok_no_20
    ok04 = and ok03, ok_has_30
    ok05 = and ok04, ok_oob
    ok06 = and ok05, ok_head_len
    ok07 = and ok06, ok_tail_len
    ok08 = and ok07, ok_hf
    ok09 = and ok08, ok_hf_v
    ok10 = and ok09, ok_tf
    ok11 = and ok10, ok_tf_v
    ok12 = and ok11, ok_tb
    ok = and ok12, ok_tb_v

    !rem_ok
    !rem_val
    !len3
    !has_20
    !has_30
    !oob_ok
    !oob_val
    !head_len
    !tail_len
    !head_front_ok
    !head_front
    !tail_front_ok
    !tail_front
    !tail_back_ok
    !tail_back
    !ok_rem
    !ok_rem_val
    !ok_len3
    !ok_no_20
    !ok_has_30
    !ok_oob
    !ok_head_len
    !ok_tail_len
    !ok_hf
    !ok_hf_v
    !ok_tf
    !ok_tf_v
    !ok_tb
    !ok_tb_v
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10869)
