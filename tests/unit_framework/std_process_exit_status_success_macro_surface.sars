@import "sa_std/process.sars"
@import "sa_std/process.sal"

@test "sa_std process exit_status success"():
L_ENTRY:
    st = stack_alloc ProcessExitStatus_SIZE
    st2 = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_EXIT_STATUS_NEW st, 0
    EXPAND PROCESS_EXIT_STATUS_SUCCESS ok0, st
    EXPAND PROCESS_EXIT_STATUS_NEW st2, 1
    EXPAND PROCESS_EXIT_STATUS_SUCCESS ok1, st2
    a = eq ok0, 1
    b = eq ok1, 0
    ok = and a, b
    !ok0
    !ok1
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10997)
