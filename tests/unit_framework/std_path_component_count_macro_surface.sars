@import "sa_std/path.sars"
@import "sa_std/string.sars"

@const P = utf8:"a/b/c"

@test "sa_std path component_count"():
L_ENTRY:
    EXPAND STR_FROM_PARTS path, &P, 5
    EXPAND PATH_COMPONENT_COUNT n, path
    ok = eq n, 3
    !n
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10981)
