@import "sa_std/sync/rwlock.sars"

@test "sa_std sync rwlock noerr state macros"():
L_ENTRY:
    EXPAND RWLOCK_NEW lock
    EXPAND RWLOCK_IS_UNLOCKED unlocked0, lock
    EXPAND RWLOCK_READER_COUNT readers0, lock
    EXPAND RWLOCK_TRY_READ_NOERR read0_ok, read0_guard, lock
    EXPAND RWLOCK_READER_COUNT readers1, lock
    EXPAND RWLOCK_TRY_READ_NOERR read1_ok, read1_guard, lock
    EXPAND RWLOCK_READER_COUNT readers2, lock
    EXPAND RWLOCK_TRY_WRITE_NOERR write0_ok, write0_guard, lock
    EXPAND RWLOCK_RELEASE_READ lock
    EXPAND RWLOCK_READER_COUNT readers3, lock
    EXPAND RWLOCK_RELEASE_READ lock
    EXPAND RWLOCK_IS_UNLOCKED unlocked1, lock
    EXPAND RWLOCK_TRY_WRITE_NOERR write1_ok, write1_guard, lock
    EXPAND RWLOCK_IS_WRITING writing1, lock
    EXPAND RWLOCK_TRY_READ_NOERR read_while_write_ok, read_while_write_guard, lock
    EXPAND RWLOCK_RELEASE_WRITE lock
    EXPAND RWLOCK_IS_UNLOCKED unlocked2, lock
    EXPAND RWLOCK_TRY_WRITE_NOERR write2_ok, write2_guard, lock
    EXPAND RWLOCK_FORCE_UNLOCKED lock
    EXPAND RWLOCK_IS_UNLOCKED unlocked3, lock

    read0_guard_eq = eq read0_guard, lock
    read1_guard_eq = eq read1_guard, lock
    write0_guard_null = eq write0_guard, 0
    write1_guard_eq = eq write1_guard, lock
    read_while_write_null = eq read_while_write_guard, 0
    write2_guard_eq = eq write2_guard, lock

    ok_readers0 = eq readers0, 0
    ok_read0 = eq read0_ok, 1
    ok_readers1 = eq readers1, 1
    ok_read1 = eq read1_ok, 1
    ok_readers2 = eq readers2, 2
    ok_write0 = eq write0_ok, 0
    ok_readers3 = eq readers3, 1
    ok_write1 = eq write1_ok, 1
    ok_read_while_write = eq read_while_write_ok, 0
    ok_write2 = eq write2_ok, 1

    ok01 = and unlocked0, ok_readers0
    ok02 = and ok01, ok_read0
    ok03 = and ok02, read0_guard_eq
    ok04 = and ok03, ok_readers1
    ok05 = and ok04, ok_read1
    ok06 = and ok05, read1_guard_eq
    ok07 = and ok06, ok_readers2
    ok08 = and ok07, ok_write0
    ok09 = and ok08, write0_guard_null
    ok10 = and ok09, ok_readers3
    ok11 = and ok10, unlocked1
    ok12 = and ok11, ok_write1
    ok13 = and ok12, write1_guard_eq
    ok14 = and ok13, writing1
    ok15 = and ok14, ok_read_while_write
    ok16 = and ok15, read_while_write_null
    ok17 = and ok16, unlocked2
    ok18 = and ok17, ok_write2
    ok19 = and ok18, write2_guard_eq
    ok = and ok19, unlocked3

    !lock
    !unlocked0
    !readers0
    !read0_ok
    !read0_guard
    !readers1
    !read1_ok
    !read1_guard
    !readers2
    !write0_ok
    !write0_guard
    !readers3
    !unlocked1
    !write1_ok
    !write1_guard
    !writing1
    !read_while_write_ok
    !read_while_write_guard
    !unlocked2
    !write2_ok
    !write2_guard
    !unlocked3
    !read0_guard_eq
    !read1_guard_eq
    !write0_guard_null
    !write1_guard_eq
    !read_while_write_null
    !write2_guard_eq
    !ok_readers0
    !ok_read0
    !ok_readers1
    !ok_read1
    !ok_readers2
    !ok_write0
    !ok_readers3
    !ok_write1
    !ok_read_while_write
    !ok_write2
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10218)

L_PASS:
    !ok
    return 0

@test "sa_std sync rwlock default alias"():
L_ENTRY:
    EXPAND RWLOCK_DEFAULT lock
    EXPAND RWLOCK_IS_UNLOCKED unlocked0, lock
    EXPAND RWLOCK_TRY_WRITE_NOERR write_ok, write_guard, lock
    EXPAND RWLOCK_IS_WRITING writing1, lock
    EXPAND RWLOCK_RELEASE_WRITE lock
    EXPAND RWLOCK_IS_UNLOCKED unlocked1, lock

    ok0 = eq unlocked0, 1
    ok1 = eq write_ok, 1
    ok2 = eq writing1, 1
    ok3 = eq unlocked1, 1
    write_guard_eq = eq write_guard, lock
    ok01 = and ok0, ok1
    ok02 = and ok01, ok2
    ok03 = and ok02, ok3
    ok = and ok03, write_guard_eq

    !unlocked0
    !write_ok
    !write_guard
    !writing1
    !unlocked1
    !write_guard_eq
    !ok0
    !ok1
    !ok2
    !ok3
    !ok01
    !ok02
    !ok03
    !lock
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10420)
L_OK:
    !ok
    return
