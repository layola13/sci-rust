@import "sa_std/collections/btree_map.sars"
@import "sa_std/collections/btree_set.sars"
@import "sa_std/core/slice.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"

@test "sa_std btree hash_one bare alias macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, charlie, 30
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, bravo, 20

    EXPAND BTREE_MAP_HASH_STR_U64 map_typed_hash, map
    EXPAND BTREE_MAP_HASH map_bare_hash, map
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_BTREE_MAP_STR_U64 map_build_typed, builder, map
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_BTREE_MAP map_build_bare, builder, map

    state = stack_alloc RandomState_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_BTREE_MAP_STR_U64 map_state_typed, state, map
    EXPAND RANDOM_STATE_HASH_ONE_BTREE_MAP map_state_bare, state, map

    EXPAND BTREE_SET_NEW set
    EXPAND BTREE_SET_INSERT set_ins_c, set, charlie
    EXPAND BTREE_SET_INSERT set_ins_a, set, alpha
    EXPAND BTREE_SET_INSERT set_ins_b, set, bravo

    EXPAND BTREE_SET_HASH_STR set_typed_hash, set
    EXPAND BTREE_SET_HASH set_bare_hash, set
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_BTREE_SET_STR set_build_typed, builder, set
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_BTREE_SET set_build_bare, builder, set
    EXPAND RANDOM_STATE_HASH_ONE_BTREE_SET_STR set_state_typed, state, set
    EXPAND RANDOM_STATE_HASH_ONE_BTREE_SET set_state_bare, state, set

    map_hash_matches = eq map_bare_hash, map_typed_hash
    map_build_matches = eq map_build_bare, map_build_typed
    map_state_matches = eq map_state_bare, map_state_typed
    map_build_eq_typed_hash = eq map_build_typed, map_typed_hash
    map_state_differs = ne map_state_typed, map_typed_hash

    set_inserts_1 = and set_ins_c, set_ins_a
    set_inserts_ok = and set_inserts_1, set_ins_b
    set_hash_matches = eq set_bare_hash, set_typed_hash
    set_build_matches = eq set_build_bare, set_build_typed
    set_state_matches = eq set_state_bare, set_state_typed
    set_build_eq_typed_hash = eq set_build_typed, set_typed_hash
    set_state_differs = ne set_state_typed, set_typed_hash
    map_set_distinct = ne map_typed_hash, set_typed_hash

    ok01 = and map_hash_matches, map_build_matches
    ok02 = and ok01, map_state_matches
    ok03 = and ok02, map_build_eq_typed_hash
    ok04 = and ok03, map_state_differs
    ok05 = and ok04, set_inserts_ok
    ok06 = and ok05, set_hash_matches
    ok07 = and ok06, set_build_matches
    ok08 = and ok07, set_state_matches
    ok09 = and ok08, set_build_eq_typed_hash
    ok10 = and ok09, set_state_differs
    ok = and ok10, map_set_distinct

    !map_typed_hash
    !map_bare_hash
    !map_build_typed
    !map_build_bare
    !map_state_typed
    !map_state_bare
    !set_ins_c
    !set_ins_a
    !set_ins_b
    !set_typed_hash
    !set_bare_hash
    !set_build_typed
    !set_build_bare
    !set_state_typed
    !set_state_bare
    !map_hash_matches
    !map_build_matches
    !map_state_matches
    !map_build_eq_typed_hash
    !map_state_differs
    !set_inserts_1
    !set_inserts_ok
    !set_hash_matches
    !set_build_matches
    !set_state_matches
    !set_build_eq_typed_hash
    !set_state_differs
    !map_set_distinct
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_SET_FREE set
    EXPAND BTREE_MAP_FREE map
    return 0

L_FAIL:
    panic(10850)
