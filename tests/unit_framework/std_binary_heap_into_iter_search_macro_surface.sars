@import "sa_std/collections/binary_heap.sars"

@binary_heap_into_iter_search_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@binary_heap_into_iter_search_lt_four(value: u64) -> u64:
L_ENTRY:
    is_lt = ult value, 4
    !value
    return is_lt

@binary_heap_into_iter_try_find_even_lt_ten(value: u64, &out_match: ptr) -> u64:
L_ENTRY:
    too_large = uge value, 10
    keep = eq too_large, 0
    br keep -> L_BINARY_HEAP_INTO_ITER_TRY_FIND_EVEN_CHECK, L_BINARY_HEAP_INTO_ITER_TRY_FIND_EVEN_STOP
L_BINARY_HEAP_INTO_ITER_TRY_FIND_EVEN_CHECK:
    rem = urem value, 2
    is_even = eq rem, 0
    store out_match+0, is_even as u64
    !is_even
    !rem
    !keep
    !too_large
    !out_match
    !value
    return 1
L_BINARY_HEAP_INTO_ITER_TRY_FIND_EVEN_STOP:
    !keep
    !too_large
    !out_match
    !value
    return 0

@binary_heap_into_iter_try_find_fail_on_four(value: u64, &out_match: ptr) -> u64:
L_ENTRY:
    is_four = eq value, 4
    keep = eq is_four, 0
    br keep -> L_BINARY_HEAP_INTO_ITER_TRY_FIND_FAIL_CHECK, L_BINARY_HEAP_INTO_ITER_TRY_FIND_FAIL_STOP
L_BINARY_HEAP_INTO_ITER_TRY_FIND_FAIL_CHECK:
    store out_match+0, 0 as u64
    !keep
    !is_four
    !out_match
    !value
    return 1
L_BINARY_HEAP_INTO_ITER_TRY_FIND_FAIL_STOP:
    !keep
    !is_four
    !out_match
    !value
    return 0

@binary_heap_into_iter_find_map_even_tens(value: u64, &out_value: ptr) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    br is_even -> L_BINARY_HEAP_INTO_ITER_FIND_MAP_EVEN, L_BINARY_HEAP_INTO_ITER_FIND_MAP_SKIP
L_BINARY_HEAP_INTO_ITER_FIND_MAP_EVEN:
    mapped = mul value, 10
    store out_value+0, mapped as u64
    !mapped
    !is_even
    !rem
    !out_value
    !value
    return 1
L_BINARY_HEAP_INTO_ITER_FIND_MAP_SKIP:
    !is_even
    !rem
    !out_value
    !value
    return 0

@test "sa_std binary_heap into_iter search macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW find_heap
    EXPAND BINARY_HEAP_PUSH_U64 find_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 find_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 find_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 find_iter, find_backing, find_heap
    EXPAND BINARY_HEAP_INTO_ITER_FIND_U64 find_has, find_value, find_iter, @binary_heap_into_iter_search_is_even
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 find_remaining, find_iter
    EXPAND VEC_LEN find_backing_len, find_backing

    EXPAND BINARY_HEAP_NEW find_none_heap
    EXPAND BINARY_HEAP_PUSH_U64 find_none_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 find_none_heap, 7
    EXPAND BINARY_HEAP_INTO_ITER_U64 find_none_iter, find_none_backing, find_none_heap
    EXPAND BINARY_HEAP_INTO_ITER_FIND_U64 find_none_has, find_none_value, find_none_iter, @binary_heap_into_iter_search_is_even
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 find_none_empty, find_none_iter

    EXPAND BINARY_HEAP_NEW try_success_heap
    EXPAND BINARY_HEAP_PUSH_U64 try_success_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 try_success_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 try_success_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 try_success_iter, try_success_backing, try_success_heap
    EXPAND BINARY_HEAP_INTO_ITER_TRY_FIND_U64 try_success_ok, try_success_has, try_success_value, try_success_iter, @binary_heap_into_iter_try_find_even_lt_ten
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 try_success_remaining, try_success_iter

    EXPAND BINARY_HEAP_NEW try_fail_heap
    EXPAND BINARY_HEAP_PUSH_U64 try_fail_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 try_fail_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 try_fail_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 try_fail_iter, try_fail_backing, try_fail_heap
    EXPAND BINARY_HEAP_INTO_ITER_TRY_FIND_U64 try_fail_ok, try_fail_has, try_fail_value, try_fail_iter, @binary_heap_into_iter_try_find_fail_on_four
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 try_fail_remaining, try_fail_iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 try_fail_next_has, try_fail_next, try_fail_iter

    EXPAND BINARY_HEAP_NEW map_heap
    EXPAND BINARY_HEAP_PUSH_U64 map_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 map_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 map_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 map_iter, map_backing, map_heap
    EXPAND BINARY_HEAP_INTO_ITER_FIND_MAP_U64 map_has, map_value, map_iter, @binary_heap_into_iter_find_map_even_tens
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 map_remaining, map_iter

    EXPAND BINARY_HEAP_NEW position_heap
    EXPAND BINARY_HEAP_PUSH_U64 position_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 position_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 position_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 position_iter, position_backing, position_heap
    EXPAND BINARY_HEAP_INTO_ITER_POSITION_U64 position_has, position_index, position_iter, @binary_heap_into_iter_search_is_even
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 position_remaining, position_iter

    EXPAND BINARY_HEAP_NEW rposition_heap
    EXPAND BINARY_HEAP_PUSH_U64 rposition_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 rposition_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 rposition_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 rposition_iter, rposition_backing, rposition_heap
    EXPAND BINARY_HEAP_INTO_ITER_RPOSITION_U64 rposition_has, rposition_index, rposition_iter, @binary_heap_into_iter_search_is_even
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 rposition_remaining, rposition_iter

    EXPAND BINARY_HEAP_NEW rfind_heap
    EXPAND BINARY_HEAP_PUSH_U64 rfind_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 rfind_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 rfind_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 rfind_iter, rfind_backing, rfind_heap
    EXPAND BINARY_HEAP_INTO_ITER_RFIND_U64 rfind_has, rfind_value, rfind_iter, @binary_heap_into_iter_search_lt_four
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 rfind_remaining, rfind_iter

    EXPAND VEC_FREE find_backing
    EXPAND VEC_FREE find_none_backing
    EXPAND VEC_FREE try_success_backing
    EXPAND VEC_FREE try_fail_backing
    EXPAND VEC_FREE map_backing
    EXPAND VEC_FREE position_backing
    EXPAND VEC_FREE rposition_backing
    EXPAND VEC_FREE rfind_backing

    ok_find_has = eq find_has, 1
    ok_find_value = eq find_value, 4
    ok_find_remaining = eq find_remaining, 1
    ok_find_backing_len = eq find_backing_len, 3
    ok_find_none_has = eq find_none_has, 0
    ok_find_none_value = eq find_none_value, 0
    ok_find_none_empty = eq find_none_empty, 1
    ok_try_success_ok = eq try_success_ok, 1
    ok_try_success_has = eq try_success_has, 1
    ok_try_success_value = eq try_success_value, 4
    ok_try_success_remaining = eq try_success_remaining, 1
    ok_try_fail_ok = eq try_fail_ok, 0
    ok_try_fail_has = eq try_fail_has, 0
    ok_try_fail_value = eq try_fail_value, 0
    ok_try_fail_remaining = eq try_fail_remaining, 1
    ok_try_fail_next_has = eq try_fail_next_has, 1
    ok_try_fail_next = eq try_fail_next, 1
    ok_map_has = eq map_has, 1
    ok_map_value = eq map_value, 40
    ok_map_remaining = eq map_remaining, 1
    ok_position_has = eq position_has, 1
    ok_position_index = eq position_index, 1
    ok_position_remaining = eq position_remaining, 1
    ok_rposition_has = eq rposition_has, 1
    ok_rposition_index = eq rposition_index, 1
    ok_rposition_remaining = eq rposition_remaining, 1
    ok_rfind_has = eq rfind_has, 1
    ok_rfind_value = eq rfind_value, 1
    ok_rfind_remaining = eq rfind_remaining, 2

    ok = and ok_find_has, ok_find_value
    ok = and ok, ok_find_remaining
    ok = and ok, ok_find_backing_len
    ok = and ok, ok_find_none_has
    ok = and ok, ok_find_none_value
    ok = and ok, ok_find_none_empty
    ok = and ok, ok_try_success_ok
    ok = and ok, ok_try_success_has
    ok = and ok, ok_try_success_value
    ok = and ok, ok_try_success_remaining
    ok = and ok, ok_try_fail_ok
    ok = and ok, ok_try_fail_has
    ok = and ok, ok_try_fail_value
    ok = and ok, ok_try_fail_remaining
    ok = and ok, ok_try_fail_next_has
    ok = and ok, ok_try_fail_next
    ok = and ok, ok_map_has
    ok = and ok, ok_map_value
    ok = and ok, ok_map_remaining
    ok = and ok, ok_position_has
    ok = and ok, ok_position_index
    ok = and ok, ok_position_remaining
    ok = and ok, ok_rposition_has
    ok = and ok, ok_rposition_index
    ok = and ok, ok_rposition_remaining
    ok = and ok, ok_rfind_has
    ok = and ok, ok_rfind_value
    ok = and ok, ok_rfind_remaining

    !find_has
    !find_value
    !find_remaining
    !find_backing_len
    !find_none_has
    !find_none_value
    !find_none_empty
    !try_success_ok
    !try_success_has
    !try_success_value
    !try_success_remaining
    !try_fail_ok
    !try_fail_has
    !try_fail_value
    !try_fail_remaining
    !try_fail_next_has
    !try_fail_next
    !map_has
    !map_value
    !map_remaining
    !position_has
    !position_index
    !position_remaining
    !rposition_has
    !rposition_index
    !rposition_remaining
    !rfind_has
    !rfind_value
    !rfind_remaining
    !ok_find_has
    !ok_find_value
    !ok_find_remaining
    !ok_find_backing_len
    !ok_find_none_has
    !ok_find_none_value
    !ok_find_none_empty
    !ok_try_success_ok
    !ok_try_success_has
    !ok_try_success_value
    !ok_try_success_remaining
    !ok_try_fail_ok
    !ok_try_fail_has
    !ok_try_fail_value
    !ok_try_fail_remaining
    !ok_try_fail_next_has
    !ok_try_fail_next
    !ok_map_has
    !ok_map_value
    !ok_map_remaining
    !ok_position_has
    !ok_position_index
    !ok_position_remaining
    !ok_rposition_has
    !ok_rposition_index
    !ok_rposition_remaining
    !ok_rfind_has
    !ok_rfind_value
    !ok_rfind_remaining
    !find_iter
    !find_none_iter
    !try_success_iter
    !try_fail_iter
    !map_iter
    !position_iter
    !rposition_iter
    !rfind_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_SEARCH_OK, L_BINARY_HEAP_INTO_ITER_SEARCH_FAIL

L_BINARY_HEAP_INTO_ITER_SEARCH_FAIL:
    !ok
    panic(10769)

L_BINARY_HEAP_INTO_ITER_SEARCH_OK:
    !ok
    return
