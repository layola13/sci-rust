@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap peek_mut alias"():
L_ENTRY:
    EXPAND BINARY_HEAP_WITH_CAPACITY heap, 4
    EXPAND BINARY_HEAP_PUSH heap, 1
    EXPAND BINARY_HEAP_PUSH heap, 5
    EXPAND BINARY_HEAP_PUSH heap, 3

    EXPAND BINARY_HEAP_PEEK_MUT peek_mut_ok, peek_mut_ptr, heap
    store peek_mut_ptr+0, 9 as u64
    EXPAND BINARY_HEAP_PEEK peek_after, heap
    EXPAND BINARY_HEAP_LEN len_after, heap

    EXPAND BINARY_HEAP_CLEAR heap
    EXPAND BINARY_HEAP_PEEK_MUT empty_ok, empty_ptr, heap
    EXPAND BINARY_HEAP_FREE heap

    null_ptr = 0 as ptr
    ok_peek_mut = eq peek_mut_ok, 1
    ok_peek_after = eq peek_after, 9
    ok_len = eq len_after, 3
    ok_empty = eq empty_ok, 0
    ok_empty_ptr = eq empty_ptr, null_ptr

    ok01 = and ok_peek_mut, ok_peek_after
    ok02 = and ok01, ok_len
    ok03 = and ok02, ok_empty
    ok = and ok03, ok_empty_ptr

    !peek_mut_ok
    !peek_mut_ptr
    !peek_after
    !len_after
    !empty_ok
    !empty_ptr
    !null_ptr
    !ok_peek_mut
    !ok_peek_after
    !ok_len
    !ok_empty
    !ok_empty_ptr
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10829)

L_OK:
    !ok
    return
