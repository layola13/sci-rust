@import "sa_std/num.sars"

[MACRO] TEST_DISJOINT_BITOR_EQ %out_acc, %prev_acc, %value, %expected
    __test_disjoint_bitor_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_disjoint_bitor_eq_%out_acc
    !__test_disjoint_bitor_eq_%out_acc
[END_MACRO]

@test "sa_std unsigned primitive unchecked_disjoint_bitor macro surface"():
L_ENTRY:
    EXPAND NUM_U8_UNCHECKED_DISJOINT_BITOR u8_value, 1, 4
    EXPAND NUM_U16_UNCHECKED_DISJOINT_BITOR u16_value, 1, 4
    EXPAND NUM_U32_UNCHECKED_DISJOINT_BITOR u32_value, 1, 4
    EXPAND NUM_U64_UNCHECKED_DISJOINT_BITOR u64_value, 1, 4
    EXPAND NUM_USIZE_UNCHECKED_DISJOINT_BITOR usize_value, 1, 4

    EXPAND NUM_U8_UNCHECKED_DISJOINT_BITOR u8_high, 128, 1
    EXPAND NUM_U16_UNCHECKED_DISJOINT_BITOR u16_high, 32768, 1
    EXPAND NUM_U32_UNCHECKED_DISJOINT_BITOR u32_high, 2147483648, 1
    EXPAND NUM_U64_UNCHECKED_DISJOINT_BITOR u64_high, NUM_I64_MIN, 1
    EXPAND NUM_USIZE_UNCHECKED_DISJOINT_BITOR usize_high, NUM_I64_MIN, 1

    EXPAND NUM_U64_UNCHECKED_DISJOINT_BITOR zero_lhs, 0, 12345
    EXPAND NUM_U64_UNCHECKED_DISJOINT_BITOR zero_rhs, 12345, 0
    EXPAND NUM_U8_UNCHECKED_DISJOINT_BITOR u8_truncated, 256, 1

    acc_00 = eq 0, 0
    EXPAND TEST_DISJOINT_BITOR_EQ acc_01, acc_00, u8_value, 5
    EXPAND TEST_DISJOINT_BITOR_EQ acc_02, acc_01, u16_value, 5
    EXPAND TEST_DISJOINT_BITOR_EQ acc_03, acc_02, u32_value, 5
    EXPAND TEST_DISJOINT_BITOR_EQ acc_04, acc_03, u64_value, 5
    EXPAND TEST_DISJOINT_BITOR_EQ acc_05, acc_04, usize_value, 5
    EXPAND TEST_DISJOINT_BITOR_EQ acc_06, acc_05, u8_high, 129
    EXPAND TEST_DISJOINT_BITOR_EQ acc_07, acc_06, u16_high, 32769
    EXPAND TEST_DISJOINT_BITOR_EQ acc_08, acc_07, u32_high, 2147483649
    EXPAND TEST_DISJOINT_BITOR_EQ acc_09, acc_08, u64_high, 9223372036854775809
    EXPAND TEST_DISJOINT_BITOR_EQ acc_10, acc_09, usize_high, 9223372036854775809
    EXPAND TEST_DISJOINT_BITOR_EQ acc_11, acc_10, zero_lhs, 12345
    EXPAND TEST_DISJOINT_BITOR_EQ acc_12, acc_11, zero_rhs, 12345
    EXPAND TEST_DISJOINT_BITOR_EQ acc_13, acc_12, u8_truncated, 1
    br acc_13 -> L_PASS, L_FAIL

L_FAIL:
    !acc_13
    panic(10649)

L_PASS:
    !acc_13
    return 0
