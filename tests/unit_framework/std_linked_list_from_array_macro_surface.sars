@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list from_array"():
L_ENTRY:
    buf = alloc 24
    store buf+0, 5 as u64
    store buf+8, 6 as u64
    store buf+16, 7 as u64
    EXPAND LINKED_LIST_FROM_ARRAY list, buf, 3
    EXPAND LINKED_LIST_LEN len, list
    EXPAND LINKED_LIST_TRY_FRONT f_ok, f, list
    EXPAND LINKED_LIST_TRY_BACK b_ok, b, list
    EXPAND LINKED_LIST_FREE list
    a = eq len, 3
    b1 = eq f_ok, 1
    c = eq f, 5
    d = eq b_ok, 1
    e = eq b, 7
    ok01 = and a, b1
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok = and ok03, e
    !len
    !f_ok
    !f
    !b_ok
    !b
    !a
    !b1
    !c
    !d
    !e
    !ok01
    !ok02
    !ok03
    !buf
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10892)
