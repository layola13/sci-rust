    !empty_iter
    br ok -> L_VEC_INTO_ITER_SEARCH_OK, L_VEC_INTO_ITER_SEARCH_FAIL

L_VEC_INTO_ITER_SEARCH_FAIL:
    !ok
    panic(10715)

L_VEC_INTO_ITER_SEARCH_OK:
    !ok
    return
