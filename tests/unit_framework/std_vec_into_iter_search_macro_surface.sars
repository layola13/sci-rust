@import "sa_std/vec.sars"

@vec_into_iter_search_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    !value
    return out

@vec_into_iter_search_lt_four(value: u64) -> u64:
L_ENTRY:
    out = ult value, 4
    !value
    return out

@vec_into_iter_search_gt_four(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 4
    !value
    return out

@vec_into_iter_try_find_even_lt_ten(value: u64, &out_match: ptr) -> u64:
L_ENTRY:
    keep = ult value, 10
    br keep -> L_VEC_TRY_FIND_EVEN_CHECK, L_VEC_TRY_FIND_EVEN_STOP
L_VEC_TRY_FIND_EVEN_CHECK:
    rem = urem value, 2
    matched = eq rem, 0
    store out_match+0, matched as u64
    !matched
    !rem
    !out_match
    !value
    return keep
L_VEC_TRY_FIND_EVEN_STOP:
    !out_match
    !value
    return keep

@vec_into_iter_try_find_nine_before_four(value: u64, &out_match: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_VEC_TRY_FIND_NINE_CHECK, L_VEC_TRY_FIND_NINE_STOP
L_VEC_TRY_FIND_NINE_CHECK:
    matched = eq value, 9
    store out_match+0, matched as u64
    !matched
    !out_match
    !value
    return keep
L_VEC_TRY_FIND_NINE_STOP:
    !out_match
    !value
    return keep

@vec_into_iter_find_map_even_tens(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    br is_even -> L_VEC_FIND_MAP_EVEN, L_VEC_FIND_MAP_SKIP
L_VEC_FIND_MAP_EVEN:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !is_even
    !rem
    !out_mapped
    !value
    return 1
L_VEC_FIND_MAP_SKIP:
    !is_even
    !rem
    !out_mapped
    !value
    return 0

@test "sa_std vec into_iter search and predicate macro surface"():
L_ENTRY:
    EXPAND VEC_NEW find_vec
    EXPAND VEC_PUSH_U64 find_vec, 1
    EXPAND VEC_PUSH_U64 find_vec, 3
    EXPAND VEC_PUSH_U64 find_vec, 4
    EXPAND VEC_PUSH_U64 find_vec, 6
    EXPAND VEC_INTO_ITER_U64 find_iter, find_backing, find_vec
    EXPAND VEC_INTO_ITER_FIND_U64 find_has, find_value, find_iter, @vec_into_iter_search_is_even
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 find_remaining, find_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 find_next_has, find_next, find_iter

    EXPAND VEC_NEW find_none_vec
    EXPAND VEC_PUSH_U64 find_none_vec, 1
    EXPAND VEC_PUSH_U64 find_none_vec, 3
    EXPAND VEC_INTO_ITER_U64 find_none_iter, find_none_backing, find_none_vec
    EXPAND VEC_INTO_ITER_FIND_U64 find_none_has, find_none_value, find_none_iter, @vec_into_iter_search_is_even
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 find_none_empty, find_none_iter

    EXPAND VEC_NEW try_success_vec
    EXPAND VEC_PUSH_U64 try_success_vec, 1
    EXPAND VEC_PUSH_U64 try_success_vec, 3
    EXPAND VEC_PUSH_U64 try_success_vec, 4
    EXPAND VEC_PUSH_U64 try_success_vec, 5
    EXPAND VEC_INTO_ITER_U64 try_success_iter, try_success_backing, try_success_vec
    EXPAND VEC_INTO_ITER_TRY_FIND_U64 try_success_ok, try_success_has, try_success_value, try_success_iter, @vec_into_iter_try_find_even_lt_ten
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 try_success_remaining, try_success_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 try_success_next_has, try_success_next, try_success_iter

    EXPAND VEC_NEW try_fail_vec
    EXPAND VEC_PUSH_U64 try_fail_vec, 1
    EXPAND VEC_PUSH_U64 try_fail_vec, 2
    EXPAND VEC_PUSH_U64 try_fail_vec, 4
    EXPAND VEC_PUSH_U64 try_fail_vec, 5
    EXPAND VEC_INTO_ITER_U64 try_fail_iter, try_fail_backing, try_fail_vec
    EXPAND VEC_INTO_ITER_TRY_FIND_U64 try_fail_ok, try_fail_has, try_fail_value, try_fail_iter, @vec_into_iter_try_find_nine_before_four
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 try_fail_remaining, try_fail_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 try_fail_next_has, try_fail_next, try_fail_iter

    EXPAND VEC_NEW map_vec
    EXPAND VEC_PUSH_U64 map_vec, 1
    EXPAND VEC_PUSH_U64 map_vec, 3
    EXPAND VEC_PUSH_U64 map_vec, 4
    EXPAND VEC_PUSH_U64 map_vec, 5
    EXPAND VEC_INTO_ITER_U64 map_iter, map_backing, map_vec
    EXPAND VEC_INTO_ITER_FIND_MAP_U64 map_has, map_value, map_iter, @vec_into_iter_find_map_even_tens
    EXPAND VEC_INTO_ITER_NEXT_U64 map_next_has, map_next, map_iter

    EXPAND VEC_NEW position_vec
    EXPAND VEC_PUSH_U64 position_vec, 9
    EXPAND VEC_PUSH_U64 position_vec, 8
    EXPAND VEC_PUSH_U64 position_vec, 7
    EXPAND VEC_PUSH_U64 position_vec, 6
    EXPAND VEC_INTO_ITER_U64 position_iter, position_backing, position_vec
    EXPAND VEC_INTO_ITER_POSITION_U64 position_has, position_index, position_iter, @vec_into_iter_search_is_even
    EXPAND VEC_INTO_ITER_NEXT_U64 position_next_has, position_next, position_iter

    EXPAND VEC_NEW rposition_vec
    EXPAND VEC_PUSH_U64 rposition_vec, 1
    EXPAND VEC_PUSH_U64 rposition_vec, 2
    EXPAND VEC_PUSH_U64 rposition_vec, 3
    EXPAND VEC_PUSH_U64 rposition_vec, 4
    EXPAND VEC_PUSH_U64 rposition_vec, 5
    EXPAND VEC_INTO_ITER_U64 rposition_iter, rposition_backing, rposition_vec
    EXPAND VEC_INTO_ITER_RPOSITION_U64 rposition_has, rposition_index, rposition_iter, @vec_into_iter_search_is_even
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 rposition_remaining, rposition_iter
    EXPAND VEC_INTO_ITER_NEXT_BACK_U64 rposition_back_has, rposition_back, rposition_iter

    EXPAND VEC_NEW rfind_vec
    EXPAND VEC_PUSH_U64 rfind_vec, 1
    EXPAND VEC_PUSH_U64 rfind_vec, 2
    EXPAND VEC_PUSH_U64 rfind_vec, 3
    EXPAND VEC_PUSH_U64 rfind_vec, 4
    EXPAND VEC_PUSH_U64 rfind_vec, 5
    EXPAND VEC_INTO_ITER_U64 rfind_iter, rfind_backing, rfind_vec
    EXPAND VEC_INTO_ITER_RFIND_U64 rfind_has, rfind_value, rfind_iter, @vec_into_iter_search_lt_four
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 rfind_remaining, rfind_iter
    EXPAND VEC_INTO_ITER_NEXT_BACK_U64 rfind_back_has, rfind_back, rfind_iter

    EXPAND VEC_NEW any_vec
    EXPAND VEC_PUSH_U64 any_vec, 1
    EXPAND VEC_PUSH_U64 any_vec, 3
    EXPAND VEC_PUSH_U64 any_vec, 4
    EXPAND VEC_PUSH_U64 any_vec, 5
    EXPAND VEC_INTO_ITER_U64 any_iter, any_backing, any_vec
    EXPAND VEC_INTO_ITER_ANY_U64 any_value, any_iter, @vec_into_iter_search_is_even
    EXPAND VEC_INTO_ITER_NEXT_U64 any_next_has, any_next, any_iter

    EXPAND VEC_NEW all_vec
    EXPAND VEC_PUSH_U64 all_vec, 1
    EXPAND VEC_PUSH_U64 all_vec, 2
    EXPAND VEC_PUSH_U64 all_vec, 5
    EXPAND VEC_PUSH_U64 all_vec, 6
    EXPAND VEC_INTO_ITER_U64 all_iter, all_backing, all_vec
    EXPAND VEC_INTO_ITER_ALL_U64 all_value, all_iter, @vec_into_iter_search_lt_four
    EXPAND VEC_INTO_ITER_NEXT_U64 all_next_has, all_next, all_iter

    EXPAND VEC_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND VEC_INTO_ITER_ANY_U64 empty_any, empty_iter, @vec_into_iter_search_gt_four
    EXPAND VEC_INTO_ITER_ALL_U64 empty_all, empty_iter, @vec_into_iter_search_gt_four

    EXPAND VEC_FREE find_backing
    EXPAND VEC_FREE find_none_backing
    EXPAND VEC_FREE try_success_backing
    EXPAND VEC_FREE try_fail_backing
    EXPAND VEC_FREE map_backing
    EXPAND VEC_FREE position_backing
    EXPAND VEC_FREE rposition_backing
    EXPAND VEC_FREE rfind_backing
    EXPAND VEC_FREE any_backing
    EXPAND VEC_FREE all_backing
    EXPAND VEC_FREE empty_backing

    ok_find_has = eq find_has, 1
    ok_find_value = eq find_value, 4
    ok_find_remaining = eq find_remaining, 1
    ok_find_next_has = eq find_next_has, 1
    ok_find_next = eq find_next, 6
    ok_find_none_has = eq find_none_has, 0
    ok_find_none_value = eq find_none_value, 0
    ok_find_none_empty = eq find_none_empty, 1
    ok_try_success_ok = eq try_success_ok, 1
    ok_try_success_has = eq try_success_has, 1
    ok_try_success_value = eq try_success_value, 4
    ok_try_success_remaining = eq try_success_remaining, 1
    ok_try_success_next_has = eq try_success_next_has, 1
    ok_try_success_next = eq try_success_next, 5
    ok_try_fail_ok = eq try_fail_ok, 0
    ok_try_fail_has = eq try_fail_has, 0
    ok_try_fail_value = eq try_fail_value, 0
    ok_try_fail_remaining = eq try_fail_remaining, 1
    ok_try_fail_next_has = eq try_fail_next_has, 1
    ok_try_fail_next = eq try_fail_next, 5
    ok_map_has = eq map_has, 1
    ok_map_value = eq map_value, 40
    ok_map_next_has = eq map_next_has, 1
    ok_map_next = eq map_next, 5
    ok_position_has = eq position_has, 1
    ok_position_index = eq position_index, 1
    ok_position_next_has = eq position_next_has, 1
    ok_position_next = eq position_next, 7
    ok_rposition_has = eq rposition_has, 1
    ok_rposition_index = eq rposition_index, 3
    ok_rposition_remaining = eq rposition_remaining, 3
    ok_rposition_back_has = eq rposition_back_has, 1
    ok_rposition_back = eq rposition_back, 3
    ok_rfind_has = eq rfind_has, 1
    ok_rfind_value = eq rfind_value, 3
    ok_rfind_remaining = eq rfind_remaining, 2
    ok_rfind_back_has = eq rfind_back_has, 1
    ok_rfind_back = eq rfind_back, 2
    ok_any_value = eq any_value, 1
    ok_any_next_has = eq any_next_has, 1
    ok_any_next = eq any_next, 5
    ok_all_value = eq all_value, 0
    ok_all_next_has = eq all_next_has, 1
    ok_all_next = eq all_next, 6
    ok_empty_any = eq empty_any, 0
    ok_empty_all = eq empty_all, 1

    ok = and ok_find_has, ok_find_value
    ok = and ok, ok_find_remaining
    ok = and ok, ok_find_next_has
    ok = and ok, ok_find_next
    ok = and ok, ok_find_none_has
    ok = and ok, ok_find_none_value
    ok = and ok, ok_find_none_empty
    ok = and ok, ok_try_success_ok
    ok = and ok, ok_try_success_has
    ok = and ok, ok_try_success_value
    ok = and ok, ok_try_success_remaining
    ok = and ok, ok_try_success_next_has
    ok = and ok, ok_try_success_next
    ok = and ok, ok_try_fail_ok
    ok = and ok, ok_try_fail_has
    ok = and ok, ok_try_fail_value
    ok = and ok, ok_try_fail_remaining
    ok = and ok, ok_try_fail_next_has
    ok = and ok, ok_try_fail_next
    ok = and ok, ok_map_has
    ok = and ok, ok_map_value
    ok = and ok, ok_map_next_has
    ok = and ok, ok_map_next
    ok = and ok, ok_position_has
    ok = and ok, ok_position_index
    ok = and ok, ok_position_next_has
    ok = and ok, ok_position_next
    ok = and ok, ok_rposition_has
    ok = and ok, ok_rposition_index
    ok = and ok, ok_rposition_remaining
    ok = and ok, ok_rposition_back_has
    ok = and ok, ok_rposition_back
    ok = and ok, ok_rfind_has
    ok = and ok, ok_rfind_value
    ok = and ok, ok_rfind_remaining
    ok = and ok, ok_rfind_back_has
    ok = and ok, ok_rfind_back
    ok = and ok, ok_any_value
    ok = and ok, ok_any_next_has
    ok = and ok, ok_any_next
    ok = and ok, ok_all_value
    ok = and ok, ok_all_next_has
    ok = and ok, ok_all_next
    ok = and ok, ok_empty_any
    ok = and ok, ok_empty_all

    !find_has
    !find_value
    !find_remaining
    !find_next_has
    !find_next
    !find_none_has
    !find_none_value
    !find_none_empty
    !try_success_ok
    !try_success_has
    !try_success_value
    !try_success_remaining
    !try_success_next_has
    !try_success_next
    !try_fail_ok
    !try_fail_has
    !try_fail_value
    !try_fail_remaining
    !try_fail_next_has
    !try_fail_next
    !map_has
    !map_value
    !map_next_has
    !map_next
    !position_has
    !position_index
    !position_next_has
    !position_next
    !rposition_has
    !rposition_index
    !rposition_remaining
    !rposition_back_has
    !rposition_back
    !rfind_has
    !rfind_value
    !rfind_remaining
    !rfind_back_has
    !rfind_back
    !any_value
    !any_next_has
    !any_next
    !all_value
    !all_next_has
    !all_next
    !empty_any
    !empty_all
    !ok_find_has
    !ok_find_value
    !ok_find_remaining
    !ok_find_next_has
    !ok_find_next
    !ok_find_none_has
    !ok_find_none_value
    !ok_find_none_empty
    !ok_try_success_ok
    !ok_try_success_has
    !ok_try_success_value
    !ok_try_success_remaining
    !ok_try_success_next_has
    !ok_try_success_next
    !ok_try_fail_ok
    !ok_try_fail_has
    !ok_try_fail_value
    !ok_try_fail_remaining
    !ok_try_fail_next_has
    !ok_try_fail_next
    !ok_map_has
    !ok_map_value
    !ok_map_next_has
    !ok_map_next
    !ok_position_has
    !ok_position_index
    !ok_position_next_has
    !ok_position_next
    !ok_rposition_has
    !ok_rposition_index
    !ok_rposition_remaining
    !ok_rposition_back_has
    !ok_rposition_back
    !ok_rfind_has
    !ok_rfind_value
    !ok_rfind_remaining
    !ok_rfind_back_has
    !ok_rfind_back
    !ok_any_value
    !ok_any_next_has
    !ok_any_next
    !ok_all_value
    !ok_all_next_has
    !ok_all_next
