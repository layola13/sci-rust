@import "sa_std/env.sars"

@test "sa_std env named aliases"():
L_ENTRY:
    EXPAND ENV_CWD_GET cwd
    EXPAND ENV_HOME home
    EXPAND ENV_RUST_ARGS args
    EXPAND ENV_RUST_VARS vars
    cwd_ok = ne cwd, 0
    home_ok = ne home, 0
    args_ok = ne args, 0
    vars_ok = ne vars, 0
    EXPAND ENV_BUFFER_FREE cwd_free, cwd
    EXPAND ENV_BUFFER_FREE home_free, home
    EXPAND ENV_BUFFER_FREE args_free, args
    EXPAND ENV_BUFFER_FREE vars_free, vars
    EXPAND ENV_STATUS_IS_OK cwd_free_ok, cwd_free
    EXPAND ENV_STATUS_IS_OK home_free_ok, home_free
    EXPAND ENV_STATUS_IS_OK args_free_ok, args_free
    EXPAND ENV_STATUS_IS_OK vars_free_ok, vars_free
    ok01 = and cwd_ok, home_ok
    ok02 = and ok01, args_ok
    ok03 = and ok02, vars_ok
    ok04 = and ok03, cwd_free_ok
    ok05 = and ok04, home_free_ok
    ok06 = and ok05, args_free_ok
    ok = and ok06, vars_free_ok
    !cwd_ok
    !home_ok
    !args_ok
    !vars_ok
    !cwd_free
    !home_free
    !args_free
    !vars_free
    !cwd_free_ok
    !home_free_ok
    !args_free_ok
    !vars_free_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    br ok -> L_PASS, L_FAIL
L_PASS:
    !ok
    return 0
L_FAIL:
    !ok
    panic(11151)