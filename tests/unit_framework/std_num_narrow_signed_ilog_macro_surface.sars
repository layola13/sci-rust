    EXPAND NUM_I32_ILOG2 i32_ilog2_direct, 1048576
    EXPAND NUM_I32_CHECKED_ILOG10 i32_ilog10_ok, i32_ilog10_value, 1000000
    EXPAND NUM_I32_ILOG10 i32_ilog10_direct, 1000000

    ok01 = eq i8_ilog_ok, 1
    ok02 = eq i8_ilog_value, 3
    ok03 = eq i8_ilog_base_ok, 1
    ok04 = eq i8_ilog_base_value, 6
    ok05 = eq i8_ilog_lt_ok, 1
    ok06 = eq i8_ilog_lt_value, 0
    ok07 = eq i8_ilog_neg_ok, 0
    ok08 = eq i8_ilog_neg_value, 0
    ok09 = eq i8_ilog_zero_ok, 0
    ok10 = eq i8_ilog_zero_value, 0
    ok11 = eq i8_ilog_base_one_ok, 0
    ok12 = eq i8_ilog_base_one_value, 0
    ok13 = eq i8_ilog_raw_ok, 0
    ok14 = eq i8_ilog_raw_value, 0
    ok15 = eq i8_ilog_direct, 3
    ok16 = eq i8_ilog_direct_fail, 0
    ok17 = eq i8_ilog2_ok, 1
