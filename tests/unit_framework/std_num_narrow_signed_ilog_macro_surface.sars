    EXPAND NUM_I16_ILOG i16_ilog_direct, 3125, 5
    EXPAND NUM_I16_CHECKED_ILOG2 i16_ilog2_ok, i16_ilog2_value, 1024
    EXPAND NUM_I16_CHECKED_ILOG2 i16_ilog2_zero_ok, i16_ilog2_zero_value, 0
