    ok19 = eq i8_ilog2_direct, 6
    ok20 = eq i8_ilog10_ok, 1
    ok21 = eq i8_ilog10_value, 2
    ok22 = eq i8_ilog10_direct, 2

    ok23 = eq i16_ilog_ok, 1
