@import "sa_std/num.sars"

@test "sa_std num narrow signed ilog macro surface"():
L_ENTRY:
    EXPAND NUM_I8_CHECKED_ILOG i8_ilog_ok, i8_ilog_value, 125, 5
    EXPAND NUM_I8_CHECKED_ILOG i8_ilog_base_ok, i8_ilog_base_value, 127, 2
