@import "sa_std/ascii.sars"
@import "sa_std/char.sars"

@test "sa_std ascii char is_ascii digit"():
L_ENTRY:
    EXPAND ASCII_IS_ASCII is_a, 65
    EXPAND ASCII_IS_ASCII is_hi, 200
    EXPAND CHAR_IS_ASCII_DIGIT is_d, 53
    EXPAND CHAR_IS_ASCII_DIGIT is_nd, 65
    a = eq is_a, 1
    b = eq is_hi, 0
    c = eq is_d, 1
    d = eq is_nd, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !is_a
    !is_hi
    !is_d
    !is_nd
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10946)
