@test "sa_std env set_var_os/remove_var_os aliases"():
L_ENTRY:
    key = stack_alloc Slice_SIZE
    value = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW key, &MUTATION_KEY, MUTATION_KEY_LEN
    EXPAND SLICE_NEW value, &MUTATION_VALUE, MUTATION_VALUE_LEN
    EXPAND ENV_SET_VAR_OS set_status, key, value
    EXPAND ENV_STATUS_IS_OK set_ok, set_status
    EXPAND ENV_REMOVE_VAR_OS remove_status, key
    EXPAND ENV_STATUS_IS_OK remove_ok, remove_status
    ok = and set_ok, remove_ok

    !set_ok
    !remove_ok
    !set_status
    !remove_status
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1026)

L_PASS:
    !ok
    return 0
