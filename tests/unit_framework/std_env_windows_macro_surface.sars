@test "sa_std env split_paths_os/join_paths_os aliases macro surface"():
L_ENTRY:
    path_list_slice = stack_alloc Slice_SIZE
    paths_json_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW path_list_slice, &PATH_LIST, PATH_LIST_LEN
    EXPAND SLICE_NEW paths_json_slice, &PATH_LIST_JSON, PATH_LIST_JSON_LEN
    EXPAND ENV_SPLIT_PATHS_OS split_buffer, path_list_slice
    EXPAND ENV_JOIN_PATHS_OS join_buffer, paths_json_slice
    split_nonzero = ne split_buffer, 0
    join_nonzero = ne join_buffer, 0
    EXPAND ENV_BUFFER_FREE split_free, split_buffer
    EXPAND ENV_STATUS_IS_OK split_free_ok, split_free
    EXPAND ENV_BUFFER_FREE join_free, join_buffer
    EXPAND ENV_STATUS_IS_OK join_free_ok, join_free
    ok01 = and split_nonzero, join_nonzero
    ok02 = and ok01, split_free_ok
    ok = and ok02, join_free_ok

    !split_nonzero
    !join_nonzero
    !split_free_ok
    !join_free_ok
    !split_free
    !join_free
    !ok01
    !ok02
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1022)

L_PASS:
    !ok
    return 0

