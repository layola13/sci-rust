@import "sa_std/string.sars"
@import "sa_std/hash.sars"
@import "sa_std/core/slice.sars"

@test "sa_std string buf hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    base_data = alloc 4
    store base_data+0, 104 as u8
    store base_data+1, 97 as u8
    store base_data+2, 115 as u8
    store base_data+3, 104 as u8
    base_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW base_slice, base_data, 4

    suffix_data = alloc 1
    store suffix_data+0, 33 as u8
    suffix_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW suffix_slice, suffix_data, 1

    EXPAND STRING_BUF_FROM_STR string_buf, base_slice
    EXPAND STRING_BUF_FROM_STR same_string, base_slice

    write_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW write_hasher
    EXPAND DEFAULT_HASHER_WRITE_STRING_BUF write_hasher, string_buf
    EXPAND DEFAULT_HASHER_FINISH writer_hash, write_hasher

    EXPAND STRING_BUF_HASH direct_hash, string_buf
    EXPAND HASH_STR str_hash, base_slice
    EXPAND HASH_SLICE_U8 byte_slice_hash, base_slice
    EXPAND STRING_BUF_HASH same_hash, same_string
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_STRING_BUF build_hash, builder, string_buf
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_STR build_str_hash, builder, base_slice

    state = stack_alloc RandomState_SIZE
    manual_state_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_STRING_BUF state_hash, state, string_buf
    EXPAND RANDOM_STATE_BUILD manual_state_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_STR manual_state_hasher, base_slice
    EXPAND DEFAULT_HASHER_FINISH manual_state_hash, manual_state_hasher

    EXPAND STRING_BUF_PUSH_STR string_buf, suffix_slice
    EXPAND STRING_BUF_AS_STR changed_view, string_buf
    EXPAND STRING_BUF_HASH changed_hash, string_buf
    EXPAND HASH_STR changed_str_hash, changed_view
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_STRING_BUF changed_build_hash, builder, string_buf

    writer_matches_str = eq writer_hash, str_hash
    direct_matches_str = eq direct_hash, str_hash
    same_value_matches = eq same_hash, direct_hash
    build_matches_str = eq build_hash, build_str_hash
    build_matches_direct = eq build_hash, direct_hash
    state_matches_manual = eq state_hash, manual_state_hash
    str_domain_sep = ne direct_hash, byte_slice_hash
    changed_matches_str = eq changed_hash, changed_str_hash
    changed_build_matches = eq changed_build_hash, changed_hash
    changed_differs_old = ne changed_hash, direct_hash
    seeded_differs_default = ne state_hash, direct_hash

    c01 = and writer_matches_str, direct_matches_str
    c02 = and c01, same_value_matches
    c03 = and c02, build_matches_str
    c04 = and c03, build_matches_direct
    c05 = and c04, state_matches_manual
    c06 = and c05, str_domain_sep
    c07 = and c06, changed_matches_str
    c08 = and c07, changed_build_matches
    c09 = and c08, changed_differs_old
    ok = and c09, seeded_differs_default

    !writer_hash
    !direct_hash
    !str_hash
    !byte_slice_hash
    !same_hash
    !build_hash
    !build_str_hash
    !state_hash
    !manual_state_hash
    !changed_hash
    !changed_str_hash
    !changed_build_hash
    !writer_matches_str
    !direct_matches_str
    !same_value_matches
    !build_matches_str
    !build_matches_direct
    !state_matches_manual
    !str_domain_sep
    !changed_matches_str
    !changed_build_matches
    !changed_differs_old
    !seeded_differs_default
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !changed_view
    EXPAND STRING_BUF_FREE string_buf
    EXPAND STRING_BUF_FREE same_string
    !builder
    !base_slice
    !base_data
    !suffix_slice
    !suffix_data

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10582)

L_PASS:
    !ok
    return 0
