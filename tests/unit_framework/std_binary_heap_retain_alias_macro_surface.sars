@import "sa_std/collections/binary_heap.sars"

@binary_heap_retain_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@binary_heap_retain_never(value: u64) -> u64:
L_ENTRY:
    !value
    return 0

@test "sa_std binary_heap retain alias"():
L_ENTRY:
    EXPAND BINARY_HEAP_WITH_CAPACITY heap, 8
    EXPAND BINARY_HEAP_PUSH heap, 1
    EXPAND BINARY_HEAP_PUSH heap, 2
    EXPAND BINARY_HEAP_PUSH heap, 3
    EXPAND BINARY_HEAP_PUSH heap, 4
    EXPAND BINARY_HEAP_PUSH heap, 5
    EXPAND BINARY_HEAP_PUSH heap, 6
    EXPAND BINARY_HEAP_RETAIN remain_len, heap, @binary_heap_retain_even
    EXPAND BINARY_HEAP_LEN len_after, heap
    EXPAND BINARY_HEAP_PEEK peek0, heap
    EXPAND BINARY_HEAP_TRY_POP ok0, pop0, heap
    EXPAND BINARY_HEAP_TRY_POP ok1, pop1, heap
    EXPAND BINARY_HEAP_TRY_POP ok2, pop2, heap
    EXPAND BINARY_HEAP_TRY_POP ok_empty, empty_value, heap
    EXPAND BINARY_HEAP_FREE heap

    EXPAND BINARY_HEAP_WITH_CAPACITY never_heap, 3
    EXPAND BINARY_HEAP_PUSH never_heap, 7
    EXPAND BINARY_HEAP_PUSH never_heap, 8
    EXPAND BINARY_HEAP_PUSH never_heap, 9
    EXPAND BINARY_HEAP_RETAIN never_remain, never_heap, @binary_heap_retain_never
    EXPAND BINARY_HEAP_IS_EMPTY never_empty, never_heap
    EXPAND BINARY_HEAP_FREE never_heap

    EXPAND BINARY_HEAP_WITH_CAPACITY empty_heap, 0
    EXPAND BINARY_HEAP_RETAIN empty_remain, empty_heap, @binary_heap_retain_even
    EXPAND BINARY_HEAP_IS_EMPTY empty_still, empty_heap
    EXPAND BINARY_HEAP_FREE empty_heap

    ok_remain = eq remain_len, 3
    ok_len = eq len_after, 3
    ok_peek = eq peek0, 6
    ok_ok0 = eq ok0, 1
    ok_pop0 = eq pop0, 6
    ok_ok1 = eq ok1, 1
    ok_pop1 = eq pop1, 4
    ok_ok2 = eq ok2, 1
    ok_pop2 = eq pop2, 2
    ok_empty_pop = eq ok_empty, 0
    ok_never_remain = eq never_remain, 0
    ok_never_empty = eq never_empty, 1
    ok_empty_remain = eq empty_remain, 0
    ok_empty_still = eq empty_still, 1

    ok01 = and ok_remain, ok_len
    ok02 = and ok01, ok_peek
    ok03 = and ok02, ok_ok0
    ok04 = and ok03, ok_pop0
    ok05 = and ok04, ok_ok1
    ok06 = and ok05, ok_pop1
    ok07 = and ok06, ok_ok2
    ok08 = and ok07, ok_pop2
    ok09 = and ok08, ok_empty_pop
    ok10 = and ok09, ok_never_remain
    ok11 = and ok10, ok_never_empty
    ok12 = and ok11, ok_empty_remain
    ok = and ok12, ok_empty_still

    !remain_len
    !len_after
    !peek0
    !ok0
    !pop0
    !ok1
    !pop1
    !ok2
    !pop2
    !ok_empty
    !empty_value
    !never_remain
    !never_empty
    !empty_remain
    !empty_still
    !ok_remain
    !ok_len
    !ok_peek
    !ok_ok0
    !ok_pop0
    !ok_ok1
    !ok_pop1
    !ok_ok2
    !ok_pop2
    !ok_empty_pop
    !ok_never_remain
    !ok_never_empty
    !ok_empty_remain
    !ok_empty_still
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    br ok -> L_OK, L_FAIL

L_OK:
    return 0

L_FAIL:
    panic(10835)
