@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap into_iter_sorted adapter collect macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW take_heap
    EXPAND BINARY_HEAP_PUSH_U64 take_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 take_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 take_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 take_heap, 4
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 take_iter, take_backing, take_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_TAKE_COLLECT_U64 take_vec, take_iter, 2
    EXPAND VEC_LEN take_len, take_vec
    EXPAND VEC_GET_U64 take_0, take_vec, 0
    EXPAND VEC_GET_U64 take_1, take_vec, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 take_remaining, take_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 take_next_has, take_next, take_iter

    EXPAND BINARY_HEAP_NEW take_all_heap
    EXPAND BINARY_HEAP_PUSH_U64 take_all_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 take_all_heap, 6
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 take_all_iter, take_all_backing, take_all_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_TAKE_COLLECT_U64 take_all_vec, take_all_iter, 9
    EXPAND VEC_LEN take_all_len, take_all_vec
    EXPAND VEC_GET_U64 take_all_1, take_all_vec, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 take_all_empty, take_all_iter

    EXPAND BINARY_HEAP_NEW skip_heap
    EXPAND BINARY_HEAP_PUSH_U64 skip_heap, 10
    EXPAND BINARY_HEAP_PUSH_U64 skip_heap, 11
    EXPAND BINARY_HEAP_PUSH_U64 skip_heap, 12
    EXPAND BINARY_HEAP_PUSH_U64 skip_heap, 13
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 skip_iter, skip_backing, skip_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_SKIP_COLLECT_U64 skip_vec, skip_iter, 2
    EXPAND VEC_LEN skip_len, skip_vec
    EXPAND VEC_GET_U64 skip_0, skip_vec, 0
    EXPAND VEC_GET_U64 skip_1, skip_vec, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 skip_empty, skip_iter

    EXPAND BINARY_HEAP_NEW skip_all_heap
    EXPAND BINARY_HEAP_PUSH_U64 skip_all_heap, 20
    EXPAND BINARY_HEAP_PUSH_U64 skip_all_heap, 21
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 skip_all_iter, skip_all_backing, skip_all_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_SKIP_COLLECT_U64 skip_all_vec, skip_all_iter, 9
    EXPAND VEC_LEN skip_all_len, skip_all_vec
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 skip_all_empty, skip_all_iter

    EXPAND VEC_FREE take_backing
    EXPAND VEC_FREE take_vec
    EXPAND VEC_FREE take_all_backing
    EXPAND VEC_FREE take_all_vec
    EXPAND VEC_FREE skip_backing
    EXPAND VEC_FREE skip_vec
    EXPAND VEC_FREE skip_all_backing
    EXPAND VEC_FREE skip_all_vec

    ok_take_len = eq take_len, 2
    ok_take_0 = eq take_0, 4
    ok_take_1 = eq take_1, 3
    ok_take_remaining = eq take_remaining, 2
    ok_take_next_has = eq take_next_has, 1
    ok_take_next = eq take_next, 2
    ok_take_all_len = eq take_all_len, 2
    ok_take_all_1 = eq take_all_1, 5
    ok_take_all_empty = eq take_all_empty, 1
    ok_skip_len = eq skip_len, 2
    ok_skip_0 = eq skip_0, 11
    ok_skip_1 = eq skip_1, 10
    ok_skip_empty = eq skip_empty, 1
    ok_skip_all_len = eq skip_all_len, 0
    ok_skip_all_empty = eq skip_all_empty, 1

    ok = and ok_take_len, ok_take_0
    ok = and ok, ok_take_1
    ok = and ok, ok_take_remaining
    ok = and ok, ok_take_next_has
    ok = and ok, ok_take_next
    ok = and ok, ok_take_all_len
    ok = and ok, ok_take_all_1
    ok = and ok, ok_take_all_empty
    ok = and ok, ok_skip_len
    ok = and ok, ok_skip_0
    ok = and ok, ok_skip_1
    ok = and ok, ok_skip_empty
    ok = and ok, ok_skip_all_len
    ok = and ok, ok_skip_all_empty

    !take_len
    !take_0
    !take_1
    !take_remaining
    !take_next_has
    !take_next
    !take_all_len
    !take_all_1
    !take_all_empty
    !skip_len
    !skip_0
    !skip_1
    !skip_empty
    !skip_all_len
    !skip_all_empty
    !ok_take_len
    !ok_take_0
    !ok_take_1
    !ok_take_remaining
    !ok_take_next_has
    !ok_take_next
    !ok_take_all_len
    !ok_take_all_1
    !ok_take_all_empty
    !ok_skip_len
    !ok_skip_0
    !ok_skip_1
    !ok_skip_empty
    !ok_skip_all_len
    !ok_skip_all_empty
    !take_iter
    !take_all_iter
    !skip_iter
    !skip_all_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_SORTED_ADAPTER_OK, L_BINARY_HEAP_INTO_ITER_SORTED_ADAPTER_FAIL

L_BINARY_HEAP_INTO_ITER_SORTED_ADAPTER_FAIL:
    !ok
    panic(10780)

L_BINARY_HEAP_INTO_ITER_SORTED_ADAPTER_OK:
    !ok
    return
