@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_map.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"

@test "sa_std btree_map get_disjoint_mut aliases"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, bravo, 20
    EXPAND BTREE_MAP_INSERT map, charlie, 30

    EXPAND BTREE_MAP_GET_DISJOINT_MUT disjoint_ok, disjoint_a_ptr, disjoint_b_ptr, map, alpha, bravo
    store disjoint_a_ptr+0, 11 as u64
    store disjoint_b_ptr+0, 22 as u64
    EXPAND BTREE_MAP_GET after_alpha, map, alpha
    EXPAND BTREE_MAP_GET after_bravo, map, bravo
    EXPAND BTREE_MAP_GET after_charlie, map, charlie

    EXPAND BTREE_MAP_GET_DISJOINT_MUT_PTRS ptrs_ok, ptrs_a, ptrs_b, map, alpha, charlie
    EXPAND BTREE_MAP_GET_DISJOINT_MUT same_key_ok, same_a_ptr, same_b_ptr, map, alpha, alpha

    EXPAND BTREE_MAP_NEW empty_map
    EXPAND BTREE_MAP_GET_DISJOINT_MUT empty_ok, empty_a_ptr, empty_b_ptr, empty_map, alpha, bravo

    null_ptr = 0 as ptr
    ok_disjoint = eq disjoint_ok, 1
    ok_after_alpha = eq after_alpha, 11
    ok_after_bravo = eq after_bravo, 22
    ok_after_charlie = eq after_charlie, 30
    ok_ptrs = eq ptrs_ok, 1
    ok_same_key = eq same_key_ok, 0
    ok_same_a = eq same_a_ptr, null_ptr
    ok_same_b = eq same_b_ptr, null_ptr
    ok_empty = eq empty_ok, 0
    ok_empty_a = eq empty_a_ptr, null_ptr
    ok_empty_b = eq empty_b_ptr, null_ptr

    ok01 = and ok_disjoint, ok_after_alpha
    ok02 = and ok01, ok_after_bravo
    ok03 = and ok02, ok_after_charlie
    ok04 = and ok03, ok_ptrs
    ok05 = and ok04, ok_same_key
    ok06 = and ok05, ok_same_a
    ok07 = and ok06, ok_same_b
    ok08 = and ok07, ok_empty
    ok09 = and ok08, ok_empty_a
    ok = and ok09, ok_empty_b

    !disjoint_ok
    !disjoint_a_ptr
    !disjoint_b_ptr
    !after_alpha
    !after_bravo
    !after_charlie
    !ptrs_ok
    !ptrs_a
    !ptrs_b
    !same_key_ok
    !same_a_ptr
    !same_b_ptr
    !empty_ok
    !empty_a_ptr
    !empty_b_ptr
    !null_ptr
    !ok_disjoint
    !ok_after_alpha
    !ok_after_bravo
    !ok_after_charlie
    !ok_ptrs
    !ok_same_key
    !ok_same_a
    !ok_same_b
    !ok_empty
    !ok_empty_a
    !ok_empty_b
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_MAP_FREE empty_map
    EXPAND BTREE_MAP_FREE map
    return 0

L_FAIL:
    panic(10833)
