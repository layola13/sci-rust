@import "sa_std/num.sars"

@test "sa_std narrow unsigned primitive rotate macro surface"():
L_ENTRY:
    u32_high = shl 1, 31
    usize_high = shl 1, 63

    EXPAND NUM_U8_ROTATE_LEFT u8_left_wrap, 129, 1
    EXPAND NUM_U8_ROTATE_RIGHT u8_right_wrap, 3, 1
    EXPAND NUM_U8_ROTATE_LEFT u8_left_half, 18, 4
    EXPAND NUM_U8_ROTATE_RIGHT u8_right_half, 18, 4
    EXPAND NUM_U8_ROTATE_LEFT u8_left_mod, 1, 9
    EXPAND NUM_U8_ROTATE_RIGHT u8_right_mod, 1, 9
    EXPAND NUM_U8_ROTATE_LEFT u8_left_mask, 300, 2
    EXPAND NUM_U8_ROTATE_RIGHT u8_right_mask, 300, 2
    EXPAND NUM_U8_ROTATE_LEFT u8_zero_shift, 300, 0

    EXPAND NUM_U16_ROTATE_LEFT u16_left_wrap, 32769, 1
    EXPAND NUM_U16_ROTATE_RIGHT u16_right_wrap, 3, 1
    EXPAND NUM_U16_ROTATE_LEFT u16_left_byte, 4660, 8
    EXPAND NUM_U16_ROTATE_RIGHT u16_right_byte, 4660, 8
    EXPAND NUM_U16_ROTATE_LEFT u16_left_mod, 1, 17
    EXPAND NUM_U16_ROTATE_RIGHT u16_right_mod, 1, 17
    EXPAND NUM_U16_ROTATE_LEFT u16_zero_shift, 70000, 0

    EXPAND NUM_U32_ROTATE_LEFT u32_left_wrap, u32_high, 1
    EXPAND NUM_U32_ROTATE_RIGHT u32_right_wrap, 1, 1
    EXPAND NUM_U32_ROTATE_LEFT u32_left_byte, 305419896, 8
    EXPAND NUM_U32_ROTATE_RIGHT u32_right_byte, 305419896, 8
    EXPAND NUM_U32_ROTATE_LEFT u32_left_mod, 1, 33
    EXPAND NUM_U32_ROTATE_RIGHT u32_right_mod, 1, 33

    EXPAND NUM_USIZE_ROTATE_LEFT usize_left_wrap, usize_high, 1
    EXPAND NUM_USIZE_ROTATE_RIGHT usize_right_wrap, 1, 1
    EXPAND NUM_USIZE_ROTATE_LEFT usize_left_mod, 1, 68
    EXPAND NUM_USIZE_ROTATE_RIGHT usize_right_mod, 16, 68
    EXPAND NUM_USIZE_ROTATE_LEFT usize_zero_shift, usize_high, 0

    ok01 = eq u8_left_wrap, 3
    ok02 = eq u8_right_wrap, 129
    ok03 = eq u8_left_half, 33
    ok04 = eq u8_right_half, 33
    ok05 = eq u8_left_mod, 2
    ok06 = eq u8_right_mod, 128
    ok07 = eq u8_left_mask, 176
    ok08 = eq u8_right_mask, 11
    ok09 = eq u8_zero_shift, 44

    ok10 = eq u16_left_wrap, 3
    ok11 = eq u16_right_wrap, 32769
    ok12 = eq u16_left_byte, 13330
    ok13 = eq u16_right_byte, 13330
    ok14 = eq u16_left_mod, 2
    ok15 = eq u16_right_mod, 32768
    ok16 = eq u16_zero_shift, 4464

    ok17 = eq u32_left_wrap, 1
    ok18 = eq u32_right_wrap, u32_high
    ok19 = eq u32_left_byte, 878082066
    ok20 = eq u32_right_byte, 2014458966
    ok21 = eq u32_left_mod, 2
    ok22 = eq u32_right_mod, u32_high

    ok23 = eq usize_left_wrap, 1
    ok24 = eq usize_right_wrap, usize_high
    ok25 = eq usize_left_mod, 16
    ok26 = eq usize_right_mod, 1
    ok27 = eq usize_zero_shift, usize_high

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    chain22 = and chain21, ok23
    chain23 = and chain22, ok24
    chain24 = and chain23, ok25
    chain25 = and chain24, ok26
    ok = and chain25, ok27

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    !u32_high
    !usize_high
    panic(10664)

L_PASS:
    !ok
    !u32_high
    !usize_high
    return 0
