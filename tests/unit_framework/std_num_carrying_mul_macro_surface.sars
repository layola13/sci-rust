@import "sa_std/num.sars"

[MACRO] TEST_CARRYING_MUL_EQ %out_acc, %prev_acc, %value, %expected
    __test_carrying_mul_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_carrying_mul_eq_%out_acc
    !__test_carrying_mul_eq_%out_acc
[END_MACRO]

@test "sa_std unsigned primitive carrying_mul and carrying_mul_add macro surface"():
L_ENTRY:
    EXPAND NUM_U8_CARRYING_MUL u8_mul_low, u8_mul_high, 13, 42, 0
    EXPAND NUM_U16_CARRYING_MUL u16_mul_low, u16_mul_high, 789, 456, 123
    EXPAND NUM_U32_CARRYING_MUL u32_mul_low, u32_mul_high, 1000000000, 10, 10
    EXPAND NUM_U64_CARRYING_MUL u64_mul_low, u64_mul_high, NUM_U64_MAX, NUM_U64_MAX, NUM_U64_MAX
    EXPAND NUM_USIZE_CARRYING_MUL usize_mul_low, usize_mul_high, NUM_USIZE_MAX, NUM_USIZE_MAX, NUM_USIZE_MAX

    EXPAND NUM_U8_CARRYING_MUL_ADD u8_add_low, u8_add_high, 5, 2, 10, 10
    EXPAND NUM_U16_CARRYING_MUL_ADD u16_add_low, u16_add_high, NUM_U16_MAX, NUM_U16_MAX, NUM_U16_MAX, NUM_U16_MAX
    EXPAND NUM_U32_CARRYING_MUL_ADD u32_add_low, u32_add_high, 1000000000, 10, 10, 10
    EXPAND NUM_U64_CARRYING_MUL_ADD u64_add_low, u64_add_high, NUM_U64_MAX, NUM_U64_MAX, NUM_U64_MAX, NUM_U64_MAX
    EXPAND NUM_USIZE_CARRYING_MUL_ADD usize_add_low, usize_add_high, 5, 2, 10, 10

    acc_00 = eq 0, 0
    EXPAND TEST_CARRYING_MUL_EQ acc_01, acc_00, u8_mul_low, 34
    EXPAND TEST_CARRYING_MUL_EQ acc_02, acc_01, u8_mul_high, 2
    EXPAND TEST_CARRYING_MUL_EQ acc_03, acc_02, u16_mul_low, 32227
    EXPAND TEST_CARRYING_MUL_EQ acc_04, acc_03, u16_mul_high, 5
    EXPAND TEST_CARRYING_MUL_EQ acc_05, acc_04, u32_mul_low, 1410065418
    EXPAND TEST_CARRYING_MUL_EQ acc_06, acc_05, u32_mul_high, 2
    EXPAND TEST_CARRYING_MUL_EQ acc_07, acc_06, u64_mul_low, 0
    EXPAND TEST_CARRYING_MUL_EQ acc_08, acc_07, u64_mul_high, NUM_U64_MAX
    EXPAND TEST_CARRYING_MUL_EQ acc_09, acc_08, usize_mul_low, 0
    EXPAND TEST_CARRYING_MUL_EQ acc_10, acc_09, usize_mul_high, NUM_USIZE_MAX
    EXPAND TEST_CARRYING_MUL_EQ acc_11, acc_10, u8_add_low, 30
    EXPAND TEST_CARRYING_MUL_EQ acc_12, acc_11, u8_add_high, 0
    EXPAND TEST_CARRYING_MUL_EQ acc_13, acc_12, u16_add_low, NUM_U16_MAX
    EXPAND TEST_CARRYING_MUL_EQ acc_14, acc_13, u16_add_high, NUM_U16_MAX
    EXPAND TEST_CARRYING_MUL_EQ acc_15, acc_14, u32_add_low, 1410065428
    EXPAND TEST_CARRYING_MUL_EQ acc_16, acc_15, u32_add_high, 2
    EXPAND TEST_CARRYING_MUL_EQ acc_17, acc_16, u64_add_low, NUM_U64_MAX
    EXPAND TEST_CARRYING_MUL_EQ acc_18, acc_17, u64_add_high, NUM_U64_MAX
    EXPAND TEST_CARRYING_MUL_EQ acc_19, acc_18, usize_add_low, 30
    EXPAND TEST_CARRYING_MUL_EQ acc_20, acc_19, usize_add_high, 0
    br acc_20 -> L_PASS, L_FAIL

L_FAIL:
    !acc_20
    panic(10650)

L_PASS:
    !acc_20
    return 0
