@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list clear is_empty"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 1
    EXPAND LINKED_LIST_PUSH_BACK list, 2
    EXPAND LINKED_LIST_CLEAR list
    EXPAND LINKED_LIST_IS_EMPTY e, list
    EXPAND LINKED_LIST_LEN ln, list
    EXPAND LINKED_LIST_FREE list
    a = eq e, 1
    b = eq ln, 0
    ok = and a, b
    !e
    !ln
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10978)
