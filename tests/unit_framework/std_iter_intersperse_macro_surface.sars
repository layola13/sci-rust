@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@iter_separator_ninety() -> u64:
L_ENTRY:
    return 90

@test "sa_std iter intersperse collect macro surface"():
L_ENTRY:
    values = stack_alloc 24
    single_values = stack_alloc 8
    empty_values = stack_alloc 8

    store values+0, 2 as u64
    store values+8, 4 as u64
    store values+16, 6 as u64
    store single_values+0, 42 as u64

    slice = alloc Slice_SIZE
    single_slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 3
    EXPAND SLICE_NEW single_slice, single_values, 1
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE fixed_iter, slice
    EXPAND ITER_INTERSPERSE_COLLECT_U64 fixed_vec, fixed_iter, 99
    EXPAND ITER_IS_EMPTY fixed_iter_empty, fixed_iter
    EXPAND VEC_LEN fixed_len, fixed_vec
    EXPAND VEC_GET_U64 fixed_0, fixed_vec, 0
    EXPAND VEC_GET_U64 fixed_1, fixed_vec, 1
    EXPAND VEC_GET_U64 fixed_2, fixed_vec, 2
    EXPAND VEC_GET_U64 fixed_3, fixed_vec, 3
    EXPAND VEC_GET_U64 fixed_4, fixed_vec, 4

    EXPAND ITER_FROM_SLICE tail_iter, slice
    EXPAND ITER_NEXT_U64 tail_first_ok, tail_first, tail_iter
    EXPAND ITER_INTERSPERSE_COLLECT_U64 tail_vec, tail_iter, 77
    EXPAND ITER_IS_EMPTY tail_iter_empty, tail_iter
    EXPAND VEC_LEN tail_len, tail_vec
    EXPAND VEC_GET_U64 tail_0, tail_vec, 0
    EXPAND VEC_GET_U64 tail_1, tail_vec, 1
    EXPAND VEC_GET_U64 tail_2, tail_vec, 2

    EXPAND ITER_FROM_SLICE with_iter, slice
    EXPAND ITER_INTERSPERSE_WITH_COLLECT_U64 with_vec, with_iter, @iter_separator_ninety
    EXPAND ITER_IS_EMPTY with_iter_empty, with_iter
    EXPAND VEC_LEN with_len, with_vec
    EXPAND VEC_GET_U64 with_0, with_vec, 0
    EXPAND VEC_GET_U64 with_1, with_vec, 1
    EXPAND VEC_GET_U64 with_2, with_vec, 2
    EXPAND VEC_GET_U64 with_3, with_vec, 3
    EXPAND VEC_GET_U64 with_4, with_vec, 4

    EXPAND ITER_FROM_SLICE single_iter, single_slice
    EXPAND ITER_INTERSPERSE_COLLECT_U64 single_vec, single_iter, 11
    EXPAND ITER_IS_EMPTY single_iter_empty, single_iter
    EXPAND VEC_LEN single_len, single_vec
    EXPAND VEC_GET_U64 single_0, single_vec, 0

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_INTERSPERSE_WITH_COLLECT_U64 empty_vec, empty_iter, @iter_separator_ninety
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter
    EXPAND VEC_LEN empty_len, empty_vec

    ok_fixed_empty = eq fixed_iter_empty, 1
    ok_fixed_len = eq fixed_len, 5
    ok_fixed_0 = eq fixed_0, 2
    ok_fixed_1 = eq fixed_1, 99
    ok_fixed_2 = eq fixed_2, 4
    ok_fixed_3 = eq fixed_3, 99
    ok_fixed_4 = eq fixed_4, 6
    ok_tail_first_ok = eq tail_first_ok, 1
    ok_tail_first = eq tail_first, 2
    ok_tail_empty = eq tail_iter_empty, 1
    ok_tail_len = eq tail_len, 3
    ok_tail_0 = eq tail_0, 4
    ok_tail_1 = eq tail_1, 77
    ok_tail_2 = eq tail_2, 6
    ok_with_empty = eq with_iter_empty, 1
    ok_with_len = eq with_len, 5
    ok_with_0 = eq with_0, 2
    ok_with_1 = eq with_1, 90
    ok_with_2 = eq with_2, 4
    ok_with_3 = eq with_3, 90
    ok_with_4 = eq with_4, 6
    ok_single_empty = eq single_iter_empty, 1
    ok_single_len = eq single_len, 1
    ok_single_0 = eq single_0, 42
    ok_empty_iter = eq empty_iter_empty, 1
    ok_empty_len = eq empty_len, 0

    c01 = and ok_fixed_empty, ok_fixed_len
    c02 = and c01, ok_fixed_0
    c03 = and c02, ok_fixed_1
    c04 = and c03, ok_fixed_2
    c05 = and c04, ok_fixed_3
    c06 = and c05, ok_fixed_4
    c07 = and c06, ok_tail_first_ok
    c08 = and c07, ok_tail_first
    c09 = and c08, ok_tail_empty
    c10 = and c09, ok_tail_len
    c11 = and c10, ok_tail_0
    c12 = and c11, ok_tail_1
    c13 = and c12, ok_tail_2
    c14 = and c13, ok_with_empty
    c15 = and c14, ok_with_len
    c16 = and c15, ok_with_0
    c17 = and c16, ok_with_1
    c18 = and c17, ok_with_2
    c19 = and c18, ok_with_3
    c20 = and c19, ok_with_4
    c21 = and c20, ok_single_empty
    c22 = and c21, ok_single_len
    c23 = and c22, ok_single_0
    c24 = and c23, ok_empty_iter
    ok = and c24, ok_empty_len

    !fixed_iter_empty
    !fixed_len
    !fixed_0
    !fixed_1
    !fixed_2
    !fixed_3
    !fixed_4
    !tail_first_ok
    !tail_first
    !tail_iter_empty
    !tail_len
    !tail_0
    !tail_1
    !tail_2
    !with_iter_empty
    !with_len
    !with_0
    !with_1
    !with_2
    !with_3
    !with_4
    !single_iter_empty
    !single_len
    !single_0
    !empty_iter_empty
    !empty_len
    !ok_fixed_empty
    !ok_fixed_len
    !ok_fixed_0
    !ok_fixed_1
    !ok_fixed_2
    !ok_fixed_3
    !ok_fixed_4
    !ok_tail_first_ok
    !ok_tail_first
    !ok_tail_empty
    !ok_tail_len
    !ok_tail_0
    !ok_tail_1
    !ok_tail_2
    !ok_with_empty
    !ok_with_len
    !ok_with_0
    !ok_with_1
    !ok_with_2
    !ok_with_3
    !ok_with_4
    !ok_single_empty
    !ok_single_len
    !ok_single_0
    !ok_empty_iter
    !ok_empty_len
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !c19
    !c20
    !c21
    !c22
    !c23
    !c24
    !empty_iter
    !single_iter
    !with_iter
    !tail_iter
    !fixed_iter
    !empty_slice
    !single_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE single_vec
    EXPAND VEC_FREE with_vec
    EXPAND VEC_FREE tail_vec
    EXPAND VEC_FREE fixed_vec
    panic(10543)

L_PASS:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE single_vec
    EXPAND VEC_FREE with_vec
    EXPAND VEC_FREE tail_vec
    EXPAND VEC_FREE fixed_vec
    return 0
