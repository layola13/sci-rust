@import "sa_std/array.sars"

@test "sa_std array hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    arr = stack_alloc 24
    other = stack_alloc 24
    slice = stack_alloc Slice_SIZE
    manual_hasher = stack_alloc DefaultHasher_SIZE
    state = stack_alloc RandomState_SIZE
    state_manual_hasher = stack_alloc DefaultHasher_SIZE

    store arr+0, 7 as u64
    store arr+8, 99 as u64
    store arr+16, 123 as u64

    store other+0, 7 as u64
    store other+8, 99 as u64
    store other+16, 124 as u64

    EXPAND ARRAY_AS_SLICE_U64 slice, arr, 3
    EXPAND ARRAY_HASH_U64 array_hash, arr, 3
    EXPAND SLICE_HASH_U64 slice_hash, slice
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_ARRAY_U64 build_array_hash, builder, arr, 3
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_SLICE_U64 build_slice_hash, builder, slice
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_ARRAY_U64 build_other_hash, builder, other, 3

    EXPAND DEFAULT_HASHER_NEW manual_hasher
    EXPAND DEFAULT_HASHER_WRITE_ARRAY_U64 manual_hasher, arr, 3
    EXPAND DEFAULT_HASHER_FINISH manual_hash, manual_hasher

    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_ARRAY_U64 state_array_hash, state, arr, 3
    EXPAND RANDOM_STATE_BUILD state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_ARRAY_U64 state_manual_hasher, arr, 3
    EXPAND DEFAULT_HASHER_FINISH state_manual_hash, state_manual_hasher

    array_matches_slice = eq array_hash, slice_hash
    build_matches_array = eq build_array_hash, array_hash
    build_matches_slice = eq build_array_hash, build_slice_hash
    build_matches_manual = eq build_array_hash, manual_hash
    state_matches_manual = eq state_array_hash, state_manual_hash
    value_matters = ne build_array_hash, build_other_hash
    seeded_differs_default = ne state_array_hash, build_array_hash

    c01 = and array_matches_slice, build_matches_array
    c02 = and c01, build_matches_slice
    c03 = and c02, build_matches_manual
    c04 = and c03, state_matches_manual
    c05 = and c04, value_matters
    ok = and c05, seeded_differs_default

    !builder
    !array_hash
    !slice_hash
    !build_array_hash
    !build_slice_hash
    !build_other_hash
    !manual_hash
    !state_array_hash
    !state_manual_hash
    !array_matches_slice
    !build_matches_array
    !build_matches_slice
    !build_matches_manual
    !state_matches_manual
    !value_matters
    !seeded_differs_default
    !c01
    !c02
    !c03
    !c04
    !c05
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10579)

L_PASS:
    !ok
    return 0
