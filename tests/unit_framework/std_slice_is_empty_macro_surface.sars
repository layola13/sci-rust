@import "sa_std/core/slice.sars"

@test "sa_std slice is_empty"():
L_ENTRY:
    buf = alloc 8
    store buf+0, 1 as u64
    s = stack_alloc Slice_SIZE
    s2 = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW s, buf, 1
    EXPAND SLICE_IS_EMPTY e0, s
    EXPAND SLICE_NEW s2, buf, 0
    EXPAND SLICE_IS_EMPTY e1, s2
    a = eq e0, 0
    b = eq e1, 1
    ok = and a, b
    !e0
    !e1
    !a
    !b
    !buf
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(11002)
