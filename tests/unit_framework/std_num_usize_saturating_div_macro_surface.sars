@import "sa_std/num.sars"

@test "sa_std num usize saturating div macro surface"():
L_ENTRY:
    EXPAND NUM_USIZE_SATURATING_DIV usize_mid, 42, 7
    EXPAND NUM_USIZE_SATURATING_DIV usize_zero, 42, 0

    ok01 = eq usize_mid, 6
    ok02 = eq usize_zero, NUM_USIZE_MAX
    ok = and ok01, ok02

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10679)

L_PASS:
    return 0
