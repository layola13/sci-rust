@import "sa_std/vec.sars"

@vec_partition_lt_5(value: u64) -> u64:
L_ENTRY:
    keep = ult value, 5
    !value
    return keep

@test "sa_std vec search dedup aliases"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 search_vec, 4
    EXPAND VEC_PUSH_U64 search_vec, 1
    EXPAND VEC_PUSH_U64 search_vec, 3
    EXPAND VEC_PUSH_U64 search_vec, 5
    EXPAND VEC_PUSH_U64 search_vec, 7
    EXPAND VEC_BINARY_SEARCH hit_ok, hit_idx, search_vec, 5
    EXPAND VEC_BINARY_SEARCH miss_ok, miss_idx, search_vec, 4
    EXPAND VEC_CONTAINS has_5, search_vec, 5
    EXPAND VEC_CONTAINS has_4, search_vec, 4
    EXPAND VEC_PARTITION_POINT partition_idx, search_vec, @vec_partition_lt_5
    EXPAND VEC_FREE search_vec

    EXPAND VEC_WITH_CAPACITY_U64 dedup_vec, 6
    EXPAND VEC_PUSH_U64 dedup_vec, 1
    EXPAND VEC_PUSH_U64 dedup_vec, 1
    EXPAND VEC_PUSH_U64 dedup_vec, 2
    EXPAND VEC_PUSH_U64 dedup_vec, 2
    EXPAND VEC_PUSH_U64 dedup_vec, 2
    EXPAND VEC_PUSH_U64 dedup_vec, 3
    EXPAND VEC_DEDUP dedup_len, dedup_vec
    EXPAND VEC_LEN len_after_dedup, dedup_vec
    EXPAND VEC_TRY_GET_U64 first_ok, first, dedup_vec, 0
    EXPAND VEC_TRY_GET_U64 second_ok, second, dedup_vec, 1
    EXPAND VEC_TRY_GET_U64 third_ok, third, dedup_vec, 2
    EXPAND VEC_TRY_GET_U64 fourth_ok, fourth, dedup_vec, 3
    EXPAND VEC_FREE dedup_vec

    hit_flag_ok = eq hit_ok, 1
    hit_idx_ok = eq hit_idx, 2
    miss_flag_ok = eq miss_ok, 0
    miss_idx_ok = eq miss_idx, 2
    has_5_ok = eq has_5, 1
    has_4_ok = eq has_4, 0
    partition_idx_ok = eq partition_idx, 2
    dedup_len_ok = eq dedup_len, 3
    len_after_dedup_ok = eq len_after_dedup, 3
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first, 1
    second_flag_ok = eq second_ok, 1
    second_value_ok = eq second, 2
    third_flag_ok = eq third_ok, 1
    third_value_ok = eq third, 3
    fourth_flag_ok = eq fourth_ok, 0
    fourth_value_ok = eq fourth, 0

    ok01 = and hit_flag_ok, hit_idx_ok
    ok02 = and ok01, miss_flag_ok
    ok03 = and ok02, miss_idx_ok
    ok04 = and ok03, has_5_ok
    ok05 = and ok04, has_4_ok
    ok06 = and ok05, partition_idx_ok
    ok07 = and ok06, dedup_len_ok
    ok08 = and ok07, len_after_dedup_ok
    ok09 = and ok08, first_flag_ok
    ok10 = and ok09, first_value_ok
    ok11 = and ok10, second_flag_ok
    ok12 = and ok11, second_value_ok
    ok13 = and ok12, third_flag_ok
    ok14 = and ok13, third_value_ok
    ok15 = and ok14, fourth_flag_ok
    ok = and ok15, fourth_value_ok

    !hit_ok
    !hit_idx
    !miss_ok
    !miss_idx
    !has_5
    !has_4
    !partition_idx
    !dedup_len
    !len_after_dedup
    !first_ok
    !first
    !second_ok
    !second
    !third_ok
    !third
    !fourth_ok
    !fourth
    !hit_flag_ok
    !hit_idx_ok
    !miss_flag_ok
    !miss_idx_ok
    !has_5_ok
    !has_4_ok
    !partition_idx_ok
    !dedup_len_ok
    !len_after_dedup_ok
    !first_flag_ok
    !first_value_ok
    !second_flag_ok
    !second_value_ok
    !third_flag_ok
    !third_value_ok
    !fourth_flag_ok
    !fourth_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10839)

L_OK:
    !ok
    return
