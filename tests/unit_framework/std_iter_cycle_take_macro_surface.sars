@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@test "sa_std iter cycle take collect macro surface"():
L_ENTRY:
    values = stack_alloc 24
    empty_values = stack_alloc 8

    store values+0, 3 as u64
    store values+8, 5 as u64
    store values+16, 7 as u64

    slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 3
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE cycle_iter, slice
    EXPAND ITER_CYCLE_TAKE_COLLECT_U64 cycle_vec, cycle_iter, 8
    EXPAND ITER_IS_EMPTY cycle_iter_empty, cycle_iter
    EXPAND VEC_LEN cycle_len, cycle_vec
    EXPAND VEC_GET_U64 cycle_0, cycle_vec, 0
    EXPAND VEC_GET_U64 cycle_1, cycle_vec, 1
    EXPAND VEC_GET_U64 cycle_2, cycle_vec, 2
    EXPAND VEC_GET_U64 cycle_3, cycle_vec, 3
    EXPAND VEC_GET_U64 cycle_4, cycle_vec, 4
    EXPAND VEC_GET_U64 cycle_5, cycle_vec, 5
    EXPAND VEC_GET_U64 cycle_6, cycle_vec, 6
    EXPAND VEC_GET_U64 cycle_7, cycle_vec, 7

    EXPAND ITER_FROM_SLICE tail_iter, slice
    EXPAND ITER_NEXT_U64 tail_first_ok, tail_first, tail_iter
    EXPAND ITER_CYCLE_TAKE_COLLECT_U64 tail_vec, tail_iter, 4
    EXPAND ITER_IS_EMPTY tail_iter_empty, tail_iter
    EXPAND VEC_LEN tail_len, tail_vec
    EXPAND VEC_GET_U64 tail_0, tail_vec, 0
    EXPAND VEC_GET_U64 tail_1, tail_vec, 1
    EXPAND VEC_GET_U64 tail_2, tail_vec, 2
    EXPAND VEC_GET_U64 tail_3, tail_vec, 3

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_CYCLE_TAKE_COLLECT_U64 empty_vec, empty_iter, 5
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter
    EXPAND VEC_LEN empty_len, empty_vec

    EXPAND ITER_FROM_SLICE zero_iter, slice
    EXPAND ITER_CYCLE_TAKE_COLLECT_U64 zero_vec, zero_iter, 0
    EXPAND VEC_LEN zero_len, zero_vec
    EXPAND ITER_NEXT_U64 zero_next_ok, zero_next, zero_iter
    EXPAND ITER_LEN zero_remaining, zero_iter

    ok_cycle_empty = eq cycle_iter_empty, 1
    ok_cycle_len = eq cycle_len, 8
    ok_cycle_0 = eq cycle_0, 3
    ok_cycle_1 = eq cycle_1, 5
    ok_cycle_2 = eq cycle_2, 7
    ok_cycle_3 = eq cycle_3, 3
    ok_cycle_4 = eq cycle_4, 5
    ok_cycle_5 = eq cycle_5, 7
    ok_cycle_6 = eq cycle_6, 3
    ok_cycle_7 = eq cycle_7, 5
    ok_tail_first_ok = eq tail_first_ok, 1
    ok_tail_first = eq tail_first, 3
    ok_tail_empty = eq tail_iter_empty, 1
    ok_tail_len = eq tail_len, 4
    ok_tail_0 = eq tail_0, 5
    ok_tail_1 = eq tail_1, 7
    ok_tail_2 = eq tail_2, 5
    ok_tail_3 = eq tail_3, 7
    ok_empty_iter = eq empty_iter_empty, 1
    ok_empty_len = eq empty_len, 0
    ok_zero_len = eq zero_len, 0
    ok_zero_next_ok = eq zero_next_ok, 1
    ok_zero_next = eq zero_next, 3
    ok_zero_remaining = eq zero_remaining, 2

    c01 = and ok_cycle_empty, ok_cycle_len
    c02 = and c01, ok_cycle_0
    c03 = and c02, ok_cycle_1
    c04 = and c03, ok_cycle_2
    c05 = and c04, ok_cycle_3
    c06 = and c05, ok_cycle_4
    c07 = and c06, ok_cycle_5
    c08 = and c07, ok_cycle_6
    c09 = and c08, ok_cycle_7
    c10 = and c09, ok_tail_first_ok
    c11 = and c10, ok_tail_first
    c12 = and c11, ok_tail_empty
    c13 = and c12, ok_tail_len
    c14 = and c13, ok_tail_0
    c15 = and c14, ok_tail_1
    c16 = and c15, ok_tail_2
    c17 = and c16, ok_tail_3
    c18 = and c17, ok_empty_iter
    c19 = and c18, ok_empty_len
    c20 = and c19, ok_zero_len
    c21 = and c20, ok_zero_next_ok
    c22 = and c21, ok_zero_next
    ok = and c22, ok_zero_remaining

    !cycle_iter_empty
    !cycle_len
    !cycle_0
    !cycle_1
    !cycle_2
    !cycle_3
    !cycle_4
    !cycle_5
    !cycle_6
    !cycle_7
    !tail_first_ok
    !tail_first
    !tail_iter_empty
    !tail_len
    !tail_0
    !tail_1
    !tail_2
    !tail_3
    !empty_iter_empty
    !empty_len
    !zero_len
    !zero_next_ok
    !zero_next
    !zero_remaining
    !ok_cycle_empty
    !ok_cycle_len
    !ok_cycle_0
    !ok_cycle_1
    !ok_cycle_2
    !ok_cycle_3
    !ok_cycle_4
    !ok_cycle_5
    !ok_cycle_6
    !ok_cycle_7
    !ok_tail_first_ok
    !ok_tail_first
    !ok_tail_empty
    !ok_tail_len
    !ok_tail_0
    !ok_tail_1
    !ok_tail_2
    !ok_tail_3
    !ok_empty_iter
    !ok_empty_len
    !ok_zero_len
    !ok_zero_next_ok
    !ok_zero_next
    !ok_zero_remaining
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !c19
    !c20
    !c21
    !c22
    !zero_iter
    !empty_iter
    !tail_iter
    !cycle_iter
    !empty_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE tail_vec
    EXPAND VEC_FREE cycle_vec
    panic(10542)

L_PASS:
    !ok
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE tail_vec
    EXPAND VEC_FREE cycle_vec
    return 0
