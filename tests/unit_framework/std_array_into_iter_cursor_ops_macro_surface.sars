@import "sa_std/array.sars"

@test "sa_std array into_iter cursor ops macro surface"():
L_ENTRY:
    arr = stack_alloc 48
    store arr+0, 1 as u64
    store arr+8, 2 as u64
    store arr+16, 3 as u64
    store arr+24, 4 as u64
    store arr+32, 5 as u64
    store arr+40, 6 as u64

    EXPAND ARRAY_INTO_ITER_U64 iter, backing, arr, 6
    EXPAND ARRAY_INTO_ITER_NEXT_U64 next_has, next_value, iter
    EXPAND ARRAY_INTO_ITER_NTH_U64 nth_has, nth_value, iter, 1
    EXPAND ARRAY_INTO_ITER_NEXT_BACK_U64 back_has, back_value, iter
    EXPAND ARRAY_INTO_ITER_NTH_BACK_U64 nth_back_has, nth_back_value, iter, 0
    EXPAND ARRAY_INTO_ITER_ADVANCE_BY adv_ok, adv_remaining, iter, 1
    EXPAND ARRAY_INTO_ITER_NEXT_U64 done_has, done_value, iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_adv, iter

    last_arr = stack_alloc 32
    store last_arr+0, 10 as u64
    store last_arr+8, 20 as u64
    store last_arr+16, 30 as u64
    store last_arr+24, 40 as u64
    EXPAND ARRAY_INTO_ITER_U64 last_iter, last_backing, last_arr, 4
    EXPAND ARRAY_INTO_ITER_ADVANCE_BACK_BY adv_back_ok, adv_back_remaining, last_iter, 1
    EXPAND ARRAY_INTO_ITER_LAST_U64 last_has, last_value, last_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_last, last_iter

    count_arr = stack_alloc 24
    store count_arr+0, 7 as u64
    store count_arr+8, 8 as u64
    store count_arr+16, 9 as u64
    EXPAND ARRAY_INTO_ITER_U64 count_iter, count_backing, count_arr, 3
    EXPAND ARRAY_INTO_ITER_COUNT_U64 count_value, count_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_count, count_iter

    short_arr = stack_alloc 16
    store short_arr+0, 100 as u64
    store short_arr+8, 200 as u64
    EXPAND ARRAY_INTO_ITER_U64 short_iter, short_backing, short_arr, 2
    EXPAND ARRAY_INTO_ITER_ADVANCE_BY short_ok, short_remaining, short_iter, 5
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_short, short_iter

    short_back_arr = stack_alloc 16
    store short_back_arr+0, 300 as u64
    store short_back_arr+8, 400 as u64
    EXPAND ARRAY_INTO_ITER_U64 short_back_iter, short_back_backing, short_back_arr, 2
    EXPAND ARRAY_INTO_ITER_ADVANCE_BACK_BY short_back_ok, short_back_remaining, short_back_iter, 5
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_short_back, short_back_iter

    chunk_arr = stack_alloc 40
    store chunk_arr+0, 11 as u64
    store chunk_arr+8, 22 as u64
    store chunk_arr+16, 33 as u64
    store chunk_arr+24, 44 as u64
    store chunk_arr+32, 55 as u64
    chunk_buf = stack_alloc 24
    EXPAND ARRAY_INTO_ITER_U64 chunk_iter, chunk_backing, chunk_arr, 5
    EXPAND ARRAY_INTO_ITER_TRY_NEXT_CHUNK_U64 chunk_ok, chunk_filled, chunk_iter, chunk_buf, 3
    chunk_0 = load chunk_buf+0 as u64
    chunk_1 = load chunk_buf+8 as u64
    chunk_2 = load chunk_buf+16 as u64
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 chunk_remaining, chunk_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 chunk_next_has, chunk_next, chunk_iter

    tail_buf = stack_alloc 32
    EXPAND ARRAY_INTO_ITER_U64 tail_iter, tail_backing, chunk_arr, 5
    EXPAND ARRAY_INTO_ITER_ADVANCE_BY tail_skip_ok, tail_skip_remaining, tail_iter, 3
    EXPAND ARRAY_INTO_ITER_TRY_NEXT_CHUNK_U64 tail_ok, tail_filled, tail_iter, tail_buf, 4
    tail_0 = load tail_buf+0 as u64
    tail_1 = load tail_buf+8 as u64
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 tail_empty, tail_iter

    zero_buf = stack_alloc 8
    EXPAND ARRAY_INTO_ITER_U64 zero_iter, zero_backing, short_arr, 2
    EXPAND ARRAY_INTO_ITER_NEXT_U64 zero_first_has, zero_first, zero_iter
    EXPAND ARRAY_INTO_ITER_TRY_NEXT_CHUNK_U64 zero_ok, zero_filled, zero_iter, zero_buf, 0
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 zero_remaining, zero_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 zero_next_has, zero_next, zero_iter

    EXPAND VEC_FREE backing
    EXPAND VEC_FREE last_backing
    EXPAND VEC_FREE count_backing
    EXPAND VEC_FREE short_backing
    EXPAND VEC_FREE short_back_backing
    EXPAND VEC_FREE chunk_backing
    EXPAND VEC_FREE tail_backing
    EXPAND VEC_FREE zero_backing

    ok_next_has = eq next_has, 1
    ok_next_value = eq next_value, 1
    ok_nth_has = eq nth_has, 1
    ok_nth_value = eq nth_value, 3
    ok_back_has = eq back_has, 1
    ok_back_value = eq back_value, 6
    ok_nth_back_has = eq nth_back_has, 1
    ok_nth_back_value = eq nth_back_value, 5
    ok_adv_ok = eq adv_ok, 1
    ok_adv_remaining = eq adv_remaining, 0
    ok_done_has = eq done_has, 0
    ok_done_value = eq done_value, 0
    ok_len_after_adv = eq len_after_adv, 0
    ok_adv_back_ok = eq adv_back_ok, 1
    ok_adv_back_remaining = eq adv_back_remaining, 0
    ok_last_has = eq last_has, 1
    ok_last_value = eq last_value, 30
    ok_len_after_last = eq len_after_last, 0
    ok_count_value = eq count_value, 3
    ok_len_after_count = eq len_after_count, 0
    ok_short_ok = eq short_ok, 0
    ok_short_remaining = eq short_remaining, 3
    ok_len_after_short = eq len_after_short, 0
    ok_short_back_ok = eq short_back_ok, 0
    ok_short_back_remaining = eq short_back_remaining, 3
    ok_len_after_short_back = eq len_after_short_back, 0
    ok_chunk_ok = eq chunk_ok, 1
    ok_chunk_filled = eq chunk_filled, 3
    ok_chunk_0 = eq chunk_0, 11
    ok_chunk_1 = eq chunk_1, 22
    ok_chunk_2 = eq chunk_2, 33
    ok_chunk_remaining = eq chunk_remaining, 2
    ok_chunk_next_has = eq chunk_next_has, 1
    ok_chunk_next = eq chunk_next, 44
    ok_tail_skip_ok = eq tail_skip_ok, 1
    ok_tail_skip_remaining = eq tail_skip_remaining, 0
    ok_tail_ok = eq tail_ok, 0
    ok_tail_filled = eq tail_filled, 2
    ok_tail_0 = eq tail_0, 44
    ok_tail_1 = eq tail_1, 55
    ok_tail_empty = eq tail_empty, 1
    ok_zero_first_has = eq zero_first_has, 1
    ok_zero_first = eq zero_first, 100
    ok_zero_ok = eq zero_ok, 1
    ok_zero_filled = eq zero_filled, 0
    ok_zero_remaining = eq zero_remaining, 1
    ok_zero_next_has = eq zero_next_has, 1
    ok_zero_next = eq zero_next, 200

    ok = and ok_next_has, ok_next_value
    ok = and ok, ok_nth_has
    ok = and ok, ok_nth_value
    ok = and ok, ok_back_has
    ok = and ok, ok_back_value
    ok = and ok, ok_nth_back_has
    ok = and ok, ok_nth_back_value
    ok = and ok, ok_adv_ok
    ok = and ok, ok_adv_remaining
    ok = and ok, ok_done_has
    ok = and ok, ok_done_value
    ok = and ok, ok_len_after_adv
    ok = and ok, ok_adv_back_ok
    ok = and ok, ok_adv_back_remaining
    ok = and ok, ok_last_has
    ok = and ok, ok_last_value
    ok = and ok, ok_len_after_last
    ok = and ok, ok_count_value
    ok = and ok, ok_len_after_count
    ok = and ok, ok_short_ok
    ok = and ok, ok_short_remaining
    ok = and ok, ok_len_after_short
    ok = and ok, ok_short_back_ok
    ok = and ok, ok_short_back_remaining
    ok = and ok, ok_len_after_short_back
    ok = and ok, ok_chunk_ok
    ok = and ok, ok_chunk_filled
    ok = and ok, ok_chunk_0
    ok = and ok, ok_chunk_1
    ok = and ok, ok_chunk_2
    ok = and ok, ok_chunk_remaining
    ok = and ok, ok_chunk_next_has
    ok = and ok, ok_chunk_next
    ok = and ok, ok_tail_skip_ok
    ok = and ok, ok_tail_skip_remaining
    ok = and ok, ok_tail_ok
    ok = and ok, ok_tail_filled
    ok = and ok, ok_tail_0
    ok = and ok, ok_tail_1
    ok = and ok, ok_tail_empty
    ok = and ok, ok_zero_first_has
    ok = and ok, ok_zero_first
    ok = and ok, ok_zero_ok
    ok = and ok, ok_zero_filled
    ok = and ok, ok_zero_remaining
    ok = and ok, ok_zero_next_has
    ok = and ok, ok_zero_next

    !next_has
    !next_value
    !nth_has
    !nth_value
    !back_has
    !back_value
    !nth_back_has
    !nth_back_value
    !adv_ok
    !adv_remaining
    !done_has
    !done_value
    !len_after_adv
    !adv_back_ok
    !adv_back_remaining
    !last_has
    !last_value
    !len_after_last
    !count_value
    !len_after_count
    !short_ok
    !short_remaining
    !len_after_short
    !short_back_ok
    !short_back_remaining
    !len_after_short_back
    !chunk_ok
    !chunk_filled
    !chunk_0
    !chunk_1
    !chunk_2
    !chunk_remaining
    !chunk_next_has
    !chunk_next
    !tail_skip_ok
    !tail_skip_remaining
    !tail_ok
    !tail_filled
    !tail_0
    !tail_1
    !tail_empty
    !zero_first_has
    !zero_first
    !zero_ok
    !zero_filled
    !zero_remaining
    !zero_next_has
    !zero_next
    !ok_next_has
    !ok_next_value
    !ok_nth_has
    !ok_nth_value
    !ok_back_has
    !ok_back_value
    !ok_nth_back_has
    !ok_nth_back_value
    !ok_adv_ok
    !ok_adv_remaining
    !ok_done_has
    !ok_done_value
    !ok_len_after_adv
    !ok_adv_back_ok
    !ok_adv_back_remaining
    !ok_last_has
    !ok_last_value
    !ok_len_after_last
    !ok_count_value
    !ok_len_after_count
    !ok_short_ok
    !ok_short_remaining
    !ok_len_after_short
    !ok_short_back_ok
    !ok_short_back_remaining
    !ok_len_after_short_back
    !ok_chunk_ok
    !ok_chunk_filled
    !ok_chunk_0
    !ok_chunk_1
    !ok_chunk_2
    !ok_chunk_remaining
    !ok_chunk_next_has
    !ok_chunk_next
    !ok_tail_skip_ok
    !ok_tail_skip_remaining
    !ok_tail_ok
    !ok_tail_filled
    !ok_tail_0
    !ok_tail_1
    !ok_tail_empty
    !ok_zero_first_has
    !ok_zero_first
    !ok_zero_ok
    !ok_zero_filled
    !ok_zero_remaining
    !ok_zero_next_has
    !ok_zero_next
    !iter
    !last_iter
    !count_iter
    !short_iter
    !short_back_iter
    !chunk_iter
    !tail_iter
    !zero_iter
    br ok -> L_ARRAY_INTO_ITER_CURSOR_OK, L_ARRAY_INTO_ITER_CURSOR_FAIL

L_ARRAY_INTO_ITER_CURSOR_FAIL:
    !ok
    panic(10738)

L_ARRAY_INTO_ITER_CURSOR_OK:
    !ok
    return
