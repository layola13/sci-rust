@import "sa_std/collections/vec_deque.sars"

@test "sa_std vec_deque split_off alias"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_SPLIT_OFF split_ok, right, deque, 2
    EXPAND VEC_DEQUE_LEN left_len, deque
    EXPAND VEC_DEQUE_LEN right_len, right
    EXPAND VEC_DEQUE_TRY_GET l0_ok, l0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET l1_ok, l1, deque, 1
    EXPAND VEC_DEQUE_TRY_GET r0_ok, r0, right, 0
    EXPAND VEC_DEQUE_TRY_GET r1_ok, r1, right, 1

    EXPAND VEC_DEQUE_NEW empty
    EXPAND VEC_DEQUE_SPLIT_OFF empty_ok, empty_right, empty, 0
    EXPAND VEC_DEQUE_IS_EMPTY empty_left_empty, empty
    EXPAND VEC_DEQUE_IS_EMPTY empty_right_empty, empty_right

    EXPAND VEC_DEQUE_WITH_CAPACITY miss_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK miss_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK miss_deque, 2
    EXPAND VEC_DEQUE_SPLIT_OFF miss_ok, miss_right, miss_deque, 9
    EXPAND VEC_DEQUE_LEN miss_len, miss_deque

    ok_split = eq split_ok, 1
    ok_left_len = eq left_len, 2
    ok_right_len = eq right_len, 2
    ok_l0_flag = eq l0_ok, 1
    ok_l0 = eq l0, 10
    ok_l1_flag = eq l1_ok, 1
    ok_l1 = eq l1, 20
    ok_r0_flag = eq r0_ok, 1
    ok_r0 = eq r0, 30
    ok_r1_flag = eq r1_ok, 1
    ok_r1 = eq r1, 40
    ok_empty_ok = eq empty_ok, 1
    ok_empty_left = eq empty_left_empty, 1
    ok_empty_right = eq empty_right_empty, 1
    ok_miss = eq miss_ok, 0
    ok_miss_len = eq miss_len, 2

    ok = and ok_split, ok_left_len
    ok = and ok, ok_right_len
    ok = and ok, ok_l0_flag
    ok = and ok, ok_l0
    ok = and ok, ok_l1_flag
    ok = and ok, ok_l1
    ok = and ok, ok_r0_flag
    ok = and ok, ok_r0
    ok = and ok, ok_r1_flag
    ok = and ok, ok_r1
    ok = and ok, ok_empty_ok
    ok = and ok, ok_empty_left
    ok = and ok, ok_empty_right
    ok = and ok, ok_miss
    ok = and ok, ok_miss_len

    EXPAND VEC_DEQUE_FREE right
    EXPAND VEC_DEQUE_FREE empty_right
    EXPAND VEC_DEQUE_FREE deque
    EXPAND VEC_DEQUE_FREE empty
    EXPAND VEC_DEQUE_FREE miss_deque
    !miss_right
    !split_ok
    !left_len
    !right_len
    !l0_ok
    !l0
    !l1_ok
    !l1
    !r0_ok
    !r0
    !r1_ok
    !r1
    !empty_ok
    !empty_left_empty
    !empty_right_empty
    !miss_ok
    !miss_len
    !ok_split
    !ok_left_len
    !ok_right_len
    !ok_l0_flag
    !ok_l0
    !ok_l1_flag
    !ok_l1
    !ok_r0_flag
    !ok_r0
    !ok_r1_flag
    !ok_r1
    !ok_empty_ok
    !ok_empty_left
    !ok_empty_right
    !ok_miss
    !ok_miss_len
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10826)

L_OK:
    !ok
    return
