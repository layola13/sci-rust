@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const A = utf8:"hi"
@const B = utf8:"!"

@test "sa_std string_buf push_str len"():
L_ENTRY:
    EXPAND STR_FROM_PARTS a, &A, 2
    EXPAND STR_FROM_PARTS b, &B, 1
    EXPAND STRING_BUF_FROM_STR buf, a
    EXPAND STRING_BUF_PUSH_STR buf, b
    EXPAND STRING_BUF_LEN ln, buf
    EXPAND STRING_BUF_AS_STR view, buf
    EXPAND SLICE_GET_LEN vln, view
    x = eq ln, 3
    y = eq vln, 3
    ok = and x, y
    !ln
    !vln
    !x
    !y
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10920)
