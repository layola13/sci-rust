    !s1
    !s2
    !s3
    !s4
    !s5
    !s6
    !s7
    !ipv6
    !ipaddr
    !socket_addr
    br ok -> L_SOCKET_ADDR_V6_ENUM_PARSE_PASS, L_SOCKET_ADDR_V6_ENUM_PARSE_FAIL

L_SOCKET_ADDR_V6_ENUM_PARSE_FAIL:
    !ok
    panic(10107)

L_SOCKET_ADDR_V6_ENUM_PARSE_PASS:
    !ok
    return 0
