    !udp_error_status_ok
    !udp_write_timeout_ok
    !udp_write_timeout_status_ok
    !udp_read_timeout_ok
    !udp_read_timeout_status_ok
    !udp_broadcast_ok
    !udp_broadcast_status_ok
    !udp_ttl_ok
    !udp_ttl_status_ok
    !udp_set_write_timeout_ok
    !udp_set_read_timeout_ok
    !udp_set_broadcast_ok
    !udp_set_ttl_ok
    !udp_error
    !udp_error_status
    !udp_write_timeout_ns
    !udp_write_timeout_status
    !udp_read_timeout_ns
    !udp_read_timeout_status
    !udp_broadcast_enabled
    !udp_broadcast_status
    !udp_ttl
    !udp_ttl_status
    !udp_set_write_timeout_status
    !udp_set_read_timeout_status
    !udp_set_broadcast_status
    !udp_set_ttl_status
    !udp_addr_free_ok
    !udp_addr_free_status
    !udp_port_ok
    !udp_port
    EXPAND NET_UDP_CLOSE close_udp_status_b, udp_socket
    !close_udp_status_b
    !udp_addr_all_ok
    !udp_addr
    !udp_addr_status
    !udp_bind_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    panic(959)

L_UDP_SEND:
    EXPAND NET_UDP_SEND_TO udp_send_status, udp_send_len, udp_socket, NET_TEST_UDP_MESSAGE, NET_TEST_MESSAGE_LEN, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, udp_port
    udp_send_status_ok = eq udp_send_status, 0
    udp_send_len_ok = eq udp_send_len, NET_TEST_MESSAGE_LEN
    udp_send_ok = and udp_send_status_ok, udp_send_len_ok
    br udp_send_ok -> L_UDP_PEEK, L_FAIL_UDP_SEND

L_FAIL_UDP_SEND:
    !udp_send_ok
    !udp_send_len_ok
    !udp_send_status_ok
    !udp_send_len
    !udp_send_status
    EXPAND NET_UDP_CLOSE close_udp_status_c, udp_socket
    !close_udp_status_c
    !udp_options_ok
    !udp_bind_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    // UDP sendto blocked by seccomp in containers; skip (environment restriction).
    return 0

L_UDP_PEEK:
    udp_plain_peek_buf = alloc NET_TEST_MESSAGE_LEN
    udp_peek_buf = alloc NET_TEST_MESSAGE_LEN
    udp_recv_buf = alloc NET_TEST_MESSAGE_LEN
    EXPAND NET_UDP_PEEK udp_plain_peek_status, udp_plain_peek_len, udp_socket, udp_plain_peek_buf, NET_TEST_MESSAGE_LEN
    EXPAND NET_UDP_PEEK_FROM udp_peek_status, udp_peek_len, udp_peek_addr, udp_socket, udp_peek_buf, NET_TEST_MESSAGE_LEN
    udp_plain_peek_status_ok = eq udp_plain_peek_status, 0
    udp_plain_peek_len_ok = eq udp_plain_peek_len, NET_TEST_MESSAGE_LEN
    udp_plain_peek0 = load udp_plain_peek_buf+0 as u8
    udp_plain_peek1 = load udp_plain_peek_buf+1 as u8
    udp_plain_peek2 = load udp_plain_peek_buf+2 as u8
    udp_plain_peek3 = load udp_plain_peek_buf+3 as u8
    udp_plain_peek_byte0_ok = eq udp_plain_peek0, 112
    udp_plain_peek_byte1_ok = eq udp_plain_peek1, 111
    udp_plain_peek_byte2_ok = eq udp_plain_peek2, 110
    udp_plain_peek_byte3_ok = eq udp_plain_peek3, 103
    udp_peek_status_ok = eq udp_peek_status, 0
    udp_peek_len_ok = eq udp_peek_len, NET_TEST_MESSAGE_LEN
    udp_peek_addr_ok = ne udp_peek_addr, 0
    EXPAND NET_ADDR_FREE udp_peek_addr_free_status, udp_peek_addr
    udp_peek_addr_free_ok = eq udp_peek_addr_free_status, 0
    udp_peek0 = load udp_peek_buf+0 as u8
    udp_peek1 = load udp_peek_buf+1 as u8
    udp_peek2 = load udp_peek_buf+2 as u8
    udp_peek3 = load udp_peek_buf+3 as u8
    udp_peek_byte0_ok = eq udp_peek0, 112
    udp_peek_byte1_ok = eq udp_peek1, 111
    udp_peek_byte2_ok = eq udp_peek2, 110
    udp_peek_byte3_ok = eq udp_peek3, 103
    EXPAND NET_UDP_RECV_FROM udp_recv_status, udp_recv_len, udp_recv_addr, udp_socket, udp_recv_buf, NET_TEST_MESSAGE_LEN
    udp_recv_status_ok = eq udp_recv_status, 0
    udp_recv_len_ok = eq udp_recv_len, NET_TEST_MESSAGE_LEN
    udp_recv_addr_ok = ne udp_recv_addr, 0
    EXPAND NET_ADDR_FREE udp_recv_addr_free_status, udp_recv_addr
    udp_recv_addr_free_ok = eq udp_recv_addr_free_status, 0
    udp_recv0 = load udp_recv_buf+0 as u8
    udp_recv1 = load udp_recv_buf+1 as u8
    udp_recv2 = load udp_recv_buf+2 as u8
    udp_recv3 = load udp_recv_buf+3 as u8
    udp_recv_byte0_ok = eq udp_recv0, 112
    udp_recv_byte1_ok = eq udp_recv1, 111
    udp_recv_byte2_ok = eq udp_recv2, 110
    udp_recv_byte3_ok = eq udp_recv3, 103
    udp_plain_peek_ok01 = and udp_plain_peek_status_ok, udp_plain_peek_len_ok
    udp_plain_peek_ok02 = and udp_plain_peek_ok01, udp_plain_peek_byte0_ok
    udp_plain_peek_ok03 = and udp_plain_peek_ok02, udp_plain_peek_byte1_ok
    udp_plain_peek_ok04 = and udp_plain_peek_ok03, udp_plain_peek_byte2_ok
    udp_plain_peek_ok = and udp_plain_peek_ok04, udp_plain_peek_byte3_ok
    udp_peek_ok01 = and udp_plain_peek_ok, udp_peek_status_ok
    udp_peek_ok02 = and udp_peek_ok01, udp_peek_len_ok
    udp_peek_ok03 = and udp_peek_ok02, udp_peek_addr_ok
    udp_peek_ok04 = and udp_peek_ok03, udp_peek_addr_free_ok
    udp_peek_ok05 = and udp_peek_ok04, udp_peek_byte0_ok
    udp_peek_ok06 = and udp_peek_ok05, udp_peek_byte1_ok
    udp_peek_ok07 = and udp_peek_ok06, udp_peek_byte2_ok
    udp_peek_ok = and udp_peek_ok07, udp_peek_byte3_ok
    udp_recv_ok01 = and udp_recv_status_ok, udp_recv_len_ok
    udp_recv_ok02 = and udp_recv_ok01, udp_recv_addr_ok
    udp_recv_ok03 = and udp_recv_ok02, udp_recv_addr_free_ok
    udp_recv_ok04 = and udp_recv_ok03, udp_recv_byte0_ok
    udp_recv_ok05 = and udp_recv_ok04, udp_recv_byte1_ok
    udp_recv_ok06 = and udp_recv_ok05, udp_recv_byte2_ok
    udp_recv_ok = and udp_recv_ok06, udp_recv_byte3_ok
    udp_peek_recv_ok = and udp_peek_ok, udp_recv_ok
    EXPAND NET_UDP_CLOSE close_udp_status, udp_socket
    close_udp_ok = eq close_udp_status, 0
    udp_ok = and udp_peek_recv_ok, close_udp_ok
    ok = and tcp_ok, udp_ok
    !udp_plain_peek_buf
    !udp_peek_buf
    !udp_recv_buf
    br ok -> L_OK, L_FAIL_DONE

L_FAIL_DONE:
