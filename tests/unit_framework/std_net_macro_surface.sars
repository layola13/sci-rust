    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII bad_ok, bad_ipaddr, NET_TEST_SOCKET_V6, NET_TEST_SOCKET_V6_LEN

    ok_parse = eq parse_ok, 1
    ok_is_v4 = eq is_v4, 0
    ok_is_v6 = eq is_v6, 1
    ok_to_v6 = eq to_v6_ok, 1
