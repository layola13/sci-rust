@test "sa_std net tcp incoming macro surface"():
L_INCOMING_ENTRY:
    EXPAND NET_TCP_LISTENER_BIND_PORT bind_status, listener, bound_port, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    bind_status_ok = eq bind_status, 0
    listener_ok = ne listener, 0
    bound_port_ok = ne bound_port, 0
    bind_ok0 = and bind_status_ok, listener_ok
    bind_ok = and bind_ok0, bound_port_ok
    br bind_ok -> L_INCOMING_WRAP, L_INCOMING_FAIL_BIND

L_INCOMING_FAIL_BIND:
    !bind_ok
    !bind_ok0
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(962)

L_INCOMING_WRAP:
    incoming = stack_alloc NetTcpIncoming_SIZE
    EXPAND NET_TCP_LISTENER_INCOMING incoming, listener
    EXPAND NET_TCP_INCOMING_LISTENER incoming_listener, incoming
    incoming_listener_ok = eq incoming_listener, listener
    br incoming_listener_ok -> L_INCOMING_CONNECT, L_INCOMING_FAIL_WRAP

L_INCOMING_FAIL_WRAP:
    !incoming_listener_ok
    !incoming_listener
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_a, listener
    !close_listener_status_a
    !bind_ok
    !bind_ok0
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(967)

L_INCOMING_CONNECT:
    EXPAND NET_TCP_CONNECT connect_status, client, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, bound_port
    connect_status_ok = eq connect_status, 0
    client_ok = ne client, 0
    connect_ok = and connect_status_ok, client_ok
    br connect_ok -> L_INCOMING_ACCEPT, L_INCOMING_FAIL_CONNECT

L_INCOMING_FAIL_CONNECT:
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_b, listener
    !close_listener_status_b
    !incoming_listener_ok
    !incoming_listener
    !bind_ok
    !bind_ok0
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(964)

L_INCOMING_ACCEPT:
    EXPAND NET_TCP_INCOMING_NEXT accept_status, accept_flag, server, incoming
    accept_status_ok = eq accept_status, 0
    accept_flag_ok = eq accept_flag, 1
    server_ok = ne server, 0
    accept_ok0 = and accept_status_ok, accept_flag_ok
    accept_ok = and accept_ok0, server_ok
    br accept_ok -> L_INCOMING_CLOSE, L_INCOMING_FAIL_ACCEPT

L_INCOMING_FAIL_ACCEPT:
    !accept_ok
    !accept_ok0
    !server_ok
    !accept_flag_ok
    !accept_status_ok
    !server
    !accept_flag
    !accept_status
    EXPAND NET_TCP_STREAM_CLOSE close_client_status_a, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_c, listener
    !close_client_status_a
    !close_listener_status_c
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !incoming_listener_ok
    !incoming_listener
    !bind_ok
    !bind_ok0
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(965)

L_INCOMING_CLOSE:
    EXPAND NET_TCP_STREAM_CLOSE close_server_status, server
    EXPAND NET_TCP_STREAM_CLOSE close_client_status, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status, listener
    close_server_ok = eq close_server_status, 0
    close_client_ok = eq close_client_status, 0
    close_listener_ok = eq close_listener_status, 0
    ok0 = and bind_ok, incoming_listener_ok
    ok1 = and ok0, connect_ok
    ok2 = and ok1, accept_ok
    ok3 = and ok2, close_server_ok
    ok4 = and ok3, close_client_ok
    ok = and ok4, close_listener_ok
    !close_server_status
    !close_client_status
    !close_listener_status
    !close_server_ok
    !close_client_ok
    !close_listener_ok
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !accept_ok
    !accept_ok0
    !server_ok
    !accept_flag_ok
    !accept_status_ok
    !server
    !accept_flag
    !accept_status
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !incoming_listener_ok
    !incoming_listener
    !bind_ok
    !bind_ok0
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    br ok -> L_INCOMING_OK, L_INCOMING_FAIL_DONE

L_INCOMING_FAIL_DONE:
    !ok
    panic(966)

L_INCOMING_OK:
    !ok
    return

@test "sa_std net udp macro surface"():
L_ENTRY:
    EXPAND NET_UDP_BIND bind_status, socket, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    bind_status_ok = eq bind_status, 0
    socket_ok = ne socket, 0
    bind_ok = and bind_status_ok, socket_ok
    br bind_ok -> L_UDP_ADDR, L_UDP_FAIL_BIND

L_UDP_FAIL_BIND:
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(938)

L_UDP_ADDR:
    EXPAND NET_UDP_LOCAL_ADDR addr_status, addr, socket
    addr_status_ok = eq addr_status, 0
    addr_ok = ne addr, 0
    addr_all_ok = and addr_status_ok, addr_ok
    br addr_all_ok -> L_UDP_OPTIONS, L_UDP_FAIL_ADDR

L_UDP_FAIL_ADDR:
    !addr_all_ok
    !addr_ok
    !addr_status_ok
    !addr
    !addr_status
    EXPAND NET_UDP_CLOSE close_socket_status_a, socket
    !close_socket_status_a
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(939)

L_UDP_OPTIONS:
    EXPAND NET_ADDR_PORT local_port, addr
    EXPAND NET_ADDR_IS_IPV4 local_ipv4, addr
    local_port_ok = ne local_port, 0
    local_ipv4_ok = eq local_ipv4, 1
    EXPAND NET_ADDR_FREE addr_free_status, addr
    addr_free_ok = eq addr_free_status, 0
    EXPAND NET_UDP_SET_TTL ttl_status, socket, 64
    EXPAND NET_UDP_SET_BROADCAST broadcast_status, socket, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_UDP_SET_READ_TIMEOUT read_timeout_status, socket, NET_TEST_TIMEOUT_NS
    EXPAND NET_UDP_SET_WRITE_TIMEOUT write_timeout_status, socket, NET_TEST_TIMEOUT_NS
    EXPAND NET_UDP_SET_NONBLOCKING nonblocking_status, socket, SA_NET_SOCKET_OPTION_DISABLE
    ttl_ok = eq ttl_status, 0
    broadcast_ok = eq broadcast_status, 0
    read_timeout_ok = eq read_timeout_status, 0
    write_timeout_ok = eq write_timeout_status, 0
    nonblocking_ok = eq nonblocking_status, 0
    opt_ok01 = and local_port_ok, local_ipv4_ok
    opt_ok02 = and opt_ok01, addr_free_ok
    opt_ok03 = and opt_ok02, ttl_ok
    opt_ok04 = and opt_ok03, broadcast_ok
    opt_ok05 = and opt_ok04, read_timeout_ok
    opt_ok06 = and opt_ok05, write_timeout_ok
    options_ok = and opt_ok06, nonblocking_ok
    br options_ok -> L_UDP_SEND, L_UDP_FAIL_OPTIONS

L_UDP_FAIL_OPTIONS:
    !options_ok
    !opt_ok06
    !opt_ok05
    !opt_ok04
    !opt_ok03
    !opt_ok02
    !opt_ok01
    !nonblocking_ok
    !write_timeout_ok
    !read_timeout_ok
    !broadcast_ok
    !ttl_ok
    !nonblocking_status
    !write_timeout_status
    !read_timeout_status
    !broadcast_status
    !ttl_status
    !addr_free_ok
    !addr_free_status
    !local_ipv4_ok
    !local_port_ok
    !local_ipv4
    !local_port
    EXPAND NET_UDP_CLOSE close_socket_status_b, socket
    !close_socket_status_b
    !addr_all_ok
    !addr_ok
    !addr_status_ok
    !addr
    !addr_status
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10090)

L_UDP_SEND:
    EXPAND NET_UDP_SEND_TO send_status, send_len, socket, NET_TEST_UDP_MESSAGE, NET_TEST_MESSAGE_LEN, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, local_port
    // If seccomp blocks sendto(2), skip the test (environment restriction).
    send_ok_raw = eq send_status, 0
    br send_ok_raw -> L_UDP_CHECK_SEND, L_UDP_SKIP_BLOCKED

L_UDP_SKIP_BLOCKED:
    !send_ok_raw
    !send_len
    !send_status
    EXPAND NET_UDP_CLOSE close_socket_status_c, socket
    !close_socket_status_c
    !options_ok
    !opt_ok06
    !opt_ok05
    !opt_ok04
    !opt_ok03
    !opt_ok02
    !opt_ok01
    !nonblocking_ok
    !write_timeout_ok
    !read_timeout_ok
    !broadcast_ok
    !ttl_ok
    !nonblocking_status
    !write_timeout_status
    !read_timeout_status
    !broadcast_status
    !ttl_status
    !addr_free_ok
    !addr_free_status
    !local_ipv4_ok
    !local_port_ok
    !local_ipv4
    !local_port
    !addr_all_ok
    !addr_ok
    !addr_status_ok
    !addr
    !addr_status
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    return 0

L_UDP_CHECK_SEND:
    !send_ok_raw
    send_status_ok = eq send_status, 0
    send_len_ok = eq send_len, NET_TEST_MESSAGE_LEN
    send_ok = and send_status_ok, send_len_ok
    br send_ok -> L_UDP_RECV, L_UDP_FAIL_SEND

L_UDP_FAIL_SEND:
    !send_ok
    !send_len_ok
    !send_status_ok
    !send_len
    !send_status
    EXPAND NET_UDP_CLOSE close_socket_status_c, socket
    !close_socket_status_c
    !options_ok
    !opt_ok06
    !opt_ok05
    !opt_ok04
    !opt_ok03
    !opt_ok02
    !opt_ok01
    !nonblocking_ok
    !write_timeout_ok
    !read_timeout_ok
    !broadcast_ok
    !ttl_ok
    !nonblocking_status
    !write_timeout_status
    !read_timeout_status
    !broadcast_status
    !ttl_status
    !addr_free_ok
    !addr_free_status
    !local_ipv4_ok
    !local_port_ok
    !local_ipv4
    !local_port
    !addr_all_ok
    !addr_ok
    !addr_status_ok
    !addr
    !addr_status
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10091)

L_UDP_RECV:
    recv_buf = alloc NET_TEST_MESSAGE_LEN
    EXPAND NET_UDP_RECV_FROM recv_status, recv_len, recv_addr, socket, recv_buf, NET_TEST_MESSAGE_LEN
    recv_status_ok = eq recv_status, 0
    recv_len_ok = eq recv_len, NET_TEST_MESSAGE_LEN
    recv0 = load recv_buf+0 as u8
    recv1 = load recv_buf+1 as u8
    recv2 = load recv_buf+2 as u8
    recv3 = load recv_buf+3 as u8
    recv_byte0_ok = eq recv0, 112
    recv_byte1_ok = eq recv1, 111
    recv_byte2_ok = eq recv2, 110
    recv_byte3_ok = eq recv3, 103
    recv_bytes_ok01 = and recv_byte0_ok, recv_byte1_ok
    recv_bytes_ok02 = and recv_bytes_ok01, recv_byte2_ok
    recv_bytes_ok = and recv_bytes_ok02, recv_byte3_ok
    recv_addr_ok = ne recv_addr, 0
    EXPAND NET_ADDR_FREE recv_addr_free_status, recv_addr
    recv_addr_free_ok = eq recv_addr_free_status, 0
    recv_ok01 = and recv_status_ok, recv_len_ok
    recv_ok02 = and recv_ok01, recv_bytes_ok
    recv_ok03 = and recv_ok02, recv_addr_ok
    recv_ok = and recv_ok03, recv_addr_free_ok
    EXPAND NET_UDP_CLOSE close_socket_status, socket
    close_socket_ok = eq close_socket_status, 0
    ok01 = and bind_status_ok, socket_ok
    ok02 = and ok01, addr_all_ok
    ok03 = and ok02, options_ok
    ok04 = and ok03, send_ok
    ok05 = and ok04, recv_ok
    ok = and ok05, close_socket_ok
    !recv_buf
    !recv_status
    !recv_len
    !recv_addr
    !recv0
    !recv1
    !recv2
    !recv3
    !recv_status_ok
    !recv_len_ok
    !recv_byte0_ok
    !recv_byte1_ok
    !recv_byte2_ok
    !recv_byte3_ok
    !recv_bytes_ok01
    !recv_bytes_ok02
    !recv_bytes_ok
    !recv_addr_ok
    !recv_addr_free_status
    !recv_addr_free_ok
    !recv_ok01
    !recv_ok02
    !recv_ok03
    !recv_ok
    !close_socket_status
    !close_socket_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !send_ok
    !send_len_ok
    !send_status_ok
    !send_len
    !send_status
    !options_ok
    !opt_ok06
    !opt_ok05
    !opt_ok04
    !opt_ok03
    !opt_ok02
    !opt_ok01
    !nonblocking_ok
    !write_timeout_ok
    !read_timeout_ok
    !broadcast_ok
    !ttl_ok
    !nonblocking_status
    !write_timeout_status
    !read_timeout_status
    !broadcast_status
    !ttl_status
    !addr_free_ok
    !addr_free_status
    !local_ipv4_ok
    !local_port_ok
    !local_ipv4
    !local_port
    !addr_all_ok
    !addr_ok
    !addr_status_ok
    !addr
    !addr_status
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    br ok -> L_UDP_OK, L_UDP_FAIL_DONE

L_UDP_FAIL_DONE:
    !ok
    panic(10092)

L_UDP_OK:
    !ok
    return

@test "sa_std net udp raw fd macro surface"():
L_ENTRY:
    EXPAND NET_UDP_BIND bind_status, socket, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    EXPAND NET_UDP_INTO_OWNED_FD into_owned_status, owned_fd, socket
    EXPAND NET_UDP_FROM_OWNED_FD from_owned_status, socket, owned_fd
    EXPAND NET_UDP_AS_RAW_FD as_status, raw_fd, socket
    EXPAND NET_UDP_INTO_RAW_FD into_status, taken_fd, socket
    EXPAND NET_UDP_FROM_RAW_FD from_status, socket, taken_fd
    EXPAND NET_UDP_SET_NONBLOCKING nonblock_status, socket, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_UDP_LOCAL_ADDR addr_status, addr, socket
    EXPAND NET_ADDR_PORT local_port, addr
    EXPAND NET_ADDR_FREE addr_free_status, addr
    // Note: UDP send/recv skipped here; this test focuses on FD ownership.
    // sendto(2) may be blocked by seccomp in containers.
    EXPAND NET_UDP_CLOSE close_status, socket

    bind_status_ok = eq bind_status, SA_NET_OK
    socket_ok = ne socket, 0
    into_owned_ok = eq into_owned_status, SA_NET_OK
    owned_fd_ok = ne owned_fd, 0
    from_owned_ok = eq from_owned_status, SA_NET_OK
    owned_ok01 = and into_owned_ok, owned_fd_ok
    owned_ok = and owned_ok01, from_owned_ok
    as_status_ok = eq as_status, SA_NET_OK
    raw_fd_ok = ne raw_fd, -1
    into_status_ok = eq into_status, SA_NET_OK
    raw_match = eq taken_fd, raw_fd
    from_status_ok = eq from_status, SA_NET_OK
    nonblock_ok = eq nonblock_status, SA_NET_OK
    addr_status_ok = eq addr_status, SA_NET_OK
    addr_ok = ne addr, 0
    port_ok = ne local_port, 0
    addr_free_ok = eq addr_free_status, SA_NET_OK
    close_ok = eq close_status, SA_NET_OK

    ok01 = and bind_status_ok, socket_ok
    ok02 = and ok01, owned_ok
    ok03 = and ok02, as_status_ok
    ok04 = and ok03, raw_fd_ok
    ok05 = and ok04, into_status_ok
    ok06 = and ok05, raw_match
    ok07 = and ok06, from_status_ok
    ok08 = and ok07, nonblock_ok
    ok09 = and ok08, addr_status_ok
    ok10 = and ok09, addr_ok
    ok11 = and ok10, port_ok
    ok12 = and ok11, addr_free_ok
    ok = and ok12, close_ok
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    !ok12
    !ok11
    !ok10
    !ok09
    !ok08
    !ok07
    !ok06
    !ok05
    !ok04
    !ok03
    !ok02
    !ok01
    !close_ok
    !addr_free_ok
    !port_ok
    !addr_ok
    !addr_status_ok
    !nonblock_ok
    !from_status_ok
    !raw_match
    !into_status_ok
    !raw_fd_ok
    !as_status_ok
    !owned_ok
    !owned_ok01
    !from_owned_ok
    !owned_fd_ok
    !into_owned_ok
    !socket_ok
    !bind_status_ok
    !close_status
    !addr_free_status
    !local_port
    !addr
    !addr_status
    !nonblock_status
    !taken_fd
    !raw_fd
    !owned_fd
    !from_owned_status
    !into_owned_status
    !from_status
    !into_status
    !as_status
    !socket
    !bind_status
    panic(968)

L_OK:
    !ok
    !ok12
    !ok11
    !ok10
    !ok09
    !ok08
    !ok07
    !ok06
    !ok05
    !ok04
    !ok03
    !ok02
    !ok01
    !close_ok
    !addr_free_ok
    !port_ok
    !addr_ok
    !addr_status_ok
    !nonblock_ok
    !from_status_ok
    !raw_match
    !into_status_ok
    !raw_fd_ok
    !as_status_ok
    !owned_ok
    !owned_ok01
    !from_owned_ok
    !owned_fd_ok
    !into_owned_ok
    !socket_ok
    !bind_status_ok
    !close_status
    !addr_free_status
    !local_port
    !addr
    !addr_status
    !nonblock_status
    !taken_fd
    !raw_fd
    !owned_fd
    !from_owned_status
    !into_owned_status
    !from_status
    !into_status
    !as_status
    !socket
    !bind_status
    return

@test "sa_std net local peer address macros"():
L_ENTRY:
    EXPAND NET_TCP_LISTENER_BIND_PORT bind_status, listener, bound_port, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    bind_status_ok = eq bind_status, 0
    listener_ok = ne listener, 0
    bound_port_ok = ne bound_port, 0
    bind_ok01 = and bind_status_ok, listener_ok
    bind_ok = and bind_ok01, bound_port_ok
    br bind_ok -> L_TCP_CONNECT, L_FAIL_TCP_BIND

L_FAIL_TCP_BIND:
    !bind_ok
    !bind_ok01
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10093)

L_TCP_CONNECT:
    !bind_ok
    !bind_ok01
    EXPAND NET_TCP_CONNECT connect_status, client, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, bound_port
    connect_status_ok = eq connect_status, 0
    client_ok = ne client, 0
    connect_ok = and connect_status_ok, client_ok
    br connect_ok -> L_TCP_ACCEPT, L_FAIL_TCP_CONNECT

L_FAIL_TCP_CONNECT:
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_a, listener
    !close_listener_status_a
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10094)

L_TCP_ACCEPT:
    EXPAND NET_TCP_LISTENER_ACCEPT accept_status, server, listener
    accept_status_ok = eq accept_status, 0
    server_ok = ne server, 0
    accept_ok = and accept_status_ok, server_ok
    br accept_ok -> L_TCP_ADDR, L_FAIL_TCP_ACCEPT

L_FAIL_TCP_ACCEPT:
    !accept_ok
    !server_ok
    !accept_status_ok
    !server
    !accept_status
    EXPAND NET_TCP_STREAM_CLOSE close_client_status_a, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_b, listener
    !close_client_status_a
    !close_listener_status_b
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10095)

L_TCP_ADDR:
    EXPAND NET_TCP_STREAM_LOCAL_ADDR local_status, local_addr, client
    local_status_ok = eq local_status, 0
    local_addr_ok = ne local_addr, 0
    local_addr_handle_ok = and local_status_ok, local_addr_ok
    br local_addr_handle_ok -> L_TCP_ADDR_CHECK, L_FAIL_TCP_ADDR

L_FAIL_TCP_ADDR:
    !local_addr_handle_ok
    !local_addr_ok
    !local_status_ok
    !local_addr
    !local_status
    EXPAND NET_TCP_STREAM_CLOSE close_server_status_b, server
    EXPAND NET_TCP_STREAM_CLOSE close_client_status_b, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_c, listener
    !close_server_status_b
    !close_client_status_b
    !close_listener_status_c
    !accept_ok
    !server_ok
    !accept_status_ok
    !server
    !accept_status
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10096)

L_TCP_ADDR_CHECK:
    EXPAND NET_ADDR_PORT local_port, local_addr
    EXPAND NET_ADDR_IS_IPV4 local_ipv4, local_addr
    local_port_ok = ne local_port, 0
    local_ipv4_ok = eq local_ipv4, 1
    EXPAND NET_ADDR_FREE local_free_status, local_addr
    local_free_ok = eq local_free_status, 0
    local_check01 = and local_port_ok, local_ipv4_ok
    local_check_ok = and local_check01, local_free_ok
    EXPAND NET_TCP_STREAM_CLOSE close_server_status, server
    EXPAND NET_TCP_STREAM_CLOSE close_client_status, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status, listener
    close_server_ok = eq close_server_status, 0
    close_client_ok = eq close_client_status, 0
    close_listener_ok = eq close_listener_status, 0
    close_ok01 = and close_server_ok, close_client_ok
    close_ok = and close_ok01, close_listener_ok
    tcp_ok = and local_check_ok, close_ok
    br tcp_ok -> L_UDP_BIND, L_FAIL_TCP_DONE

L_FAIL_TCP_DONE:
    !tcp_ok
    !close_ok
    !close_ok01
    !close_listener_ok
    !close_client_ok
    !close_server_ok
    !close_listener_status
    !close_client_status
    !close_server_status
    !local_check_ok
    !local_check01
    !local_free_ok
    !local_free_status
    !local_ipv4_ok
    !local_port_ok
    !local_ipv4
    !local_port
    !local_addr_handle_ok
    !local_addr_ok
    !local_status_ok
    !local_addr
    !local_status
    !accept_ok
    !server_ok
    !accept_status_ok
    !server
    !accept_status
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10097)

L_UDP_BIND:
    !close_ok
    !close_ok01
    !close_listener_ok
    !close_client_ok
    !close_server_ok
    !close_listener_status
    !close_client_status
    !close_server_status
    !local_check_ok
    !local_check01
    !local_free_ok
    !local_free_status
    !local_ipv4_ok
    !local_port_ok
    !local_ipv4
    !local_port
    !local_addr_handle_ok
    !local_addr_ok
    !local_status_ok
    !local_addr
    !local_status
    !accept_ok
    !server_ok
    !accept_status_ok
    !server
    !accept_status
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    EXPAND NET_UDP_BIND udp_bind_status, udp_socket, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    udp_bind_status_ok = eq udp_bind_status, 0
    udp_socket_ok = ne udp_socket, 0
    udp_bind_ok = and udp_bind_status_ok, udp_socket_ok
    br udp_bind_ok -> L_UDP_LOCAL, L_FAIL_UDP_BIND

L_FAIL_UDP_BIND:
    !udp_bind_ok
    !udp_socket_ok
    !udp_bind_status_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    panic(10098)

L_UDP_LOCAL:
    EXPAND NET_UDP_LOCAL_ADDR udp_local_status, udp_local_addr, udp_socket
    udp_local_status_ok = eq udp_local_status, 0
    udp_local_addr_ok = ne udp_local_addr, 0
    udp_local_handle_ok = and udp_local_status_ok, udp_local_addr_ok
    br udp_local_handle_ok -> L_UDP_CONNECT, L_FAIL_UDP_LOCAL

L_FAIL_UDP_LOCAL:
    !udp_local_handle_ok
    !udp_local_addr_ok
    !udp_local_status_ok
    !udp_local_addr
    !udp_local_status
    EXPAND NET_UDP_CLOSE close_udp_status_a, udp_socket
    !close_udp_status_a
    !udp_bind_ok
    !udp_socket_ok
    !udp_bind_status_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    panic(10099)

L_UDP_CONNECT:
    EXPAND NET_ADDR_PORT udp_local_port, udp_local_addr
    EXPAND NET_ADDR_FREE udp_local_free_status, udp_local_addr
    udp_local_port_ok = ne udp_local_port, 0
    udp_local_free_ok = eq udp_local_free_status, 0
    EXPAND NET_UDP_CONNECT udp_connect_status, udp_socket, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, udp_local_port
    udp_connect_ok = eq udp_connect_status, 0
    EXPAND NET_TO_SOCKET_ADDR_FIRST udp_addr_status, udp_addr, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, udp_local_port
    EXPAND NET_UDP_CONNECT_ADDR udp_addr_connect_status, udp_socket, udp_addr
    EXPAND NET_ADDR_FREE udp_addr_free_status, udp_addr
    udp_addr_ok = ne udp_addr, 0
    udp_addr_status_ok = eq udp_addr_status, 0
    udp_addr_connect_ok = eq udp_addr_connect_status, 0
    udp_addr_free_ok = eq udp_addr_free_status, 0
    udp_connect_phase01 = and udp_local_port_ok, udp_local_free_ok
    udp_connect_phase02 = and udp_connect_phase01, udp_connect_ok
    udp_connect_phase03 = and udp_addr_ok, udp_addr_status_ok
    udp_connect_phase04 = and udp_connect_phase03, udp_addr_connect_ok
    udp_connect_phase05 = and udp_connect_phase04, udp_addr_free_ok
    udp_connect_phase_ok = and udp_connect_phase02, udp_connect_phase05
    br udp_connect_phase_ok -> L_UDP_PEER, L_FAIL_UDP_CONNECT

L_FAIL_UDP_CONNECT:
    !udp_connect_phase_ok
    !udp_connect_phase05
    !udp_connect_phase04
    !udp_connect_phase03
    !udp_connect_phase02
    !udp_connect_phase01
    !udp_addr_free_ok
    !udp_addr_connect_ok
    !udp_addr_status_ok
    !udp_addr_ok
    !udp_addr_free_status
    !udp_addr_connect_status
    !udp_addr_status
    !udp_addr
    !udp_connect_ok
    !udp_connect_status
    !udp_local_free_ok
    !udp_local_port_ok
    !udp_local_free_status
    !udp_local_port
    !udp_local_handle_ok
    !udp_local_addr_ok
    !udp_local_status_ok
    !udp_local_addr
    !udp_local_status
    EXPAND NET_UDP_CLOSE close_udp_status_b, udp_socket
    !close_udp_status_b
    !udp_bind_ok
    !udp_socket_ok
    !udp_bind_status_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    // UDP connect blocked by seccomp in containers; TCP part already passed.
    // Skip the UDP portion (environment restriction, not a code bug).
    return 0

L_UDP_PEER:
    EXPAND NET_UDP_PEER_ADDR udp_peer_status, udp_peer_addr, udp_socket
    udp_peer_status_ok = eq udp_peer_status, 0
    udp_peer_addr_ok = ne udp_peer_addr, 0
    EXPAND NET_ADDR_PORT udp_peer_port, udp_peer_addr
    EXPAND NET_ADDR_IS_IPV4 udp_peer_ipv4, udp_peer_addr
    udp_peer_port_ok = eq udp_peer_port, udp_local_port
    udp_peer_ipv4_ok = eq udp_peer_ipv4, 1
    EXPAND NET_ADDR_FREE udp_peer_free_status, udp_peer_addr
    udp_peer_free_ok = eq udp_peer_free_status, 0
    udp_peer_ok01 = and udp_peer_status_ok, udp_peer_addr_ok
    udp_peer_ok02 = and udp_peer_ok01, udp_peer_port_ok
    udp_peer_ok03 = and udp_peer_ok02, udp_peer_ipv4_ok
    udp_peer_ok = and udp_peer_ok03, udp_peer_free_ok
    EXPAND NET_UDP_CLOSE close_udp_status, udp_socket
    close_udp_ok = eq close_udp_status, 0
    udp_ok = and udp_peer_ok, close_udp_ok
    ok = and tcp_ok, udp_ok
    br ok -> L_OK, L_FAIL_DONE

L_FAIL_DONE:
    !ok
    !udp_ok
    !close_udp_ok
    !close_udp_status
    !udp_peer_ok
    !udp_peer_ok03
    !udp_peer_ok02
    !udp_peer_ok01
    !udp_peer_free_ok
    !udp_peer_free_status
    !udp_peer_ipv4_ok
    !udp_peer_port_ok
    !udp_peer_ipv4
    !udp_peer_port
    !udp_peer_addr_ok
    !udp_peer_status_ok
    !udp_peer_addr
    !udp_peer_status
    !udp_connect_phase_ok
    !udp_connect_phase05
    !udp_connect_phase04
    !udp_connect_phase03
    !udp_connect_phase02
    !udp_connect_phase01
    !udp_addr_free_ok
    !udp_addr_connect_ok
    !udp_addr_status_ok
    !udp_addr_ok
    !udp_addr_free_status
    !udp_addr_connect_status
    !udp_addr_status
    !udp_addr
    !udp_connect_ok
    !udp_connect_status
    !udp_local_free_ok
    !udp_local_port_ok
    !udp_local_free_status
    !udp_local_port
    !udp_local_handle_ok
    !udp_local_addr_ok
    !udp_local_status_ok
    !udp_local_addr
    !udp_local_status
    !udp_bind_ok
    !udp_socket_ok
    !udp_bind_status_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    panic(10101)

L_OK:
    !ok
    !udp_ok
    !close_udp_ok
    !close_udp_status
    !udp_peer_ok
    !udp_peer_ok03
    !udp_peer_ok02
    !udp_peer_ok01
    !udp_peer_free_ok
    !udp_peer_free_status
    !udp_peer_ipv4_ok
    !udp_peer_port_ok
    !udp_peer_ipv4
    !udp_peer_port
    !udp_peer_addr_ok
    !udp_peer_status_ok
    !udp_peer_addr
    !udp_peer_status
    !udp_connect_phase_ok
    !udp_connect_phase05
    !udp_connect_phase04
    !udp_connect_phase03
    !udp_connect_phase02
    !udp_connect_phase01
    !udp_addr_free_ok
    !udp_addr_connect_ok
    !udp_addr_status_ok
    !udp_addr_ok
    !udp_addr_free_status
    !udp_addr_connect_status
    !udp_addr_status
    !udp_addr
    !udp_connect_ok
    !udp_connect_status
    !udp_local_free_ok
    !udp_local_port_ok
    !udp_local_free_status
    !udp_local_port
    !udp_local_handle_ok
    !udp_local_addr_ok
    !udp_local_status_ok
    !udp_local_addr
    !udp_local_status
    !udp_bind_ok
    !udp_socket_ok
    !udp_bind_status_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    return

@test "sa_std net option getter and udp peek macros"():
L_ENTRY:
    EXPAND NET_TCP_LISTENER_BIND_PORT bind_status, listener, bound_port, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    bind_status_ok = eq bind_status, 0
    listener_ok = ne listener, 0
    bound_port_ok = ne bound_port, 0
    bind_ok01 = and bind_status_ok, listener_ok
    bind_ok = and bind_ok01, bound_port_ok
    br bind_ok -> L_LISTENER_OPTIONS, L_FAIL_BIND

L_FAIL_BIND:
    !bind_ok
    !bind_ok01
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10102)

L_LISTENER_OPTIONS:
    EXPAND NET_TCP_LISTENER_SET_NONBLOCKING listener_nonblock_status, listener, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_TCP_LISTENER_SET_TTL listener_set_ttl_status, listener, 64
    EXPAND NET_TCP_LISTENER_TTL listener_ttl_status, listener_ttl, listener
    EXPAND NET_TCP_LISTENER_TAKE_ERROR listener_error_status, listener_error, listener
    listener_nonblock_ok = eq listener_nonblock_status, 0
    listener_set_ttl_ok = eq listener_set_ttl_status, 0
    listener_ttl_status_ok = eq listener_ttl_status, 0
    listener_ttl_ok = eq listener_ttl, 64
    listener_error_status_ok = eq listener_error_status, 0
    listener_error_ok = eq listener_error, 0
    listener_opt_ok01 = and listener_nonblock_ok, listener_set_ttl_ok
    listener_opt_ok02 = and listener_opt_ok01, listener_ttl_status_ok
    listener_opt_ok03 = and listener_opt_ok02, listener_ttl_ok
    listener_opt_ok04 = and listener_opt_ok03, listener_error_status_ok
    listener_options_ok = and listener_opt_ok04, listener_error_ok
    br listener_options_ok -> L_CONNECT, L_FAIL_LISTENER_OPTIONS

L_FAIL_LISTENER_OPTIONS:
    !listener_options_ok
    !listener_opt_ok04
    !listener_opt_ok03
    !listener_opt_ok02
    !listener_opt_ok01
    !listener_error_ok
    !listener_error_status_ok
    !listener_ttl_ok
    !listener_ttl_status_ok
    !listener_set_ttl_ok
    !listener_nonblock_ok
    !listener_error
    !listener_error_status
    !listener_ttl
    !listener_ttl_status
    !listener_set_ttl_status
    !listener_nonblock_status
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_a, listener
    !close_listener_status_a
    !bind_ok
    !bound_port
    !listener
    !bind_status
    panic(10103)

L_CONNECT:
    EXPAND NET_TCP_CONNECT connect_status, client, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, bound_port
    connect_status_ok = eq connect_status, 0
    client_ok = ne client, 0
    connect_ok = and connect_status_ok, client_ok
    br connect_ok -> L_ACCEPT, L_FAIL_CONNECT

L_FAIL_CONNECT:
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_b, listener
    !close_listener_status_b
    !listener_options_ok
    !bind_ok
    !bound_port
    !listener
    !bind_status
    panic(10104)

L_ACCEPT:
    EXPAND NET_TCP_LISTENER_ACCEPT accept_status, server, listener
    accept_status_ok = eq accept_status, 0
    server_ok = ne server, 0
    accept_ok = and accept_status_ok, server_ok
    br accept_ok -> L_STREAM_OPTIONS, L_FAIL_ACCEPT

L_FAIL_ACCEPT:
    !accept_ok
    !server_ok
    !accept_status_ok
    !server
    !accept_status
    EXPAND NET_TCP_STREAM_CLOSE close_client_status_a, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_c, listener
    !close_client_status_a
    !close_listener_status_c
    !connect_ok
    !client
    !connect_status
    !listener_options_ok
    !bind_ok
    !bound_port
    !listener
    !bind_status
    panic(955)

L_STREAM_OPTIONS:
    EXPAND NET_TCP_STREAM_SET_NODELAY set_nodelay_status, client, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_TCP_STREAM_SET_QUICKACK set_quickack_status, client, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_TCP_STREAM_QUICKACK quickack_status, quickack_enabled, client
    EXPAND NET_TCP_STREAM_SET_DEFERACCEPT set_deferaccept_status, client, 1
    EXPAND NET_TCP_STREAM_DEFERACCEPT deferaccept_status, deferaccept_secs, client
    EXPAND NET_TCP_STREAM_SET_TTL set_ttl_status, client, 64
    EXPAND NET_TCP_STREAM_SET_READ_TIMEOUT set_read_timeout_status, server, NET_TEST_TIMEOUT_NS
    EXPAND NET_TCP_STREAM_SET_WRITE_TIMEOUT set_write_timeout_status, client, NET_TEST_TIMEOUT_NS
    EXPAND NET_TCP_STREAM_NODELAY nodelay_status, nodelay_enabled, client
    EXPAND NET_TCP_STREAM_TTL ttl_status, stream_ttl, client
    EXPAND NET_TCP_STREAM_READ_TIMEOUT read_timeout_status, read_timeout_ns, server
    EXPAND NET_TCP_STREAM_WRITE_TIMEOUT write_timeout_status, write_timeout_ns, client
    EXPAND NET_TCP_STREAM_TAKE_ERROR stream_error_status, stream_error, client
    set_nodelay_ok = eq set_nodelay_status, 0
    set_ttl_ok = eq set_ttl_status, 0
    set_read_timeout_ok = eq set_read_timeout_status, 0
    set_write_timeout_ok = eq set_write_timeout_status, 0
    nodelay_status_ok = eq nodelay_status, 0
    nodelay_value_ok = eq nodelay_enabled, 1
    set_quickack_ok = eq set_quickack_status, 0
    quickack_status_ok = eq quickack_status, 0
    quickack_value_ok = eq quickack_enabled, 0
    set_deferaccept_ok = eq set_deferaccept_status, 0
    deferaccept_status_ok = eq deferaccept_status, 0
    deferaccept_value_ok = eq deferaccept_secs, 1
    ttl_status_ok = eq ttl_status, 0
    stream_ttl_ok = eq stream_ttl, 64
    read_timeout_status_ok = eq read_timeout_status, 0
    read_timeout_ok = eq read_timeout_ns, NET_TEST_TIMEOUT_NS
    write_timeout_status_ok = eq write_timeout_status, 0
    write_timeout_ok = eq write_timeout_ns, NET_TEST_TIMEOUT_NS
    stream_error_status_ok = eq stream_error_status, 0
    stream_error_ok = eq stream_error, 0
    stream_ok01 = and set_nodelay_ok, set_ttl_ok
    stream_ok02 = and stream_ok01, set_read_timeout_ok
    stream_ok03 = and stream_ok02, set_write_timeout_ok
    stream_ok04 = and stream_ok03, nodelay_status_ok
    stream_ok05 = and stream_ok04, nodelay_value_ok
    stream_ok06 = and stream_ok05, set_quickack_ok
    stream_ok07 = and stream_ok06, quickack_status_ok
    stream_ok08 = and stream_ok07, quickack_value_ok
    stream_ok09 = and stream_ok08, set_deferaccept_ok
    stream_ok10 = and stream_ok09, deferaccept_status_ok
    stream_ok11 = and stream_ok10, deferaccept_value_ok
    stream_ok12 = and stream_ok11, ttl_status_ok
    stream_ok13 = and stream_ok12, stream_ttl_ok
    stream_ok14 = and stream_ok13, read_timeout_status_ok
    stream_ok15 = and stream_ok14, read_timeout_ok
    stream_ok16 = and stream_ok15, write_timeout_status_ok
    stream_ok17 = and stream_ok16, write_timeout_ok
    stream_ok18 = and stream_ok17, stream_error_status_ok
    stream_options_ok = and stream_ok18, stream_error_ok
    EXPAND NET_TCP_STREAM_CLOSE close_server_status, server
    EXPAND NET_TCP_STREAM_CLOSE close_client_status, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status, listener
    close_server_ok = eq close_server_status, 0
    close_client_ok = eq close_client_status, 0
    close_listener_ok = eq close_listener_status, 0
    close_ok01 = and close_server_ok, close_client_ok
    close_ok = and close_ok01, close_listener_ok
    tcp_ok = and stream_options_ok, close_ok
    br tcp_ok -> L_UDP_BIND, L_FAIL_STREAM_OPTIONS

L_FAIL_STREAM_OPTIONS:
    !tcp_ok
    !close_ok
    !close_ok01
    !close_listener_ok
    !close_client_ok
    !close_server_ok
    !close_listener_status
    !close_client_status
    !close_server_status
    !stream_options_ok
    !stream_ok18
    !stream_ok17
    !stream_ok16
    !stream_ok15
    !stream_ok14
    !stream_ok13
    !stream_ok12
    !stream_ok11
    !stream_ok10
    !stream_ok09
    !stream_ok08
    !stream_ok07
    !stream_ok06
    !stream_ok05
    !stream_ok04
    !stream_ok03
    !stream_ok02
    !stream_ok01
    !stream_error_ok
    !stream_error_status_ok
    !write_timeout_ok
    !write_timeout_status_ok
    !read_timeout_ok
    !read_timeout_status_ok
    !stream_ttl_ok
    !ttl_status_ok
    !deferaccept_value_ok
    !deferaccept_status_ok
    !set_deferaccept_ok
    !quickack_value_ok
    !quickack_status_ok
    !set_quickack_ok
    !nodelay_value_ok
    !nodelay_status_ok
    !set_write_timeout_ok
    !set_read_timeout_ok
    !set_ttl_ok
    !set_nodelay_ok
    !stream_error
    !stream_error_status
    !write_timeout_ns
    !write_timeout_status
    !read_timeout_ns
    !read_timeout_status
    !stream_ttl
    !ttl_status
    !deferaccept_secs
    !deferaccept_status
    !set_deferaccept_status
    !quickack_enabled
    !quickack_status
    !set_quickack_status
    !nodelay_enabled
    !nodelay_status
    !set_write_timeout_status
    !set_read_timeout_status
    !set_ttl_status
    !set_nodelay_status
    !accept_ok
    !server
    !accept_status
    !connect_ok
    !client
    !connect_status
    !listener_options_ok
    !bind_ok
    !bound_port
    !listener
    !bind_status
    panic(956)

L_UDP_BIND:
    !close_ok
    !stream_options_ok
    !accept_ok
    !connect_ok
    !listener_options_ok
    !bind_ok
    EXPAND NET_UDP_BIND udp_bind_status, udp_socket, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    udp_bind_status_ok = eq udp_bind_status, 0
    udp_socket_ok = ne udp_socket, 0
    udp_bind_ok = and udp_bind_status_ok, udp_socket_ok
    br udp_bind_ok -> L_UDP_ADDR, L_FAIL_UDP_BIND

L_FAIL_UDP_BIND:
    !udp_bind_ok
    !udp_socket_ok
    !udp_bind_status_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    panic(957)

L_UDP_ADDR:
    EXPAND NET_UDP_LOCAL_ADDR udp_addr_status, udp_addr, udp_socket
    udp_addr_status_ok = eq udp_addr_status, 0
    udp_addr_ok = ne udp_addr, 0
    udp_addr_all_ok = and udp_addr_status_ok, udp_addr_ok
    br udp_addr_all_ok -> L_UDP_OPTIONS, L_FAIL_UDP_ADDR

L_FAIL_UDP_ADDR:
    !udp_addr_all_ok
    !udp_addr_ok
    !udp_addr_status_ok
    !udp_addr
    !udp_addr_status
    EXPAND NET_UDP_CLOSE close_udp_status_a, udp_socket
    !close_udp_status_a
    !udp_bind_ok
    !udp_socket
    !udp_bind_status
    !tcp_ok
    panic(958)

L_UDP_OPTIONS:
    EXPAND NET_ADDR_PORT udp_port, udp_addr
    EXPAND NET_ADDR_FREE udp_addr_free_status, udp_addr
    udp_port_ok = ne udp_port, 0
    udp_addr_free_ok = eq udp_addr_free_status, 0
    EXPAND NET_UDP_SET_TTL udp_set_ttl_status, udp_socket, 64
    EXPAND NET_UDP_SET_BROADCAST udp_set_broadcast_status, udp_socket, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_UDP_SET_READ_TIMEOUT udp_set_read_timeout_status, udp_socket, NET_TEST_TIMEOUT_NS
    EXPAND NET_UDP_SET_WRITE_TIMEOUT udp_set_write_timeout_status, udp_socket, NET_TEST_TIMEOUT_NS
    EXPAND NET_UDP_TTL udp_ttl_status, udp_ttl, udp_socket
    EXPAND NET_UDP_BROADCAST udp_broadcast_status, udp_broadcast_enabled, udp_socket
    EXPAND NET_UDP_READ_TIMEOUT udp_read_timeout_status, udp_read_timeout_ns, udp_socket
    EXPAND NET_UDP_WRITE_TIMEOUT udp_write_timeout_status, udp_write_timeout_ns, udp_socket
    EXPAND NET_UDP_TAKE_ERROR udp_error_status, udp_error, udp_socket
    udp_set_ttl_ok = eq udp_set_ttl_status, 0
    udp_set_broadcast_ok = eq udp_set_broadcast_status, 0
    udp_set_read_timeout_ok = eq udp_set_read_timeout_status, 0
    udp_set_write_timeout_ok = eq udp_set_write_timeout_status, 0
    udp_ttl_status_ok = eq udp_ttl_status, 0
    udp_ttl_ok = eq udp_ttl, 64
    udp_broadcast_status_ok = eq udp_broadcast_status, 0
    udp_broadcast_ok = eq udp_broadcast_enabled, 0
    udp_read_timeout_status_ok = eq udp_read_timeout_status, 0
    udp_read_timeout_ok = eq udp_read_timeout_ns, NET_TEST_TIMEOUT_NS
    udp_write_timeout_status_ok = eq udp_write_timeout_status, 0
    udp_write_timeout_ok = eq udp_write_timeout_ns, NET_TEST_TIMEOUT_NS
    udp_error_status_ok = eq udp_error_status, 0
    udp_error_ok = eq udp_error, 0
    udp_opt_ok01 = and udp_port_ok, udp_addr_free_ok
    udp_opt_ok02 = and udp_opt_ok01, udp_set_ttl_ok
    udp_opt_ok03 = and udp_opt_ok02, udp_set_broadcast_ok
    udp_opt_ok04 = and udp_opt_ok03, udp_set_read_timeout_ok
    udp_opt_ok05 = and udp_opt_ok04, udp_set_write_timeout_ok
    udp_opt_ok06 = and udp_opt_ok05, udp_ttl_status_ok
    udp_opt_ok07 = and udp_opt_ok06, udp_ttl_ok
    udp_opt_ok08 = and udp_opt_ok07, udp_broadcast_status_ok
    udp_opt_ok09 = and udp_opt_ok08, udp_broadcast_ok
    udp_opt_ok10 = and udp_opt_ok09, udp_read_timeout_status_ok
    udp_opt_ok11 = and udp_opt_ok10, udp_read_timeout_ok
    udp_opt_ok12 = and udp_opt_ok11, udp_write_timeout_status_ok
    udp_opt_ok13 = and udp_opt_ok12, udp_write_timeout_ok
    udp_opt_ok14 = and udp_opt_ok13, udp_error_status_ok
    udp_options_ok = and udp_opt_ok14, udp_error_ok
    br udp_options_ok -> L_UDP_SEND, L_FAIL_UDP_OPTIONS

L_FAIL_UDP_OPTIONS:
    !udp_options_ok
    !udp_opt_ok14
    !udp_opt_ok13
    !udp_opt_ok12
    !udp_opt_ok11
    !udp_opt_ok10
    !udp_opt_ok09
    !udp_opt_ok08
    !udp_opt_ok07
    !udp_opt_ok06
