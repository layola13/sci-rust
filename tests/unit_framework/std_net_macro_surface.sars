    !options_ok
    !peer_free_ok
    !peer_addr
    !peer_status
    !nonblocking_status
    !write_timeout_status
    !read_timeout_status
    !ttl_status
    !nodelay_status
    !accept_ok
    !server_ok
    !server
    !accept_status
    !connect_ok
    !client_ok
    !client
    !connect_status
    !addr_all_ok
    !addr_free_ok
    !addr_handle_ok
    !addr_status_ok
    !addr
    !addr_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    br ok -> L_OK, L_FAIL_DONE

L_FAIL_DONE:
    !ok
    panic(937)

L_OK:
    !ok
    return

@test "sa_std net tcp raw fd macro surface"():
L_ENTRY:
    EXPAND NET_TCP_LISTENER_BIND_PORT bind_status, listener, bound_port, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    EXPAND NET_TCP_LISTENER_INTO_OWNED_FD listener_into_owned_status, listener_owned_fd, listener
    EXPAND NET_TCP_LISTENER_FROM_OWNED_FD listener_from_owned_status, listener, listener_owned_fd
    EXPAND NET_TCP_LISTENER_AS_RAW_FD listener_as_status, listener_raw_fd, listener
    EXPAND NET_TCP_LISTENER_INTO_RAW_FD listener_into_status, listener_taken_fd, listener
    EXPAND NET_TCP_LISTENER_FROM_RAW_FD listener_from_status, listener, listener_taken_fd
    EXPAND NET_TCP_LISTENER_SET_NONBLOCKING listener_nonblock_status, listener, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_TCP_CONNECT connect_status, client, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, bound_port
    EXPAND NET_TCP_STREAM_INTO_OWNED_FD client_into_owned_status, client_owned_fd, client
    EXPAND NET_TCP_STREAM_FROM_OWNED_FD client_from_owned_status, client, client_owned_fd
    EXPAND NET_TCP_STREAM_AS_RAW_FD client_as_status, client_raw_fd, client
    EXPAND NET_TCP_STREAM_INTO_RAW_FD client_into_status, client_taken_fd, client
    EXPAND NET_TCP_STREAM_FROM_RAW_FD client_from_status, client, client_taken_fd
    EXPAND NET_TCP_LISTENER_ACCEPT accept_status, server, listener
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_status, listener
    EXPAND NET_TCP_STREAM_INTO_OWNED_FD server_into_owned_status, server_owned_fd, server
    EXPAND NET_TCP_STREAM_FROM_OWNED_FD server_from_owned_status, server, server_owned_fd
    EXPAND NET_TCP_STREAM_AS_RAW_FD server_as_status, server_raw_fd, server
    EXPAND NET_TCP_STREAM_INTO_RAW_FD server_into_status, server_taken_fd, server
    EXPAND NET_TCP_STREAM_FROM_RAW_FD server_from_status, server, server_taken_fd

    send_buf = stack_alloc 4
    recv_buf = stack_alloc 4
    store send_buf+0, 84 as u8
    store send_buf+1, 67 as u8
    store send_buf+2, 80 as u8
    store send_buf+3, 33 as u8
    EXPAND NET_TCP_STREAM_WRITE write_status, write_len, client, send_buf, 4
    EXPAND NET_TCP_STREAM_READ read_status, read_len, server, recv_buf, 4
