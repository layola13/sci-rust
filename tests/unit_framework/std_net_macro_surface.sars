    listener_into_owned_ok = eq listener_into_owned_status, SA_NET_OK
    listener_owned_fd_ok = ne listener_owned_fd, 0
    listener_from_owned_ok = eq listener_from_owned_status, SA_NET_OK
    listener_owned01 = and listener_into_owned_ok, listener_owned_fd_ok
    listener_owned_ok = and listener_owned01, listener_from_owned_ok
    listener_as_ok = eq listener_as_status, SA_NET_OK
    listener_raw_fd_ok = ne listener_raw_fd, -1
    listener_into_ok = eq listener_into_status, SA_NET_OK
    listener_raw_match = eq listener_taken_fd, listener_raw_fd
    listener_from_ok = eq listener_from_status, SA_NET_OK
    listener_nonblock_ok = eq listener_nonblock_status, SA_NET_OK
    connect_ok = eq connect_status, SA_NET_OK
    client_ok = ne client, 0
    client_into_owned_ok = eq client_into_owned_status, SA_NET_OK
    client_owned_fd_ok = ne client_owned_fd, 0
    client_from_owned_ok = eq client_from_owned_status, SA_NET_OK
    client_owned01 = and client_into_owned_ok, client_owned_fd_ok
    client_owned_ok = and client_owned01, client_from_owned_ok
    client_as_ok = eq client_as_status, SA_NET_OK
    client_raw_fd_ok = ne client_raw_fd, -1
    client_into_ok = eq client_into_status, SA_NET_OK
    client_raw_match = eq client_taken_fd, client_raw_fd
    client_from_ok = eq client_from_status, SA_NET_OK
    accept_ok = eq accept_status, SA_NET_OK
    server_ok = ne server, 0
    listener_close_ok = eq listener_close_status, SA_NET_OK
    server_into_owned_ok = eq server_into_owned_status, SA_NET_OK
    server_owned_fd_ok = ne server_owned_fd, 0
    server_from_owned_ok = eq server_from_owned_status, SA_NET_OK
    server_owned01 = and server_into_owned_ok, server_owned_fd_ok
    server_owned_ok = and server_owned01, server_from_owned_ok
    server_as_ok = eq server_as_status, SA_NET_OK
    server_raw_fd_ok = ne server_raw_fd, -1
    server_into_ok = eq server_into_status, SA_NET_OK
    server_raw_match = eq server_taken_fd, server_raw_fd
    server_from_ok = eq server_from_status, SA_NET_OK
    write_status_ok = eq write_status, SA_NET_OK
    write_len_ok = eq write_len, 4
    read_status_ok = eq read_status, SA_NET_OK
    read_len_ok = eq read_len, 4
