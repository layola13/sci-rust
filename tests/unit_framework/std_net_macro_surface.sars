    !s2
    !s3
    !s4
    !s5
    !s6
    !s7
    !bad_ok
    !payload
    !bad_ipaddr
    !ipaddr
    br ok -> L_IPADDR_V6_PARSE_PASS, L_IPADDR_V6_PARSE_FAIL

