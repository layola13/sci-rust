@import "sa_std/net.sars"

@const NET_TEST_LOOPBACK = utf8:"127.0.0.1"
@const NET_TEST_IPV4_ALT = utf8:"192.168.1.42"
@const NET_TEST_IPV4_BAD_RANGE = utf8:"256.0.0.1"
@const NET_TEST_IPV4_BAD_EMPTY = utf8:"127..0.1"
@const NET_TEST_IPV4_BAD_TRAIL = utf8:"127.0.0.1x"
@const NET_TEST_SOCKET_V4 = utf8:"192.168.1.42:8080"
@const NET_TEST_SOCKET_V4_MAX = utf8:"127.0.0.1:65535"
@const NET_TEST_SOCKET_V4_BAD_PORT = utf8:"127.0.0.1:65536"
@const NET_TEST_SOCKET_V4_BAD_EMPTY_PORT = utf8:"127.0.0.1:"
@const NET_TEST_SOCKET_V4_BAD_IPV6 = utf8:"[::1]:8080"
@const NET_TEST_IPV6_LOOPBACK = utf8:"::1"
@const NET_TEST_IPV6_DOC = utf8:"2001:db8::1"
@const NET_TEST_IPV6_BAD = utf8:"::gg"
@const NET_TEST_SOCKET_V6 = utf8:"[::1]:8080"
@const NET_TEST_SOCKET_V6_DOC = utf8:"[2001:db8::1]:443"
@const NET_TEST_SOCKET_V6_BAD_PORT = utf8:"[::1]:65536"
@const NET_TEST_SOCKET_V6_BAD_UNBRACKET = utf8:"::1:8080"
@const NET_TEST_MESSAGE = utf8:"ping"
@const NET_TEST_UDP_MESSAGE = utf8:"pong"

#def NET_TEST_LOOPBACK_LEN = 9
#def NET_TEST_IPV4_ALT_LEN = 12
#def NET_TEST_IPV4_BAD_RANGE_LEN = 9
#def NET_TEST_IPV4_BAD_EMPTY_LEN = 8
#def NET_TEST_IPV4_BAD_TRAIL_LEN = 10
#def NET_TEST_SOCKET_V4_LEN = 17
#def NET_TEST_SOCKET_V4_MAX_LEN = 15
#def NET_TEST_SOCKET_V4_BAD_PORT_LEN = 15
#def NET_TEST_SOCKET_V4_BAD_EMPTY_PORT_LEN = 10
#def NET_TEST_SOCKET_V4_BAD_IPV6_LEN = 10
#def NET_TEST_IPV6_LOOPBACK_LEN = 3
#def NET_TEST_IPV6_DOC_LEN = 11
#def NET_TEST_IPV6_BAD_LEN = 4
#def NET_TEST_SOCKET_V6_LEN = 10
#def NET_TEST_SOCKET_V6_DOC_LEN = 17
#def NET_TEST_SOCKET_V6_BAD_PORT_LEN = 11
#def NET_TEST_SOCKET_V6_BAD_UNBRACKET_LEN = 8
#def NET_TEST_MESSAGE_LEN = 4
#def NET_TEST_TIMEOUT_NS = 100000000

@test "sa_std net to_socket_addrs first macro surface"():
L_ENTRY:
    EXPAND NET_TO_SOCKET_ADDR_FIRST resolve_status, resolved_addr, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 80
    resolve_status_ok = eq resolve_status, 0
    resolved_addr_ok = ne resolved_addr, 0
    resolve_ok = and resolve_status_ok, resolved_addr_ok
    br resolve_ok -> L_CHECK, L_FAIL_RESOLVE

L_FAIL_RESOLVE:
    !resolve_ok
    !resolved_addr_ok
    !resolve_status_ok
    !resolved_addr
    !resolve_status
    panic(10078)

L_CHECK:
    fmt_buf = stack_alloc 32
    EXPAND NET_ADDR_HOST resolved_host_ptr, resolved_addr
    EXPAND NET_ADDR_HOST_LEN resolved_host_len, resolved_addr
    EXPAND NET_ADDR_PORT resolved_port, resolved_addr
    EXPAND NET_ADDR_FAMILY resolved_family, resolved_addr
    EXPAND NET_ADDR_IS_IPV4 resolved_is_ipv4, resolved_addr
    EXPAND NET_ADDR_FORMAT format_status, format_len, resolved_addr, fmt_buf, 32
    fmt_first = load fmt_buf+0 as u8
    fmt_colon = load fmt_buf+9 as u8
    fmt_eight = load fmt_buf+10 as u8
    host_ptr_ok = ne resolved_host_ptr, 0
    host_len_ok = eq resolved_host_len, NET_TEST_LOOPBACK_LEN
    port_ok = eq resolved_port, 80
    family_ok = eq resolved_family, SA_NET_AF_INET
    ipv4_ok = eq resolved_is_ipv4, 1
    format_status_ok = eq format_status, 0
    format_len_ok = eq format_len, 12
    format_first_ok = eq fmt_first, 49
    format_colon_ok = eq fmt_colon, 58
    format_eight_ok = eq fmt_eight, 56
    ok01 = and host_ptr_ok, host_len_ok
    ok02 = and ok01, port_ok
    ok03 = and ok02, family_ok
    ok04 = and ok03, ipv4_ok
    ok05 = and ok04, format_status_ok
    ok06 = and ok05, format_len_ok
    ok07 = and ok06, format_first_ok
    ok08 = and ok07, format_colon_ok
    fields_ok = and ok08, format_eight_ok
    EXPAND NET_ADDR_FREE free_status, resolved_addr
    free_ok = eq free_status, 0
    ok = and fields_ok, free_ok
    !resolved_host_ptr
    !resolved_host_len
    !resolved_port
    !resolved_family
    !resolved_is_ipv4
    !format_status
    !format_len
    !fmt_first
    !fmt_colon
    !fmt_eight
    !host_ptr_ok
    !host_len_ok
    !port_ok
    !family_ok
    !ipv4_ok
    !format_status_ok
    !format_len_ok
    !format_first_ok
    !format_colon_ok
    !format_eight_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !fields_ok
    !free_status
    !resolve_ok
    !resolved_addr_ok
    !resolve_status_ok
    !resolved_addr
    !resolve_status
    br ok -> L_PASS, L_FAIL_FIELDS

L_FAIL_FIELDS:
    !ok
    !free_ok
    panic(10079)

L_PASS:
    !ok
    !free_ok
    return 0

@test "sa_std net ipv4 parse_ascii macro surface"():
L_ENTRY:
    parsed_addr = alloc NetIpv4Addr_SIZE
    alias_addr = alloc NetIpv4Addr_SIZE
    bad_range_addr = alloc NetIpv4Addr_SIZE
    bad_empty_addr = alloc NetIpv4Addr_SIZE
    bad_trail_addr = alloc NetIpv4Addr_SIZE
    EXPAND NET_IPV4_TRY_PARSE_ASCII parse_ok, parsed_addr, NET_TEST_IPV4_ALT, NET_TEST_IPV4_ALT_LEN
    EXPAND NET_IPV4_OCTETS parsed_a, parsed_b, parsed_c, parsed_d, parsed_addr
    EXPAND NET_IPV4_PARSE_ASCII alias_ok, alias_addr, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN
    EXPAND NET_IPV4_OCTETS alias_a, alias_b, alias_c, alias_d, alias_addr
    EXPAND NET_IPV4_TRY_PARSE_ASCII bad_range_ok, bad_range_addr, NET_TEST_IPV4_BAD_RANGE, NET_TEST_IPV4_BAD_RANGE_LEN
    EXPAND NET_IPV4_TRY_PARSE_ASCII bad_empty_ok, bad_empty_addr, NET_TEST_IPV4_BAD_EMPTY, NET_TEST_IPV4_BAD_EMPTY_LEN
    EXPAND NET_IPV4_TRY_PARSE_ASCII bad_trail_ok, bad_trail_addr, NET_TEST_IPV4_BAD_TRAIL, NET_TEST_IPV4_BAD_TRAIL_LEN

    ok_parse = eq parse_ok, 1
    ok_a = eq parsed_a, 192
    ok_b = eq parsed_b, 168
    ok_c = eq parsed_c, 1
    ok_d = eq parsed_d, 42
    ok_alias = eq alias_ok, 1
    ok_alias_a = eq alias_a, 127
    ok_alias_b = eq alias_b, 0
    ok_alias_c = eq alias_c, 0
    ok_alias_d = eq alias_d, 1
    ok_bad_range = eq bad_range_ok, 0
    ok_bad_empty = eq bad_empty_ok, 0
    ok_bad_trail = eq bad_trail_ok, 0

    ok01 = and ok_parse, ok_a
    ok02 = and ok01, ok_b
    ok03 = and ok02, ok_c
    ok04 = and ok03, ok_d
    ok05 = and ok04, ok_alias
    ok06 = and ok05, ok_alias_a
    ok07 = and ok06, ok_alias_b
    ok08 = and ok07, ok_alias_c
    ok09 = and ok08, ok_alias_d
    ok10 = and ok09, ok_bad_range
    ok11 = and ok10, ok_bad_empty
    ok = and ok11, ok_bad_trail

    !ok_parse
    !ok_a
    !ok_b
    !ok_c
    !ok_d
    !ok_alias
    !ok_alias_a
    !ok_alias_b
    !ok_alias_c
    !ok_alias_d
    !ok_bad_range
    !ok_bad_empty
    !ok_bad_trail
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !parse_ok
    !parsed_a
    !parsed_b
    !parsed_c
    !parsed_d
    !parsed_addr
    !alias_ok
    !alias_a
    !alias_b
    !alias_c
    !alias_d
    !alias_addr
    !bad_range_ok
    !bad_range_addr
    !bad_empty_ok
    !bad_empty_addr
    !bad_trail_ok
    !bad_trail_addr
    br ok -> L_IPV4_PARSE_PASS, L_IPV4_PARSE_FAIL

L_IPV4_PARSE_FAIL:
    !ok
    panic(10080)

L_IPV4_PARSE_PASS:
    !ok
    return 0

@test "sa_std net socketaddr v4 parse_ascii macro surface"():
L_ENTRY:
    socket_addr = alloc NetSocketAddrV4_SIZE
    socket_ip = alloc NetIpv4Addr_SIZE
    socket_max_addr = alloc NetSocketAddrV4_SIZE
    bad_port_addr = alloc NetSocketAddrV4_SIZE
    bad_empty_port_addr = alloc NetSocketAddrV4_SIZE
    bad_ipv6_addr = alloc NetSocketAddrV4_SIZE

    EXPAND NET_SOCKET_ADDR_V4_TRY_PARSE_ASCII socket_ok, socket_addr, NET_TEST_SOCKET_V4, NET_TEST_SOCKET_V4_LEN
    EXPAND NET_SOCKET_ADDR_V4_IP socket_ip, socket_addr
    EXPAND NET_IPV4_OCTETS socket_a, socket_b, socket_c, socket_d, socket_ip
    EXPAND NET_SOCKET_ADDR_V4_PORT socket_port, socket_addr
    EXPAND NET_SOCKET_ADDR_V4_PARSE_ASCII max_ok, socket_max_addr, NET_TEST_SOCKET_V4_MAX, NET_TEST_SOCKET_V4_MAX_LEN
    EXPAND NET_SOCKET_ADDR_V4_PORT max_port, socket_max_addr
    EXPAND NET_SOCKET_ADDR_V4_TRY_PARSE_ASCII bad_port_ok, bad_port_addr, NET_TEST_SOCKET_V4_BAD_PORT, NET_TEST_SOCKET_V4_BAD_PORT_LEN
    EXPAND NET_SOCKET_ADDR_V4_TRY_PARSE_ASCII bad_empty_port_ok, bad_empty_port_addr, NET_TEST_SOCKET_V4_BAD_EMPTY_PORT, NET_TEST_SOCKET_V4_BAD_EMPTY_PORT_LEN
    EXPAND NET_SOCKET_ADDR_V4_TRY_PARSE_ASCII bad_ipv6_ok, bad_ipv6_addr, NET_TEST_SOCKET_V4_BAD_IPV6, NET_TEST_SOCKET_V4_BAD_IPV6_LEN

    ok_socket = eq socket_ok, 1
    ok_a = eq socket_a, 192
    ok_b = eq socket_b, 168
    ok_c = eq socket_c, 1
    ok_d = eq socket_d, 42
    ok_port = eq socket_port, 8080
    ok_max = eq max_ok, 1
    ok_max_port = eq max_port, 65535
    ok_bad_port = eq bad_port_ok, 0
    ok_bad_empty_port = eq bad_empty_port_ok, 0
    ok_bad_ipv6 = eq bad_ipv6_ok, 0

    ok01 = and ok_socket, ok_a
    ok02 = and ok01, ok_b
    ok03 = and ok02, ok_c
    ok04 = and ok03, ok_d
    ok05 = and ok04, ok_port
    ok06 = and ok05, ok_max
    ok07 = and ok06, ok_max_port
    ok08 = and ok07, ok_bad_port
    ok09 = and ok08, ok_bad_empty_port
    ok = and ok09, ok_bad_ipv6

    !ok_socket
    !ok_a
    !ok_b
    !ok_c
    !ok_d
    !ok_port
    !ok_max
    !ok_max_port
    !ok_bad_port
    !ok_bad_empty_port
    !ok_bad_ipv6
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !socket_ok
    !socket_a
    !socket_b
    !socket_c
    !socket_d
    !socket_port
    !max_ok
    !max_port
    !bad_port_ok
    !bad_empty_port_ok
    !bad_ipv6_ok
    !bad_ipv6_addr
    !bad_empty_port_addr
    !bad_port_addr
    !socket_max_addr
    !socket_ip
    !socket_addr
    br ok -> L_SOCKET_V4_PARSE_PASS, L_SOCKET_V4_PARSE_FAIL

L_SOCKET_V4_PARSE_FAIL:
    !ok
    panic(10081)

L_SOCKET_V4_PARSE_PASS:
    !ok
    return 0

@test "sa_std net ipaddr parse_ascii ipv4 subset"():
L_ENTRY:
    ipaddr = alloc NetIpAddr_SIZE
    alias_ipaddr = alloc NetIpAddr_SIZE
    bad_ipaddr = alloc NetIpAddr_SIZE
    payload = alloc NetIpv4Addr_SIZE
    alias_payload = alloc NetIpv4Addr_SIZE

    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII parse_ok, ipaddr, NET_TEST_IPV4_ALT, NET_TEST_IPV4_ALT_LEN
    EXPAND NET_IP_ADDR_IS_IPV4 is_v4, ipaddr
    EXPAND NET_IP_ADDR_IS_IPV6 is_v6, ipaddr
    EXPAND NET_IP_ADDR_TO_IPV4 to_v4_ok, payload, ipaddr
    EXPAND NET_IPV4_OCTETS ip_a, ip_b, ip_c, ip_d, payload
    EXPAND NET_IP_ADDR_PARSE_ASCII alias_ok, alias_ipaddr, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN
    EXPAND NET_IP_ADDR_TO_IPV4 alias_to_v4_ok, alias_payload, alias_ipaddr
    EXPAND NET_IPV4_OCTETS alias_a, alias_b, alias_c, alias_d, alias_payload
    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII bad_ok, bad_ipaddr, NET_TEST_SOCKET_V4_BAD_IPV6, NET_TEST_SOCKET_V4_BAD_IPV6_LEN

    ok_parse = eq parse_ok, 1
    ok_is_v4 = eq is_v4, 1
    ok_is_v6 = eq is_v6, 0
    ok_to_v4 = eq to_v4_ok, 1
    ok_a = eq ip_a, 192
    ok_b = eq ip_b, 168
    ok_c = eq ip_c, 1
    ok_d = eq ip_d, 42
    ok_alias = eq alias_ok, 1
    ok_alias_to_v4 = eq alias_to_v4_ok, 1
    ok_alias_a = eq alias_a, 127
    ok_alias_b = eq alias_b, 0
    ok_alias_c = eq alias_c, 0
    ok_alias_d = eq alias_d, 1
    ok_bad = eq bad_ok, 0

    ok01 = and ok_parse, ok_is_v4
    ok02 = and ok01, ok_is_v6
    ok03 = and ok02, ok_to_v4
    ok04 = and ok03, ok_a
    ok05 = and ok04, ok_b
    ok06 = and ok05, ok_c
    ok07 = and ok06, ok_d
    ok08 = and ok07, ok_alias
    ok09 = and ok08, ok_alias_to_v4
    ok10 = and ok09, ok_alias_a
    ok11 = and ok10, ok_alias_b
    ok12 = and ok11, ok_alias_c
    ok13 = and ok12, ok_alias_d
    ok = and ok13, ok_bad

    !ok_parse
    !ok_is_v4
    !ok_is_v6
    !ok_to_v4
    !ok_a
    !ok_b
    !ok_c
    !ok_d
    !ok_alias
    !ok_alias_to_v4
    !ok_alias_a
    !ok_alias_b
    !ok_alias_c
    !ok_alias_d
    !ok_bad
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !parse_ok
    !is_v4
    !is_v6
    !to_v4_ok
    !ip_a
    !ip_b
    !ip_c
    !ip_d
    !alias_ok
    !alias_to_v4_ok
    !alias_a
    !alias_b
    !alias_c
    !alias_d
    !bad_ok
    !alias_payload
    !payload
    !bad_ipaddr
    !alias_ipaddr
    !ipaddr
    br ok -> L_IPADDR_PARSE_PASS, L_IPADDR_PARSE_FAIL

L_IPADDR_PARSE_FAIL:
    !ok
    panic(10082)

L_IPADDR_PARSE_PASS:
    !ok
    return 0

@test "sa_std net socketaddr parse_ascii ipv4 subset"():
L_ENTRY:
    socket_addr = alloc NetSocketAddr_SIZE
    alias_addr = alloc NetSocketAddr_SIZE
    bad_addr = alloc NetSocketAddr_SIZE
    ipaddr = alloc NetIpAddr_SIZE
    ipv4 = alloc NetIpv4Addr_SIZE

    EXPAND NET_SOCKET_ADDR_TRY_PARSE_ASCII parse_ok, socket_addr, NET_TEST_SOCKET_V4, NET_TEST_SOCKET_V4_LEN
    EXPAND NET_SOCKET_ADDR_IS_IPV4 is_v4, socket_addr
    EXPAND NET_SOCKET_ADDR_IS_IPV6 is_v6, socket_addr
    EXPAND NET_SOCKET_ADDR_PORT port, socket_addr
    EXPAND NET_SOCKET_ADDR_IP ipaddr, socket_addr
    EXPAND NET_IP_ADDR_TO_IPV4 to_v4_ok, ipv4, ipaddr
    EXPAND NET_IPV4_OCTETS ip_a, ip_b, ip_c, ip_d, ipv4
    EXPAND NET_SOCKET_ADDR_PARSE_ASCII alias_ok, alias_addr, NET_TEST_SOCKET_V4_MAX, NET_TEST_SOCKET_V4_MAX_LEN
    EXPAND NET_SOCKET_ADDR_PORT alias_port, alias_addr
    EXPAND NET_SOCKET_ADDR_TRY_PARSE_ASCII bad_ok, bad_addr, NET_TEST_SOCKET_V6_BAD_PORT, NET_TEST_SOCKET_V6_BAD_PORT_LEN

    ok_parse = eq parse_ok, 1
    ok_is_v4 = eq is_v4, 1
    ok_is_v6 = eq is_v6, 0
    ok_port = eq port, 8080
    ok_to_v4 = eq to_v4_ok, 1
    ok_a = eq ip_a, 192
    ok_b = eq ip_b, 168
    ok_c = eq ip_c, 1
    ok_d = eq ip_d, 42
    ok_alias = eq alias_ok, 1
    ok_alias_port = eq alias_port, 65535
    ok_bad = eq bad_ok, 0

    ok01 = and ok_parse, ok_is_v4
    ok02 = and ok01, ok_is_v6
    ok03 = and ok02, ok_port
    ok04 = and ok03, ok_to_v4
    ok05 = and ok04, ok_a
    ok06 = and ok05, ok_b
    ok07 = and ok06, ok_c
    ok08 = and ok07, ok_d
    ok09 = and ok08, ok_alias
    ok10 = and ok09, ok_alias_port
    ok = and ok10, ok_bad

    !ok_parse
    !ok_is_v4
    !ok_is_v6
    !ok_port
    !ok_to_v4
    !ok_a
    !ok_b
    !ok_c
    !ok_d
    !ok_alias
    !ok_alias_port
    !ok_bad
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !parse_ok
    !is_v4
    !is_v6
    !port
    !to_v4_ok
    !ip_a
    !ip_b
    !ip_c
    !ip_d
    !alias_ok
    !alias_port
    !bad_ok
    !ipv4
    !ipaddr
    !bad_addr
    !alias_addr
    !socket_addr
    br ok -> L_SOCKET_ADDR_PARSE_PASS, L_SOCKET_ADDR_PARSE_FAIL

L_SOCKET_ADDR_PARSE_FAIL:
    !ok
    panic(10083)

L_SOCKET_ADDR_PARSE_PASS:
    !ok
    return 0

@test "sa_std net tcp macro surface"():
L_ENTRY:
    EXPAND NET_TCP_LISTENER_BIND_PORT bind_status, listener, bound_port, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    bind_status_ok = eq bind_status, 0
    listener_ok = ne listener, 0
    bound_port_ok = ne bound_port, 0
    bind_ok0 = and bind_status_ok, listener_ok
    bind_ok = and bind_ok0, bound_port_ok
    br bind_ok -> L_ADDR, L_FAIL_BIND

L_FAIL_BIND:
    !bind_ok
    !bind_ok0
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10084)

L_ADDR:
    !bind_ok
    !bind_ok0
    EXPAND NET_TCP_LISTENER_LOCAL_ADDR addr_status, addr, listener
    addr_status_ok = eq addr_status, 0
    addr_handle_ok = ne addr, 0
    addr_ok = and addr_status_ok, addr_handle_ok
    br addr_ok -> L_ADDR_CHECK, L_FAIL_ADDR

L_FAIL_ADDR:
    !addr_ok
    !addr_handle_ok
    !addr_status_ok
    !addr
    !addr_status
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_a, listener
    !close_listener_status_a
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10085)

L_ADDR_CHECK:
    !addr_ok
    EXPAND NET_ADDR_HOST host_ptr, addr
    EXPAND NET_ADDR_HOST_LEN host_len, addr
    EXPAND NET_ADDR_PORT addr_port, addr
    EXPAND NET_ADDR_FAMILY addr_family, addr
    EXPAND NET_ADDR_IS_IPV4 addr_is_ipv4, addr
    host_ptr_ok = ne host_ptr, 0
    host_len_ok = eq host_len, NET_TEST_LOOPBACK_LEN
    addr_port_ok = eq addr_port, bound_port
    addr_family_ok = eq addr_family, SA_NET_AF_INET
    addr_ipv4_ok = eq addr_is_ipv4, 1
    addr_ok01 = and host_ptr_ok, host_len_ok
    addr_ok02 = and addr_ok01, addr_port_ok
    addr_ok03 = and addr_ok02, addr_family_ok
    addr_fields_ok = and addr_ok03, addr_ipv4_ok
    EXPAND NET_ADDR_FREE addr_free_status, addr
    addr_free_ok = eq addr_free_status, 0
    addr_all_ok = and addr_fields_ok, addr_free_ok
    !host_ptr
    !host_len
    !addr_port
    !addr_family
    !addr_is_ipv4
    !host_ptr_ok
    !host_len_ok
    !addr_port_ok
    !addr_family_ok
    !addr_ipv4_ok
    !addr_ok01
    !addr_ok02
    !addr_ok03
    !addr_fields_ok
    !addr_free_status
    br addr_all_ok -> L_CONNECT, L_FAIL_ADDR_FIELDS

L_FAIL_ADDR_FIELDS:
    !addr_all_ok
    !addr_free_ok
    !addr_handle_ok
    !addr_status_ok
    !addr
    !addr_status
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_b, listener
    !close_listener_status_b
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10086)

L_CONNECT:
    EXPAND NET_TCP_CONNECT connect_status, client, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, bound_port
    connect_status_ok = eq connect_status, 0
    client_ok = ne client, 0
    connect_ok = and connect_status_ok, client_ok
    !connect_status_ok
    br connect_ok -> L_ACCEPT, L_FAIL_CONNECT

L_FAIL_CONNECT:
    !connect_ok
    !client_ok
    !client
    !connect_status
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_c, listener
    !close_listener_status_c
    !addr_all_ok
    !addr_free_ok
    !addr_handle_ok
    !addr_status_ok
    !addr
    !addr_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10087)

L_ACCEPT:
    EXPAND NET_TCP_LISTENER_ACCEPT accept_status, server, listener
    accept_status_ok = eq accept_status, 0
    server_ok = ne server, 0
    accept_ok = and accept_status_ok, server_ok
    !accept_status_ok
    br accept_ok -> L_OPTIONS, L_FAIL_ACCEPT

L_FAIL_ACCEPT:
    !accept_ok
    !server_ok
    !server
    !accept_status
    EXPAND NET_TCP_STREAM_CLOSE close_client_status_a, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_d, listener
    !close_client_status_a
    !close_listener_status_d
    !connect_ok
    !client_ok
    !client
    !connect_status
    !addr_all_ok
    !addr_free_ok
    !addr_handle_ok
    !addr_status_ok
    !addr
    !addr_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10088)

L_OPTIONS:
    EXPAND NET_TCP_STREAM_SET_NODELAY nodelay_status, client, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_TCP_STREAM_SET_TTL ttl_status, client, 64
    EXPAND NET_TCP_STREAM_SET_READ_TIMEOUT read_timeout_status, server, NET_TEST_TIMEOUT_NS
    EXPAND NET_TCP_STREAM_SET_WRITE_TIMEOUT write_timeout_status, client, NET_TEST_TIMEOUT_NS
    EXPAND NET_TCP_STREAM_SET_NONBLOCKING nonblocking_status, server, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_TCP_STREAM_PEER_ADDR peer_status, peer_addr, server
    peer_status_ok = eq peer_status, 0
    peer_addr_ok = ne peer_addr, 0
    peer_ok = and peer_status_ok, peer_addr_ok
    EXPAND NET_ADDR_FREE peer_free_status, peer_addr
    peer_free_ok = eq peer_free_status, 0
    nodelay_ok = eq nodelay_status, 0
    ttl_ok = eq ttl_status, 0
    read_timeout_ok = eq read_timeout_status, 0
    write_timeout_ok = eq write_timeout_status, 0
    nonblocking_ok = eq nonblocking_status, 0
    opt_ok01 = and nodelay_ok, ttl_ok
    opt_ok02 = and opt_ok01, read_timeout_ok
    opt_ok03 = and opt_ok02, write_timeout_ok
    opt_ok04 = and opt_ok03, nonblocking_ok
    opt_ok05 = and opt_ok04, peer_ok
    options_ok = and opt_ok05, peer_free_ok
    !peer_status_ok
    !peer_addr_ok
    !peer_ok
    !peer_free_status
    !nodelay_ok
    !ttl_ok
    !read_timeout_ok
    !write_timeout_ok
    !nonblocking_ok
    !opt_ok01
    !opt_ok02
    !opt_ok03
    !opt_ok04
    !opt_ok05
    br options_ok -> L_WRITE, L_FAIL_OPTIONS

L_FAIL_OPTIONS:
    !options_ok
    !peer_free_ok
    !peer_addr
    !peer_status
    !nonblocking_status
    !write_timeout_status
    !read_timeout_status
    !ttl_status
    !nodelay_status
    EXPAND NET_TCP_STREAM_CLOSE close_server_status_a, server
    EXPAND NET_TCP_STREAM_CLOSE close_client_status_b, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_e, listener
    !close_server_status_a
    !close_client_status_b
    !close_listener_status_e
    !accept_ok
    !server_ok
    !server
    !accept_status
    !connect_ok
    !client_ok
    !client
    !connect_status
    !addr_all_ok
    !addr_free_ok
    !addr_handle_ok
    !addr_status_ok
    !addr
    !addr_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(935)

L_WRITE:
    EXPAND NET_TCP_STREAM_WRITE_ALL write_all_status, client, NET_TEST_MESSAGE, NET_TEST_MESSAGE_LEN
    EXPAND NET_TCP_STREAM_FLUSH flush_status, client
    write_all_ok = eq write_all_status, 0
    flush_ok = eq flush_status, 0
    write_ok = and write_all_ok, flush_ok
    !write_all_ok
    !flush_ok
    br write_ok -> L_PEEK_READ, L_FAIL_WRITE

L_FAIL_WRITE:
    !write_ok
    !flush_status
    !write_all_status
    EXPAND NET_TCP_STREAM_CLOSE close_server_status_b, server
    EXPAND NET_TCP_STREAM_CLOSE close_client_status_c, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status_f, listener
    !close_server_status_b
    !close_client_status_c
    !close_listener_status_f
    !options_ok
    !peer_free_ok
    !peer_addr
    !peer_status
    !nonblocking_status
    !write_timeout_status
    !read_timeout_status
    !ttl_status
    !nodelay_status
    !accept_ok
    !server_ok
    !server
    !accept_status
    !connect_ok
    !client_ok
    !client
    !connect_status
    !addr_all_ok
    !addr_free_ok
    !addr_handle_ok
    !addr_status_ok
    !addr
    !addr_status
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10089)

L_PEEK_READ:
    peek_buf = alloc NET_TEST_MESSAGE_LEN
    read_buf = alloc NET_TEST_MESSAGE_LEN
    EXPAND NET_TCP_STREAM_PEEK peek_status, peek_len, server, peek_buf, NET_TEST_MESSAGE_LEN
    EXPAND NET_TCP_STREAM_READ read_status, read_len, server, read_buf, NET_TEST_MESSAGE_LEN
    peek_status_ok = eq peek_status, 0
    peek_len_ok = eq peek_len, NET_TEST_MESSAGE_LEN
    read_status_ok = eq read_status, 0
    read_len_ok = eq read_len, NET_TEST_MESSAGE_LEN
    peek0 = load peek_buf+0 as u8
    peek1 = load peek_buf+1 as u8
    peek2 = load peek_buf+2 as u8
    peek3 = load peek_buf+3 as u8
    read0 = load read_buf+0 as u8
    read1 = load read_buf+1 as u8
    read2 = load read_buf+2 as u8
    read3 = load read_buf+3 as u8
    peek_byte0_ok = eq peek0, 112
    peek_byte1_ok = eq peek1, 105
    peek_byte2_ok = eq peek2, 110
    peek_byte3_ok = eq peek3, 103
    read_byte0_ok = eq read0, 112
    read_byte1_ok = eq read1, 105
    read_byte2_ok = eq read2, 110
    read_byte3_ok = eq read3, 103
    bytes_ok01 = and peek_byte0_ok, peek_byte1_ok
    bytes_ok02 = and bytes_ok01, peek_byte2_ok
    bytes_ok03 = and bytes_ok02, peek_byte3_ok
    bytes_ok04 = and bytes_ok03, read_byte0_ok
    bytes_ok05 = and bytes_ok04, read_byte1_ok
    bytes_ok06 = and bytes_ok05, read_byte2_ok
    bytes_ok = and bytes_ok06, read_byte3_ok
    io_ok01 = and peek_status_ok, peek_len_ok
    io_ok02 = and io_ok01, read_status_ok
    io_ok03 = and io_ok02, read_len_ok
    io_ok = and io_ok03, bytes_ok
    EXPAND NET_TCP_STREAM_CLOSE close_server_status, server
    EXPAND NET_TCP_STREAM_CLOSE close_client_status, client
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status, listener
    close_server_ok = eq close_server_status, 0
    close_client_ok = eq close_client_status, 0
    close_listener_ok = eq close_listener_status, 0
    close_ok01 = and close_server_ok, close_client_ok
    close_ok = and close_ok01, close_listener_ok
    ok01 = and bind_status_ok, listener_ok
    ok02 = and ok01, bound_port_ok
    ok03 = and ok02, addr_status_ok
    ok04 = and ok03, addr_handle_ok
    ok05 = and ok04, addr_all_ok
    ok06 = and ok05, connect_ok
    ok07 = and ok06, accept_ok
    ok08 = and ok07, options_ok
    ok09 = and ok08, write_ok
    ok10 = and ok09, io_ok
    ok = and ok10, close_ok
    !peek_buf
    !read_buf
    !peek_status
    !peek_len
    !read_status
    !read_len
    !peek0
    !peek1
    !peek2
    !peek3
    !read0
    !read1
    !read2
    !read3
    !peek_status_ok
    !peek_len_ok
    !read_status_ok
    !read_len_ok
    !peek_byte0_ok
    !peek_byte1_ok
    !peek_byte2_ok
    !peek_byte3_ok
    !read_byte0_ok
    !read_byte1_ok
    !read_byte2_ok
    !read_byte3_ok
    !bytes_ok01
    !bytes_ok02
    !bytes_ok03
    !bytes_ok04
    !bytes_ok05
    !bytes_ok06
    !bytes_ok
    !io_ok01
    !io_ok02
    !io_ok03
    !io_ok
    !close_server_status
    !close_client_status
    !close_listener_status
    !close_server_ok
    !close_client_ok
    !close_listener_ok
    !close_ok01
    !close_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !write_ok
    !flush_status
