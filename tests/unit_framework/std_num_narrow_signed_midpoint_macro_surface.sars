@import "sa_std/num.sars"

@test "sa_std num narrow signed midpoint macro surface"():
L_ENTRY:
    EXPAND NUM_I8_MIDPOINT i8_pos, 4, 10
    EXPAND NUM_I8_MIDPOINT i8_neg, -128, -127
    EXPAND NUM_I8_MIDPOINT i8_mixed, -7, 0
    EXPAND NUM_I8_MIDPOINT i8_edges, NUM_I8_MIN, NUM_I8_MAX
    EXPAND NUM_I8_MIDPOINT i8_raw, 255, 1

    EXPAND NUM_I16_MIDPOINT i16_pos, 1, 4
    EXPAND NUM_I16_MIDPOINT i16_neg, -32768, -32767
    EXPAND NUM_I16_MIDPOINT i16_mixed, 0, -7
    EXPAND NUM_I16_MIDPOINT i16_edges, NUM_I16_MIN, NUM_I16_MAX
    EXPAND NUM_I16_MIDPOINT i16_raw, 65535, 1

    EXPAND NUM_I32_MIDPOINT i32_pos, 4, 11
    EXPAND NUM_I32_MIDPOINT i32_neg, -2147483648, -2147483647
    EXPAND NUM_I32_MIDPOINT i32_mixed, -1, 2
    EXPAND NUM_I32_MIDPOINT i32_edges, NUM_I32_MIN, NUM_I32_MAX
    EXPAND NUM_I32_MIDPOINT i32_raw, 4294967295, 1

    ok01 = eq i8_pos, 7
    ok02 = eq i8_neg, -127
    ok03 = eq i8_mixed, -3
    ok04 = eq i8_edges, 0
    ok05 = eq i8_raw, 0
    ok06 = eq i16_pos, 2
    ok07 = eq i16_neg, -32767
    ok08 = eq i16_mixed, -3
    ok09 = eq i16_edges, 0
    ok10 = eq i16_raw, 0
    ok11 = eq i32_pos, 7
    ok12 = eq i32_neg, -2147483647
    ok13 = eq i32_mixed, 0
    ok14 = eq i32_edges, 0
    ok15 = eq i32_raw, 0

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    ok = and chain13, ok15

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10673)

L_PASS:
    return 0
