@import "sa_std/vec_deque.sars"
@import "sa_std/core/slice.sars"

@test "sa_std vec_deque hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    data = stack_alloc 32
    store data+0, 20 as u64
    store data+8, 30 as u64
    store data+16, 40 as u64
    store data+24, 50 as u64
    slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 4

    short_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW short_slice, data, 3

    order_data = stack_alloc 32
    store order_data+0, 30 as u64
    store order_data+8, 20 as u64
    store order_data+16, 40 as u64
    store order_data+24, 50 as u64
    order_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW order_slice, order_data, 4

    EXPAND VEC_DEQUE_WITH_CAPACITY wrapped, 4
    EXPAND VEC_DEQUE_PUSH_BACK wrapped, 10
    EXPAND VEC_DEQUE_PUSH_BACK wrapped, 20
    EXPAND VEC_DEQUE_PUSH_BACK wrapped, 30
    EXPAND VEC_DEQUE_PUSH_BACK wrapped, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop_ok, pop_value, wrapped
    EXPAND VEC_DEQUE_PUSH_BACK wrapped, 50

    EXPAND VEC_DEQUE_FROM_SLICE_U64 same_deque, slice
    EXPAND VEC_DEQUE_FROM_SLICE_U64 short_deque, short_slice
    EXPAND VEC_DEQUE_FROM_SLICE_U64 order_deque, order_slice

    write_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW write_hasher
    EXPAND DEFAULT_HASHER_WRITE_VEC_DEQUE_U64 write_hasher, wrapped
    EXPAND DEFAULT_HASHER_FINISH writer_hash, write_hasher

    EXPAND VEC_DEQUE_HASH_U64 wrapped_hash, wrapped
    EXPAND VEC_DEQUE_HASH_U64 same_hash, same_deque
    EXPAND VEC_DEQUE_HASH_U64 short_hash, short_deque
    EXPAND VEC_DEQUE_HASH_U64 order_hash, order_deque
    EXPAND SLICE_HASH_U64 slice_hash, slice
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_VEC_DEQUE_U64 build_hash, builder, wrapped
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_SLICE_U64 build_slice_hash, builder, slice

    state = stack_alloc RandomState_SIZE
    state_manual_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_VEC_DEQUE_U64 state_hash, state, wrapped
    EXPAND RANDOM_STATE_BUILD state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 state_manual_hasher, slice
    EXPAND DEFAULT_HASHER_FINISH state_manual_hash, state_manual_hasher

    EXPAND VEC_DEQUE_PUSH_BACK wrapped, 60
    EXPAND VEC_DEQUE_MAKE_CONTIGUOUS changed_slice, wrapped
    EXPAND VEC_DEQUE_HASH_U64 changed_hash, wrapped
    EXPAND SLICE_HASH_U64 changed_slice_hash, changed_slice
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_VEC_DEQUE_U64 changed_build_hash, builder, wrapped

    pop_ok_matches = eq pop_ok, 1
    pop_value_matches = eq pop_value, 10
    writer_matches_slice = eq writer_hash, slice_hash
    wrapped_matches_slice = eq wrapped_hash, slice_hash
    same_value_matches = eq same_hash, wrapped_hash
    length_matters = ne short_hash, wrapped_hash
    order_matters = ne order_hash, wrapped_hash
    build_matches_deque = eq build_hash, wrapped_hash
    build_matches_slice = eq build_hash, build_slice_hash
    state_matches_manual = eq state_hash, state_manual_hash
    seeded_differs_default = ne state_hash, wrapped_hash
    changed_matches_slice = eq changed_hash, changed_slice_hash
    changed_build_matches = eq changed_build_hash, changed_hash
    changed_differs_old = ne changed_hash, wrapped_hash

    c01 = and pop_ok_matches, pop_value_matches
    c02 = and c01, writer_matches_slice
    c03 = and c02, wrapped_matches_slice
    c04 = and c03, same_value_matches
    c05 = and c04, length_matters
    c06 = and c05, order_matters
    c07 = and c06, build_matches_deque
    c08 = and c07, build_matches_slice
    c09 = and c08, state_matches_manual
    c10 = and c09, seeded_differs_default
    c11 = and c10, changed_matches_slice
    c12 = and c11, changed_build_matches
    ok = and c12, changed_differs_old

    !pop_ok
    !pop_value
    !writer_hash
    !wrapped_hash
    !same_hash
    !short_hash
    !order_hash
    !slice_hash
    !build_hash
    !build_slice_hash
    !state_hash
    !state_manual_hash
    !changed_hash
    !changed_slice_hash
    !changed_build_hash
    !pop_ok_matches
    !pop_value_matches
    !writer_matches_slice
    !wrapped_matches_slice
    !same_value_matches
    !length_matters
    !order_matters
    !build_matches_deque
    !build_matches_slice
    !state_matches_manual
    !seeded_differs_default
    !changed_matches_slice
    !changed_build_matches
    !changed_differs_old
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !changed_slice
    EXPAND VEC_DEQUE_FREE wrapped
    EXPAND VEC_DEQUE_FREE same_deque
    EXPAND VEC_DEQUE_FREE short_deque
    EXPAND VEC_DEQUE_FREE order_deque
    !builder
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10585)

L_PASS:
    !ok
    return 0
