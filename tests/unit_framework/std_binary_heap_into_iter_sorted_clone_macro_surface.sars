@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap into_iter_sorted clone macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW heap
    EXPAND BINARY_HEAP_PUSH_U64 heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 heap, 4
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 iter, backing_vec, heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 first_has, first, iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_CLONE_U64 clone_iter, clone_backing, iter
    EXPAND VEC_LEN clone_backing_len, clone_backing
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 original_len_after_clone, iter
    EXPAND VEC_GET_MUT_U64 clone_mut_ok, clone_mut_ptr, clone_backing, 0
    store clone_mut_ptr+0, 40 as u64
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 clone_first_has, clone_first, clone_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 clone_second_has, clone_second, clone_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 clone_third_has, clone_third, clone_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 clone_done_has, clone_done, clone_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 original_len_after_clone_consumed, iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 original_next_has, original_next, iter
    EXPAND VEC_GET_U64 original_second, backing_vec, 1

    EXPAND BINARY_HEAP_NEW empty_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 empty_iter, empty_backing, empty_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_CLONE_U64 empty_clone_iter, empty_clone_backing, empty_iter
    EXPAND VEC_LEN empty_clone_backing_len, empty_clone_backing
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 empty_clone_has, empty_clone, empty_clone_iter

    EXPAND VEC_FREE backing_vec
    EXPAND VEC_FREE clone_backing
    EXPAND VEC_FREE empty_backing
    EXPAND VEC_FREE empty_clone_backing

    ok_first_has = eq first_has, 1
    ok_first = eq first, 5
    ok_clone_backing_len = eq clone_backing_len, 3
    ok_original_len_after_clone = eq original_len_after_clone, 3
    ok_clone_mut = eq clone_mut_ok, 1
    ok_clone_first_has = eq clone_first_has, 1
    ok_clone_first = eq clone_first, 40
    ok_clone_second_has = eq clone_second_has, 1
    ok_clone_second = eq clone_second, 3
    ok_clone_third_has = eq clone_third_has, 1
    ok_clone_third = eq clone_third, 1
    ok_clone_done_has = eq clone_done_has, 0
    ok_clone_done = eq clone_done, 0
    ok_original_len_after_clone_consumed = eq original_len_after_clone_consumed, 3
    ok_original_next_has = eq original_next_has, 1
    ok_original_next = eq original_next, 4
    ok_original_second = eq original_second, 4
    ok_empty_clone_backing_len = eq empty_clone_backing_len, 0
    ok_empty_clone_has = eq empty_clone_has, 0
    ok_empty_clone = eq empty_clone, 0

    ok = and ok_first_has, ok_first
    ok = and ok, ok_clone_backing_len
    ok = and ok, ok_original_len_after_clone
    ok = and ok, ok_clone_mut
    ok = and ok, ok_clone_first_has
    ok = and ok, ok_clone_first
    ok = and ok, ok_clone_second_has
    ok = and ok, ok_clone_second
    ok = and ok, ok_clone_third_has
    ok = and ok, ok_clone_third
    ok = and ok, ok_clone_done_has
    ok = and ok, ok_clone_done
    ok = and ok, ok_original_len_after_clone_consumed
    ok = and ok, ok_original_next_has
    ok = and ok, ok_original_next
    ok = and ok, ok_original_second
    ok = and ok, ok_empty_clone_backing_len
    ok = and ok, ok_empty_clone_has
    ok = and ok, ok_empty_clone

    !first_has
    !first
    !clone_backing_len
    !original_len_after_clone
    !clone_mut_ok
    !clone_mut_ptr
    !clone_first_has
    !clone_first
    !clone_second_has
    !clone_second
    !clone_third_has
    !clone_third
    !clone_done_has
    !clone_done
    !original_len_after_clone_consumed
    !original_next_has
    !original_next
    !original_second
    !empty_clone_backing_len
    !empty_clone_has
    !empty_clone
    !ok_first_has
    !ok_first
    !ok_clone_backing_len
    !ok_original_len_after_clone
    !ok_clone_mut
    !ok_clone_first_has
    !ok_clone_first
    !ok_clone_second_has
    !ok_clone_second
    !ok_clone_third_has
    !ok_clone_third
    !ok_clone_done_has
    !ok_clone_done
    !ok_original_len_after_clone_consumed
    !ok_original_next_has
    !ok_original_next
    !ok_original_second
    !ok_empty_clone_backing_len
    !ok_empty_clone_has
    !ok_empty_clone
    !iter
    !clone_iter
    !empty_iter
    !empty_clone_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_SORTED_CLONE_OK, L_BINARY_HEAP_INTO_ITER_SORTED_CLONE_FAIL

L_BINARY_HEAP_INTO_ITER_SORTED_CLONE_FAIL:
    !ok
    panic(10732)

L_BINARY_HEAP_INTO_ITER_SORTED_CLONE_OK:
    !ok
    return
