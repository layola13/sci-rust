@import "sa_std/time.sars"

@test "sa_std instant duration_since"():
L_ENTRY:
    EXPAND TIME_DURATION_FROM_NS later, 100
    EXPAND TIME_DURATION_FROM_NS earlier, 40
    EXPAND TIME_INSTANT_DURATION_SINCE d, later, earlier
    EXPAND TIME_INSTANT_CHECKED_DURATION_SINCE ok_under, under, earlier, later
    a = eq d, 60
    b = eq ok_under, 0
    ok = and a, b
    !later
    !earlier
    !d
    !ok_under
    !under
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(11000)
