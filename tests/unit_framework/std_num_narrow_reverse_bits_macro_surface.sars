@import "sa_std/num.sars"

@test "sa_std narrow unsigned primitive reverse bits macro surface"():
L_ENTRY:
    u32_high = shl 1, 31
    usize_high = shl 1, 63
    usize_rev_128 = shl 1, 56

    EXPAND NUM_U8_REVERSE_BITS u8_zero, 0
    EXPAND NUM_U8_REVERSE_BITS u8_one, 1
    EXPAND NUM_U8_REVERSE_BITS u8_mixed, 40
    EXPAND NUM_U8_REVERSE_BITS u8_mask, 300

    EXPAND NUM_U16_REVERSE_BITS u16_zero, 0
    EXPAND NUM_U16_REVERSE_BITS u16_one, 1
    EXPAND NUM_U16_REVERSE_BITS u16_mixed, 1032
    EXPAND NUM_U16_REVERSE_BITS u16_mask, 70000

    EXPAND NUM_U32_REVERSE_BITS u32_zero, 0
    EXPAND NUM_U32_REVERSE_BITS u32_one, 1
    EXPAND NUM_U32_REVERSE_BITS u32_mixed, 16777232
    EXPAND NUM_U32_REVERSE_BITS u32_mask, 4294967304

    EXPAND NUM_USIZE_REVERSE_BITS usize_zero, 0
    EXPAND NUM_USIZE_REVERSE_BITS usize_one, 1
    EXPAND NUM_USIZE_REVERSE_BITS usize_mixed, 128

    ok01 = eq u8_zero, 0
    ok02 = eq u8_one, 128
    ok03 = eq u8_mixed, 20
    ok04 = eq u8_mask, 52

    ok05 = eq u16_zero, 0
    ok06 = eq u16_one, 32768
    ok07 = eq u16_mixed, 4128
    ok08 = eq u16_mask, 3720

    ok09 = eq u32_zero, 0
    ok10 = eq u32_one, u32_high
    ok11 = eq u32_mixed, 134217856
    ok12 = eq u32_mask, 268435456

    ok13 = eq usize_zero, 0
    ok14 = eq usize_one, usize_high
    ok15 = eq usize_mixed, usize_rev_128

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    ok = and chain13, ok15

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    !u32_high
    !usize_high
    !usize_rev_128
    panic(10665)

L_PASS:
    !ok
    !u32_high
    !usize_high
    !usize_rev_128
    return 0
