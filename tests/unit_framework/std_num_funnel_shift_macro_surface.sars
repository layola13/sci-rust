@import "sa_std/num.sars"

[MACRO] TEST_FUNNEL_SHIFT_EQ %out_acc, %prev_acc, %value, %expected
    __test_funnel_shift_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_funnel_shift_eq_%out_acc
    !__test_funnel_shift_eq_%out_acc
[END_MACRO]

@test "sa_std unsigned primitive funnel shift macro surface"():
L_ENTRY:
    EXPAND NUM_U8_FUNNEL_SHL u8_shl, 1, 128, 1
    EXPAND NUM_U16_FUNNEL_SHL u16_shl, 1, 32768, 1
    EXPAND NUM_U32_FUNNEL_SHL u32_shl, 1, 2147483648, 1
    EXPAND NUM_U64_FUNNEL_SHL u64_shl, 1, NUM_I64_MIN, 1
    EXPAND NUM_USIZE_FUNNEL_SHL usize_shl, 1, NUM_I64_MIN, 1

    EXPAND NUM_U8_FUNNEL_SHR u8_shr, 1, 2, 1
    EXPAND NUM_U16_FUNNEL_SHR u16_shr, 1, 2, 1
    EXPAND NUM_U32_FUNNEL_SHR u32_shr, 1, 2, 1
    EXPAND NUM_U64_FUNNEL_SHR u64_shr, 1, 2, 1
    EXPAND NUM_USIZE_FUNNEL_SHR usize_shr, 1, 2, 1

    EXPAND NUM_U8_UNCHECKED_FUNNEL_SHL u8_unchecked_shl, 1, 128, 1
    EXPAND NUM_U16_UNCHECKED_FUNNEL_SHL u16_unchecked_shl, 1, 32768, 1
    EXPAND NUM_U32_UNCHECKED_FUNNEL_SHL u32_unchecked_shl, 1, 2147483648, 1
    EXPAND NUM_U64_UNCHECKED_FUNNEL_SHL u64_unchecked_shl, 1, NUM_I64_MIN, 1
    EXPAND NUM_USIZE_UNCHECKED_FUNNEL_SHL usize_unchecked_shl, 1, NUM_I64_MIN, 1

    EXPAND NUM_U8_UNCHECKED_FUNNEL_SHR u8_unchecked_shr, 1, 2, 1
    EXPAND NUM_U16_UNCHECKED_FUNNEL_SHR u16_unchecked_shr, 1, 2, 1
    EXPAND NUM_U32_UNCHECKED_FUNNEL_SHR u32_unchecked_shr, 1, 2, 1
    EXPAND NUM_U64_UNCHECKED_FUNNEL_SHR u64_unchecked_shr, 1, 2, 1
    EXPAND NUM_USIZE_UNCHECKED_FUNNEL_SHR usize_unchecked_shr, 1, 2, 1

    EXPAND NUM_U64_FUNNEL_SHL zero_shl, 123, 456, 0
    EXPAND NUM_U64_FUNNEL_SHR zero_shr, 123, 456, 0
    u64_shr_expected = add NUM_I64_MIN, 1

    acc_00 = eq 0, 0
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_01, acc_00, u8_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_02, acc_01, u16_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_03, acc_02, u32_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_04, acc_03, u64_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_05, acc_04, usize_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_06, acc_05, u8_shr, 129
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_07, acc_06, u16_shr, 32769
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_08, acc_07, u32_shr, 2147483649
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_09, acc_08, u64_shr, u64_shr_expected
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_10, acc_09, usize_shr, u64_shr_expected
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_11, acc_10, u8_unchecked_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_12, acc_11, u16_unchecked_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_13, acc_12, u32_unchecked_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_14, acc_13, u64_unchecked_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_15, acc_14, usize_unchecked_shl, 3
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_16, acc_15, u8_unchecked_shr, 129
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_17, acc_16, u16_unchecked_shr, 32769
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_18, acc_17, u32_unchecked_shr, 2147483649
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_19, acc_18, u64_unchecked_shr, u64_shr_expected
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_20, acc_19, usize_unchecked_shr, u64_shr_expected
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_21, acc_20, zero_shl, 123
    EXPAND TEST_FUNNEL_SHIFT_EQ acc_22, acc_21, zero_shr, 456
    !u64_shr_expected
    br acc_22 -> L_PASS, L_FAIL

L_FAIL:
    !acc_22
    panic(10646)

L_PASS:
    !acc_22
    return 0

@test should_panic "sa_std funnel_shl panics on out of range shift"():
L_ENTRY:
    EXPAND NUM_U8_FUNNEL_SHL value, 1, 2, 8
    !value
    return 0

@test should_panic "sa_std funnel_shr panics on out of range shift"():
L_ENTRY:
    EXPAND NUM_U64_FUNNEL_SHR value, 1, 2, 64
    !value
    return 0
