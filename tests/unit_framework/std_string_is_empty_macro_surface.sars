@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const S = utf8:"x"

@test "sa_std string is_empty"():
L_ENTRY:
    EXPAND STR_FROM_PARTS s, &S, 1
    EXPAND STR_IS_EMPTY e1, s
    empty = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW empty, &S, 0
    EXPAND STR_IS_EMPTY e0, empty
    a = eq e1, 0
    b = eq e0, 1
    ok = and a, b
    !e1
    !e0
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10973)
