@import "sa_std/array.sars"

@test "sa_std array iter trait macro surface"():
L_ENTRY:
    arr = stack_alloc 32
    store arr+0, 11 as u64
    store arr+8, 22 as u64
    store arr+16, 33 as u64
    store arr+24, 44 as u64

    EXPAND ARRAY_ITER_U64 iter, arr, 4
    EXPAND ARRAY_ITER_SIZE_HINT_U64 hint_lower_initial, hint_upper_initial, iter
    EXPAND ARRAY_ITER_EXACT_SIZE_LEN_U64 exact_len_initial, iter
    EXPAND ARRAY_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_initial, iter
    EXPAND ARRAY_ITER_NEXT_U64 first_has, first, iter
    rest_slice = stack_alloc Slice_SIZE
    EXPAND ARRAY_ITER_AS_REF_SLICE_U64 rest_slice, iter
    EXPAND SLICE_GET_LEN rest_len, rest_slice
    EXPAND SLICE_GET_U64 rest_first, rest_slice, 0
    EXPAND ARRAY_ITER_CLONE_U64 clone_iter, iter
    EXPAND ARRAY_ITER_SIZE_HINT_U64 clone_hint_lower, clone_hint_upper, clone_iter
    EXPAND ARRAY_ITER_EXACT_SIZE_LEN_U64 original_len_after_clone, iter
    EXPAND ARRAY_ITER_NEXT_U64 clone_first_has, clone_first, clone_iter
    EXPAND ARRAY_ITER_NEXT_BACK_U64 clone_back_has, clone_back, clone_iter
    EXPAND ARRAY_ITER_NEXT_U64 clone_middle_has, clone_middle, clone_iter
    EXPAND ARRAY_ITER_NEXT_U64 clone_done_has, clone_done, clone_iter
    EXPAND ARRAY_ITER_EXACT_SIZE_LEN_U64 original_len_after_clone_consumed, iter
    EXPAND ARRAY_ITER_NEXT_U64 original_next_has, original_next, iter
    EXPAND ARRAY_ITER_NEXT_BACK_U64 original_back_has, original_back, iter
    EXPAND ARRAY_ITER_NEXT_U64 original_middle_has, original_middle, iter
    EXPAND ARRAY_ITER_EXACT_SIZE_IS_EMPTY_U64 original_empty_done, iter

    EXPAND ARRAY_ITER_MUT_U64 iter_mut, arr, 4
    EXPAND ARRAY_ITER_MUT_SIZE_HINT_U64 mut_hint_lower_initial, mut_hint_upper_initial, iter_mut
    EXPAND ARRAY_ITER_MUT_EXACT_SIZE_LEN_U64 mut_exact_len_initial, iter_mut
    EXPAND ARRAY_ITER_MUT_EXACT_SIZE_IS_EMPTY_U64 mut_empty_initial, iter_mut
    mut_ref_slice = stack_alloc Slice_SIZE
    EXPAND ARRAY_ITER_MUT_AS_REF_SLICE_U64 mut_ref_slice, iter_mut
    EXPAND SLICE_GET_LEN mut_ref_slice_len, mut_ref_slice
    EXPAND ARRAY_ITER_MUT_NEXT_U64 mut_first_has, mut_first, iter_mut
    mut_slice = stack_alloc Slice_SIZE
    EXPAND ARRAY_ITER_MUT_AS_MUT_SLICE_U64 mut_slice, iter_mut
    EXPAND SLICE_GET_LEN mut_slice_len, mut_slice
    EXPAND SLICE_GET_MUT_PTR_U64 mut_second_ptr, mut_slice, 0
    store mut_second_ptr+0, 25 as u64
    EXPAND ARRAY_ITER_MUT_SIZE_HINT_U64 mut_hint_lower_after_first, mut_hint_upper_after_first, iter_mut
    EXPAND ARRAY_ITER_MUT_NEXT_U64 mut_second_has, mut_second, iter_mut
    EXPAND ARRAY_ITER_MUT_NEXT_BACK_U64 mut_back_has, mut_back, iter_mut
    EXPAND ARRAY_ITER_MUT_NEXT_U64 mut_middle_has, mut_middle, iter_mut
    EXPAND ARRAY_ITER_MUT_EXACT_SIZE_IS_EMPTY_U64 mut_empty_done, iter_mut
    EXPAND ARRAY_ITER_MUT_NEXT_U64 mut_done_has, mut_done, iter_mut

    EXPAND ARRAY_REF_INTO_ITER_U64 ref_iter, arr, 4
    EXPAND ARRAY_ITER_NEXT_BACK_U64 ref_back_has, ref_back, ref_iter
    EXPAND ARRAY_ITER_EXACT_SIZE_LEN_U64 ref_len_after_back, ref_iter

    EXPAND ARRAY_MUT_REF_INTO_ITER_U64 mut_ref_iter, arr, 4
    EXPAND ARRAY_ITER_MUT_NEXT_U64 mut_ref_next_has, mut_ref_next, mut_ref_iter
    EXPAND ARRAY_ITER_MUT_NEXT_BACK_U64 mut_ref_back_has, mut_ref_back, mut_ref_iter
    EXPAND ARRAY_ITER_MUT_EXACT_SIZE_LEN_U64 mut_ref_len_after_edges, mut_ref_iter

    EXPAND ARRAY_GET_U64 array_second_after_mut_slice, arr, 1

    ok_hint_lower_initial = eq hint_lower_initial, 4
    ok_hint_upper_initial = eq hint_upper_initial, 4
    ok_exact_len_initial = eq exact_len_initial, 4
    ok_empty_initial = eq empty_initial, 0
    ok_first_has = eq first_has, 1
    ok_first = eq first, 11
    ok_rest_len = eq rest_len, 3
    ok_rest_first = eq rest_first, 22
    ok_clone_hint_lower = eq clone_hint_lower, 3
    ok_clone_hint_upper = eq clone_hint_upper, 3
    ok_original_len_after_clone = eq original_len_after_clone, 3
    ok_clone_first_has = eq clone_first_has, 1
    ok_clone_first = eq clone_first, 22
    ok_clone_back_has = eq clone_back_has, 1
    ok_clone_back = eq clone_back, 44
    ok_clone_middle_has = eq clone_middle_has, 1
    ok_clone_middle = eq clone_middle, 33
    ok_clone_done_has = eq clone_done_has, 0
    ok_clone_done = eq clone_done, 0
    ok_original_len_after_clone_consumed = eq original_len_after_clone_consumed, 3
    ok_original_next_has = eq original_next_has, 1
    ok_original_next = eq original_next, 22
    ok_original_back_has = eq original_back_has, 1
    ok_original_back = eq original_back, 44
    ok_original_middle_has = eq original_middle_has, 1
    ok_original_middle = eq original_middle, 33
    ok_original_empty_done = eq original_empty_done, 1
    ok_mut_hint_lower_initial = eq mut_hint_lower_initial, 4
    ok_mut_hint_upper_initial = eq mut_hint_upper_initial, 4
    ok_mut_exact_len_initial = eq mut_exact_len_initial, 4
    ok_mut_empty_initial = eq mut_empty_initial, 0
    ok_mut_ref_slice_len = eq mut_ref_slice_len, 4
    ok_mut_first_has = eq mut_first_has, 1
    ok_mut_first = eq mut_first, 11
    ok_mut_slice_len = eq mut_slice_len, 3
    ok_mut_hint_lower_after_first = eq mut_hint_lower_after_first, 3
    ok_mut_hint_upper_after_first = eq mut_hint_upper_after_first, 3
    ok_mut_second_has = eq mut_second_has, 1
    ok_mut_second = eq mut_second, 25
    ok_mut_back_has = eq mut_back_has, 1
    ok_mut_back = eq mut_back, 44
    ok_mut_middle_has = eq mut_middle_has, 1
    ok_mut_middle = eq mut_middle, 33
    ok_mut_empty_done = eq mut_empty_done, 1
    ok_mut_done_has = eq mut_done_has, 0
    ok_mut_done = eq mut_done, 0
    ok_ref_back_has = eq ref_back_has, 1
    ok_ref_back = eq ref_back, 44
    ok_ref_len_after_back = eq ref_len_after_back, 3
    ok_mut_ref_next_has = eq mut_ref_next_has, 1
    ok_mut_ref_next = eq mut_ref_next, 11
    ok_mut_ref_back_has = eq mut_ref_back_has, 1
    ok_mut_ref_back = eq mut_ref_back, 44
    ok_mut_ref_len_after_edges = eq mut_ref_len_after_edges, 2
    ok_array_second = eq array_second_after_mut_slice, 25

    ok = and ok_hint_lower_initial, ok_hint_upper_initial
    ok = and ok, ok_exact_len_initial
    ok = and ok, ok_empty_initial
    ok = and ok, ok_first_has
    ok = and ok, ok_first
    ok = and ok, ok_rest_len
    ok = and ok, ok_rest_first
    ok = and ok, ok_clone_hint_lower
    ok = and ok, ok_clone_hint_upper
    ok = and ok, ok_original_len_after_clone
    ok = and ok, ok_clone_first_has
    ok = and ok, ok_clone_first
    ok = and ok, ok_clone_back_has
    ok = and ok, ok_clone_back
    ok = and ok, ok_clone_middle_has
    ok = and ok, ok_clone_middle
    ok = and ok, ok_clone_done_has
    ok = and ok, ok_clone_done
    ok = and ok, ok_original_len_after_clone_consumed
    ok = and ok, ok_original_next_has
    ok = and ok, ok_original_next
    ok = and ok, ok_original_back_has
    ok = and ok, ok_original_back
    ok = and ok, ok_original_middle_has
    ok = and ok, ok_original_middle
    ok = and ok, ok_original_empty_done
    ok = and ok, ok_mut_hint_lower_initial
    ok = and ok, ok_mut_hint_upper_initial
    ok = and ok, ok_mut_exact_len_initial
    ok = and ok, ok_mut_empty_initial
    ok = and ok, ok_mut_ref_slice_len
    ok = and ok, ok_mut_first_has
    ok = and ok, ok_mut_first
    ok = and ok, ok_mut_slice_len
    ok = and ok, ok_mut_hint_lower_after_first
    ok = and ok, ok_mut_hint_upper_after_first
    ok = and ok, ok_mut_second_has
    ok = and ok, ok_mut_second
    ok = and ok, ok_mut_back_has
    ok = and ok, ok_mut_back
    ok = and ok, ok_mut_middle_has
    ok = and ok, ok_mut_middle
    ok = and ok, ok_mut_empty_done
    ok = and ok, ok_mut_done_has
    ok = and ok, ok_mut_done
    ok = and ok, ok_ref_back_has
    ok = and ok, ok_ref_back
    ok = and ok, ok_ref_len_after_back
    ok = and ok, ok_mut_ref_next_has
    ok = and ok, ok_mut_ref_next
    ok = and ok, ok_mut_ref_back_has
    ok = and ok, ok_mut_ref_back
    ok = and ok, ok_mut_ref_len_after_edges
    ok = and ok, ok_array_second

    !hint_lower_initial
    !hint_upper_initial
    !exact_len_initial
    !empty_initial
    !first_has
    !first
    !rest_len
    !rest_first
    !clone_hint_lower
    !clone_hint_upper
    !original_len_after_clone
    !clone_first_has
    !clone_first
    !clone_back_has
    !clone_back
    !clone_middle_has
    !clone_middle
    !clone_done_has
    !clone_done
    !original_len_after_clone_consumed
    !original_next_has
    !original_next
    !original_back_has
    !original_back
    !original_middle_has
    !original_middle
    !original_empty_done
    !mut_hint_lower_initial
    !mut_hint_upper_initial
    !mut_exact_len_initial
    !mut_empty_initial
    !mut_ref_slice_len
    !mut_first_has
    !mut_first
    !mut_slice_len
    !mut_second_ptr
    !mut_hint_lower_after_first
    !mut_hint_upper_after_first
    !mut_second_has
    !mut_second
    !mut_back_has
    !mut_back
    !mut_middle_has
    !mut_middle
    !mut_empty_done
    !mut_done_has
    !mut_done
    !ref_back_has
    !ref_back
    !ref_len_after_back
    !mut_ref_next_has
    !mut_ref_next
    !mut_ref_back_has
    !mut_ref_back
    !mut_ref_len_after_edges
    !array_second_after_mut_slice
    !ok_hint_lower_initial
    !ok_hint_upper_initial
    !ok_exact_len_initial
    !ok_empty_initial
    !ok_first_has
    !ok_first
    !ok_rest_len
    !ok_rest_first
    !ok_clone_hint_lower
    !ok_clone_hint_upper
    !ok_original_len_after_clone
    !ok_clone_first_has
    !ok_clone_first
    !ok_clone_back_has
    !ok_clone_back
    !ok_clone_middle_has
    !ok_clone_middle
    !ok_clone_done_has
    !ok_clone_done
    !ok_original_len_after_clone_consumed
    !ok_original_next_has
    !ok_original_next
    !ok_original_back_has
    !ok_original_back
    !ok_original_middle_has
    !ok_original_middle
    !ok_original_empty_done
    !ok_mut_hint_lower_initial
    !ok_mut_hint_upper_initial
    !ok_mut_exact_len_initial
    !ok_mut_empty_initial
    !ok_mut_ref_slice_len
    !ok_mut_first_has
    !ok_mut_first
    !ok_mut_slice_len
    !ok_mut_hint_lower_after_first
    !ok_mut_hint_upper_after_first
    !ok_mut_second_has
    !ok_mut_second
    !ok_mut_back_has
    !ok_mut_back
    !ok_mut_middle_has
    !ok_mut_middle
    !ok_mut_empty_done
    !ok_mut_done_has
    !ok_mut_done
    !ok_ref_back_has
    !ok_ref_back
    !ok_ref_len_after_back
    !ok_mut_ref_next_has
    !ok_mut_ref_next
    !ok_mut_ref_back_has
    !ok_mut_ref_back
    !ok_mut_ref_len_after_edges
    !ok_array_second
    !iter
    !clone_iter
    !iter_mut
    !ref_iter
    !mut_ref_iter
    br ok -> L_ARRAY_ITER_TRAIT_OK, L_ARRAY_ITER_TRAIT_FAIL

L_ARRAY_ITER_TRAIT_FAIL:
    !ok
    panic(10736)

L_ARRAY_ITER_TRAIT_OK:
    !ok
    return
