@import "sa_std/fs.sars"
@import "sa_std/string.sars"

@const FS_DIR_ENTRY_ROOT = utf8:"_tmp_fs_dir_entry_ext"
@const FS_DIR_ENTRY_FILE = utf8:"_tmp_fs_dir_entry_ext/alpha.txt"
@const FS_DIR_ENTRY_SUBDIR = utf8:"_tmp_fs_dir_entry_ext/beta"
@const FS_DIR_ENTRY_FILE_NAME = utf8:"alpha.txt"
@const FS_DIR_ENTRY_SUBDIR_NAME = utf8:"beta"
@const FS_DIR_ENTRY_DATA = utf8:"x"

#def FS_DIR_ENTRY_ROOT_LEN = 21
#def FS_DIR_ENTRY_FILE_LEN = 31
#def FS_DIR_ENTRY_SUBDIR_LEN = 26
#def FS_DIR_ENTRY_FILE_NAME_LEN = 9
#def FS_DIR_ENTRY_SUBDIR_NAME_LEN = 4
#def FS_DIR_ENTRY_DATA_LEN = 1

@test "sa_std fs dir entry ext inode macros"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_root_status, FS_DIR_ENTRY_ROOT, FS_DIR_ENTRY_ROOT_LEN
    EXPAND FS_MAKE_DIR create_root_status, FS_DIR_ENTRY_ROOT, FS_DIR_ENTRY_ROOT_LEN
    EXPAND FS_WRITE_FILE create_file_status, FS_DIR_ENTRY_FILE, FS_DIR_ENTRY_FILE_LEN, FS_DIR_ENTRY_DATA, FS_DIR_ENTRY_DATA_LEN
    EXPAND FS_CREATE_DIR create_subdir_status, FS_DIR_ENTRY_SUBDIR, FS_DIR_ENTRY_SUBDIR_LEN

    EXPAND FS_METADATA file_meta_status, file_meta, FS_DIR_ENTRY_FILE, FS_DIR_ENTRY_FILE_LEN
    EXPAND FS_METADATA_INO file_ino, file_meta
    EXPAND FS_METADATA_FREE file_meta_free_status, file_meta
    EXPAND FS_METADATA dir_meta_status, dir_meta, FS_DIR_ENTRY_SUBDIR, FS_DIR_ENTRY_SUBDIR_LEN
    EXPAND FS_METADATA_INO dir_ino, dir_meta
    EXPAND FS_METADATA_FREE dir_meta_free_status, dir_meta

    EXPAND FS_READ_DIR_ENTRIES read_dir_status, entries, FS_DIR_ENTRY_ROOT, FS_DIR_ENTRY_ROOT_LEN, 16
    EXPAND FS_DIR_ENTRIES_LEN entry_count, entries

    idx = 0
    file_found = 0
    dir_found = 0
    file_match_ok = 0
    dir_match_ok = 0
    file_kind_ok = 0
    dir_kind_ok = 0

L_LOOP:
    done = uge idx, entry_count
    br done -> L_DONE, L_BODY

L_BODY:
    EXPAND FS_DIR_ENTRIES_GET get_status, entry, entries, idx
    EXPAND FS_DIR_ENTRY_FILE_NAME_REF_PTR entry_name_ptr, entry
    EXPAND FS_DIR_ENTRY_FILE_NAME_REF_LEN entry_name_len, entry
    EXPAND FS_DIR_ENTRY_KIND entry_kind, entry
    EXPAND FS_DIR_ENTRY_INO entry_ino, entry
    EXPAND STR_FROM_PARTS entry_name_view, entry_name_ptr, entry_name_len
    EXPAND STR_FROM_PARTS file_name_view, &FS_DIR_ENTRY_FILE_NAME, FS_DIR_ENTRY_FILE_NAME_LEN
    EXPAND STR_FROM_PARTS dir_name_view, &FS_DIR_ENTRY_SUBDIR_NAME, FS_DIR_ENTRY_SUBDIR_NAME_LEN
    EXPAND STR_EQ is_file_name, entry_name_view, file_name_view
    EXPAND STR_EQ is_dir_name, entry_name_view, dir_name_view

    br is_file_name -> L_CAPTURE_FILE, L_CHECK_DIR

L_CAPTURE_FILE:
    file_found = 1
    file_match_ok = eq entry_ino, file_ino
    file_kind_ok = eq entry_kind, SA_FS_FILE_REGULAR
    EXPAND FS_DIR_ENTRY_FREE free_entry_status, entry
    !is_dir_name
    !is_file_name
    !dir_name_view
    !file_name_view
    !entry_name_view
    !entry_ino
    !entry_kind
    !entry_name_len
    !entry_name_ptr
    !get_status
    idx = add idx, 1
    jmp L_LOOP

L_CHECK_DIR:
    br is_dir_name -> L_CAPTURE_DIR, L_SKIP

L_CAPTURE_DIR:
    dir_found = 1
    dir_match_ok = eq entry_ino, dir_ino
    dir_kind_ok = eq entry_kind, SA_FS_FILE_DIR
    EXPAND FS_DIR_ENTRY_FREE free_entry_status, entry
    !is_dir_name
    !is_file_name
    !dir_name_view
    !file_name_view
    !entry_name_view
    !entry_ino
    !entry_kind
    !entry_name_len
    !entry_name_ptr
    !get_status
    idx = add idx, 1
    jmp L_LOOP

L_SKIP:
    EXPAND FS_DIR_ENTRY_FREE free_entry_status, entry
    !is_dir_name
    !is_file_name
    !dir_name_view
    !file_name_view
    !entry_name_view
    !entry_ino
    !entry_kind
    !entry_name_len
    !entry_name_ptr
    !get_status
    idx = add idx, 1
    jmp L_LOOP

L_DONE:
    EXPAND FS_DIR_ENTRIES_FREE free_entries_status, entries
    EXPAND FS_REMOVE_PATH remove_file_status, FS_DIR_ENTRY_FILE, FS_DIR_ENTRY_FILE_LEN
    EXPAND FS_REMOVE_PATH remove_subdir_status, FS_DIR_ENTRY_SUBDIR, FS_DIR_ENTRY_SUBDIR_LEN
    EXPAND FS_REMOVE_PATH remove_root_status, FS_DIR_ENTRY_ROOT, FS_DIR_ENTRY_ROOT_LEN

    create_root_ok = eq create_root_status, SA_FS_OK
    create_file_ok = eq create_file_status, SA_FS_OK
    create_subdir_ok = eq create_subdir_status, SA_FS_OK
    file_meta_ok = eq file_meta_status, SA_FS_OK
    file_ino_ok = ne file_ino, 0
    file_meta_free_ok = eq file_meta_free_status, SA_FS_OK
    dir_meta_ok = eq dir_meta_status, SA_FS_OK
    dir_ino_ok = ne dir_ino, 0
    dir_meta_free_ok = eq dir_meta_free_status, SA_FS_OK
    read_dir_ok = eq read_dir_status, SA_FS_OK
    entry_count_ok = eq entry_count, 2
    free_entries_ok = eq free_entries_status, SA_FS_OK
    remove_file_ok = eq remove_file_status, SA_FS_OK
    remove_subdir_ok = eq remove_subdir_status, SA_FS_OK
    remove_root_ok = eq remove_root_status, SA_FS_OK
    file_found_ok = eq file_found, 1
    dir_found_ok = eq dir_found, 1

    ok01 = and create_root_ok, create_file_ok
    ok02 = and ok01, create_subdir_ok
    ok03 = and ok02, file_meta_ok
    ok04 = and ok03, file_ino_ok
    ok05 = and ok04, file_meta_free_ok
    ok06 = and ok05, dir_meta_ok
    ok07 = and ok06, dir_ino_ok
    ok08 = and ok07, dir_meta_free_ok
    ok09 = and ok08, read_dir_ok
    ok10 = and ok09, entry_count_ok
    ok11 = and ok10, file_found_ok
    ok12 = and ok11, dir_found_ok
    ok13 = and ok12, file_match_ok
    ok14 = and ok13, dir_match_ok
    ok15 = and ok14, file_kind_ok
    ok16 = and ok15, dir_kind_ok
    ok17 = and ok16, free_entries_ok
    ok18 = and ok17, remove_file_ok
    ok19 = and ok18, remove_subdir_ok
    ok = and ok19, remove_root_ok

    !cleanup_root_status
    !create_root_status
    !create_file_status
    !create_subdir_status
    !file_meta_status
    !file_meta
    !file_ino
    !file_meta_free_status
    !dir_meta_status
    !dir_meta
    !dir_ino
    !dir_meta_free_status
    !read_dir_status
    !entry_count
    !idx
    !file_found
    !dir_found
    !file_match_ok
    !dir_match_ok
    !file_kind_ok
    !dir_kind_ok
    !done
    !free_entries_status
    !remove_file_status
    !remove_subdir_status
    !remove_root_status
    !create_root_ok
    !create_file_ok
    !create_subdir_ok
    !file_meta_ok
    !file_ino_ok
    !file_meta_free_ok
    !dir_meta_ok
    !dir_ino_ok
    !dir_meta_free_ok
    !read_dir_ok
    !entry_count_ok
    !free_entries_ok
    !remove_file_ok
    !remove_subdir_ok
    !remove_root_ok
    !file_found_ok
    !dir_found_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1810)

L_PASS:
    !ok
    return 0
