@import "sa_std/num.sars"

@test "sa_std primitive checked and strict euclidean div rem macro surface"():
L_ENTRY:
    EXPAND NUM_U8_CHECKED_DIV_EUCLID u8_div_ok, u8_div, 43, 7
    EXPAND NUM_U16_CHECKED_DIV_EUCLID u16_div_ok, u16_div, 43, 7
    EXPAND NUM_U32_CHECKED_DIV_EUCLID u32_div_ok, u32_div, 43, 7
    EXPAND NUM_U64_CHECKED_DIV_EUCLID u64_div_ok, u64_div, 43, 7
    EXPAND NUM_USIZE_CHECKED_DIV_EUCLID usize_div_ok, usize_div, 43, 7
    EXPAND NUM_I8_CHECKED_DIV_EUCLID i8_div_ok, i8_div, -43, 7
    EXPAND NUM_I16_CHECKED_DIV_EUCLID i16_div_ok, i16_div, -43, 7
    EXPAND NUM_I32_CHECKED_DIV_EUCLID i32_div_ok, i32_div, -43, 7
    EXPAND NUM_I64_CHECKED_DIV_EUCLID i64_div_ok, i64_div, -43, 7
    EXPAND NUM_ISIZE_CHECKED_DIV_EUCLID isize_div_ok, isize_div, -43, 7

    EXPAND NUM_U8_CHECKED_REM_EUCLID u8_rem_ok, u8_rem, 43, 7
    EXPAND NUM_U16_CHECKED_REM_EUCLID u16_rem_ok, u16_rem, 43, 7
    EXPAND NUM_U32_CHECKED_REM_EUCLID u32_rem_ok, u32_rem, 43, 7
    EXPAND NUM_U64_CHECKED_REM_EUCLID u64_rem_ok, u64_rem, 43, 7
    EXPAND NUM_USIZE_CHECKED_REM_EUCLID usize_rem_ok, usize_rem, 43, 7
    EXPAND NUM_I8_CHECKED_REM_EUCLID i8_rem_ok, i8_rem, -43, 7
    EXPAND NUM_I16_CHECKED_REM_EUCLID i16_rem_ok, i16_rem, -43, 7
    EXPAND NUM_I32_CHECKED_REM_EUCLID i32_rem_ok, i32_rem, -43, 7
    EXPAND NUM_I64_CHECKED_REM_EUCLID i64_rem_ok, i64_rem, -43, 7
    EXPAND NUM_ISIZE_CHECKED_REM_EUCLID isize_rem_ok, isize_rem, -43, 7

    EXPAND NUM_U8_STRICT_DIV_EUCLID u8_strict_div, 43, 7
    EXPAND NUM_U16_STRICT_DIV_EUCLID u16_strict_div, 43, 7
    EXPAND NUM_U32_STRICT_DIV_EUCLID u32_strict_div, 43, 7
    EXPAND NUM_U64_STRICT_DIV_EUCLID u64_strict_div, 43, 7
    EXPAND NUM_USIZE_STRICT_DIV_EUCLID usize_strict_div, 43, 7
    EXPAND NUM_I8_STRICT_DIV_EUCLID i8_strict_div, -43, 7
    EXPAND NUM_I16_STRICT_DIV_EUCLID i16_strict_div, -43, 7
    EXPAND NUM_I32_STRICT_DIV_EUCLID i32_strict_div, -43, 7
    EXPAND NUM_I64_STRICT_DIV_EUCLID i64_strict_div, -43, 7
    EXPAND NUM_ISIZE_STRICT_DIV_EUCLID isize_strict_div, -43, 7

    EXPAND NUM_U8_STRICT_REM_EUCLID u8_strict_rem, 43, 7
    EXPAND NUM_U16_STRICT_REM_EUCLID u16_strict_rem, 43, 7
    EXPAND NUM_U32_STRICT_REM_EUCLID u32_strict_rem, 43, 7
    EXPAND NUM_U64_STRICT_REM_EUCLID u64_strict_rem, 43, 7
    EXPAND NUM_USIZE_STRICT_REM_EUCLID usize_strict_rem, 43, 7
    EXPAND NUM_I8_STRICT_REM_EUCLID i8_strict_rem, -43, 7
    EXPAND NUM_I16_STRICT_REM_EUCLID i16_strict_rem, -43, 7
    EXPAND NUM_I32_STRICT_REM_EUCLID i32_strict_rem, -43, 7
    EXPAND NUM_I64_STRICT_REM_EUCLID i64_strict_rem, -43, 7
    EXPAND NUM_ISIZE_STRICT_REM_EUCLID isize_strict_rem, -43, 7

    EXPAND NUM_U8_CHECKED_DIV_EUCLID u8_div_zero_ok, u8_div_zero, 1, 0
    EXPAND NUM_I8_CHECKED_DIV_EUCLID i8_div_over_ok, i8_div_over, NUM_I8_MIN, -1
    EXPAND NUM_U8_CHECKED_REM_EUCLID u8_rem_zero_ok, u8_rem_zero, 1, 0
    EXPAND NUM_I8_CHECKED_REM_EUCLID i8_rem_over_ok, i8_rem_over, NUM_I8_MIN, -1

    ok_01 = and u8_div_ok, u16_div_ok
    ok_02 = and ok_01, u32_div_ok
    ok_03 = and ok_02, u64_div_ok
    ok_04 = and ok_03, usize_div_ok
    ok_05 = and ok_04, i8_div_ok
    ok_06 = and ok_05, i16_div_ok
    ok_07 = and ok_06, i32_div_ok
    ok_08 = and ok_07, i64_div_ok
    ok_09 = and ok_08, isize_div_ok
    ok_10 = and ok_09, u8_rem_ok
    ok_11 = and ok_10, u16_rem_ok
    ok_12 = and ok_11, u32_rem_ok
    ok_13 = and ok_12, u64_rem_ok
    ok_14 = and ok_13, usize_rem_ok
    ok_15 = and ok_14, i8_rem_ok
    ok_16 = and ok_15, i16_rem_ok
    ok_17 = and ok_16, i32_rem_ok
    ok_18 = and ok_17, i64_rem_ok
    ok_19 = and ok_18, isize_rem_ok

    val_01 = eq u8_div, 6
    val_02 = eq u16_div, 6
    val_03 = eq u32_div, 6
    val_04 = eq u64_div, 6
    val_05 = eq usize_div, 6
    val_06 = eq i8_div, -7
    val_07 = eq i16_div, -7
    val_08 = eq i32_div, -7
    val_09 = eq i64_div, -7
    val_10 = eq isize_div, -7
    val_11 = eq u8_rem, 1
    val_12 = eq u16_rem, 1
    val_13 = eq u32_rem, 1
    val_14 = eq u64_rem, 1
    val_15 = eq usize_rem, 1
    val_16 = eq i8_rem, 6
    val_17 = eq i16_rem, 6
    val_18 = eq i32_rem, 6
    val_19 = eq i64_rem, 6
    val_20 = eq isize_rem, 6

    strict_01 = eq u8_strict_div, 6
    strict_02 = eq u16_strict_div, 6
    strict_03 = eq u32_strict_div, 6
    strict_04 = eq u64_strict_div, 6
    strict_05 = eq usize_strict_div, 6
    strict_06 = eq i8_strict_div, -7
    strict_07 = eq i16_strict_div, -7
    strict_08 = eq i32_strict_div, -7
    strict_09 = eq i64_strict_div, -7
    strict_10 = eq isize_strict_div, -7
    strict_11 = eq u8_strict_rem, 1
    strict_12 = eq u16_strict_rem, 1
    strict_13 = eq u32_strict_rem, 1
    strict_14 = eq u64_strict_rem, 1
    strict_15 = eq usize_strict_rem, 1
    strict_16 = eq i8_strict_rem, 6
    strict_17 = eq i16_strict_rem, 6
    strict_18 = eq i32_strict_rem, 6
    strict_19 = eq i64_strict_rem, 6
    strict_20 = eq isize_strict_rem, 6

    fail_01 = eq u8_div_zero_ok, 0
    fail_02 = eq i8_div_over_ok, 0
    fail_03 = eq u8_rem_zero_ok, 0
    fail_04 = eq i8_rem_over_ok, 0

    acc_01 = and ok_19, val_01
    acc_02 = and acc_01, val_02
    acc_03 = and acc_02, val_03
    acc_04 = and acc_03, val_04
    acc_05 = and acc_04, val_05
    acc_06 = and acc_05, val_06
    acc_07 = and acc_06, val_07
    acc_08 = and acc_07, val_08
    acc_09 = and acc_08, val_09
    acc_10 = and acc_09, val_10
    acc_11 = and acc_10, val_11
    acc_12 = and acc_11, val_12
    acc_13 = and acc_12, val_13
    acc_14 = and acc_13, val_14
    acc_15 = and acc_14, val_15
    acc_16 = and acc_15, val_16
    acc_17 = and acc_16, val_17
    acc_18 = and acc_17, val_18
    acc_19 = and acc_18, val_19
    acc_20 = and acc_19, val_20
    acc_21 = and acc_20, strict_01
    acc_22 = and acc_21, strict_02
    acc_23 = and acc_22, strict_03
    acc_24 = and acc_23, strict_04
    acc_25 = and acc_24, strict_05
    acc_26 = and acc_25, strict_06
    acc_27 = and acc_26, strict_07
    acc_28 = and acc_27, strict_08
    acc_29 = and acc_28, strict_09
    acc_30 = and acc_29, strict_10
    acc_31 = and acc_30, strict_11
    acc_32 = and acc_31, strict_12
    acc_33 = and acc_32, strict_13
    acc_34 = and acc_33, strict_14
    acc_35 = and acc_34, strict_15
    acc_36 = and acc_35, strict_16
    acc_37 = and acc_36, strict_17
    acc_38 = and acc_37, strict_18
    acc_39 = and acc_38, strict_19
    acc_40 = and acc_39, strict_20
    acc_41 = and acc_40, fail_01
    acc_42 = and acc_41, fail_02
    acc_43 = and acc_42, fail_03
    ok = and acc_43, fail_04
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10635)

L_PASS:
    !ok
    return 0

@test should_panic "sa_std unsigned strict div_euclid panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_U8_STRICT_DIV_EUCLID value, 1, 0
    !value
    return 0

@test should_panic "sa_std unsigned strict rem_euclid panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_U8_STRICT_REM_EUCLID value, 1, 0
    !value
    return 0

@test should_panic "sa_std signed strict div_euclid panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_I64_STRICT_DIV_EUCLID value, 1, 0
    !value
    return 0

@test should_panic "sa_std signed strict rem_euclid panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_I64_STRICT_REM_EUCLID value, 1, 0
    !value
    return 0

@test should_panic "sa_std signed strict div_euclid panics on min over negative one"():
L_ENTRY:
    EXPAND NUM_I8_STRICT_DIV_EUCLID value, NUM_I8_MIN, -1
    !value
    return 0

@test should_panic "sa_std signed strict rem_euclid panics on min over negative one"():
L_ENTRY:
    EXPAND NUM_I8_STRICT_REM_EUCLID value, NUM_I8_MIN, -1
    !value
    return 0
