@import "sa_std/num.sars"

@test "sa_std num narrow signed bit helper macro surface"():
L_ENTRY:
    EXPAND NUM_I8_COUNT_ONES i8_count_ones_neg1, -1
    EXPAND NUM_I8_COUNT_ZEROS i8_count_zeros_neg1, -1
    EXPAND NUM_I8_LEADING_ZEROS i8_lz_pos8, 8
    EXPAND NUM_I8_TRAILING_ZEROS i8_tz_pos8, 8
    EXPAND NUM_I8_LEADING_ONES i8_lo_neg1, -1
    EXPAND NUM_I8_TRAILING_ONES i8_to_15, 15
    EXPAND NUM_I8_ISOLATE_HIGHEST_ONE i8_iso_high_neg8, -8
    EXPAND NUM_I8_ISOLATE_LOWEST_ONE i8_iso_low_neg8, -8
    EXPAND NUM_I8_HIGHEST_ONE i8_high_neg8_ok, i8_high_neg8_idx, -8
    EXPAND NUM_I8_LOWEST_ONE i8_low_neg8_ok, i8_low_neg8_idx, -8
    EXPAND NUM_I8_HIGHEST_ONE i8_high_zero_ok, i8_high_zero_idx, 0
    EXPAND NUM_I8_LOWEST_ONE i8_low_zero_ok, i8_low_zero_idx, 0

    EXPAND NUM_I16_COUNT_ONES i16_count_ones_neg1, -1
    EXPAND NUM_I16_COUNT_ZEROS i16_count_zeros_neg1, -1
    EXPAND NUM_I16_LEADING_ZEROS i16_lz_pos8, 8
    EXPAND NUM_I16_TRAILING_ZEROS i16_tz_pos8, 8
    EXPAND NUM_I16_LEADING_ONES i16_lo_neg1, -1
    EXPAND NUM_I16_TRAILING_ONES i16_to_15, 15
    EXPAND NUM_I16_ISOLATE_HIGHEST_ONE i16_iso_high_neg8, -8
    EXPAND NUM_I16_ISOLATE_LOWEST_ONE i16_iso_low_neg8, -8
    EXPAND NUM_I16_HIGHEST_ONE i16_high_neg8_ok, i16_high_neg8_idx, -8
    EXPAND NUM_I16_LOWEST_ONE i16_low_neg8_ok, i16_low_neg8_idx, -8
    EXPAND NUM_I16_HIGHEST_ONE i16_high_zero_ok, i16_high_zero_idx, 0
    EXPAND NUM_I16_LOWEST_ONE i16_low_zero_ok, i16_low_zero_idx, 0

    EXPAND NUM_I32_COUNT_ONES i32_count_ones_neg1, -1
    EXPAND NUM_I32_COUNT_ZEROS i32_count_zeros_neg1, -1
    EXPAND NUM_I32_LEADING_ZEROS i32_lz_pos8, 8
    EXPAND NUM_I32_TRAILING_ZEROS i32_tz_pos8, 8
    EXPAND NUM_I32_LEADING_ONES i32_lo_neg1, -1
    EXPAND NUM_I32_TRAILING_ONES i32_to_15, 15
    EXPAND NUM_I32_ISOLATE_HIGHEST_ONE i32_iso_high_neg8, -8
    EXPAND NUM_I32_ISOLATE_LOWEST_ONE i32_iso_low_neg8, -8
    EXPAND NUM_I32_HIGHEST_ONE i32_high_neg8_ok, i32_high_neg8_idx, -8
    EXPAND NUM_I32_LOWEST_ONE i32_low_neg8_ok, i32_low_neg8_idx, -8
    EXPAND NUM_I32_HIGHEST_ONE i32_high_zero_ok, i32_high_zero_idx, 0
    EXPAND NUM_I32_LOWEST_ONE i32_low_zero_ok, i32_low_zero_idx, 0

    ok01 = eq i8_count_ones_neg1, 8
    ok02 = eq i8_count_zeros_neg1, 0
    ok03 = eq i8_lz_pos8, 4
    ok04 = eq i8_tz_pos8, 3
    ok05 = eq i8_lo_neg1, 8
    ok06 = eq i8_to_15, 4
    ok07 = eq i8_iso_high_neg8, NUM_I8_MIN
    ok08 = eq i8_iso_low_neg8, 8
    ok09 = eq i8_high_neg8_ok, 1
    ok10 = eq i8_high_neg8_idx, 7
    ok11 = eq i8_low_neg8_ok, 1
    ok12 = eq i8_low_neg8_idx, 3
    ok13 = eq i8_high_zero_ok, 0
    ok14 = eq i8_high_zero_idx, 0
    ok15 = eq i8_low_zero_ok, 0
    ok16 = eq i8_low_zero_idx, 0

    ok17 = eq i16_count_ones_neg1, 16
    ok18 = eq i16_count_zeros_neg1, 0
    ok19 = eq i16_lz_pos8, 12
    ok20 = eq i16_tz_pos8, 3
    ok21 = eq i16_lo_neg1, 16
    ok22 = eq i16_to_15, 4
    ok23 = eq i16_iso_high_neg8, NUM_I16_MIN
    ok24 = eq i16_iso_low_neg8, 8
    ok25 = eq i16_high_neg8_ok, 1
    ok26 = eq i16_high_neg8_idx, 15
    ok27 = eq i16_low_neg8_ok, 1
    ok28 = eq i16_low_neg8_idx, 3
    ok29 = eq i16_high_zero_ok, 0
    ok30 = eq i16_high_zero_idx, 0
    ok31 = eq i16_low_zero_ok, 0
    ok32 = eq i16_low_zero_idx, 0

    ok33 = eq i32_count_ones_neg1, 32
    ok34 = eq i32_count_zeros_neg1, 0
    ok35 = eq i32_lz_pos8, 28
    ok36 = eq i32_tz_pos8, 3
    ok37 = eq i32_lo_neg1, 32
    ok38 = eq i32_to_15, 4
    ok39 = eq i32_iso_high_neg8, NUM_I32_MIN
    ok40 = eq i32_iso_low_neg8, 8
    ok41 = eq i32_high_neg8_ok, 1
    ok42 = eq i32_high_neg8_idx, 31
    ok43 = eq i32_low_neg8_ok, 1
    ok44 = eq i32_low_neg8_idx, 3
    ok45 = eq i32_high_zero_ok, 0
    ok46 = eq i32_high_zero_idx, 0
    ok47 = eq i32_low_zero_ok, 0
    ok48 = eq i32_low_zero_idx, 0

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    chain22 = and chain21, ok23
    chain23 = and chain22, ok24
    chain24 = and chain23, ok25
    chain25 = and chain24, ok26
    chain26 = and chain25, ok27
    chain27 = and chain26, ok28
    chain28 = and chain27, ok29
    chain29 = and chain28, ok30
    chain30 = and chain29, ok31
    chain31 = and chain30, ok32
    chain32 = and chain31, ok33
    chain33 = and chain32, ok34
    chain34 = and chain33, ok35
    chain35 = and chain34, ok36
    chain36 = and chain35, ok37
    chain37 = and chain36, ok38
    chain38 = and chain37, ok39
    chain39 = and chain38, ok40
    chain40 = and chain39, ok41
    chain41 = and chain40, ok42
    chain42 = and chain41, ok43
    chain43 = and chain42, ok44
    chain44 = and chain43, ok45
    chain45 = and chain44, ok46
    chain46 = and chain45, ok47
    ok = and chain46, ok48

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10671)

L_PASS:
    return 0
