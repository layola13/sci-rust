@import "sa_std/array.sars"

@array_into_iter_cmp_compare_u64(left: u64, right: u64) -> i64:
L_ENTRY:
    is_less = ult left, right
    br is_less -> L_ARRAY_CMP_LESS, L_ARRAY_CMP_CHECK_GREATER
L_ARRAY_CMP_LESS:
    out_less = sub 0, 1
    !is_less
    !right
    !left
    return out_less
L_ARRAY_CMP_CHECK_GREATER:
    is_greater = ugt left, right
    br is_greater -> L_ARRAY_CMP_GREATER, L_ARRAY_CMP_EQUAL
L_ARRAY_CMP_GREATER:
    out_greater = add 0, 1
    !is_greater
    !is_less
    !right
    !left
    return out_greater
L_ARRAY_CMP_EQUAL:
    out_equal = add 0, 0
    !is_greater
    !is_less
    !right
    !left
    return out_equal

@array_into_iter_cmp_partial_none_on_99(left: u64, right: u64, &out_order: ptr) -> u64:
L_ENTRY:
    left_bad = eq left, 99
    right_bad = eq right, 99
    bad = or left_bad, right_bad
    br bad -> L_ARRAY_PARTIAL_CMP_NONE, L_ARRAY_PARTIAL_CMP_SOME
L_ARRAY_PARTIAL_CMP_SOME:
    order = call @array_into_iter_cmp_compare_u64(left, right)
    store out_order+0, order as i64
    !order
    !bad
    !right_bad
    !left_bad
    !out_order
    !right
    !left
    return 1
L_ARRAY_PARTIAL_CMP_NONE:
    !bad
    !right_bad
    !left_bad
    !out_order
    !right
    !left
    return 0

@array_into_iter_cmp_eq_mod10(left: u64, right: u64) -> u64:
L_ENTRY:
    left_key = urem left, 10
    right_key = urem right, 10
    out = eq left_key, right_key
    !right_key
    !left_key
    !right
    !left
    return out

@test "sa_std array into_iter comparison macro surface"():
L_ENTRY:
    cmp_eq_left_arr = stack_alloc 24
    store cmp_eq_left_arr+0, 1 as u64
    store cmp_eq_left_arr+8, 2 as u64
    store cmp_eq_left_arr+16, 3 as u64
    cmp_eq_right_arr = stack_alloc 24
    store cmp_eq_right_arr+0, 1 as u64
    store cmp_eq_right_arr+8, 2 as u64
    store cmp_eq_right_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 cmp_eq_left_iter, cmp_eq_left_backing, cmp_eq_left_arr, 3
    EXPAND ARRAY_INTO_ITER_U64 cmp_eq_right_iter, cmp_eq_right_backing, cmp_eq_right_arr, 3
    EXPAND ARRAY_INTO_ITER_CMP_U64 cmp_equal, cmp_eq_left_iter, cmp_eq_right_iter

    cmp_less_left_arr = stack_alloc 24
    store cmp_less_left_arr+0, 1 as u64
    store cmp_less_left_arr+8, 2 as u64
    store cmp_less_left_arr+16, 3 as u64
    cmp_less_right_arr = stack_alloc 24
    store cmp_less_right_arr+0, 1 as u64
    store cmp_less_right_arr+8, 4 as u64
    store cmp_less_right_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 cmp_less_left_iter, cmp_less_left_backing, cmp_less_left_arr, 3
    EXPAND ARRAY_INTO_ITER_U64 cmp_less_right_iter, cmp_less_right_backing, cmp_less_right_arr, 3
    EXPAND ARRAY_INTO_ITER_CMP_U64 cmp_less, cmp_less_left_iter, cmp_less_right_iter

    cmp_short_left_arr = stack_alloc 16
    store cmp_short_left_arr+0, 1 as u64
    store cmp_short_left_arr+8, 2 as u64
    cmp_short_right_arr = stack_alloc 24
    store cmp_short_right_arr+0, 1 as u64
    store cmp_short_right_arr+8, 2 as u64
    store cmp_short_right_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 cmp_short_left_iter, cmp_short_left_backing, cmp_short_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 cmp_short_right_iter, cmp_short_right_backing, cmp_short_right_arr, 3
    EXPAND ARRAY_INTO_ITER_CMP_BY_U64 cmp_by_short, cmp_short_left_iter, cmp_short_right_iter, @array_into_iter_cmp_compare_u64

    partial_left_arr = stack_alloc 16
    store partial_left_arr+0, 1 as u64
    store partial_left_arr+8, 3 as u64
    partial_right_arr = stack_alloc 16
    store partial_right_arr+0, 1 as u64
    store partial_right_arr+8, 4 as u64
    EXPAND ARRAY_INTO_ITER_U64 partial_left_iter, partial_left_backing, partial_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 partial_right_iter, partial_right_backing, partial_right_arr, 2
    EXPAND ARRAY_INTO_ITER_PARTIAL_CMP_U64 partial_cmp_order, partial_left_iter, partial_right_iter

    partial_by_left_arr = stack_alloc 24
    store partial_by_left_arr+0, 1 as u64
    store partial_by_left_arr+8, 99 as u64
    store partial_by_left_arr+16, 5 as u64
    partial_by_right_arr = stack_alloc 24
    store partial_by_right_arr+0, 1 as u64
    store partial_by_right_arr+8, 2 as u64
    store partial_by_right_arr+16, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 partial_by_left_iter, partial_by_left_backing, partial_by_left_arr, 3
    EXPAND ARRAY_INTO_ITER_U64 partial_by_right_iter, partial_by_right_backing, partial_by_right_arr, 3
    EXPAND ARRAY_INTO_ITER_PARTIAL_CMP_BY_U64 partial_by_ok, partial_by_order, partial_by_left_iter, partial_by_right_iter, @array_into_iter_cmp_partial_none_on_99
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 partial_by_left_remaining, partial_by_left_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 partial_by_right_remaining, partial_by_right_iter

    eq_by_left_arr = stack_alloc 16
    store eq_by_left_arr+0, 11 as u64
    store eq_by_left_arr+8, 22 as u64
    eq_by_right_arr = stack_alloc 16
    store eq_by_right_arr+0, 1 as u64
    store eq_by_right_arr+8, 2 as u64
    EXPAND ARRAY_INTO_ITER_U64 eq_by_left_iter, eq_by_left_backing, eq_by_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 eq_by_right_iter, eq_by_right_backing, eq_by_right_arr, 2
    EXPAND ARRAY_INTO_ITER_EQ_BY_U64 eq_by_value, eq_by_left_iter, eq_by_right_iter, @array_into_iter_cmp_eq_mod10

    eq_left_arr = stack_alloc 16
    store eq_left_arr+0, 7 as u64
    store eq_left_arr+8, 8 as u64
    eq_right_arr = stack_alloc 16
    store eq_right_arr+0, 7 as u64
    store eq_right_arr+8, 8 as u64
    EXPAND ARRAY_INTO_ITER_U64 eq_left_iter, eq_left_backing, eq_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 eq_right_iter, eq_right_backing, eq_right_arr, 2
    EXPAND ARRAY_INTO_ITER_EQ_U64 eq_value, eq_left_iter, eq_right_iter

    partial_eq_left_arr = stack_alloc 16
    store partial_eq_left_arr+0, 7 as u64
    store partial_eq_left_arr+8, 8 as u64
    partial_eq_right_arr = stack_alloc 16
    store partial_eq_right_arr+0, 7 as u64
    store partial_eq_right_arr+8, 8 as u64
    EXPAND ARRAY_INTO_ITER_U64 partial_eq_left_iter, partial_eq_left_backing, partial_eq_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 partial_eq_right_iter, partial_eq_right_backing, partial_eq_right_arr, 2
    EXPAND ARRAY_INTO_ITER_PARTIAL_EQ_U64 partial_eq_value, partial_eq_left_iter, partial_eq_right_iter

    ne_left_arr = stack_alloc 16
    store ne_left_arr+0, 7 as u64
    store ne_left_arr+8, 9 as u64
    ne_right_arr = stack_alloc 16
    store ne_right_arr+0, 7 as u64
    store ne_right_arr+8, 8 as u64
    EXPAND ARRAY_INTO_ITER_U64 ne_left_iter, ne_left_backing, ne_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 ne_right_iter, ne_right_backing, ne_right_arr, 2
    EXPAND ARRAY_INTO_ITER_NE_U64 ne_value, ne_left_iter, ne_right_iter

    lt_left_arr = stack_alloc 16
    store lt_left_arr+0, 1 as u64
    store lt_left_arr+8, 2 as u64
    lt_right_arr = stack_alloc 16
    store lt_right_arr+0, 1 as u64
    store lt_right_arr+8, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 lt_left_iter, lt_left_backing, lt_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 lt_right_iter, lt_right_backing, lt_right_arr, 2
    EXPAND ARRAY_INTO_ITER_LT_U64 lt_value, lt_left_iter, lt_right_iter

    le_left_arr = stack_alloc 16
    store le_left_arr+0, 1 as u64
    store le_left_arr+8, 2 as u64
    le_right_arr = stack_alloc 16
    store le_right_arr+0, 1 as u64
    store le_right_arr+8, 2 as u64
    EXPAND ARRAY_INTO_ITER_U64 le_left_iter, le_left_backing, le_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 le_right_iter, le_right_backing, le_right_arr, 2
    EXPAND ARRAY_INTO_ITER_LE_U64 le_value, le_left_iter, le_right_iter

    gt_left_arr = stack_alloc 16
    store gt_left_arr+0, 1 as u64
    store gt_left_arr+8, 4 as u64
    gt_right_arr = stack_alloc 16
    store gt_right_arr+0, 1 as u64
    store gt_right_arr+8, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 gt_left_iter, gt_left_backing, gt_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 gt_right_iter, gt_right_backing, gt_right_arr, 2
    EXPAND ARRAY_INTO_ITER_GT_U64 gt_value, gt_left_iter, gt_right_iter

    ge_left_arr = stack_alloc 16
    store ge_left_arr+0, 1 as u64
    store ge_left_arr+8, 2 as u64
    ge_right_arr = stack_alloc 16
    store ge_right_arr+0, 1 as u64
    store ge_right_arr+8, 2 as u64
    EXPAND ARRAY_INTO_ITER_U64 ge_left_iter, ge_left_backing, ge_left_arr, 2
    EXPAND ARRAY_INTO_ITER_U64 ge_right_iter, ge_right_backing, ge_right_arr, 2
    EXPAND ARRAY_INTO_ITER_GE_U64 ge_value, ge_left_iter, ge_right_iter

    EXPAND VEC_FREE cmp_eq_left_backing
    EXPAND VEC_FREE cmp_eq_right_backing
    EXPAND VEC_FREE cmp_less_left_backing
    EXPAND VEC_FREE cmp_less_right_backing
    EXPAND VEC_FREE cmp_short_left_backing
    EXPAND VEC_FREE cmp_short_right_backing
    EXPAND VEC_FREE partial_left_backing
    EXPAND VEC_FREE partial_right_backing
    EXPAND VEC_FREE partial_by_left_backing
    EXPAND VEC_FREE partial_by_right_backing
    EXPAND VEC_FREE eq_by_left_backing
    EXPAND VEC_FREE eq_by_right_backing
    EXPAND VEC_FREE eq_left_backing
    EXPAND VEC_FREE eq_right_backing
    EXPAND VEC_FREE partial_eq_left_backing
    EXPAND VEC_FREE partial_eq_right_backing
    EXPAND VEC_FREE ne_left_backing
    EXPAND VEC_FREE ne_right_backing
    EXPAND VEC_FREE lt_left_backing
    EXPAND VEC_FREE lt_right_backing
    EXPAND VEC_FREE le_left_backing
    EXPAND VEC_FREE le_right_backing
    EXPAND VEC_FREE gt_left_backing
    EXPAND VEC_FREE gt_right_backing
    EXPAND VEC_FREE ge_left_backing
    EXPAND VEC_FREE ge_right_backing

    ok_cmp_equal = eq cmp_equal, 0
    ok_cmp_less = slt cmp_less, 0
    ok_cmp_by_short = slt cmp_by_short, 0
    ok_partial_cmp = slt partial_cmp_order, 0
    ok_partial_by_flag = eq partial_by_ok, 0
    ok_partial_by_order = eq partial_by_order, 0
    ok_partial_by_left_remaining = eq partial_by_left_remaining, 1
    ok_partial_by_right_remaining = eq partial_by_right_remaining, 1
    ok_eq_by = eq eq_by_value, 1
    ok_eq = eq eq_value, 1
    ok_partial_eq = eq partial_eq_value, 1
    ok_ne = eq ne_value, 1
    ok_lt = eq lt_value, 1
    ok_le = eq le_value, 1
    ok_gt = eq gt_value, 1
    ok_ge = eq ge_value, 1

    ok = and ok_cmp_equal, ok_cmp_less
    ok = and ok, ok_cmp_by_short
    ok = and ok, ok_partial_cmp
    ok = and ok, ok_partial_by_flag
    ok = and ok, ok_partial_by_order
    ok = and ok, ok_partial_by_left_remaining
    ok = and ok, ok_partial_by_right_remaining
    ok = and ok, ok_eq_by
    ok = and ok, ok_eq
    ok = and ok, ok_partial_eq
    ok = and ok, ok_ne
    ok = and ok, ok_lt
    ok = and ok, ok_le
    ok = and ok, ok_gt
    ok = and ok, ok_ge

    !cmp_equal
    !cmp_less
    !cmp_by_short
    !partial_cmp_order
    !partial_by_ok
    !partial_by_order
    !partial_by_left_remaining
    !partial_by_right_remaining
    !eq_by_value
    !eq_value
    !partial_eq_value
    !ne_value
    !lt_value
    !le_value
    !gt_value
    !ge_value
    !ok_cmp_equal
    !ok_cmp_less
    !ok_cmp_by_short
    !ok_partial_cmp
    !ok_partial_by_flag
    !ok_partial_by_order
    !ok_partial_by_left_remaining
    !ok_partial_by_right_remaining
    !ok_eq_by
    !ok_eq
    !ok_partial_eq
    !ok_ne
    !ok_lt
    !ok_le
    !ok_gt
    !ok_ge
    !cmp_eq_left_iter
    !cmp_eq_right_iter
    !cmp_less_left_iter
    !cmp_less_right_iter
    !cmp_short_left_iter
    !cmp_short_right_iter
    !partial_left_iter
    !partial_right_iter
    !partial_by_left_iter
    !partial_by_right_iter
    !eq_by_left_iter
    !eq_by_right_iter
    !eq_left_iter
    !eq_right_iter
    !partial_eq_left_iter
    !partial_eq_right_iter
    !ne_left_iter
    !ne_right_iter
    !lt_left_iter
    !lt_right_iter
    !le_left_iter
    !le_right_iter
    !gt_left_iter
    !gt_right_iter
    !ge_left_iter
    !ge_right_iter
    br ok -> L_ARRAY_INTO_ITER_COMPARISON_OK, L_ARRAY_INTO_ITER_COMPARISON_FAIL

L_ARRAY_INTO_ITER_COMPARISON_FAIL:
    !ok
    panic(10745)

L_ARRAY_INTO_ITER_COMPARISON_OK:
    !ok
    return
