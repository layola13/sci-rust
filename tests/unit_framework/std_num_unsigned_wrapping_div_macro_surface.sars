@import "sa_std/num.sars"

@test "sa_std unsigned primitive wrapping division macro surface"():
L_ENTRY:
    EXPAND NUM_U8_DIV_EUCLID u8_div_euclid, 43, 7
    EXPAND NUM_U8_REM_EUCLID u8_rem_euclid, 43, 7
    EXPAND NUM_U8_WRAPPING_DIV u8_wrap_div, 43, 7
    EXPAND NUM_U8_WRAPPING_REM u8_wrap_rem, 43, 7
    EXPAND NUM_U8_WRAPPING_DIV_EUCLID u8_wrap_div_euclid, 43, 7
    EXPAND NUM_U8_WRAPPING_REM_EUCLID u8_wrap_rem_euclid, 43, 7
    EXPAND NUM_U8_DIV_EUCLID u8_div_mask, 300, 10
    EXPAND NUM_U8_REM_EUCLID u8_rem_mask, 300, 10

    EXPAND NUM_U16_DIV_EUCLID u16_div_euclid, 65535, 255
    EXPAND NUM_U16_REM_EUCLID u16_rem_euclid, 65535, 255
    EXPAND NUM_U16_WRAPPING_DIV u16_wrap_div, 65535, 255
    EXPAND NUM_U16_WRAPPING_REM u16_wrap_rem, 65535, 255
    EXPAND NUM_U16_WRAPPING_DIV_EUCLID u16_wrap_div_euclid, 65535, 255
    EXPAND NUM_U16_WRAPPING_REM_EUCLID u16_wrap_rem_euclid, 65535, 255
    EXPAND NUM_U16_DIV_EUCLID u16_div_mask, 70000, 1000
    EXPAND NUM_U16_REM_EUCLID u16_rem_mask, 70000, 1000

    EXPAND NUM_U32_DIV_EUCLID u32_div_euclid, 4294967295, 65535
    EXPAND NUM_U32_REM_EUCLID u32_rem_euclid, 4294967295, 65535
    EXPAND NUM_U32_WRAPPING_DIV u32_wrap_div, 4294967295, 65535
    EXPAND NUM_U32_WRAPPING_REM u32_wrap_rem, 4294967295, 65535
    EXPAND NUM_U32_WRAPPING_DIV_EUCLID u32_wrap_div_euclid, 4294967295, 65535
    EXPAND NUM_U32_WRAPPING_REM_EUCLID u32_wrap_rem_euclid, 4294967295, 65535
    EXPAND NUM_U32_DIV_EUCLID u32_div_mask, 4294967304, 3
    EXPAND NUM_U32_REM_EUCLID u32_rem_mask, 4294967304, 3

    EXPAND NUM_U64_WRAPPING_DIV_EUCLID u64_wrap_div_euclid, 100, 9
    EXPAND NUM_U64_WRAPPING_REM_EUCLID u64_wrap_rem_euclid, 100, 9
    EXPAND NUM_USIZE_WRAPPING_DIV usize_wrap_div, 1000000000000, 10
    EXPAND NUM_USIZE_WRAPPING_REM usize_wrap_rem, 1000000000001, 10
    EXPAND NUM_USIZE_WRAPPING_DIV_EUCLID usize_wrap_div_euclid, 1000000000000, 10
    EXPAND NUM_USIZE_WRAPPING_REM_EUCLID usize_wrap_rem_euclid, 1000000000001, 10

    ok01 = eq u8_div_euclid, 6
    ok02 = eq u8_rem_euclid, 1
    ok03 = eq u8_wrap_div, 6
    ok04 = eq u8_wrap_rem, 1
    ok05 = eq u8_wrap_div_euclid, 6
    ok06 = eq u8_wrap_rem_euclid, 1
    ok07 = eq u8_div_mask, 4
    ok08 = eq u8_rem_mask, 4

    ok09 = eq u16_div_euclid, 257
    ok10 = eq u16_rem_euclid, 0
    ok11 = eq u16_wrap_div, 257
    ok12 = eq u16_wrap_rem, 0
    ok13 = eq u16_wrap_div_euclid, 257
    ok14 = eq u16_wrap_rem_euclid, 0
    ok15 = eq u16_div_mask, 4
    ok16 = eq u16_rem_mask, 464

    ok17 = eq u32_div_euclid, 65537
    ok18 = eq u32_rem_euclid, 0
    ok19 = eq u32_wrap_div, 65537
    ok20 = eq u32_wrap_rem, 0
    ok21 = eq u32_wrap_div_euclid, 65537
    ok22 = eq u32_wrap_rem_euclid, 0
    ok23 = eq u32_div_mask, 2
    ok24 = eq u32_rem_mask, 2

    ok25 = eq u64_wrap_div_euclid, 11
    ok26 = eq u64_wrap_rem_euclid, 1
    ok27 = eq usize_wrap_div, 100000000000
    ok28 = eq usize_wrap_rem, 1
    ok29 = eq usize_wrap_div_euclid, 100000000000
    ok30 = eq usize_wrap_rem_euclid, 1

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    chain22 = and chain21, ok23
    chain23 = and chain22, ok24
    chain24 = and chain23, ok25
    chain25 = and chain24, ok26
    chain26 = and chain25, ok27
    chain27 = and chain26, ok28
    chain28 = and chain27, ok29
    ok = and chain28, ok30

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10668)

L_PASS:
    !ok
    return 0
