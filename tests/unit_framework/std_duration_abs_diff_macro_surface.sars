@import "sa_std/time.sars"

@test "sa_std duration abs_diff"():
L_ENTRY:
    EXPAND TIME_DURATION_FROM_NS a, 10
    EXPAND TIME_DURATION_FROM_NS b, 3
    EXPAND TIME_DURATION_ABS_DIFF d, a, b
    ok = eq d, 7
    !a
    !b
    !d
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10982)
