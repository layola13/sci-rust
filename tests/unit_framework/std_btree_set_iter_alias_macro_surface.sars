@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/vec.sars"
@import "sa_std/collections/btree_set.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"

@test "sa_std btree_set eager iter aliases"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_SET_NEW set
    EXPAND BTREE_SET_INSERT ins_charlie, set, charlie
    EXPAND BTREE_SET_INSERT ins_alpha, set, alpha
    EXPAND BTREE_SET_INSERT ins_bravo, set, bravo

    EXPAND BTREE_SET_ITER iter_vec, set
    EXPAND BTREE_SET_REF_INTO_ITER ref_iter_vec, set
    EXPAND VEC_LEN iter_len, iter_vec
    EXPAND VEC_LEN ref_iter_len, ref_iter_vec

    EXPAND VEC_GET_U64 iter_alpha_ptr_bits, iter_vec, 0
    EXPAND VEC_GET_U64 iter_alpha_len, iter_vec, 1
    EXPAND VEC_GET_U64 iter_bravo_ptr_bits, iter_vec, 2
    EXPAND VEC_GET_U64 iter_bravo_len, iter_vec, 3
    EXPAND VEC_GET_U64 iter_charlie_ptr_bits, iter_vec, 4
    EXPAND VEC_GET_U64 iter_charlie_len, iter_vec, 5
    EXPAND VEC_GET_U64 ref_iter_alpha_ptr_bits, ref_iter_vec, 0
    EXPAND VEC_GET_U64 ref_iter_alpha_len, ref_iter_vec, 1
    EXPAND VEC_GET_U64 ref_iter_bravo_ptr_bits, ref_iter_vec, 2
    EXPAND VEC_GET_U64 ref_iter_bravo_len, ref_iter_vec, 3
    EXPAND VEC_GET_U64 ref_iter_charlie_ptr_bits, ref_iter_vec, 4
    EXPAND VEC_GET_U64 ref_iter_charlie_len, ref_iter_vec, 5

    alpha_ptr = load alpha+Slice_ptr as ptr
    bravo_ptr = load bravo+Slice_ptr as ptr
    charlie_ptr = load charlie+Slice_ptr as ptr
    alpha_ptr_bits = bitcast alpha_ptr as u64
    bravo_ptr_bits = bitcast bravo_ptr as u64
    charlie_ptr_bits = bitcast charlie_ptr as u64
    EXPAND BTREE_SET_LEN set_len_after_iter, set

    EXPAND BTREE_SET_NEW empty_set
    EXPAND BTREE_SET_ITER empty_iter, empty_set
    EXPAND BTREE_SET_REF_INTO_ITER empty_ref_iter, empty_set
    EXPAND VEC_LEN empty_iter_len, empty_iter
    EXPAND VEC_LEN empty_ref_iter_len, empty_ref_iter

    ok_ins_charlie = eq ins_charlie, 1
    ok_ins_alpha = eq ins_alpha, 1
    ok_ins_bravo = eq ins_bravo, 1
    ok_iter_len = eq iter_len, 6
    ok_ref_iter_len = eq ref_iter_len, 6
    ok_iter_alpha_ptr = eq iter_alpha_ptr_bits, alpha_ptr_bits
    ok_iter_alpha_len = eq iter_alpha_len, 5
    ok_iter_bravo_ptr = eq iter_bravo_ptr_bits, bravo_ptr_bits
    ok_iter_bravo_len = eq iter_bravo_len, 5
    ok_iter_charlie_ptr = eq iter_charlie_ptr_bits, charlie_ptr_bits
    ok_iter_charlie_len = eq iter_charlie_len, 7
    ok_ref_iter_alpha_ptr = eq ref_iter_alpha_ptr_bits, alpha_ptr_bits
    ok_ref_iter_alpha_len = eq ref_iter_alpha_len, 5
    ok_ref_iter_bravo_ptr = eq ref_iter_bravo_ptr_bits, bravo_ptr_bits
    ok_ref_iter_bravo_len = eq ref_iter_bravo_len, 5
    ok_ref_iter_charlie_ptr = eq ref_iter_charlie_ptr_bits, charlie_ptr_bits
    ok_ref_iter_charlie_len = eq ref_iter_charlie_len, 7
    ok_set_len_after_iter = eq set_len_after_iter, 3
    ok_empty_iter = eq empty_iter_len, 0
    ok_empty_ref_iter = eq empty_ref_iter_len, 0

    ok01 = and ok_ins_charlie, ok_ins_alpha
    ok02 = and ok01, ok_ins_bravo
    ok03 = and ok02, ok_iter_len
    ok04 = and ok03, ok_ref_iter_len
    ok05 = and ok04, ok_iter_alpha_ptr
    ok06 = and ok05, ok_iter_alpha_len
    ok07 = and ok06, ok_iter_bravo_ptr
    ok08 = and ok07, ok_iter_bravo_len
    ok09 = and ok08, ok_iter_charlie_ptr
    ok10 = and ok09, ok_iter_charlie_len
    ok11 = and ok10, ok_ref_iter_alpha_ptr
    ok12 = and ok11, ok_ref_iter_alpha_len
    ok13 = and ok12, ok_ref_iter_bravo_ptr
    ok14 = and ok13, ok_ref_iter_bravo_len
    ok15 = and ok14, ok_ref_iter_charlie_ptr
    ok16 = and ok15, ok_ref_iter_charlie_len
    ok17 = and ok16, ok_set_len_after_iter
    ok18 = and ok17, ok_empty_iter
    ok = and ok18, ok_empty_ref_iter

    !ins_charlie
    !ins_alpha
    !ins_bravo
    !iter_vec
    !ref_iter_vec
    !iter_len
    !ref_iter_len
    !iter_alpha_ptr_bits
    !iter_alpha_len
    !iter_bravo_ptr_bits
    !iter_bravo_len
    !iter_charlie_ptr_bits
    !iter_charlie_len
    !ref_iter_alpha_ptr_bits
    !ref_iter_alpha_len
    !ref_iter_bravo_ptr_bits
    !ref_iter_bravo_len
    !ref_iter_charlie_ptr_bits
    !ref_iter_charlie_len
    !alpha_ptr
    !bravo_ptr
    !charlie_ptr
    !alpha_ptr_bits
    !bravo_ptr_bits
    !charlie_ptr_bits
    !set_len_after_iter
    !empty_iter
    !empty_ref_iter
    !empty_iter_len
    !empty_ref_iter_len
    !ok_ins_charlie
    !ok_ins_alpha
    !ok_ins_bravo
    !ok_iter_len
    !ok_ref_iter_len
    !ok_iter_alpha_ptr
    !ok_iter_alpha_len
    !ok_iter_bravo_ptr
    !ok_iter_bravo_len
    !ok_iter_charlie_ptr
    !ok_iter_charlie_len
    !ok_ref_iter_alpha_ptr
    !ok_ref_iter_alpha_len
    !ok_ref_iter_bravo_ptr
    !ok_ref_iter_bravo_len
    !ok_ref_iter_charlie_ptr
    !ok_ref_iter_charlie_len
    !ok_set_len_after_iter
    !ok_empty_iter
    !ok_empty_ref_iter
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_SET_FREE empty_set
    EXPAND BTREE_SET_FREE set
    return 0

L_FAIL:
    panic(10809)
