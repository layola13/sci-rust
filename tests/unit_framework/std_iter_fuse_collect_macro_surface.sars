@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@test "sa_std iter fuse collect macro surface"():
L_ENTRY:
    values = stack_alloc 32
    empty_values = stack_alloc 8

    store values+0, 2 as u64
    store values+8, 4 as u64
    store values+16, 6 as u64
    store values+24, 8 as u64

    slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 4
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_NEXT_U64 first_ok, first_value, iter
    EXPAND ITER_FUSE_COLLECT_U64 fuse_vec, iter
    EXPAND ITER_NEXT_U64 after_ok, after_value, iter
    EXPAND ITER_NEXT_U64 after_again_ok, after_again_value, iter
    EXPAND VEC_LEN fuse_len, fuse_vec
    EXPAND VEC_GET_U64 fuse_0, fuse_vec, 0
    EXPAND VEC_GET_U64 fuse_1, fuse_vec, 1
    EXPAND VEC_GET_U64 fuse_2, fuse_vec, 2

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_NEXT_U64 empty_before_ok, empty_before_value, empty_iter
    EXPAND ITER_FUSE_COLLECT_U64 empty_vec, empty_iter
    EXPAND ITER_NEXT_U64 empty_after_ok, empty_after_value, empty_iter
    EXPAND VEC_LEN empty_len, empty_vec

    ok_first_ok = eq first_ok, 1
    ok_first_value = eq first_value, 2
    ok_after_ok = eq after_ok, 0
    ok_after_value = eq after_value, 0
    ok_after_again_ok = eq after_again_ok, 0
    ok_after_again_value = eq after_again_value, 0
    ok_fuse_len = eq fuse_len, 3
    ok_fuse_0 = eq fuse_0, 4
    ok_fuse_1 = eq fuse_1, 6
    ok_fuse_2 = eq fuse_2, 8
    ok_empty_before_ok = eq empty_before_ok, 0
    ok_empty_before_value = eq empty_before_value, 0
    ok_empty_after_ok = eq empty_after_ok, 0
    ok_empty_after_value = eq empty_after_value, 0
    ok_empty_len = eq empty_len, 0

    c01 = and ok_first_ok, ok_first_value
    c02 = and c01, ok_after_ok
    c03 = and c02, ok_after_value
    c04 = and c03, ok_after_again_ok
    c05 = and c04, ok_after_again_value
    c06 = and c05, ok_fuse_len
    c07 = and c06, ok_fuse_0
    c08 = and c07, ok_fuse_1
    c09 = and c08, ok_fuse_2
    c10 = and c09, ok_empty_before_ok
    c11 = and c10, ok_empty_before_value
    c12 = and c11, ok_empty_after_ok
    c13 = and c12, ok_empty_after_value
    ok = and c13, ok_empty_len

    !first_ok
    !first_value
    !after_ok
    !after_value
    !after_again_ok
    !after_again_value
    !fuse_len
    !fuse_0
    !fuse_1
    !fuse_2
    !empty_before_ok
    !empty_before_value
    !empty_after_ok
    !empty_after_value
    !empty_len
    !ok_first_ok
    !ok_first_value
    !ok_after_ok
    !ok_after_value
    !ok_after_again_ok
    !ok_after_again_value
    !ok_fuse_len
    !ok_fuse_0
    !ok_fuse_1
    !ok_fuse_2
    !ok_empty_before_ok
    !ok_empty_before_value
    !ok_empty_after_ok
    !ok_empty_after_value
    !ok_empty_len
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !empty_vec
    !empty_iter
    !fuse_vec
    !iter
    !empty_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10548)

L_PASS:
    !ok
    return 0
