@import "sa_std/num.sars"

@test "sa_std nonzero unsigned checked next power macro surface"():
L_ENTRY:
    u8_three = stack_alloc NonZeroU8_SIZE
    u8_power = stack_alloc NonZeroU8_SIZE
    u8_max = stack_alloc NonZeroU8_SIZE
    u8_out_three = stack_alloc NonZeroU8_SIZE
    u8_out_power = stack_alloc NonZeroU8_SIZE
    u8_out_max = stack_alloc NonZeroU8_SIZE

    u16_three = stack_alloc NonZeroU16_SIZE
    u16_power = stack_alloc NonZeroU16_SIZE
    u16_max = stack_alloc NonZeroU16_SIZE
    u16_out_three = stack_alloc NonZeroU16_SIZE
    u16_out_power = stack_alloc NonZeroU16_SIZE
    u16_out_max = stack_alloc NonZeroU16_SIZE

    u32_three = stack_alloc NonZeroU32_SIZE
    u32_power = stack_alloc NonZeroU32_SIZE
    u32_max = stack_alloc NonZeroU32_SIZE
    u32_out_three = stack_alloc NonZeroU32_SIZE
    u32_out_power = stack_alloc NonZeroU32_SIZE
    u32_out_max = stack_alloc NonZeroU32_SIZE

    u64_three = stack_alloc NonZeroU64_SIZE
    u64_power = stack_alloc NonZeroU64_SIZE
    u64_max = stack_alloc NonZeroU64_SIZE
    u64_out_three = stack_alloc NonZeroU64_SIZE
    u64_out_power = stack_alloc NonZeroU64_SIZE
    u64_out_max = stack_alloc NonZeroU64_SIZE

    usize_three = stack_alloc NonZeroUsize_SIZE
    usize_power = stack_alloc NonZeroUsize_SIZE
    usize_max = stack_alloc NonZeroUsize_SIZE
    usize_out_three = stack_alloc NonZeroUsize_SIZE
    usize_out_power = stack_alloc NonZeroUsize_SIZE
    usize_out_max = stack_alloc NonZeroUsize_SIZE

    u64_mid_power = shl 1, 62
    u64_large_value = add u64_mid_power, 1
    u64_next_power = shl 1, 63

    EXPAND NONZERO_U8_NEW ok_u8_three_new, u8_three, 3
    EXPAND NONZERO_U8_NEW ok_u8_power_new, u8_power, 128
    EXPAND NONZERO_U8_NEW ok_u8_max_new, u8_max, NUM_U8_MAX
    EXPAND NONZERO_U16_NEW ok_u16_three_new, u16_three, 4097
    EXPAND NONZERO_U16_NEW ok_u16_power_new, u16_power, 32768
    EXPAND NONZERO_U16_NEW ok_u16_max_new, u16_max, NUM_U16_MAX
    EXPAND NONZERO_U32_NEW ok_u32_three_new, u32_three, 268435457
    EXPAND NONZERO_U32_NEW ok_u32_power_new, u32_power, 2147483648
    EXPAND NONZERO_U32_NEW ok_u32_max_new, u32_max, NUM_U32_MAX
    EXPAND NONZERO_U64_NEW ok_u64_three_new, u64_three, 3
    EXPAND NONZERO_U64_NEW ok_u64_power_new, u64_power, u64_large_value
    EXPAND NONZERO_U64_NEW ok_u64_max_new, u64_max, NUM_U64_MAX
    EXPAND NONZERO_USIZE_NEW ok_usize_three_new, usize_three, 3
    EXPAND NONZERO_USIZE_NEW ok_usize_power_new, usize_power, u64_large_value
    EXPAND NONZERO_USIZE_NEW ok_usize_max_new, usize_max, NUM_U64_MAX

    EXPAND NONZERO_U8_CHECKED_NEXT_POWER_OF_TWO ok_u8_three, u8_out_three, u8_three
    EXPAND NONZERO_U8_CHECKED_NEXT_POWER_OF_TWO ok_u8_power, u8_out_power, u8_power
    EXPAND NONZERO_U8_CHECKED_NEXT_POWER_OF_TWO ok_u8_max, u8_out_max, u8_max
    EXPAND NONZERO_U16_CHECKED_NEXT_POWER_OF_TWO ok_u16_three, u16_out_three, u16_three
    EXPAND NONZERO_U16_CHECKED_NEXT_POWER_OF_TWO ok_u16_power, u16_out_power, u16_power
    EXPAND NONZERO_U16_CHECKED_NEXT_POWER_OF_TWO ok_u16_max, u16_out_max, u16_max
    EXPAND NONZERO_U32_CHECKED_NEXT_POWER_OF_TWO ok_u32_three, u32_out_three, u32_three
    EXPAND NONZERO_U32_CHECKED_NEXT_POWER_OF_TWO ok_u32_power, u32_out_power, u32_power
    EXPAND NONZERO_U32_CHECKED_NEXT_POWER_OF_TWO ok_u32_max, u32_out_max, u32_max
    EXPAND NONZERO_U64_CHECKED_NEXT_POWER_OF_TWO ok_u64_three, u64_out_three, u64_three
    EXPAND NONZERO_U64_CHECKED_NEXT_POWER_OF_TWO ok_u64_power, u64_out_power, u64_power
    EXPAND NONZERO_U64_CHECKED_NEXT_POWER_OF_TWO ok_u64_max, u64_out_max, u64_max
    EXPAND NONZERO_USIZE_CHECKED_NEXT_POWER_OF_TWO ok_usize_three, usize_out_three, usize_three
    EXPAND NONZERO_USIZE_CHECKED_NEXT_POWER_OF_TWO ok_usize_power, usize_out_power, usize_power
    EXPAND NONZERO_USIZE_CHECKED_NEXT_POWER_OF_TWO ok_usize_max, usize_out_max, usize_max

    EXPAND NONZERO_U8_GET u8_three_value, u8_out_three
    EXPAND NONZERO_U8_GET u8_power_value, u8_out_power
    EXPAND NONZERO_U16_GET u16_three_value, u16_out_three
    EXPAND NONZERO_U16_GET u16_power_value, u16_out_power
    EXPAND NONZERO_U32_GET u32_three_value, u32_out_three
    EXPAND NONZERO_U32_GET u32_power_value, u32_out_power
    EXPAND NONZERO_U64_GET u64_three_value, u64_out_three
    EXPAND NONZERO_U64_GET u64_power_value, u64_out_power
    EXPAND NONZERO_USIZE_GET usize_three_value, usize_out_three
    EXPAND NONZERO_USIZE_GET usize_power_value, usize_out_power

    ok_new_01 = and ok_u8_three_new, ok_u8_power_new
    ok_new_02 = and ok_new_01, ok_u8_max_new
    ok_new_03 = and ok_new_02, ok_u16_three_new
    ok_new_04 = and ok_new_03, ok_u16_power_new
    ok_new_05 = and ok_new_04, ok_u16_max_new
    ok_new_06 = and ok_new_05, ok_u32_three_new
    ok_new_07 = and ok_new_06, ok_u32_power_new
    ok_new_08 = and ok_new_07, ok_u32_max_new
    ok_new_09 = and ok_new_08, ok_u64_three_new
    ok_new_10 = and ok_new_09, ok_u64_power_new
    ok_new_11 = and ok_new_10, ok_u64_max_new
    ok_new_12 = and ok_new_11, ok_usize_three_new
    ok_new_13 = and ok_new_12, ok_usize_power_new
    ok_new_all = and ok_new_13, ok_usize_max_new

    ok_success_01 = and ok_u8_three, ok_u8_power
    ok_success_02 = and ok_success_01, ok_u16_three
    ok_success_03 = and ok_success_02, ok_u16_power
    ok_success_04 = and ok_success_03, ok_u32_three
    ok_success_05 = and ok_success_04, ok_u32_power
    ok_success_06 = and ok_success_05, ok_u64_three
    ok_success_07 = and ok_success_06, ok_u64_power
    ok_success_08 = and ok_success_07, ok_usize_three
    ok_success_all = and ok_success_08, ok_usize_power

    ok_u8_max_none = eq ok_u8_max, 0
    ok_u16_max_none = eq ok_u16_max, 0
    ok_u32_max_none = eq ok_u32_max, 0
    ok_u64_max_none = eq ok_u64_max, 0
    ok_usize_max_none = eq ok_usize_max, 0
    ok_none_01 = and ok_u8_max_none, ok_u16_max_none
    ok_none_02 = and ok_none_01, ok_u32_max_none
    ok_none_03 = and ok_none_02, ok_u64_max_none
    ok_none_all = and ok_none_03, ok_usize_max_none

    ok_u8_three_value = eq u8_three_value, 4
    ok_u8_power_value = eq u8_power_value, 128
    ok_u16_three_value = eq u16_three_value, 8192
    ok_u16_power_value = eq u16_power_value, 32768
    ok_u32_three_value = eq u32_three_value, 536870912
    ok_u32_power_value = eq u32_power_value, 2147483648
    ok_u64_three_value = eq u64_three_value, 4
    ok_u64_power_value = eq u64_power_value, u64_next_power
    ok_usize_three_value = eq usize_three_value, 4
    ok_usize_power_value = eq usize_power_value, u64_next_power

    ok_value_01 = and ok_new_all, ok_success_all
    ok_value_02 = and ok_value_01, ok_none_all
    ok_value_03 = and ok_value_02, ok_u8_three_value
    ok_value_04 = and ok_value_03, ok_u8_power_value
    ok_value_05 = and ok_value_04, ok_u16_three_value
    ok_value_06 = and ok_value_05, ok_u16_power_value
    ok_value_07 = and ok_value_06, ok_u32_three_value
    ok_value_08 = and ok_value_07, ok_u32_power_value
    ok_value_09 = and ok_value_08, ok_u64_three_value
    ok_value_10 = and ok_value_09, ok_u64_power_value
    ok_value_11 = and ok_value_10, ok_usize_three_value
    ok = and ok_value_11, ok_usize_power_value
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    !u64_large_value
    !u64_next_power
    panic(10611)

L_PASS:
    !ok
    !u64_large_value
    !u64_next_power
    return 0
