@import "sa_std/vec.sars"

@test "sa_std vec into_iter next_chunk macro surface"():
L_ENTRY:
    chunk_buf = stack_alloc 24
    EXPAND VEC_NEW chunk_src
    EXPAND VEC_PUSH_U64 chunk_src, 1
    EXPAND VEC_PUSH_U64 chunk_src, 2
    EXPAND VEC_PUSH_U64 chunk_src, 3
    EXPAND VEC_PUSH_U64 chunk_src, 4
    EXPAND VEC_PUSH_U64 chunk_src, 5
    EXPAND VEC_INTO_ITER_U64 chunk_iter, chunk_backing, chunk_src
    EXPAND VEC_INTO_ITER_TRY_NEXT_CHUNK_U64 chunk_ok, chunk_filled, chunk_iter, chunk_buf, 3
    chunk_0 = load chunk_buf+0 as u64
    chunk_1 = load chunk_buf+8 as u64
    chunk_2 = load chunk_buf+16 as u64
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 chunk_remaining, chunk_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 chunk_next_has, chunk_next, chunk_iter

    short_buf = stack_alloc 32
    EXPAND VEC_NEW short_src
    EXPAND VEC_PUSH_U64 short_src, 10
    EXPAND VEC_PUSH_U64 short_src, 20
    EXPAND VEC_PUSH_U64 short_src, 30
    EXPAND VEC_PUSH_U64 short_src, 40
    EXPAND VEC_PUSH_U64 short_src, 50
    EXPAND VEC_INTO_ITER_U64 short_iter, short_backing, short_src
    EXPAND VEC_INTO_ITER_ADVANCE_BY short_skip_ok, short_skip_remaining, short_iter, 3
    EXPAND VEC_INTO_ITER_TRY_NEXT_CHUNK_U64 short_ok, short_filled, short_iter, short_buf, 4
    short_0 = load short_buf+0 as u64
    short_1 = load short_buf+8 as u64
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 short_empty, short_iter

    zero_buf = stack_alloc 8
    EXPAND VEC_NEW zero_src
    EXPAND VEC_PUSH_U64 zero_src, 7
    EXPAND VEC_PUSH_U64 zero_src, 8
    EXPAND VEC_INTO_ITER_U64 zero_iter, zero_backing, zero_src
    EXPAND VEC_INTO_ITER_NEXT_U64 zero_first_has, zero_first, zero_iter
    EXPAND VEC_INTO_ITER_TRY_NEXT_CHUNK_U64 zero_ok, zero_filled, zero_iter, zero_buf, 0
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 zero_remaining, zero_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 zero_next_has, zero_next, zero_iter

    exact_buf = stack_alloc 16
    EXPAND VEC_NEW exact_src
    EXPAND VEC_PUSH_U64 exact_src, 9
    EXPAND VEC_PUSH_U64 exact_src, 10
    EXPAND VEC_INTO_ITER_U64 exact_iter, exact_backing, exact_src
    EXPAND VEC_INTO_ITER_TRY_NEXT_CHUNK_U64 exact_ok, exact_filled, exact_iter, exact_buf, 2
    exact_0 = load exact_buf+0 as u64
    exact_1 = load exact_buf+8 as u64
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 exact_empty, exact_iter

    empty_buf = stack_alloc 8
    EXPAND VEC_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND VEC_INTO_ITER_TRY_NEXT_CHUNK_U64 empty_ok, empty_filled, empty_iter, empty_buf, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_empty, empty_iter

    EXPAND VEC_FREE chunk_backing
    EXPAND VEC_FREE short_backing
    EXPAND VEC_FREE zero_backing
    EXPAND VEC_FREE exact_backing
    EXPAND VEC_FREE empty_backing

    ok_chunk_ok = eq chunk_ok, 1
    ok_chunk_filled = eq chunk_filled, 3
    ok_chunk_0 = eq chunk_0, 1
    ok_chunk_1 = eq chunk_1, 2
    ok_chunk_2 = eq chunk_2, 3
    ok_chunk_remaining = eq chunk_remaining, 2
    ok_chunk_next_has = eq chunk_next_has, 1
    ok_chunk_next = eq chunk_next, 4
    ok_short_skip_ok = eq short_skip_ok, 1
    ok_short_skip_remaining = eq short_skip_remaining, 0
    ok_short_ok = eq short_ok, 0
    ok_short_filled = eq short_filled, 2
    ok_short_0 = eq short_0, 40
    ok_short_1 = eq short_1, 50
    ok_short_empty = eq short_empty, 1
    ok_zero_first_has = eq zero_first_has, 1
    ok_zero_first = eq zero_first, 7
    ok_zero_ok = eq zero_ok, 1
    ok_zero_filled = eq zero_filled, 0
    ok_zero_remaining = eq zero_remaining, 1
    ok_zero_next_has = eq zero_next_has, 1
    ok_zero_next = eq zero_next, 8
    ok_exact_ok = eq exact_ok, 1
    ok_exact_filled = eq exact_filled, 2
    ok_exact_0 = eq exact_0, 9
    ok_exact_1 = eq exact_1, 10
    ok_exact_empty = eq exact_empty, 1
    ok_empty_ok = eq empty_ok, 0
    ok_empty_filled = eq empty_filled, 0
    ok_empty_empty = eq empty_empty, 1

    ok = and ok_chunk_ok, ok_chunk_filled
    ok = and ok, ok_chunk_0
    ok = and ok, ok_chunk_1
    ok = and ok, ok_chunk_2
    ok = and ok, ok_chunk_remaining
    ok = and ok, ok_chunk_next_has
    ok = and ok, ok_chunk_next
    ok = and ok, ok_short_skip_ok
    ok = and ok, ok_short_skip_remaining
    ok = and ok, ok_short_ok
    ok = and ok, ok_short_filled
    ok = and ok, ok_short_0
    ok = and ok, ok_short_1
    ok = and ok, ok_short_empty
    ok = and ok, ok_zero_first_has
    ok = and ok, ok_zero_first
    ok = and ok, ok_zero_ok
    ok = and ok, ok_zero_filled
    ok = and ok, ok_zero_remaining
    ok = and ok, ok_zero_next_has
    ok = and ok, ok_zero_next
    ok = and ok, ok_exact_ok
    ok = and ok, ok_exact_filled
    ok = and ok, ok_exact_0
    ok = and ok, ok_exact_1
    ok = and ok, ok_exact_empty
    ok = and ok, ok_empty_ok
    ok = and ok, ok_empty_filled
    ok = and ok, ok_empty_empty

    !chunk_ok
    !chunk_filled
    !chunk_0
    !chunk_1
    !chunk_2
    !chunk_remaining
    !chunk_next_has
    !chunk_next
    !short_skip_ok
    !short_skip_remaining
    !short_ok
    !short_filled
    !short_0
    !short_1
    !short_empty
    !zero_first_has
    !zero_first
    !zero_ok
    !zero_filled
    !zero_remaining
    !zero_next_has
    !zero_next
    !exact_ok
    !exact_filled
    !exact_0
    !exact_1
    !exact_empty
    !empty_ok
    !empty_filled
    !empty_empty
    !ok_chunk_ok
    !ok_chunk_filled
    !ok_chunk_0
    !ok_chunk_1
    !ok_chunk_2
    !ok_chunk_remaining
    !ok_chunk_next_has
    !ok_chunk_next
    !ok_short_skip_ok
    !ok_short_skip_remaining
    !ok_short_ok
    !ok_short_filled
    !ok_short_0
    !ok_short_1
    !ok_short_empty
    !ok_zero_first_has
    !ok_zero_first
    !ok_zero_ok
    !ok_zero_filled
    !ok_zero_remaining
    !ok_zero_next_has
    !ok_zero_next
    !ok_exact_ok
    !ok_exact_filled
    !ok_exact_0
    !ok_exact_1
    !ok_exact_empty
    !ok_empty_ok
    !ok_empty_filled
    !ok_empty_empty
    !chunk_iter
    !short_iter
    !zero_iter
    !exact_iter
    !empty_iter
    br ok -> L_VEC_INTO_ITER_NEXT_CHUNK_OK, L_VEC_INTO_ITER_NEXT_CHUNK_FAIL

L_VEC_INTO_ITER_NEXT_CHUNK_FAIL:
    !ok
    panic(10728)

L_VEC_INTO_ITER_NEXT_CHUNK_OK:
    !ok
    return
