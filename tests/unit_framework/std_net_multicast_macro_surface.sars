@import "sa_std/net.sars"

@const NET_TEST_LOOPBACK = utf8:"127.0.0.1"
@const NET_TEST_ANY_V4 = utf8:"0.0.0.0"
@const NET_TEST_MULTICAST_V4 = utf8:"224.0.0.251"
@const NET_TEST_LOOPBACK_V6 = utf8:"::1"
@const NET_TEST_MULTICAST_V6 = utf8:"ff01::114"

#def NET_TEST_LOOPBACK_LEN = 9
#def NET_TEST_ANY_V4_LEN = 7
#def NET_TEST_MULTICAST_V4_LEN = 11
#def NET_TEST_LOOPBACK_V6_LEN = 3
#def NET_TEST_MULTICAST_V6_LEN = 9

@test "sa_std net udp multicast v4 macro surface"():
L_ENTRY:
    EXPAND NET_UDP_BIND bind_status, socket, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    bind_status_ok = eq bind_status, 0
    socket_ok = ne socket, 0
    bind_ok = and bind_status_ok, socket_ok
    br bind_ok -> L_LOCAL_ADDR, L_FAIL_BIND

L_FAIL_BIND:
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10108)

L_LOCAL_ADDR:
    EXPAND NET_UDP_LOCAL_ADDR addr_status, addr, socket
    addr_status_ok = eq addr_status, 0
    addr_ok = ne addr, 0
    addr_fetch_ok = and addr_status_ok, addr_ok
    br addr_fetch_ok -> L_ADDR_FIELDS, L_FAIL_LOCAL_ADDR

L_FAIL_LOCAL_ADDR:
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !addr
    !addr_status
    EXPAND NET_UDP_CLOSE close_socket_status_a, socket
    !close_socket_status_a
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10109)

L_ADDR_FIELDS:
    EXPAND NET_ADDR_IS_IPV4 addr_is_ipv4, addr
    EXPAND NET_ADDR_SCOPE_ID addr_scope_id, addr
    addr_ipv4_ok = eq addr_is_ipv4, 1
    addr_scope_ok = eq addr_scope_id, 0
    addr_fields_ok = and addr_ipv4_ok, addr_scope_ok
    EXPAND NET_ADDR_FREE addr_free_status, addr
    addr_free_ok = eq addr_free_status, 0
    addr_all_ok = and addr_fields_ok, addr_free_ok
    !addr_is_ipv4
    !addr_scope_id
    !addr_ipv4_ok
    !addr_scope_ok
    !addr_fields_ok
    !addr_free_status
    br addr_all_ok -> L_LOOP_DISABLE, L_FAIL_ADDR_FIELDS

L_FAIL_ADDR_FIELDS:
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    EXPAND NET_UDP_CLOSE close_socket_status_b, socket
    !close_socket_status_b
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10110)

L_LOOP_DISABLE:
    EXPAND NET_UDP_SET_MULTICAST_LOOP_V4 set_loop0_status, socket, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_UDP_MULTICAST_LOOP_V4 get_loop0_status, loop0_enabled, socket
    set_loop0_ok = eq set_loop0_status, 0
    get_loop0_ok = eq get_loop0_status, 0
    loop0_value_ok = eq loop0_enabled, 0
    loop0_ok0 = and set_loop0_ok, get_loop0_ok
    loop0_ok = and loop0_ok0, loop0_value_ok
    br loop0_ok -> L_LOOP_ENABLE, L_FAIL_LOOP0

L_FAIL_LOOP0:
    !loop0_ok
    !loop0_ok0
    !loop0_value_ok
    !get_loop0_ok
    !set_loop0_ok
    !loop0_enabled
    !get_loop0_status
    !set_loop0_status
    EXPAND NET_UDP_CLOSE close_socket_status_c, socket
    !close_socket_status_c
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10111)

L_LOOP_ENABLE:
    EXPAND NET_UDP_SET_MULTICAST_LOOP_V4 set_loop1_status, socket, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_UDP_MULTICAST_LOOP_V4 get_loop1_status, loop1_enabled, socket
    set_loop1_ok = eq set_loop1_status, 0
    get_loop1_ok = eq get_loop1_status, 0
    loop1_value_ok = eq loop1_enabled, 1
    loop1_ok0 = and set_loop1_ok, get_loop1_ok
    loop1_ok = and loop1_ok0, loop1_value_ok
    br loop1_ok -> L_TTL, L_FAIL_LOOP1

L_FAIL_LOOP1:
    !loop1_ok
    !loop1_ok0
    !loop1_value_ok
    !get_loop1_ok
    !set_loop1_ok
    !loop1_enabled
    !get_loop1_status
    !set_loop1_status
    EXPAND NET_UDP_CLOSE close_socket_status_d, socket
    !close_socket_status_d
    !loop0_ok
    !loop0_ok0
    !loop0_value_ok
    !get_loop0_ok
    !set_loop0_ok
    !loop0_enabled
    !get_loop0_status
    !set_loop0_status
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10112)

L_TTL:
    EXPAND NET_UDP_SET_MULTICAST_TTL_V4 set_ttl_status, socket, 7
    EXPAND NET_UDP_MULTICAST_TTL_V4 get_ttl_status, ttl_value, socket
    set_ttl_ok = eq set_ttl_status, 0
    get_ttl_ok = eq get_ttl_status, 0
    ttl_value_ok = eq ttl_value, 7
    ttl_ok0 = and set_ttl_ok, get_ttl_ok
    ttl_ok = and ttl_ok0, ttl_value_ok
    br ttl_ok -> L_JOIN, L_FAIL_TTL

L_FAIL_TTL:
    !ttl_ok
    !ttl_ok0
    !ttl_value_ok
    !get_ttl_ok
    !set_ttl_ok
    !ttl_value
    !get_ttl_status
    !set_ttl_status
    EXPAND NET_UDP_CLOSE close_socket_status_e, socket
    !close_socket_status_e
    !loop1_ok
    !loop1_ok0
    !loop1_value_ok
    !get_loop1_ok
    !set_loop1_ok
    !loop1_enabled
    !get_loop1_status
    !set_loop1_status
    !loop0_ok
    !loop0_ok0
    !loop0_value_ok
    !get_loop0_ok
    !set_loop0_ok
    !loop0_enabled
    !get_loop0_status
    !set_loop0_status
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10113)

L_JOIN:
    EXPAND NET_UDP_JOIN_MULTICAST_V4 join_status, socket, NET_TEST_MULTICAST_V4, NET_TEST_MULTICAST_V4_LEN, NET_TEST_ANY_V4, NET_TEST_ANY_V4_LEN
    join_ok = eq join_status, 0
    br join_ok -> L_LEAVE, L_FAIL_JOIN

L_FAIL_JOIN:
    !join_ok
    !join_status
    EXPAND NET_UDP_CLOSE close_socket_status_f, socket
    !close_socket_status_f
    !ttl_ok
    !ttl_ok0
    !ttl_value_ok
    !get_ttl_ok
    !set_ttl_ok
    !ttl_value
    !get_ttl_status
    !set_ttl_status
    !loop1_ok
    !loop1_ok0
    !loop1_value_ok
    !get_loop1_ok
    !set_loop1_ok
    !loop1_enabled
    !get_loop1_status
    !set_loop1_status
    !loop0_ok
    !loop0_ok0
    !loop0_value_ok
    !get_loop0_ok
    !set_loop0_ok
    !loop0_enabled
    !get_loop0_status
    !set_loop0_status
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    panic(10114)

L_LEAVE:
    EXPAND NET_UDP_LEAVE_MULTICAST_V4 leave_status, socket, NET_TEST_MULTICAST_V4, NET_TEST_MULTICAST_V4_LEN, NET_TEST_ANY_V4, NET_TEST_ANY_V4_LEN
    leave_ok = eq leave_status, 0
    EXPAND NET_UDP_CLOSE close_socket_status, socket
    close_socket_ok = eq close_socket_status, 0
    ok0 = and bind_ok, addr_all_ok
    ok1 = and ok0, loop0_ok
    ok2 = and ok1, loop1_ok
    ok3 = and ok2, ttl_ok
    ok4 = and ok3, join_ok
    ok5 = and ok4, leave_ok
    ok = and ok5, close_socket_ok
    !leave_status
    !leave_ok
    !close_socket_status
    !close_socket_ok
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !ok5
    !join_ok
    !join_status
    !ttl_ok
    !ttl_ok0
    !ttl_value_ok
    !get_ttl_ok
    !set_ttl_ok
    !ttl_value
    !get_ttl_status
    !set_ttl_status
    !loop1_ok
    !loop1_ok0
    !loop1_value_ok
    !get_loop1_ok
    !set_loop1_ok
    !loop1_enabled
    !get_loop1_status
    !set_loop1_status
    !loop0_ok
    !loop0_ok0
    !loop0_value_ok
    !get_loop0_ok
    !set_loop0_ok
    !loop0_enabled
    !get_loop0_status
    !set_loop0_status
    !addr_all_ok
    !addr_free_ok
    !addr
    !addr_status
    !addr_fetch_ok
    !addr_ok
    !addr_status_ok
    !bind_ok
    !socket_ok
    !bind_status_ok
    !socket
    !bind_status
    br ok -> L_OK, L_FAIL_DONE

L_FAIL_DONE:
    !ok
    panic(10115)

L_OK:
    !ok
    return
