@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@test "sa_std iter step_by collect macro surface"():
L_ENTRY:
    values = stack_alloc 56
    store values+0, 0 as u64
    store values+8, 1 as u64
    store values+16, 2 as u64
    store values+24, 3 as u64
    store values+32, 4 as u64
    store values+40, 5 as u64
    store values+48, 6 as u64

    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 7

    EXPAND ITER_FROM_SLICE step2_iter, slice
    EXPAND ITER_STEP_BY_COLLECT_U64 step2_vec, step2_iter, 2
    EXPAND ITER_IS_EMPTY step2_empty, step2_iter
    EXPAND VEC_LEN step2_len, step2_vec
    EXPAND VEC_GET_U64 step2_0, step2_vec, 0
    EXPAND VEC_GET_U64 step2_1, step2_vec, 1
    EXPAND VEC_GET_U64 step2_2, step2_vec, 2
    EXPAND VEC_GET_U64 step2_3, step2_vec, 3

    EXPAND ITER_FROM_SLICE tail_iter, slice
    EXPAND ITER_NEXT_U64 tail_skip_ok, tail_skip_value, tail_iter
    EXPAND ITER_STEP_BY_COLLECT_U64 tail_vec, tail_iter, 3
    EXPAND ITER_IS_EMPTY tail_empty, tail_iter
    EXPAND VEC_LEN tail_len, tail_vec
    EXPAND VEC_GET_U64 tail_0, tail_vec, 0
    EXPAND VEC_GET_U64 tail_1, tail_vec, 1

    EXPAND ITER_FROM_SLICE step1_iter, slice
    EXPAND ITER_STEP_BY_COLLECT_U64 step1_vec, step1_iter, 1
    EXPAND ITER_IS_EMPTY step1_empty, step1_iter
    EXPAND VEC_LEN step1_len, step1_vec
    EXPAND VEC_GET_U64 step1_6, step1_vec, 6

    EXPAND ITER_FROM_SLICE invalid_iter, slice
    EXPAND ITER_TRY_STEP_BY_COLLECT_U64 invalid_ok, invalid_vec, invalid_iter, 0
    EXPAND VEC_LEN invalid_len, invalid_vec
    EXPAND ITER_NEXT_U64 invalid_next_ok, invalid_next_value, invalid_iter

    ok_step2_empty = eq step2_empty, 1
    ok_step2_len = eq step2_len, 4
    ok_step2_0 = eq step2_0, 0
    ok_step2_1 = eq step2_1, 2
    ok_step2_2 = eq step2_2, 4
    ok_step2_3 = eq step2_3, 6
    ok_tail_skip_flag = eq tail_skip_ok, 1
    ok_tail_skip_value = eq tail_skip_value, 0
    ok_tail_empty = eq tail_empty, 1
    ok_tail_len = eq tail_len, 2
    ok_tail_0 = eq tail_0, 1
    ok_tail_1 = eq tail_1, 4
    ok_step1_empty = eq step1_empty, 1
    ok_step1_len = eq step1_len, 7
    ok_step1_6 = eq step1_6, 6
    ok_invalid_flag = eq invalid_ok, 0
    ok_invalid_len = eq invalid_len, 0
    ok_invalid_next_flag = eq invalid_next_ok, 1
    ok_invalid_next_value = eq invalid_next_value, 0

    c01 = and ok_step2_empty, ok_step2_len
    c02 = and c01, ok_step2_0
    c03 = and c02, ok_step2_1
    c04 = and c03, ok_step2_2
    c05 = and c04, ok_step2_3
    c06 = and c05, ok_tail_skip_flag
    c07 = and c06, ok_tail_skip_value
    c08 = and c07, ok_tail_empty
    c09 = and c08, ok_tail_len
    c10 = and c09, ok_tail_0
    c11 = and c10, ok_tail_1
    c12 = and c11, ok_step1_empty
    c13 = and c12, ok_step1_len
    c14 = and c13, ok_step1_6
    c15 = and c14, ok_invalid_flag
    c16 = and c15, ok_invalid_len
    c17 = and c16, ok_invalid_next_flag
    ok = and c17, ok_invalid_next_value

    !step2_empty
    !step2_len
    !step2_0
    !step2_1
    !step2_2
    !step2_3
    !tail_skip_ok
    !tail_skip_value
    !tail_empty
    !tail_len
    !tail_0
    !tail_1
    !step1_empty
    !step1_len
    !step1_6
    !invalid_ok
    !invalid_len
    !invalid_next_ok
    !invalid_next_value
    !ok_step2_empty
    !ok_step2_len
    !ok_step2_0
    !ok_step2_1
    !ok_step2_2
    !ok_step2_3
    !ok_tail_skip_flag
    !ok_tail_skip_value
    !ok_tail_empty
    !ok_tail_len
    !ok_tail_0
    !ok_tail_1
    !ok_step1_empty
    !ok_step1_len
    !ok_step1_6
    !ok_invalid_flag
    !ok_invalid_len
    !ok_invalid_next_flag
    !ok_invalid_next_value
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !invalid_iter
    !step1_iter
    !tail_iter
    !step2_iter
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE invalid_vec
    EXPAND VEC_FREE step1_vec
    EXPAND VEC_FREE tail_vec
    EXPAND VEC_FREE step2_vec
    panic(10538)

L_PASS:
    !ok
    EXPAND VEC_FREE invalid_vec
    EXPAND VEC_FREE step1_vec
    EXPAND VEC_FREE tail_vec
    EXPAND VEC_FREE step2_vec
    return 0
