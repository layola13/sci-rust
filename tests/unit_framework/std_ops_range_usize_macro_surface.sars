@import "sa_std/ops.sars"

@test "sa_std ops range usize macro aliases"():
L_ENTRY:
    data = stack_alloc 48
    store data+0, 11 as u64
    store data+8, 22 as u64
    store data+16, 33 as u64
    store data+24, 44 as u64
    store data+32, 55 as u64
    store data+40, 66 as u64

    base_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW base_slice, data, 6

    range = stack_alloc RangeUsize_SIZE
    EXPAND RANGE_USIZE_NEW range, 1, 5
    EXPAND RANGE_USIZE_START range_start, range
    EXPAND RANGE_USIZE_END range_end, range
    EXPAND RANGE_USIZE_CONTAINS range_has1, range, 1
    EXPAND RANGE_USIZE_CONTAINS range_has5, range, 5
    EXPAND RANGE_USIZE_LEN range_len, range
    range_slice = stack_alloc Slice_SIZE
    EXPAND RANGE_USIZE_TRY_GET_SLICE range_slice_ok, range_slice, base_slice, range
    range_slice_ptr = load range_slice+Slice_ptr as ptr
    range_slice_len = load range_slice+Slice_len as u64
    range_slice_first = load range_slice_ptr+0 as u64
    expected_range_ptr = ptr_add data, 8

    range_iter = stack_alloc RangeUsize_SIZE
    EXPAND RANGE_USIZE_NEW range_iter, 3, 6
    EXPAND RANGE_USIZE_NEXT next_ok, next_value, range_iter
    EXPAND RANGE_USIZE_NEXT_BACK back_ok, back_value, range_iter
    EXPAND RANGE_USIZE_NTH nth_ok, nth_value, range_iter, 0
    EXPAND RANGE_USIZE_COUNT count_after_nth, range_iter

    range_from = stack_alloc RangeFromUsize_SIZE
    EXPAND RANGE_FROM_USIZE_NEW range_from, 2
    EXPAND RANGE_FROM_USIZE_START range_from_start, range_from
    EXPAND RANGE_FROM_USIZE_CONTAINS range_from_has1, range_from, 1
    EXPAND RANGE_FROM_USIZE_CONTAINS range_from_has2, range_from, 2
    range_from_slice = stack_alloc Slice_SIZE
    EXPAND RANGE_FROM_USIZE_TRY_GET_SLICE range_from_ok, range_from_slice, base_slice, range_from
    range_from_len = load range_from_slice+Slice_len as u64

    range_to = stack_alloc RangeToUsize_SIZE
    EXPAND RANGE_TO_USIZE_NEW range_to, 4
    EXPAND RANGE_TO_USIZE_END range_to_end, range_to
    EXPAND RANGE_TO_USIZE_CONTAINS range_to_has3, range_to, 3
    EXPAND RANGE_TO_USIZE_CONTAINS range_to_has4, range_to, 4
    range_to_slice = stack_alloc Slice_SIZE
    EXPAND RANGE_TO_USIZE_TRY_GET_SLICE range_to_ok, range_to_slice, base_slice, range_to
    range_to_len = load range_to_slice+Slice_len as u64

    range_inc = stack_alloc RangeInclusiveUsize_SIZE
    EXPAND RANGE_INCLUSIVE_USIZE_NEW range_inc, 2, 4
    EXPAND RANGE_INCLUSIVE_USIZE_START range_inc_start, range_inc
    EXPAND RANGE_INCLUSIVE_USIZE_END range_inc_end, range_inc
    EXPAND RANGE_INCLUSIVE_USIZE_CONTAINS range_inc_has2, range_inc, 2
    EXPAND RANGE_INCLUSIVE_USIZE_CONTAINS range_inc_has4, range_inc, 4
    EXPAND RANGE_INCLUSIVE_USIZE_CONTAINS range_inc_has5, range_inc, 5
    EXPAND RANGE_INCLUSIVE_USIZE_LEN range_inc_len, range_inc
    range_inc_slice = stack_alloc Slice_SIZE
    EXPAND RANGE_INCLUSIVE_USIZE_TRY_GET_SLICE range_inc_ok, range_inc_slice, base_slice, range_inc
    range_inc_slice_len = load range_inc_slice+Slice_len as u64
    EXPAND RANGE_INCLUSIVE_USIZE_SET_EXHAUSTED range_inc, 1
    EXPAND RANGE_INCLUSIVE_USIZE_IS_EMPTY range_inc_empty_after, range_inc

    range_inc_iter = stack_alloc RangeInclusiveUsize_SIZE
    EXPAND RANGE_INCLUSIVE_USIZE_NEW range_inc_iter, 7, 9
    EXPAND RANGE_INCLUSIVE_USIZE_NEXT inc_next_ok, inc_next_value, range_inc_iter
    EXPAND RANGE_INCLUSIVE_USIZE_NEXT_BACK inc_back_ok, inc_back_value, range_inc_iter
    EXPAND RANGE_INCLUSIVE_USIZE_COUNT inc_count_left, range_inc_iter

    range_to_inc = stack_alloc RangeToInclusiveUsize_SIZE
    EXPAND RANGE_TO_INCLUSIVE_USIZE_NEW range_to_inc, 3
    EXPAND RANGE_TO_INCLUSIVE_USIZE_END range_to_inc_end, range_to_inc
    EXPAND RANGE_TO_INCLUSIVE_USIZE_CONTAINS range_to_inc_has3, range_to_inc, 3
    EXPAND RANGE_TO_INCLUSIVE_USIZE_CONTAINS range_to_inc_has4, range_to_inc, 4
    range_to_inc_slice = stack_alloc Slice_SIZE
    EXPAND RANGE_TO_INCLUSIVE_USIZE_TRY_GET_SLICE range_to_inc_ok, range_to_inc_slice, base_slice, range_to_inc
    range_to_inc_len = load range_to_inc_slice+Slice_len as u64

    EXPAND RANGE_FULL_CONTAINS_USIZE full_has, 999

    ok_range_start = eq range_start, 1
    ok_range_end = eq range_end, 5
    ok_range_has1 = eq range_has1, 1
    ok_range_has5 = eq range_has5, 0
    ok_range_len = eq range_len, 4
    ok_range_slice_ok = eq range_slice_ok, 1
    ok_range_slice_ptr = eq range_slice_ptr, expected_range_ptr
    ok_range_slice_len = eq range_slice_len, 4
    ok_range_slice_first = eq range_slice_first, 22
    ok_next = eq next_ok, 1
    ok_next_value = eq next_value, 3
    ok_back = eq back_ok, 1
    ok_back_value = eq back_value, 5
    ok_nth = eq nth_ok, 1
    ok_nth_value = eq nth_value, 4
    ok_count_after = eq count_after_nth, 0
    ok_from_start = eq range_from_start, 2
    ok_from_has1 = eq range_from_has1, 0
    ok_from_has2 = eq range_from_has2, 1
    ok_from_ok = eq range_from_ok, 1
    ok_from_len = eq range_from_len, 4
    ok_to_end = eq range_to_end, 4
    ok_to_has3 = eq range_to_has3, 1
    ok_to_has4 = eq range_to_has4, 0
    ok_to_ok = eq range_to_ok, 1
    ok_to_len = eq range_to_len, 4
    ok_inc_start = eq range_inc_start, 2
    ok_inc_end = eq range_inc_end, 4
    ok_inc_has2 = eq range_inc_has2, 1
    ok_inc_has4 = eq range_inc_has4, 1
    ok_inc_has5 = eq range_inc_has5, 0
    ok_inc_len = eq range_inc_len, 3
    ok_inc_ok = eq range_inc_ok, 1
    ok_inc_slice_len = eq range_inc_slice_len, 3
    ok_inc_empty_after = eq range_inc_empty_after, 1
    ok_inc_next = eq inc_next_ok, 1
    ok_inc_next_value = eq inc_next_value, 7
    ok_inc_back = eq inc_back_ok, 1
    ok_inc_back_value = eq inc_back_value, 9
    ok_inc_count_left = eq inc_count_left, 1
    ok_to_inc_end = eq range_to_inc_end, 3
    ok_to_inc_has3 = eq range_to_inc_has3, 1
    ok_to_inc_has4 = eq range_to_inc_has4, 0
    ok_to_inc_ok = eq range_to_inc_ok, 1
    ok_to_inc_len = eq range_to_inc_len, 4
    ok_full = eq full_has, 1

    c01 = and ok_range_start, ok_range_end
    c02 = and c01, ok_range_has1
    c03 = and c02, ok_range_has5
    c04 = and c03, ok_range_len
    c05 = and c04, ok_range_slice_ok
    c06 = and c05, ok_range_slice_ptr
    c07 = and c06, ok_range_slice_len
    c08 = and c07, ok_range_slice_first
    c09 = and c08, ok_next
    c10 = and c09, ok_next_value
    c11 = and c10, ok_back
    c12 = and c11, ok_back_value
    c13 = and c12, ok_nth
    c14 = and c13, ok_nth_value
    c15 = and c14, ok_count_after
    c16 = and c15, ok_from_start
    c17 = and c16, ok_from_has1
    c18 = and c17, ok_from_has2
    c19 = and c18, ok_from_ok
    c20 = and c19, ok_from_len
    c21 = and c20, ok_to_end
    c22 = and c21, ok_to_has3
    c23 = and c22, ok_to_has4
    c24 = and c23, ok_to_ok
    c25 = and c24, ok_to_len
    c26 = and c25, ok_inc_start
    c27 = and c26, ok_inc_end
    c28 = and c27, ok_inc_has2
    c29 = and c28, ok_inc_has4
    c30 = and c29, ok_inc_has5
    c31 = and c30, ok_inc_len
    c32 = and c31, ok_inc_ok
    c33 = and c32, ok_inc_slice_len
    c34 = and c33, ok_inc_empty_after
    c35 = and c34, ok_inc_next
    c36 = and c35, ok_inc_next_value
    c37 = and c36, ok_inc_back
    c38 = and c37, ok_inc_back_value
    c39 = and c38, ok_inc_count_left
    c40 = and c39, ok_to_inc_end
    c41 = and c40, ok_to_inc_has3
    c42 = and c41, ok_to_inc_has4
    c43 = and c42, ok_to_inc_ok
    c44 = and c43, ok_to_inc_len
    ok = and c44, ok_full

    !expected_range_ptr
    !range_slice_ptr

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10509)

L_PASS:
    return 0
