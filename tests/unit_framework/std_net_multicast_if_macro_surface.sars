@import "sa_std/net.sars"

@const NET_TEST_LOOPBACK = utf8:"127.0.0.1"
@const NET_TEST_LOOPBACK_V6 = utf8:"::1"
#def NET_TEST_LOOPBACK_LEN = 9
#def NET_TEST_LOOPBACK_V6_LEN = 3

@test "sa_std udp multicast interface options"():
L_ENTRY:
    interface_v4 = stack_alloc 4
    out_interface_v4 = stack_alloc 4
    EXPAND NET_IPV4_NEW interface_v4, 127, 0, 0, 1
    EXPAND NET_UDP_BIND bind4_status, socket4, NET_TEST_LOOPBACK, NET_TEST_LOOPBACK_LEN, 0
    EXPAND NET_UDP_SET_MULTICAST_IF_V4 set4_status, socket4, interface_v4
    EXPAND NET_UDP_MULTICAST_IF_V4 get4_status, out_interface_v4, socket4
    EXPAND NET_IPV4_EQ interface4_ok, interface_v4, out_interface_v4
    EXPAND NET_UDP_CLOSE close4_status, socket4
    bind4_ok = eq bind4_status, SA_NET_OK
    set4_ok = eq set4_status, SA_NET_OK
    get4_ok = eq get4_status, SA_NET_OK
    close4_ok = eq close4_status, SA_NET_OK
    v4_ok0 = and bind4_ok, set4_ok
    v4_ok1 = and get4_ok, interface4_ok
    v4_ok2 = and v4_ok0, v4_ok1
    v4_ok = and v4_ok2, close4_ok
    br v4_ok -> L_V6, L_FAIL

L_V6:
    EXPAND NET_UDP_BIND bind6_status, socket6, NET_TEST_LOOPBACK_V6, NET_TEST_LOOPBACK_V6_LEN, 0
    EXPAND NET_UDP_SET_MULTICAST_IF_V6 set6_status, socket6, 0
    EXPAND NET_UDP_MULTICAST_IF_V6 get6_status, interface6, socket6
    EXPAND NET_UDP_CLOSE close6_status, socket6
    bind6_ok = eq bind6_status, SA_NET_OK
    set6_ok = eq set6_status, SA_NET_OK
    get6_ok = eq get6_status, SA_NET_OK
    close6_ok = eq close6_status, SA_NET_OK
    interface6_ok = eq interface6, 0
    v6_ok0 = and bind6_ok, set6_ok
    v6_ok1 = and get6_ok, interface6_ok
    v6_ok2 = and v6_ok0, v6_ok1
    v6_ok = and v6_ok2, close6_ok
    br v6_ok -> L_DONE, L_FAIL

L_FAIL:
    panic(10124)

L_DONE:
    !interface6_ok
    !v6_ok
    !v6_ok2
    !v6_ok1
    !v6_ok0
    !close6_ok
    !get6_ok
    !set6_ok
    !bind6_ok
    !close6_status
    !get6_status
    !set6_status
    !bind6_status
    !interface6
    !socket6
    !v4_ok
    !v4_ok2
    !v4_ok1
    !v4_ok0
    !close4_ok
    !get4_ok
    !set4_ok
    !bind4_ok
    !close4_status
    !interface4_ok
    !get4_status
    !set4_status
    !bind4_status
    !socket4
    return 0
