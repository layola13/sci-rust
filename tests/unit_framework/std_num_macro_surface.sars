@test "sa_std num i64 primitive macros"():
L_ENTRY:
    neg_seven = sub 0, 7
    neg_three = sub 0, 3
    neg_one = sub 0, 1

    EXPAND NUM_I64_IS_POSITIVE pos_true, 7
    EXPAND NUM_I64_IS_POSITIVE pos_false_zero, 0
    EXPAND NUM_I64_IS_POSITIVE pos_false_neg, neg_seven
    EXPAND NUM_I64_IS_NEGATIVE neg_true, neg_seven
    EXPAND NUM_I64_IS_NEGATIVE neg_false_zero, 0
    EXPAND NUM_I64_IS_NEGATIVE neg_false_pos, 7
    EXPAND NUM_I64_SIGNUM sign_pos, 7
    EXPAND NUM_I64_SIGNUM sign_zero, 0
    EXPAND NUM_I64_SIGNUM sign_neg, neg_seven
    EXPAND NUM_I64_ABS abs_pos, 7
    EXPAND NUM_I64_ABS abs_zero, 0
    EXPAND NUM_I64_ABS abs_neg, neg_seven
    EXPAND NUM_I64_ABS_DIFF abs_diff_lr, 9, neg_three
    EXPAND NUM_I64_ABS_DIFF abs_diff_rl, neg_three, 9
    EXPAND NUM_I64_CHECKED_ADD checked_add_ok, checked_add_value, 7, 3
    EXPAND NUM_I64_CHECKED_ADD checked_add_over_ok, checked_add_over_value, NUM_I64_MAX, 1
    EXPAND NUM_I64_CHECKED_ADD checked_add_under_ok, checked_add_under_value, NUM_I64_MIN, neg_one
    EXPAND NUM_I64_CHECKED_SUB checked_sub_ok, checked_sub_value, 7, 3
    EXPAND NUM_I64_CHECKED_SUB checked_sub_under_ok, checked_sub_under_value, NUM_I64_MIN, 1
    EXPAND NUM_I64_CHECKED_SUB checked_sub_over_ok, checked_sub_over_value, NUM_I64_MAX, neg_one
    EXPAND NUM_I64_CHECKED_DIV checked_div_ok, checked_div_value, 21, 3
    EXPAND NUM_I64_CHECKED_DIV checked_div_zero_ok, checked_div_zero_value, 21, 0
    EXPAND NUM_I64_CHECKED_DIV checked_div_over_ok, checked_div_over_value, NUM_I64_MIN, neg_one
    EXPAND NUM_I64_CHECKED_REM checked_rem_ok, checked_rem_value, 22, 5
    EXPAND NUM_I64_CHECKED_REM checked_rem_zero_ok, checked_rem_zero_value, 22, 0
    EXPAND NUM_I64_CHECKED_REM checked_rem_over_ok, checked_rem_over_value, NUM_I64_MIN, neg_one
    EXPAND NUM_I64_CHECKED_NEG checked_neg_ok, checked_neg_value, neg_seven
    EXPAND NUM_I64_CHECKED_NEG checked_neg_min_ok, checked_neg_min_value, NUM_I64_MIN
    EXPAND NUM_I64_CHECKED_ABS checked_abs_ok, checked_abs_value, neg_seven
    EXPAND NUM_I64_CHECKED_ABS checked_abs_min_ok, checked_abs_min_value, NUM_I64_MIN
    EXPAND NUM_I64_SATURATING_ADD sat_add_mid, 7, 3
    EXPAND NUM_I64_SATURATING_ADD sat_add_max, NUM_I64_MAX, 1
    EXPAND NUM_I64_SATURATING_ADD sat_add_min, NUM_I64_MIN, neg_one
    EXPAND NUM_I64_SATURATING_SUB sat_sub_mid, 7, 3
    EXPAND NUM_I64_SATURATING_SUB sat_sub_min, NUM_I64_MIN, 1
    EXPAND NUM_I64_SATURATING_SUB sat_sub_max, NUM_I64_MAX, neg_one
    EXPAND NUM_I64_SATURATING_NEG sat_neg_mid, neg_seven
    EXPAND NUM_I64_SATURATING_NEG sat_neg_min, NUM_I64_MIN
    EXPAND NUM_I64_SATURATING_ABS sat_abs_mid, neg_seven
    EXPAND NUM_I64_SATURATING_ABS sat_abs_min, NUM_I64_MIN
    EXPAND NUM_I64_WRAPPING_NEG wrap_neg_min, NUM_I64_MIN
    EXPAND NUM_I64_WRAPPING_ABS wrap_abs_min, NUM_I64_MIN

    ok_pos_true = eq pos_true, 1
    ok_pos_zero = eq pos_false_zero, 0
    ok_pos_neg = eq pos_false_neg, 0
    ok_neg_true = eq neg_true, 1
    ok_neg_zero = eq neg_false_zero, 0
    ok_neg_pos = eq neg_false_pos, 0
    ok_sign_pos = eq sign_pos, 1
    ok_sign_zero = eq sign_zero, 0
    ok_sign_neg = eq sign_neg, neg_one
    ok_abs_pos = eq abs_pos, 7
    ok_abs_zero = eq abs_zero, 0
    ok_abs_neg = eq abs_neg, 7
    ok_abs_diff_lr = eq abs_diff_lr, 12
    ok_abs_diff_rl = eq abs_diff_rl, 12
    ok_checked_add_flag = eq checked_add_ok, 1
    ok_checked_add_value = eq checked_add_value, 10
    ok_checked_add_over_flag = eq checked_add_over_ok, 0
    ok_checked_add_over_value = eq checked_add_over_value, 0
    ok_checked_add_under_flag = eq checked_add_under_ok, 0
    ok_checked_add_under_value = eq checked_add_under_value, 0
    ok_checked_sub_flag = eq checked_sub_ok, 1
    ok_checked_sub_value = eq checked_sub_value, 4
    ok_checked_sub_under_flag = eq checked_sub_under_ok, 0
    ok_checked_sub_under_value = eq checked_sub_under_value, 0
    ok_checked_sub_over_flag = eq checked_sub_over_ok, 0
    ok_checked_sub_over_value = eq checked_sub_over_value, 0
    ok_checked_div_flag = eq checked_div_ok, 1
    ok_checked_div_value = eq checked_div_value, 7
    ok_checked_div_zero_flag = eq checked_div_zero_ok, 0
    ok_checked_div_zero_value = eq checked_div_zero_value, 0
    ok_checked_div_over_flag = eq checked_div_over_ok, 0
    ok_checked_div_over_value = eq checked_div_over_value, 0
    ok_checked_rem_flag = eq checked_rem_ok, 1
    ok_checked_rem_value = eq checked_rem_value, 2
    ok_checked_rem_zero_flag = eq checked_rem_zero_ok, 0
    ok_checked_rem_zero_value = eq checked_rem_zero_value, 0
    ok_checked_rem_over_flag = eq checked_rem_over_ok, 0
    ok_checked_rem_over_value = eq checked_rem_over_value, 0
    ok_checked_neg_flag = eq checked_neg_ok, 1
