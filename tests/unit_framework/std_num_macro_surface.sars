    nz_isize = stack_alloc NonZeroIsize_SIZE
    nz_isize_from = stack_alloc NonZeroIsize_SIZE

    EXPAND NUM_U64_WRITE_BE_BYTES zero_write_ok, zero_buf, 8, 0

    EXPAND NONZERO_U64_NEW u64_new_ok, nz_u64, 8
