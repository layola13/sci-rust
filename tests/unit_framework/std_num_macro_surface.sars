@test "sa_std num platform sized macros"():
L_ENTRY:
    neg_three = sub 0, 3
    neg_four = sub 0, 4
    neg_twenty_one = sub 0, 21
    bytes = stack_alloc 8

    EXPAND NUM_USIZE_CHECKED_ADD usize_add_ok, usize_add_value, 7, 5
    EXPAND NUM_USIZE_CHECKED_SHL usize_shl_ok, usize_shl_value, 1, 4
    EXPAND NUM_USIZE_SATURATING_ADD usize_sat_add, NUM_USIZE_MAX, 1
    EXPAND NUM_USIZE_WRAPPING_ADD usize_wrap_add, NUM_USIZE_MAX, 1
    EXPAND NUM_USIZE_IS_POWER_OF_TWO usize_pow2, 16
    EXPAND NUM_USIZE_ABS_DIFF usize_abs_diff, 4, 9
    EXPAND NUM_USIZE_MIDPOINT usize_midpoint, 4, 10
    EXPAND NUM_USIZE_POW usize_pow, 3, 4

    EXPAND NUM_ISIZE_CHECKED_MUL isize_mul_ok, isize_mul_value, 7, neg_three
    EXPAND NUM_ISIZE_CHECKED_SHR isize_shr_ok, isize_shr_value, -16, 2
    EXPAND NUM_ISIZE_SATURATING_MUL isize_sat_mul, NUM_ISIZE_MIN, -1
    EXPAND NUM_ISIZE_WRAPPING_ADD isize_wrap_add, NUM_ISIZE_MAX, 1
    EXPAND NUM_ISIZE_IS_NEGATIVE isize_neg, neg_three
    EXPAND NUM_ISIZE_SIGNUM isize_sign, neg_three
    EXPAND NUM_ISIZE_ABS isize_abs, neg_three
    EXPAND NUM_ISIZE_CHECKED_NEG isize_checked_neg_ok, isize_checked_neg_value, neg_three
    EXPAND NUM_ISIZE_CHECKED_NEG isize_checked_neg_min_ok, isize_checked_neg_min_value, NUM_ISIZE_MIN
    EXPAND NUM_ISIZE_CHECKED_ABS isize_checked_abs_ok, isize_checked_abs_value, neg_three
    EXPAND NUM_ISIZE_CHECKED_ABS isize_checked_abs_min_ok, isize_checked_abs_min_value, NUM_ISIZE_MIN
    EXPAND NUM_ISIZE_SATURATING_NEG isize_sat_neg, NUM_ISIZE_MIN
    EXPAND NUM_ISIZE_SATURATING_ABS isize_sat_abs, NUM_ISIZE_MIN
    EXPAND NUM_ISIZE_WRAPPING_DIV isize_wrap_div, NUM_ISIZE_MIN, -1
    EXPAND NUM_ISIZE_WRAPPING_REM isize_wrap_rem, NUM_ISIZE_MIN, -1
    EXPAND NUM_ISIZE_WRAPPING_NEG isize_wrap_neg, NUM_ISIZE_MIN
    EXPAND NUM_ISIZE_WRAPPING_ABS isize_wrap_abs, NUM_ISIZE_MIN
    EXPAND NUM_ISIZE_ABS_DIFF isize_abs_diff, 9, neg_three
    EXPAND NUM_ISIZE_MIDPOINT isize_midpoint, -10, 4
    EXPAND NUM_ISIZE_POW isize_pow, neg_three, 3
    EXPAND NUM_USIZE_WRITE_BE_BYTES usize_be_ok, bytes, 8, 81985529216486895
    EXPAND NUM_USIZE_FROM_BE_BYTES usize_from_be, bytes
    usize_b0 = load bytes+0 as u8
    usize_b7_ptr = ptr_add bytes, 7
    usize_b7 = load usize_b7_ptr+0 as u8
    EXPAND NUM_ISIZE_WRITE_LE_BYTES isize_le_ok, bytes, 8, -2
    EXPAND NUM_ISIZE_FROM_LE_BYTES isize_from_le, bytes
    isize_b0 = load bytes+0 as u8
    isize_b7_ptr = ptr_add bytes, 7
    isize_b7 = load isize_b7_ptr+0 as u8

    ok_usize_bits = eq NUM_USIZE_BITS, 64
    ok_isize_bits = eq NUM_ISIZE_BITS, 64
    ok_usize_add = eq usize_add_ok, 1
    ok_usize_add_value = eq usize_add_value, 12
    ok_usize_shl = eq usize_shl_ok, 1
    ok_usize_shl_value = eq usize_shl_value, 16
    ok_usize_sat_add = eq usize_sat_add, NUM_USIZE_MAX
    ok_usize_wrap_add = eq usize_wrap_add, 0
    ok_usize_pow2 = eq usize_pow2, 1
    ok_usize_abs_diff = eq usize_abs_diff, 5
    ok_usize_midpoint = eq usize_midpoint, 7
    ok_usize_pow = eq usize_pow, 81
    ok_isize_mul = eq isize_mul_ok, 1
    ok_isize_mul_value = eq isize_mul_value, neg_twenty_one
    ok_isize_shr = eq isize_shr_ok, 1
    ok_isize_shr_value = eq isize_shr_value, neg_four
    ok_isize_sat_mul = eq isize_sat_mul, NUM_ISIZE_MAX
    ok_isize_wrap_add = eq isize_wrap_add, NUM_ISIZE_MIN
    ok_isize_neg = eq isize_neg, 1
    ok_isize_sign = eq isize_sign, -1
    ok_isize_abs = eq isize_abs, 3
    ok_isize_checked_neg = eq isize_checked_neg_ok, 1
    ok_isize_checked_neg_value = eq isize_checked_neg_value, 3
    ok_isize_checked_neg_min = eq isize_checked_neg_min_ok, 0
    ok_isize_checked_neg_min_value = eq isize_checked_neg_min_value, 0
    ok_isize_checked_abs = eq isize_checked_abs_ok, 1
    ok_isize_checked_abs_value = eq isize_checked_abs_value, 3
    ok_isize_checked_abs_min = eq isize_checked_abs_min_ok, 0
    ok_isize_checked_abs_min_value = eq isize_checked_abs_min_value, 0
    ok_isize_sat_neg = eq isize_sat_neg, NUM_ISIZE_MAX
    ok_isize_sat_abs = eq isize_sat_abs, NUM_ISIZE_MAX
    ok_isize_wrap_div = eq isize_wrap_div, NUM_ISIZE_MIN
    ok_isize_wrap_rem = eq isize_wrap_rem, 0
    ok_isize_wrap_neg = eq isize_wrap_neg, NUM_ISIZE_MIN
    ok_isize_wrap_abs = eq isize_wrap_abs, NUM_ISIZE_MIN
    ok_isize_abs_diff = eq isize_abs_diff, 12
    ok_isize_midpoint = eq isize_midpoint, -3
