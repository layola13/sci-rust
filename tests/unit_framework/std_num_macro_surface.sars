    ok_checked_neg_min_value = eq checked_neg_min_value, 0
    ok_checked_abs_flag = eq checked_abs_ok, 1
    ok_checked_abs_value = eq checked_abs_value, 7
    ok_checked_abs_min_flag = eq checked_abs_min_ok, 0
    ok_checked_abs_min_value = eq checked_abs_min_value, 0
    ok_sat_add_mid = eq sat_add_mid, 10
    ok_sat_add_max = eq sat_add_max, NUM_I64_MAX
    ok_sat_add_min = eq sat_add_min, NUM_I64_MIN
    ok_sat_sub_mid = eq sat_sub_mid, 4
    ok_sat_sub_min = eq sat_sub_min, NUM_I64_MIN
    ok_sat_sub_max = eq sat_sub_max, NUM_I64_MAX
    ok_sat_neg_mid = eq sat_neg_mid, 7
