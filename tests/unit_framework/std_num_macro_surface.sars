    ok52 = eq ilog10_direct, 3
    ok53 = eq usize_ov_add_value, 0
    ok54 = eq usize_ov_add_over, 1
    ok55 = eq usize_carrying_value, 0
    ok56 = eq usize_carrying_carry, 1
    ok57 = eq usize_borrowing_value, NUM_USIZE_MAX
    ok58 = eq usize_borrowing_borrow, 1
    ok59 = eq usize_next_ok, 1
    ok60 = eq usize_next_value, 49
    ok61 = eq usize_multiple, 1
    ok62 = eq usize_div_ceil, 7
    ok63 = eq usize_ilog2_ok, 1
    ok64 = eq usize_ilog2_value, 10
    ok65 = eq usize_ilog10_direct, 3

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
