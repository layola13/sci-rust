@test "sa_std num unsigned rust named parity macros"():
L_ENTRY:
    max_minus_one = sub NUM_U64_MAX, 1

    EXPAND NUM_U64_UNCHECKED_ADD unchecked_add, 7, 5
    EXPAND NUM_U64_UNCHECKED_SUB unchecked_sub, 7, 5
    EXPAND NUM_U64_UNCHECKED_MUL unchecked_mul, 7, 6
    EXPAND NUM_U64_UNCHECKED_DIV unchecked_div, 42, 7
    EXPAND NUM_U64_UNCHECKED_REM unchecked_rem, 43, 7
    EXPAND NUM_U64_UNCHECKED_SHL unchecked_shl, 1, 4
    EXPAND NUM_U64_UNCHECKED_SHR unchecked_shr, 16, 4

    EXPAND NUM_U64_OVERFLOWING_ADD ov_add_value, ov_add_over, NUM_U64_MAX, 1
    EXPAND NUM_U64_OVERFLOWING_SUB ov_sub_value, ov_sub_over, 0, 1
    EXPAND NUM_U64_OVERFLOWING_MUL ov_mul_value, ov_mul_over, NUM_U64_MAX, 2
    EXPAND NUM_U64_OVERFLOWING_SHL ov_shl_value, ov_shl_over, 1, 68
    EXPAND NUM_U64_OVERFLOWING_SHR ov_shr_value, ov_shr_over, 16, 68
    EXPAND NUM_U64_CARRYING_ADD carrying_value, carrying_carry, NUM_U64_MAX, 0, 1
    EXPAND NUM_U64_BORROWING_SUB borrowing_value, borrowing_borrow, 0, 0, 1
    EXPAND NUM_U64_DIV_EUCLID div_euclid, 43, 7
    EXPAND NUM_U64_REM_EUCLID rem_euclid, 43, 7
    EXPAND NUM_U64_IS_MULTIPLE_OF multiple_yes, 42, 7
    EXPAND NUM_U64_IS_MULTIPLE_OF multiple_no, 43, 7
    EXPAND NUM_U64_IS_MULTIPLE_OF multiple_zero_zero, 0, 0
    EXPAND NUM_U64_IS_MULTIPLE_OF multiple_nonzero_zero, 1, 0
    EXPAND NUM_U64_CHECKED_NEXT_MULTIPLE_OF next_mul_ok, next_mul_value, 43, 7
    EXPAND NUM_U64_CHECKED_NEXT_MULTIPLE_OF next_mul_aligned_ok, next_mul_aligned_value, 42, 7
    EXPAND NUM_U64_CHECKED_NEXT_MULTIPLE_OF next_mul_zero_ok, next_mul_zero_value, 42, 0
    EXPAND NUM_U64_CHECKED_NEXT_MULTIPLE_OF next_mul_over_ok, next_mul_over_value, NUM_U64_MAX, 2
    EXPAND NUM_U64_NEXT_MULTIPLE_OF next_mul_direct, 43, 7
    EXPAND NUM_U64_DIV_CEIL div_ceil, 43, 7
    EXPAND NUM_U64_CHECKED_ILOG ilog_ok, ilog_value, 125, 5
    EXPAND NUM_U64_CHECKED_ILOG ilog_zero_ok, ilog_zero_value, 0, 5
    EXPAND NUM_U64_CHECKED_ILOG ilog_base_one_ok, ilog_base_one_value, 125, 1
    EXPAND NUM_U64_ILOG ilog_direct, 125, 5
    EXPAND NUM_U64_CHECKED_ILOG2 ilog2_ok, ilog2_value, 1024
    EXPAND NUM_U64_CHECKED_ILOG2 ilog2_zero_ok, ilog2_zero_value, 0
    EXPAND NUM_U64_ILOG2 ilog2_direct, 1024
    EXPAND NUM_U64_CHECKED_ILOG10 ilog10_ok, ilog10_value, 1000
    EXPAND NUM_U64_ILOG10 ilog10_direct, 1000

    EXPAND NUM_USIZE_OVERFLOWING_ADD usize_ov_add_value, usize_ov_add_over, NUM_USIZE_MAX, 1
    EXPAND NUM_USIZE_CARRYING_ADD usize_carrying_value, usize_carrying_carry, NUM_USIZE_MAX, 0, 1
    EXPAND NUM_USIZE_BORROWING_SUB usize_borrowing_value, usize_borrowing_borrow, 0, 0, 1
    EXPAND NUM_USIZE_CHECKED_NEXT_MULTIPLE_OF usize_next_ok, usize_next_value, 43, 7
    EXPAND NUM_USIZE_IS_MULTIPLE_OF usize_multiple, 42, 7
    EXPAND NUM_USIZE_DIV_CEIL usize_div_ceil, 43, 7
    EXPAND NUM_USIZE_CHECKED_ILOG2 usize_ilog2_ok, usize_ilog2_value, 1024
    EXPAND NUM_USIZE_ILOG10 usize_ilog10_direct, 1000

    ok01 = eq unchecked_add, 12
    ok02 = eq unchecked_sub, 2
    ok03 = eq unchecked_mul, 42
    ok04 = eq unchecked_div, 6
    ok05 = eq unchecked_rem, 1
