@import "sa_std/num.sars"

@test "sa_std num bit position helper macros"():
L_ENTRY:
    high_bit = shl 1, 63
    mixed = add high_bit, 40

    EXPAND NUM_U64_BIT_WIDTH u64_bw_zero, 0
    EXPAND NUM_U64_BIT_WIDTH u64_bw_one, 1
    EXPAND NUM_U64_BIT_WIDTH u64_bw_mixed, mixed
    EXPAND NUM_U64_ISOLATE_HIGHEST_ONE u64_iso_high_zero, 0
    EXPAND NUM_U64_ISOLATE_HIGHEST_ONE u64_iso_high_mixed, mixed
    EXPAND NUM_U64_ISOLATE_LOWEST_ONE u64_iso_low_zero, 0
    EXPAND NUM_U64_ISOLATE_LOWEST_ONE u64_iso_low_mixed, mixed
    EXPAND NUM_U64_HIGHEST_ONE u64_high_zero_ok, u64_high_zero_idx, 0
    EXPAND NUM_U64_HIGHEST_ONE u64_high_mixed_ok, u64_high_mixed_idx, mixed
    EXPAND NUM_U64_LOWEST_ONE u64_low_zero_ok, u64_low_zero_idx, 0
    EXPAND NUM_U64_LOWEST_ONE u64_low_mixed_ok, u64_low_mixed_idx, mixed

    EXPAND NUM_I64_COUNT_ONES i64_count_ones_neg1, -1
    EXPAND NUM_I64_COUNT_ZEROS i64_count_zeros_neg1, -1
    EXPAND NUM_I64_LEADING_ZEROS i64_lz_neg1, -1
    EXPAND NUM_I64_TRAILING_ZEROS i64_tz_neg8, -8
    EXPAND NUM_I64_LEADING_ONES i64_lo_neg1, -1
    EXPAND NUM_I64_TRAILING_ONES i64_to_neg1, -1
    EXPAND NUM_I64_ISOLATE_HIGHEST_ONE i64_iso_high_neg8, -8
    EXPAND NUM_I64_ISOLATE_LOWEST_ONE i64_iso_low_neg8, -8
    EXPAND NUM_I64_HIGHEST_ONE i64_high_neg8_ok, i64_high_neg8_idx, -8
    EXPAND NUM_I64_LOWEST_ONE i64_low_neg8_ok, i64_low_neg8_idx, -8
    EXPAND NUM_I64_HIGHEST_ONE i64_high_zero_ok, i64_high_zero_idx, 0
    EXPAND NUM_I64_LOWEST_ONE i64_low_zero_ok, i64_low_zero_idx, 0

    ok01 = eq u64_bw_zero, 0
    ok02 = eq u64_bw_one, 1
    ok03 = eq u64_bw_mixed, 64
    ok04 = eq u64_iso_high_zero, 0
    ok05 = eq u64_iso_high_mixed, high_bit
    ok06 = eq u64_iso_low_zero, 0
    ok07 = eq u64_iso_low_mixed, 8
    ok08 = eq u64_high_zero_ok, 0
    ok09 = eq u64_high_zero_idx, 0
    ok10 = eq u64_high_mixed_ok, 1
    ok11 = eq u64_high_mixed_idx, 63
    ok12 = eq u64_low_zero_ok, 0
    ok13 = eq u64_low_zero_idx, 0
    ok14 = eq u64_low_mixed_ok, 1
    ok15 = eq u64_low_mixed_idx, 3
    ok16 = eq i64_count_ones_neg1, 64
    ok17 = eq i64_count_zeros_neg1, 0
    ok18 = eq i64_lz_neg1, 0
    ok19 = eq i64_tz_neg8, 3
    ok20 = eq i64_lo_neg1, 64
    ok21 = eq i64_to_neg1, 64
    ok22 = eq i64_iso_high_neg8, high_bit
    ok23 = eq i64_iso_low_neg8, 8
    ok24 = eq i64_high_neg8_ok, 1
    ok25 = eq i64_high_neg8_idx, 63
    ok26 = eq i64_low_neg8_ok, 1
    ok27 = eq i64_low_neg8_idx, 3
    ok28 = eq i64_high_zero_ok, 0
    ok29 = eq i64_high_zero_idx, 0
    ok30 = eq i64_low_zero_ok, 0
    ok31 = eq i64_low_zero_idx, 0

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    chain22 = and chain21, ok23
    chain23 = and chain22, ok24
    chain24 = and chain23, ok25
    chain25 = and chain24, ok26
    chain26 = and chain25, ok27
    chain27 = and chain26, ok28
    chain28 = and chain27, ok29
    chain29 = and chain28, ok30
    ok = and chain29, ok31

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(900)

L_PASS:
    return 0

@test "sa_std num u64 primitive macros"():
L_ENTRY:
    max = add 0, NUM_U64_MAX
    be_buf = stack_alloc 8
    le_buf = stack_alloc 8
    ne_buf = stack_alloc 8
    i64_buf = stack_alloc 8

    EXPAND NUM_U64_CHECKED_ADD add_ok, add_value, 7, 5
    EXPAND NUM_U64_CHECKED_ADD add_over_ok, add_over_value, max, 1
    EXPAND NUM_U64_CHECKED_SUB sub_ok, sub_value, 7, 5
    EXPAND NUM_U64_CHECKED_SUB sub_under_ok, sub_under_value, 5, 7
    EXPAND NUM_U64_CHECKED_MUL mul_ok, mul_value, 7, 6
    EXPAND NUM_U64_CHECKED_MUL mul_zero_ok, mul_zero_value, max, 0
    EXPAND NUM_U64_CHECKED_MUL mul_over_ok, mul_over_value, max, 2
    EXPAND NUM_U64_CHECKED_DIV div_ok, div_value, 42, 7
    EXPAND NUM_U64_CHECKED_DIV div_zero_ok, div_zero_value, 42, 0
    EXPAND NUM_U64_CHECKED_REM rem_ok, rem_value, 43, 7
    EXPAND NUM_U64_CHECKED_REM rem_zero_ok, rem_zero_value, 43, 0

    EXPAND NUM_U64_SATURATING_ADD sat_add_mid, 7, 5
    EXPAND NUM_U64_SATURATING_ADD sat_add_max, max, 1
    EXPAND NUM_U64_SATURATING_SUB sat_sub_mid, 7, 5
    EXPAND NUM_U64_SATURATING_SUB sat_sub_zero, 5, 7
    EXPAND NUM_U64_SATURATING_MUL sat_mul_mid, 7, 6
    EXPAND NUM_U64_SATURATING_MUL sat_mul_max, max, 2
    EXPAND NUM_U64_SATURATING_DIV sat_div_mid, 42, 7
    EXPAND NUM_U64_SATURATING_DIV sat_div_max, 42, 0

    EXPAND NUM_U64_WRAPPING_ADD wrap_add, max, 1
    EXPAND NUM_U64_WRAPPING_SUB wrap_sub, 0, 1
    EXPAND NUM_U64_WRAPPING_MUL wrap_mul, max, 2
    EXPAND NUM_U64_WRAPPING_DIV wrap_div, 43, 7
    EXPAND NUM_U64_WRAPPING_REM wrap_rem, 43, 7
    EXPAND NUM_U64_CHECKED_SHL checked_shl_ok, checked_shl_value, 1, 4
    EXPAND NUM_U64_CHECKED_SHL checked_shl_over_ok, checked_shl_over_value, 1, 64
    EXPAND NUM_U64_CHECKED_SHR checked_shr_ok, checked_shr_value, 16, 4
    EXPAND NUM_U64_CHECKED_SHR checked_shr_over_ok, checked_shr_over_value, 16, 64
    EXPAND NUM_U64_WRAPPING_SHL wrap_shl, 1, 68
    EXPAND NUM_U64_WRAPPING_SHR wrap_shr, 16, 68
    EXPAND NUM_U64_IS_POWER_OF_TWO pow2_zero, 0
    EXPAND NUM_U64_IS_POWER_OF_TWO pow2_yes, 16
    EXPAND NUM_U64_IS_POWER_OF_TWO pow2_no, 18
    EXPAND NUM_U64_ABS_DIFF abs_diff_lr, 9, 4
    EXPAND NUM_U64_ABS_DIFF abs_diff_rl, 4, 9
    EXPAND NUM_U64_MIDPOINT midpoint_small, 4, 10
    EXPAND NUM_U64_MIDPOINT midpoint_max, max, max
    EXPAND NUM_U64_ROTATE_LEFT rot_left, 1, 4
    EXPAND NUM_U64_ROTATE_RIGHT rot_right, 16, 4
    EXPAND NUM_U64_ROTATE_LEFT rot_left_mod, 1, 68
    EXPAND NUM_U64_ROTATE_RIGHT rot_right_zero, 16, 0
    EXPAND NUM_U64_COUNT_ONES count_ones, 11
    EXPAND NUM_U64_COUNT_ZEROS count_zeros, 11
    EXPAND NUM_U64_POW pow_value, 3, 4
    EXPAND NUM_U64_LEADING_ZEROS leading_zeros, 8
    EXPAND NUM_U64_LEADING_ZEROS leading_zeros_zero, 0
    EXPAND NUM_U64_TRAILING_ZEROS trailing_zeros, 8
    EXPAND NUM_U64_TRAILING_ZEROS trailing_zeros_zero, 0
    EXPAND NUM_U64_LEADING_ONES leading_ones, max
    EXPAND NUM_U64_TRAILING_ONES trailing_ones, 15
    EXPAND NUM_U64_REVERSE_BITS reverse_one, 1
    EXPAND NUM_U64_SWAP_BYTES swap_one, 1
    EXPAND NUM_U64_TO_BE to_be_one, 1
    EXPAND NUM_U64_FROM_BE from_be_one, to_be_one
    EXPAND NUM_U64_TO_LE to_le_value, 123
    EXPAND NUM_U64_FROM_LE from_le_value, to_le_value
    EXPAND NUM_U64_WRITE_BE_BYTES write_be_ok, be_buf, 8, 81985529216486895
    EXPAND NUM_U64_FROM_BE_BYTES from_be_bytes, be_buf
    be_b0 = load be_buf+0 as u8
    be_b1_ptr = ptr_add be_buf, 1
    be_b7_ptr = ptr_add be_buf, 7
    be_b1 = load be_b1_ptr+0 as u8
    be_b7 = load be_b7_ptr+0 as u8
    EXPAND NUM_U64_WRITE_BE_BYTES write_be_short_ok, be_buf, 7, 81985529216486895
    EXPAND NUM_U64_WRITE_LE_BYTES write_le_ok, le_buf, 8, 81985529216486895
    EXPAND NUM_U64_FROM_LE_BYTES from_le_bytes, le_buf
    le_b0 = load le_buf+0 as u8
    le_b1_ptr = ptr_add le_buf, 1
    le_b7_ptr = ptr_add le_buf, 7
    le_b1 = load le_b1_ptr+0 as u8
    le_b7 = load le_b7_ptr+0 as u8
    EXPAND NUM_U64_WRITE_NE_BYTES write_ne_ok, ne_buf, 8, 81985529216486895
    EXPAND NUM_U64_FROM_NE_BYTES from_ne_bytes, ne_buf
    ne_b0 = load ne_buf+0 as u8
    EXPAND NUM_I64_WRITE_BE_BYTES write_i64_be_ok, i64_buf, 8, -2
    EXPAND NUM_I64_FROM_BE_BYTES from_i64_be_bytes, i64_buf
    i64_b0 = load i64_buf+0 as u8
    i64_b7_ptr = ptr_add i64_buf, 7
    i64_b7 = load i64_b7_ptr+0 as u8
    high_bit = shl 1, 63
    high_byte = shl 1, 56
    high_plus_one = add high_bit, 1
    EXPAND NUM_U64_CHECKED_NEXT_POWER_OF_TWO np_zero_ok, np_zero, 0
    EXPAND NUM_U64_CHECKED_NEXT_POWER_OF_TWO np_one_ok, np_one, 1
    EXPAND NUM_U64_CHECKED_NEXT_POWER_OF_TWO np_mid_ok, np_mid, 9
    EXPAND NUM_U64_CHECKED_NEXT_POWER_OF_TWO np_high_ok, np_high, high_bit
    EXPAND NUM_U64_CHECKED_NEXT_POWER_OF_TWO np_over_ok, np_over, high_plus_one
    EXPAND NUM_U64_NEXT_POWER_OF_TWO np_direct, 9

    ok_add = eq add_ok, 1
    ok_add_value = eq add_value, 12
    ok_add_over = eq add_over_ok, 0
    ok_add_over_value = eq add_over_value, 0
    ok_sub = eq sub_ok, 1
    ok_sub_value = eq sub_value, 2
    ok_sub_under = eq sub_under_ok, 0
    ok_sub_under_value = eq sub_under_value, 0
    ok_mul = eq mul_ok, 1
    ok_mul_value = eq mul_value, 42
    ok_mul_zero = eq mul_zero_ok, 1
    ok_mul_zero_value = eq mul_zero_value, 0
    ok_mul_over = eq mul_over_ok, 0
    ok_mul_over_value = eq mul_over_value, 0
    ok_div = eq div_ok, 1
    ok_div_value = eq div_value, 6
    ok_div_zero = eq div_zero_ok, 0
    ok_div_zero_value = eq div_zero_value, 0
    ok_rem = eq rem_ok, 1
    ok_rem_value = eq rem_value, 1
    ok_rem_zero = eq rem_zero_ok, 0
    ok_rem_zero_value = eq rem_zero_value, 0
    ok_sat_add_mid = eq sat_add_mid, 12
    ok_sat_add_max = eq sat_add_max, max
    ok_sat_sub_mid = eq sat_sub_mid, 2
    ok_sat_sub_zero = eq sat_sub_zero, 0
    ok_sat_mul_mid = eq sat_mul_mid, 42
    ok_sat_mul_max = eq sat_mul_max, max
    ok_sat_div_mid = eq sat_div_mid, 6
    ok_sat_div_max = eq sat_div_max, max
    ok_wrap_add = eq wrap_add, 0
    ok_wrap_sub = eq wrap_sub, max
    max_minus_one = sub max, 1
    ok_wrap_mul = eq wrap_mul, max_minus_one
    ok_wrap_div = eq wrap_div, 6
    ok_wrap_rem = eq wrap_rem, 1
    ok_checked_shl = eq checked_shl_ok, 1
    ok_checked_shl_value = eq checked_shl_value, 16
    ok_checked_shl_over = eq checked_shl_over_ok, 0
    ok_checked_shl_over_value = eq checked_shl_over_value, 0
    ok_checked_shr = eq checked_shr_ok, 1
    ok_checked_shr_value = eq checked_shr_value, 1
    ok_checked_shr_over = eq checked_shr_over_ok, 0
    ok_checked_shr_over_value = eq checked_shr_over_value, 0
    ok_wrap_shl = eq wrap_shl, 16
    ok_wrap_shr = eq wrap_shr, 1
    ok_pow2_zero = eq pow2_zero, 0
    ok_pow2_yes = eq pow2_yes, 1
    ok_pow2_no = eq pow2_no, 0
    ok_abs_diff_lr = eq abs_diff_lr, 5
    ok_abs_diff_rl = eq abs_diff_rl, 5
    ok_midpoint_small = eq midpoint_small, 7
    ok_midpoint_max = eq midpoint_max, max
    ok_rot_left = eq rot_left, 16
    ok_rot_right = eq rot_right, 1
    ok_rot_left_mod = eq rot_left_mod, 16
    ok_rot_right_zero = eq rot_right_zero, 16
    ok_count_ones = eq count_ones, 3
    ok_count_zeros = eq count_zeros, 61
    ok_pow = eq pow_value, 81
    ok_lz = eq leading_zeros, 60
    ok_lz_zero = eq leading_zeros_zero, 64
    ok_tz = eq trailing_zeros, 3
    ok_tz_zero = eq trailing_zeros_zero, 64
    ok_lo = eq leading_ones, 64
    ok_to = eq trailing_ones, 4
    ok_reverse_one = eq reverse_one, high_bit
    ok_swap_one = eq swap_one, high_byte
    ok_to_be = eq to_be_one, high_byte
    ok_from_be = eq from_be_one, 1
    ok_to_le = eq to_le_value, 123
    ok_from_le = eq from_le_value, 123
    ok_write_be = eq write_be_ok, 1
    ok_from_be_bytes = eq from_be_bytes, 81985529216486895
    ok_be_b0 = eq be_b0, 1
    ok_be_b1 = eq be_b1, 35
    ok_be_b7 = eq be_b7, 239
    ok_write_be_short = eq write_be_short_ok, 0
    ok_write_le = eq write_le_ok, 1
    ok_from_le_bytes = eq from_le_bytes, 81985529216486895
    ok_le_b0 = eq le_b0, 239
    ok_le_b1 = eq le_b1, 205
    ok_le_b7 = eq le_b7, 1
    ok_write_ne = eq write_ne_ok, 1
    ok_from_ne_bytes = eq from_ne_bytes, 81985529216486895
    ok_ne_b0 = eq ne_b0, 239
    ok_write_i64_be = eq write_i64_be_ok, 1
    ok_from_i64_be = eq from_i64_be_bytes, -2
    ok_i64_b0 = eq i64_b0, 255
    ok_i64_b7 = eq i64_b7, 254
    ok_np_zero_flag = eq np_zero_ok, 1
    ok_np_zero = eq np_zero, 1
    ok_np_one_flag = eq np_one_ok, 1
    ok_np_one = eq np_one, 1
    ok_np_mid_flag = eq np_mid_ok, 1
    ok_np_mid = eq np_mid, 16
    ok_np_high_flag = eq np_high_ok, 1
    ok_np_high = eq np_high, high_bit
    ok_np_over_flag = eq np_over_ok, 0
    ok_np_over = eq np_over, 0
    ok_np_direct = eq np_direct, 16

    ok01 = and ok_add, ok_add_value
    ok02 = and ok01, ok_add_over
    ok03 = and ok02, ok_add_over_value
    ok04 = and ok03, ok_sub
    ok05 = and ok04, ok_sub_value
    ok06 = and ok05, ok_sub_under
    ok07 = and ok06, ok_sub_under_value
    ok08 = and ok07, ok_mul
    ok09 = and ok08, ok_mul_value
    ok10 = and ok09, ok_mul_zero
    ok11 = and ok10, ok_mul_zero_value
    ok12 = and ok11, ok_mul_over
    ok13 = and ok12, ok_mul_over_value
    ok14 = and ok13, ok_div
    ok15 = and ok14, ok_div_value
    ok16 = and ok15, ok_div_zero
    ok17 = and ok16, ok_div_zero_value
    ok18 = and ok17, ok_sat_add_mid
    ok19 = and ok18, ok_sat_add_max
    ok20 = and ok19, ok_sat_sub_mid
    ok21 = and ok20, ok_sat_sub_zero
    ok22 = and ok21, ok_sat_mul_mid
    ok23 = and ok22, ok_sat_mul_max
    ok24 = and ok23, ok_sat_div_mid
    ok25 = and ok24, ok_sat_div_max
    ok26 = and ok25, ok_wrap_add
    ok27 = and ok26, ok_wrap_sub
    ok28 = and ok27, ok_wrap_mul
    ok29 = and ok28, ok_pow2_zero
    ok30 = and ok29, ok_pow2_yes
    ok31 = and ok30, ok_pow2_no
    ok32 = and ok31, ok_abs_diff_lr
    ok33 = and ok32, ok_abs_diff_rl
    ok34 = and ok33, ok_midpoint_small
    ok35 = and ok34, ok_midpoint_max
    ok36 = and ok35, ok_rot_left
    ok37 = and ok36, ok_rot_right
    ok38 = and ok37, ok_rot_left_mod
    ok39 = and ok38, ok_rot_right_zero
    ok40 = and ok39, ok_count_ones
    ok41 = and ok40, ok_count_zeros
    ok42 = and ok41, ok_pow
    ok43 = and ok42, ok_lz
    ok44 = and ok43, ok_lz_zero
    ok45 = and ok44, ok_tz
    ok46 = and ok45, ok_tz_zero
    ok47 = and ok46, ok_lo
    ok48 = and ok47, ok_to
    ok49 = and ok48, ok_reverse_one
    ok50 = and ok49, ok_swap_one
    ok51 = and ok50, ok_to_be
    ok52 = and ok51, ok_from_be
    ok53 = and ok52, ok_to_le
    ok54 = and ok53, ok_from_le
    ok55 = and ok54, ok_np_zero_flag
    ok56 = and ok55, ok_np_zero
    ok57 = and ok56, ok_np_one_flag
    ok58 = and ok57, ok_np_one
    ok59 = and ok58, ok_np_mid_flag
    ok60 = and ok59, ok_np_mid
    ok61 = and ok60, ok_np_high_flag
    ok62 = and ok61, ok_np_high
    ok63 = and ok62, ok_np_over_flag
    ok64 = and ok63, ok_np_over
    base_ok = and ok64, ok_np_direct
    extra01 = and ok_rem, ok_rem_value
    extra02 = and extra01, ok_rem_zero
    extra03 = and extra02, ok_rem_zero_value
    extra04 = and extra03, ok_wrap_div
    extra05 = and extra04, ok_wrap_rem
    extra06 = and extra05, ok_checked_shl
    extra07 = and extra06, ok_checked_shl_value
    extra08 = and extra07, ok_checked_shl_over
    extra09 = and extra08, ok_checked_shl_over_value
    extra10 = and extra09, ok_checked_shr
    extra11 = and extra10, ok_checked_shr_value
    extra12 = and extra11, ok_checked_shr_over
    extra13 = and extra12, ok_checked_shr_over_value
    extra14 = and extra13, ok_wrap_shl
    extra15 = and extra14, ok_wrap_shr
    extra16 = and extra15, ok_write_be
    extra17 = and extra16, ok_from_be_bytes
    extra18 = and extra17, ok_be_b0
    extra19 = and extra18, ok_be_b1
    extra20 = and extra19, ok_be_b7
    extra21 = and extra20, ok_write_be_short
    extra22 = and extra21, ok_write_le
    extra23 = and extra22, ok_from_le_bytes
    extra24 = and extra23, ok_le_b0
    extra25 = and extra24, ok_le_b1
    extra26 = and extra25, ok_le_b7
    extra27 = and extra26, ok_write_ne
    extra28 = and extra27, ok_from_ne_bytes
    extra29 = and extra28, ok_ne_b0
    extra30 = and extra29, ok_write_i64_be
    extra31 = and extra30, ok_from_i64_be
    extra32 = and extra31, ok_i64_b0
    extra = and extra32, ok_i64_b7
    ok = and base_ok, extra

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10161)

L_PASS:
    return 0

@test "sa_std num checked div rem parity macros"():
L_ENTRY:
    nz_u8_div = stack_alloc NonZeroU8_SIZE
    nz_u8_rem = stack_alloc NonZeroU8_SIZE
    nz_u16_div = stack_alloc NonZeroU16_SIZE
    nz_u16_rem = stack_alloc NonZeroU16_SIZE
    nz_u32_div = stack_alloc NonZeroU32_SIZE
    nz_u32_rem = stack_alloc NonZeroU32_SIZE
    nz_u64_div = stack_alloc NonZeroU64_SIZE
    nz_u64_rem = stack_alloc NonZeroU64_SIZE
    nz_usize_div = stack_alloc NonZeroUsize_SIZE
    nz_usize_rem = stack_alloc NonZeroUsize_SIZE
    nz_i8_div = stack_alloc NonZeroI8_SIZE
    nz_i8_rem = stack_alloc NonZeroI8_SIZE
    nz_i16_div = stack_alloc NonZeroI16_SIZE
    nz_i16_rem = stack_alloc NonZeroI16_SIZE
    nz_i32_div = stack_alloc NonZeroI32_SIZE
    nz_i32_rem = stack_alloc NonZeroI32_SIZE
    nz_i64_div = stack_alloc NonZeroI64_SIZE
    nz_i64_rem = stack_alloc NonZeroI64_SIZE
    nz_isize_div = stack_alloc NonZeroIsize_SIZE
    nz_isize_rem = stack_alloc NonZeroIsize_SIZE

    EXPAND NUM_U8_CHECKED_DIV u8_div_ok, u8_div_value, 12, 3
    EXPAND NUM_U8_CHECKED_REM u8_rem_ok, u8_rem_value, 14, 5
    EXPAND NUM_U8_CHECKED_DIV u8_div_zero_ok, u8_div_zero_value, 12, 0
    EXPAND NUM_U16_CHECKED_DIV u16_div_ok, u16_div_value, 1200, 30
    EXPAND NUM_U16_CHECKED_REM u16_rem_ok, u16_rem_value, 1207, 30
    EXPAND NUM_U32_CHECKED_DIV u32_div_ok, u32_div_value, 120000, 300
    EXPAND NUM_U32_CHECKED_REM u32_rem_ok, u32_rem_value, 120007, 300

    EXPAND NONZERO_U8_CHECKED_DIV nz_u8_div_ok, nz_u8_div, 12, 3
    EXPAND NONZERO_U8_GET nz_u8_div_value, nz_u8_div
    EXPAND NONZERO_U8_CHECKED_REM nz_u8_rem_ok, nz_u8_rem, 14, 5
    EXPAND NONZERO_U8_GET nz_u8_rem_value, nz_u8_rem
    EXPAND NONZERO_U8_CHECKED_DIV nz_u8_div_zero_result_ok, nz_u8_div, 1, 2
    EXPAND NONZERO_U16_CHECKED_DIV nz_u16_div_ok, nz_u16_div, 1200, 30
    EXPAND NONZERO_U16_GET nz_u16_div_value, nz_u16_div
    EXPAND NONZERO_U16_CHECKED_REM nz_u16_rem_ok, nz_u16_rem, 1207, 30
