    nz_usize = stack_alloc NonZeroUsize_SIZE
    nz_usize_add = stack_alloc NonZeroUsize_SIZE
    nz_i8 = stack_alloc NonZeroI8_SIZE
    nz_i8_add = stack_alloc NonZeroI8_SIZE
    nz_i8_abs = stack_alloc NonZeroI8_SIZE
    nz_i8_abs_zero = stack_alloc NonZeroI8_SIZE
    nz_i8_abs_min = stack_alloc NonZeroI8_SIZE
    nz_i8_sat_abs = stack_alloc NonZeroI8_SIZE
    nz_i16 = stack_alloc NonZeroI16_SIZE
    nz_i16_sub = stack_alloc NonZeroI16_SIZE
    nz_i32 = stack_alloc NonZeroI32_SIZE
    nz_i32_mul = stack_alloc NonZeroI32_SIZE
    nz_isize = stack_alloc NonZeroIsize_SIZE
    nz_isize_abs = stack_alloc NonZeroIsize_SIZE

    EXPAND NONZERO_U8_NEW u8_new_ok, nz_u8, 8
    EXPAND NONZERO_U8_GET u8_value, nz_u8
    EXPAND NONZERO_U8_NEW u8_zero_ok, nz_u8, 0
    EXPAND NONZERO_U8_NEW u8_range_ok, nz_u8, 256
    EXPAND NONZERO_U8_IS_VALID u8_valid_max, 255
    EXPAND NONZERO_U8_IS_VALID u8_valid_zero, 0
    EXPAND NONZERO_U8_CHECKED_ADD u8_add_ok, nz_u8_add, 8, 4
    EXPAND NONZERO_U8_GET u8_add_value, nz_u8_add
    EXPAND NONZERO_U8_CHECKED_SUB u8_sub_zero_ok, nz_u8_sub, 8, 8
    EXPAND NONZERO_U8_CHECKED_SUB u8_sub_ok, nz_u8_sub, 8, 3
    EXPAND NONZERO_U8_GET u8_sub_value, nz_u8_sub
    EXPAND NONZERO_U8_CHECKED_MUL u8_mul_ok, nz_u8_mul, 8, 3
    EXPAND NONZERO_U8_GET u8_mul_value, nz_u8_mul
    EXPAND NONZERO_U8_IS_POWER_OF_TWO u8_pow2, nz_u8
    EXPAND NONZERO_U8_SATURATING_ADD nz_u8_sat, 250, 6
    EXPAND NONZERO_U8_GET u8_sat_value, nz_u8_sat

    EXPAND NONZERO_U16_NEW u16_new_ok, nz_u16, 1024
    EXPAND NONZERO_U16_GET u16_value, nz_u16
    EXPAND NONZERO_U16_NEW u16_range_ok, nz_u16, 65536
    EXPAND NONZERO_U16_CHECKED_ADD u16_add_ok, nz_u16_add, 1024, 1
    EXPAND NONZERO_U16_GET u16_add_value, nz_u16_add
    EXPAND NONZERO_U16_SATURATING_MUL nz_u16_sat, 32768, 2
    EXPAND NONZERO_U16_GET u16_sat_value, nz_u16_sat

    EXPAND NONZERO_U32_NEW u32_new_ok, nz_u32, 4096
    EXPAND NONZERO_U32_GET u32_value, nz_u32
    EXPAND NONZERO_U32_CHECKED_MUL u32_mul_ok, nz_u32_mul, 4096, 2
    EXPAND NONZERO_U32_GET u32_mul_value, nz_u32_mul
    EXPAND NONZERO_U32_CHECKED_SUB u32_sub_zero_ok, nz_u32_mul, 4096, 4096

    EXPAND NONZERO_USIZE_NEW usize_new_ok, nz_usize, 64
    EXPAND NONZERO_USIZE_GET usize_value, nz_usize
    EXPAND NONZERO_USIZE_CHECKED_ADD usize_add_ok, nz_usize_add, 64, 1
    EXPAND NONZERO_USIZE_GET usize_add_value, nz_usize_add
    EXPAND NONZERO_USIZE_IS_POWER_OF_TWO usize_pow2, nz_usize

    EXPAND NONZERO_I8_NEW i8_new_ok, nz_i8, -7
    EXPAND NONZERO_I8_GET i8_value, nz_i8
    EXPAND NONZERO_I8_NEW i8_zero_ok, nz_i8, 0
    EXPAND NONZERO_I8_NEW i8_range_ok, nz_i8, 128
    EXPAND NONZERO_I8_IS_VALID i8_valid_min, NUM_I8_MIN
    EXPAND NONZERO_I8_IS_VALID i8_valid_zero, 0
    EXPAND NONZERO_I8_CHECKED_ADD i8_add_ok, nz_i8_add, -7, 2
    EXPAND NONZERO_I8_GET i8_add_value, nz_i8_add
    EXPAND NONZERO_I8_CHECKED_SUB i8_sub_zero_ok, nz_i8_add, -7, -7
    EXPAND NONZERO_I8_CHECKED_MUL i8_mul_zero_ok, nz_i8_add, -7, 0
    EXPAND NONZERO_I8_CHECKED_ABS i8_abs_ok, nz_i8_abs, -7
    EXPAND NONZERO_I8_GET i8_abs_value, nz_i8_abs
    EXPAND NONZERO_I8_CHECKED_ABS i8_abs_zero_ok, nz_i8_abs_zero, 0
    EXPAND NONZERO_I8_CHECKED_ABS i8_abs_min_ok, nz_i8_abs_min, NUM_I8_MIN
    EXPAND NONZERO_I8_SATURATING_ABS nz_i8_sat_abs, NUM_I8_MIN
    EXPAND NONZERO_I8_GET i8_sat_abs_value, nz_i8_sat_abs
    EXPAND NONZERO_I8_IS_NEGATIVE i8_negative, nz_i8
    EXPAND NONZERO_I8_IS_POSITIVE i8_positive, nz_i8_abs

    EXPAND NONZERO_I16_NEW i16_new_ok, nz_i16, -1024
    EXPAND NONZERO_I16_GET i16_value, nz_i16
    EXPAND NONZERO_I16_CHECKED_SUB i16_sub_ok, nz_i16_sub, -1024, 1
    EXPAND NONZERO_I16_GET i16_sub_value, nz_i16_sub
    EXPAND NONZERO_I16_SATURATING_ABS nz_i16_sub, NUM_I16_MIN
    EXPAND NONZERO_I16_GET i16_sat_abs_value, nz_i16_sub

    EXPAND NONZERO_I32_NEW i32_new_ok, nz_i32, -4096
    EXPAND NONZERO_I32_GET i32_value, nz_i32
    EXPAND NONZERO_I32_CHECKED_MUL i32_mul_ok, nz_i32_mul, -4096, 2
    EXPAND NONZERO_I32_GET i32_mul_value, nz_i32_mul
    EXPAND NONZERO_I32_IS_NEGATIVE i32_negative, nz_i32

    EXPAND NONZERO_ISIZE_NEW isize_new_ok, nz_isize, -64
    EXPAND NONZERO_ISIZE_GET isize_value, nz_isize
    EXPAND NONZERO_ISIZE_CHECKED_ABS isize_abs_ok, nz_isize_abs, -64
    EXPAND NONZERO_ISIZE_GET isize_abs_value, nz_isize_abs
    EXPAND NONZERO_ISIZE_IS_POSITIVE isize_positive, nz_isize_abs

    ok01 = eq u8_new_ok, 1
    ok02 = eq u8_value, 8
    ok03 = eq u8_zero_ok, 0
    ok04 = eq u8_range_ok, 0
    ok05 = eq u8_valid_max, 1
    ok06 = eq u8_valid_zero, 0
    ok07 = eq u8_add_ok, 1
    ok08 = eq u8_add_value, 12
    ok09 = eq u8_sub_zero_ok, 0
    ok10 = eq u8_sub_ok, 1
    ok11 = eq u8_sub_value, 5
    ok12 = eq u8_mul_ok, 1
    ok13 = eq u8_mul_value, 24
    ok14 = eq u8_pow2, 1
    ok15 = eq u8_sat_value, NUM_U8_MAX
    ok16 = eq u16_new_ok, 1
    ok17 = eq u16_value, 1024
    ok18 = eq u16_range_ok, 0
    ok19 = eq u16_add_ok, 1
    ok20 = eq u16_add_value, 1025
    ok21 = eq u16_sat_value, NUM_U16_MAX
    ok22 = eq u32_new_ok, 1
    ok23 = eq u32_value, 4096
    ok24 = eq u32_mul_ok, 1
    ok25 = eq u32_mul_value, 8192
    ok26 = eq u32_sub_zero_ok, 0
    ok27 = eq usize_new_ok, 1
    ok28 = eq usize_value, 64
    ok29 = eq usize_add_ok, 1
    ok30 = eq usize_add_value, 65
    ok31 = eq usize_pow2, 1
    ok32 = eq i8_new_ok, 1
    ok33 = eq i8_value, -7
    ok34 = eq i8_zero_ok, 0
    ok35 = eq i8_range_ok, 0
    ok36 = eq i8_valid_min, 1
    ok37 = eq i8_valid_zero, 0
    ok38 = eq i8_add_ok, 1
    ok39 = eq i8_add_value, -5
    ok40 = eq i8_sub_zero_ok, 0
    ok41 = eq i8_mul_zero_ok, 0
    ok42 = eq i8_abs_ok, 1
    ok43 = eq i8_abs_value, 7
    ok44 = eq i8_abs_zero_ok, 0
    ok45 = eq i8_abs_min_ok, 0
    ok46 = eq i8_sat_abs_value, NUM_I8_MAX
    ok47 = eq i8_negative, 1
    ok48 = eq i8_positive, 1
    ok49 = eq i16_new_ok, 1
    ok50 = eq i16_value, -1024
    ok51 = eq i16_sub_ok, 1
    ok52 = eq i16_sub_value, -1025
    ok53 = eq i16_sat_abs_value, NUM_I16_MAX
    ok54 = eq i32_new_ok, 1
    ok55 = eq i32_value, -4096
    ok56 = eq i32_mul_ok, 1
    ok57 = eq i32_mul_value, -8192
    ok58 = eq i32_negative, 1
    ok59 = eq isize_new_ok, 1
    ok60 = eq isize_value, -64
    ok61 = eq isize_abs_ok, 1
    ok62 = eq isize_abs_value, 64
    ok63 = eq isize_positive, 1

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
