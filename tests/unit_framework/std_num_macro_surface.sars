@test "sa_std num endian value transform macros"():
L_ENTRY:
    EXPAND NUM_U8_SWAP_BYTES u8_swap, 171
    EXPAND NUM_U8_TO_BE u8_to_be, 171
    EXPAND NUM_U8_FROM_BE u8_from_be, u8_to_be
    EXPAND NUM_U16_SWAP_BYTES u16_swap, 4660
    EXPAND NUM_U16_TO_BE u16_to_be, 4660
    EXPAND NUM_U16_FROM_BE u16_from_be, u16_to_be
    EXPAND NUM_U16_TO_LE u16_to_le, 4660
    EXPAND NUM_U32_SWAP_BYTES u32_swap, 305419896
    EXPAND NUM_U32_TO_BE u32_to_be, 305419896
    EXPAND NUM_U32_FROM_BE u32_from_be, u32_to_be
    EXPAND NUM_U32_TO_LE u32_to_le, 305419896
    EXPAND NUM_I8_SWAP_BYTES i8_swap, -2
    EXPAND NUM_I8_TO_LE i8_to_le, -2
    EXPAND NUM_I16_SWAP_BYTES i16_swap, -257
    EXPAND NUM_I16_FROM_BE i16_from_be, i16_swap
    EXPAND NUM_I32_SWAP_BYTES i32_swap, -65537
    EXPAND NUM_I32_FROM_BE i32_from_be, i32_swap
    EXPAND NUM_I64_SWAP_BYTES i64_swap, -2
    EXPAND NUM_I64_FROM_BE i64_from_be, i64_swap
    EXPAND NUM_USIZE_TO_BE usize_to_be, 1
    EXPAND NUM_USIZE_FROM_BE usize_from_be, usize_to_be
    EXPAND NUM_ISIZE_TO_LE isize_to_le, -2
    EXPAND NUM_ISIZE_FROM_LE isize_from_le, isize_to_le

    high_byte = shl 1, 56
    ok01 = eq u8_swap, 171
    ok02 = eq u8_to_be, 171
    ok03 = eq u8_from_be, 171
    ok04 = eq u16_swap, 13330
    ok05 = eq u16_to_be, 13330
    ok06 = eq u16_from_be, 4660
    ok07 = eq u16_to_le, 4660
    ok08 = eq u32_swap, 2018915346
    ok09 = eq u32_to_be, 2018915346
    ok10 = eq u32_from_be, 305419896
    ok11 = eq u32_to_le, 305419896
    ok12 = eq i8_swap, -2
    ok13 = eq i8_to_le, -2
    ok14 = eq i16_swap, -2
    ok15 = eq i16_from_be, -257
    ok16 = eq i32_swap, -257
    ok17 = eq i32_from_be, -65537
    ok18 = eq i64_swap, -72057594037927937
    ok19 = eq i64_from_be, -2
    ok20 = eq usize_to_be, high_byte
    ok21 = eq usize_from_be, 1
    ok22 = eq isize_to_le, -2
    ok23 = eq isize_from_le, -2

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    ok = and chain21, ok23

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(9621)

L_PASS:
