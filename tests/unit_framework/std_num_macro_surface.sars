@test "sa_std num i64 arithmetic parity macros"():
L_ENTRY:
    neg_three = sub 0, 3
    neg_four = sub 0, 4
    neg_ten = sub 0, 10
    neg_sixteen = sub 0, 16
    neg_twenty_one = sub 0, 21
    neg_twenty_seven = sub 0, 27
    neg_two = sub 0, 2
    max_minus_one = sub NUM_I64_MAX, 1

    EXPAND NUM_I64_CHECKED_MUL checked_mul_ok, checked_mul_value, 7, 6
    EXPAND NUM_I64_CHECKED_MUL checked_mul_zero_ok, checked_mul_zero_value, NUM_I64_MAX, 0
    EXPAND NUM_I64_CHECKED_MUL checked_mul_over_ok, checked_mul_over_value, NUM_I64_MAX, 2
    EXPAND NUM_I64_CHECKED_MUL checked_mul_min_ok, checked_mul_min_value, NUM_I64_MIN, -1
    EXPAND NUM_I64_SATURATING_MUL sat_mul_mid, 7, neg_three
    EXPAND NUM_I64_SATURATING_MUL sat_mul_max, NUM_I64_MAX, 2
    EXPAND NUM_I64_SATURATING_MUL sat_mul_min, NUM_I64_MIN, 2
    EXPAND NUM_I64_SATURATING_MUL sat_mul_min_neg, NUM_I64_MIN, -1

    EXPAND NUM_I64_WRAPPING_ADD wrap_add, NUM_I64_MAX, 1
    EXPAND NUM_I64_WRAPPING_SUB wrap_sub, NUM_I64_MIN, 1
    EXPAND NUM_I64_WRAPPING_MUL wrap_mul, NUM_I64_MAX, 2
    EXPAND NUM_I64_WRAPPING_DIV wrap_div, NUM_I64_MIN, -1
    EXPAND NUM_I64_WRAPPING_REM wrap_rem, NUM_I64_MIN, -1

    EXPAND NUM_I64_CHECKED_SHL checked_shl_ok, checked_shl_value, 1, 4
    EXPAND NUM_I64_CHECKED_SHL checked_shl_over_ok, checked_shl_over_value, 1, 64
    EXPAND NUM_I64_CHECKED_SHR checked_shr_ok, checked_shr_value, neg_sixteen, 2
    EXPAND NUM_I64_CHECKED_SHR checked_shr_over_ok, checked_shr_over_value, neg_sixteen, 64
    EXPAND NUM_I64_WRAPPING_SHL wrap_shl, 1, 68
    EXPAND NUM_I64_WRAPPING_SHR wrap_shr, neg_sixteen, 66

    EXPAND NUM_I64_MIDPOINT midpoint_pos, 4, 10
    EXPAND NUM_I64_MIDPOINT midpoint_neg, neg_ten, neg_four
    EXPAND NUM_I64_MIDPOINT midpoint_mixed, neg_ten, 4
    EXPAND NUM_I64_POW pow_neg_odd, neg_three, 3
    EXPAND NUM_I64_POW pow_neg_even, neg_three, 2

    ok_checked_mul = eq checked_mul_ok, 1
    ok_checked_mul_value = eq checked_mul_value, 42
    ok_checked_mul_zero = eq checked_mul_zero_ok, 1
    ok_checked_mul_zero_value = eq checked_mul_zero_value, 0
    ok_checked_mul_over = eq checked_mul_over_ok, 0
    ok_checked_mul_over_value = eq checked_mul_over_value, 0
    ok_checked_mul_min = eq checked_mul_min_ok, 0
    ok_checked_mul_min_value = eq checked_mul_min_value, 0
    ok_sat_mul_mid = eq sat_mul_mid, neg_twenty_one
    ok_sat_mul_max = eq sat_mul_max, NUM_I64_MAX
    ok_sat_mul_min = eq sat_mul_min, NUM_I64_MIN
    ok_sat_mul_min_neg = eq sat_mul_min_neg, NUM_I64_MAX
    ok_wrap_add = eq wrap_add, NUM_I64_MIN
    ok_wrap_sub = eq wrap_sub, NUM_I64_MAX
    ok_wrap_mul = eq wrap_mul, neg_two
    ok_wrap_div = eq wrap_div, NUM_I64_MIN
    ok_wrap_rem = eq wrap_rem, 0
    ok_checked_shl = eq checked_shl_ok, 1
    ok_checked_shl_value = eq checked_shl_value, 16
    ok_checked_shl_over = eq checked_shl_over_ok, 0
    ok_checked_shl_over_value = eq checked_shl_over_value, 0
    ok_checked_shr = eq checked_shr_ok, 1
    ok_checked_shr_value = eq checked_shr_value, neg_four
    ok_checked_shr_over = eq checked_shr_over_ok, 0
    ok_checked_shr_over_value = eq checked_shr_over_value, 0
    ok_wrap_shl = eq wrap_shl, 16
    ok_wrap_shr = eq wrap_shr, neg_four
    ok_midpoint_pos = eq midpoint_pos, 7
    ok_midpoint_neg = eq midpoint_neg, -7
    ok_midpoint_mixed = eq midpoint_mixed, -3
    ok_pow_neg_odd = eq pow_neg_odd, neg_twenty_seven
    ok_pow_neg_even = eq pow_neg_even, 9

    ok01 = and ok_checked_mul, ok_checked_mul_value
    ok02 = and ok01, ok_checked_mul_zero
