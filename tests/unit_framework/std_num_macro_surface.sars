@test "sa_std num nonzero narrow and platform macros"():
L_ENTRY:
    nz_u8 = stack_alloc NonZeroU8_SIZE
    nz_u8_add = stack_alloc NonZeroU8_SIZE
    nz_u8_sub = stack_alloc NonZeroU8_SIZE
    nz_u8_mul = stack_alloc NonZeroU8_SIZE
