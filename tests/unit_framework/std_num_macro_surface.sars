@test "sa_std num narrow byte conversion macros"():
L_ENTRY:
    buf = stack_alloc 8

    EXPAND NUM_U8_WRITE_BE_BYTES u8_write_ok, buf, 1, 171
    EXPAND NUM_U8_FROM_BE_BYTES u8_from_be, buf
    EXPAND NUM_U8_WRITE_BE_BYTES u8_short_ok, buf, 0, 171

    EXPAND NUM_U16_WRITE_BE_BYTES u16_be_ok, buf, 2, 4660
    EXPAND NUM_U16_FROM_BE_BYTES u16_from_be, buf
    u16_be_b0 = load buf+0 as u8
    u16_be_b1 = load buf+1 as u8
    EXPAND NUM_U16_WRITE_LE_BYTES u16_le_ok, buf, 2, 4660
    EXPAND NUM_U16_FROM_LE_BYTES u16_from_le, buf
    u16_le_b0 = load buf+0 as u8
    u16_le_b1 = load buf+1 as u8
    EXPAND NUM_U16_WRITE_BE_BYTES u16_short_ok, buf, 1, 4660

    EXPAND NUM_U32_WRITE_BE_BYTES u32_be_ok, buf, 4, 305419896
    EXPAND NUM_U32_FROM_BE_BYTES u32_from_be, buf
    u32_be_b0 = load buf+0 as u8
    u32_be_b3 = load buf+3 as u8
    EXPAND NUM_U32_WRITE_LE_BYTES u32_le_ok, buf, 4, 305419896
    EXPAND NUM_U32_FROM_LE_BYTES u32_from_le, buf
    u32_le_b0 = load buf+0 as u8
    u32_le_b3 = load buf+3 as u8
    EXPAND NUM_U32_WRITE_BE_BYTES u32_short_ok, buf, 3, 305419896

    EXPAND NUM_I8_WRITE_BE_BYTES i8_write_ok, buf, 1, -2
    EXPAND NUM_I8_FROM_BE_BYTES i8_from_be, buf
    i8_b0 = load buf+0 as u8
    EXPAND NUM_I16_WRITE_BE_BYTES i16_be_ok, buf, 2, -2
    EXPAND NUM_I16_FROM_BE_BYTES i16_from_be, buf
    i16_be_b0 = load buf+0 as u8
    i16_be_b1 = load buf+1 as u8
    EXPAND NUM_I32_WRITE_LE_BYTES i32_le_ok, buf, 4, -2
    EXPAND NUM_I32_FROM_LE_BYTES i32_from_le, buf
    i32_le_b0 = load buf+0 as u8
    i32_le_b3 = load buf+3 as u8

    ok01 = eq u8_write_ok, 1
    ok02 = eq u8_from_be, 171
    ok03 = eq u8_short_ok, 0
    ok04 = eq u16_be_ok, 1
    ok05 = eq u16_from_be, 4660
    ok06 = eq u16_be_b0, 18
    ok07 = eq u16_be_b1, 52
    ok08 = eq u16_le_ok, 1
    ok09 = eq u16_from_le, 4660
    ok10 = eq u16_le_b0, 52
    ok11 = eq u16_le_b1, 18
    ok12 = eq u16_short_ok, 0
    ok13 = eq u32_be_ok, 1
    ok14 = eq u32_from_be, 305419896
    ok15 = eq u32_be_b0, 18
    ok16 = eq u32_be_b3, 120
    ok17 = eq u32_le_ok, 1
    ok18 = eq u32_from_le, 305419896
    ok19 = eq u32_le_b0, 120
    ok20 = eq u32_le_b3, 18
    ok21 = eq u32_short_ok, 0
    ok22 = eq i8_write_ok, 1
    ok23 = eq i8_from_be, -2
    ok24 = eq i8_b0, 254
    ok25 = eq i16_be_ok, 1
    ok26 = eq i16_from_be, -2
    ok27 = eq i16_be_b0, 255
    ok28 = eq i16_be_b1, 254
    ok29 = eq i32_le_ok, 1
    ok30 = eq i32_from_le, -2
    ok31 = eq i32_le_b0, 254
    ok32 = eq i32_le_b3, 255

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
