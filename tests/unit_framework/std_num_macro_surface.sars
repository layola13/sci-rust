@test "sa_std num signed rust named parity macros"():
L_ENTRY:
    EXPAND NUM_I64_CHECKED_DIV_EUCLID div_euclid_pos_ok, div_euclid_pos, 7, 3
    EXPAND NUM_I64_CHECKED_DIV_EUCLID div_euclid_neg_ok, div_euclid_neg, -7, 3
    EXPAND NUM_I64_CHECKED_DIV_EUCLID div_euclid_both_neg_ok, div_euclid_both_neg, -7, -3
    EXPAND NUM_I64_CHECKED_DIV_EUCLID div_euclid_zero_ok, div_euclid_zero, 7, 0
    EXPAND NUM_I64_CHECKED_DIV_EUCLID div_euclid_over_ok, div_euclid_over, NUM_I64_MIN, -1
    EXPAND NUM_I64_DIV_EUCLID div_euclid_direct, -7, 3

    EXPAND NUM_I64_CHECKED_REM_EUCLID rem_euclid_pos_ok, rem_euclid_pos, 7, 3
    EXPAND NUM_I64_CHECKED_REM_EUCLID rem_euclid_neg_ok, rem_euclid_neg, -7, 3
    EXPAND NUM_I64_CHECKED_REM_EUCLID rem_euclid_both_neg_ok, rem_euclid_both_neg, -7, -3
    EXPAND NUM_I64_CHECKED_REM_EUCLID rem_euclid_zero_ok, rem_euclid_zero, 7, 0
    EXPAND NUM_I64_REM_EUCLID rem_euclid_direct, -7, 3

    EXPAND NUM_I64_CHECKED_DIV_CEIL div_ceil_pos_ok, div_ceil_pos, 7, 3
    EXPAND NUM_I64_CHECKED_DIV_CEIL div_ceil_neg_lhs_ok, div_ceil_neg_lhs, -7, 3
    EXPAND NUM_I64_CHECKED_DIV_CEIL div_ceil_neg_rhs_ok, div_ceil_neg_rhs, 7, -3
    EXPAND NUM_I64_CHECKED_DIV_CEIL div_ceil_both_neg_ok, div_ceil_both_neg, -7, -3
    EXPAND NUM_I64_CHECKED_DIV_CEIL div_ceil_zero_ok, div_ceil_zero, 7, 0
    EXPAND NUM_I64_DIV_CEIL div_ceil_direct, -7, -3

    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF next_pos_ok, next_pos, 43, 7
    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF next_neg_value_ok, next_neg_value, -43, 7
    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF next_neg_rhs_ok, next_neg_rhs, 43, -7
    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF next_aligned_ok, next_aligned, -42, 7
    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF next_zero_rhs_ok, next_zero_rhs, 42, 0
    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF next_over_ok, next_over, NUM_I64_MAX, 2
    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF next_min_rhs_zero_ok, next_min_rhs_zero, -7, NUM_I64_MIN
    EXPAND NUM_I64_NEXT_MULTIPLE_OF next_direct, -43, 7

    EXPAND NUM_I64_CHECKED_ILOG ilog_ok, ilog_value, 125, 5
    EXPAND NUM_I64_CHECKED_ILOG ilog_neg_ok, ilog_neg_value, -125, 5
    EXPAND NUM_I64_CHECKED_ILOG ilog_base_one_ok, ilog_base_one_value, 125, 1
    EXPAND NUM_I64_ILOG ilog_direct, 125, 5
    EXPAND NUM_I64_CHECKED_ILOG2 ilog2_ok, ilog2_value, 1024
    EXPAND NUM_I64_CHECKED_ILOG2 ilog2_zero_ok, ilog2_zero_value, 0
    EXPAND NUM_I64_ILOG2 ilog2_direct, 1024
    EXPAND NUM_I64_CHECKED_ILOG10 ilog10_ok, ilog10_value, 1000
    EXPAND NUM_I64_ILOG10 ilog10_direct, 1000

    EXPAND NUM_ISIZE_CHECKED_DIV_CEIL isize_div_ceil_ok, isize_div_ceil, -7, -3
    EXPAND NUM_ISIZE_CHECKED_NEXT_MULTIPLE_OF isize_next_ok, isize_next, -43, 7
    EXPAND NUM_ISIZE_CHECKED_ILOG2 isize_ilog2_ok, isize_ilog2_value, 1024
    EXPAND NUM_ISIZE_REM_EUCLID isize_rem_euclid, -7, 3

    ok01 = eq div_euclid_pos_ok, 1
    ok02 = eq div_euclid_pos, 2
    ok03 = eq div_euclid_neg_ok, 1
    ok04 = eq div_euclid_neg, -3
    ok05 = eq div_euclid_both_neg_ok, 1
    ok06 = eq div_euclid_both_neg, 3
    ok07 = eq div_euclid_zero_ok, 0
    ok08 = eq div_euclid_zero, 0
    ok09 = eq div_euclid_over_ok, 0
    ok10 = eq div_euclid_over, 0
    ok11 = eq div_euclid_direct, -3
    ok12 = eq rem_euclid_pos_ok, 1
    ok13 = eq rem_euclid_pos, 1
    ok14 = eq rem_euclid_neg_ok, 1
    ok15 = eq rem_euclid_neg, 2
    ok16 = eq rem_euclid_both_neg_ok, 1
    ok17 = eq rem_euclid_both_neg, 2
    ok18 = eq rem_euclid_zero_ok, 0
    ok19 = eq rem_euclid_zero, 0
    ok20 = eq rem_euclid_direct, 2
    ok21 = eq div_ceil_pos_ok, 1
    ok22 = eq div_ceil_pos, 3
    ok23 = eq div_ceil_neg_lhs_ok, 1
    ok24 = eq div_ceil_neg_lhs, -2
    ok25 = eq div_ceil_neg_rhs_ok, 1
    ok26 = eq div_ceil_neg_rhs, -2
    ok27 = eq div_ceil_both_neg_ok, 1
    ok28 = eq div_ceil_both_neg, 3
    ok29 = eq div_ceil_zero_ok, 0
    ok30 = eq div_ceil_zero, 0
    ok31 = eq div_ceil_direct, 3
    ok32 = eq next_pos_ok, 1
    ok33 = eq next_pos, 49
    ok34 = eq next_neg_value_ok, 1
    ok35 = eq next_neg_value, -42
    ok36 = eq next_neg_rhs_ok, 1
    ok37 = eq next_neg_rhs, 49
    ok38 = eq next_aligned_ok, 1
    ok39 = eq next_aligned, -42
    ok40 = eq next_zero_rhs_ok, 0
    ok41 = eq next_zero_rhs, 0
    ok42 = eq next_over_ok, 0
    ok43 = eq next_over, 0
    ok44 = eq next_min_rhs_zero_ok, 1
    ok45 = eq next_min_rhs_zero, 0
    ok46 = eq next_direct, -42
    ok47 = eq ilog_ok, 1
    ok48 = eq ilog_value, 3
    ok49 = eq ilog_neg_ok, 0
    ok50 = eq ilog_neg_value, 0
    ok51 = eq ilog_base_one_ok, 0
