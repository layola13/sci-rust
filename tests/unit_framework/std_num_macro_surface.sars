    EXPAND NONZERO_U64_TRAILING_ZEROS u64_tz, nz_u64
    EXPAND NONZERO_U64_WRITE_BE_BYTES u64_write_ok, nz_u64, buf, 8
    EXPAND NONZERO_U64_FROM_BE_BYTES u64_from_ok, nz_u64_from, buf
