@test "sa_std num nonzero primitive macros"():
L_ENTRY:
    nz_u64 = stack_alloc NonZeroU64_SIZE
    nz_u64_add = stack_alloc NonZeroU64_SIZE
    nz_u64_sub = stack_alloc NonZeroU64_SIZE
    nz_u64_mul = stack_alloc NonZeroU64_SIZE
    nz_u64_sat = stack_alloc NonZeroU64_SIZE
    nz_i64 = stack_alloc NonZeroI64_SIZE
    nz_i64_add = stack_alloc NonZeroI64_SIZE
    nz_i64_sub = stack_alloc NonZeroI64_SIZE
    nz_i64_mul = stack_alloc NonZeroI64_SIZE
    nz_i64_abs = stack_alloc NonZeroI64_SIZE
    nz_i64_abs_zero = stack_alloc NonZeroI64_SIZE
    nz_i64_sat_abs = stack_alloc NonZeroI64_SIZE

    EXPAND NONZERO_U64_NEW nz_u64_new_ok, nz_u64, 8
    EXPAND NONZERO_U64_GET nz_u64_value, nz_u64
    EXPAND NONZERO_U64_IS_VALID nz_u64_zero_valid, 0
    EXPAND NONZERO_U64_CHECKED_ADD nz_u64_add_ok, nz_u64_add, 8, 4
    EXPAND NONZERO_U64_GET nz_u64_add_value, nz_u64_add
    EXPAND NONZERO_U64_CHECKED_SUB nz_u64_sub_ok, nz_u64_sub, 8, 3
    EXPAND NONZERO_U64_GET nz_u64_sub_value, nz_u64_sub
    EXPAND NONZERO_U64_CHECKED_SUB nz_u64_sub_zero_ok, nz_u64_sub, 8, 8
    EXPAND NONZERO_U64_CHECKED_MUL nz_u64_mul_ok, nz_u64_mul, 8, 3
    EXPAND NONZERO_U64_GET nz_u64_mul_value, nz_u64_mul
    EXPAND NONZERO_U64_IS_POWER_OF_TWO nz_u64_pow2, nz_u64
    EXPAND NONZERO_U64_SATURATING_ADD nz_u64_sat, NUM_U64_MAX, 1
    EXPAND NONZERO_U64_GET nz_u64_sat_value, nz_u64_sat

    EXPAND NONZERO_I64_NEW nz_i64_new_ok, nz_i64, -7
    EXPAND NONZERO_I64_GET nz_i64_value, nz_i64
    EXPAND NONZERO_I64_IS_VALID nz_i64_zero_valid, 0
    EXPAND NONZERO_I64_CHECKED_ADD nz_i64_add_ok, nz_i64_add, -7, 2
    EXPAND NONZERO_I64_GET nz_i64_add_value, nz_i64_add
    EXPAND NONZERO_I64_CHECKED_SUB nz_i64_sub_ok, nz_i64_sub, -7, 2
    EXPAND NONZERO_I64_GET nz_i64_sub_value, nz_i64_sub
    EXPAND NONZERO_I64_CHECKED_MUL nz_i64_mul_ok, nz_i64_mul, -7, 3
    EXPAND NONZERO_I64_GET nz_i64_mul_value, nz_i64_mul
    EXPAND NONZERO_I64_CHECKED_ABS nz_i64_abs_ok, nz_i64_abs, -7
    EXPAND NONZERO_I64_GET nz_i64_abs_value, nz_i64_abs
    EXPAND NONZERO_I64_CHECKED_ABS nz_i64_abs_zero_ok, nz_i64_abs_zero, 0
    EXPAND NONZERO_I64_SATURATING_ABS nz_i64_sat_abs, NUM_I64_MIN
    EXPAND NONZERO_I64_GET nz_i64_sat_abs_value, nz_i64_sat_abs
    EXPAND NONZERO_I64_IS_NEGATIVE nz_i64_negative, nz_i64
    EXPAND NONZERO_I64_IS_POSITIVE nz_i64_positive, nz_i64_abs

    ok_nz_u64_new = eq nz_u64_new_ok, 1
    ok_nz_u64_value = eq nz_u64_value, 8
    ok_nz_u64_zero = eq nz_u64_zero_valid, 0
    ok_nz_u64_add = eq nz_u64_add_ok, 1
    ok_nz_u64_add_value = eq nz_u64_add_value, 12
    ok_nz_u64_sub = eq nz_u64_sub_ok, 1
    ok_nz_u64_sub_value = eq nz_u64_sub_value, 5
