@test "sa_std num nonzero endian value transform macros"():
L_ENTRY:
    nz_u64 = stack_alloc NonZeroU64_SIZE
    nz_u64_swapped = stack_alloc NonZeroU64_SIZE
    nz_i64 = stack_alloc NonZeroI64_SIZE
    nz_i64_swapped = stack_alloc NonZeroI64_SIZE
    nz_u16 = stack_alloc NonZeroU16_SIZE
    nz_u16_swapped = stack_alloc NonZeroU16_SIZE
    nz_u32 = stack_alloc NonZeroU32_SIZE
    nz_u32_swapped = stack_alloc NonZeroU32_SIZE
    nz_i16 = stack_alloc NonZeroI16_SIZE
    nz_i16_swapped = stack_alloc NonZeroI16_SIZE
    nz_i32 = stack_alloc NonZeroI32_SIZE
    nz_i32_swapped = stack_alloc NonZeroI32_SIZE
    nz_u8 = stack_alloc NonZeroU8_SIZE
    nz_u8_be = stack_alloc NonZeroU8_SIZE
    nz_i8 = stack_alloc NonZeroI8_SIZE
    nz_i8_le = stack_alloc NonZeroI8_SIZE
    nz_usize = stack_alloc NonZeroUsize_SIZE
    nz_usize_be = stack_alloc NonZeroUsize_SIZE
    nz_isize = stack_alloc NonZeroIsize_SIZE
    nz_isize_le = stack_alloc NonZeroIsize_SIZE

    EXPAND NONZERO_U64_NEW u64_new_ok, nz_u64, 1
    EXPAND NONZERO_U64_TO_BE u64_be_ok, nz_u64_swapped, nz_u64
    EXPAND NONZERO_U64_GET u64_be_value, nz_u64_swapped
    EXPAND NONZERO_U64_FROM_BE u64_back_ok, nz_u64, nz_u64_swapped
    EXPAND NONZERO_U64_GET u64_back_value, nz_u64
    EXPAND NONZERO_I64_NEW i64_new_ok, nz_i64, -2
    EXPAND NONZERO_I64_TO_BE i64_be_ok, nz_i64_swapped, nz_i64
    EXPAND NONZERO_I64_GET i64_be_value, nz_i64_swapped
    EXPAND NONZERO_I64_FROM_BE i64_back_ok, nz_i64, nz_i64_swapped
    EXPAND NONZERO_I64_GET i64_back_value, nz_i64

    EXPAND NONZERO_U16_NEW u16_new_ok, nz_u16, 4660
    EXPAND NONZERO_U16_TO_BE u16_be_ok, nz_u16_swapped, nz_u16
    EXPAND NONZERO_U16_GET u16_be_value, nz_u16_swapped
    EXPAND NONZERO_U16_FROM_BE u16_back_ok, nz_u16, nz_u16_swapped
    EXPAND NONZERO_U16_GET u16_back_value, nz_u16
    EXPAND NONZERO_U32_NEW u32_new_ok, nz_u32, 305419896
    EXPAND NONZERO_U32_TO_BE u32_be_ok, nz_u32_swapped, nz_u32
    EXPAND NONZERO_U32_GET u32_be_value, nz_u32_swapped
    EXPAND NONZERO_U32_FROM_BE u32_back_ok, nz_u32, nz_u32_swapped
    EXPAND NONZERO_U32_GET u32_back_value, nz_u32

    EXPAND NONZERO_I16_NEW i16_new_ok, nz_i16, -257
    EXPAND NONZERO_I16_TO_BE i16_be_ok, nz_i16_swapped, nz_i16
    EXPAND NONZERO_I16_GET i16_be_value, nz_i16_swapped
    EXPAND NONZERO_I16_FROM_BE i16_back_ok, nz_i16, nz_i16_swapped
    EXPAND NONZERO_I16_GET i16_back_value, nz_i16
    EXPAND NONZERO_I32_NEW i32_new_ok, nz_i32, -65537
    EXPAND NONZERO_I32_TO_BE i32_be_ok, nz_i32_swapped, nz_i32
    EXPAND NONZERO_I32_GET i32_be_value, nz_i32_swapped
    EXPAND NONZERO_I32_FROM_BE i32_back_ok, nz_i32, nz_i32_swapped
    EXPAND NONZERO_I32_GET i32_back_value, nz_i32

    EXPAND NONZERO_U8_NEW u8_new_ok, nz_u8, 171
    EXPAND NONZERO_U8_TO_BE u8_be_ok, nz_u8_be, nz_u8
    EXPAND NONZERO_U8_GET u8_be_value, nz_u8_be
    EXPAND NONZERO_I8_NEW i8_new_ok, nz_i8, -2
    EXPAND NONZERO_I8_TO_LE i8_le_ok, nz_i8_le, nz_i8
    EXPAND NONZERO_I8_GET i8_le_value, nz_i8_le
    EXPAND NONZERO_USIZE_NEW usize_new_ok, nz_usize, 1
