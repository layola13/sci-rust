@import "sa_std/collections/vec_deque.sars"

@test "sa_std vec_deque push pop"():
L_ENTRY:
    EXPAND VEC_DEQUE_NEW d
    EXPAND VEC_DEQUE_PUSH_BACK d, 1
    EXPAND VEC_DEQUE_PUSH_FRONT d, 0
    EXPAND VEC_DEQUE_PUSH_BACK d, 2
    EXPAND VEC_DEQUE_TRY_POP_FRONT f_ok, f, d
    EXPAND VEC_DEQUE_TRY_POP_BACK b_ok, b, d
    EXPAND VEC_DEQUE_LEN ln, d
    EXPAND VEC_DEQUE_FREE d
    a = eq f_ok, 1
    b1 = eq f, 0
    c = eq b_ok, 1
    d1 = eq b, 2
    e = eq ln, 1
    ok01 = and a, b1
    ok02 = and ok01, c
    ok03 = and ok02, d1
    ok = and ok03, e
    !f_ok
    !f
    !b_ok
    !b
    !ln
    !a
    !b1
    !c
    !d1
    !e
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10924)
