@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_set.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"
@const KEY_DELTA = utf8:"delta"

@extract_len_five(&key: ptr) -> u64:
L_ENTRY:
    key_len = load key+Slice_len as u64
    take = eq key_len, 5
    !key_len
    !key
    return take

@extract_never(&key: ptr) -> u64:
L_ENTRY:
    !key
    return 0

@test "sa_std btree_set eager extract_if"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    delta = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7
    EXPAND SLICE_NEW delta, &KEY_DELTA, 5

    EXPAND BTREE_SET_NEW set
    EXPAND BTREE_SET_INSERT ins_delta, set, delta
    EXPAND BTREE_SET_INSERT ins_charlie, set, charlie
    EXPAND BTREE_SET_INSERT ins_alpha, set, alpha
    EXPAND BTREE_SET_INSERT ins_bravo, set, bravo
    EXPAND BTREE_SET_EXTRACT_IF remain_len, extracted, set, @extract_len_five

    EXPAND BTREE_SET_LEN source_len, set
    EXPAND BTREE_SET_LEN extracted_len, extracted
    EXPAND BTREE_SET_CONTAINS source_alpha, set, alpha
    EXPAND BTREE_SET_CONTAINS source_charlie, set, charlie
    EXPAND BTREE_SET_CONTAINS extracted_alpha, extracted, alpha
    EXPAND BTREE_SET_CONTAINS extracted_bravo, extracted, bravo
    EXPAND BTREE_SET_CONTAINS extracted_charlie, extracted, charlie
    EXPAND BTREE_SET_CONTAINS extracted_delta, extracted, delta
    EXPAND BTREE_SET_FIRST extracted_first_ok, extracted_first, extracted
    EXPAND BTREE_SET_LAST extracted_last_ok, extracted_last, extracted
    extracted_first_ptr = load extracted_first+Slice_ptr as ptr
    extracted_last_ptr = load extracted_last+Slice_ptr as ptr
    alpha_ptr = load alpha+Slice_ptr as ptr
    delta_ptr = load delta+Slice_ptr as ptr

    EXPAND BTREE_SET_EXTRACT_IF never_remain_len, never_extracted, set, @extract_never
    EXPAND BTREE_SET_LEN never_extracted_len, never_extracted
    EXPAND BTREE_SET_CONTAINS source_charlie_after_never, set, charlie

    EXPAND BTREE_SET_NEW empty_set
    EXPAND BTREE_SET_EXTRACT_IF empty_remain_len, empty_extracted, empty_set, @extract_len_five
    EXPAND BTREE_SET_LEN empty_extracted_len, empty_extracted

    ok_ins_delta = eq ins_delta, 1
    ok_ins_charlie = eq ins_charlie, 1
    ok_ins_alpha = eq ins_alpha, 1
    ok_ins_bravo = eq ins_bravo, 1
    ok_remain_len = eq remain_len, 1
    ok_source_len = eq source_len, 1
    ok_extracted_len = eq extracted_len, 3
    ok_source_alpha = eq source_alpha, 0
    ok_source_charlie = eq source_charlie, 1
    ok_extracted_alpha = eq extracted_alpha, 1
    ok_extracted_bravo = eq extracted_bravo, 1
    ok_extracted_charlie = eq extracted_charlie, 0
    ok_extracted_delta = eq extracted_delta, 1
    ok_first = eq extracted_first_ok, 1
    ok_first_ptr = eq extracted_first_ptr, alpha_ptr
    ok_last = eq extracted_last_ok, 1
    ok_last_ptr = eq extracted_last_ptr, delta_ptr
    ok_never_remain = eq never_remain_len, 1
    ok_never_extracted = eq never_extracted_len, 0
    ok_never_source = eq source_charlie_after_never, 1
    ok_empty_remain = eq empty_remain_len, 0
    ok_empty_extracted = eq empty_extracted_len, 0

    ok01 = and ok_ins_delta, ok_ins_charlie
    ok02 = and ok01, ok_ins_alpha
    ok03 = and ok02, ok_ins_bravo
    ok04 = and ok03, ok_remain_len
    ok05 = and ok04, ok_source_len
    ok06 = and ok05, ok_extracted_len
    ok07 = and ok06, ok_source_alpha
    ok08 = and ok07, ok_source_charlie
    ok09 = and ok08, ok_extracted_alpha
    ok10 = and ok09, ok_extracted_bravo
    ok11 = and ok10, ok_extracted_charlie
    ok12 = and ok11, ok_extracted_delta
    ok13 = and ok12, ok_first
    ok14 = and ok13, ok_first_ptr
    ok15 = and ok14, ok_last
    ok16 = and ok15, ok_last_ptr
    ok17 = and ok16, ok_never_remain
    ok18 = and ok17, ok_never_extracted
    ok19 = and ok18, ok_never_source
    ok20 = and ok19, ok_empty_remain
    ok = and ok20, ok_empty_extracted

    !ins_delta
    !ins_charlie
    !ins_alpha
    !ins_bravo
    !remain_len
    !source_len
    !extracted_len
    !source_alpha
    !source_charlie
    !extracted_alpha
    !extracted_bravo
    !extracted_charlie
    !extracted_delta
    !extracted_first_ok
    !extracted_last_ok
    !extracted_first_ptr
    !extracted_last_ptr
    !alpha_ptr
    !delta_ptr
    !never_remain_len
    !never_extracted_len
    !source_charlie_after_never
    !empty_remain_len
    !empty_extracted_len
    !ok_ins_delta
    !ok_ins_charlie
    !ok_ins_alpha
    !ok_ins_bravo
    !ok_remain_len
    !ok_source_len
    !ok_extracted_len
    !ok_source_alpha
    !ok_source_charlie
    !ok_extracted_alpha
    !ok_extracted_bravo
    !ok_extracted_charlie
    !ok_extracted_delta
    !ok_first
    !ok_first_ptr
    !ok_last
    !ok_last_ptr
    !ok_never_remain
    !ok_never_extracted
    !ok_never_source
    !ok_empty_remain
    !ok_empty_extracted
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !delta
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_SET_FREE empty_extracted
    EXPAND BTREE_SET_FREE empty_set
    EXPAND BTREE_SET_FREE never_extracted
    EXPAND BTREE_SET_FREE extracted
    EXPAND BTREE_SET_FREE set
    return 0

L_FAIL:
    panic(10817)
