@import "sa_std/collections/binary_heap.sars"

@binary_heap_into_iter_sorted_desc(left: u64, right: u64) -> u64:
L_ENTRY:
    out = uge left, right
    !right
    !left
    return out

@binary_heap_into_iter_sorted_strict_desc(left: u64, right: u64) -> u64:
L_ENTRY:
    out = ugt left, right
    !right
    !left
    return out

@binary_heap_into_iter_sorted_key_tens(value: u64) -> u64:
L_ENTRY:
    out = udiv value, 10
    !value
    return out

@binary_heap_into_iter_sorted_key_reverse_tens(value: u64) -> u64:
L_ENTRY:
    tens = udiv value, 10
    out = sub 100, tens
    !tens
    !value
    return out

@test "sa_std binary_heap into_iter_sorted sortedness macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW ascending_check_heap
    EXPAND BINARY_HEAP_PUSH_U64 ascending_check_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 ascending_check_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 ascending_check_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 ascending_check_iter, ascending_check_backing, ascending_check_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_U64 ascending_check_value, ascending_check_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 ascending_check_empty, ascending_check_iter

    EXPAND BINARY_HEAP_NEW single_heap
    EXPAND BINARY_HEAP_PUSH_U64 single_heap, 7
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 single_iter, single_backing, single_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_U64 single_sorted, single_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 single_empty, single_iter

    EXPAND BINARY_HEAP_NEW desc_heap
    EXPAND BINARY_HEAP_PUSH_U64 desc_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 desc_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 desc_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 desc_iter, desc_backing, desc_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_BY_U64 desc_value, desc_iter, @binary_heap_into_iter_sorted_desc
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 desc_empty, desc_iter

    EXPAND BINARY_HEAP_NEW strict_dup_heap
    EXPAND BINARY_HEAP_PUSH_U64 strict_dup_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 strict_dup_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 strict_dup_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 strict_dup_iter, strict_dup_backing, strict_dup_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_BY_U64 strict_dup_value, strict_dup_iter, @binary_heap_into_iter_sorted_strict_desc
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 strict_dup_empty, strict_dup_iter

    EXPAND BINARY_HEAP_NEW key_heap
    EXPAND BINARY_HEAP_PUSH_U64 key_heap, 14
    EXPAND BINARY_HEAP_PUSH_U64 key_heap, 23
    EXPAND BINARY_HEAP_PUSH_U64 key_heap, 31
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 key_iter, key_backing, key_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_BY_KEY_U64 key_value, key_iter, @binary_heap_into_iter_sorted_key_reverse_tens
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 key_empty, key_iter

    EXPAND BINARY_HEAP_NEW key_unsorted_heap
    EXPAND BINARY_HEAP_PUSH_U64 key_unsorted_heap, 34
    EXPAND BINARY_HEAP_PUSH_U64 key_unsorted_heap, 29
    EXPAND BINARY_HEAP_PUSH_U64 key_unsorted_heap, 11
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 key_unsorted_iter, key_unsorted_backing, key_unsorted_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_BY_KEY_U64 key_unsorted_value, key_unsorted_iter, @binary_heap_into_iter_sorted_key_tens
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 key_unsorted_empty, key_unsorted_iter

    EXPAND BINARY_HEAP_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_U64 empty_sorted, empty_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_SORTED_BY_U64 empty_sorted_by, empty_iter, @binary_heap_into_iter_sorted_strict_desc

    EXPAND VEC_FREE ascending_check_backing
    EXPAND VEC_FREE single_backing
    EXPAND VEC_FREE desc_backing
    EXPAND VEC_FREE strict_dup_backing
    EXPAND VEC_FREE key_backing
    EXPAND VEC_FREE key_unsorted_backing
    EXPAND VEC_FREE empty_backing

    ok_ascending_check = eq ascending_check_value, 0
    ok_ascending_check_empty = eq ascending_check_empty, 1
    ok_single_sorted = eq single_sorted, 1
    ok_single_empty = eq single_empty, 1
    ok_desc = eq desc_value, 1
    ok_desc_empty = eq desc_empty, 1
    ok_strict_dup = eq strict_dup_value, 0
    ok_strict_dup_empty = eq strict_dup_empty, 1
    ok_key = eq key_value, 1
    ok_key_empty = eq key_empty, 1
    ok_key_unsorted = eq key_unsorted_value, 0
    ok_key_unsorted_empty = eq key_unsorted_empty, 1
    ok_empty_sorted = eq empty_sorted, 1
    ok_empty_sorted_by = eq empty_sorted_by, 1

    ok = and ok_ascending_check, ok_ascending_check_empty
    ok = and ok, ok_single_sorted
    ok = and ok, ok_single_empty
    ok = and ok, ok_desc
    ok = and ok, ok_desc_empty
    ok = and ok, ok_strict_dup
    ok = and ok, ok_strict_dup_empty
    ok = and ok, ok_key
    ok = and ok, ok_key_empty
    ok = and ok, ok_key_unsorted
    ok = and ok, ok_key_unsorted_empty
    ok = and ok, ok_empty_sorted
    ok = and ok, ok_empty_sorted_by

    !ascending_check_value
    !ascending_check_empty
    !single_sorted
    !single_empty
    !desc_value
    !desc_empty
    !strict_dup_value
    !strict_dup_empty
    !key_value
    !key_empty
    !key_unsorted_value
    !key_unsorted_empty
    !empty_sorted
    !empty_sorted_by
    !ok_ascending_check
    !ok_ascending_check_empty
    !ok_single_sorted
    !ok_single_empty
    !ok_desc
    !ok_desc_empty
    !ok_strict_dup
    !ok_strict_dup_empty
    !ok_key
    !ok_key_empty
    !ok_key_unsorted
    !ok_key_unsorted_empty
    !ok_empty_sorted
    !ok_empty_sorted_by
    !ascending_check_iter
    !single_iter
    !desc_iter
    !strict_dup_iter
    !key_iter
    !key_unsorted_iter
    !empty_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_SORTED_SORTEDNESS_OK, L_BINARY_HEAP_INTO_ITER_SORTED_SORTEDNESS_FAIL

L_BINARY_HEAP_INTO_ITER_SORTED_SORTEDNESS_FAIL:
    !ok
    panic(10778)

L_BINARY_HEAP_INTO_ITER_SORTED_SORTEDNESS_OK:
    !ok
    return
