@import "sa_std/num.sars"

@test "sa_std narrow unsigned primitive multiples macro surface"():
L_ENTRY:
    EXPAND NUM_U8_IS_MULTIPLE_OF u8_multiple_yes, 42, 7
    EXPAND NUM_U8_IS_MULTIPLE_OF u8_multiple_no, 43, 7
    EXPAND NUM_U8_IS_MULTIPLE_OF u8_multiple_zero_zero, 0, 0
    EXPAND NUM_U8_IS_MULTIPLE_OF u8_multiple_nonzero_zero, 1, 0
    EXPAND NUM_U8_IS_MULTIPLE_OF u8_multiple_mask, 300, 11
    EXPAND NUM_U8_CHECKED_NEXT_MULTIPLE_OF u8_next_ok, u8_next_value, 43, 7
    EXPAND NUM_U8_CHECKED_NEXT_MULTIPLE_OF u8_next_aligned_ok, u8_next_aligned_value, 42, 7
    EXPAND NUM_U8_CHECKED_NEXT_MULTIPLE_OF u8_next_zero_ok, u8_next_zero_value, 42, 0
    EXPAND NUM_U8_CHECKED_NEXT_MULTIPLE_OF u8_next_over_ok, u8_next_over_value, 250, 8
    EXPAND NUM_U8_NEXT_MULTIPLE_OF u8_next_direct, 43, 7
    EXPAND NUM_U8_NEXT_MULTIPLE_OF u8_next_direct_over, 250, 8
    EXPAND NUM_U8_DIV_CEIL u8_div_ceil, 43, 7
    EXPAND NUM_U8_DIV_CEIL u8_div_ceil_mask, 300, 10

    EXPAND NUM_U16_IS_MULTIPLE_OF u16_multiple_yes, 42, 7
    EXPAND NUM_U16_IS_MULTIPLE_OF u16_multiple_no, 43, 7
    EXPAND NUM_U16_IS_MULTIPLE_OF u16_multiple_zero_zero, 0, 0
    EXPAND NUM_U16_IS_MULTIPLE_OF u16_multiple_nonzero_zero, 1, 0
    EXPAND NUM_U16_IS_MULTIPLE_OF u16_multiple_mask, 70000, 31
    EXPAND NUM_U16_CHECKED_NEXT_MULTIPLE_OF u16_next_ok, u16_next_value, 43, 7
    EXPAND NUM_U16_CHECKED_NEXT_MULTIPLE_OF u16_next_aligned_ok, u16_next_aligned_value, 42, 7
    EXPAND NUM_U16_CHECKED_NEXT_MULTIPLE_OF u16_next_zero_ok, u16_next_zero_value, 42, 0
    EXPAND NUM_U16_CHECKED_NEXT_MULTIPLE_OF u16_next_over_ok, u16_next_over_value, 65531, 10
    EXPAND NUM_U16_NEXT_MULTIPLE_OF u16_next_direct, 43, 7
    EXPAND NUM_U16_NEXT_MULTIPLE_OF u16_next_direct_over, 65531, 10
    EXPAND NUM_U16_DIV_CEIL u16_div_ceil, 43, 7
    EXPAND NUM_U16_DIV_CEIL u16_div_ceil_mask, 70000, 1000

    EXPAND NUM_U32_IS_MULTIPLE_OF u32_multiple_yes, 42, 7
    EXPAND NUM_U32_IS_MULTIPLE_OF u32_multiple_no, 43, 7
    EXPAND NUM_U32_IS_MULTIPLE_OF u32_multiple_zero_zero, 0, 0
    EXPAND NUM_U32_IS_MULTIPLE_OF u32_multiple_nonzero_zero, 1, 0
    EXPAND NUM_U32_IS_MULTIPLE_OF u32_multiple_mask, 4294967304, 8
    EXPAND NUM_U32_CHECKED_NEXT_MULTIPLE_OF u32_next_ok, u32_next_value, 43, 7
    EXPAND NUM_U32_CHECKED_NEXT_MULTIPLE_OF u32_next_aligned_ok, u32_next_aligned_value, 42, 7
    EXPAND NUM_U32_CHECKED_NEXT_MULTIPLE_OF u32_next_zero_ok, u32_next_zero_value, 42, 0
    EXPAND NUM_U32_CHECKED_NEXT_MULTIPLE_OF u32_next_over_ok, u32_next_over_value, 4294967291, 10
    EXPAND NUM_U32_NEXT_MULTIPLE_OF u32_next_direct, 43, 7
    EXPAND NUM_U32_NEXT_MULTIPLE_OF u32_next_direct_over, 4294967291, 10
    EXPAND NUM_U32_DIV_CEIL u32_div_ceil, 43, 7
    EXPAND NUM_U32_DIV_CEIL u32_div_ceil_mask, 4294967304, 3

    ok01 = eq u8_multiple_yes, 1
    ok02 = eq u8_multiple_no, 0
    ok03 = eq u8_multiple_zero_zero, 1
    ok04 = eq u8_multiple_nonzero_zero, 0
    ok05 = eq u8_multiple_mask, 1
    ok06 = eq u8_next_ok, 1
    ok07 = eq u8_next_value, 49
    ok08 = eq u8_next_aligned_ok, 1
    ok09 = eq u8_next_aligned_value, 42
    ok10 = eq u8_next_zero_ok, 0
    ok11 = eq u8_next_zero_value, 0
    ok12 = eq u8_next_over_ok, 0
    ok13 = eq u8_next_over_value, 0
    ok14 = eq u8_next_direct, 49
    ok15 = eq u8_next_direct_over, 0
    ok16 = eq u8_div_ceil, 7
    ok17 = eq u8_div_ceil_mask, 5

    ok18 = eq u16_multiple_yes, 1
    ok19 = eq u16_multiple_no, 0
    ok20 = eq u16_multiple_zero_zero, 1
    ok21 = eq u16_multiple_nonzero_zero, 0
    ok22 = eq u16_multiple_mask, 1
    ok23 = eq u16_next_ok, 1
    ok24 = eq u16_next_value, 49
    ok25 = eq u16_next_aligned_ok, 1
    ok26 = eq u16_next_aligned_value, 42
    ok27 = eq u16_next_zero_ok, 0
    ok28 = eq u16_next_zero_value, 0
    ok29 = eq u16_next_over_ok, 0
    ok30 = eq u16_next_over_value, 0
    ok31 = eq u16_next_direct, 49
    ok32 = eq u16_next_direct_over, 0
    ok33 = eq u16_div_ceil, 7
    ok34 = eq u16_div_ceil_mask, 5

    ok35 = eq u32_multiple_yes, 1
    ok36 = eq u32_multiple_no, 0
    ok37 = eq u32_multiple_zero_zero, 1
    ok38 = eq u32_multiple_nonzero_zero, 0
    ok39 = eq u32_multiple_mask, 1
    ok40 = eq u32_next_ok, 1
    ok41 = eq u32_next_value, 49
    ok42 = eq u32_next_aligned_ok, 1
    ok43 = eq u32_next_aligned_value, 42
    ok44 = eq u32_next_zero_ok, 0
    ok45 = eq u32_next_zero_value, 0
    ok46 = eq u32_next_over_ok, 0
    ok47 = eq u32_next_over_value, 0
    ok48 = eq u32_next_direct, 49
    ok49 = eq u32_next_direct_over, 0
    ok50 = eq u32_div_ceil, 7
    ok51 = eq u32_div_ceil_mask, 3

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    chain22 = and chain21, ok23
    chain23 = and chain22, ok24
    chain24 = and chain23, ok25
    chain25 = and chain24, ok26
    chain26 = and chain25, ok27
    chain27 = and chain26, ok28
    chain28 = and chain27, ok29
    chain29 = and chain28, ok30
    chain30 = and chain29, ok31
    chain31 = and chain30, ok32
    chain32 = and chain31, ok33
    chain33 = and chain32, ok34
    chain34 = and chain33, ok35
    chain35 = and chain34, ok36
    chain36 = and chain35, ok37
    chain37 = and chain36, ok38
    chain38 = and chain37, ok39
    chain39 = and chain38, ok40
    chain40 = and chain39, ok41
    chain41 = and chain40, ok42
    chain42 = and chain41, ok43
    chain43 = and chain42, ok44
    chain44 = and chain43, ok45
    chain45 = and chain44, ok46
    chain46 = and chain45, ok47
    chain47 = and chain46, ok48
    chain48 = and chain47, ok49
    chain49 = and chain48, ok50
    ok = and chain49, ok51

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10666)

L_PASS:
    !ok
    return 0
