@import "sa_std/collections.sal"

@test "sa_std collections TryReserveError layout constants"():
L_ENTRY:
    expected_kind_size = add 8, AllocLayout_SIZE
    ok_kind_size = eq TryReserveErrorKind_SIZE, expected_kind_size
    ok_kind_align = eq TryReserveErrorKind_ALIGN, AllocLayout_ALIGN
    ok_kind_tag = eq TryReserveErrorKind_kind, +0
    ok_kind_layout = eq TryReserveErrorKind_layout, +8
    ok_capacity = eq TRY_RESERVE_ERROR_CAPACITY_OVERFLOW, 0
    ok_alloc = eq TRY_RESERVE_ERROR_ALLOC_ERROR, 1

    ok_error_size = eq TryReserveError_SIZE, TryReserveErrorKind_SIZE
    ok_error_align = eq TryReserveError_ALIGN, TryReserveErrorKind_ALIGN
    ok_error_tag = eq TryReserveError_kind, TryReserveErrorKind_kind
    ok_error_layout = eq TryReserveError_layout, TryReserveErrorKind_layout

    c01 = and ok_kind_size, ok_kind_align
    c02 = and c01, ok_kind_tag
    c03 = and c02, ok_kind_layout
    c04 = and c03, ok_capacity
    c05 = and c04, ok_alloc
    c06 = and c05, ok_error_size
    c07 = and c06, ok_error_align
    c08 = and c07, ok_error_tag
    ok = and c08, ok_error_layout

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10504)

L_PASS:
    return 0
