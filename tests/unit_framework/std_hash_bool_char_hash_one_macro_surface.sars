@import "sa_std/hash.sars"

@test "sa_std hash bool char hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    state = stack_alloc RandomState_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22

    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_BOOL build_true, builder, 1
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_BOOL build_false, builder, 0
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_BOOL build_nonzero, builder, 99
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_CHAR build_char, builder, 937

    EXPAND HASH_BOOL hash_true, 1
    EXPAND HASH_BOOL hash_false, 0
    EXPAND HASH_BOOL hash_nonzero, 99
    EXPAND HASH_CHAR hash_char, 937

    EXPAND RANDOM_STATE_HASH_ONE_BOOL state_true, state, 1
    EXPAND RANDOM_STATE_HASH_ONE_BOOL state_false, state, 0
    EXPAND RANDOM_STATE_HASH_ONE_BOOL state_nonzero, state, 99
    EXPAND RANDOM_STATE_HASH_ONE_CHAR state_char, state, 937

    manual_true_hasher = stack_alloc DefaultHasher_SIZE
    manual_false_hasher = stack_alloc DefaultHasher_SIZE
    manual_char_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND RANDOM_STATE_BUILD manual_true_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_BOOL manual_true_hasher, 1
    EXPAND DEFAULT_HASHER_FINISH manual_true, manual_true_hasher

    EXPAND RANDOM_STATE_BUILD manual_false_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_BOOL manual_false_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH manual_false, manual_false_hasher

    EXPAND RANDOM_STATE_BUILD manual_char_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_CHAR manual_char_hasher, 937
    EXPAND DEFAULT_HASHER_FINISH manual_char, manual_char_hasher

    build_true_ok = eq build_true, hash_true
    build_false_ok = eq build_false, hash_false
    build_nonzero_ok = eq build_nonzero, hash_nonzero
    build_nonzero_normalized = eq build_nonzero, build_true
    build_bool_diff = ne build_true, build_false
    build_char_ok = eq build_char, hash_char

    state_true_ok = eq state_true, manual_true
    state_false_ok = eq state_false, manual_false
    state_nonzero_normalized = eq state_nonzero, state_true
    state_bool_diff = ne state_true, state_false
    state_char_ok = eq state_char, manual_char
    seeded_changes = ne state_char, hash_char

    c01 = and build_true_ok, build_false_ok
    c02 = and c01, build_nonzero_ok
    c03 = and c02, build_nonzero_normalized
    c04 = and c03, build_bool_diff
    c05 = and c04, build_char_ok
    c06 = and c05, state_true_ok
    c07 = and c06, state_false_ok
    c08 = and c07, state_nonzero_normalized
    c09 = and c08, state_bool_diff
    c10 = and c09, state_char_ok
    ok = and c10, seeded_changes

    !builder
    !build_true
    !build_false
    !build_nonzero
    !build_char
    !hash_true
    !hash_false
    !hash_nonzero
    !hash_char
    !state_true
    !state_false
    !state_nonzero
    !state_char
    !manual_true
    !manual_false
    !manual_char
    !build_true_ok
    !build_false_ok
    !build_nonzero_ok
    !build_nonzero_normalized
    !build_bool_diff
    !build_char_ok
    !state_true_ok
    !state_false_ok
    !state_nonzero_normalized
    !state_bool_diff
    !state_char_ok
    !seeded_changes
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10562)

L_PASS:
    !ok
    return 0
