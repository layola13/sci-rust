@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const S = utf8:"abc"

@test "sa_std str byte_at alias"():
L_ENTRY:
    EXPAND STR_FROM_PARTS s, &S, 3
    EXPAND STR_BYTE_AT ok, b, s, 1
    EXPAND STR_BYTE_AT miss, m, s, 9
    a = eq ok, 1
    b1 = eq b, 98
    c = eq miss, 0
    ok01 = and a, b1
    ok_all = and ok01, c
    !ok
    !b
    !miss
    !m
    !a
    !b1
    !c
    !ok01
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(10902)
