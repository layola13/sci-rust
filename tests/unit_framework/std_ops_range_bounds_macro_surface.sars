@import "sa_std/ops.sars"

@test "sa_std ops RangeBounds concrete macros"():
L_ENTRY:
    range = stack_alloc RangeU64_SIZE
    range_from = stack_alloc RangeFromU64_SIZE
    range_to = stack_alloc RangeToU64_SIZE
    range_inc = stack_alloc RangeInclusiveU64_SIZE
    range_to_inc = stack_alloc RangeToInclusiveU64_SIZE
    range_usize = stack_alloc RangeUsize_SIZE
    range_inc_usize = stack_alloc RangeInclusiveUsize_SIZE

    start_bound = stack_alloc BoundU64_SIZE
    end_bound = stack_alloc BoundU64_SIZE
    exhausted_end_bound = stack_alloc BoundU64_SIZE
    other_start = stack_alloc BoundU64_SIZE
    other_end = stack_alloc BoundU64_SIZE
    start_bound_usize = stack_alloc BoundUsize_SIZE
    end_bound_usize = stack_alloc BoundUsize_SIZE

    EXPAND RANGE_U64_NEW range, 2, 7
    EXPAND RANGE_FROM_U64_NEW range_from, 4
    EXPAND RANGE_TO_U64_NEW range_to, 9
    EXPAND RANGE_INCLUSIVE_U64_NEW range_inc, 11, 13
    EXPAND RANGE_TO_INCLUSIVE_U64_NEW range_to_inc, 15
    EXPAND RANGE_USIZE_NEW range_usize, 21, 25
    EXPAND RANGE_INCLUSIVE_USIZE_NEW range_inc_usize, 31, 33

    EXPAND RANGE_U64_INTO_BOUNDS start_bound, end_bound, range
    EXPAND BOUND_U64_TAG range_start_tag, start_bound
    EXPAND BOUND_U64_VALUE range_start_value, start_bound
    EXPAND BOUND_U64_TAG range_end_tag, end_bound
    EXPAND BOUND_U64_VALUE range_end_value, end_bound

    EXPAND RANGE_FROM_U64_INTO_BOUNDS start_bound, end_bound, range_from
    EXPAND BOUND_U64_TAG from_start_tag, start_bound
    EXPAND BOUND_U64_VALUE from_start_value, start_bound
    EXPAND BOUND_U64_TAG from_end_tag, end_bound

    EXPAND RANGE_TO_U64_INTO_BOUNDS start_bound, end_bound, range_to
    EXPAND BOUND_U64_TAG to_start_tag, start_bound
    EXPAND BOUND_U64_TAG to_end_tag, end_bound
    EXPAND BOUND_U64_VALUE to_end_value, end_bound

    EXPAND RANGE_INCLUSIVE_U64_INTO_BOUNDS start_bound, end_bound, range_inc
    EXPAND BOUND_U64_TAG inc_start_tag, start_bound
    EXPAND BOUND_U64_VALUE inc_start_value, start_bound
    EXPAND BOUND_U64_TAG inc_end_tag, end_bound
    EXPAND BOUND_U64_VALUE inc_end_value, end_bound
    EXPAND RANGE_INCLUSIVE_U64_SET_EXHAUSTED range_inc, 1
    EXPAND RANGE_INCLUSIVE_U64_END_BOUND exhausted_end_bound, range_inc
    EXPAND BOUND_U64_TAG inc_exhausted_end_tag, exhausted_end_bound
    EXPAND BOUND_U64_VALUE inc_exhausted_end_value, exhausted_end_bound

    EXPAND RANGE_TO_INCLUSIVE_U64_INTO_BOUNDS start_bound, end_bound, range_to_inc
    EXPAND BOUND_U64_TAG to_inc_start_tag, start_bound
    EXPAND BOUND_U64_TAG to_inc_end_tag, end_bound
    EXPAND BOUND_U64_VALUE to_inc_end_value, end_bound

    EXPAND RANGE_FULL_INTO_BOUNDS_U64 other_start, other_end
    EXPAND BOUND_U64_TAG full_start_tag, other_start
    EXPAND BOUND_U64_TAG full_end_tag, other_end

    EXPAND RANGE_USIZE_INTO_BOUNDS start_bound_usize, end_bound_usize, range_usize
    EXPAND BOUND_USIZE_TAG usize_start_tag, start_bound_usize
    EXPAND BOUND_USIZE_VALUE usize_start_value, start_bound_usize
    EXPAND BOUND_USIZE_TAG usize_end_tag, end_bound_usize
    EXPAND BOUND_USIZE_VALUE usize_end_value, end_bound_usize

    EXPAND RANGE_INCLUSIVE_USIZE_SET_EXHAUSTED range_inc_usize, 1
    EXPAND RANGE_INCLUSIVE_USIZE_INTO_BOUNDS start_bound_usize, end_bound_usize, range_inc_usize
    EXPAND BOUND_USIZE_TAG usize_inc_start_tag, start_bound_usize
    EXPAND BOUND_USIZE_VALUE usize_inc_start_value, start_bound_usize
    EXPAND BOUND_USIZE_TAG usize_inc_end_tag, end_bound_usize
    EXPAND BOUND_USIZE_VALUE usize_inc_end_value, end_bound_usize

    ok_range_start = eq range_start_tag, BOUND_U64_INCLUDED
    ok_range_start_value = eq range_start_value, 2
    ok_range_end = eq range_end_tag, BOUND_U64_EXCLUDED
    ok_range_end_value = eq range_end_value, 7
    ok_from_start = eq from_start_tag, BOUND_U64_INCLUDED
    ok_from_start_value = eq from_start_value, 4
    ok_from_end = eq from_end_tag, BOUND_U64_UNBOUNDED
    ok_to_start = eq to_start_tag, BOUND_U64_UNBOUNDED
    ok_to_end = eq to_end_tag, BOUND_U64_EXCLUDED
    ok_to_end_value = eq to_end_value, 9
    ok_inc_start = eq inc_start_tag, BOUND_U64_INCLUDED
    ok_inc_start_value = eq inc_start_value, 11
    ok_inc_end = eq inc_end_tag, BOUND_U64_INCLUDED
    ok_inc_end_value = eq inc_end_value, 13
    ok_inc_exhausted_end = eq inc_exhausted_end_tag, BOUND_U64_EXCLUDED
    ok_inc_exhausted_value = eq inc_exhausted_end_value, 13
    ok_to_inc_start = eq to_inc_start_tag, BOUND_U64_UNBOUNDED
    ok_to_inc_end = eq to_inc_end_tag, BOUND_U64_INCLUDED
    ok_to_inc_value = eq to_inc_end_value, 15
    ok_full_start = eq full_start_tag, BOUND_U64_UNBOUNDED
    ok_full_end = eq full_end_tag, BOUND_U64_UNBOUNDED
    ok_usize_start = eq usize_start_tag, BOUND_USIZE_INCLUDED
    ok_usize_start_value = eq usize_start_value, 21
    ok_usize_end = eq usize_end_tag, BOUND_USIZE_EXCLUDED
    ok_usize_end_value = eq usize_end_value, 25
    ok_usize_inc_start = eq usize_inc_start_tag, BOUND_USIZE_INCLUDED
    ok_usize_inc_start_value = eq usize_inc_start_value, 31
    ok_usize_inc_end = eq usize_inc_end_tag, BOUND_USIZE_EXCLUDED
    ok_usize_inc_end_value = eq usize_inc_end_value, 33

    c01 = and ok_range_start, ok_range_start_value
    c02 = and c01, ok_range_end
    c03 = and c02, ok_range_end_value
    c04 = and c03, ok_from_start
    c05 = and c04, ok_from_start_value
    c06 = and c05, ok_from_end
    c07 = and c06, ok_to_start
    c08 = and c07, ok_to_end
    c09 = and c08, ok_to_end_value
    c10 = and c09, ok_inc_start
    c11 = and c10, ok_inc_start_value
    c12 = and c11, ok_inc_end
    c13 = and c12, ok_inc_end_value
    c14 = and c13, ok_inc_exhausted_end
    c15 = and c14, ok_inc_exhausted_value
    c16 = and c15, ok_to_inc_start
    c17 = and c16, ok_to_inc_end
    c18 = and c17, ok_to_inc_value
    c19 = and c18, ok_full_start
    c20 = and c19, ok_full_end
    c21 = and c20, ok_usize_start
    c22 = and c21, ok_usize_start_value
    c23 = and c22, ok_usize_end
    c24 = and c23, ok_usize_end_value
    c25 = and c24, ok_usize_inc_start
    c26 = and c25, ok_usize_inc_start_value
    c27 = and c26, ok_usize_inc_end
    ok = and c27, ok_usize_inc_end_value

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10511)

L_PASS:
    return 0
