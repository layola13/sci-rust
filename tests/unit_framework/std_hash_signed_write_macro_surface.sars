@import "sa_std/hash.sars"

@test "sa_std hash signed write macro surface"():
L_ENTRY:
    signed_hasher = stack_alloc DefaultHasher_SIZE
    unsigned_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW signed_hasher
    EXPAND DEFAULT_HASHER_NEW unsigned_hasher

    EXPAND DEFAULT_HASHER_WRITE_I8 signed_hasher, 7
    EXPAND DEFAULT_HASHER_WRITE_I16 signed_hasher, 300
    EXPAND DEFAULT_HASHER_WRITE_I32 signed_hasher, 70000
    EXPAND DEFAULT_HASHER_WRITE_I64 signed_hasher, 9000000
    EXPAND DEFAULT_HASHER_WRITE_ISIZE signed_hasher, 11
    EXPAND DEFAULT_HASHER_FINISH signed_hash, signed_hasher

    EXPAND DEFAULT_HASHER_WRITE_U8 unsigned_hasher, 7
    EXPAND DEFAULT_HASHER_WRITE_U16 unsigned_hasher, 300
    EXPAND DEFAULT_HASHER_WRITE_U32 unsigned_hasher, 70000
    EXPAND DEFAULT_HASHER_WRITE_U64 unsigned_hasher, 9000000
    EXPAND DEFAULT_HASHER_WRITE_USIZE unsigned_hasher, 11
    EXPAND DEFAULT_HASHER_FINISH unsigned_hash, unsigned_hasher

    ok_same = eq signed_hash, unsigned_hash
    ok_changed = ne signed_hash, HASHER_DEFAULT_SEED
    ok = and ok_same, ok_changed

    !signed_hash
    !unsigned_hash
    !ok_same
    !ok_changed
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10530)

L_PASS:
    !ok
    return 0
