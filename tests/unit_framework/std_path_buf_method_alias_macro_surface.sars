@import "sa_std/path.sars"
@import "sa_std/string.sars"
@import "sa_std/os/unix_ffi.sars"

// Thin PathBuf method/alias macros not covered by a dedicated surface file:
// DEFAULT, FROM_STR, AS_STR, TRY_WITH_CAPACITY, RESERVE, JOIN_PATH_BUF,
// TRY_COMPONENT_AT, TRY_ANCESTOR_AT, INTO_OS_STRING_MOVE.

@const PB_ALIAS_FULL = utf8:"/tmp/demo/file.txt"
@const PB_ALIAS_ROOT = utf8:"/"
@const PB_ALIAS_CHILD = utf8:"child"
@const PB_ALIAS_EXPECT_JOINED = utf8:"/child"
@const PB_ALIAS_EXPECT_TMP = utf8:"tmp"
@const PB_ALIAS_EXPECT_DEMO = utf8:"demo"
@const PB_ALIAS_EXPECT_FILE = utf8:"file.txt"
@const PB_ALIAS_EXPECT_PARENT = utf8:"/tmp/demo"
@const PB_ALIAS_EXPECT_GP = utf8:"/tmp"

@test "sa_std path PathBuf method alias macro surface"():
L_ENTRY:
    EXPAND STR_FROM_PARTS full, &PB_ALIAS_FULL, 18
    EXPAND STR_FROM_PARTS root, &PB_ALIAS_ROOT, 1
    EXPAND STR_FROM_PARTS child, &PB_ALIAS_CHILD, 5
    EXPAND STR_FROM_PARTS expect_joined, &PB_ALIAS_EXPECT_JOINED, 6
    EXPAND STR_FROM_PARTS expect_tmp, &PB_ALIAS_EXPECT_TMP, 3
    EXPAND STR_FROM_PARTS expect_demo, &PB_ALIAS_EXPECT_DEMO, 4
    EXPAND STR_FROM_PARTS expect_file, &PB_ALIAS_EXPECT_FILE, 8
    EXPAND STR_FROM_PARTS expect_parent, &PB_ALIAS_EXPECT_PARENT, 9
    EXPAND STR_FROM_PARTS expect_gp, &PB_ALIAS_EXPECT_GP, 4

    // PATH_BUF_DEFAULT / NEW-equivalent empty buffer
    EXPAND PATH_BUF_DEFAULT def_buf
    EXPAND PATH_BUF_IS_EMPTY def_empty, def_buf
    EXPAND PATH_BUF_LEN def_len, def_buf
    ok_def_empty = eq def_empty, 1
    ok_def_len = eq def_len, 0

    // PATH_BUF_FROM_STR + PATH_BUF_AS_STR (thin aliases of FROM_PATH / AS_PATH)
    EXPAND PATH_BUF_FROM_STR from_str_buf, full
    EXPAND PATH_BUF_AS_STR as_str_view, from_str_buf
    EXPAND STR_EQ as_str_eq, as_str_view, full
    EXPAND PATH_BUF_LEN from_str_len, from_str_buf
    ok_as_str = eq as_str_eq, 1
    ok_from_str_len = eq from_str_len, 18
    !as_str_view

    // PATH_BUF_TRY_WITH_CAPACITY + PATH_BUF_RESERVE
    EXPAND PATH_BUF_TRY_WITH_CAPACITY try_ok, try_buf, 32
    EXPAND PATH_BUF_CAPACITY try_cap0, try_buf
    EXPAND PATH_BUF_RESERVE try_buf, 64
    EXPAND PATH_BUF_CAPACITY try_cap1, try_buf
    ok_try = eq try_ok, 1
    ok_try_cap0 = uge try_cap0, 32
    ok_try_cap1 = uge try_cap1, try_cap0

    // PATH_BUF_JOIN_PATH_BUF (alias of PUSH_PATH_BUF)
    EXPAND PATH_BUF_FROM_PATH join_parent, root
    EXPAND PATH_BUF_FROM_PATH join_child, child
    EXPAND PATH_BUF_JOIN_PATH_BUF join_parent, join_child
    EXPAND PATH_BUF_AS_PATH join_view, join_parent
    EXPAND STR_EQ join_eq, join_view, expect_joined
    ok_join = eq join_eq, 1
    !join_view

    // PATH_BUF_TRY_COMPONENT_AT — /tmp/demo/file.txt -> [tmp, demo, file.txt]
    EXPAND PATH_BUF_FROM_PATH comp_buf, full
    EXPAND PATH_BUF_TRY_COMPONENT_AT c0_ok, c0, comp_buf, 0
    EXPAND PATH_BUF_TRY_COMPONENT_AT c1_ok, c1, comp_buf, 1
    EXPAND PATH_BUF_TRY_COMPONENT_AT c2_ok, c2, comp_buf, 2
    EXPAND PATH_BUF_TRY_COMPONENT_AT c3_ok, c3, comp_buf, 3
    EXPAND STR_EQ c0_eq, c0, expect_tmp
    EXPAND STR_EQ c1_eq, c1, expect_demo
    EXPAND STR_EQ c2_eq, c2, expect_file
    EXPAND STR_IS_EMPTY c3_empty, c3
    ok_c0 = eq c0_ok, 1
    ok_c1 = eq c1_ok, 1
    ok_c2 = eq c2_ok, 1
    ok_c3 = eq c3_ok, 0
    ok_c0_eq = eq c0_eq, 1
    ok_c1_eq = eq c1_eq, 1
    ok_c2_eq = eq c2_eq, 1
    ok_c3_empty = eq c3_empty, 1
    !c0
    !c1
    !c2
    !c3

    // PATH_BUF_TRY_ANCESTOR_AT — a0=full, a1=/tmp/demo, a2=/tmp, a3=/, a4=miss
    EXPAND PATH_BUF_TRY_ANCESTOR_AT a0_ok, a0, comp_buf, 0
    EXPAND PATH_BUF_TRY_ANCESTOR_AT a1_ok, a1, comp_buf, 1
    EXPAND PATH_BUF_TRY_ANCESTOR_AT a2_ok, a2, comp_buf, 2
    EXPAND PATH_BUF_TRY_ANCESTOR_AT a3_ok, a3, comp_buf, 3
    EXPAND PATH_BUF_TRY_ANCESTOR_AT a4_ok, a4, comp_buf, 4
    EXPAND STR_EQ a0_eq, a0, full
    EXPAND STR_EQ a1_eq, a1, expect_parent
    EXPAND STR_EQ a2_eq, a2, expect_gp
    EXPAND STR_EQ a3_eq, a3, root
    EXPAND STR_IS_EMPTY a4_empty, a4
    ok_a0 = eq a0_ok, 1
    ok_a1 = eq a1_ok, 1
    ok_a2 = eq a2_ok, 1
    ok_a3 = eq a3_ok, 1
    ok_a4 = eq a4_ok, 0
    ok_a0_eq = eq a0_eq, 1
    ok_a1_eq = eq a1_eq, 1
    ok_a2_eq = eq a2_eq, 1
    ok_a3_eq = eq a3_eq, 1
    ok_a4_empty = eq a4_empty, 1
    !a0
    !a1
    !a2
    !a3
    !a4

    // PATH_BUF_INTO_OS_STRING_MOVE frees the PathBuf after conversion
    EXPAND PATH_BUF_FROM_STR move_buf, full
    EXPAND PATH_BUF_INTO_OS_STRING_MOVE moved_os, move_buf
    EXPAND OS_STRING_LEN moved_len, moved_os
    ok_moved_len = eq moved_len, 18

    ok01 = and ok_def_empty, ok_def_len
    ok02 = and ok01, ok_as_str
    ok03 = and ok02, ok_from_str_len
    ok04 = and ok03, ok_try
    ok05 = and ok04, ok_try_cap0
    ok06 = and ok05, ok_try_cap1
    ok07 = and ok06, ok_join
    ok08 = and ok07, ok_c0
    ok09 = and ok08, ok_c0_eq
    ok10 = and ok09, ok_c1
    ok11 = and ok10, ok_c1_eq
    ok12 = and ok11, ok_c2
    ok13 = and ok12, ok_c2_eq
    ok14 = and ok13, ok_c3
    ok15 = and ok14, ok_c3_empty
    ok16 = and ok15, ok_a0
    ok17 = and ok16, ok_a0_eq
    ok18 = and ok17, ok_a1
    ok19 = and ok18, ok_a1_eq
    ok20 = and ok19, ok_a2
    ok21 = and ok20, ok_a2_eq
    ok22 = and ok21, ok_a3
    ok23 = and ok22, ok_a3_eq
    ok24 = and ok23, ok_a4
    ok25 = and ok24, ok_a4_empty
    ok = and ok25, ok_moved_len

    !def_empty
    !def_len
    !as_str_eq
    !from_str_len
    !try_ok
    !try_cap0
    !try_cap1
    !join_eq
    !c0_ok
    !c1_ok
    !c2_ok
    !c3_ok
    !c0_eq
    !c1_eq
    !c2_eq
    !c3_empty
    !a0_ok
    !a1_ok
    !a2_ok
    !a3_ok
    !a4_ok
    !a0_eq
    !a1_eq
    !a2_eq
    !a3_eq
    !a4_empty
    !moved_len
    !ok_def_empty
    !ok_def_len
    !ok_as_str
    !ok_from_str_len
    !ok_try
    !ok_try_cap0
    !ok_try_cap1
    !ok_join
    !ok_c0
    !ok_c0_eq
    !ok_c1
    !ok_c1_eq
    !ok_c2
    !ok_c2_eq
    !ok_c3
    !ok_c3_empty
    !ok_a0
    !ok_a0_eq
    !ok_a1
    !ok_a1_eq
    !ok_a2
    !ok_a2_eq
    !ok_a3
    !ok_a3_eq
    !ok_a4
    !ok_a4_empty
    !ok_moved_len
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25

    EXPAND PATH_BUF_FREE def_buf
    EXPAND PATH_BUF_FREE from_str_buf
    EXPAND PATH_BUF_FREE try_buf
    EXPAND PATH_BUF_FREE join_parent
    EXPAND PATH_BUF_FREE join_child
    EXPAND PATH_BUF_FREE comp_buf
    EXPAND OS_STRING_FREE moved_os
    !full
    !root
    !child
    !expect_joined
    !expect_tmp
    !expect_demo
    !expect_file
    !expect_parent
    !expect_gp
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10857)

L_OK:
    !ok
    return
