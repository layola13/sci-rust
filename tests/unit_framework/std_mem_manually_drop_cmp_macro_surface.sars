@import "sa_std/mem.sars"

@test "sa_std ManuallyDrop comparison macro surface"():
L_ENTRY:
    left = stack_alloc ManuallyDropU64_SIZE
    same = stack_alloc ManuallyDropU64_SIZE
    greater = stack_alloc ManuallyDropU64_SIZE
    EXPAND MANUALLY_DROP_U64_NEW left, 11
    EXPAND MANUALLY_DROP_U64_NEW same, 11
    EXPAND MANUALLY_DROP_U64_NEW greater, 13

    EXPAND MANUALLY_DROP_U64_EQ eq_same, left, same
    EXPAND MANUALLY_DROP_U64_EQ eq_greater, left, greater
    EXPAND MANUALLY_DROP_U64_NE ne_same, left, same
    EXPAND MANUALLY_DROP_U64_NE ne_greater, left, greater
    EXPAND MANUALLY_DROP_U64_CMP cmp_less, left, greater
    EXPAND MANUALLY_DROP_U64_CMP cmp_equal, left, same
    EXPAND MANUALLY_DROP_U64_CMP cmp_greater, greater, left
    EXPAND MANUALLY_DROP_U64_PARTIAL_CMP partial_cmp_less, left, greater
    EXPAND MANUALLY_DROP_U64_LT lt_less, left, greater
    EXPAND MANUALLY_DROP_U64_LE le_equal, left, same
    EXPAND MANUALLY_DROP_U64_GT gt_greater, greater, left
    EXPAND MANUALLY_DROP_U64_GE ge_equal, left, same

    EXPAND MANUALLY_DROP_U64_AS_MUT_PTR same_mut_ptr, same
    store same_mut_ptr+0, 15 as u64
    EXPAND MANUALLY_DROP_U64_EQ eq_after_change, left, same
    EXPAND MANUALLY_DROP_U64_CMP cmp_after_change, left, same

    ok_eq_same = eq eq_same, 1
    ok_eq_greater = eq eq_greater, 0
    ok_ne_same = eq ne_same, 0
    ok_ne_greater = eq ne_greater, 1
    ok_cmp_less = eq cmp_less, CMP_ORDERING_LESS
    ok_cmp_equal = eq cmp_equal, CMP_ORDERING_EQUAL
    ok_cmp_greater = eq cmp_greater, CMP_ORDERING_GREATER
    ok_partial = eq partial_cmp_less, CMP_ORDERING_LESS
    ok_lt = eq lt_less, 1
    ok_le = eq le_equal, 1
    ok_gt = eq gt_greater, 1
    ok_ge = eq ge_equal, 1
    ok_changed_eq = eq eq_after_change, 0
    ok_changed_cmp = eq cmp_after_change, CMP_ORDERING_LESS

    c01 = and ok_eq_same, ok_eq_greater
    c02 = and c01, ok_ne_same
    c03 = and c02, ok_ne_greater
    c04 = and c03, ok_cmp_less
    c05 = and c04, ok_cmp_equal
    c06 = and c05, ok_cmp_greater
    c07 = and c06, ok_partial
    c08 = and c07, ok_lt
    c09 = and c08, ok_le
    c10 = and c09, ok_gt
    c11 = and c10, ok_ge
    c12 = and c11, ok_changed_eq
    ok = and c12, ok_changed_cmp

    !eq_same
    !eq_greater
    !ne_same
    !ne_greater
    !cmp_less
    !cmp_equal
    !cmp_greater
    !partial_cmp_less
    !lt_less
    !le_equal
    !gt_greater
    !ge_equal
    !same_mut_ptr
    !eq_after_change
    !cmp_after_change
    !ok_eq_same
    !ok_eq_greater
    !ok_ne_same
    !ok_ne_greater
    !ok_cmp_less
    !ok_cmp_equal
    !ok_cmp_greater
    !ok_partial
    !ok_lt
    !ok_le
    !ok_gt
    !ok_ge
    !ok_changed_eq
    !ok_changed_cmp
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10599)

L_PASS:
    !ok
    return 0
