@import "sa_std/path.sars"
@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const BASE = utf8:"/tmp/sa"
@const CHILD = utf8:"child"

@test "sa_std path parent and join"():
L_ENTRY:
    EXPAND STR_FROM_PARTS base, &BASE, 7
    EXPAND STR_FROM_PARTS child, &CHILD, 5
    EXPAND PATH_JOIN joined, base, child
    EXPAND PATH_PARENT parent, joined
    EXPAND PATH_FILE_NAME name, joined
    EXPAND SLICE_GET_LEN jlen, joined
    EXPAND SLICE_GET_LEN nlen, name
    a = eq jlen, 13
    b = eq nlen, 5
    ok = and a, b
    !jlen
    !nlen
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10918)
