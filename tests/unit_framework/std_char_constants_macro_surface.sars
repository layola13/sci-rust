@import "sa_std/char.sal"
@import "sa_std/mem.sal"

@test "sa_std char associated constants and layout"():
L_ENTRY:
    ok_size = eq CHAR_SIZE, 4
    ok_align = eq CHAR_ALIGN, 4
    ok_size_mem = eq CHAR_SIZE, MEM_SIZE_CHAR
    ok_align_mem = eq CHAR_ALIGN, MEM_ALIGN_CHAR

    ok_min = eq CHAR_MIN, 0
    ok_max = eq CHAR_MAX, 1114111
    ok_default = eq CHAR_DEFAULT, CHAR_MIN
    ok_replacement = eq CHAR_REPLACEMENT_CHARACTER, 65533
    ok_replacement_alias = eq CHAR_REPLACEMENT_CHARACTER, CHAR_REPLACEMENT
    ok_utf8_len = eq CHAR_MAX_LEN_UTF8, 4
    ok_utf16_len = eq CHAR_MAX_LEN_UTF16, 2

    c01 = and ok_size, ok_align
    c02 = and c01, ok_size_mem
    c03 = and c02, ok_align_mem
    c04 = and c03, ok_min
    c05 = and c04, ok_max
    c06 = and c05, ok_default
    c07 = and c06, ok_replacement
    c08 = and c07, ok_replacement_alias
    c09 = and c08, ok_utf8_len
    ok = and c09, ok_utf16_len

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10491)

L_PASS:
    return 0
