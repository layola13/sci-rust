@import "sa_std/thread.sars"

@const JOIN_HANDLE_WORKER_VT = vtable { call = @join_handle_worker }

#def JoinHandleWorkerSlot_SIZE = 8
#def JoinHandleWorkerSlot_value = +0

@join_handle_worker(&slot: ptr) -> i32:
L_ENTRY:
    value = load slot+JoinHandleWorkerSlot_value as i32
    result = add value, 13
    store slot+JoinHandleWorkerSlot_value, result as i32
    !value
    !slot
    return result

@ffi_wrapper join_handle_spawn_worker(*slot: ptr) -> i32:
L_ENTRY:
    worker_vt = &JOIN_HANDLE_WORKER_VT
    worker_fn = load worker_vt+0 as ptr
    worker_safe = assume_safe worker_fn
    EXPAND THREAD_SPAWN handle, *worker_safe, *slot
    !worker_vt
    !worker_fn
    !worker_safe
    !slot
    return handle

@test "sa_std join handle zero raw state is finished"():
L_ENTRY:
    EXPAND JOIN_HANDLE_NEW handle, 0
    EXPAND JOIN_HANDLE_IS_FINISHED done0, handle
    EXPAND JOIN_HANDLE_NEW dropped_handle, 0
    EXPAND JOIN_HANDLE_IS_FINISHED done1, dropped_handle
    EXPAND JOIN_HANDLE_DROP dropped_handle
    ok0 = eq done0, 1
    ok1 = eq done1, 1
    ok = and ok0, ok1
    !handle
    !done0
    !done1
    !ok0
    !ok1
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10992)

@test "sa_std join handle repeated join caches result"():
L_ENTRY:
    slot = alloc JoinHandleWorkerSlot_SIZE
    store slot+JoinHandleWorkerSlot_value, 29 as i32
    raw_handle = call @join_handle_spawn_worker(*slot)
    EXPAND JOIN_HANDLE_NEW handle, raw_handle
    first_out = stack_alloc 4
    EXPAND JOIN_HANDLE_JOIN_STATUS first_status, handle, first_out
    first_result = load first_out+0 as i32
    second_out = stack_alloc 4
    store second_out+0, 0 as i32
    EXPAND JOIN_HANDLE_JOIN_STATUS second_status, handle, second_out
    second_result = load second_out+0 as i32
    EXPAND JOIN_HANDLE_IS_FINISHED done, handle
    EXPAND JOIN_HANDLE_RESULT_STATUS cached_status, handle
    slot_value = load slot+JoinHandleWorkerSlot_value as i32

    raw_ok = ne raw_handle, 0
    first_ok = eq first_status, 0
    first_result_ok = eq first_result, 42
    second_ok = eq second_status, 0
    second_result_ok = eq second_result, 0
    done_ok = eq done, 1
    cached_ok = eq cached_status, 0
    slot_ok = eq slot_value, 42
    ok01 = and raw_ok, first_ok
    ok02 = and ok01, first_result_ok
    ok03 = and ok02, second_ok
    ok04 = and ok03, second_result_ok
    ok05 = and ok04, done_ok
    ok06 = and ok05, cached_ok
    ok = and ok06, slot_ok

    !raw_handle
    !first_status
    !first_result
    !second_status
    !second_result
    !done
    !cached_status
    !slot_value
    !raw_ok
    !first_ok
    !first_result_ok
    !second_ok
    !second_result_ok
    !done_ok
    !cached_ok
    !slot_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !slot
    !handle
    br ok -> L_REPEAT_PASS, L_REPEAT_FAIL
L_REPEAT_FAIL:
    !ok
    panic(10993)
L_REPEAT_PASS:
    !ok
    return 0