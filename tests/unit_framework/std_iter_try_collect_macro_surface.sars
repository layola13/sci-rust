@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@iter_try_collect_until_four(value: u64, &out_value: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_TRY_COLLECT_KEEP, L_TRY_COLLECT_FAIL
L_TRY_COLLECT_KEEP:
    mapped = mul value, 10
    store out_value+0, mapped as u64
    !mapped
    !out_value
    !value
    return keep
L_TRY_COLLECT_FAIL:
    !out_value
    !value
    return keep

@iter_try_collect_all(value: u64, &out_value: ptr) -> u64:
L_ENTRY:
    mapped = add value, 100
    store out_value+0, mapped as u64
    !mapped
    !out_value
    !value
    return 1

@test "sa_std iter try_collect macro surface"():
L_ENTRY:
    values = stack_alloc 40
    all_values = stack_alloc 24
    first_fail_values = stack_alloc 24
    empty_values = stack_alloc 8

    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 4 as u64
    store values+24, 5 as u64
    store values+32, 6 as u64

    store all_values+0, 7 as u64
    store all_values+8, 8 as u64
    store all_values+16, 9 as u64

    store first_fail_values+0, 4 as u64
    store first_fail_values+8, 1 as u64
    store first_fail_values+16, 2 as u64

    slice = alloc Slice_SIZE
    all_slice = alloc Slice_SIZE
    first_fail_slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW all_slice, all_values, 3
    EXPAND SLICE_NEW first_fail_slice, first_fail_values, 3
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_TRY_COLLECT_U64 try_ok, try_vec, iter, @iter_try_collect_until_four
    EXPAND VEC_LEN try_len, try_vec
    EXPAND VEC_GET_U64 try_0, try_vec, 0
    EXPAND VEC_GET_U64 try_1, try_vec, 1
    EXPAND ITER_LEN try_remaining, iter
    EXPAND ITER_NEXT_U64 try_tail_ok, try_tail, iter
    EXPAND ITER_LEN try_remaining_after_tail, iter

    EXPAND ITER_FROM_SLICE all_iter, all_slice
    EXPAND ITER_TRY_COLLECT_U64 all_ok, all_vec, all_iter, @iter_try_collect_all
    EXPAND VEC_LEN all_len, all_vec
    EXPAND VEC_GET_U64 all_0, all_vec, 0
    EXPAND VEC_GET_U64 all_2, all_vec, 2
    EXPAND ITER_IS_EMPTY all_empty, all_iter

    EXPAND ITER_FROM_SLICE first_fail_iter, first_fail_slice
    EXPAND ITER_TRY_COLLECT_U64 first_fail_ok, first_fail_vec, first_fail_iter, @iter_try_collect_until_four
    EXPAND VEC_LEN first_fail_len, first_fail_vec
    EXPAND ITER_LEN first_fail_remaining, first_fail_iter
    EXPAND ITER_NEXT_U64 first_fail_tail_ok, first_fail_tail, first_fail_iter

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_TRY_COLLECT_U64 empty_ok, empty_vec, empty_iter, @iter_try_collect_until_four
    EXPAND VEC_LEN empty_len, empty_vec
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter

    ok_try_ok = eq try_ok, 0
    ok_try_len = eq try_len, 2
    ok_try_0 = eq try_0, 10
    ok_try_1 = eq try_1, 20
    ok_try_remaining = eq try_remaining, 2
    ok_try_tail_ok = eq try_tail_ok, 1
    ok_try_tail = eq try_tail, 5
    ok_try_remaining_after_tail = eq try_remaining_after_tail, 1
    ok_all_ok = eq all_ok, 1
    ok_all_len = eq all_len, 3
    ok_all_0 = eq all_0, 107
    ok_all_2 = eq all_2, 109
    ok_all_empty = eq all_empty, 1
    ok_first_fail_ok = eq first_fail_ok, 0
    ok_first_fail_len = eq first_fail_len, 0
    ok_first_fail_remaining = eq first_fail_remaining, 2
    ok_first_fail_tail_ok = eq first_fail_tail_ok, 1
    ok_first_fail_tail = eq first_fail_tail, 1
    ok_empty_ok = eq empty_ok, 1
    ok_empty_len = eq empty_len, 0
    ok_empty_iter = eq empty_iter_empty, 1

    c01 = and ok_try_ok, ok_try_len
    c02 = and c01, ok_try_0
    c03 = and c02, ok_try_1
    c04 = and c03, ok_try_remaining
    c05 = and c04, ok_try_tail_ok
    c06 = and c05, ok_try_tail
    c07 = and c06, ok_try_remaining_after_tail
    c08 = and c07, ok_all_ok
    c09 = and c08, ok_all_len
    c10 = and c09, ok_all_0
    c11 = and c10, ok_all_2
    c12 = and c11, ok_all_empty
    c13 = and c12, ok_first_fail_ok
    c14 = and c13, ok_first_fail_len
    c15 = and c14, ok_first_fail_remaining
    c16 = and c15, ok_first_fail_tail_ok
    c17 = and c16, ok_first_fail_tail
    c18 = and c17, ok_empty_ok
    c19 = and c18, ok_empty_len
    ok = and c19, ok_empty_iter

    !try_ok
    !try_len
    !try_0
    !try_1
    !try_remaining
    !try_tail_ok
    !try_tail
    !try_remaining_after_tail
    !all_ok
    !all_len
    !all_0
    !all_2
    !all_empty
    !first_fail_ok
    !first_fail_len
    !first_fail_remaining
    !first_fail_tail_ok
    !first_fail_tail
    !empty_ok
    !empty_len
    !empty_iter_empty
    !ok_try_ok
    !ok_try_len
    !ok_try_0
    !ok_try_1
    !ok_try_remaining
    !ok_try_tail_ok
    !ok_try_tail
    !ok_try_remaining_after_tail
    !ok_all_ok
    !ok_all_len
    !ok_all_0
    !ok_all_2
    !ok_all_empty
    !ok_first_fail_ok
    !ok_first_fail_len
    !ok_first_fail_remaining
    !ok_first_fail_tail_ok
    !ok_first_fail_tail
    !ok_empty_ok
    !ok_empty_len
    !ok_empty_iter
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !c19
    !empty_iter
    !first_fail_iter
    !all_iter
    !iter
    !empty_slice
    !first_fail_slice
    !all_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE first_fail_vec
    EXPAND VEC_FREE all_vec
    EXPAND VEC_FREE try_vec
    panic(10553)

L_PASS:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE first_fail_vec
    EXPAND VEC_FREE all_vec
    EXPAND VEC_FREE try_vec
    return 0
