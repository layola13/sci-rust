@import "sa_std/hash.sars"
@import "sa_std/hash.sal"

@test "sa_std default hasher write finish"():
L_ENTRY:
    h = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW h
    EXPAND DEFAULT_HASHER_WRITE_U64 h, 123
    EXPAND DEFAULT_HASHER_FINISH a, h
    h2 = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW h2
    EXPAND DEFAULT_HASHER_WRITE_U64 h2, 123
    EXPAND DEFAULT_HASHER_FINISH b, h2
    h3 = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW h3
    EXPAND DEFAULT_HASHER_WRITE_U64 h3, 124
    EXPAND DEFAULT_HASHER_FINISH c, h3
    same = eq a, b
    diff = ne a, c
    ok = and same, diff
    !a
    !b
    !c
    !same
    !diff
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10930)
