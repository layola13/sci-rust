@test "sa_std task poll macros"():
L_ENTRY:
    waker_data = alloc TestWaker_SIZE
    store waker_data+TestWaker_value, 8 as i32
    EXPAND WAKER_NEW waker, waker_data, &TEST_WAKER_VT
    EXPAND CONTEXT_NEW ctx, waker, waker_data
    future_data = alloc TestFuture_SIZE
    store future_data+TestFuture_state, 0 as u64
    store future_data+TestFuture_value, 42 as u64
    ready_data = alloc TestFuture_SIZE
    store ready_data+TestFuture_state, 0 as u64
    store ready_data+TestFuture_value, 9 as u64
    EXPAND FUTURE_NEW future, future_data, &TEST_PENDING_ONCE_VT
    EXPAND FUTURE_NEW ready_future, ready_data, &TEST_READY_VT
    EXPAND TASK_NEW task, future, ctx
    EXPAND TASK_NEW ready_task, ready_future, ctx
    EXPAND TASK_POLL first_poll, task
    EXPAND POLL_IS_PENDING first_pending, first_poll
    EXPAND TASK_IS_READY ready0, task
    EXPAND TASK_POLL second_poll, task
    EXPAND POLL_IS_READY second_ready, second_poll
    EXPAND TASK_IS_READY ready1, task
    EXPAND TASK_RESULT task_result, task
    slots = alloc 8
    store slots+0, task as ptr
    EXPAND EXECUTOR_NEW executor, slots, 1
    EXPAND EXECUTOR_POLL_ONE executor_poll, executor, 0
    EXPAND POLL_IS_READY executor_ready, executor_poll
    EXPAND POLL_VALUE executor_value, executor_poll
    batch_slots = alloc 16
    store batch_slots+0, task as ptr
    store batch_slots+8, ready_task as ptr
    EXPAND EXECUTOR_NEW batch_executor, batch_slots, 2
    EXPAND EXECUTOR_POLL_READY_COUNT batch_ready_count, batch_executor
    ok_first_pending = eq first_pending, 1
    ok_ready0 = eq ready0, 0
    ok_second_ready = eq second_ready, 1
    ok_ready1 = eq ready1, 1
    ok_task_result = eq task_result, 42
    ok_executor_ready = eq executor_ready, 1
    ok_executor_value = eq executor_value, 42
    ok_batch_ready_count = eq batch_ready_count, 2
    ok01 = and ok_first_pending, ok_ready0
    ok02 = and ok01, ok_second_ready
    ok03 = and ok02, ok_ready1
    ok04 = and ok03, ok_task_result
    ok05 = and ok04, ok_executor_ready
    ok06 = and ok05, ok_executor_value
    ok = and ok06, ok_batch_ready_count
    !first_poll
    !second_poll
    !executor_poll
    !executor
    !slots
    !batch_executor
    !batch_slots
    !task
    !ready_task
    !future
    !ready_future
    !future_data
    !ready_data
    !ctx
    !waker
    !waker_data
    !first_pending
    !ready0
    !second_ready
    !ready1
    !task_result
    !executor_ready
    !executor_value
    !batch_ready_count
    !ok_first_pending
    !ok_ready0
    !ok_second_ready
    !ok_ready1
    !ok_task_result
    !ok_executor_ready
    !ok_executor_value
    !ok_batch_ready_count
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10040)

L_OK:
    !ok
    return
