@import "sa_std/collections/vec_deque.sars"

@test "sa_std vec_deque front/back mut aliases"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_FRONT deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40

    EXPAND VEC_DEQUE_FRONT_MUT front_ok, front_ptr, deque
    store front_ptr+0, 11 as u64
    EXPAND VEC_DEQUE_BACK_MUT back_ok, back_ptr, deque
    store back_ptr+0, 41 as u64

    EXPAND VEC_DEQUE_TRY_FRONT front_view_ok, front_view, deque
    EXPAND VEC_DEQUE_TRY_BACK back_view_ok, back_view, deque
    EXPAND VEC_DEQUE_TRY_GET mid_view_ok, mid_view, deque, 1
    EXPAND VEC_DEQUE_LEN len, deque

    EXPAND VEC_DEQUE_CLEAR deque
    EXPAND VEC_DEQUE_FRONT_MUT empty_front_ok, empty_front_ptr, deque
    EXPAND VEC_DEQUE_BACK_MUT empty_back_ok, empty_back_ptr, deque
    EXPAND VEC_DEQUE_FREE deque

    null_ptr = 0 as ptr
    ok_front_flag = eq front_ok, 1
    ok_back_flag = eq back_ok, 1
    ok_front_view_flag = eq front_view_ok, 1
    ok_front_view = eq front_view, 11
    ok_back_view_flag = eq back_view_ok, 1
    ok_back_view = eq back_view, 41
    ok_mid_view_flag = eq mid_view_ok, 1
    ok_mid_view = eq mid_view, 20
    ok_len = eq len, 4
    ok_empty_front = eq empty_front_ok, 0
    ok_empty_front_ptr = eq empty_front_ptr, null_ptr
    ok_empty_back = eq empty_back_ok, 0
    ok_empty_back_ptr = eq empty_back_ptr, null_ptr

    ok = and ok_front_flag, ok_back_flag
    ok = and ok, ok_front_view_flag
    ok = and ok, ok_front_view
    ok = and ok, ok_back_view_flag
    ok = and ok, ok_back_view
    ok = and ok, ok_mid_view_flag
    ok = and ok, ok_mid_view
    ok = and ok, ok_len
    ok = and ok, ok_empty_front
    ok = and ok, ok_empty_front_ptr
    ok = and ok, ok_empty_back
    ok = and ok, ok_empty_back_ptr

    !front_ok
    !front_ptr
    !back_ok
    !back_ptr
    !front_view_ok
    !front_view
    !back_view_ok
    !back_view
    !mid_view_ok
    !mid_view
    !len
    !empty_front_ok
    !empty_front_ptr
    !empty_back_ok
    !empty_back_ptr
    !null_ptr
    !ok_front_flag
    !ok_back_flag
    !ok_front_view_flag
    !ok_front_view
    !ok_back_view_flag
    !ok_back_view
    !ok_mid_view_flag
    !ok_mid_view
    !ok_len
    !ok_empty_front
    !ok_empty_front_ptr
    !ok_empty_back
    !ok_empty_back_ptr
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10824)

L_OK:
    !ok
    return
