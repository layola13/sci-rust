@import "sa_std/vec.sars"

@test "sa_std vec into_iter adapter collect macro surface"():
L_ENTRY:
    EXPAND VEC_NEW take_src
    EXPAND VEC_PUSH_U64 take_src, 1
    EXPAND VEC_PUSH_U64 take_src, 2
    EXPAND VEC_PUSH_U64 take_src, 3
    EXPAND VEC_PUSH_U64 take_src, 4
    EXPAND VEC_INTO_ITER_U64 take_iter, take_backing, take_src
    EXPAND VEC_INTO_ITER_TAKE_COLLECT_U64 take_vec, take_iter, 2
    EXPAND VEC_LEN take_len, take_vec
    EXPAND VEC_GET_U64 take_0, take_vec, 0
    EXPAND VEC_GET_U64 take_1, take_vec, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 take_remaining, take_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 take_next_has, take_next, take_iter

    EXPAND VEC_NEW take_all_src
    EXPAND VEC_PUSH_U64 take_all_src, 5
    EXPAND VEC_PUSH_U64 take_all_src, 6
    EXPAND VEC_INTO_ITER_U64 take_all_iter, take_all_backing, take_all_src
    EXPAND VEC_INTO_ITER_TAKE_COLLECT_U64 take_all_vec, take_all_iter, 9
    EXPAND VEC_LEN take_all_len, take_all_vec
    EXPAND VEC_GET_U64 take_all_1, take_all_vec, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 take_all_empty, take_all_iter

    EXPAND VEC_NEW skip_src
    EXPAND VEC_PUSH_U64 skip_src, 10
    EXPAND VEC_PUSH_U64 skip_src, 11
    EXPAND VEC_PUSH_U64 skip_src, 12
    EXPAND VEC_PUSH_U64 skip_src, 13
    EXPAND VEC_INTO_ITER_U64 skip_iter, skip_backing, skip_src
    EXPAND VEC_INTO_ITER_SKIP_COLLECT_U64 skip_vec, skip_iter, 2
    EXPAND VEC_LEN skip_len, skip_vec
    EXPAND VEC_GET_U64 skip_0, skip_vec, 0
    EXPAND VEC_GET_U64 skip_1, skip_vec, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_empty, skip_iter

    EXPAND VEC_NEW skip_all_src
    EXPAND VEC_PUSH_U64 skip_all_src, 20
    EXPAND VEC_PUSH_U64 skip_all_src, 21
    EXPAND VEC_INTO_ITER_U64 skip_all_iter, skip_all_backing, skip_all_src
    EXPAND VEC_INTO_ITER_SKIP_COLLECT_U64 skip_all_vec, skip_all_iter, 9
    EXPAND VEC_LEN skip_all_len, skip_all_vec
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_all_empty, skip_all_iter

    EXPAND VEC_NEW rev_src
    EXPAND VEC_PUSH_U64 rev_src, 1
    EXPAND VEC_PUSH_U64 rev_src, 2
    EXPAND VEC_PUSH_U64 rev_src, 3
    EXPAND VEC_INTO_ITER_U64 rev_iter, rev_backing, rev_src
    EXPAND VEC_INTO_ITER_REV_COLLECT_U64 rev_vec, rev_iter
    EXPAND VEC_LEN rev_len, rev_vec
    EXPAND VEC_GET_U64 rev_0, rev_vec, 0
    EXPAND VEC_GET_U64 rev_2, rev_vec, 2
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 rev_empty, rev_iter

    EXPAND VEC_NEW step2_src
    EXPAND VEC_PUSH_U64 step2_src, 0
    EXPAND VEC_PUSH_U64 step2_src, 1
    EXPAND VEC_PUSH_U64 step2_src, 2
    EXPAND VEC_PUSH_U64 step2_src, 3
    EXPAND VEC_PUSH_U64 step2_src, 4
    EXPAND VEC_PUSH_U64 step2_src, 5
    EXPAND VEC_PUSH_U64 step2_src, 6
    EXPAND VEC_INTO_ITER_U64 step2_iter, step2_backing, step2_src
    EXPAND VEC_INTO_ITER_STEP_BY_COLLECT_U64 step2_vec, step2_iter, 2
    EXPAND VEC_LEN step2_len, step2_vec
    EXPAND VEC_GET_U64 step2_0, step2_vec, 0
    EXPAND VEC_GET_U64 step2_1, step2_vec, 1
    EXPAND VEC_GET_U64 step2_3, step2_vec, 3
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 step2_empty, step2_iter

    EXPAND VEC_NEW step3_src
    EXPAND VEC_PUSH_U64 step3_src, 1
    EXPAND VEC_PUSH_U64 step3_src, 2
    EXPAND VEC_PUSH_U64 step3_src, 3
    EXPAND VEC_PUSH_U64 step3_src, 4
    EXPAND VEC_PUSH_U64 step3_src, 5
    EXPAND VEC_PUSH_U64 step3_src, 6
    EXPAND VEC_PUSH_U64 step3_src, 7
    EXPAND VEC_INTO_ITER_U64 step3_iter, step3_backing, step3_src
    EXPAND VEC_INTO_ITER_TRY_STEP_BY_COLLECT_U64 step3_ok, step3_vec, step3_iter, 3
    EXPAND VEC_LEN step3_len, step3_vec
    EXPAND VEC_GET_U64 step3_0, step3_vec, 0
    EXPAND VEC_GET_U64 step3_1, step3_vec, 1
    EXPAND VEC_GET_U64 step3_2, step3_vec, 2
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 step3_empty, step3_iter

    EXPAND VEC_NEW invalid_src
    EXPAND VEC_PUSH_U64 invalid_src, 30
    EXPAND VEC_PUSH_U64 invalid_src, 31
    EXPAND VEC_INTO_ITER_U64 invalid_iter, invalid_backing, invalid_src
    EXPAND VEC_INTO_ITER_TRY_STEP_BY_COLLECT_U64 invalid_ok, invalid_vec, invalid_iter, 0
    EXPAND VEC_LEN invalid_len, invalid_vec
    EXPAND VEC_INTO_ITER_NEXT_U64 invalid_next_has, invalid_next, invalid_iter

    EXPAND VEC_FREE take_backing
    EXPAND VEC_FREE take_vec
    EXPAND VEC_FREE take_all_backing
    EXPAND VEC_FREE take_all_vec
    EXPAND VEC_FREE skip_backing
    EXPAND VEC_FREE skip_vec
    EXPAND VEC_FREE skip_all_backing
    EXPAND VEC_FREE skip_all_vec
    EXPAND VEC_FREE rev_backing
    EXPAND VEC_FREE rev_vec
    EXPAND VEC_FREE step2_backing
    EXPAND VEC_FREE step2_vec
    EXPAND VEC_FREE step3_backing
    EXPAND VEC_FREE step3_vec
    EXPAND VEC_FREE invalid_backing
    EXPAND VEC_FREE invalid_vec

    ok_take_len = eq take_len, 2
    ok_take_0 = eq take_0, 1
    ok_take_1 = eq take_1, 2
    ok_take_remaining = eq take_remaining, 2
    ok_take_next_has = eq take_next_has, 1
    ok_take_next = eq take_next, 3
    ok_take_all_len = eq take_all_len, 2
    ok_take_all_1 = eq take_all_1, 6
    ok_take_all_empty = eq take_all_empty, 1
    ok_skip_len = eq skip_len, 2
    ok_skip_0 = eq skip_0, 12
    ok_skip_1 = eq skip_1, 13
    ok_skip_empty = eq skip_empty, 1
    ok_skip_all_len = eq skip_all_len, 0
    ok_skip_all_empty = eq skip_all_empty, 1
    ok_rev_len = eq rev_len, 3
    ok_rev_0 = eq rev_0, 3
    ok_rev_2 = eq rev_2, 1
    ok_rev_empty = eq rev_empty, 1
    ok_step2_len = eq step2_len, 4
    ok_step2_0 = eq step2_0, 0
    ok_step2_1 = eq step2_1, 2
    ok_step2_3 = eq step2_3, 6
    ok_step2_empty = eq step2_empty, 1
    ok_step3_ok = eq step3_ok, 1
    ok_step3_len = eq step3_len, 3
    ok_step3_0 = eq step3_0, 1
    ok_step3_1 = eq step3_1, 4
    ok_step3_2 = eq step3_2, 7
    ok_step3_empty = eq step3_empty, 1
    ok_invalid_ok = eq invalid_ok, 0
    ok_invalid_len = eq invalid_len, 0
    ok_invalid_next_has = eq invalid_next_has, 1
    ok_invalid_next = eq invalid_next, 30

    ok = and ok_take_len, ok_take_0
    ok = and ok, ok_take_1
    ok = and ok, ok_take_remaining
    ok = and ok, ok_take_next_has
    ok = and ok, ok_take_next
    ok = and ok, ok_take_all_len
    ok = and ok, ok_take_all_1
    ok = and ok, ok_take_all_empty
    ok = and ok, ok_skip_len
    ok = and ok, ok_skip_0
    ok = and ok, ok_skip_1
    ok = and ok, ok_skip_empty
    ok = and ok, ok_skip_all_len
    ok = and ok, ok_skip_all_empty
    ok = and ok, ok_rev_len
    ok = and ok, ok_rev_0
    ok = and ok, ok_rev_2
    ok = and ok, ok_rev_empty
    ok = and ok, ok_step2_len
    ok = and ok, ok_step2_0
    ok = and ok, ok_step2_1
    ok = and ok, ok_step2_3
    ok = and ok, ok_step2_empty
    ok = and ok, ok_step3_ok
    ok = and ok, ok_step3_len
    ok = and ok, ok_step3_0
    ok = and ok, ok_step3_1
    ok = and ok, ok_step3_2
    ok = and ok, ok_step3_empty
    ok = and ok, ok_invalid_ok
    ok = and ok, ok_invalid_len
    ok = and ok, ok_invalid_next_has
    ok = and ok, ok_invalid_next

    !take_len
    !take_0
    !take_1
    !take_remaining
    !take_next_has
    !take_next
    !take_all_len
    !take_all_1
    !take_all_empty
    !skip_len
    !skip_0
    !skip_1
    !skip_empty
    !skip_all_len
    !skip_all_empty
    !rev_len
    !rev_0
    !rev_2
    !rev_empty
    !step2_len
    !step2_0
    !step2_1
    !step2_3
    !step2_empty
    !step3_ok
    !step3_len
    !step3_0
    !step3_1
    !step3_2
    !step3_empty
    !invalid_ok
    !invalid_len
    !invalid_next_has
    !invalid_next
    !ok_take_len
    !ok_take_0
    !ok_take_1
    !ok_take_remaining
    !ok_take_next_has
    !ok_take_next
    !ok_take_all_len
    !ok_take_all_1
    !ok_take_all_empty
    !ok_skip_len
    !ok_skip_0
    !ok_skip_1
    !ok_skip_empty
    !ok_skip_all_len
    !ok_skip_all_empty
    !ok_rev_len
    !ok_rev_0
    !ok_rev_2
    !ok_rev_empty
    !ok_step2_len
    !ok_step2_0
    !ok_step2_1
    !ok_step2_3
    !ok_step2_empty
    !ok_step3_ok
    !ok_step3_len
    !ok_step3_0
    !ok_step3_1
    !ok_step3_2
    !ok_step3_empty
    !ok_invalid_ok
    !ok_invalid_len
    !ok_invalid_next_has
    !ok_invalid_next
    !take_iter
    !take_all_iter
    !skip_iter
    !skip_all_iter
    !rev_iter
    !step2_iter
    !step3_iter
    !invalid_iter
    br ok -> L_VEC_INTO_ITER_ADAPTER_COLLECT_OK, L_VEC_INTO_ITER_ADAPTER_COLLECT_FAIL

L_VEC_INTO_ITER_ADAPTER_COLLECT_FAIL:
    !ok
    panic(10721)

L_VEC_INTO_ITER_ADAPTER_COLLECT_OK:
    !ok
    return
