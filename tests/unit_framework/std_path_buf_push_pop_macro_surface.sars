@import "sa_std/path.sars"
@import "sa_std/core/slice.sars"

@const A = utf8:"a"
@const B = utf8:"b"

@test "sa_std path_buf push pop"():
L_ENTRY:
    EXPAND PATH_BUF_NEW pb
    sa = stack_alloc Slice_SIZE
    sb = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW sa, &A, 1
    EXPAND SLICE_NEW sb, &B, 1
    EXPAND PATH_BUF_PUSH pb, sa
    EXPAND PATH_BUF_PUSH pb, sb
    EXPAND PATH_BUF_POP ok, pb
    EXPAND PATH_BUF_LEN ln, pb
    EXPAND PATH_BUF_FREE pb
    a = eq ok, 1
    b = ugt ln, 0
    ok_all = and a, b
    !ok
    !ln
    !a
    !b
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(11005)
