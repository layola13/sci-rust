@import "sa_std/process.sars"

@test "sa_std process Stdio value object macros"():
L_ENTRY:
    piped = stack_alloc ProcessStdio_SIZE
    inherit = stack_alloc ProcessStdio_SIZE
    null = stack_alloc ProcessStdio_SIZE
    custom = stack_alloc ProcessStdio_SIZE

    EXPAND PROCESS_STDIO_PIPED piped
    EXPAND PROCESS_STDIO_INHERIT inherit
    EXPAND PROCESS_STDIO_NULL null
    EXPAND PROCESS_STDIO_NEW custom, PROCESS_STDIO_KIND_PIPED

    EXPAND PROCESS_STDIO_KIND piped_kind, piped
    EXPAND PROCESS_STDIO_KIND inherit_kind, inherit
    EXPAND PROCESS_STDIO_KIND null_kind, null
    EXPAND PROCESS_STDIO_KIND custom_kind, custom
    EXPAND PROCESS_STDIO_MAKES_PIPE piped_makes_pipe, piped
    EXPAND PROCESS_STDIO_MAKES_PIPE inherit_makes_pipe, inherit
    EXPAND PROCESS_STDIO_MAKES_PIPE null_makes_pipe, null
    EXPAND PROCESS_STDIO_MAKES_PIPE custom_makes_pipe, custom

    ok_size = eq ProcessStdio_SIZE, 1
    ok_align = eq ProcessStdio_ALIGN, 1
    ok_piped = eq piped_kind, PROCESS_STDIO_KIND_PIPED
    ok_inherit = eq inherit_kind, PROCESS_STDIO_KIND_INHERIT
    ok_null = eq null_kind, PROCESS_STDIO_KIND_NULL
    ok_custom = eq custom_kind, PROCESS_STDIO_KIND_PIPED
    ok_inherit_not_pipe = eq inherit_makes_pipe, 0
    ok_null_not_pipe = eq null_makes_pipe, 0
    ok00 = and ok_size, ok_align
    ok01 = and ok00, ok_piped
    ok02 = and ok01, ok_inherit
    ok03 = and ok02, ok_null
    ok04 = and ok03, ok_custom
    ok05 = and ok04, piped_makes_pipe
    ok06 = and ok05, custom_makes_pipe
    ok07 = and ok06, ok_inherit_not_pipe
    ok = and ok07, ok_null_not_pipe

    !piped_kind
    !inherit_kind
    !null_kind
    !custom_kind
    !piped_makes_pipe
    !inherit_makes_pipe
    !null_makes_pipe
    !custom_makes_pipe
    !ok_size
    !ok_align
    !ok_piped
    !ok_inherit
    !ok_null
    !ok_custom
    !ok_inherit_not_pipe
    !ok_null_not_pipe
    !ok00
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10683)

L_PASS:
    !ok
    return 0
