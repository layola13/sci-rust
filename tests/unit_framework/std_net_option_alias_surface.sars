@import "sa_std/net.sars"

@test "sa_std network option spelling aliases"():
L_ENTRY:
    listener = add 0, 0
    stream = add 0, 0
    enabled = add 0, 1
    seconds = add 0, 5
    idle = add 0, 10
    interval = add 0, 2
    count = add 0, 3

    EXPAND NET_TCP_LISTENER_SET_REUSE_ADDR listener_reuse_addr, listener, enabled
    EXPAND NET_TCP_LISTENER_SET_REUSE_PORT listener_reuse_port, listener, enabled
    EXPAND NET_TCP_STREAM_SET_QUICK_ACK stream_quick_ack, stream, enabled
    EXPAND NET_TCP_STREAM_QUICK_ACK stream_quick_ack_get, quick_ack_enabled, stream
    EXPAND NET_TCP_STREAM_SET_DEFER_ACCEPT stream_defer_accept, stream, seconds
    EXPAND NET_TCP_STREAM_DEFER_ACCEPT stream_defer_accept_get, defer_accept_seconds, stream
    EXPAND NET_TCP_STREAM_SET_KEEP_ALIVE stream_keep_alive, stream, enabled
    EXPAND NET_TCP_STREAM_SET_KEEP_ALIVE_PARAMS stream_keep_alive_params, stream, idle, interval, count

    !listener_reuse_addr
    !listener_reuse_port
    !stream_quick_ack
    !stream_quick_ack_get
    !quick_ack_enabled
    !stream_defer_accept
    !stream_defer_accept_get
    !defer_accept_seconds
    !stream_keep_alive
    !stream_keep_alive_params
    !listener
    !stream
    !enabled
    !seconds
    !idle
    !interval
    !count
    return 0
