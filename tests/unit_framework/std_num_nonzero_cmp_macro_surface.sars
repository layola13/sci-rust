    EXPAND NONZERO_ISIZE_LE isize_le_equal, isize_left, isize_same
    EXPAND NONZERO_ISIZE_GT isize_gt_greater, isize_greater, isize_left
    EXPAND NONZERO_ISIZE_GE isize_ge_equal, isize_left, isize_same
    isize_ok_new_left = eq ok_isize_left, 1
    isize_ok_new_same = eq ok_isize_same, 1
    isize_ok_new_greater = eq ok_isize_greater, 1
    isize_ok_eq_same = eq isize_eq_same, 1
    isize_ok_eq_greater = eq isize_eq_greater, 0
    isize_ok_ne_same = eq isize_ne_same, 0
