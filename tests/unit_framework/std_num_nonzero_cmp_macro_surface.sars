    EXPAND NONZERO_ISIZE_EQ isize_eq_greater, isize_left, isize_greater
    EXPAND NONZERO_ISIZE_NE isize_ne_same, isize_left, isize_same
    EXPAND NONZERO_ISIZE_NE isize_ne_greater, isize_left, isize_greater
