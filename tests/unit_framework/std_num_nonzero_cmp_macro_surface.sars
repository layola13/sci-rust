[MACRO] CHECK_NONZERO_ISIZE_CMP %out_ok
    isize_left = stack_alloc NonZeroIsize_SIZE
    isize_same = stack_alloc NonZeroIsize_SIZE
    isize_greater = stack_alloc NonZeroIsize_SIZE
    EXPAND NONZERO_ISIZE_NEW ok_isize_left, isize_left, -11
    EXPAND NONZERO_ISIZE_NEW ok_isize_same, isize_same, -11
    EXPAND NONZERO_ISIZE_NEW ok_isize_greater, isize_greater, 5
