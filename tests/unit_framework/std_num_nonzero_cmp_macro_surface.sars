    EXPAND NONZERO_ISIZE_CMP isize_cmp_equal, isize_left, isize_same
    EXPAND NONZERO_ISIZE_CMP isize_cmp_greater, isize_greater, isize_left
    EXPAND NONZERO_ISIZE_PARTIAL_CMP isize_partial_less, isize_left, isize_greater
