[MACRO] CHECK_NONZERO_USIZE_CMP %out_ok
    usize_left = stack_alloc NonZeroUsize_SIZE
    usize_same = stack_alloc NonZeroUsize_SIZE
    usize_greater = stack_alloc NonZeroUsize_SIZE
    EXPAND NONZERO_USIZE_NEW ok_usize_left, usize_left, 11
    EXPAND NONZERO_USIZE_NEW ok_usize_same, usize_same, 11
    EXPAND NONZERO_USIZE_NEW ok_usize_greater, usize_greater, 12
    EXPAND NONZERO_USIZE_EQ usize_eq_same, usize_left, usize_same
    EXPAND NONZERO_USIZE_EQ usize_eq_greater, usize_left, usize_greater
    EXPAND NONZERO_USIZE_NE usize_ne_same, usize_left, usize_same
    EXPAND NONZERO_USIZE_NE usize_ne_greater, usize_left, usize_greater
    EXPAND NONZERO_USIZE_CMP usize_cmp_less, usize_left, usize_greater
    EXPAND NONZERO_USIZE_CMP usize_cmp_equal, usize_left, usize_same
    EXPAND NONZERO_USIZE_CMP usize_cmp_greater, usize_greater, usize_left
    EXPAND NONZERO_USIZE_PARTIAL_CMP usize_partial_less, usize_left, usize_greater
    EXPAND NONZERO_USIZE_LT usize_lt_less, usize_left, usize_greater
    EXPAND NONZERO_USIZE_LE usize_le_equal, usize_left, usize_same
    EXPAND NONZERO_USIZE_GT usize_gt_greater, usize_greater, usize_left
    EXPAND NONZERO_USIZE_GE usize_ge_equal, usize_left, usize_same
    usize_ok_new_left = eq ok_usize_left, 1
    usize_ok_new_same = eq ok_usize_same, 1
    usize_ok_new_greater = eq ok_usize_greater, 1
    usize_ok_eq_same = eq usize_eq_same, 1
    usize_ok_eq_greater = eq usize_eq_greater, 0
    usize_ok_ne_same = eq usize_ne_same, 0
    usize_ok_ne_greater = eq usize_ne_greater, 1
    usize_ok_cmp_less = eq usize_cmp_less, CMP_ORDERING_LESS
    usize_ok_cmp_equal = eq usize_cmp_equal, CMP_ORDERING_EQUAL
    usize_ok_cmp_greater = eq usize_cmp_greater, CMP_ORDERING_GREATER
    usize_ok_partial_less = eq usize_partial_less, CMP_ORDERING_LESS
    usize_ok_lt_less = eq usize_lt_less, 1
    usize_ok_le_equal = eq usize_le_equal, 1
    usize_ok_gt_greater = eq usize_gt_greater, 1
    usize_ok_ge_equal = eq usize_ge_equal, 1
    usize_ok_chain_01 = and usize_ok_new_left, usize_ok_new_same
    usize_ok_chain_02 = and usize_ok_chain_01, usize_ok_new_greater
    usize_ok_chain_03 = and usize_ok_chain_02, usize_ok_eq_same
    usize_ok_chain_04 = and usize_ok_chain_03, usize_ok_eq_greater
    usize_ok_chain_05 = and usize_ok_chain_04, usize_ok_ne_same
    usize_ok_chain_06 = and usize_ok_chain_05, usize_ok_ne_greater
    usize_ok_chain_07 = and usize_ok_chain_06, usize_ok_cmp_less
    usize_ok_chain_08 = and usize_ok_chain_07, usize_ok_cmp_equal
    usize_ok_chain_09 = and usize_ok_chain_08, usize_ok_cmp_greater
    usize_ok_chain_10 = and usize_ok_chain_09, usize_ok_partial_less
    usize_ok_chain_11 = and usize_ok_chain_10, usize_ok_lt_less
    usize_ok_chain_12 = and usize_ok_chain_11, usize_ok_le_equal
    usize_ok_chain_13 = and usize_ok_chain_12, usize_ok_gt_greater
