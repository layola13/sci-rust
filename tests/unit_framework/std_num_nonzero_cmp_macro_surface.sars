@import "sa_std/num.sars"

[MACRO] CHECK_NONZERO_U8_CMP %out_ok
    u8_left = stack_alloc NonZeroU8_SIZE
    u8_same = stack_alloc NonZeroU8_SIZE
    u8_greater = stack_alloc NonZeroU8_SIZE
    EXPAND NONZERO_U8_NEW ok_u8_left, u8_left, 7
    EXPAND NONZERO_U8_NEW ok_u8_same, u8_same, 7
    EXPAND NONZERO_U8_NEW ok_u8_greater, u8_greater, 9
    EXPAND NONZERO_U8_EQ u8_eq_same, u8_left, u8_same
    EXPAND NONZERO_U8_EQ u8_eq_greater, u8_left, u8_greater
    EXPAND NONZERO_U8_NE u8_ne_same, u8_left, u8_same
    EXPAND NONZERO_U8_NE u8_ne_greater, u8_left, u8_greater
    EXPAND NONZERO_U8_CMP u8_cmp_less, u8_left, u8_greater
    EXPAND NONZERO_U8_CMP u8_cmp_equal, u8_left, u8_same
    EXPAND NONZERO_U8_CMP u8_cmp_greater, u8_greater, u8_left
    EXPAND NONZERO_U8_PARTIAL_CMP u8_partial_less, u8_left, u8_greater
    EXPAND NONZERO_U8_LT u8_lt_less, u8_left, u8_greater
    EXPAND NONZERO_U8_LE u8_le_equal, u8_left, u8_same
    EXPAND NONZERO_U8_GT u8_gt_greater, u8_greater, u8_left
    EXPAND NONZERO_U8_GE u8_ge_equal, u8_left, u8_same
    u8_ok_new_left = eq ok_u8_left, 1
    u8_ok_new_same = eq ok_u8_same, 1
    u8_ok_new_greater = eq ok_u8_greater, 1
    u8_ok_eq_same = eq u8_eq_same, 1
    u8_ok_eq_greater = eq u8_eq_greater, 0
    u8_ok_ne_same = eq u8_ne_same, 0
    u8_ok_ne_greater = eq u8_ne_greater, 1
    u8_ok_cmp_less = eq u8_cmp_less, CMP_ORDERING_LESS
    u8_ok_cmp_equal = eq u8_cmp_equal, CMP_ORDERING_EQUAL
    u8_ok_cmp_greater = eq u8_cmp_greater, CMP_ORDERING_GREATER
    u8_ok_partial_less = eq u8_partial_less, CMP_ORDERING_LESS
    u8_ok_lt_less = eq u8_lt_less, 1
    u8_ok_le_equal = eq u8_le_equal, 1
    u8_ok_gt_greater = eq u8_gt_greater, 1
    u8_ok_ge_equal = eq u8_ge_equal, 1
    u8_ok_chain_01 = and u8_ok_new_left, u8_ok_new_same
    u8_ok_chain_02 = and u8_ok_chain_01, u8_ok_new_greater
    u8_ok_chain_03 = and u8_ok_chain_02, u8_ok_eq_same
    u8_ok_chain_04 = and u8_ok_chain_03, u8_ok_eq_greater
    u8_ok_chain_05 = and u8_ok_chain_04, u8_ok_ne_same
    u8_ok_chain_06 = and u8_ok_chain_05, u8_ok_ne_greater
    u8_ok_chain_07 = and u8_ok_chain_06, u8_ok_cmp_less
    u8_ok_chain_08 = and u8_ok_chain_07, u8_ok_cmp_equal
    u8_ok_chain_09 = and u8_ok_chain_08, u8_ok_cmp_greater
    u8_ok_chain_10 = and u8_ok_chain_09, u8_ok_partial_less
    u8_ok_chain_11 = and u8_ok_chain_10, u8_ok_lt_less
    u8_ok_chain_12 = and u8_ok_chain_11, u8_ok_le_equal
    u8_ok_chain_13 = and u8_ok_chain_12, u8_ok_gt_greater
    u8_ok_chain_14 = and u8_ok_chain_13, u8_ok_ge_equal
    %out_ok = add u8_ok_chain_14, 0
[END_MACRO]

