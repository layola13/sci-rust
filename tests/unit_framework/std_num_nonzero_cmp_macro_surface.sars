    isize_ok_cmp_less = eq isize_cmp_less, CMP_ORDERING_LESS
    isize_ok_cmp_equal = eq isize_cmp_equal, CMP_ORDERING_EQUAL
    isize_ok_cmp_greater = eq isize_cmp_greater, CMP_ORDERING_GREATER
    isize_ok_partial_less = eq isize_partial_less, CMP_ORDERING_LESS
    isize_ok_lt_less = eq isize_lt_less, 1
    isize_ok_le_equal = eq isize_le_equal, 1
    isize_ok_gt_greater = eq isize_gt_greater, 1
    isize_ok_ge_equal = eq isize_ge_equal, 1
    isize_ok_chain_01 = and isize_ok_new_left, isize_ok_new_same
    isize_ok_chain_02 = and isize_ok_chain_01, isize_ok_new_greater
    isize_ok_chain_03 = and isize_ok_chain_02, isize_ok_eq_same
    isize_ok_chain_04 = and isize_ok_chain_03, isize_ok_eq_greater
    isize_ok_chain_05 = and isize_ok_chain_04, isize_ok_ne_same
    isize_ok_chain_06 = and isize_ok_chain_05, isize_ok_ne_greater
    isize_ok_chain_07 = and isize_ok_chain_06, isize_ok_cmp_less
    isize_ok_chain_08 = and isize_ok_chain_07, isize_ok_cmp_equal
    isize_ok_chain_09 = and isize_ok_chain_08, isize_ok_cmp_greater
    isize_ok_chain_10 = and isize_ok_chain_09, isize_ok_partial_less
    isize_ok_chain_11 = and isize_ok_chain_10, isize_ok_lt_less
    isize_ok_chain_12 = and isize_ok_chain_11, isize_ok_le_equal
    isize_ok_chain_13 = and isize_ok_chain_12, isize_ok_gt_greater
