    u16_ok_chain_02 = and u16_ok_chain_01, u16_ok_new_greater
    u16_ok_chain_03 = and u16_ok_chain_02, u16_ok_eq_same
    u16_ok_chain_04 = and u16_ok_chain_03, u16_ok_eq_greater
    u16_ok_chain_05 = and u16_ok_chain_04, u16_ok_ne_same
    u16_ok_chain_06 = and u16_ok_chain_05, u16_ok_ne_greater
    u16_ok_chain_07 = and u16_ok_chain_06, u16_ok_cmp_less
    u16_ok_chain_08 = and u16_ok_chain_07, u16_ok_cmp_equal
    u16_ok_chain_09 = and u16_ok_chain_08, u16_ok_cmp_greater
    u16_ok_chain_10 = and u16_ok_chain_09, u16_ok_partial_less
    u16_ok_chain_11 = and u16_ok_chain_10, u16_ok_lt_less
    u16_ok_chain_12 = and u16_ok_chain_11, u16_ok_le_equal
    u16_ok_chain_13 = and u16_ok_chain_12, u16_ok_gt_greater
