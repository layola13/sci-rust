@import "sa_std/rust_core.sars"
@import "sa_std/hash.sars"

@test "sa_std hash rc arc u64 macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    EXPAND RC_NEW rc_a, 70
    EXPAND RC_NEW rc_same, 70
    EXPAND RC_NEW rc_other, 71
    EXPAND ARC_NEW arc_a, 80
    EXPAND ARC_NEW arc_same, 80
    EXPAND ARC_NEW arc_other, 81

    rc_write_hasher = stack_alloc DefaultHasher_SIZE
    arc_write_hasher = stack_alloc DefaultHasher_SIZE
    state = stack_alloc RandomState_SIZE
    rc_state_manual_hasher = stack_alloc DefaultHasher_SIZE
    arc_state_manual_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW rc_write_hasher
    EXPAND DEFAULT_HASHER_WRITE_RC_U64 rc_write_hasher, rc_a
    EXPAND DEFAULT_HASHER_FINISH rc_write_hash, rc_write_hasher

    EXPAND DEFAULT_HASHER_NEW arc_write_hasher
    EXPAND DEFAULT_HASHER_WRITE_ARC_U64 arc_write_hasher, arc_a
    EXPAND DEFAULT_HASHER_FINISH arc_write_hash, arc_write_hasher

    EXPAND HASH_U64 rc_value_hash, 70
    EXPAND HASH_U64 arc_value_hash, 80
    EXPAND HASH_RC_U64 rc_hash, rc_a
    EXPAND HASH_RC_U64 rc_same_hash, rc_same
    EXPAND HASH_RC_U64 rc_other_hash, rc_other
    EXPAND HASH_ARC_U64 arc_hash, arc_a
    EXPAND HASH_ARC_U64 arc_same_hash, arc_same
    EXPAND HASH_ARC_U64 arc_other_hash, arc_other
    EXPAND HASH_PTR_VALUE rc_ptr_hash, rc_a
    EXPAND HASH_PTR_VALUE arc_ptr_hash, arc_a
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_RC_U64 build_rc_hash, builder, rc_a
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_ARC_U64 build_arc_hash, builder, arc_a

    EXPAND RC_AS_PTR rc_value_ptr, rc_a
    store rc_value_ptr+0, 72 as u64
    EXPAND HASH_RC_U64 rc_changed_hash, rc_a
    EXPAND HASH_U64 rc_changed_value_hash, 72

    EXPAND ARC_AS_PTR arc_value_ptr, arc_a
    store arc_value_ptr+0, 82 as u64
    EXPAND HASH_ARC_U64 arc_changed_hash, arc_a
    EXPAND HASH_U64 arc_changed_value_hash, 82

    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_RC_U64 rc_state_hash, state, rc_a
    EXPAND RANDOM_STATE_BUILD rc_state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_U64 rc_state_manual_hasher, 72
    EXPAND DEFAULT_HASHER_FINISH rc_state_manual_hash, rc_state_manual_hasher

    EXPAND RANDOM_STATE_HASH_ONE_ARC_U64 arc_state_hash, state, arc_a
    EXPAND RANDOM_STATE_BUILD arc_state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_U64 arc_state_manual_hasher, 82
    EXPAND DEFAULT_HASHER_FINISH arc_state_manual_hash, arc_state_manual_hasher

    rc_write_matches_value = eq rc_write_hash, rc_value_hash
    arc_write_matches_value = eq arc_write_hash, arc_value_hash
    rc_forwards_value = eq rc_hash, rc_value_hash
    arc_forwards_value = eq arc_hash, arc_value_hash
    rc_same_value_matches = eq rc_same_hash, rc_hash
    arc_same_value_matches = eq arc_same_hash, arc_hash
    rc_different_value_matters = ne rc_other_hash, rc_hash
    arc_different_value_matters = ne arc_other_hash, arc_hash
    rc_pointer_not_value = ne rc_ptr_hash, rc_hash
    arc_pointer_not_value = ne arc_ptr_hash, arc_hash
    build_rc_matches_value = eq build_rc_hash, rc_value_hash
    build_arc_matches_value = eq build_arc_hash, arc_value_hash
    rc_changed_matches = eq rc_changed_hash, rc_changed_value_hash
    arc_changed_matches = eq arc_changed_hash, arc_changed_value_hash
    rc_changed_differs_old = ne rc_changed_hash, rc_hash
    arc_changed_differs_old = ne arc_changed_hash, arc_hash
    rc_state_matches_manual = eq rc_state_hash, rc_state_manual_hash
    arc_state_matches_manual = eq arc_state_hash, arc_state_manual_hash
    rc_seeded_differs_default = ne rc_state_hash, rc_changed_hash
    arc_seeded_differs_default = ne arc_state_hash, arc_changed_hash

    c01 = and rc_write_matches_value, arc_write_matches_value
    c02 = and c01, rc_forwards_value
    c03 = and c02, arc_forwards_value
    c04 = and c03, rc_same_value_matches
    c05 = and c04, arc_same_value_matches
    c06 = and c05, rc_different_value_matters
    c07 = and c06, arc_different_value_matters
    c08 = and c07, rc_pointer_not_value
    c09 = and c08, arc_pointer_not_value
    c10 = and c09, build_rc_matches_value
    c11 = and c10, build_arc_matches_value
    c12 = and c11, rc_changed_matches
    c13 = and c12, arc_changed_matches
    c14 = and c13, rc_changed_differs_old
    c15 = and c14, arc_changed_differs_old
    c16 = and c15, rc_state_matches_manual
    c17 = and c16, arc_state_matches_manual
    c18 = and c17, rc_seeded_differs_default
    ok = and c18, arc_seeded_differs_default

    !builder
    !rc_write_hash
    !arc_write_hash
    !rc_value_hash
    !arc_value_hash
    !rc_hash
    !rc_same_hash
    !rc_other_hash
    !arc_hash
    !arc_same_hash
    !arc_other_hash
    !rc_ptr_hash
    !arc_ptr_hash
    !build_rc_hash
    !build_arc_hash
    !rc_value_ptr
    !arc_value_ptr
    !rc_changed_hash
    !rc_changed_value_hash
    !arc_changed_hash
    !arc_changed_value_hash
    !rc_state_hash
    !rc_state_manual_hash
    !arc_state_hash
    !arc_state_manual_hash
    !rc_write_matches_value
    !arc_write_matches_value
    !rc_forwards_value
    !arc_forwards_value
    !rc_same_value_matches
    !arc_same_value_matches
    !rc_different_value_matters
    !arc_different_value_matters
    !rc_pointer_not_value
    !arc_pointer_not_value
    !build_rc_matches_value
    !build_arc_matches_value
    !rc_changed_matches
    !arc_changed_matches
    !rc_changed_differs_old
    !arc_changed_differs_old
    !rc_state_matches_manual
    !arc_state_matches_manual
    !rc_seeded_differs_default
    !arc_seeded_differs_default
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !rc_a
    !rc_same
    !rc_other
    !arc_a
    !arc_same
    !arc_other

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10581)

L_PASS:
    !ok
    return 0
