@import "sa_std/num.sars"

@test "sa_std primitive checked and saturating sign cast macro surface"():
L_ENTRY:
    EXPAND NUM_U8_SATURATING_CAST_SIGNED u8_sat, NUM_U8_MAX
    EXPAND NUM_U16_SATURATING_CAST_SIGNED u16_sat, NUM_U16_MAX
    EXPAND NUM_U32_SATURATING_CAST_SIGNED u32_sat, NUM_U32_MAX
    EXPAND NUM_U64_SATURATING_CAST_SIGNED u64_sat, NUM_U64_MAX
    EXPAND NUM_USIZE_SATURATING_CAST_SIGNED usize_sat, NUM_U64_MAX
    EXPAND NUM_U64_SATURATING_CAST_SIGNED u64_sat_value, 64

    EXPAND NUM_U8_CHECKED_CAST_SIGNED u8_checked_ok, u8_checked, NUM_U8_MAX
    EXPAND NUM_U16_CHECKED_CAST_SIGNED u16_checked_ok, u16_checked, NUM_U16_MAX
    EXPAND NUM_U32_CHECKED_CAST_SIGNED u32_checked_ok, u32_checked, NUM_U32_MAX
    EXPAND NUM_U64_CHECKED_CAST_SIGNED u64_checked_ok, u64_checked, NUM_U64_MAX
    EXPAND NUM_USIZE_CHECKED_CAST_SIGNED usize_checked_ok, usize_checked, NUM_U64_MAX
    EXPAND NUM_U64_CHECKED_CAST_SIGNED u64_value_ok, u64_value, 64

    EXPAND NUM_I8_SATURATING_CAST_UNSIGNED i8_sat, -1
    EXPAND NUM_I16_SATURATING_CAST_UNSIGNED i16_sat, -1
    EXPAND NUM_I32_SATURATING_CAST_UNSIGNED i32_sat, -1
    EXPAND NUM_I64_SATURATING_CAST_UNSIGNED i64_sat, -1
    EXPAND NUM_ISIZE_SATURATING_CAST_UNSIGNED isize_sat, -1
    EXPAND NUM_I64_SATURATING_CAST_UNSIGNED i64_sat_value, 64

    EXPAND NUM_I8_CHECKED_CAST_UNSIGNED i8_checked_ok, i8_checked, -1
    EXPAND NUM_I16_CHECKED_CAST_UNSIGNED i16_checked_ok, i16_checked, -1
    EXPAND NUM_I32_CHECKED_CAST_UNSIGNED i32_checked_ok, i32_checked, -1
    EXPAND NUM_I64_CHECKED_CAST_UNSIGNED i64_checked_ok, i64_checked, -1
    EXPAND NUM_ISIZE_CHECKED_CAST_UNSIGNED isize_checked_ok, isize_checked, -1
    EXPAND NUM_I64_CHECKED_CAST_UNSIGNED i64_value_ok, i64_value, 64

    ok_sat_01 = eq u8_sat, NUM_I8_MAX
    ok_sat_02 = eq u16_sat, NUM_I16_MAX
    ok_sat_03 = eq u32_sat, NUM_I32_MAX
    ok_sat_04 = eq u64_sat, NUM_I64_MAX
    ok_sat_05 = eq usize_sat, NUM_I64_MAX
    ok_sat_06 = eq u64_sat_value, 64

    ok_ucheck_01 = eq u8_checked_ok, 0
    ok_ucheck_02 = eq u16_checked_ok, 0
    ok_ucheck_03 = eq u32_checked_ok, 0
    ok_ucheck_04 = eq u64_checked_ok, 0
    ok_ucheck_05 = eq usize_checked_ok, 0
    ok_ucheck_06 = eq u8_checked, 0
    ok_ucheck_07 = eq u16_checked, 0
    ok_ucheck_08 = eq u32_checked, 0
    ok_ucheck_09 = eq u64_checked, 0
    ok_ucheck_10 = eq usize_checked, 0
    ok_ucheck_11 = eq u64_value_ok, 1
    ok_ucheck_12 = eq u64_value, 64

    ok_isat_01 = eq i8_sat, 0
    ok_isat_02 = eq i16_sat, 0
    ok_isat_03 = eq i32_sat, 0
    ok_isat_04 = eq i64_sat, 0
    ok_isat_05 = eq isize_sat, 0
    ok_isat_06 = eq i64_sat_value, 64

    ok_icheck_01 = eq i8_checked_ok, 0
    ok_icheck_02 = eq i16_checked_ok, 0
    ok_icheck_03 = eq i32_checked_ok, 0
    ok_icheck_04 = eq i64_checked_ok, 0
    ok_icheck_05 = eq isize_checked_ok, 0
    ok_icheck_06 = eq i8_checked, 0
    ok_icheck_07 = eq i16_checked, 0
    ok_icheck_08 = eq i32_checked, 0
    ok_icheck_09 = eq i64_checked, 0
    ok_icheck_10 = eq isize_checked, 0
    ok_icheck_11 = eq i64_value_ok, 1
    ok_icheck_12 = eq i64_value, 64

    ok_01 = and ok_sat_01, ok_sat_02
    ok_02 = and ok_01, ok_sat_03
    ok_03 = and ok_02, ok_sat_04
    ok_04 = and ok_03, ok_sat_05
    ok_05 = and ok_04, ok_sat_06
    ok_06 = and ok_05, ok_ucheck_01
    ok_07 = and ok_06, ok_ucheck_02
    ok_08 = and ok_07, ok_ucheck_03
    ok_09 = and ok_08, ok_ucheck_04
    ok_10 = and ok_09, ok_ucheck_05
    ok_11 = and ok_10, ok_ucheck_06
    ok_12 = and ok_11, ok_ucheck_07
    ok_13 = and ok_12, ok_ucheck_08
    ok_14 = and ok_13, ok_ucheck_09
    ok_15 = and ok_14, ok_ucheck_10
    ok_16 = and ok_15, ok_ucheck_11
    ok_17 = and ok_16, ok_ucheck_12
    ok_18 = and ok_17, ok_isat_01
    ok_19 = and ok_18, ok_isat_02
    ok_20 = and ok_19, ok_isat_03
    ok_21 = and ok_20, ok_isat_04
    ok_22 = and ok_21, ok_isat_05
    ok_23 = and ok_22, ok_isat_06
    ok_24 = and ok_23, ok_icheck_01
    ok_25 = and ok_24, ok_icheck_02
    ok_26 = and ok_25, ok_icheck_03
    ok_27 = and ok_26, ok_icheck_04
    ok_28 = and ok_27, ok_icheck_05
    ok_29 = and ok_28, ok_icheck_06
    ok_30 = and ok_29, ok_icheck_07
    ok_31 = and ok_30, ok_icheck_08
    ok_32 = and ok_31, ok_icheck_09
    ok_33 = and ok_32, ok_icheck_10
    ok_34 = and ok_33, ok_icheck_11
    ok = and ok_34, ok_icheck_12
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10629)

L_PASS:
    !ok
    return 0
