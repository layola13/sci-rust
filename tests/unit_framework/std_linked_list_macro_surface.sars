@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list push pop front back"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_IS_EMPTY empty0, list
    EXPAND LINKED_LIST_PUSH_BACK list, 10
    EXPAND LINKED_LIST_PUSH_BACK list, 20
    EXPAND LINKED_LIST_PUSH_FRONT list, 5
    EXPAND LINKED_LIST_LEN len3, list
    EXPAND LINKED_LIST_TRY_FRONT front_ok, front, list
    EXPAND LINKED_LIST_TRY_BACK back_ok, back, list
    EXPAND LINKED_LIST_CONTAINS has_20, list, 20
    EXPAND LINKED_LIST_CONTAINS has_99, list, 99
    EXPAND LINKED_LIST_TRY_POP_FRONT popf_ok, popf, list
    EXPAND LINKED_LIST_TRY_POP_BACK popb_ok, popb, list
    EXPAND LINKED_LIST_LEN len1, list
    EXPAND LINKED_LIST_TRY_FRONT mid_ok, mid, list
    EXPAND LINKED_LIST_CLEAR list
    EXPAND LINKED_LIST_IS_EMPTY empty1, list
    EXPAND LINKED_LIST_TRY_POP_FRONT empty_pop_ok, empty_pop, list
    EXPAND LINKED_LIST_FREE list

    ok_empty0 = eq empty0, 1
    ok_len3 = eq len3, 3
    ok_front_flag = eq front_ok, 1
    ok_front = eq front, 5
    ok_back_flag = eq back_ok, 1
    ok_back = eq back, 20
    ok_has_20 = eq has_20, 1
    ok_has_99 = eq has_99, 0
    ok_popf_flag = eq popf_ok, 1
    ok_popf = eq popf, 5
    ok_popb_flag = eq popb_ok, 1
    ok_popb = eq popb, 20
    ok_len1 = eq len1, 1
    ok_mid_flag = eq mid_ok, 1
    ok_mid = eq mid, 10
    ok_empty1 = eq empty1, 1
    ok_empty_pop = eq empty_pop_ok, 0

    ok01 = and ok_empty0, ok_len3
    ok02 = and ok01, ok_front_flag
    ok03 = and ok02, ok_front
    ok04 = and ok03, ok_back_flag
    ok05 = and ok04, ok_back
    ok06 = and ok05, ok_has_20
    ok07 = and ok06, ok_has_99
    ok08 = and ok07, ok_popf_flag
    ok09 = and ok08, ok_popf
    ok10 = and ok09, ok_popb_flag
    ok11 = and ok10, ok_popb
    ok12 = and ok11, ok_len1
    ok13 = and ok12, ok_mid_flag
    ok14 = and ok13, ok_mid
    ok15 = and ok14, ok_empty1
    ok = and ok15, ok_empty_pop

    !empty0
    !len3
    !front_ok
    !front
    !back_ok
    !back
    !has_20
    !has_99
    !popf_ok
    !popf
    !popb_ok
    !popb
    !len1
    !mid_ok
    !mid
    !empty1
    !empty_pop_ok
    !empty_pop
    !ok_empty0
    !ok_len3
    !ok_front_flag
    !ok_front
    !ok_back_flag
    !ok_back
    !ok_has_20
    !ok_has_99
    !ok_popf_flag
    !ok_popf
    !ok_popb_flag
    !ok_popb
    !ok_len1
    !ok_mid_flag
    !ok_mid
    !ok_empty1
    !ok_empty_pop
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10863)

@test "sa_std linked_list append"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW a
    EXPAND LINKED_LIST_NEW b
    EXPAND LINKED_LIST_PUSH_BACK a, 1
    EXPAND LINKED_LIST_PUSH_BACK a, 2
    EXPAND LINKED_LIST_PUSH_BACK b, 3
    EXPAND LINKED_LIST_PUSH_BACK b, 4
    EXPAND LINKED_LIST_APPEND a, b
    EXPAND LINKED_LIST_LEN a_len, a
    EXPAND LINKED_LIST_IS_EMPTY b_empty, b
    EXPAND LINKED_LIST_TRY_FRONT a_front_ok, a_front, a
    EXPAND LINKED_LIST_TRY_BACK a_back_ok, a_back, a
    EXPAND LINKED_LIST_FREE a
    EXPAND LINKED_LIST_FREE b

    ok_len = eq a_len, 4
    ok_b_empty = eq b_empty, 1
    ok_front_flag = eq a_front_ok, 1
    ok_front = eq a_front, 1
    ok_back_flag = eq a_back_ok, 1
    ok_back = eq a_back, 4
    ok01 = and ok_len, ok_b_empty
    ok02 = and ok01, ok_front_flag
    ok03 = and ok02, ok_front
    ok04 = and ok03, ok_back_flag
    ok = and ok04, ok_back

    !a_len
    !b_empty
    !a_front_ok
    !a_front
    !a_back_ok
    !a_back
    !ok_len
    !ok_b_empty
    !ok_front_flag
    !ok_front
    !ok_back_flag
    !ok_back
    !ok01
    !ok02
    !ok03
    !ok04
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10864)
