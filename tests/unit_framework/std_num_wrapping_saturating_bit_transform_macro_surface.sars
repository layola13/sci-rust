@import "sa_std/num.sars"

@test "sa_std Wrapping and Saturating bit-transform macro surface"():
L_ENTRY:
    be64_one = add 0, 72057594037927936
    be32_one = add 0, 16777216

    wrap_u64 = stack_alloc WrappingU64_SIZE
    wrap_u64_be = stack_alloc WrappingU64_SIZE
    wrap_u64_rotl = stack_alloc WrappingU64_SIZE
    wrap_u64_rotr = stack_alloc WrappingU64_SIZE
    wrap_u64_rev = stack_alloc WrappingU64_SIZE
    wrap_u64_swap = stack_alloc WrappingU64_SIZE
    wrap_u64_to_be = stack_alloc WrappingU64_SIZE
    wrap_u64_from_be = stack_alloc WrappingU64_SIZE
    wrap_u64_to_le = stack_alloc WrappingU64_SIZE
    wrap_u64_from_le = stack_alloc WrappingU64_SIZE
    EXPAND WRAPPING_U64_NEW wrap_u64, 1
    EXPAND WRAPPING_U64_NEW wrap_u64_be, be64_one
    EXPAND WRAPPING_U64_ROTATE_LEFT wrap_u64_rotl, wrap_u64, 4
    EXPAND WRAPPING_U64_ROTATE_RIGHT wrap_u64_rotr, wrap_u64, 1
    EXPAND WRAPPING_U64_REVERSE_BITS wrap_u64_rev, wrap_u64
    EXPAND WRAPPING_U64_SWAP_BYTES wrap_u64_swap, wrap_u64
    EXPAND WRAPPING_U64_TO_BE wrap_u64_to_be, wrap_u64
    EXPAND WRAPPING_U64_FROM_BE wrap_u64_from_be, wrap_u64_be
    EXPAND WRAPPING_U64_TO_LE wrap_u64_to_le, wrap_u64
    EXPAND WRAPPING_U64_FROM_LE wrap_u64_from_le, wrap_u64_be

    wrap_u32 = stack_alloc WrappingU32_SIZE
    wrap_u32_be = stack_alloc WrappingU32_SIZE
    wrap_u32_rotl = stack_alloc WrappingU32_SIZE
    wrap_u32_rotr = stack_alloc WrappingU32_SIZE
    wrap_u32_rev = stack_alloc WrappingU32_SIZE
    wrap_u32_swap = stack_alloc WrappingU32_SIZE
    wrap_u32_to_be = stack_alloc WrappingU32_SIZE
    wrap_u32_from_be = stack_alloc WrappingU32_SIZE
    wrap_u32_to_le = stack_alloc WrappingU32_SIZE
    wrap_u32_from_le = stack_alloc WrappingU32_SIZE
    EXPAND WRAPPING_U32_NEW wrap_u32, 1
    EXPAND WRAPPING_U32_NEW wrap_u32_be, be32_one
    EXPAND WRAPPING_U32_ROTATE_LEFT wrap_u32_rotl, wrap_u32, 36
    EXPAND WRAPPING_U32_ROTATE_RIGHT wrap_u32_rotr, wrap_u32, 1
    EXPAND WRAPPING_U32_REVERSE_BITS wrap_u32_rev, wrap_u32
    EXPAND WRAPPING_U32_SWAP_BYTES wrap_u32_swap, wrap_u32
    EXPAND WRAPPING_U32_TO_BE wrap_u32_to_be, wrap_u32
    EXPAND WRAPPING_U32_FROM_BE wrap_u32_from_be, wrap_u32_be
    EXPAND WRAPPING_U32_TO_LE wrap_u32_to_le, wrap_u32
    EXPAND WRAPPING_U32_FROM_LE wrap_u32_from_le, wrap_u32_be

    wrap_i64 = stack_alloc WrappingI64_SIZE
    wrap_i64_be = stack_alloc WrappingI64_SIZE
    wrap_i64_rotl = stack_alloc WrappingI64_SIZE
    wrap_i64_rotr = stack_alloc WrappingI64_SIZE
    wrap_i64_rev = stack_alloc WrappingI64_SIZE
    wrap_i64_swap = stack_alloc WrappingI64_SIZE
    wrap_i64_to_be = stack_alloc WrappingI64_SIZE
    wrap_i64_from_be = stack_alloc WrappingI64_SIZE
    wrap_i64_to_le = stack_alloc WrappingI64_SIZE
    wrap_i64_from_le = stack_alloc WrappingI64_SIZE
    EXPAND WRAPPING_I64_NEW wrap_i64, 1
    EXPAND WRAPPING_I64_NEW wrap_i64_be, be64_one
    EXPAND WRAPPING_I64_ROTATE_LEFT wrap_i64_rotl, wrap_i64, 63
    EXPAND WRAPPING_I64_ROTATE_RIGHT wrap_i64_rotr, wrap_i64, 1
    EXPAND WRAPPING_I64_REVERSE_BITS wrap_i64_rev, wrap_i64
    EXPAND WRAPPING_I64_SWAP_BYTES wrap_i64_swap, wrap_i64
    EXPAND WRAPPING_I64_TO_BE wrap_i64_to_be, wrap_i64
    EXPAND WRAPPING_I64_FROM_BE wrap_i64_from_be, wrap_i64_be
    EXPAND WRAPPING_I64_TO_LE wrap_i64_to_le, wrap_i64
    EXPAND WRAPPING_I64_FROM_LE wrap_i64_from_le, wrap_i64_be

    sat_u64 = stack_alloc SaturatingU64_SIZE
    sat_u64_be = stack_alloc SaturatingU64_SIZE
    sat_u64_rotl = stack_alloc SaturatingU64_SIZE
    sat_u64_rotr = stack_alloc SaturatingU64_SIZE
    sat_u64_rev = stack_alloc SaturatingU64_SIZE
    sat_u64_swap = stack_alloc SaturatingU64_SIZE
    sat_u64_to_be = stack_alloc SaturatingU64_SIZE
    sat_u64_from_be = stack_alloc SaturatingU64_SIZE
    sat_u64_to_le = stack_alloc SaturatingU64_SIZE
    sat_u64_from_le = stack_alloc SaturatingU64_SIZE
    EXPAND SATURATING_U64_NEW sat_u64, 1
    EXPAND SATURATING_U64_NEW sat_u64_be, be64_one
    EXPAND SATURATING_U64_ROTATE_LEFT sat_u64_rotl, sat_u64, 4
    EXPAND SATURATING_U64_ROTATE_RIGHT sat_u64_rotr, sat_u64, 1
    EXPAND SATURATING_U64_REVERSE_BITS sat_u64_rev, sat_u64
    EXPAND SATURATING_U64_SWAP_BYTES sat_u64_swap, sat_u64
    EXPAND SATURATING_U64_TO_BE sat_u64_to_be, sat_u64
    EXPAND SATURATING_U64_FROM_BE sat_u64_from_be, sat_u64_be
    EXPAND SATURATING_U64_TO_LE sat_u64_to_le, sat_u64
    EXPAND SATURATING_U64_FROM_LE sat_u64_from_le, sat_u64_be

    sat_i64 = stack_alloc SaturatingI64_SIZE
    sat_i64_be = stack_alloc SaturatingI64_SIZE
    sat_i64_rotl = stack_alloc SaturatingI64_SIZE
    sat_i64_rotr = stack_alloc SaturatingI64_SIZE
    sat_i64_rev = stack_alloc SaturatingI64_SIZE
    sat_i64_swap = stack_alloc SaturatingI64_SIZE
    sat_i64_to_be = stack_alloc SaturatingI64_SIZE
    sat_i64_from_be = stack_alloc SaturatingI64_SIZE
    sat_i64_to_le = stack_alloc SaturatingI64_SIZE
    sat_i64_from_le = stack_alloc SaturatingI64_SIZE
    EXPAND SATURATING_I64_NEW sat_i64, NUM_I64_MIN
    EXPAND SATURATING_I64_NEW sat_i64_be, 128
    EXPAND SATURATING_I64_ROTATE_LEFT sat_i64_rotl, sat_i64, 1
    EXPAND SATURATING_I64_ROTATE_RIGHT sat_i64_rotr, sat_i64, 63
    EXPAND SATURATING_I64_REVERSE_BITS sat_i64_rev, sat_i64
    EXPAND SATURATING_I64_SWAP_BYTES sat_i64_swap, sat_i64
    EXPAND SATURATING_I64_TO_BE sat_i64_to_be, sat_i64
    EXPAND SATURATING_I64_FROM_BE sat_i64_from_be, sat_i64_be
    EXPAND SATURATING_I64_TO_LE sat_i64_to_le, sat_i64
    EXPAND SATURATING_I64_FROM_LE sat_i64_from_le, sat_i64_be

    EXPAND WRAPPING_U64_GET wrap_u64_rotl_value, wrap_u64_rotl
    EXPAND WRAPPING_U64_GET wrap_u64_rotr_value, wrap_u64_rotr
    EXPAND WRAPPING_U64_GET wrap_u64_rev_value, wrap_u64_rev
    EXPAND WRAPPING_U64_GET wrap_u64_swap_value, wrap_u64_swap
    EXPAND WRAPPING_U64_GET wrap_u64_to_be_value, wrap_u64_to_be
    EXPAND WRAPPING_U64_GET wrap_u64_from_be_value, wrap_u64_from_be
    EXPAND WRAPPING_U64_GET wrap_u64_to_le_value, wrap_u64_to_le
    EXPAND WRAPPING_U64_GET wrap_u64_from_le_value, wrap_u64_from_le
    EXPAND WRAPPING_U32_GET wrap_u32_rotl_value, wrap_u32_rotl
    EXPAND WRAPPING_U32_GET wrap_u32_rotr_value, wrap_u32_rotr
    EXPAND WRAPPING_U32_GET wrap_u32_rev_value, wrap_u32_rev
    EXPAND WRAPPING_U32_GET wrap_u32_swap_value, wrap_u32_swap
    EXPAND WRAPPING_U32_GET wrap_u32_to_be_value, wrap_u32_to_be
    EXPAND WRAPPING_U32_GET wrap_u32_from_be_value, wrap_u32_from_be
    EXPAND WRAPPING_U32_GET wrap_u32_to_le_value, wrap_u32_to_le
    EXPAND WRAPPING_U32_GET wrap_u32_from_le_value, wrap_u32_from_le
    EXPAND WRAPPING_I64_GET wrap_i64_rotl_value, wrap_i64_rotl
    EXPAND WRAPPING_I64_GET wrap_i64_rotr_value, wrap_i64_rotr
    EXPAND WRAPPING_I64_GET wrap_i64_rev_value, wrap_i64_rev
    EXPAND WRAPPING_I64_GET wrap_i64_swap_value, wrap_i64_swap
    EXPAND WRAPPING_I64_GET wrap_i64_to_be_value, wrap_i64_to_be
    EXPAND WRAPPING_I64_GET wrap_i64_from_be_value, wrap_i64_from_be
    EXPAND WRAPPING_I64_GET wrap_i64_to_le_value, wrap_i64_to_le
    EXPAND WRAPPING_I64_GET wrap_i64_from_le_value, wrap_i64_from_le
    EXPAND SATURATING_U64_GET sat_u64_rotl_value, sat_u64_rotl
    EXPAND SATURATING_U64_GET sat_u64_rotr_value, sat_u64_rotr
    EXPAND SATURATING_U64_GET sat_u64_rev_value, sat_u64_rev
    EXPAND SATURATING_U64_GET sat_u64_swap_value, sat_u64_swap
    EXPAND SATURATING_U64_GET sat_u64_to_be_value, sat_u64_to_be
    EXPAND SATURATING_U64_GET sat_u64_from_be_value, sat_u64_from_be
    EXPAND SATURATING_U64_GET sat_u64_to_le_value, sat_u64_to_le
    EXPAND SATURATING_U64_GET sat_u64_from_le_value, sat_u64_from_le
    EXPAND SATURATING_I64_GET sat_i64_rotl_value, sat_i64_rotl
    EXPAND SATURATING_I64_GET sat_i64_rotr_value, sat_i64_rotr
    EXPAND SATURATING_I64_GET sat_i64_rev_value, sat_i64_rev
    EXPAND SATURATING_I64_GET sat_i64_swap_value, sat_i64_swap
    EXPAND SATURATING_I64_GET sat_i64_to_be_value, sat_i64_to_be
    EXPAND SATURATING_I64_GET sat_i64_from_be_value, sat_i64_from_be
    EXPAND SATURATING_I64_GET sat_i64_to_le_value, sat_i64_to_le
    EXPAND SATURATING_I64_GET sat_i64_from_le_value, sat_i64_from_le

    ok01 = eq wrap_u64_rotl_value, 16
    ok02 = eq wrap_u64_rotr_value, NUM_I64_MIN
    ok03 = eq wrap_u64_rev_value, NUM_I64_MIN
    ok04 = eq wrap_u64_swap_value, be64_one
    ok05 = eq wrap_u64_to_be_value, be64_one
    ok06 = eq wrap_u64_from_be_value, 1
    ok07 = eq wrap_u64_to_le_value, 1
    ok08 = eq wrap_u64_from_le_value, be64_one
    ok09 = eq wrap_u32_rotl_value, 16
    ok10 = eq wrap_u32_rotr_value, 2147483648
    ok11 = eq wrap_u32_rev_value, 2147483648
    ok12 = eq wrap_u32_swap_value, be32_one
    ok13 = eq wrap_u32_to_be_value, be32_one
    ok14 = eq wrap_u32_from_be_value, 1
    ok15 = eq wrap_u32_to_le_value, 1
    ok16 = eq wrap_u32_from_le_value, be32_one
    ok17 = eq wrap_i64_rotl_value, NUM_I64_MIN
    ok18 = eq wrap_i64_rotr_value, NUM_I64_MIN
    ok19 = eq wrap_i64_rev_value, NUM_I64_MIN
    ok20 = eq wrap_i64_swap_value, be64_one
    ok21 = eq wrap_i64_to_be_value, be64_one
    ok22 = eq wrap_i64_from_be_value, 1
    ok23 = eq wrap_i64_to_le_value, 1
    ok24 = eq wrap_i64_from_le_value, be64_one
    ok25 = eq sat_u64_rotl_value, 16
    ok26 = eq sat_u64_rotr_value, NUM_I64_MIN
    ok27 = eq sat_u64_rev_value, NUM_I64_MIN
    ok28 = eq sat_u64_swap_value, be64_one
    ok29 = eq sat_u64_to_be_value, be64_one
    ok30 = eq sat_u64_from_be_value, 1
    ok31 = eq sat_u64_to_le_value, 1
    ok32 = eq sat_u64_from_le_value, be64_one
    ok33 = eq sat_i64_rotl_value, 1
    ok34 = eq sat_i64_rotr_value, 1
    ok35 = eq sat_i64_rev_value, 1
    ok36 = eq sat_i64_swap_value, 128
    ok37 = eq sat_i64_to_be_value, 128
    ok38 = eq sat_i64_from_be_value, NUM_I64_MIN
    ok39 = eq sat_i64_to_le_value, NUM_I64_MIN
    ok40 = eq sat_i64_from_le_value, 128

    c01 = and ok01, ok02
    c02 = and c01, ok03
    c03 = and c02, ok04
    c04 = and c03, ok05
    c05 = and c04, ok06
    c06 = and c05, ok07
    c07 = and c06, ok08
    c08 = and c07, ok09
    c09 = and c08, ok10
    c10 = and c09, ok11
    c11 = and c10, ok12
    c12 = and c11, ok13
    c13 = and c12, ok14
    c14 = and c13, ok15
    c15 = and c14, ok16
    c16 = and c15, ok17
    c17 = and c16, ok18
    c18 = and c17, ok19
    c19 = and c18, ok20
    c20 = and c19, ok21
    c21 = and c20, ok22
    c22 = and c21, ok23
    c23 = and c22, ok24
    c24 = and c23, ok25
    c25 = and c24, ok26
    c26 = and c25, ok27
    c27 = and c26, ok28
    c28 = and c27, ok29
    c29 = and c28, ok30
    c30 = and c29, ok31
    c31 = and c30, ok32
    c32 = and c31, ok33
    c33 = and c32, ok34
    c34 = and c33, ok35
    c35 = and c34, ok36
    c36 = and c35, ok37
    c37 = and c36, ok38
    c38 = and c37, ok39
    ok = and c38, ok40

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10618)

L_PASS:
    !ok
    return 0
