@import "sa_std/time.sars"

@test "sa_std duration zero is_zero"():
L_ENTRY:
    EXPAND TIME_DURATION_ZERO z
    EXPAND TIME_DURATION_IS_ZERO isz, z
    EXPAND TIME_DURATION_FROM_NS one, 1
    EXPAND TIME_DURATION_IS_ZERO is1, one
    a = eq isz, 1
    b = eq is1, 0
    ok = and a, b
    !z
    !isz
    !one
    !is1
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10947)
