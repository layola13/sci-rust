@import "sa_std/net.sars"

// DNS 主机名解析测试。
// 验证 tcp_listen / udp_bind 现在能接受主机名（走 getaddrinfo 路径），
// 而不再是仅接受 IP 字面量。使用 "localhost"（本地必解析，不依赖外网）。
@const DNS_TEST_HOST = utf8:"localhost"

@test "sa_std net tcp listen resolves hostname"():
L_ENTRY:
    // 端口 0 让内核分配；主机名 "localhost" 需经 getaddrinfo 解析为 127.0.0.1 / ::1。
    EXPAND NET_TCP_LISTENER_BIND_PORT bind_status, listener, bound_port, DNS_TEST_HOST, 9, 0
    bind_ok = eq bind_status, SA_NET_OK
    listener_ok = ne listener, 0
    port_ok = ne bound_port, 0
    all01 = and bind_ok, listener_ok
    all = and all01, port_ok
    !bound_port
    !bind_status
    br all -> L_CLOSE, L_FAIL

L_FAIL:
    !all
    !all01
    !port_ok
    !listener_ok
    !bind_ok
    !listener
    panic(10074)

L_CLOSE:
    EXPAND NET_TCP_LISTENER_CLOSE close_status, listener
    !close_status
    !listener
    return 0

@test "sa_std net udp bind resolves hostname"():
L_ENTRY:
    EXPAND NET_UDP_BIND bind_status, socket, DNS_TEST_HOST, 9, 0
    bind_ok = eq bind_status, SA_NET_OK
    socket_ok = ne socket, 0
    all = and bind_ok, socket_ok
    !bind_status
    br all -> L_CLOSE, L_FAIL

L_FAIL:
    !all
    !socket_ok
    !bind_ok
    !socket
    panic(10075)

L_CLOSE:
    EXPAND NET_UDP_CLOSE close_status, socket
    !close_status
    !socket
    return 0
