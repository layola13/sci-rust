@import "sa_std/time.sars"

@test "sa_std duration saturating_add"():
L_ENTRY:
    EXPAND TIME_DURATION_MAX mx
    EXPAND TIME_DURATION_FROM_NS one, 1
    EXPAND TIME_DURATION_SATURATING_ADD sum, mx, one
    ok = eq sum, mx
    !mx
    !one
    !sum
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(11007)
