@import "sa_std/path.sars"
@import "sa_std/string.sars"

@const P = utf8:"/tmp"

@test "sa_std path is_dir"():
L_ENTRY:
    EXPAND STR_FROM_PARTS p, &P, 4
    EXPAND PATH_IS_DIR is_dir, p
    EXPAND PATH_IS_FILE is_file, p
    a = eq is_dir, 1
    b = eq is_file, 0
    ok = and a, b
    !is_dir
    !is_file
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10995)
