@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@test "sa_std iter array chunks collect macro surface"():
L_ENTRY:
    values = stack_alloc 40
    partial_values = stack_alloc 48
    exact_values = stack_alloc 32

    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    store partial_values+0, 10 as u64
    store partial_values+8, 20 as u64
    store partial_values+16, 30 as u64
    store partial_values+24, 40 as u64
    store partial_values+32, 50 as u64
    store partial_values+40, 60 as u64

    store exact_values+0, 7 as u64
    store exact_values+8, 8 as u64
    store exact_values+16, 9 as u64
    store exact_values+24, 10 as u64

    slice = alloc Slice_SIZE
    partial_slice = alloc Slice_SIZE
    exact_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW partial_slice, partial_values, 6
    EXPAND SLICE_NEW exact_slice, exact_values, 4

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_ARRAY_CHUNKS_COLLECT_U64 chunks_ok, chunks_vec, iter, 2
    EXPAND VEC_LEN chunks_len, chunks_vec
    EXPAND VEC_GET_U64 chunks_0, chunks_vec, 0
    EXPAND VEC_GET_U64 chunks_1, chunks_vec, 1
    EXPAND VEC_GET_U64 chunks_2, chunks_vec, 2
    EXPAND VEC_GET_U64 chunks_3, chunks_vec, 3
    EXPAND ITER_LEN chunks_remaining, iter
    EXPAND ITER_NEXT_U64 chunks_tail_ok, chunks_tail, iter
    EXPAND ITER_IS_EMPTY chunks_empty_after_tail, iter

    EXPAND ITER_FROM_SLICE partial_iter, partial_slice
    EXPAND ITER_NEXT_U64 partial_first_ok, partial_first, partial_iter
    EXPAND ITER_ARRAY_CHUNKS_COLLECT_U64 partial_ok, partial_vec, partial_iter, 2
    EXPAND VEC_LEN partial_len, partial_vec
    EXPAND VEC_GET_U64 partial_0, partial_vec, 0
    EXPAND VEC_GET_U64 partial_1, partial_vec, 1
    EXPAND VEC_GET_U64 partial_2, partial_vec, 2
    EXPAND VEC_GET_U64 partial_3, partial_vec, 3
    EXPAND ITER_NEXT_U64 partial_tail_ok, partial_tail, partial_iter
    EXPAND ITER_IS_EMPTY partial_empty_after_tail, partial_iter

    EXPAND ITER_FROM_SLICE exact_iter, exact_slice
    EXPAND ITER_ARRAY_CHUNKS_COLLECT_U64 exact_ok, exact_vec, exact_iter, 2
    EXPAND VEC_LEN exact_len, exact_vec
    EXPAND VEC_GET_U64 exact_0, exact_vec, 0
    EXPAND VEC_GET_U64 exact_3, exact_vec, 3
    EXPAND ITER_IS_EMPTY exact_empty, exact_iter

    EXPAND ITER_FROM_SLICE large_iter, slice
    EXPAND ITER_ARRAY_CHUNKS_COLLECT_U64 large_ok, large_vec, large_iter, 8
    EXPAND VEC_LEN large_len, large_vec
    EXPAND ITER_LEN large_remaining_before_next, large_iter
    EXPAND ITER_NEXT_U64 large_next_ok, large_next, large_iter
    EXPAND ITER_LEN large_remaining_after_next, large_iter

    EXPAND ITER_FROM_SLICE zero_iter, slice
    EXPAND ITER_ARRAY_CHUNKS_COLLECT_U64 zero_ok, zero_vec, zero_iter, 0
    EXPAND VEC_LEN zero_len, zero_vec
    EXPAND ITER_LEN zero_remaining_before_next, zero_iter
    EXPAND ITER_NEXT_U64 zero_next_ok, zero_next, zero_iter
    EXPAND ITER_LEN zero_remaining_after_next, zero_iter

    ok_chunks_ok = eq chunks_ok, 1
    ok_chunks_len = eq chunks_len, 4
    ok_chunks_0 = eq chunks_0, 1
    ok_chunks_1 = eq chunks_1, 2
    ok_chunks_2 = eq chunks_2, 3
    ok_chunks_3 = eq chunks_3, 4
    ok_chunks_remaining = eq chunks_remaining, 1
    ok_chunks_tail_ok = eq chunks_tail_ok, 1
    ok_chunks_tail = eq chunks_tail, 5
    ok_chunks_empty_after_tail = eq chunks_empty_after_tail, 1

    ok_partial_first_ok = eq partial_first_ok, 1
    ok_partial_first = eq partial_first, 10
    ok_partial_ok = eq partial_ok, 1
    ok_partial_len = eq partial_len, 4
    ok_partial_0 = eq partial_0, 20
    ok_partial_1 = eq partial_1, 30
    ok_partial_2 = eq partial_2, 40
    ok_partial_3 = eq partial_3, 50
    ok_partial_tail_ok = eq partial_tail_ok, 1
    ok_partial_tail = eq partial_tail, 60
    ok_partial_empty_after_tail = eq partial_empty_after_tail, 1

    ok_exact_ok = eq exact_ok, 1
    ok_exact_len = eq exact_len, 4
    ok_exact_0 = eq exact_0, 7
    ok_exact_3 = eq exact_3, 10
    ok_exact_empty = eq exact_empty, 1

    ok_large_ok = eq large_ok, 1
    ok_large_len = eq large_len, 0
    ok_large_remaining_before = eq large_remaining_before_next, 5
    ok_large_next_ok = eq large_next_ok, 1
    ok_large_next = eq large_next, 1
    ok_large_remaining_after = eq large_remaining_after_next, 4

    ok_zero_ok = eq zero_ok, 0
    ok_zero_len = eq zero_len, 0
    ok_zero_remaining_before = eq zero_remaining_before_next, 5
    ok_zero_next_ok = eq zero_next_ok, 1
    ok_zero_next = eq zero_next, 1
    ok_zero_remaining_after = eq zero_remaining_after_next, 4

    c01 = and ok_chunks_ok, ok_chunks_len
    c02 = and c01, ok_chunks_0
    c03 = and c02, ok_chunks_1
    c04 = and c03, ok_chunks_2
    c05 = and c04, ok_chunks_3
    c06 = and c05, ok_chunks_remaining
    c07 = and c06, ok_chunks_tail_ok
    c08 = and c07, ok_chunks_tail
    c09 = and c08, ok_chunks_empty_after_tail
    c10 = and c09, ok_partial_first_ok
    c11 = and c10, ok_partial_first
    c12 = and c11, ok_partial_ok
    c13 = and c12, ok_partial_len
    c14 = and c13, ok_partial_0
    c15 = and c14, ok_partial_1
    c16 = and c15, ok_partial_2
    c17 = and c16, ok_partial_3
    c18 = and c17, ok_partial_tail_ok
    c19 = and c18, ok_partial_tail
    c20 = and c19, ok_partial_empty_after_tail
    c21 = and c20, ok_exact_ok
    c22 = and c21, ok_exact_len
    c23 = and c22, ok_exact_0
    c24 = and c23, ok_exact_3
    c25 = and c24, ok_exact_empty
    c26 = and c25, ok_large_ok
    c27 = and c26, ok_large_len
    c28 = and c27, ok_large_remaining_before
    c29 = and c28, ok_large_next_ok
    c30 = and c29, ok_large_next
    c31 = and c30, ok_large_remaining_after
    c32 = and c31, ok_zero_ok
    c33 = and c32, ok_zero_len
    c34 = and c33, ok_zero_remaining_before
    c35 = and c34, ok_zero_next_ok
    c36 = and c35, ok_zero_next
    ok = and c36, ok_zero_remaining_after

    !chunks_ok
    !chunks_len
    !chunks_0
    !chunks_1
    !chunks_2
    !chunks_3
    !chunks_remaining
    !chunks_tail_ok
    !chunks_tail
    !chunks_empty_after_tail
    !partial_first_ok
    !partial_first
    !partial_ok
    !partial_len
    !partial_0
    !partial_1
    !partial_2
    !partial_3
    !partial_tail_ok
    !partial_tail
    !partial_empty_after_tail
    !exact_ok
    !exact_len
    !exact_0
    !exact_3
    !exact_empty
    !large_ok
    !large_len
    !large_remaining_before_next
    !large_next_ok
    !large_next
    !large_remaining_after_next
    !zero_ok
    !zero_len
    !zero_remaining_before_next
    !zero_next_ok
    !zero_next
    !zero_remaining_after_next
    !ok_chunks_ok
    !ok_chunks_len
    !ok_chunks_0
    !ok_chunks_1
    !ok_chunks_2
    !ok_chunks_3
    !ok_chunks_remaining
    !ok_chunks_tail_ok
    !ok_chunks_tail
    !ok_chunks_empty_after_tail
    !ok_partial_first_ok
    !ok_partial_first
    !ok_partial_ok
    !ok_partial_len
    !ok_partial_0
    !ok_partial_1
    !ok_partial_2
    !ok_partial_3
    !ok_partial_tail_ok
    !ok_partial_tail
    !ok_partial_empty_after_tail
    !ok_exact_ok
    !ok_exact_len
    !ok_exact_0
    !ok_exact_3
    !ok_exact_empty
    !ok_large_ok
    !ok_large_len
    !ok_large_remaining_before
    !ok_large_next_ok
    !ok_large_next
    !ok_large_remaining_after
    !ok_zero_ok
    !ok_zero_len
    !ok_zero_remaining_before
    !ok_zero_next_ok
    !ok_zero_next
    !ok_zero_remaining_after
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !c19
    !c20
    !c21
    !c22
    !c23
    !c24
    !c25
    !c26
    !c27
    !c28
    !c29
    !c30
    !c31
    !c32
    !c33
    !c34
    !c35
    !c36
    !zero_iter
    !large_iter
    !exact_iter
    !partial_iter
    !iter
    !exact_slice
    !partial_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE large_vec
    EXPAND VEC_FREE exact_vec
    EXPAND VEC_FREE partial_vec
    EXPAND VEC_FREE chunks_vec
    panic(10550)

L_PASS:
    !ok
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE large_vec
    EXPAND VEC_FREE exact_vec
    EXPAND VEC_FREE partial_vec
    EXPAND VEC_FREE chunks_vec
    return 0
