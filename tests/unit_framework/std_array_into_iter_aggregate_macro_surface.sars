@import "sa_std/array.sars"

@array_into_iter_reduce_tens(acc: u64, value: u64) -> u64:
L_ENTRY:
    scaled = mul value, 10
    out = add acc, scaled
    !scaled
    return out

@array_into_iter_try_reduce_lt_four(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_ARRAY_TRY_REDUCE_KEEP, L_ARRAY_TRY_REDUCE_STOP
L_ARRAY_TRY_REDUCE_KEEP:
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep
L_ARRAY_TRY_REDUCE_STOP:
    !out_next
    !value
    !acc
    return keep

@array_into_iter_try_reduce_lt_ten(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 10
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep

@test "sa_std array into_iter aggregate macro surface"():
L_ENTRY:
    sum_arr = stack_alloc 24
    store sum_arr+0, 2 as u64
    store sum_arr+8, 3 as u64
    store sum_arr+16, 4 as u64
    EXPAND ARRAY_INTO_ITER_U64 sum_iter, sum_backing, sum_arr, 3
    EXPAND ARRAY_INTO_ITER_SUM_U64 sum_value, sum_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 sum_empty, sum_iter

    product_arr = stack_alloc 24
    store product_arr+0, 2 as u64
    store product_arr+8, 3 as u64
    store product_arr+16, 4 as u64
    EXPAND ARRAY_INTO_ITER_U64 product_iter, product_backing, product_arr, 3
    EXPAND ARRAY_INTO_ITER_PRODUCT_U64 product_value, product_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 product_empty, product_iter

    min_arr = stack_alloc 24
    store min_arr+0, 8 as u64
    store min_arr+8, 3 as u64
    store min_arr+16, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 min_iter, min_backing, min_arr, 3
    EXPAND ARRAY_INTO_ITER_MIN_U64 min_has, min_value, min_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 min_empty, min_iter

    max_arr = stack_alloc 24
    store max_arr+0, 8 as u64
    store max_arr+8, 3 as u64
    store max_arr+16, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 max_iter, max_backing, max_arr, 3
    EXPAND ARRAY_INTO_ITER_MAX_U64 max_has, max_value, max_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 max_empty, max_iter

    reduce_arr = stack_alloc 24
    store reduce_arr+0, 1 as u64
    store reduce_arr+8, 2 as u64
    store reduce_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 reduce_iter, reduce_backing, reduce_arr, 3
    EXPAND ARRAY_INTO_ITER_REDUCE_U64 reduce_has, reduce_value, reduce_iter, @array_into_iter_reduce_tens
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 reduce_empty, reduce_iter

    EXPAND ARRAY_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND ARRAY_INTO_ITER_MIN_U64 empty_min_has, empty_min_value, empty_iter
    EXPAND ARRAY_INTO_ITER_REDUCE_U64 empty_reduce_has, empty_reduce_value, empty_iter, @array_into_iter_reduce_tens
    EXPAND ARRAY_INTO_ITER_SUM_U64 empty_sum, empty_iter
    EXPAND ARRAY_INTO_ITER_PRODUCT_U64 empty_product, empty_iter

    try_stop_arr = stack_alloc 32
    store try_stop_arr+0, 1 as u64
    store try_stop_arr+8, 2 as u64
    store try_stop_arr+16, 4 as u64
    store try_stop_arr+24, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 try_stop_iter, try_stop_backing, try_stop_arr, 4
    EXPAND ARRAY_INTO_ITER_TRY_REDUCE_U64 try_stop_ok, try_stop_has, try_stop_value, try_stop_iter, @array_into_iter_try_reduce_lt_four
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 try_stop_remaining, try_stop_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 try_stop_next_has, try_stop_next, try_stop_iter

    try_all_arr = stack_alloc 24
    store try_all_arr+0, 1 as u64
    store try_all_arr+8, 2 as u64
    store try_all_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 try_all_iter, try_all_backing, try_all_arr, 3
    EXPAND ARRAY_INTO_ITER_TRY_REDUCE_U64 try_all_ok, try_all_has, try_all_value, try_all_iter, @array_into_iter_try_reduce_lt_ten
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 try_all_empty, try_all_iter

    EXPAND VEC_FREE sum_backing
    EXPAND VEC_FREE product_backing
    EXPAND VEC_FREE min_backing
    EXPAND VEC_FREE max_backing
    EXPAND VEC_FREE reduce_backing
    EXPAND VEC_FREE empty_backing
    EXPAND VEC_FREE try_stop_backing
    EXPAND VEC_FREE try_all_backing

    ok_sum_value = eq sum_value, 9
    ok_sum_empty = eq sum_empty, 1
    ok_product_value = eq product_value, 24
    ok_product_empty = eq product_empty, 1
    ok_min_has = eq min_has, 1
    ok_min_value = eq min_value, 3
    ok_min_empty = eq min_empty, 1
    ok_max_has = eq max_has, 1
    ok_max_value = eq max_value, 8
    ok_max_empty = eq max_empty, 1
    ok_reduce_has = eq reduce_has, 1
    ok_reduce_value = eq reduce_value, 51
    ok_reduce_empty = eq reduce_empty, 1
    ok_empty_min_has = eq empty_min_has, 0
    ok_empty_min_value = eq empty_min_value, 0
    ok_empty_reduce_has = eq empty_reduce_has, 0
    ok_empty_reduce_value = eq empty_reduce_value, 0
    ok_empty_sum = eq empty_sum, 0
    ok_empty_product = eq empty_product, 1
    ok_try_stop_ok = eq try_stop_ok, 0
    ok_try_stop_has = eq try_stop_has, 0
    ok_try_stop_value = eq try_stop_value, 21
    ok_try_stop_remaining = eq try_stop_remaining, 1
    ok_try_stop_next_has = eq try_stop_next_has, 1
    ok_try_stop_next = eq try_stop_next, 5
    ok_try_all_ok = eq try_all_ok, 1
    ok_try_all_has = eq try_all_has, 1
    ok_try_all_value = eq try_all_value, 51
    ok_try_all_empty = eq try_all_empty, 1

    ok = and ok_sum_value, ok_sum_empty
    ok = and ok, ok_product_value
    ok = and ok, ok_product_empty
    ok = and ok, ok_min_has
    ok = and ok, ok_min_value
    ok = and ok, ok_min_empty
    ok = and ok, ok_max_has
    ok = and ok, ok_max_value
    ok = and ok, ok_max_empty
    ok = and ok, ok_reduce_has
    ok = and ok, ok_reduce_value
    ok = and ok, ok_reduce_empty
    ok = and ok, ok_empty_min_has
    ok = and ok, ok_empty_min_value
    ok = and ok, ok_empty_reduce_has
    ok = and ok, ok_empty_reduce_value
    ok = and ok, ok_empty_sum
    ok = and ok, ok_empty_product
    ok = and ok, ok_try_stop_ok
    ok = and ok, ok_try_stop_has
    ok = and ok, ok_try_stop_value
    ok = and ok, ok_try_stop_remaining
    ok = and ok, ok_try_stop_next_has
    ok = and ok, ok_try_stop_next
    ok = and ok, ok_try_all_ok
    ok = and ok, ok_try_all_has
    ok = and ok, ok_try_all_value
    ok = and ok, ok_try_all_empty

    !sum_value
    !sum_empty
    !product_value
    !product_empty
    !min_has
    !min_value
    !min_empty
    !max_has
    !max_value
    !max_empty
    !reduce_has
    !reduce_value
    !reduce_empty
    !empty_min_has
    !empty_min_value
    !empty_reduce_has
    !empty_reduce_value
    !empty_sum
    !empty_product
    !try_stop_ok
    !try_stop_has
    !try_stop_value
    !try_stop_remaining
    !try_stop_next_has
    !try_stop_next
    !try_all_ok
    !try_all_has
    !try_all_value
    !try_all_empty
    !ok_sum_value
    !ok_sum_empty
    !ok_product_value
    !ok_product_empty
    !ok_min_has
    !ok_min_value
    !ok_min_empty
    !ok_max_has
    !ok_max_value
    !ok_max_empty
    !ok_reduce_has
    !ok_reduce_value
    !ok_reduce_empty
    !ok_empty_min_has
    !ok_empty_min_value
    !ok_empty_reduce_has
    !ok_empty_reduce_value
    !ok_empty_sum
    !ok_empty_product
    !ok_try_stop_ok
    !ok_try_stop_has
    !ok_try_stop_value
    !ok_try_stop_remaining
    !ok_try_stop_next_has
    !ok_try_stop_next
    !ok_try_all_ok
    !ok_try_all_has
    !ok_try_all_value
    !ok_try_all_empty
    !sum_iter
    !product_iter
    !min_iter
    !max_iter
    !reduce_iter
    !empty_iter
    !try_stop_iter
    !try_all_iter
    br ok -> L_ARRAY_INTO_ITER_AGGREGATE_OK, L_ARRAY_INTO_ITER_AGGREGATE_FAIL

L_ARRAY_INTO_ITER_AGGREGATE_FAIL:
    !ok
    panic(10740)

L_ARRAY_INTO_ITER_AGGREGATE_OK:
    !ok
    return
