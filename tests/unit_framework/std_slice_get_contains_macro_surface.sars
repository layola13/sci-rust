@import "sa_std/core/slice.sars"

@test "sa_std slice get contains"():
L_ENTRY:
    buf = alloc 24
    store buf+0, 1 as u64
    store buf+8, 2 as u64
    store buf+16, 3 as u64
    slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW slice, buf, 3
    EXPAND SLICE_GET_U64 v1, slice, 1
    EXPAND SLICE_CONTAINS_U64 has2, slice, 2
    EXPAND SLICE_CONTAINS_U64 has9, slice, 9
    EXPAND SLICE_GET_LEN ln, slice
    a = eq v1, 2
    b = eq has2, 1
    c = eq has9, 0
    d = eq ln, 3
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !v1
    !has2
    !has9
    !ln
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    !buf
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10929)
