@import "sa_std/num.sars"

[MACRO] CHECK_NONZERO_U8_MIN_MAX %out_ok
    u8_left = stack_alloc NonZeroU8_SIZE
    u8_same = stack_alloc NonZeroU8_SIZE
    u8_greater = stack_alloc NonZeroU8_SIZE
    u8_min = stack_alloc NonZeroU8_SIZE
    u8_max = stack_alloc NonZeroU8_SIZE
    u8_min_rev = stack_alloc NonZeroU8_SIZE
    u8_max_rev = stack_alloc NonZeroU8_SIZE
    u8_min_tie = stack_alloc NonZeroU8_SIZE
    u8_max_tie = stack_alloc NonZeroU8_SIZE
    EXPAND NONZERO_U8_NEW ok_u8_left, u8_left, 7
    EXPAND NONZERO_U8_NEW ok_u8_same, u8_same, 7
    EXPAND NONZERO_U8_NEW ok_u8_greater, u8_greater, 9
    EXPAND NONZERO_U8_MIN u8_min, u8_left, u8_greater
    EXPAND NONZERO_U8_MAX u8_max, u8_left, u8_greater
    EXPAND NONZERO_U8_MIN u8_min_rev, u8_greater, u8_left
    EXPAND NONZERO_U8_MAX u8_max_rev, u8_greater, u8_left
    EXPAND NONZERO_U8_MIN u8_min_tie, u8_left, u8_same
    EXPAND NONZERO_U8_MAX u8_max_tie, u8_left, u8_same
    EXPAND NONZERO_U8_GET u8_min_value, u8_min
    EXPAND NONZERO_U8_GET u8_max_value, u8_max
    EXPAND NONZERO_U8_GET u8_min_rev_value, u8_min_rev
    EXPAND NONZERO_U8_GET u8_max_rev_value, u8_max_rev
    EXPAND NONZERO_U8_GET u8_min_tie_value, u8_min_tie
    EXPAND NONZERO_U8_GET u8_max_tie_value, u8_max_tie
    u8_ok_new_left = eq ok_u8_left, 1
    u8_ok_new_same = eq ok_u8_same, 1
    u8_ok_new_greater = eq ok_u8_greater, 1
    u8_ok_min = eq u8_min_value, 7
    u8_ok_max = eq u8_max_value, 9
    u8_ok_min_rev = eq u8_min_rev_value, 7
    u8_ok_max_rev = eq u8_max_rev_value, 9
    u8_ok_min_tie = eq u8_min_tie_value, 7
    u8_ok_max_tie = eq u8_max_tie_value, 7
    u8_ok_chain_01 = and u8_ok_new_left, u8_ok_new_same
    u8_ok_chain_02 = and u8_ok_chain_01, u8_ok_new_greater
    u8_ok_chain_03 = and u8_ok_chain_02, u8_ok_min
    u8_ok_chain_04 = and u8_ok_chain_03, u8_ok_max
    u8_ok_chain_05 = and u8_ok_chain_04, u8_ok_min_rev
    u8_ok_chain_06 = and u8_ok_chain_05, u8_ok_max_rev
    u8_ok_chain_07 = and u8_ok_chain_06, u8_ok_min_tie
    u8_ok_chain_08 = and u8_ok_chain_07, u8_ok_max_tie
    %out_ok = add u8_ok_chain_08, 0
[END_MACRO]

