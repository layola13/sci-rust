@test "sa_std nonzero integer min max macro surface"():
L_ENTRY:
    EXPAND CHECK_NONZERO_U8_MIN_MAX ok_u8
    EXPAND CHECK_NONZERO_U16_MIN_MAX ok_u16
    EXPAND CHECK_NONZERO_U32_MIN_MAX ok_u32
    EXPAND CHECK_NONZERO_U64_MIN_MAX ok_u64
    EXPAND CHECK_NONZERO_USIZE_MIN_MAX ok_usize
    EXPAND CHECK_NONZERO_I8_MIN_MAX ok_i8
    EXPAND CHECK_NONZERO_I16_MIN_MAX ok_i16
    EXPAND CHECK_NONZERO_I32_MIN_MAX ok_i32
    EXPAND CHECK_NONZERO_I64_MIN_MAX ok_i64
    EXPAND CHECK_NONZERO_ISIZE_MIN_MAX ok_isize
    ok_all_u16 = and ok_u8, ok_u16
    ok_all_u32 = and ok_all_u16, ok_u32
    ok_all_u64 = and ok_all_u32, ok_u64
    ok_all_usize = and ok_all_u64, ok_usize
    ok_all_i8 = and ok_all_usize, ok_i8
    ok_all_i16 = and ok_all_i8, ok_i16
    ok_all_i32 = and ok_all_i16, ok_i32
    ok_all_i64 = and ok_all_i32, ok_i64
    ok_all_isize = and ok_all_i64, ok_isize
    ok = add ok_all_isize, 0
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10606)

L_PASS:
    !ok
    return 0
