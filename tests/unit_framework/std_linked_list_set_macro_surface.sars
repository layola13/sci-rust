@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list try_set"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 1
    EXPAND LINKED_LIST_PUSH_BACK list, 2
    EXPAND LINKED_LIST_PUSH_BACK list, 3
    EXPAND LINKED_LIST_TRY_SET s_ok, list, 1, 99
    EXPAND LINKED_LIST_TRY_GET g_ok, g, list, 1
    EXPAND LINKED_LIST_TRY_SET oob, list, 5, 0
    EXPAND LINKED_LIST_FREE list

    a = eq s_ok, 1
    b = eq g_ok, 1
    c = eq g, 99
    d = eq oob, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !s_ok
    !g_ok
    !g
    !oob
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10880)
