    EXPAND VEC_DEQUE_ITER_LT_U64 lt_value, lt_left_iter, lt_right_iter
    EXPAND VEC_DEQUE_ITER_U64 le_left_iter, le_left_backing, partial_right_deque
    EXPAND VEC_DEQUE_ITER_U64 le_right_iter, le_right_backing, partial_right_deque
    EXPAND VEC_DEQUE_ITER_LE_U64 le_value, le_left_iter, le_right_iter
    EXPAND VEC_DEQUE_ITER_U64 gt_left_iter, gt_left_backing, cmp_right_deque
    EXPAND VEC_DEQUE_ITER_U64 gt_right_iter, gt_right_backing, cmp_left_deque
