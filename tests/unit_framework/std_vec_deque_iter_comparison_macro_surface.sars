    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 min_by_empty, min_by_iter

    EXPAND VEC_DEQUE_ITER_U64 max_by_iter, max_by_backing, min_by_deque
    EXPAND VEC_DEQUE_ITER_MAX_BY_U64 max_by_ok, max_by_value, max_by_iter, @vec_deque_iter_cmp_compare_u64

    EXPAND VEC_DEQUE_WITH_CAPACITY key_deque, 4
