    EXPAND VEC_DEQUE_ITER_U64 ge_right_iter, ge_right_backing, partial_right_deque
    EXPAND VEC_DEQUE_ITER_GE_U64 ge_value, ge_left_iter, ge_right_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 39
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 41
