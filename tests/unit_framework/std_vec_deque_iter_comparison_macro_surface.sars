@import "sa_std/vec_deque.sars"

@vec_deque_iter_cmp_compare_u64(left: u64, right: u64) -> i64:
L_ENTRY:
    is_less = ult left, right
    br is_less -> L_VEC_DEQUE_CMP_LESS, L_VEC_DEQUE_CMP_CHECK_GREATER
L_VEC_DEQUE_CMP_LESS:
    out_less = sub 0, 1
    !is_less
    !right
    !left
    return out_less
L_VEC_DEQUE_CMP_CHECK_GREATER:
    is_greater = ugt left, right
    br is_greater -> L_VEC_DEQUE_CMP_GREATER, L_VEC_DEQUE_CMP_EQUAL
L_VEC_DEQUE_CMP_GREATER:
    out_greater = add 0, 1
    !is_greater
    !is_less
    !right
    !left
    return out_greater
L_VEC_DEQUE_CMP_EQUAL:
    out_equal = add 0, 0
    !is_greater
    !is_less
    !right
    !left
    return out_equal

@vec_deque_iter_cmp_key_ones(value: u64) -> u64:
L_ENTRY:
    out = urem value, 10
    !value
    return out

@vec_deque_iter_cmp_partial_none_on_99(left: u64, right: u64, &out_order: ptr) -> u64:
L_ENTRY:
    left_bad = eq left, 99
    right_bad = eq right, 99
    bad = or left_bad, right_bad
    br bad -> L_VEC_DEQUE_PARTIAL_CMP_NONE, L_VEC_DEQUE_PARTIAL_CMP_SOME
L_VEC_DEQUE_PARTIAL_CMP_SOME:
    order = call @vec_deque_iter_cmp_compare_u64(left, right)
    store out_order+0, order as i64
    !order
    !bad
    !right_bad
    !left_bad
    !out_order
    !right
    !left
    return 1
L_VEC_DEQUE_PARTIAL_CMP_NONE:
    !bad
    !right_bad
    !left_bad
    !out_order
    !right
    !left
    return 0

@vec_deque_iter_cmp_eq_mod10(left: u64, right: u64) -> u64:
L_ENTRY:
    left_key = urem left, 10
    right_key = urem right, 10
    out = eq left_key, right_key
    !right_key
    !left_key
    !right
    !left
    return out

@test "sa_std vec_deque iterator comparison macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY min_by_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK min_by_deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK min_by_deque, 20
