    br ok -> L_VEC_DEQUE_ITER_CMP_OK, L_VEC_DEQUE_ITER_CMP_FAIL
L_VEC_DEQUE_ITER_CMP_FAIL:
    !ok
    panic(10791)
L_VEC_DEQUE_ITER_CMP_OK:
    !ok
    return
