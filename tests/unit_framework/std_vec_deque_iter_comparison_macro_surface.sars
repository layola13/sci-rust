    EXPAND VEC_DEQUE_ITER_MIN_BY_KEY_U64 min_key_ok, min_key_value, min_key_iter, @vec_deque_iter_cmp_key_ones
    EXPAND VEC_DEQUE_ITER_U64 max_key_iter, max_key_backing, key_deque
    EXPAND VEC_DEQUE_ITER_MAX_BY_KEY_U64 max_key_ok, max_key_value, max_key_iter, @vec_deque_iter_cmp_key_ones

    EXPAND VEC_DEQUE_WITH_CAPACITY cmp_left_deque, 3
