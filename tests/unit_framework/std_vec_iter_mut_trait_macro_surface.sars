@import "sa_std/vec.sars"

@test "sa_std vec iter_mut trait macro surface"():
L_ENTRY:
    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_PUSH_U64 vec, 40

    EXPAND VEC_ITER_MUT_U64 iter_mut, vec
    EXPAND VEC_ITER_MUT_SIZE_HINT_U64 hint_lower_initial, hint_upper_initial, iter_mut
    EXPAND VEC_ITER_MUT_EXACT_SIZE_LEN_U64 exact_len_initial, iter_mut
    EXPAND VEC_ITER_MUT_EXACT_SIZE_IS_EMPTY_U64 empty_initial, iter_mut
    ref_slice = stack_alloc Slice_SIZE
    EXPAND VEC_ITER_MUT_AS_REF_SLICE_U64 ref_slice, iter_mut
    EXPAND SLICE_GET_LEN ref_slice_len, ref_slice
    EXPAND VEC_ITER_MUT_NEXT_U64 first_has, first, iter_mut
    mut_slice = stack_alloc Slice_SIZE
    EXPAND VEC_ITER_MUT_AS_MUT_SLICE_U64 mut_slice, iter_mut
    EXPAND SLICE_GET_LEN mut_slice_len, mut_slice
    EXPAND SLICE_GET_MUT_PTR_U64 mut_second_ptr, mut_slice, 0
    store mut_second_ptr+0, 25 as u64
    EXPAND VEC_ITER_MUT_SIZE_HINT_U64 hint_lower_after_first, hint_upper_after_first, iter_mut
    EXPAND VEC_ITER_MUT_NEXT_U64 second_has, second, iter_mut
    EXPAND VEC_ITER_MUT_NEXT_BACK_U64 back_has, back, iter_mut
    EXPAND VEC_ITER_MUT_NEXT_U64 middle_has, middle, iter_mut
    EXPAND VEC_ITER_MUT_EXACT_SIZE_IS_EMPTY_U64 empty_done, iter_mut
    EXPAND VEC_ITER_MUT_NEXT_U64 done_has, done, iter_mut

    EXPAND VEC_MUT_REF_INTO_ITER_U64 mut_ref_iter, vec
    EXPAND VEC_ITER_MUT_NEXT_BACK_U64 mut_ref_back_has, mut_ref_back, mut_ref_iter
    EXPAND VEC_ITER_MUT_EXACT_SIZE_LEN_U64 mut_ref_len_after_back, mut_ref_iter

    EXPAND VEC_LEN vec_len_after_iters, vec
    EXPAND VEC_GET_U64 vec_second_after_mut_slice, vec, 1
    EXPAND VEC_FREE vec

    ok_hint_lower_initial = eq hint_lower_initial, 4
    ok_hint_upper_initial = eq hint_upper_initial, 4
    ok_exact_len_initial = eq exact_len_initial, 4
    ok_empty_initial = eq empty_initial, 0
    ok_ref_slice_len = eq ref_slice_len, 4
    ok_first_has = eq first_has, 1
    ok_first = eq first, 10
    ok_mut_slice_len = eq mut_slice_len, 3
    ok_hint_lower_after_first = eq hint_lower_after_first, 3
    ok_hint_upper_after_first = eq hint_upper_after_first, 3
    ok_second_has = eq second_has, 1
    ok_second = eq second, 25
    ok_back_has = eq back_has, 1
    ok_back = eq back, 40
    ok_middle_has = eq middle_has, 1
    ok_middle = eq middle, 30
    ok_empty_done = eq empty_done, 1
    ok_done_has = eq done_has, 0
    ok_done = eq done, 0
    ok_mut_ref_back_has = eq mut_ref_back_has, 1
    ok_mut_ref_back = eq mut_ref_back, 40
    ok_mut_ref_len_after_back = eq mut_ref_len_after_back, 3
    ok_vec_len = eq vec_len_after_iters, 4
    ok_vec_second = eq vec_second_after_mut_slice, 25

    ok = and ok_hint_lower_initial, ok_hint_upper_initial
    ok = and ok, ok_exact_len_initial
    ok = and ok, ok_empty_initial
    ok = and ok, ok_ref_slice_len
    ok = and ok, ok_first_has
    ok = and ok, ok_first
    ok = and ok, ok_mut_slice_len
    ok = and ok, ok_hint_lower_after_first
    ok = and ok, ok_hint_upper_after_first
    ok = and ok, ok_second_has
    ok = and ok, ok_second
    ok = and ok, ok_back_has
    ok = and ok, ok_back
    ok = and ok, ok_middle_has
    ok = and ok, ok_middle
    ok = and ok, ok_empty_done
    ok = and ok, ok_done_has
    ok = and ok, ok_done
    ok = and ok, ok_mut_ref_back_has
    ok = and ok, ok_mut_ref_back
    ok = and ok, ok_mut_ref_len_after_back
    ok = and ok, ok_vec_len
    ok = and ok, ok_vec_second

    !hint_lower_initial
    !hint_upper_initial
    !exact_len_initial
    !empty_initial
    !ref_slice_len
    !first_has
    !first
    !mut_slice_len
    !mut_second_ptr
    !hint_lower_after_first
    !hint_upper_after_first
    !second_has
    !second
    !back_has
    !back
    !middle_has
    !middle
    !empty_done
    !done_has
    !done
    !mut_ref_back_has
    !mut_ref_back
    !mut_ref_len_after_back
    !vec_len_after_iters
    !vec_second_after_mut_slice
    !ok_hint_lower_initial
    !ok_hint_upper_initial
    !ok_exact_len_initial
    !ok_empty_initial
    !ok_ref_slice_len
    !ok_first_has
    !ok_first
    !ok_mut_slice_len
    !ok_hint_lower_after_first
    !ok_hint_upper_after_first
    !ok_second_has
    !ok_second
    !ok_back_has
    !ok_back
    !ok_middle_has
    !ok_middle
    !ok_empty_done
    !ok_done_has
    !ok_done
    !ok_mut_ref_back_has
    !ok_mut_ref_back
    !ok_mut_ref_len_after_back
    !ok_vec_len
    !ok_vec_second
    !iter_mut
    !mut_ref_iter
    br ok -> L_VEC_ITER_MUT_TRAIT_OK, L_VEC_ITER_MUT_TRAIT_FAIL

L_VEC_ITER_MUT_TRAIT_FAIL:
    !ok
    panic(10735)

L_VEC_ITER_MUT_TRAIT_OK:
    !ok
    return
