@import "sa_std/sync/condvar.sars"
@import "sa_std/sync/mutex.sars"

@cond_pred_always_false(mutex: ptr) -> u64:
L_ENTRY:
    !mutex
    return 0

@cond_pred_until_ready(mutex: ptr) -> u64:
L_ENTRY:
    // MUTEX_NEW_I32 stores value at Mutex_data (+8)
    val = load mutex+Mutex_data as i32
    keep = eq val, 0
    !val
    !mutex
    return keep

@test "sa_std condvar notify and wait_while false path"():
L_ENTRY:
    EXPAND CONDVAR_NEW cond
    EXPAND MUTEX_NEW_I32 mutex, 0
    EXPAND MUTEX_LOCK mutex
    EXPAND CONDVAR_WAITERS waiters0, cond
    // Predicate already false: wait_while must not block.
    EXPAND CONDVAR_WAIT_WHILE cond, mutex, @cond_pred_always_false
    EXPAND CONDVAR_NOTIFY_ONE cond
    EXPAND CONDVAR_NOTIFY_ALL cond
    EXPAND MUTEX_UNLOCK mutex
    EXPAND CONDVAR_WAITERS waiters1, cond

    ok_w0 = eq waiters0, 0
    ok_w1 = eq waiters1, 0
    ok = and ok_w0, ok_w1

    !waiters0
    !waiters1
    !ok_w0
    !ok_w1
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10867)

@test "sa_std condvar default alias"():
L_ENTRY:
    EXPAND CONDVAR_DEFAULT cond
    EXPAND CONDVAR_WAITERS waiters, cond
    ok = eq waiters, 0
    !waiters
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10868)
