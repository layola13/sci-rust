@import "sa_std/array.sars"

@array_into_iter_window_sum(window: ptr, len: u64) -> u64:
L_ENTRY:
    acc = add 0, 0
    index = add 0, 0
    jmp L_ARRAY_WINDOW_SUM_HEAD
L_ARRAY_WINDOW_SUM_HEAD:
    more = ult index, len
    br more -> L_ARRAY_WINDOW_SUM_ADD, L_ARRAY_WINDOW_SUM_DONE
L_ARRAY_WINDOW_SUM_ADD:
    off = mul index, 8
    item = ptr_add window, off
    value = load item+0 as u64
    next_acc = add acc, value
    !acc
    acc = add next_acc, 0
    next_index = add index, 1
    !index
    index = add next_index, 0
    !next_index
    !next_acc
    !value
    !item
    !off
    !more
    jmp L_ARRAY_WINDOW_SUM_HEAD
L_ARRAY_WINDOW_SUM_DONE:
    !more
    !index
    !len
    !window
    return acc

@test "sa_std array into_iter array window collect macro surface"():
L_ENTRY:
    chunks_arr = stack_alloc 40
    store chunks_arr+0, 1 as u64
    store chunks_arr+8, 2 as u64
    store chunks_arr+16, 3 as u64
    store chunks_arr+24, 4 as u64
    store chunks_arr+32, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 chunks_iter, chunks_backing, chunks_arr, 5
    EXPAND ARRAY_INTO_ITER_ARRAY_CHUNKS_COLLECT_U64 chunks_ok, chunks_vec, chunks_iter, 2
    EXPAND VEC_LEN chunks_len, chunks_vec
    EXPAND VEC_GET_U64 chunks_0, chunks_vec, 0
    EXPAND VEC_GET_U64 chunks_1, chunks_vec, 1
    EXPAND VEC_GET_U64 chunks_2, chunks_vec, 2
    EXPAND VEC_GET_U64 chunks_3, chunks_vec, 3
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 chunks_remaining, chunks_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 chunks_tail_has, chunks_tail, chunks_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 chunks_empty_after_tail, chunks_iter

    partial_chunks_arr = stack_alloc 48
    store partial_chunks_arr+0, 10 as u64
    store partial_chunks_arr+8, 20 as u64
    store partial_chunks_arr+16, 30 as u64
    store partial_chunks_arr+24, 40 as u64
    store partial_chunks_arr+32, 50 as u64
    store partial_chunks_arr+40, 60 as u64
    EXPAND ARRAY_INTO_ITER_U64 partial_chunks_iter, partial_chunks_backing, partial_chunks_arr, 6
    EXPAND ARRAY_INTO_ITER_NEXT_U64 partial_chunks_first_has, partial_chunks_first, partial_chunks_iter
    EXPAND ARRAY_INTO_ITER_ARRAY_CHUNKS_COLLECT_U64 partial_chunks_ok, partial_chunks_vec, partial_chunks_iter, 2
    EXPAND VEC_LEN partial_chunks_len, partial_chunks_vec
    EXPAND VEC_GET_U64 partial_chunks_0, partial_chunks_vec, 0
    EXPAND VEC_GET_U64 partial_chunks_1, partial_chunks_vec, 1
    EXPAND VEC_GET_U64 partial_chunks_2, partial_chunks_vec, 2
    EXPAND VEC_GET_U64 partial_chunks_3, partial_chunks_vec, 3
    EXPAND ARRAY_INTO_ITER_NEXT_U64 partial_chunks_tail_has, partial_chunks_tail, partial_chunks_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 partial_chunks_empty_after_tail, partial_chunks_iter

    zero_chunks_arr = stack_alloc 16
    store zero_chunks_arr+0, 7 as u64
    store zero_chunks_arr+8, 8 as u64
    EXPAND ARRAY_INTO_ITER_U64 zero_chunks_iter, zero_chunks_backing, zero_chunks_arr, 2
    EXPAND ARRAY_INTO_ITER_ARRAY_CHUNKS_COLLECT_U64 zero_chunks_ok, zero_chunks_vec, zero_chunks_iter, 0
    EXPAND VEC_LEN zero_chunks_len, zero_chunks_vec
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 zero_chunks_remaining_before, zero_chunks_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 zero_chunks_next_has, zero_chunks_next, zero_chunks_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 zero_chunks_remaining_after, zero_chunks_iter

    windows_arr = stack_alloc 32
    store windows_arr+0, 1 as u64
    store windows_arr+8, 3 as u64
    store windows_arr+16, 8 as u64
    store windows_arr+24, 1 as u64
    EXPAND ARRAY_INTO_ITER_U64 windows_iter, windows_backing, windows_arr, 4
    EXPAND ARRAY_INTO_ITER_MAP_WINDOWS_COLLECT_U64 windows_ok, windows_vec, windows_iter, 2, @array_into_iter_window_sum
    EXPAND VEC_LEN windows_len, windows_vec
    EXPAND VEC_GET_U64 windows_0, windows_vec, 0
    EXPAND VEC_GET_U64 windows_1, windows_vec, 1
    EXPAND VEC_GET_U64 windows_2, windows_vec, 2
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 windows_empty, windows_iter

    large_windows_arr = stack_alloc 32
    store large_windows_arr+0, 1 as u64
    store large_windows_arr+8, 3 as u64
    store large_windows_arr+16, 8 as u64
    store large_windows_arr+24, 1 as u64
    EXPAND ARRAY_INTO_ITER_U64 large_windows_iter, large_windows_backing, large_windows_arr, 4
    EXPAND ARRAY_INTO_ITER_MAP_WINDOWS_COLLECT_U64 large_windows_ok, large_windows_vec, large_windows_iter, 8, @array_into_iter_window_sum
    EXPAND VEC_LEN large_windows_len, large_windows_vec
    EXPAND ARRAY_INTO_ITER_NEXT_U64 large_windows_next_has, large_windows_next, large_windows_iter

    zero_windows_arr = stack_alloc 32
    store zero_windows_arr+0, 1 as u64
    store zero_windows_arr+8, 3 as u64
    store zero_windows_arr+16, 8 as u64
    store zero_windows_arr+24, 1 as u64
    EXPAND ARRAY_INTO_ITER_U64 zero_windows_iter, zero_windows_backing, zero_windows_arr, 4
    EXPAND ARRAY_INTO_ITER_MAP_WINDOWS_COLLECT_U64 zero_windows_ok, zero_windows_vec, zero_windows_iter, 0, @array_into_iter_window_sum
    EXPAND VEC_LEN zero_windows_len, zero_windows_vec
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 zero_windows_remaining_before, zero_windows_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 zero_windows_next_has, zero_windows_next, zero_windows_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 zero_windows_remaining_after, zero_windows_iter

    EXPAND ARRAY_INTO_ITER_DEFAULT_U64 empty_windows_iter, empty_windows_backing
    EXPAND ARRAY_INTO_ITER_MAP_WINDOWS_COLLECT_U64 empty_windows_ok, empty_windows_vec, empty_windows_iter, 2, @array_into_iter_window_sum
    EXPAND VEC_LEN empty_windows_len, empty_windows_vec
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_windows_empty, empty_windows_iter

    EXPAND VEC_FREE chunks_backing
    EXPAND VEC_FREE chunks_vec
    EXPAND VEC_FREE partial_chunks_backing
    EXPAND VEC_FREE partial_chunks_vec
    EXPAND VEC_FREE zero_chunks_backing
    EXPAND VEC_FREE zero_chunks_vec
    EXPAND VEC_FREE windows_backing
    EXPAND VEC_FREE windows_vec
    EXPAND VEC_FREE large_windows_backing
    EXPAND VEC_FREE large_windows_vec
    EXPAND VEC_FREE zero_windows_backing
    EXPAND VEC_FREE zero_windows_vec
    EXPAND VEC_FREE empty_windows_backing
    EXPAND VEC_FREE empty_windows_vec

    ok_chunks_ok = eq chunks_ok, 1
    ok_chunks_len = eq chunks_len, 4
    ok_chunks_0 = eq chunks_0, 1
    ok_chunks_1 = eq chunks_1, 2
    ok_chunks_2 = eq chunks_2, 3
    ok_chunks_3 = eq chunks_3, 4
    ok_chunks_remaining = eq chunks_remaining, 1
    ok_chunks_tail_has = eq chunks_tail_has, 1
    ok_chunks_tail = eq chunks_tail, 5
    ok_chunks_empty_after_tail = eq chunks_empty_after_tail, 1
    ok_partial_chunks_first_has = eq partial_chunks_first_has, 1
    ok_partial_chunks_first = eq partial_chunks_first, 10
    ok_partial_chunks_ok = eq partial_chunks_ok, 1
    ok_partial_chunks_len = eq partial_chunks_len, 4
    ok_partial_chunks_0 = eq partial_chunks_0, 20
    ok_partial_chunks_1 = eq partial_chunks_1, 30
    ok_partial_chunks_2 = eq partial_chunks_2, 40
    ok_partial_chunks_3 = eq partial_chunks_3, 50
    ok_partial_chunks_tail_has = eq partial_chunks_tail_has, 1
    ok_partial_chunks_tail = eq partial_chunks_tail, 60
    ok_partial_chunks_empty_after_tail = eq partial_chunks_empty_after_tail, 1
    ok_zero_chunks_ok = eq zero_chunks_ok, 0
    ok_zero_chunks_len = eq zero_chunks_len, 0
    ok_zero_chunks_remaining_before = eq zero_chunks_remaining_before, 2
    ok_zero_chunks_next_has = eq zero_chunks_next_has, 1
    ok_zero_chunks_next = eq zero_chunks_next, 7
    ok_zero_chunks_remaining_after = eq zero_chunks_remaining_after, 1
    ok_windows_ok = eq windows_ok, 1
    ok_windows_len = eq windows_len, 3
    ok_windows_0 = eq windows_0, 4
    ok_windows_1 = eq windows_1, 11
    ok_windows_2 = eq windows_2, 9
    ok_windows_empty = eq windows_empty, 1
    ok_large_windows_ok = eq large_windows_ok, 1
    ok_large_windows_len = eq large_windows_len, 0
    ok_large_windows_next_has = eq large_windows_next_has, 0
    ok_large_windows_next = eq large_windows_next, 0
    ok_zero_windows_ok = eq zero_windows_ok, 0
    ok_zero_windows_len = eq zero_windows_len, 0
    ok_zero_windows_remaining_before = eq zero_windows_remaining_before, 4
    ok_zero_windows_next_has = eq zero_windows_next_has, 1
    ok_zero_windows_next = eq zero_windows_next, 1
    ok_zero_windows_remaining_after = eq zero_windows_remaining_after, 3
    ok_empty_windows_ok = eq empty_windows_ok, 1
    ok_empty_windows_len = eq empty_windows_len, 0
    ok_empty_windows_empty = eq empty_windows_empty, 1

    ok = and ok_chunks_ok, ok_chunks_len
    ok = and ok, ok_chunks_0
    ok = and ok, ok_chunks_1
    ok = and ok, ok_chunks_2
    ok = and ok, ok_chunks_3
    ok = and ok, ok_chunks_remaining
    ok = and ok, ok_chunks_tail_has
    ok = and ok, ok_chunks_tail
    ok = and ok, ok_chunks_empty_after_tail
    ok = and ok, ok_partial_chunks_first_has
    ok = and ok, ok_partial_chunks_first
    ok = and ok, ok_partial_chunks_ok
    ok = and ok, ok_partial_chunks_len
    ok = and ok, ok_partial_chunks_0
    ok = and ok, ok_partial_chunks_1
    ok = and ok, ok_partial_chunks_2
    ok = and ok, ok_partial_chunks_3
    ok = and ok, ok_partial_chunks_tail_has
    ok = and ok, ok_partial_chunks_tail
    ok = and ok, ok_partial_chunks_empty_after_tail
    ok = and ok, ok_zero_chunks_ok
    ok = and ok, ok_zero_chunks_len
    ok = and ok, ok_zero_chunks_remaining_before
    ok = and ok, ok_zero_chunks_next_has
    ok = and ok, ok_zero_chunks_next
    ok = and ok, ok_zero_chunks_remaining_after
    ok = and ok, ok_windows_ok
    ok = and ok, ok_windows_len
    ok = and ok, ok_windows_0
    ok = and ok, ok_windows_1
    ok = and ok, ok_windows_2
    ok = and ok, ok_windows_empty
    ok = and ok, ok_large_windows_ok
    ok = and ok, ok_large_windows_len
    ok = and ok, ok_large_windows_next_has
    ok = and ok, ok_large_windows_next
    ok = and ok, ok_zero_windows_ok
    ok = and ok, ok_zero_windows_len
    ok = and ok, ok_zero_windows_remaining_before
    ok = and ok, ok_zero_windows_next_has
    ok = and ok, ok_zero_windows_next
    ok = and ok, ok_zero_windows_remaining_after
    ok = and ok, ok_empty_windows_ok
    ok = and ok, ok_empty_windows_len
    ok = and ok, ok_empty_windows_empty

    !chunks_ok
    !chunks_len
    !chunks_0
    !chunks_1
    !chunks_2
    !chunks_3
    !chunks_remaining
    !chunks_tail_has
    !chunks_tail
    !chunks_empty_after_tail
    !partial_chunks_first_has
    !partial_chunks_first
    !partial_chunks_ok
    !partial_chunks_len
    !partial_chunks_0
    !partial_chunks_1
    !partial_chunks_2
    !partial_chunks_3
    !partial_chunks_tail_has
    !partial_chunks_tail
    !partial_chunks_empty_after_tail
    !zero_chunks_ok
    !zero_chunks_len
    !zero_chunks_remaining_before
    !zero_chunks_next_has
    !zero_chunks_next
    !zero_chunks_remaining_after
    !windows_ok
    !windows_len
    !windows_0
    !windows_1
    !windows_2
    !windows_empty
    !large_windows_ok
    !large_windows_len
    !large_windows_next_has
    !large_windows_next
    !zero_windows_ok
    !zero_windows_len
    !zero_windows_remaining_before
    !zero_windows_next_has
    !zero_windows_next
    !zero_windows_remaining_after
    !empty_windows_ok
    !empty_windows_len
    !empty_windows_empty
    !ok_chunks_ok
    !ok_chunks_len
    !ok_chunks_0
    !ok_chunks_1
    !ok_chunks_2
    !ok_chunks_3
    !ok_chunks_remaining
    !ok_chunks_tail_has
    !ok_chunks_tail
    !ok_chunks_empty_after_tail
    !ok_partial_chunks_first_has
    !ok_partial_chunks_first
    !ok_partial_chunks_ok
    !ok_partial_chunks_len
    !ok_partial_chunks_0
    !ok_partial_chunks_1
    !ok_partial_chunks_2
    !ok_partial_chunks_3
    !ok_partial_chunks_tail_has
    !ok_partial_chunks_tail
    !ok_partial_chunks_empty_after_tail
    !ok_zero_chunks_ok
    !ok_zero_chunks_len
    !ok_zero_chunks_remaining_before
    !ok_zero_chunks_next_has
    !ok_zero_chunks_next
    !ok_zero_chunks_remaining_after
    !ok_windows_ok
    !ok_windows_len
    !ok_windows_0
    !ok_windows_1
    !ok_windows_2
    !ok_windows_empty
    !ok_large_windows_ok
    !ok_large_windows_len
    !ok_large_windows_next_has
    !ok_large_windows_next
    !ok_zero_windows_ok
    !ok_zero_windows_len
    !ok_zero_windows_remaining_before
    !ok_zero_windows_next_has
    !ok_zero_windows_next
    !ok_zero_windows_remaining_after
    !ok_empty_windows_ok
    !ok_empty_windows_len
    !ok_empty_windows_empty
    !chunks_iter
    !partial_chunks_iter
    !zero_chunks_iter
    !windows_iter
    !large_windows_iter
    !zero_windows_iter
    !empty_windows_iter
    br ok -> L_ARRAY_INTO_ITER_ARRAY_WINDOW_COLLECT_OK, L_ARRAY_INTO_ITER_ARRAY_WINDOW_COLLECT_FAIL

L_ARRAY_INTO_ITER_ARRAY_WINDOW_COLLECT_FAIL:
    !ok
    panic(10753)

L_ARRAY_INTO_ITER_ARRAY_WINDOW_COLLECT_OK:
    !ok
    return
