@import "sa_std/sync/mpsc.sars"

@test "sa_std mpsc channel tx/rx split"():
L_ENTRY:
    EXPAND MPSC_CHANNEL tx, rx, 4
    EXPAND MPSC_TX_TRY_SEND s0, tx, 11
    EXPAND MPSC_TX_TRY_SEND s1, tx, 22
    EXPAND MPSC_RX_TRY_RECV r0_ok, r0, rx
    EXPAND MPSC_RX_TRY_RECV r1_ok, r1, rx
    EXPAND MPSC_RX_TRY_RECV r2_ok, r2, rx
    EXPAND MPSC_CHANNEL_FREE tx, rx

    ok_s0 = eq s0, 1
    ok_s1 = eq s1, 1
    ok_r0 = eq r0_ok, 1
    ok_v0 = eq r0, 11
    ok_r1 = eq r1_ok, 1
    ok_v1 = eq r1, 22
    ok_r2 = eq r2_ok, 0
    ok01 = and ok_s0, ok_s1
    ok02 = and ok01, ok_r0
    ok03 = and ok02, ok_v0
    ok04 = and ok03, ok_r1
    ok05 = and ok04, ok_v1
    ok = and ok05, ok_r2

    !s0
    !s1
    !r0_ok
    !r0
    !r1_ok
    !r1
    !r2_ok
    !r2
    !ok_s0
    !ok_s1
    !ok_r0
    !ok_v0
    !ok_r1
    !ok_v1
    !ok_r2
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10870)
