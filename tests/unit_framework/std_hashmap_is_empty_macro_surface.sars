@import "sa_std/collections/hashmap.sars"

@const KEY = utf8:"k"

@test "sa_std hashmap is_empty"():
L_ENTRY:
    EXPAND MAP_NEW map
    EXPAND MAP_IS_EMPTY e0, map
    key = &KEY
    EXPAND MAP_PUT map, key, key
    EXPAND MAP_IS_EMPTY e1, map
    EXPAND MAP_FREE map
    a = eq e0, 1
    b = eq e1, 0
    ok = and a, b
    !e0
    !e1
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10976)
