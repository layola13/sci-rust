@import "sa_std/collections/vec_deque.sars"
@import "sa_std/vec.sars"

@test "sa_std vec_deque drain bare aliases"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY full, 4
    EXPAND VEC_DEQUE_PUSH_BACK full, 10
    EXPAND VEC_DEQUE_PUSH_BACK full, 20
    EXPAND VEC_DEQUE_PUSH_BACK full, 30
    EXPAND VEC_DEQUE_PUSH_BACK full, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT wrap_pop_ok, wrap_pop, full
    EXPAND VEC_DEQUE_PUSH_BACK full, 50

    EXPAND VEC_DEQUE_DRAIN drain_vec, full
    EXPAND VEC_LEN drain_len, drain_vec
    EXPAND VEC_GET_U64 drain0, drain_vec, 0
    EXPAND VEC_GET_U64 drain1, drain_vec, 1
    EXPAND VEC_GET_U64 drain2, drain_vec, 2
    EXPAND VEC_GET_U64 drain3, drain_vec, 3
    EXPAND VEC_DEQUE_LEN full_len_after, full
    EXPAND VEC_DEQUE_IS_EMPTY full_empty, full
    EXPAND VEC_FREE drain_vec
    EXPAND VEC_DEQUE_FREE full

    EXPAND VEC_DEQUE_WITH_CAPACITY range_deque, 7
    EXPAND VEC_DEQUE_PUSH_BACK range_deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK range_deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK range_deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK range_deque, 40
    EXPAND VEC_DEQUE_PUSH_BACK range_deque, 50
    EXPAND VEC_DEQUE_TRY_POP_FRONT range_wrap_ok, range_wrap, range_deque
    EXPAND VEC_DEQUE_PUSH_BACK range_deque, 60

    EXPAND VEC_DEQUE_DRAIN_RANGE range_ok, range_drained, range_deque, 1, 3
    EXPAND VEC_DEQUE_LEN range_len_after, range_deque
    EXPAND VEC_LEN range_drained_len, range_drained
    EXPAND VEC_DEQUE_GET range0, range_deque, 0
    EXPAND VEC_DEQUE_GET range1, range_deque, 1
    EXPAND VEC_TRY_GET_U64 range_d0_ok, range_d0, range_drained, 0
    EXPAND VEC_TRY_GET_U64 range_d1_ok, range_d1, range_drained, 1
    EXPAND VEC_TRY_GET_U64 range_d2_ok, range_d2, range_drained, 2

    EXPAND VEC_DEQUE_DRAIN_RANGE zero_ok, zero_drained, range_deque, 1, 0
    EXPAND VEC_DEQUE_LEN zero_len_after, range_deque
    EXPAND VEC_LEN zero_len, zero_drained

    EXPAND VEC_DEQUE_DRAIN_RANGE miss_ok, miss_drained, range_deque, 9, 1
    EXPAND VEC_DEQUE_LEN miss_len_after, range_deque
    EXPAND VEC_LEN miss_len, miss_drained

    EXPAND VEC_FREE miss_drained
    EXPAND VEC_FREE zero_drained
    EXPAND VEC_FREE range_drained
    EXPAND VEC_DEQUE_FREE range_deque

    ok = eq wrap_pop_ok, 1
    check = eq wrap_pop, 10
    ok = and ok, check
    check = eq drain_len, 4
    ok = and ok, check
    check = eq drain0, 20
    ok = and ok, check
    check = eq drain1, 30
    ok = and ok, check
    check = eq drain2, 40
    ok = and ok, check
    check = eq drain3, 50
    ok = and ok, check
    check = eq full_len_after, 0
    ok = and ok, check
    check = eq full_empty, 1
    ok = and ok, check
    check = eq range_wrap_ok, 1
    ok = and ok, check
    check = eq range_wrap, 10
    ok = and ok, check
    check = eq range_ok, 1
    ok = and ok, check
    check = eq range_len_after, 2
    ok = and ok, check
    check = eq range_drained_len, 3
    ok = and ok, check
    check = eq range0, 20
    ok = and ok, check
    check = eq range1, 60
    ok = and ok, check
    check = eq range_d0_ok, 1
    ok = and ok, check
    check = eq range_d0, 30
    ok = and ok, check
    check = eq range_d1_ok, 1
    ok = and ok, check
    check = eq range_d1, 40
    ok = and ok, check
    check = eq range_d2_ok, 1
    ok = and ok, check
    check = eq range_d2, 50
    ok = and ok, check
    check = eq zero_ok, 1
    ok = and ok, check
    check = eq zero_len, 0
    ok = and ok, check
    check = eq zero_len_after, 2
    ok = and ok, check
    check = eq miss_ok, 0
    ok = and ok, check
    check = eq miss_len, 0
    ok = and ok, check
    check = eq miss_len_after, 2
    ok = and ok, check

    !wrap_pop_ok
    !wrap_pop
    !drain_len
    !drain0
    !drain1
    !drain2
    !drain3
    !full_len_after
    !full_empty
    !range_wrap_ok
    !range_wrap
    !range_ok
    !range_len_after
    !range_drained_len
    !range0
    !range1
    !range_d0_ok
    !range_d0
    !range_d1_ok
    !range_d1
    !range_d2_ok
    !range_d2
    !zero_ok
    !zero_len
    !zero_len_after
    !miss_ok
    !miss_len
    !miss_len_after
    !check
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10842)

L_OK:
    !ok
    return
