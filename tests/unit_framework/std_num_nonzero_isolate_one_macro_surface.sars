@import "sa_std/num.sars"

@test "sa_std nonzero integer isolate one macro surface"():
L_ENTRY:
    u8_nz = stack_alloc NonZeroU8_SIZE
    u8_high = stack_alloc NonZeroU8_SIZE
    u8_low = stack_alloc NonZeroU8_SIZE
    u16_nz = stack_alloc NonZeroU16_SIZE
    u16_high = stack_alloc NonZeroU16_SIZE
    u16_low = stack_alloc NonZeroU16_SIZE
    u32_nz = stack_alloc NonZeroU32_SIZE
    u32_high = stack_alloc NonZeroU32_SIZE
    u32_low = stack_alloc NonZeroU32_SIZE
    u64_nz = stack_alloc NonZeroU64_SIZE
    u64_high = stack_alloc NonZeroU64_SIZE
    u64_low = stack_alloc NonZeroU64_SIZE
    usize_nz = stack_alloc NonZeroUsize_SIZE
    usize_high = stack_alloc NonZeroUsize_SIZE
    usize_low = stack_alloc NonZeroUsize_SIZE
    i8_nz = stack_alloc NonZeroI8_SIZE
    i8_high = stack_alloc NonZeroI8_SIZE
    i8_low = stack_alloc NonZeroI8_SIZE
    i16_nz = stack_alloc NonZeroI16_SIZE
    i16_high = stack_alloc NonZeroI16_SIZE
    i16_low = stack_alloc NonZeroI16_SIZE
    i32_nz = stack_alloc NonZeroI32_SIZE
    i32_high = stack_alloc NonZeroI32_SIZE
    i32_low = stack_alloc NonZeroI32_SIZE
    i64_nz = stack_alloc NonZeroI64_SIZE
    i64_high = stack_alloc NonZeroI64_SIZE
    i64_low = stack_alloc NonZeroI64_SIZE
    isize_nz = stack_alloc NonZeroIsize_SIZE
    isize_high = stack_alloc NonZeroIsize_SIZE
    isize_low = stack_alloc NonZeroIsize_SIZE

    EXPAND NONZERO_U8_NEW ok_u8_new, u8_nz, 100
    EXPAND NONZERO_U16_NEW ok_u16_new, u16_nz, 4660
    EXPAND NONZERO_U32_NEW ok_u32_new, u32_nz, 305419896
    EXPAND NONZERO_U64_NEW ok_u64_new, u64_nz, 281474976710688
    EXPAND NONZERO_USIZE_NEW ok_usize_new, usize_nz, 281474976710688
    EXPAND NONZERO_I8_NEW ok_i8_new, i8_nz, -8
    EXPAND NONZERO_I16_NEW ok_i16_new, i16_nz, -8
    EXPAND NONZERO_I32_NEW ok_i32_new, i32_nz, -16
    EXPAND NONZERO_I64_NEW ok_i64_new, i64_nz, -8
    EXPAND NONZERO_ISIZE_NEW ok_isize_new, isize_nz, -8

    EXPAND NONZERO_U8_ISOLATE_HIGHEST_ONE ok_u8_high, u8_high, u8_nz
    EXPAND NONZERO_U8_ISOLATE_LOWEST_ONE ok_u8_low, u8_low, u8_nz
    EXPAND NONZERO_U16_ISOLATE_HIGHEST_ONE ok_u16_high, u16_high, u16_nz
    EXPAND NONZERO_U16_ISOLATE_LOWEST_ONE ok_u16_low, u16_low, u16_nz
    EXPAND NONZERO_U32_ISOLATE_HIGHEST_ONE ok_u32_high, u32_high, u32_nz
    EXPAND NONZERO_U32_ISOLATE_LOWEST_ONE ok_u32_low, u32_low, u32_nz
    EXPAND NONZERO_U64_ISOLATE_HIGHEST_ONE ok_u64_high, u64_high, u64_nz
    EXPAND NONZERO_U64_ISOLATE_LOWEST_ONE ok_u64_low, u64_low, u64_nz
    EXPAND NONZERO_USIZE_ISOLATE_HIGHEST_ONE ok_usize_high, usize_high, usize_nz
    EXPAND NONZERO_USIZE_ISOLATE_LOWEST_ONE ok_usize_low, usize_low, usize_nz
    EXPAND NONZERO_I8_ISOLATE_HIGHEST_ONE ok_i8_high, i8_high, i8_nz
    EXPAND NONZERO_I8_ISOLATE_LOWEST_ONE ok_i8_low, i8_low, i8_nz
    EXPAND NONZERO_I16_ISOLATE_HIGHEST_ONE ok_i16_high, i16_high, i16_nz
    EXPAND NONZERO_I16_ISOLATE_LOWEST_ONE ok_i16_low, i16_low, i16_nz
    EXPAND NONZERO_I32_ISOLATE_HIGHEST_ONE ok_i32_high, i32_high, i32_nz
    EXPAND NONZERO_I32_ISOLATE_LOWEST_ONE ok_i32_low, i32_low, i32_nz
    EXPAND NONZERO_I64_ISOLATE_HIGHEST_ONE ok_i64_high, i64_high, i64_nz
    EXPAND NONZERO_I64_ISOLATE_LOWEST_ONE ok_i64_low, i64_low, i64_nz
    EXPAND NONZERO_ISIZE_ISOLATE_HIGHEST_ONE ok_isize_high, isize_high, isize_nz
    EXPAND NONZERO_ISIZE_ISOLATE_LOWEST_ONE ok_isize_low, isize_low, isize_nz

    EXPAND NONZERO_U8_GET u8_high_value, u8_high
    EXPAND NONZERO_U8_GET u8_low_value, u8_low
    EXPAND NONZERO_U16_GET u16_high_value, u16_high
    EXPAND NONZERO_U16_GET u16_low_value, u16_low
    EXPAND NONZERO_U32_GET u32_high_value, u32_high
    EXPAND NONZERO_U32_GET u32_low_value, u32_low
    EXPAND NONZERO_U64_GET u64_high_value, u64_high
    EXPAND NONZERO_U64_GET u64_low_value, u64_low
    EXPAND NONZERO_USIZE_GET usize_high_value, usize_high
    EXPAND NONZERO_USIZE_GET usize_low_value, usize_low
    EXPAND NONZERO_I8_GET i8_high_value, i8_high
    EXPAND NONZERO_I8_GET i8_low_value, i8_low
    EXPAND NONZERO_I16_GET i16_high_value, i16_high
    EXPAND NONZERO_I16_GET i16_low_value, i16_low
    EXPAND NONZERO_I32_GET i32_high_value, i32_high
    EXPAND NONZERO_I32_GET i32_low_value, i32_low
    EXPAND NONZERO_I64_GET i64_high_value, i64_high
    EXPAND NONZERO_I64_GET i64_low_value, i64_low
    EXPAND NONZERO_ISIZE_GET isize_high_value, isize_high
    EXPAND NONZERO_ISIZE_GET isize_low_value, isize_low

    ok_new_01 = and ok_u8_new, ok_u16_new
    ok_new_02 = and ok_new_01, ok_u32_new
    ok_new_03 = and ok_new_02, ok_u64_new
    ok_new_04 = and ok_new_03, ok_usize_new
    ok_new_05 = and ok_new_04, ok_i8_new
    ok_new_06 = and ok_new_05, ok_i16_new
    ok_new_07 = and ok_new_06, ok_i32_new
    ok_new_08 = and ok_new_07, ok_i64_new
    ok_new_all = and ok_new_08, ok_isize_new

    ok_iso_01 = and ok_u8_high, ok_u8_low
    ok_iso_02 = and ok_iso_01, ok_u16_high
    ok_iso_03 = and ok_iso_02, ok_u16_low
    ok_iso_04 = and ok_iso_03, ok_u32_high
    ok_iso_05 = and ok_iso_04, ok_u32_low
    ok_iso_06 = and ok_iso_05, ok_u64_high
    ok_iso_07 = and ok_iso_06, ok_u64_low
    ok_iso_08 = and ok_iso_07, ok_usize_high
    ok_iso_09 = and ok_iso_08, ok_usize_low
    ok_iso_10 = and ok_iso_09, ok_i8_high
    ok_iso_11 = and ok_iso_10, ok_i8_low
    ok_iso_12 = and ok_iso_11, ok_i16_high
    ok_iso_13 = and ok_iso_12, ok_i16_low
    ok_iso_14 = and ok_iso_13, ok_i32_high
    ok_iso_15 = and ok_iso_14, ok_i32_low
    ok_iso_16 = and ok_iso_15, ok_i64_high
    ok_iso_17 = and ok_iso_16, ok_i64_low
    ok_iso_18 = and ok_iso_17, ok_isize_high
    ok_iso_all = and ok_iso_18, ok_isize_low

    ok_u8_high_value = eq u8_high_value, 64
    ok_u8_low_value = eq u8_low_value, 4
    ok_u16_high_value = eq u16_high_value, 4096
    ok_u16_low_value = eq u16_low_value, 4
    ok_u32_high_value = eq u32_high_value, 268435456
    ok_u32_low_value = eq u32_low_value, 8
    ok_u64_high_value = eq u64_high_value, 281474976710656
    ok_u64_low_value = eq u64_low_value, 32
    ok_usize_high_value = eq usize_high_value, 281474976710656
    ok_usize_low_value = eq usize_low_value, 32
    ok_i8_high_value = eq i8_high_value, NUM_I8_MIN
    ok_i8_low_value = eq i8_low_value, 8
    ok_i16_high_value = eq i16_high_value, NUM_I16_MIN
    ok_i16_low_value = eq i16_low_value, 8
    ok_i32_high_value = eq i32_high_value, NUM_I32_MIN
    ok_i32_low_value = eq i32_low_value, 16
    ok_i64_high_value = eq i64_high_value, NUM_I64_MIN
    ok_i64_low_value = eq i64_low_value, 8
    ok_isize_high_value = eq isize_high_value, NUM_ISIZE_MIN
    ok_isize_low_value = eq isize_low_value, 8

    ok_value_01 = and ok_new_all, ok_iso_all
    ok_value_02 = and ok_value_01, ok_u8_high_value
    ok_value_03 = and ok_value_02, ok_u8_low_value
    ok_value_04 = and ok_value_03, ok_u16_high_value
    ok_value_05 = and ok_value_04, ok_u16_low_value
    ok_value_06 = and ok_value_05, ok_u32_high_value
    ok_value_07 = and ok_value_06, ok_u32_low_value
    ok_value_08 = and ok_value_07, ok_u64_high_value
    ok_value_09 = and ok_value_08, ok_u64_low_value
    ok_value_10 = and ok_value_09, ok_usize_high_value
    ok_value_11 = and ok_value_10, ok_usize_low_value
    ok_value_12 = and ok_value_11, ok_i8_high_value
    ok_value_13 = and ok_value_12, ok_i8_low_value
    ok_value_14 = and ok_value_13, ok_i16_high_value
    ok_value_15 = and ok_value_14, ok_i16_low_value
    ok_value_16 = and ok_value_15, ok_i32_high_value
    ok_value_17 = and ok_value_16, ok_i32_low_value
    ok_value_18 = and ok_value_17, ok_i64_high_value
    ok_value_19 = and ok_value_18, ok_i64_low_value
    ok_value_20 = and ok_value_19, ok_isize_high_value
    ok = and ok_value_20, ok_isize_low_value
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10610)

L_PASS:
    !ok
    return 0
