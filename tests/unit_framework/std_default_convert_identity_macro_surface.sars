@import "sa_std/default.sars"
@import "sa_std/convert.sars"

@test "sa_std default and convert identity"():
L_ENTRY:
    EXPAND DEFAULT_U64 d
    EXPAND CONVERT_IDENTITY_U64 id, 42
    a = eq d, 0
    b = eq id, 42
    ok = and a, b
    !d
    !id
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10934)
