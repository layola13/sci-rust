@import "sa_std/num.sars"

[MACRO] TEST_SIGNED_OVERFLOWING_ABS_POW_EQ %out_acc, %prev_acc, %value, %expected
    __test_signed_overflowing_abs_pow_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_signed_overflowing_abs_pow_eq_%out_acc
    !__test_signed_overflowing_abs_pow_eq_%out_acc
[END_MACRO]

@test "sa_std signed primitive overflowing abs and pow macro surface"():
L_ENTRY:
    EXPAND NUM_I8_OVERFLOWING_ABS i8_abs_pos_value, i8_abs_pos_over, 10
    EXPAND NUM_I16_OVERFLOWING_ABS i16_abs_neg_value, i16_abs_neg_over, -10
    EXPAND NUM_I32_OVERFLOWING_ABS i32_abs_min_value, i32_abs_min_over, NUM_I32_MIN
    EXPAND NUM_I64_OVERFLOWING_ABS i64_abs_min_value, i64_abs_min_over, NUM_I64_MIN
    EXPAND NUM_ISIZE_OVERFLOWING_ABS isize_abs_min_value, isize_abs_min_over, NUM_ISIZE_MIN

    EXPAND NUM_I8_OVERFLOWING_POW i8_pow_ok_value, i8_pow_ok_over, 3, 4
    EXPAND NUM_I16_OVERFLOWING_POW i16_pow_ok_value, i16_pow_ok_over, -3, 3
    EXPAND NUM_I32_OVERFLOWING_POW i32_pow_zero_value, i32_pow_zero_over, 0, 0
    EXPAND NUM_I64_OVERFLOWING_POW i64_pow_ok_value, i64_pow_ok_over, 3, 4
    EXPAND NUM_ISIZE_OVERFLOWING_POW isize_pow_ok_value, isize_pow_ok_over, 3, 4

    EXPAND NUM_I8_OVERFLOWING_POW i8_pow_wrap_value, i8_pow_wrap_over, 3, 5
    EXPAND NUM_I16_OVERFLOWING_POW i16_pow_wrap_value, i16_pow_wrap_over, 2, 15
    EXPAND NUM_I32_OVERFLOWING_POW i32_pow_wrap_value, i32_pow_wrap_over, 2, 31
    EXPAND NUM_I64_OVERFLOWING_POW i64_pow_wrap_value, i64_pow_wrap_over, 2, 63
    EXPAND NUM_ISIZE_OVERFLOWING_POW isize_pow_wrap_value, isize_pow_wrap_over, 2, 63

    acc_00 = eq 0, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_01, acc_00, i8_abs_pos_value, 10
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_02, acc_01, i8_abs_pos_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_03, acc_02, i16_abs_neg_value, 10
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_04, acc_03, i16_abs_neg_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_05, acc_04, i32_abs_min_value, NUM_I32_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_06, acc_05, i32_abs_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_07, acc_06, i64_abs_min_value, NUM_I64_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_08, acc_07, i64_abs_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_09, acc_08, isize_abs_min_value, NUM_ISIZE_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_10, acc_09, isize_abs_min_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_11, acc_10, i8_pow_ok_value, 81
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_12, acc_11, i8_pow_ok_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_13, acc_12, i16_pow_ok_value, -27
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_14, acc_13, i16_pow_ok_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_15, acc_14, i32_pow_zero_value, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_16, acc_15, i32_pow_zero_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_17, acc_16, i64_pow_ok_value, 81
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_18, acc_17, i64_pow_ok_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_19, acc_18, isize_pow_ok_value, 81
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_20, acc_19, isize_pow_ok_over, 0
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_21, acc_20, i8_pow_wrap_value, -13
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_22, acc_21, i8_pow_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_23, acc_22, i16_pow_wrap_value, NUM_I16_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_24, acc_23, i16_pow_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_25, acc_24, i32_pow_wrap_value, NUM_I32_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_26, acc_25, i32_pow_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_27, acc_26, i64_pow_wrap_value, NUM_I64_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_28, acc_27, i64_pow_wrap_over, 1
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_29, acc_28, isize_pow_wrap_value, NUM_ISIZE_MIN
    EXPAND TEST_SIGNED_OVERFLOWING_ABS_POW_EQ acc_30, acc_29, isize_pow_wrap_over, 1
    br acc_30 -> L_PASS, L_FAIL

L_FAIL:
    !acc_30
    panic(10657)

L_PASS:
    !acc_30
    return 0
