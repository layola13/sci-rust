@import "sa_std/num.sars"

@test "sa_std primitive strict div rem macro surface"():
L_ENTRY:
    EXPAND NUM_U8_STRICT_DIV u8_div, 100, 9
    EXPAND NUM_U16_STRICT_DIV u16_div, 100, 9
    EXPAND NUM_U32_STRICT_DIV u32_div, 100, 9
    EXPAND NUM_U64_STRICT_DIV u64_div, 100, 9
    EXPAND NUM_USIZE_STRICT_DIV usize_div, 100, 9
    EXPAND NUM_I8_STRICT_DIV i8_div, -100, 9
    EXPAND NUM_I16_STRICT_DIV i16_div, -100, 9
    EXPAND NUM_I32_STRICT_DIV i32_div, -100, 9
    EXPAND NUM_I64_STRICT_DIV i64_div, -100, 9
    EXPAND NUM_ISIZE_STRICT_DIV isize_div, -100, 9

    EXPAND NUM_U8_STRICT_REM u8_rem, 100, 9
    EXPAND NUM_U16_STRICT_REM u16_rem, 100, 9
    EXPAND NUM_U32_STRICT_REM u32_rem, 100, 9
    EXPAND NUM_U64_STRICT_REM u64_rem, 100, 9
    EXPAND NUM_USIZE_STRICT_REM usize_rem, 100, 9
    EXPAND NUM_I8_STRICT_REM i8_rem, -100, 9
    EXPAND NUM_I16_STRICT_REM i16_rem, -100, 9
    EXPAND NUM_I32_STRICT_REM i32_rem, -100, 9
    EXPAND NUM_I64_STRICT_REM i64_rem, -100, 9
    EXPAND NUM_ISIZE_STRICT_REM isize_rem, -100, 9

    ok_01 = eq u8_div, 11
    ok_02 = eq u16_div, 11
    ok_03 = eq u32_div, 11
    ok_04 = eq u64_div, 11
    ok_05 = eq usize_div, 11
    ok_06 = eq i8_div, -11
    ok_07 = eq i16_div, -11
    ok_08 = eq i32_div, -11
    ok_09 = eq i64_div, -11
    ok_10 = eq isize_div, -11

    ok_11 = eq u8_rem, 1
    ok_12 = eq u16_rem, 1
    ok_13 = eq u32_rem, 1
    ok_14 = eq u64_rem, 1
    ok_15 = eq usize_rem, 1
    ok_16 = eq i8_rem, -1
    ok_17 = eq i16_rem, -1
    ok_18 = eq i32_rem, -1
    ok_19 = eq i64_rem, -1
    ok_20 = eq isize_rem, -1

    acc_01 = and ok_01, ok_02
    acc_02 = and acc_01, ok_03
    acc_03 = and acc_02, ok_04
    acc_04 = and acc_03, ok_05
    acc_05 = and acc_04, ok_06
    acc_06 = and acc_05, ok_07
    acc_07 = and acc_06, ok_08
    acc_08 = and acc_07, ok_09
    acc_09 = and acc_08, ok_10
    acc_10 = and acc_09, ok_11
    acc_11 = and acc_10, ok_12
    acc_12 = and acc_11, ok_13
    acc_13 = and acc_12, ok_14
    acc_14 = and acc_13, ok_15
    acc_15 = and acc_14, ok_16
    acc_16 = and acc_15, ok_17
    acc_17 = and acc_16, ok_18
    acc_18 = and acc_17, ok_19
    ok = and acc_18, ok_20
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10634)

L_PASS:
    !ok
    return 0

@test should_panic "sa_std unsigned strict div panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_U8_STRICT_DIV value, 1, 0
    !value
    return 0

@test should_panic "sa_std unsigned strict rem panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_U8_STRICT_REM value, 1, 0
    !value
    return 0

@test should_panic "sa_std signed strict div panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_I64_STRICT_DIV value, 1, 0
    !value
    return 0

@test should_panic "sa_std signed strict rem panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_I64_STRICT_REM value, 1, 0
    !value
    return 0

@test should_panic "sa_std signed strict div panics on min over negative one"():
L_ENTRY:
    EXPAND NUM_I8_STRICT_DIV value, NUM_I8_MIN, -1
    !value
    return 0

@test should_panic "sa_std signed strict rem panics on min over negative one"():
L_ENTRY:
    EXPAND NUM_I8_STRICT_REM value, NUM_I8_MIN, -1
    !value
    return 0
