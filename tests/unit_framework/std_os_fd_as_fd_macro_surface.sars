@import "sa_std/fs.sars"
@import "sa_std/os/fd.sars"

@const FD_AS_FD_TEST_PATH = utf8:"_tmp_fd_as_fd_surface.txt"
@const FD_AS_FD_TEST_DATA = utf8:"asfd"

#def FD_AS_FD_TEST_PATH_LEN = 25
#def FD_AS_FD_TEST_DATA_LEN = 4

@test "sa_std os fd AsFd aliases"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FD_AS_FD_TEST_PATH, FD_AS_FD_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FD_AS_FD_TEST_PATH, FD_AS_FD_TEST_PATH_LEN, FD_AS_FD_TEST_DATA, FD_AS_FD_TEST_DATA_LEN
    EXPAND FS_OPEN_READ open_status, file_handle, FD_AS_FD_TEST_PATH, FD_AS_FD_TEST_PATH_LEN
    EXPAND FS_FILE_INTO_OWNED_FD into_owned_status, owned_fd, file_handle
    EXPAND FD_OWNED_AS_FD owned_as_fd_status, borrowed_fd, owned_fd
    EXPAND FD_BORROWED_AS_FD borrowed_as_fd_status, borrowed_fd_again, borrowed_fd
    EXPAND FD_BORROWED_AS_RAW_FD borrowed_raw_status, borrowed_raw_fd, borrowed_fd_again
    EXPAND FD_BORROWED_TRY_CLONE_TO_OWNED clone_status, cloned_owned_fd, borrowed_fd_again
    EXPAND FS_CLOSE owned_close_status, owned_fd

    read_buf = stack_alloc 4
    EXPAND FS_READ read_status, read_len, cloned_owned_fd, read_buf, 4
    b0 = load read_buf+0 as u8
    b3 = load read_buf+3 as u8
    EXPAND FS_CLOSE clone_close_status, cloned_owned_fd
    EXPAND FS_REMOVE_PATH remove_status, FD_AS_FD_TEST_PATH, FD_AS_FD_TEST_PATH_LEN

    write_ok = eq write_status, SA_FS_OK
    open_ok = eq open_status, SA_FS_OK
    into_owned_ok = eq into_owned_status, SA_FD_OK
    owned_fd_ok = ne owned_fd, 0
    owned_as_fd_ok = eq owned_as_fd_status, SA_FD_OK
    borrowed_fd_ok = ne borrowed_fd, 0
    borrowed_as_fd_ok = eq borrowed_as_fd_status, SA_FD_OK
    borrowed_same_ok = eq borrowed_fd_again, borrowed_fd
    borrowed_raw_ok = eq borrowed_raw_status, SA_FD_OK
    borrowed_raw_same_ok = eq borrowed_raw_fd, borrowed_fd
    clone_ok = eq clone_status, SA_FD_OK
    cloned_owned_ok = ne cloned_owned_fd, 0
    owned_close_ok = eq owned_close_status, SA_FS_OK
    read_ok = eq read_status, SA_FS_OK
    read_len_ok = eq read_len, 4
    b0_ok = eq b0, 97
    b3_ok = eq b3, 100
    clone_close_ok = eq clone_close_status, SA_FS_OK
    remove_ok = eq remove_status, SA_FS_OK

    ok01 = and write_ok, open_ok
    ok02 = and ok01, into_owned_ok
    ok03 = and ok02, owned_fd_ok
    ok04 = and ok03, owned_as_fd_ok
    ok05 = and ok04, borrowed_fd_ok
    ok06 = and ok05, borrowed_as_fd_ok
    ok07 = and ok06, borrowed_same_ok
    ok08 = and ok07, borrowed_raw_ok
    ok09 = and ok08, borrowed_raw_same_ok
    ok10 = and ok09, clone_ok
    ok11 = and ok10, cloned_owned_ok
    ok12 = and ok11, owned_close_ok
    ok13 = and ok12, read_ok
    ok14 = and ok13, read_len_ok
    ok15 = and ok14, b0_ok
    ok16 = and ok15, b3_ok
    ok17 = and ok16, clone_close_ok
    ok = and ok17, remove_ok

    !cleanup_status
    !write_status
    !open_status
    !file_handle
    !into_owned_status
    !owned_fd
    !owned_as_fd_status
    !borrowed_fd
    !borrowed_as_fd_status
    !borrowed_fd_again
    !borrowed_raw_status
    !borrowed_raw_fd
    !clone_status
    !cloned_owned_fd
    !owned_close_status
    !read_status
    !read_len
    !b0
    !b3
    !clone_close_status
    !remove_status
    !write_ok
    !open_ok
    !into_owned_ok
    !owned_fd_ok
    !owned_as_fd_ok
    !borrowed_fd_ok
    !borrowed_as_fd_ok
    !borrowed_same_ok
    !borrowed_raw_ok
    !borrowed_raw_same_ok
    !clone_ok
    !cloned_owned_ok
    !owned_close_ok
    !read_ok
    !read_len_ok
    !b0_ok
    !b3_ok
    !clone_close_ok
    !remove_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10693)

L_PASS:
    !ok
    return 0
