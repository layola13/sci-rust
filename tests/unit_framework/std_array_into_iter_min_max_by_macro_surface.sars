@import "sa_std/array.sars"

@array_into_iter_compare_u64(left: u64, right: u64) -> i64:
L_ENTRY:
    is_less = ult left, right
    br is_less -> L_ARRAY_COMPARE_LESS, L_ARRAY_COMPARE_CHECK_GREATER
L_ARRAY_COMPARE_LESS:
    out_less = sub 0, 1
    !is_less
    !right
    !left
    return out_less
L_ARRAY_COMPARE_CHECK_GREATER:
    is_greater = ugt left, right
    br is_greater -> L_ARRAY_COMPARE_GREATER, L_ARRAY_COMPARE_EQUAL
L_ARRAY_COMPARE_GREATER:
    out_greater = add 0, 1
    !is_greater
    !is_less
    !right
    !left
    return out_greater
L_ARRAY_COMPARE_EQUAL:
    out_equal = add 0, 0
    !is_greater
    !is_less
    !right
    !left
    return out_equal

@array_into_iter_key_ones(value: u64) -> u64:
L_ENTRY:
    out = urem value, 10
    !value
    return out

@test "sa_std array into_iter min max by macro surface"():
L_ENTRY:
    min_by_arr = stack_alloc 24
    store min_by_arr+0, 8 as u64
    store min_by_arr+8, 3 as u64
    store min_by_arr+16, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 min_by_iter, min_by_backing, min_by_arr, 3
    EXPAND ARRAY_INTO_ITER_MIN_BY_U64 min_by_has, min_by_value, min_by_iter, @array_into_iter_compare_u64
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 min_by_empty, min_by_iter

    max_by_arr = stack_alloc 24
    store max_by_arr+0, 8 as u64
    store max_by_arr+8, 3 as u64
    store max_by_arr+16, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 max_by_iter, max_by_backing, max_by_arr, 3
    EXPAND ARRAY_INTO_ITER_MAX_BY_U64 max_by_has, max_by_value, max_by_iter, @array_into_iter_compare_u64
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 max_by_empty, max_by_iter

    min_key_arr = stack_alloc 32
    store min_key_arr+0, 29 as u64
    store min_key_arr+8, 34 as u64
    store min_key_arr+16, 42 as u64
    store min_key_arr+24, 51 as u64
    EXPAND ARRAY_INTO_ITER_U64 min_key_iter, min_key_backing, min_key_arr, 4
    EXPAND ARRAY_INTO_ITER_MIN_BY_KEY_U64 min_key_has, min_key_value, min_key_iter, @array_into_iter_key_ones
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 min_key_empty, min_key_iter

    max_key_arr = stack_alloc 32
    store max_key_arr+0, 21 as u64
    store max_key_arr+8, 38 as u64
    store max_key_arr+16, 47 as u64
    store max_key_arr+24, 55 as u64
    EXPAND ARRAY_INTO_ITER_U64 max_key_iter, max_key_backing, max_key_arr, 4
    EXPAND ARRAY_INTO_ITER_MAX_BY_KEY_U64 max_key_has, max_key_value, max_key_iter, @array_into_iter_key_ones
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 max_key_empty, max_key_iter

    EXPAND ARRAY_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND ARRAY_INTO_ITER_MIN_BY_U64 empty_min_has, empty_min_value, empty_iter, @array_into_iter_compare_u64
    EXPAND ARRAY_INTO_ITER_MAX_BY_KEY_U64 empty_max_key_has, empty_max_key_value, empty_iter, @array_into_iter_key_ones

    EXPAND VEC_FREE min_by_backing
    EXPAND VEC_FREE max_by_backing
    EXPAND VEC_FREE min_key_backing
    EXPAND VEC_FREE max_key_backing
    EXPAND VEC_FREE empty_backing

    ok_min_by_has = eq min_by_has, 1
    ok_min_by_value = eq min_by_value, 3
    ok_min_by_empty = eq min_by_empty, 1
    ok_max_by_has = eq max_by_has, 1
    ok_max_by_value = eq max_by_value, 8
    ok_max_by_empty = eq max_by_empty, 1
    ok_min_key_has = eq min_key_has, 1
    ok_min_key_value = eq min_key_value, 51
    ok_min_key_empty = eq min_key_empty, 1
    ok_max_key_has = eq max_key_has, 1
    ok_max_key_value = eq max_key_value, 38
    ok_max_key_empty = eq max_key_empty, 1
    ok_empty_min_has = eq empty_min_has, 0
    ok_empty_min_value = eq empty_min_value, 0
    ok_empty_max_key_has = eq empty_max_key_has, 0
    ok_empty_max_key_value = eq empty_max_key_value, 0

    ok = and ok_min_by_has, ok_min_by_value
    ok = and ok, ok_min_by_empty
    ok = and ok, ok_max_by_has
    ok = and ok, ok_max_by_value
    ok = and ok, ok_max_by_empty
    ok = and ok, ok_min_key_has
    ok = and ok, ok_min_key_value
    ok = and ok, ok_min_key_empty
    ok = and ok, ok_max_key_has
    ok = and ok, ok_max_key_value
    ok = and ok, ok_max_key_empty
    ok = and ok, ok_empty_min_has
    ok = and ok, ok_empty_min_value
    ok = and ok, ok_empty_max_key_has
    ok = and ok, ok_empty_max_key_value

    !min_by_has
    !min_by_value
    !min_by_empty
    !max_by_has
    !max_by_value
    !max_by_empty
    !min_key_has
    !min_key_value
    !min_key_empty
    !max_key_has
    !max_key_value
    !max_key_empty
    !empty_min_has
    !empty_min_value
    !empty_max_key_has
    !empty_max_key_value
    !ok_min_by_has
    !ok_min_by_value
    !ok_min_by_empty
    !ok_max_by_has
    !ok_max_by_value
    !ok_max_by_empty
    !ok_min_key_has
    !ok_min_key_value
    !ok_min_key_empty
    !ok_max_key_has
    !ok_max_key_value
    !ok_max_key_empty
    !ok_empty_min_has
    !ok_empty_min_value
    !ok_empty_max_key_has
    !ok_empty_max_key_value
    !min_by_iter
    !max_by_iter
    !min_key_iter
    !max_key_iter
    !empty_iter
    br ok -> L_ARRAY_INTO_ITER_MIN_MAX_BY_OK, L_ARRAY_INTO_ITER_MIN_MAX_BY_FAIL

L_ARRAY_INTO_ITER_MIN_MAX_BY_FAIL:
    !ok
    panic(10741)

L_ARRAY_INTO_ITER_MIN_MAX_BY_OK:
    !ok
    return
