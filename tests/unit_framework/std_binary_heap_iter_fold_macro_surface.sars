@import "sa_std/collections/binary_heap.sars"

@binary_heap_iter_accumulate_tens(acc: u64, value: u64) -> u64:
L_ENTRY:
    scaled = mul value, 10
    out = add acc, scaled
    !scaled
    return out

@binary_heap_iter_try_accumulate_lt_five(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 5
    br keep -> L_BINARY_HEAP_TRY_FOLD_KEEP, L_BINARY_HEAP_TRY_FOLD_STOP
L_BINARY_HEAP_TRY_FOLD_KEEP:
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep
L_BINARY_HEAP_TRY_FOLD_STOP:
    !out_next
    !value
    !acc
    return keep

@binary_heap_iter_try_accumulate_lt_ten(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 10
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep

@test "sa_std binary_heap iter fold macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW fold_heap
    EXPAND BINARY_HEAP_PUSH_U64 fold_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 fold_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 fold_heap, 1
    EXPAND BINARY_HEAP_ITER_U64 fold_iter, fold_heap
    EXPAND BINARY_HEAP_ITER_FOLD_U64 fold_value, fold_iter, 1, @binary_heap_iter_accumulate_tens
    EXPAND BINARY_HEAP_ITER_EXACT_SIZE_IS_EMPTY_U64 fold_empty, fold_iter

    EXPAND BINARY_HEAP_NEW rfold_heap
    EXPAND BINARY_HEAP_PUSH_U64 rfold_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 rfold_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 rfold_heap, 1
    EXPAND BINARY_HEAP_ITER_U64 rfold_iter, rfold_heap
    EXPAND BINARY_HEAP_ITER_RFOLD_U64 rfold_value, rfold_iter, 1, @binary_heap_iter_accumulate_tens
    EXPAND BINARY_HEAP_ITER_EXACT_SIZE_IS_EMPTY_U64 rfold_empty, rfold_iter

    EXPAND BINARY_HEAP_NEW try_stop_heap
    EXPAND BINARY_HEAP_PUSH_U64 try_stop_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 try_stop_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 try_stop_heap, 1
    EXPAND BINARY_HEAP_ITER_U64 try_stop_iter, try_stop_heap
    EXPAND BINARY_HEAP_ITER_TRY_FOLD_U64 try_stop_ok, try_stop_value, try_stop_iter, 1, @binary_heap_iter_try_accumulate_lt_five
    EXPAND BINARY_HEAP_ITER_EXACT_SIZE_LEN_U64 try_stop_remaining, try_stop_iter
    EXPAND BINARY_HEAP_ITER_NEXT_U64 try_stop_next_has, try_stop_next, try_stop_iter

    EXPAND BINARY_HEAP_NEW try_all_heap
    EXPAND BINARY_HEAP_PUSH_U64 try_all_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 try_all_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 try_all_heap, 1
    EXPAND BINARY_HEAP_ITER_U64 try_all_iter, try_all_heap
    EXPAND BINARY_HEAP_ITER_TRY_FOLD_U64 try_all_ok, try_all_value, try_all_iter, 1, @binary_heap_iter_try_accumulate_lt_ten
    EXPAND BINARY_HEAP_ITER_EXACT_SIZE_IS_EMPTY_U64 try_all_empty, try_all_iter

    EXPAND BINARY_HEAP_NEW try_rstop_heap
    EXPAND BINARY_HEAP_PUSH_U64 try_rstop_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 try_rstop_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 try_rstop_heap, 1
    EXPAND BINARY_HEAP_ITER_U64 try_rstop_iter, try_rstop_heap
    EXPAND BINARY_HEAP_ITER_TRY_RFOLD_U64 try_rstop_ok, try_rstop_value, try_rstop_iter, 1, @binary_heap_iter_try_accumulate_lt_five
    EXPAND BINARY_HEAP_ITER_EXACT_SIZE_LEN_U64 try_rstop_remaining, try_rstop_iter
    EXPAND BINARY_HEAP_ITER_NEXT_BACK_U64 try_rstop_back_has, try_rstop_back, try_rstop_iter

    EXPAND BINARY_HEAP_NEW try_rall_heap
    EXPAND BINARY_HEAP_PUSH_U64 try_rall_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 try_rall_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 try_rall_heap, 1
    EXPAND BINARY_HEAP_ITER_U64 try_rall_iter, try_rall_heap
    EXPAND BINARY_HEAP_ITER_TRY_RFOLD_U64 try_rall_ok, try_rall_value, try_rall_iter, 1, @binary_heap_iter_try_accumulate_lt_ten
    EXPAND BINARY_HEAP_ITER_EXACT_SIZE_IS_EMPTY_U64 try_rall_empty, try_rall_iter

    EXPAND BINARY_HEAP_ITER_DEFAULT_U64 empty_iter
    EXPAND BINARY_HEAP_ITER_FOLD_U64 empty_fold_value, empty_iter, 7, @binary_heap_iter_accumulate_tens
    EXPAND BINARY_HEAP_ITER_RFOLD_U64 empty_rfold_value, empty_iter, 11, @binary_heap_iter_accumulate_tens

    EXPAND BINARY_HEAP_LEN fold_heap_len_after, fold_heap
    EXPAND BINARY_HEAP_FREE fold_heap
    EXPAND BINARY_HEAP_FREE rfold_heap
    EXPAND BINARY_HEAP_FREE try_stop_heap
    EXPAND BINARY_HEAP_FREE try_all_heap
    EXPAND BINARY_HEAP_FREE try_rstop_heap
    EXPAND BINARY_HEAP_FREE try_rall_heap

    ok_fold_value = eq fold_value, 141
    ok_fold_empty = eq fold_empty, 1
    ok_fold_heap_len_after = eq fold_heap_len_after, 3
    ok_rfold_value = eq rfold_value, 141
    ok_rfold_empty = eq rfold_empty, 1
    ok_try_stop_ok = eq try_stop_ok, 0
    ok_try_stop_value = eq try_stop_value, 1
    ok_try_stop_remaining = eq try_stop_remaining, 2
    ok_try_stop_next_has = eq try_stop_next_has, 1
    ok_try_stop_next = eq try_stop_next, 4
    ok_try_all_ok = eq try_all_ok, 1
    ok_try_all_value = eq try_all_value, 141
    ok_try_all_empty = eq try_all_empty, 1
    ok_try_rstop_ok = eq try_rstop_ok, 0
    ok_try_rstop_value = eq try_rstop_value, 51
    ok_try_rstop_remaining = eq try_rstop_remaining, 0
    ok_try_rstop_back_has = eq try_rstop_back_has, 0
    ok_try_rstop_back = eq try_rstop_back, 0
    ok_try_rall_ok = eq try_rall_ok, 1
    ok_try_rall_value = eq try_rall_value, 141
    ok_try_rall_empty = eq try_rall_empty, 1
    ok_empty_fold_value = eq empty_fold_value, 7
    ok_empty_rfold_value = eq empty_rfold_value, 11

    ok = and ok_fold_value, ok_fold_empty
    ok = and ok, ok_fold_heap_len_after
    ok = and ok, ok_rfold_value
    ok = and ok, ok_rfold_empty
    ok = and ok, ok_try_stop_ok
    ok = and ok, ok_try_stop_value
    ok = and ok, ok_try_stop_remaining
    ok = and ok, ok_try_stop_next_has
    ok = and ok, ok_try_stop_next
    ok = and ok, ok_try_all_ok
    ok = and ok, ok_try_all_value
    ok = and ok, ok_try_all_empty
    ok = and ok, ok_try_rstop_ok
    ok = and ok, ok_try_rstop_value
    ok = and ok, ok_try_rstop_remaining
    ok = and ok, ok_try_rstop_back_has
    ok = and ok, ok_try_rstop_back
    ok = and ok, ok_try_rall_ok
    ok = and ok, ok_try_rall_value
    ok = and ok, ok_try_rall_empty
    ok = and ok, ok_empty_fold_value
    ok = and ok, ok_empty_rfold_value

    !fold_value
    !fold_empty
    !fold_heap_len_after
    !rfold_value
    !rfold_empty
    !try_stop_ok
    !try_stop_value
    !try_stop_remaining
    !try_stop_next_has
    !try_stop_next
    !try_all_ok
    !try_all_value
    !try_all_empty
    !try_rstop_ok
    !try_rstop_value
    !try_rstop_remaining
    !try_rstop_back_has
    !try_rstop_back
    !try_rall_ok
    !try_rall_value
    !try_rall_empty
    !empty_fold_value
    !empty_rfold_value
    !fold_iter
    !rfold_iter
    !try_stop_iter
    !try_all_iter
    !try_rstop_iter
    !try_rall_iter
    !empty_iter
    !ok_fold_value
    !ok_fold_empty
    !ok_fold_heap_len_after
    !ok_rfold_value
    !ok_rfold_empty
    !ok_try_stop_ok
    !ok_try_stop_value
    !ok_try_stop_remaining
    !ok_try_stop_next_has
    !ok_try_stop_next
    !ok_try_all_ok
    !ok_try_all_value
    !ok_try_all_empty
    !ok_try_rstop_ok
    !ok_try_rstop_value
    !ok_try_rstop_remaining
    !ok_try_rstop_back_has
    !ok_try_rstop_back
    !ok_try_rall_ok
    !ok_try_rall_value
    !ok_try_rall_empty
    !ok_empty_fold_value
    !ok_empty_rfold_value
    br ok -> L_BINARY_HEAP_ITER_FOLD_OK, L_BINARY_HEAP_ITER_FOLD_FAIL

L_BINARY_HEAP_ITER_FOLD_FAIL:
    !ok
    panic(10763)

L_BINARY_HEAP_ITER_FOLD_OK:
    !ok
    return
