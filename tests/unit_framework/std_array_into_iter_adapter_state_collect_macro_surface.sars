@import "sa_std/array.sars"

@test "sa_std array into_iter adapter state collect macro surface"():
L_ENTRY:
    by_ref_arr = stack_alloc 32
    store by_ref_arr+0, 5 as u64
    store by_ref_arr+8, 8 as u64
    store by_ref_arr+16, 13 as u64
    store by_ref_arr+24, 21 as u64
    EXPAND ARRAY_INTO_ITER_U64 by_ref_iter, by_ref_backing, by_ref_arr, 4
    EXPAND ARRAY_INTO_ITER_NEXT_U64 by_ref_first_has, by_ref_first, by_ref_iter
    EXPAND ARRAY_INTO_ITER_CLONE_U64 by_ref_clone_iter, by_ref_clone_backing, by_ref_iter
    EXPAND ARRAY_INTO_ITER_BY_REF_COLLECT_U64 by_ref_vec, by_ref_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 by_ref_empty, by_ref_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 by_ref_clone_remaining, by_ref_clone_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 by_ref_clone_next_has, by_ref_clone_next, by_ref_clone_iter
    EXPAND VEC_LEN by_ref_len, by_ref_vec
    EXPAND VEC_GET_U64 by_ref_0, by_ref_vec, 0
    EXPAND VEC_GET_U64 by_ref_1, by_ref_vec, 1
    EXPAND VEC_GET_U64 by_ref_2, by_ref_vec, 2

    fuse_arr = stack_alloc 32
    store fuse_arr+0, 2 as u64
    store fuse_arr+8, 4 as u64
    store fuse_arr+16, 6 as u64
    store fuse_arr+24, 8 as u64
    EXPAND ARRAY_INTO_ITER_U64 fuse_iter, fuse_backing, fuse_arr, 4
    EXPAND ARRAY_INTO_ITER_NEXT_U64 fuse_first_has, fuse_first, fuse_iter
    EXPAND ARRAY_INTO_ITER_FUSE_COLLECT_U64 fuse_vec, fuse_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 fuse_after_has, fuse_after, fuse_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 fuse_after_again_has, fuse_after_again, fuse_iter
    EXPAND VEC_LEN fuse_len, fuse_vec
    EXPAND VEC_GET_U64 fuse_0, fuse_vec, 0
    EXPAND VEC_GET_U64 fuse_1, fuse_vec, 1
    EXPAND VEC_GET_U64 fuse_2, fuse_vec, 2

    EXPAND ARRAY_INTO_ITER_DEFAULT_U64 empty_fuse_iter, empty_fuse_backing
    EXPAND ARRAY_INTO_ITER_NEXT_U64 empty_fuse_before_has, empty_fuse_before, empty_fuse_iter
    EXPAND ARRAY_INTO_ITER_FUSE_COLLECT_U64 empty_fuse_vec, empty_fuse_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 empty_fuse_after_has, empty_fuse_after, empty_fuse_iter
    EXPAND VEC_LEN empty_fuse_len, empty_fuse_vec

    peek_arr = stack_alloc 24
    store peek_arr+0, 3 as u64
    store peek_arr+8, 5 as u64
    store peek_arr+16, 8 as u64
    EXPAND ARRAY_INTO_ITER_U64 peek_iter, peek_backing, peek_arr, 3
    EXPAND ITER_TRY_PEEK_U64 peek1_has, peek1_value, peek_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 peek_len_after_peek1, peek_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 peek_next1_has, peek_next1, peek_iter
    EXPAND ITER_TRY_PEEK_U64 peek2_has, peek2_value, peek_iter
    EXPAND ARRAY_INTO_ITER_PEEKABLE_COLLECT_U64 peek_vec, peek_iter
    EXPAND ITER_TRY_PEEK_U64 peek_after_has, peek_after_value, peek_iter
    EXPAND VEC_LEN peek_len, peek_vec
    EXPAND VEC_GET_U64 peek_0, peek_vec, 0
    EXPAND VEC_GET_U64 peek_1, peek_vec, 1

    EXPAND ARRAY_INTO_ITER_DEFAULT_U64 empty_peek_iter, empty_peek_backing
    EXPAND ITER_TRY_PEEK_U64 empty_peek_before_has, empty_peek_before, empty_peek_iter
    EXPAND ARRAY_INTO_ITER_PEEKABLE_COLLECT_U64 empty_peek_vec, empty_peek_iter
    EXPAND ITER_TRY_PEEK_U64 empty_peek_after_has, empty_peek_after, empty_peek_iter
    EXPAND VEC_LEN empty_peek_len, empty_peek_vec

    EXPAND VEC_FREE by_ref_backing
    EXPAND VEC_FREE by_ref_clone_backing
    EXPAND VEC_FREE by_ref_vec
    EXPAND VEC_FREE fuse_backing
    EXPAND VEC_FREE fuse_vec
    EXPAND VEC_FREE empty_fuse_backing
    EXPAND VEC_FREE empty_fuse_vec
    EXPAND VEC_FREE peek_backing
    EXPAND VEC_FREE peek_vec
    EXPAND VEC_FREE empty_peek_backing
    EXPAND VEC_FREE empty_peek_vec

    ok_by_ref_first_has = eq by_ref_first_has, 1
    ok_by_ref_first = eq by_ref_first, 5
    ok_by_ref_empty = eq by_ref_empty, 1
    ok_by_ref_clone_remaining = eq by_ref_clone_remaining, 3
    ok_by_ref_clone_next_has = eq by_ref_clone_next_has, 1
    ok_by_ref_clone_next = eq by_ref_clone_next, 8
    ok_by_ref_len = eq by_ref_len, 3
    ok_by_ref_0 = eq by_ref_0, 8
    ok_by_ref_1 = eq by_ref_1, 13
    ok_by_ref_2 = eq by_ref_2, 21
    ok_fuse_first_has = eq fuse_first_has, 1
    ok_fuse_first = eq fuse_first, 2
    ok_fuse_after_has = eq fuse_after_has, 0
    ok_fuse_after = eq fuse_after, 0
    ok_fuse_after_again_has = eq fuse_after_again_has, 0
    ok_fuse_after_again = eq fuse_after_again, 0
    ok_fuse_len = eq fuse_len, 3
    ok_fuse_0 = eq fuse_0, 4
    ok_fuse_1 = eq fuse_1, 6
    ok_fuse_2 = eq fuse_2, 8
    ok_empty_fuse_before_has = eq empty_fuse_before_has, 0
    ok_empty_fuse_before = eq empty_fuse_before, 0
    ok_empty_fuse_after_has = eq empty_fuse_after_has, 0
    ok_empty_fuse_after = eq empty_fuse_after, 0
    ok_empty_fuse_len = eq empty_fuse_len, 0
    ok_peek1_has = eq peek1_has, 1
    ok_peek1_value = eq peek1_value, 3
    ok_peek_len_after_peek1 = eq peek_len_after_peek1, 3
    ok_peek_next1_has = eq peek_next1_has, 1
    ok_peek_next1 = eq peek_next1, 3
    ok_peek2_has = eq peek2_has, 1
    ok_peek2_value = eq peek2_value, 5
    ok_peek_after_has = eq peek_after_has, 0
    ok_peek_after_value = eq peek_after_value, 0
    ok_peek_len = eq peek_len, 2
    ok_peek_0 = eq peek_0, 5
    ok_peek_1 = eq peek_1, 8
    ok_empty_peek_before_has = eq empty_peek_before_has, 0
    ok_empty_peek_before = eq empty_peek_before, 0
    ok_empty_peek_after_has = eq empty_peek_after_has, 0
    ok_empty_peek_after = eq empty_peek_after, 0
    ok_empty_peek_len = eq empty_peek_len, 0

    ok = and ok_by_ref_first_has, ok_by_ref_first
    ok = and ok, ok_by_ref_empty
    ok = and ok, ok_by_ref_clone_remaining
    ok = and ok, ok_by_ref_clone_next_has
    ok = and ok, ok_by_ref_clone_next
    ok = and ok, ok_by_ref_len
    ok = and ok, ok_by_ref_0
    ok = and ok, ok_by_ref_1
    ok = and ok, ok_by_ref_2
    ok = and ok, ok_fuse_first_has
    ok = and ok, ok_fuse_first
    ok = and ok, ok_fuse_after_has
    ok = and ok, ok_fuse_after
    ok = and ok, ok_fuse_after_again_has
    ok = and ok, ok_fuse_after_again
    ok = and ok, ok_fuse_len
    ok = and ok, ok_fuse_0
    ok = and ok, ok_fuse_1
    ok = and ok, ok_fuse_2
    ok = and ok, ok_empty_fuse_before_has
    ok = and ok, ok_empty_fuse_before
    ok = and ok, ok_empty_fuse_after_has
    ok = and ok, ok_empty_fuse_after
    ok = and ok, ok_empty_fuse_len
    ok = and ok, ok_peek1_has
    ok = and ok, ok_peek1_value
    ok = and ok, ok_peek_len_after_peek1
    ok = and ok, ok_peek_next1_has
    ok = and ok, ok_peek_next1
    ok = and ok, ok_peek2_has
    ok = and ok, ok_peek2_value
    ok = and ok, ok_peek_after_has
    ok = and ok, ok_peek_after_value
    ok = and ok, ok_peek_len
    ok = and ok, ok_peek_0
    ok = and ok, ok_peek_1
    ok = and ok, ok_empty_peek_before_has
    ok = and ok, ok_empty_peek_before
    ok = and ok, ok_empty_peek_after_has
    ok = and ok, ok_empty_peek_after
    ok = and ok, ok_empty_peek_len

    !by_ref_first_has
    !by_ref_first
    !by_ref_empty
    !by_ref_clone_remaining
    !by_ref_clone_next_has
    !by_ref_clone_next
    !by_ref_len
    !by_ref_0
    !by_ref_1
    !by_ref_2
    !fuse_first_has
    !fuse_first
    !fuse_after_has
    !fuse_after
    !fuse_after_again_has
    !fuse_after_again
    !fuse_len
    !fuse_0
    !fuse_1
    !fuse_2
    !empty_fuse_before_has
    !empty_fuse_before
    !empty_fuse_after_has
    !empty_fuse_after
    !empty_fuse_len
    !peek1_has
    !peek1_value
    !peek_len_after_peek1
    !peek_next1_has
    !peek_next1
    !peek2_has
    !peek2_value
    !peek_after_has
    !peek_after_value
    !peek_len
    !peek_0
    !peek_1
    !empty_peek_before_has
    !empty_peek_before
    !empty_peek_after_has
    !empty_peek_after
    !empty_peek_len
    !ok_by_ref_first_has
    !ok_by_ref_first
    !ok_by_ref_empty
    !ok_by_ref_clone_remaining
    !ok_by_ref_clone_next_has
    !ok_by_ref_clone_next
    !ok_by_ref_len
    !ok_by_ref_0
    !ok_by_ref_1
    !ok_by_ref_2
    !ok_fuse_first_has
    !ok_fuse_first
    !ok_fuse_after_has
    !ok_fuse_after
    !ok_fuse_after_again_has
    !ok_fuse_after_again
    !ok_fuse_len
    !ok_fuse_0
    !ok_fuse_1
    !ok_fuse_2
    !ok_empty_fuse_before_has
    !ok_empty_fuse_before
    !ok_empty_fuse_after_has
    !ok_empty_fuse_after
    !ok_empty_fuse_len
    !ok_peek1_has
    !ok_peek1_value
    !ok_peek_len_after_peek1
    !ok_peek_next1_has
    !ok_peek_next1
    !ok_peek2_has
    !ok_peek2_value
    !ok_peek_after_has
    !ok_peek_after_value
    !ok_peek_len
    !ok_peek_0
    !ok_peek_1
    !ok_empty_peek_before_has
    !ok_empty_peek_before
    !ok_empty_peek_after_has
    !ok_empty_peek_after
    !ok_empty_peek_len
    !by_ref_iter
    !by_ref_clone_iter
    !fuse_iter
    !empty_fuse_iter
    !peek_iter
    !empty_peek_iter
    br ok -> L_ARRAY_INTO_ITER_ADAPTER_STATE_COLLECT_OK, L_ARRAY_INTO_ITER_ADAPTER_STATE_COLLECT_FAIL

L_ARRAY_INTO_ITER_ADAPTER_STATE_COLLECT_FAIL:
    !ok
    panic(10751)

L_ARRAY_INTO_ITER_ADAPTER_STATE_COLLECT_OK:
    !ok
    return
