    return 0

@test "sa_std fs file raw owned fd macros"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FD_FILE_TEST_PATH, FD_FILE_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FD_FILE_TEST_PATH, FD_FILE_TEST_PATH_LEN, FD_FILE_TEST_DATA, FD_FILE_TEST_DATA_LEN
    EXPAND FS_OPEN_READ open_status, file_handle, FD_FILE_TEST_PATH, FD_FILE_TEST_PATH_LEN
    EXPAND FS_FILE_AS_RAW_FD as_status, as_fd, file_handle
    EXPAND FS_FILE_INTO_OWNED_FD into_owned_status, owned_fd, file_handle
    EXPAND FS_FILE_FROM_OWNED_FD from_owned_status, file_handle, owned_fd

    owned_buf = stack_alloc 4
    EXPAND FS_READ_AT owned_read_status, owned_read_len, file_handle, owned_buf, 2, 4
    owned_b0 = load owned_buf+0 as u8
    owned_b1 = load owned_buf+1 as u8

    EXPAND FS_FILE_INTO_RAW_FD into_raw_status, raw_taken, file_handle
    EXPAND FS_FILE_FROM_RAW_FD from_raw_status, file_handle, raw_taken
    raw_buf = stack_alloc 4
    EXPAND FS_READ_AT raw_read_status, raw_read_len, file_handle, raw_buf, 4, 0
    raw_b0 = load raw_buf+0 as u8
    raw_b3 = load raw_buf+3 as u8

    EXPAND FS_CLOSE close_status, file_handle
    EXPAND FS_REMOVE_PATH remove_status, FD_FILE_TEST_PATH, FD_FILE_TEST_PATH_LEN

    write_ok = eq write_status, SA_FS_OK
    open_ok = eq open_status, SA_FS_OK
    as_ok = eq as_status, SA_FD_OK
    as_fd_ok = ne as_fd, 0
    into_owned_ok = eq into_owned_status, SA_FD_OK
    owned_fd_ok = ne owned_fd, 0
    from_owned_ok = eq from_owned_status, SA_FD_OK
    file_rebound_ok = ne file_handle, 0
    owned_read_ok = eq owned_read_status, SA_FS_OK
    owned_read_len_ok = eq owned_read_len, 2
    owned_b0_ok = eq owned_b0, 102
    owned_b1_ok = eq owned_b1, 100
    into_raw_ok = eq into_raw_status, SA_FD_OK
    raw_taken_ok = ne raw_taken, 0
    from_raw_ok = eq from_raw_status, SA_FD_OK
    raw_file_ok = ne file_handle, 0
    raw_read_ok = eq raw_read_status, SA_FS_OK
    raw_read_len_ok = eq raw_read_len, 4
    raw_b0_ok = eq raw_b0, 102
    raw_b3_ok = eq raw_b3, 101
    close_ok = eq close_status, SA_FS_OK
    remove_ok = eq remove_status, SA_FS_OK

    ok01 = and write_ok, open_ok
    ok02 = and ok01, as_ok
    ok03 = and ok02, as_fd_ok
    ok04 = and ok03, into_owned_ok
    ok05 = and ok04, owned_fd_ok
    ok06 = and ok05, from_owned_ok
    ok07 = and ok06, file_rebound_ok
    ok08 = and ok07, owned_read_ok
    ok09 = and ok08, owned_read_len_ok
    ok10 = and ok09, owned_b0_ok
    ok11 = and ok10, owned_b1_ok
    ok12 = and ok11, into_raw_ok
    ok13 = and ok12, raw_taken_ok
    ok14 = and ok13, from_raw_ok
    ok15 = and ok14, raw_file_ok
    ok16 = and ok15, raw_read_ok
    ok17 = and ok16, raw_read_len_ok
    ok18 = and ok17, raw_b0_ok
    ok19 = and ok18, raw_b3_ok
    ok20 = and ok19, close_ok
    ok = and ok20, remove_ok

    !cleanup_status
    !write_status
    !open_status
    !file_handle
    !as_status
    !as_fd
    !into_owned_status
    !owned_fd
    !from_owned_status
    !owned_read_status
    !owned_read_len
    !owned_b0
    !owned_b1
    !into_raw_status
    !raw_taken
    !from_raw_status
    !raw_read_status
    !raw_read_len
    !raw_b0
    !raw_b3
    !close_status
    !remove_status
    !write_ok
    !open_ok
    !as_ok
    !as_fd_ok
    !into_owned_ok
    !owned_fd_ok
    !from_owned_ok
    !file_rebound_ok
    !owned_read_ok
    !owned_read_len_ok
    !owned_b0_ok
    !owned_b1_ok
    !into_raw_ok
    !raw_taken_ok
    !from_raw_ok
    !raw_file_ok
    !raw_read_ok
    !raw_read_len_ok
    !raw_b0_ok
    !raw_b3_ok
    !close_ok
    !remove_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1502)

L_PASS:
    !ok
    return 0

@test "sa_std os fd raw dup from_into macros"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FD_TEST_PATH, FD_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FD_TEST_PATH, FD_TEST_PATH_LEN, FD_TEST_DATA, FD_TEST_DATA_LEN
    EXPAND FS_OPEN_READ open_status, file_handle, FD_TEST_PATH, FD_TEST_PATH_LEN
    EXPAND FD_AS_RAW raw_status, raw_fd, file_handle
    EXPAND FD_DUP dup_status, dup_handle, file_handle
    EXPAND FD_INTO_RAW into_status, dup_raw_fd, dup_handle
    EXPAND FD_FROM_RAW from_status, rebound_handle, dup_raw_fd
    read_buf = stack_alloc 8
    EXPAND FS_READ read_status, read_len, rebound_handle, read_buf, 8
    b0 = load read_buf+0 as u8
    b3 = load read_buf+3 as u8
    stdout_handle = call @sa_io_stdout()
    EXPAND FD_IS_TERMINAL tty_status, tty_flag, stdout_handle
    tty_is_zero = eq tty_flag, 0
    tty_is_one = eq tty_flag, 1
    tty_flag_ok = or tty_is_zero, tty_is_one
    EXPAND FS_CLOSE close_rebound_status, rebound_handle
    EXPAND FS_CLOSE close_file_status, file_handle
    EXPAND FS_REMOVE_PATH remove_status, FD_TEST_PATH, FD_TEST_PATH_LEN

    write_ok = eq write_status, SA_FS_OK
    open_ok = eq open_status, SA_FS_OK
    raw_ok = eq raw_status, SA_FD_OK
    raw_fd_ok = ne raw_fd, 0
    dup_ok = eq dup_status, SA_FD_OK
    dup_handle_ok = ne dup_handle, 0
    into_ok = eq into_status, SA_FD_OK
    dup_raw_ok = ne dup_raw_fd, 0
    from_ok = eq from_status, SA_FD_OK
    rebound_ok = ne rebound_handle, 0
    read_status_ok = eq read_status, SA_FS_OK
    read_len_ok = eq read_len, 4
    b0_ok = eq b0, 102
    b3_ok = eq b3, 107
    tty_status_ok = eq tty_status, SA_FD_OK
    close_rebound_ok = eq close_rebound_status, SA_FS_OK
    close_file_ok = eq close_file_status, SA_FS_OK
    remove_ok = eq remove_status, SA_FS_OK

    ok01 = and write_ok, open_ok
    ok02 = and ok01, raw_ok
    ok03 = and ok02, raw_fd_ok
    ok04 = and ok03, dup_ok
    ok05 = and ok04, dup_handle_ok
    ok06 = and ok05, into_ok
    ok07 = and ok06, dup_raw_ok
    ok08 = and ok07, from_ok
    ok09 = and ok08, rebound_ok
    ok10 = and ok09, read_status_ok
    ok11 = and ok10, read_len_ok
    ok12 = and ok11, b0_ok
    ok13 = and ok12, b3_ok
    ok14 = and ok13, tty_status_ok
    ok15 = and ok14, tty_flag_ok
    ok16 = and ok15, close_rebound_ok
    ok17 = and ok16, close_file_ok
    ok = and ok17, remove_ok

    !cleanup_status
    !write_status
    !open_status
    !file_handle
    !raw_status
    !raw_fd
    !dup_status
    !dup_handle
    !into_status
    !dup_raw_fd
    !from_status
    !rebound_handle
    !read_status
    !read_len
    !b0
    !b3
    !stdout_handle
    !tty_status
    !tty_flag
    !tty_is_zero
    !tty_is_one
    !tty_flag_ok
    !close_rebound_status
    !close_file_status
    !remove_status
    !write_ok
    !open_ok
    !raw_ok
    !raw_fd_ok
    !dup_ok
    !dup_handle_ok
    !into_ok
    !dup_raw_ok
    !from_ok
    !rebound_ok
    !read_status_ok
    !read_len_ok
    !b0_ok
    !b3_ok
    !tty_status_ok
    !close_rebound_ok
    !close_file_ok
    !remove_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1501)

L_PASS:
    !ok
    return 0

@test "sa_std os fd invalid handles are deterministic"():
L_ENTRY:
    EXPAND FD_AS_RAW as_status, as_fd, 0
    as_invalid = eq as_status, SA_FD_ERR_INVALID_HANDLE
    as_unsupported = eq as_status, SA_FD_ERR_UNSUPPORTED
    br as_invalid -> L_FD_AS_INVALID, L_FD_AS_NONINVALID
L_FD_AS_NONINVALID:
    br as_unsupported -> L_FD_DUP_CALL, L_FD_FAIL_10996
L_FD_AS_INVALID:
    as_value_ok = eq as_fd, -1
    br as_value_ok -> L_FD_DUP_CALL, L_FD_FAIL_10997
L_FD_DUP_CALL:
    EXPAND FD_DUP dup_status, dup_handle, 0
    dup_invalid = eq dup_status, SA_FD_ERR_INVALID_HANDLE
    dup_unsupported = eq dup_status, SA_FD_ERR_UNSUPPORTED
    br dup_invalid -> L_FD_DUP_INVALID, L_FD_DUP_NONINVALID
L_FD_DUP_NONINVALID:
    br dup_unsupported -> L_FD_DUP_RAW_CALL, L_FD_FAIL_10998
L_FD_DUP_INVALID:
    dup_value_ok = eq dup_handle, 0
    br dup_value_ok -> L_FD_DUP_RAW_CALL, L_FD_FAIL_10999
L_FD_DUP_RAW_CALL:
    EXPAND FD_DUP_RAW dup_raw_status, dup_raw_handle, -1
    dup_raw_invalid = eq dup_raw_status, SA_FD_ERR_INVALID_ARGUMENT
    dup_raw_unsupported = eq dup_raw_status, SA_FD_ERR_UNSUPPORTED
    br dup_raw_invalid -> L_FD_DUP_RAW_INVALID, L_FD_DUP_RAW_NONINVALID
L_FD_DUP_RAW_NONINVALID:
    br dup_raw_unsupported -> L_FD_FROM_RAW_CALL, L_FD_FAIL_11000
L_FD_DUP_RAW_INVALID:
    dup_raw_value_ok = eq dup_raw_handle, 0
    br dup_raw_value_ok -> L_FD_FROM_RAW_CALL, L_FD_FAIL_11001
L_FD_FROM_RAW_CALL:
    EXPAND FD_FROM_RAW from_status, from_handle, -1
    from_invalid = eq from_status, SA_FD_ERR_INVALID_ARGUMENT
    from_unsupported = eq from_status, SA_FD_ERR_UNSUPPORTED
    br from_invalid -> L_FD_FROM_RAW_INVALID, L_FD_FROM_RAW_NONINVALID
L_FD_FROM_RAW_NONINVALID:
    br from_unsupported -> L_FD_INTO_CALL, L_FD_FAIL_11002
L_FD_FROM_RAW_INVALID:
    from_value_ok = eq from_handle, 0
    br from_value_ok -> L_FD_INTO_CALL, L_FD_FAIL_11003
L_FD_INTO_CALL:
    EXPAND FD_INTO_RAW into_status, into_fd, 0
    into_invalid = eq into_status, SA_FD_ERR_INVALID_HANDLE
    into_unsupported = eq into_status, SA_FD_ERR_UNSUPPORTED
    br into_invalid -> L_FD_INTO_INVALID, L_FD_INTO_NONINVALID
L_FD_INTO_NONINVALID:
    br into_unsupported -> L_FD_TTY_CALL, L_FD_FAIL_11004
L_FD_INTO_INVALID:
    into_value_ok = eq into_fd, -1
    br into_value_ok -> L_FD_TTY_CALL, L_FD_FAIL_11005
L_FD_TTY_CALL:
    EXPAND FD_IS_TERMINAL tty_status, tty_flag, 0
    tty_invalid = eq tty_status, SA_FD_ERR_INVALID_HANDLE
    tty_unsupported = eq tty_status, SA_FD_ERR_UNSUPPORTED
    br tty_invalid -> L_FD_TTY_INVALID, L_FD_TTY_NONINVALID
L_FD_TTY_NONINVALID:
    br tty_unsupported -> L_FD_PASS, L_FD_FAIL_11006
L_FD_TTY_INVALID:
    tty_value_ok = eq tty_flag, 0
    br tty_value_ok -> L_FD_PASS, L_FD_FAIL_11007
L_FD_PASS:
    return 0
L_FD_FAIL_10996:
    panic(10996)
L_FD_FAIL_10997:
    panic(10997)
L_FD_FAIL_10998:
    panic(10998)
L_FD_FAIL_10999:
    panic(10999)
L_FD_FAIL_11000:
    panic(11000)
L_FD_FAIL_11001:
    panic(11001)
L_FD_FAIL_11002:
    panic(11002)
L_FD_FAIL_11003:
    panic(11003)
L_FD_FAIL_11004:
    panic(11004)
L_FD_FAIL_11005:
    panic(11005)
L_FD_FAIL_11006:
