@import "sa_std/fs.sars"
@import "sa_std/os/fd.sars"
@import "sa_std/io.sai"

@const FD_TEST_PATH = utf8:"_tmp_fd_macro_surface.txt"
@const FD_TEST_DATA = utf8:"fdok"
@const FD_FILE_TEST_PATH = utf8:"_tmp_fs_file_fd_surface.txt"
@const FD_FILE_TEST_DATA = utf8:"filefd"
@const FD_OWNED_TEST_PATH = utf8:"_tmp_owned_fd_surface.txt"
@const FD_OWNED_TEST_DATA = utf8:"ownedfd"
@const FD_BORROWED_TEST_PATH = utf8:"_tmp_borrowed_fd_surface.txt"
@const FD_BORROWED_TEST_DATA = utf8:"borrowfd"

#def FD_TEST_PATH_LEN = 25
#def FD_TEST_DATA_LEN = 4
#def FD_FILE_TEST_PATH_LEN = 27
#def FD_FILE_TEST_DATA_LEN = 6
#def FD_OWNED_TEST_PATH_LEN = 25
#def FD_OWNED_TEST_DATA_LEN = 7
#def FD_BORROWED_TEST_PATH_LEN = 28
#def FD_BORROWED_TEST_DATA_LEN = 8

@test "sa_std os raw borrowed fd macros"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FD_BORROWED_TEST_PATH, FD_BORROWED_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FD_BORROWED_TEST_PATH, FD_BORROWED_TEST_PATH_LEN, FD_BORROWED_TEST_DATA, FD_BORROWED_TEST_DATA_LEN
    EXPAND FS_OPEN_READ open_status, file_handle, FD_BORROWED_TEST_PATH, FD_BORROWED_TEST_PATH_LEN
    EXPAND FS_FILE_AS_RAW_FD file_raw_status, file_raw_fd, file_handle
    EXPAND FD_RAW_AS_RAW_FD raw_as_status, raw_as_fd, file_raw_fd
    EXPAND FD_RAW_INTO_RAW_FD raw_into_status, raw_into_fd, raw_as_fd
    EXPAND FD_RAW_FROM_RAW_FD raw_from_status, raw_from_fd, raw_into_fd
    EXPAND FD_BORROWED_BORROW_RAW borrow_status, borrowed_fd, raw_from_fd
    EXPAND FD_BORROWED_AS_RAW_FD borrowed_as_status, borrowed_as_fd, borrowed_fd
    EXPAND FD_BORROWED_TRY_CLONE_TO_OWNED clone_status, cloned_owned_fd, borrowed_as_fd
    EXPAND FS_CLOSE close_file_status, file_handle

    read_buf = stack_alloc 8
    EXPAND FS_READ read_status, read_len, cloned_owned_fd, read_buf, 8
    b0 = load read_buf+0 as u8
    b7 = load read_buf+7 as u8
    EXPAND FS_CLOSE clone_close_status, cloned_owned_fd
    EXPAND FS_REMOVE_PATH remove_status, FD_BORROWED_TEST_PATH, FD_BORROWED_TEST_PATH_LEN

    write_ok = eq write_status, SA_FS_OK
    open_ok = eq open_status, SA_FS_OK
    file_raw_ok = eq file_raw_status, SA_FD_OK
    file_raw_fd_ok = ne file_raw_fd, 0
    raw_as_ok = eq raw_as_status, SA_FD_OK
    raw_as_fd_ok = eq raw_as_fd, file_raw_fd
    raw_into_ok = eq raw_into_status, SA_FD_OK
    raw_into_fd_ok = eq raw_into_fd, file_raw_fd
    raw_from_ok = eq raw_from_status, SA_FD_OK
    raw_from_fd_ok = eq raw_from_fd, file_raw_fd
    borrow_ok = eq borrow_status, SA_FD_OK
    borrowed_fd_ok = eq borrowed_fd, file_raw_fd
    borrowed_as_ok = eq borrowed_as_status, SA_FD_OK
    borrowed_as_fd_ok = eq borrowed_as_fd, file_raw_fd
    clone_ok = eq clone_status, SA_FD_OK
    cloned_owned_ok = ne cloned_owned_fd, 0
    close_file_ok = eq close_file_status, SA_FS_OK
    read_ok = eq read_status, SA_FS_OK
    read_len_ok = eq read_len, 8
    b0_ok = eq b0, 98
    b7_ok = eq b7, 100
    clone_close_ok = eq clone_close_status, SA_FS_OK
    remove_ok = eq remove_status, SA_FS_OK

    ok01 = and write_ok, open_ok
    ok02 = and ok01, file_raw_ok
    ok03 = and ok02, file_raw_fd_ok
    ok04 = and ok03, raw_as_ok
    ok05 = and ok04, raw_as_fd_ok
    ok06 = and ok05, raw_into_ok
    ok07 = and ok06, raw_into_fd_ok
    ok08 = and ok07, raw_from_ok
    ok09 = and ok08, raw_from_fd_ok
    ok10 = and ok09, borrow_ok
    ok11 = and ok10, borrowed_fd_ok
    ok12 = and ok11, borrowed_as_ok
    ok13 = and ok12, borrowed_as_fd_ok
    ok14 = and ok13, clone_ok
    ok15 = and ok14, cloned_owned_ok
    ok16 = and ok15, close_file_ok
    ok17 = and ok16, read_ok
    ok18 = and ok17, read_len_ok
    ok19 = and ok18, b0_ok
    ok20 = and ok19, b7_ok
    ok21 = and ok20, clone_close_ok
    ok = and ok21, remove_ok

    !cleanup_status
    !write_status
    !open_status
    !file_handle
    !file_raw_status
    !file_raw_fd
    !raw_as_status
    !raw_as_fd
    !raw_into_status
    !raw_into_fd
    !raw_from_status
    !raw_from_fd
    !borrow_status
    !borrowed_fd
    !borrowed_as_status
    !borrowed_as_fd
    !clone_status
    !cloned_owned_fd
    !close_file_status
    !read_status
    !read_len
    !b0
    !b7
    !clone_close_status
    !remove_status
    !write_ok
    !open_ok
    !file_raw_ok
    !file_raw_fd_ok
    !raw_as_ok
    !raw_as_fd_ok
    !raw_into_ok
    !raw_into_fd_ok
    !raw_from_ok
    !raw_from_fd_ok
    !borrow_ok
    !borrowed_fd_ok
    !borrowed_as_ok
    !borrowed_as_fd_ok
    !clone_ok
    !cloned_owned_ok
    !close_file_ok
    !read_ok
    !read_len_ok
    !b0_ok
    !b7_ok
    !clone_close_ok
    !remove_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1504)

L_PASS:
    !ok
    return 0

@test "sa_std os owned fd named macros"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_status, FD_OWNED_TEST_PATH, FD_OWNED_TEST_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FD_OWNED_TEST_PATH, FD_OWNED_TEST_PATH_LEN, FD_OWNED_TEST_DATA, FD_OWNED_TEST_DATA_LEN
    EXPAND FS_OPEN_READ open_status, file_handle, FD_OWNED_TEST_PATH, FD_OWNED_TEST_PATH_LEN
    EXPAND FS_FILE_INTO_OWNED_FD into_owned_status, owned_fd, file_handle
    EXPAND FD_OWNED_AS_RAW_FD as_status, raw_fd, owned_fd
    EXPAND FD_OWNED_TRY_CLONE clone_status, clone_fd, owned_fd
    EXPAND FD_OWNED_INTO_RAW_FD clone_into_status, clone_raw, clone_fd
    EXPAND FD_OWNED_FROM_RAW_FD clone_from_status, clone_fd, clone_raw
    EXPAND FD_OWNED_AS_RAW_FD clone_as_status, clone_as_raw, clone_fd
    EXPAND FS_CLOSE clone_close_status, clone_fd

    read_buf = stack_alloc 8
    EXPAND FS_READ read_status, read_len, owned_fd, read_buf, 8
    b0 = load read_buf+0 as u8
    b6 = load read_buf+6 as u8
    EXPAND FS_CLOSE owned_close_status, owned_fd
    EXPAND FS_REMOVE_PATH remove_status, FD_OWNED_TEST_PATH, FD_OWNED_TEST_PATH_LEN

    write_ok = eq write_status, SA_FS_OK
    open_ok = eq open_status, SA_FS_OK
    into_owned_ok = eq into_owned_status, SA_FD_OK
    owned_fd_ok = ne owned_fd, 0
    as_ok = eq as_status, SA_FD_OK
    raw_fd_ok = ne raw_fd, 0
    clone_ok = eq clone_status, SA_FD_OK
    clone_fd_ok = ne clone_fd, 0
    clone_into_ok = eq clone_into_status, SA_FD_OK
    clone_raw_ok = ne clone_raw, 0
    clone_from_ok = eq clone_from_status, SA_FD_OK
    clone_rebound_ok = ne clone_fd, 0
    clone_as_ok = eq clone_as_status, SA_FD_OK
    clone_as_raw_ok = ne clone_as_raw, 0
    clone_close_ok = eq clone_close_status, SA_FS_OK
    read_ok = eq read_status, SA_FS_OK
    read_len_ok = eq read_len, 7
    b0_ok = eq b0, 111
    b6_ok = eq b6, 100
    owned_close_ok = eq owned_close_status, SA_FS_OK
    remove_ok = eq remove_status, SA_FS_OK

    ok01 = and write_ok, open_ok
    ok02 = and ok01, into_owned_ok
    ok03 = and ok02, owned_fd_ok
    ok04 = and ok03, as_ok
    ok05 = and ok04, raw_fd_ok
    ok06 = and ok05, clone_ok
    ok07 = and ok06, clone_fd_ok
    ok08 = and ok07, clone_into_ok
    ok09 = and ok08, clone_raw_ok
    ok10 = and ok09, clone_from_ok
    ok11 = and ok10, clone_rebound_ok
    ok12 = and ok11, clone_as_ok
    ok13 = and ok12, clone_as_raw_ok
    ok14 = and ok13, clone_close_ok
    ok15 = and ok14, read_ok
    ok16 = and ok15, read_len_ok
    ok17 = and ok16, b0_ok
    ok18 = and ok17, b6_ok
    ok19 = and ok18, owned_close_ok
    ok = and ok19, remove_ok

    !cleanup_status
    !write_status
    !open_status
    !file_handle
    !into_owned_status
    !owned_fd
    !as_status
    !raw_fd
    !clone_status
    !clone_fd
    !clone_into_status
    !clone_raw
    !clone_from_status
    !clone_as_status
    !clone_as_raw
    !clone_close_status
    !read_status
    !read_len
    !b0
    !b6
    !owned_close_status
    !remove_status
    !write_ok
    !open_ok
    !into_owned_ok
    !owned_fd_ok
    !as_ok
    !raw_fd_ok
    !clone_ok
    !clone_fd_ok
    !clone_into_ok
    !clone_raw_ok
    !clone_from_ok
    !clone_rebound_ok
    !clone_as_ok
    !clone_as_raw_ok
    !clone_close_ok
    !read_ok
    !read_len_ok
    !b0_ok
    !b6_ok
    !owned_close_ok
    !remove_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1503)

L_PASS:
