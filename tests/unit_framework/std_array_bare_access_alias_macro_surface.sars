@import "sa_std/array.sars"

@test "sa_std array bare access alias macro surface"():
L_ENTRY:
    arr = stack_alloc 32
    src = stack_alloc 32
    copy = stack_alloc 32
    store arr+0, 1 as u64
    store arr+8, 2 as u64
    store arr+16, 3 as u64
    store arr+24, 4 as u64
    store src+0, 10 as u64
    store src+8, 20 as u64
    store src+16, 30 as u64
    store src+24, 40 as u64

    EXPAND ARRAY_FIRST first, arr
    EXPAND ARRAY_LAST last, arr, 4
    EXPAND ARRAY_GET second, arr, 1
    EXPAND ARRAY_TRY_GET get_ok, get_value, arr, 4, 2
    EXPAND ARRAY_TRY_GET get_miss_ok, get_miss_value, arr, 4, 9
    EXPAND ARRAY_TRY_GET_MUT_PTR mut_ok, mut_ptr, arr, 4, 1
    EXPAND ARRAY_TRY_GET_MUT_PTR mut_miss_ok, mut_miss_ptr, arr, 4, 9
    store mut_ptr+0, 55 as u64
    EXPAND ARRAY_GET after_mut, arr, 1

    EXPAND ARRAY_FILL copy, 4, 7
    copy_fill0 = load copy+0 as u64
    copy_fill3 = load copy+24 as u64
    EXPAND ARRAY_COPY copy, src, 4
    copy0 = load copy+0 as u64
    copy3 = load copy+24 as u64
    EXPAND ARRAY_SWAP copy, 0, 3
    copy_swap0 = load copy+0 as u64
    copy_swap3 = load copy+24 as u64
    EXPAND ARRAY_REVERSE copy, 4
    copy_rev0 = load copy+0 as u64
    copy_rev3 = load copy+24 as u64

    ok_first = eq first, 1
    ok_last = eq last, 4
    ok_second = eq second, 2
    ok_get_flag = eq get_ok, 1
    ok_get_value = eq get_value, 3
    ok_get_miss_flag = eq get_miss_ok, 0
    ok_get_miss_value = eq get_miss_value, 0
    ok_mut_flag = eq mut_ok, 1
    ok_mut = eq after_mut, 55
    ok_mut_miss_flag = eq mut_miss_ok, 0
    null_ptr = 0 as ptr
    ok_mut_miss_ptr = eq mut_miss_ptr, null_ptr
    ok_fill0 = eq copy_fill0, 7
    ok_fill3 = eq copy_fill3, 7
    ok_copy0 = eq copy0, 10
    ok_copy3 = eq copy3, 40
    ok_swap0 = eq copy_swap0, 40
    ok_swap3 = eq copy_swap3, 10
    ok_rev0 = eq copy_rev0, 10
    ok_rev3 = eq copy_rev3, 40

    ok01 = and ok_first, ok_last
    ok02 = and ok01, ok_second
    ok03 = and ok02, ok_get_flag
    ok04 = and ok03, ok_get_value
    ok05 = and ok04, ok_get_miss_flag
    ok06 = and ok05, ok_get_miss_value
    ok07 = and ok06, ok_mut_flag
    ok08 = and ok07, ok_mut
    ok09 = and ok08, ok_mut_miss_flag
    ok10 = and ok09, ok_mut_miss_ptr
    ok11 = and ok10, ok_fill0
    ok12 = and ok11, ok_fill3
    ok13 = and ok12, ok_copy0
    ok14 = and ok13, ok_copy3
    ok15 = and ok14, ok_swap0
    ok16 = and ok15, ok_swap3
    ok17 = and ok16, ok_rev0
    ok = and ok17, ok_rev3

    !null_ptr
    !mut_miss_ptr
    !mut_ptr
    !first
    !last
    !second
    !get_ok
    !get_value
    !get_miss_ok
    !get_miss_value
    !mut_ok
    !after_mut
    !mut_miss_ok
    !copy_fill0
    !copy_fill3
    !copy0
    !copy3
    !copy_swap0
    !copy_swap3
    !copy_rev0
    !copy_rev3
    !ok_first
    !ok_last
    !ok_second
    !ok_get_flag
    !ok_get_value
    !ok_get_miss_flag
    !ok_get_miss_value
    !ok_mut_flag
    !ok_mut
    !ok_mut_miss_flag
    !ok_mut_miss_ptr
    !ok_fill0
    !ok_fill3
    !ok_copy0
    !ok_copy3
    !ok_swap0
    !ok_swap3
    !ok_rev0
    !ok_rev3
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10851)

L_PASS:
    !ok
    return 0
