@import "sa_std/array.sars"

@array_into_iter_sorted_le(left: u64, right: u64) -> u64:
L_ENTRY:
    out = ule left, right
    !right
    !left
    return out

@array_into_iter_sorted_lt(left: u64, right: u64) -> u64:
L_ENTRY:
    out = ult left, right
    !right
    !left
    return out

@array_into_iter_sorted_key_tens(value: u64) -> u64:
L_ENTRY:
    out = udiv value, 10
    !value
    return out

@test "sa_std array into_iter sorted macro surface"():
L_ENTRY:
    sorted_arr = stack_alloc 32
    store sorted_arr+0, 1 as u64
    store sorted_arr+8, 2 as u64
    store sorted_arr+16, 2 as u64
    store sorted_arr+24, 4 as u64
    EXPAND ARRAY_INTO_ITER_U64 sorted_iter, sorted_backing, sorted_arr, 4
    EXPAND ARRAY_INTO_ITER_IS_SORTED_U64 sorted_value, sorted_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 sorted_empty, sorted_iter

    unsorted_arr = stack_alloc 24
    store unsorted_arr+0, 1 as u64
    store unsorted_arr+8, 4 as u64
    store unsorted_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 unsorted_iter, unsorted_backing, unsorted_arr, 3
    EXPAND ARRAY_INTO_ITER_IS_SORTED_U64 unsorted_value, unsorted_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 unsorted_empty, unsorted_iter

    sorted_by_arr = stack_alloc 24
    store sorted_by_arr+0, 1 as u64
    store sorted_by_arr+8, 2 as u64
    store sorted_by_arr+16, 2 as u64
    EXPAND ARRAY_INTO_ITER_U64 sorted_by_iter, sorted_by_backing, sorted_by_arr, 3
    EXPAND ARRAY_INTO_ITER_IS_SORTED_BY_U64 sorted_by_value, sorted_by_iter, @array_into_iter_sorted_le
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 sorted_by_empty, sorted_by_iter

    unsorted_by_arr = stack_alloc 24
    store unsorted_by_arr+0, 1 as u64
    store unsorted_by_arr+8, 2 as u64
    store unsorted_by_arr+16, 2 as u64
    EXPAND ARRAY_INTO_ITER_U64 unsorted_by_iter, unsorted_by_backing, unsorted_by_arr, 3
    EXPAND ARRAY_INTO_ITER_IS_SORTED_BY_U64 unsorted_by_value, unsorted_by_iter, @array_into_iter_sorted_lt
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 unsorted_by_empty, unsorted_by_iter

    sorted_key_arr = stack_alloc 32
    store sorted_key_arr+0, 11 as u64
    store sorted_key_arr+8, 19 as u64
    store sorted_key_arr+16, 22 as u64
    store sorted_key_arr+24, 35 as u64
    EXPAND ARRAY_INTO_ITER_U64 sorted_key_iter, sorted_key_backing, sorted_key_arr, 4
    EXPAND ARRAY_INTO_ITER_IS_SORTED_BY_KEY_U64 sorted_key_value, sorted_key_iter, @array_into_iter_sorted_key_tens
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 sorted_key_empty, sorted_key_iter

    unsorted_key_arr = stack_alloc 24
    store unsorted_key_arr+0, 11 as u64
    store unsorted_key_arr+8, 35 as u64
    store unsorted_key_arr+16, 22 as u64
    EXPAND ARRAY_INTO_ITER_U64 unsorted_key_iter, unsorted_key_backing, unsorted_key_arr, 3
    EXPAND ARRAY_INTO_ITER_IS_SORTED_BY_KEY_U64 unsorted_key_value, unsorted_key_iter, @array_into_iter_sorted_key_tens
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 unsorted_key_empty, unsorted_key_iter

    EXPAND ARRAY_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND ARRAY_INTO_ITER_IS_SORTED_U64 empty_sorted, empty_iter
    EXPAND ARRAY_INTO_ITER_IS_SORTED_BY_U64 empty_sorted_by, empty_iter, @array_into_iter_sorted_lt

    EXPAND VEC_FREE sorted_backing
    EXPAND VEC_FREE unsorted_backing
    EXPAND VEC_FREE sorted_by_backing
    EXPAND VEC_FREE unsorted_by_backing
    EXPAND VEC_FREE sorted_key_backing
    EXPAND VEC_FREE unsorted_key_backing
    EXPAND VEC_FREE empty_backing

    ok_sorted = eq sorted_value, 1
    ok_sorted_empty = eq sorted_empty, 1
    ok_unsorted = eq unsorted_value, 0
    ok_unsorted_empty = eq unsorted_empty, 1
    ok_sorted_by = eq sorted_by_value, 1
    ok_sorted_by_empty = eq sorted_by_empty, 1
    ok_unsorted_by = eq unsorted_by_value, 0
    ok_unsorted_by_empty = eq unsorted_by_empty, 1
    ok_sorted_key = eq sorted_key_value, 1
    ok_sorted_key_empty = eq sorted_key_empty, 1
    ok_unsorted_key = eq unsorted_key_value, 0
    ok_unsorted_key_empty = eq unsorted_key_empty, 1
    ok_empty_sorted = eq empty_sorted, 1
    ok_empty_sorted_by = eq empty_sorted_by, 1

    ok = and ok_sorted, ok_sorted_empty
    ok = and ok, ok_unsorted
    ok = and ok, ok_unsorted_empty
    ok = and ok, ok_sorted_by
    ok = and ok, ok_sorted_by_empty
    ok = and ok, ok_unsorted_by
    ok = and ok, ok_unsorted_by_empty
    ok = and ok, ok_sorted_key
    ok = and ok, ok_sorted_key_empty
    ok = and ok, ok_unsorted_key
    ok = and ok, ok_unsorted_key_empty
    ok = and ok, ok_empty_sorted
    ok = and ok, ok_empty_sorted_by

    !sorted_value
    !sorted_empty
    !unsorted_value
    !unsorted_empty
    !sorted_by_value
    !sorted_by_empty
    !unsorted_by_value
    !unsorted_by_empty
    !sorted_key_value
    !sorted_key_empty
    !unsorted_key_value
    !unsorted_key_empty
    !empty_sorted
    !empty_sorted_by
    !ok_sorted
    !ok_sorted_empty
    !ok_unsorted
    !ok_unsorted_empty
    !ok_sorted_by
    !ok_sorted_by_empty
    !ok_unsorted_by
    !ok_unsorted_by_empty
    !ok_sorted_key
    !ok_sorted_key_empty
    !ok_unsorted_key
    !ok_unsorted_key_empty
    !ok_empty_sorted
    !ok_empty_sorted_by
    !sorted_iter
    !unsorted_iter
    !sorted_by_iter
    !unsorted_by_iter
    !sorted_key_iter
    !unsorted_key_iter
    !empty_iter
    br ok -> L_ARRAY_INTO_ITER_SORTED_OK, L_ARRAY_INTO_ITER_SORTED_FAIL

L_ARRAY_INTO_ITER_SORTED_FAIL:
    !ok
    panic(10744)

L_ARRAY_INTO_ITER_SORTED_OK:
    !ok
    return
