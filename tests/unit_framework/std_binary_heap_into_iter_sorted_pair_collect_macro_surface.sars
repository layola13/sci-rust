@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap into_iter_sorted pair collect macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW zip_left_heap
    EXPAND BINARY_HEAP_PUSH_U64 zip_left_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 zip_left_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 zip_left_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 zip_left_heap, 4
    EXPAND BINARY_HEAP_NEW zip_right_heap
    EXPAND BINARY_HEAP_PUSH_U64 zip_right_heap, 10
    EXPAND BINARY_HEAP_PUSH_U64 zip_right_heap, 20
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 zip_left_iter, zip_left_backing, zip_left_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 zip_right_iter, zip_right_backing, zip_right_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_ZIP_COLLECT_U64 zip_vec, zip_left_iter, zip_right_iter
    EXPAND VEC_GET_U64 zip_0, zip_vec, 0
    EXPAND VEC_GET_U64 zip_1, zip_vec, 1
    EXPAND VEC_GET_U64 zip_2, zip_vec, 2
    EXPAND VEC_GET_U64 zip_3, zip_vec, 3
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 zip_left_remaining, zip_left_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 zip_left_tail_has, zip_left_tail, zip_left_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 zip_right_empty, zip_right_iter

    EXPAND BINARY_HEAP_NEW chain_left_heap
    EXPAND BINARY_HEAP_PUSH_U64 chain_left_heap, 8
    EXPAND BINARY_HEAP_PUSH_U64 chain_left_heap, 9
    EXPAND BINARY_HEAP_NEW chain_right_heap
    EXPAND BINARY_HEAP_PUSH_U64 chain_right_heap, 30
    EXPAND BINARY_HEAP_PUSH_U64 chain_right_heap, 40
    EXPAND BINARY_HEAP_PUSH_U64 chain_right_heap, 50
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 chain_left_iter, chain_left_backing, chain_left_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 chain_right_iter, chain_right_backing, chain_right_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_CHAIN_COLLECT_U64 chain_vec, chain_left_iter, chain_right_iter
    EXPAND VEC_GET_U64 chain_0, chain_vec, 0
    EXPAND VEC_GET_U64 chain_1, chain_vec, 1
    EXPAND VEC_GET_U64 chain_2, chain_vec, 2
    EXPAND VEC_GET_U64 chain_4, chain_vec, 4

    EXPAND VEC_FREE zip_left_backing
    EXPAND VEC_FREE zip_right_backing
    EXPAND VEC_FREE zip_vec
    EXPAND VEC_FREE chain_left_backing
    EXPAND VEC_FREE chain_right_backing
    EXPAND VEC_FREE chain_vec

    ok = eq zip_0, 4
    check = eq zip_1, 20
    ok = and ok, check
    check = eq zip_2, 3
    ok = and ok, check
    check = eq zip_3, 10
    ok = and ok, check
    check = eq zip_left_remaining, 1
    ok = and ok, check
    check = eq zip_left_tail_has, 1
    ok = and ok, check
    check = eq zip_left_tail, 1
    ok = and ok, check
    check = eq zip_right_empty, 1
    ok = and ok, check
    check = eq chain_0, 9
    ok = and ok, check
    check = eq chain_1, 8
    ok = and ok, check
    check = eq chain_2, 50
    ok = and ok, check
    check = eq chain_4, 30
    ok = and ok, check

    !zip_0
    !zip_1
    !zip_2
    !zip_3
    !zip_left_remaining
    !zip_left_tail_has
    !zip_left_tail
    !zip_right_empty
    !chain_0
    !chain_1
    !chain_2
    !chain_4
    !check
    !zip_left_iter
    !zip_right_iter
    !chain_left_iter
    !chain_right_iter
    br ok -> L_SORTED_PAIR_OK, L_SORTED_PAIR_FAIL
L_SORTED_PAIR_FAIL:
    !ok
    panic(10785)
L_SORTED_PAIR_OK:
    !ok
    return
