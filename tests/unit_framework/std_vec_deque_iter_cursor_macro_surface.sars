@import "sa_std/vec_deque.sars"

@test "sa_std vec_deque iterator cursor operation macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY iter_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK iter_deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK iter_deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK iter_deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK iter_deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT iter_pop_ok, iter_pop, iter_deque
    EXPAND VEC_DEQUE_PUSH_BACK iter_deque, 50
    EXPAND VEC_DEQUE_PUSH_BACK iter_deque, 60

    EXPAND VEC_DEQUE_ITER_U64 nth_iter, nth_backing, iter_deque
    EXPAND VEC_DEQUE_ITER_NTH_U64 nth_has, nth_value, nth_iter, 1
    EXPAND VEC_DEQUE_ITER_NTH_BACK_U64 nth_back_has, nth_back_value, nth_iter, 1
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 nth_remaining, nth_iter

    EXPAND VEC_DEQUE_ITER_U64 advance_iter, advance_backing, iter_deque
    EXPAND VEC_DEQUE_ITER_ADVANCE_BY advance_ok, advance_remaining, advance_iter, 2
    EXPAND VEC_DEQUE_ITER_NEXT_U64 advance_next_has, advance_next, advance_iter
    EXPAND VEC_DEQUE_ITER_ADVANCE_BACK_BY advance_back_ok, advance_back_remaining, advance_iter, 9
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 advance_empty, advance_iter

    EXPAND VEC_DEQUE_ITER_U64 count_iter, count_backing, iter_deque
    EXPAND VEC_DEQUE_ITER_COUNT_U64 count_value, count_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 count_empty, count_iter

    EXPAND VEC_DEQUE_ITER_U64 last_iter, last_backing, iter_deque
    EXPAND VEC_DEQUE_ITER_LAST_U64 last_has, last_value, last_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 last_empty, last_iter
    EXPAND VEC_DEQUE_LEN len_after_iter_ops, iter_deque

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 4
    EXPAND VEC_DEQUE_TRY_POP_FRONT into_pop_ok, into_pop, into_deque
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 6
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_NTH_U64 into_nth_has, into_nth_value, into_iter, 1
    EXPAND VEC_DEQUE_INTO_ITER_NTH_BACK_U64 into_back_has, into_back_value, into_iter, 0
    EXPAND VEC_DEQUE_INTO_ITER_ADVANCE_BY into_adv_ok, into_adv_remaining, into_iter, 1
    EXPAND VEC_DEQUE_INTO_ITER_LAST_U64 into_last_has, into_last_value, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_COUNT_U64 into_count, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_FREE nth_backing
    EXPAND VEC_FREE advance_backing
    EXPAND VEC_FREE count_backing
    EXPAND VEC_FREE last_backing
    EXPAND VEC_DEQUE_FREE iter_deque
    EXPAND VEC_FREE into_backing
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq iter_pop_ok, 1
    check = eq iter_pop, 10
    ok = and ok, check
    check = eq nth_has, 1
    ok = and ok, check
    check = eq nth_value, 30
    ok = and ok, check
    check = eq nth_back_has, 1
    ok = and ok, check
    check = eq nth_back_value, 50
    ok = and ok, check
    check = eq nth_remaining, 1
    ok = and ok, check
    check = eq advance_ok, 1
    ok = and ok, check
    check = eq advance_remaining, 0
    ok = and ok, check
    check = eq advance_next_has, 1
    ok = and ok, check
    check = eq advance_next, 40
    ok = and ok, check
    check = eq advance_back_ok, 0
    ok = and ok, check
    check = eq advance_back_remaining, 7
    ok = and ok, check
    check = eq advance_empty, 1
    ok = and ok, check
    check = eq count_value, 5
    ok = and ok, check
    check = eq count_empty, 1
    ok = and ok, check
    check = eq last_has, 1
    ok = and ok, check
    check = eq last_value, 60
    ok = and ok, check
    check = eq last_empty, 1
    ok = and ok, check
    check = eq len_after_iter_ops, 5
    ok = and ok, check
    check = eq into_pop_ok, 1
    ok = and ok, check
    check = eq into_pop, 1
    ok = and ok, check
    check = eq into_nth_has, 1
    ok = and ok, check
    check = eq into_nth_value, 3
    ok = and ok, check
    check = eq into_back_has, 1
    ok = and ok, check
    check = eq into_back_value, 6
    ok = and ok, check
    check = eq into_adv_ok, 1
    ok = and ok, check
    check = eq into_adv_remaining, 0
    ok = and ok, check
    check = eq into_last_has, 1
    ok = and ok, check
    check = eq into_last_value, 5
    ok = and ok, check
    check = eq into_count, 0
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check

    !iter_pop_ok
    !iter_pop
    !nth_has
    !nth_value
    !nth_back_has
    !nth_back_value
    !nth_remaining
    !advance_ok
    !advance_remaining
    !advance_next_has
    !advance_next
    !advance_back_ok
    !advance_back_remaining
    !advance_empty
    !count_value
    !count_empty
    !last_has
    !last_value
    !last_empty
    !len_after_iter_ops
    !into_pop_ok
    !into_pop
    !into_nth_has
    !into_nth_value
    !into_back_has
    !into_back_value
    !into_adv_ok
    !into_adv_remaining
    !into_last_has
    !into_last_value
    !into_count
    !into_deque_empty
    !check
    !nth_iter
    !advance_iter
    !count_iter
    !last_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_CURSOR_OK, L_VEC_DEQUE_ITER_CURSOR_FAIL
L_VEC_DEQUE_ITER_CURSOR_FAIL:
    !ok
    panic(10788)
L_VEC_DEQUE_ITER_CURSOR_OK:
    !ok
    return
