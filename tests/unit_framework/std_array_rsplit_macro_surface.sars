@import "sa_std/array.sars"

@test "sa_std array rsplit macro surface"():
L_ENTRY:
    arr = stack_alloc 48
    store arr+0, 1 as u64
    store arr+8, 2 as u64
    store arr+16, 3 as u64
    store arr+24, 4 as u64
    store arr+32, 5 as u64
    store arr+40, 6 as u64

    prefix2 = stack_alloc Slice_SIZE
    suffix2 = stack_alloc Slice_SIZE
    EXPAND ARRAY_TRY_RSPLIT_ARRAY_REF_U64 split2_ok, prefix2, suffix2, arr, 6, 2
    prefix2_len = load prefix2+Slice_len as u64
    suffix2_len = load suffix2+Slice_len as u64
    suffix2_ptr = load suffix2+Slice_ptr as ptr
    suffix2_first = load suffix2_ptr+0 as u64
    suffix2_second = load suffix2_ptr+8 as u64

    prefix0 = stack_alloc Slice_SIZE
    suffix0 = stack_alloc Slice_SIZE
    EXPAND ARRAY_TRY_RSPLIT_ARRAY_REF_U64 split0_ok, prefix0, suffix0, arr, 6, 0
    prefix0_len = load prefix0+Slice_len as u64
    suffix0_len = load suffix0+Slice_len as u64

    prefix6 = stack_alloc Slice_SIZE
    suffix6 = stack_alloc Slice_SIZE
    EXPAND ARRAY_TRY_RSPLIT_ARRAY_MUT_U64 split6_ok, prefix6, suffix6, arr, 6, 6
    prefix6_len = load prefix6+Slice_len as u64
    suffix6_len = load suffix6+Slice_len as u64
    suffix6_ptr = load suffix6+Slice_ptr as ptr
    store suffix6_ptr+8, 22 as u64
    changed = load arr+8 as u64

    bad_prefix = stack_alloc Slice_SIZE
    bad_suffix = stack_alloc Slice_SIZE
    EXPAND ARRAY_TRY_RSPLIT_ARRAY_MUT_U64 bad_ok, bad_prefix, bad_suffix, arr, 6, 7
    bad_prefix_len = load bad_prefix+Slice_len as u64
    bad_suffix_len = load bad_suffix+Slice_len as u64

    ok_split2 = eq split2_ok, 1
    ok_prefix2_len = eq prefix2_len, 4
    ok_suffix2_len = eq suffix2_len, 2
    ok_suffix2_first = eq suffix2_first, 5
    ok_suffix2_second = eq suffix2_second, 6
    ok_split0 = eq split0_ok, 1
    ok_prefix0_len = eq prefix0_len, 6
    ok_suffix0_len = eq suffix0_len, 0
    ok_split6 = eq split6_ok, 1
    ok_prefix6_len = eq prefix6_len, 0
    ok_suffix6_len = eq suffix6_len, 6
    ok_changed = eq changed, 22
    ok_bad = eq bad_ok, 0
    ok_bad_prefix = eq bad_prefix_len, 0
    ok_bad_suffix = eq bad_suffix_len, 0

    !suffix6_ptr
    !suffix2_ptr

    c01 = and ok_split2, ok_prefix2_len
    c02 = and c01, ok_suffix2_len
    c03 = and c02, ok_suffix2_first
    c04 = and c03, ok_suffix2_second
    c05 = and c04, ok_split0
    c06 = and c05, ok_prefix0_len
    c07 = and c06, ok_suffix0_len
    c08 = and c07, ok_split6
    c09 = and c08, ok_prefix6_len
    c10 = and c09, ok_suffix6_len
    c11 = and c10, ok_changed
    c12 = and c11, ok_bad
    c13 = and c12, ok_bad_prefix
    ok = and c13, ok_bad_suffix

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10518)

L_PASS:
    return 0
