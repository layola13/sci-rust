@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@iter_bare_times_ten(value: u64) -> u64:
L_ENTRY:
    out = mul value, 10
    !value
    return out

@iter_bare_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    return out

@iter_bare_map_even_tens(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    br is_even -> L_BARE_FILTER_MAP_KEEP, L_BARE_FILTER_MAP_SKIP
L_BARE_FILTER_MAP_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !is_even
    !rem
    !out_mapped
    !value
    return 1
L_BARE_FILTER_MAP_SKIP:
    !is_even
    !rem
    !out_mapped
    !value
    return 0

@test "sa_std iter bare adapter alias macro surface"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5

    // Bare ITER_COLLECT alias over ITER_COLLECT_U64.
    EXPAND ITER_FROM_SLICE collect_iter, slice
    EXPAND ITER_COLLECT collect_vec, collect_iter
    EXPAND ITER_IS_EMPTY collect_empty, collect_iter
    EXPAND VEC_LEN collect_len, collect_vec
    EXPAND VEC_GET_U64 collect_0, collect_vec, 0
    EXPAND VEC_GET_U64 collect_4, collect_vec, 4

    // Bare ITER_MAP_COLLECT alias.
    EXPAND ITER_FROM_SLICE map_iter, slice
    EXPAND ITER_MAP_COLLECT map_vec, map_iter, @iter_bare_times_ten
    EXPAND ITER_IS_EMPTY map_empty, map_iter
    EXPAND VEC_LEN map_len, map_vec
    EXPAND VEC_GET_U64 map_0, map_vec, 0
    EXPAND VEC_GET_U64 map_4, map_vec, 4

    // Bare ITER_FILTER_COLLECT alias.
    EXPAND ITER_FROM_SLICE filter_iter, slice
    EXPAND ITER_FILTER_COLLECT filter_vec, filter_iter, @iter_bare_is_even
    EXPAND ITER_IS_EMPTY filter_empty, filter_iter
    EXPAND VEC_LEN filter_len, filter_vec
    EXPAND VEC_GET_U64 filter_0, filter_vec, 0
    EXPAND VEC_GET_U64 filter_1, filter_vec, 1

    // Bare ITER_FILTER_MAP_COLLECT alias (map even values to tens).
    EXPAND ITER_FROM_SLICE filter_map_iter, slice
    EXPAND ITER_FILTER_MAP_COLLECT filter_map_vec, filter_map_iter, @iter_bare_map_even_tens
    EXPAND ITER_IS_EMPTY filter_map_empty, filter_map_iter
    EXPAND VEC_LEN filter_map_len, filter_map_vec
    EXPAND VEC_GET_U64 filter_map_0, filter_map_vec, 0
    EXPAND VEC_GET_U64 filter_map_1, filter_map_vec, 1

    // Compose filter collect then map collect over the filtered result slice.
    EXPAND VEC_AS_SLICE filtered_slice, filter_vec
    EXPAND ITER_FROM_SLICE composed_iter, filtered_slice
    EXPAND ITER_MAP_COLLECT composed_vec, composed_iter, @iter_bare_times_ten
    EXPAND ITER_IS_EMPTY composed_empty, composed_iter
    EXPAND VEC_LEN composed_len, composed_vec
    EXPAND VEC_GET_U64 composed_0, composed_vec, 0
    EXPAND VEC_GET_U64 composed_1, composed_vec, 1

    ok_collect_empty = eq collect_empty, 1
    ok_collect_len = eq collect_len, 5
    ok_collect_0 = eq collect_0, 1
    ok_collect_4 = eq collect_4, 5
    ok_map_empty = eq map_empty, 1
    ok_map_len = eq map_len, 5
    ok_map_0 = eq map_0, 10
    ok_map_4 = eq map_4, 50
    ok_filter_empty = eq filter_empty, 1
    ok_filter_len = eq filter_len, 2
    ok_filter_0 = eq filter_0, 2
    ok_filter_1 = eq filter_1, 4
    ok_filter_map_empty = eq filter_map_empty, 1
    ok_filter_map_len = eq filter_map_len, 2
    ok_filter_map_0 = eq filter_map_0, 20
    ok_filter_map_1 = eq filter_map_1, 40
    ok_composed_empty = eq composed_empty, 1
    ok_composed_len = eq composed_len, 2
    ok_composed_0 = eq composed_0, 20
    ok_composed_1 = eq composed_1, 40

    c01 = and ok_collect_empty, ok_collect_len
    c02 = and c01, ok_collect_0
    c03 = and c02, ok_collect_4
    c04 = and c03, ok_map_empty
    c05 = and c04, ok_map_len
    c06 = and c05, ok_map_0
    c07 = and c06, ok_map_4
    c08 = and c07, ok_filter_empty
    c09 = and c08, ok_filter_len
    c10 = and c09, ok_filter_0
    c11 = and c10, ok_filter_1
    c12 = and c11, ok_filter_map_empty
    c13 = and c12, ok_filter_map_len
    c14 = and c13, ok_filter_map_0
    c15 = and c14, ok_filter_map_1
    c16 = and c15, ok_composed_empty
    c17 = and c16, ok_composed_len
    c18 = and c17, ok_composed_0
    ok = and c18, ok_composed_1

    !collect_empty
    !collect_len
    !collect_0
    !collect_4
    !map_empty
    !map_len
    !map_0
    !map_4
    !filter_empty
    !filter_len
    !filter_0
    !filter_1
    !filter_map_empty
    !filter_map_len
    !filter_map_0
    !filter_map_1
    !composed_empty
    !composed_len
    !composed_0
    !composed_1
    !ok_collect_empty
    !ok_collect_len
    !ok_collect_0
    !ok_collect_4
    !ok_map_empty
    !ok_map_len
    !ok_map_0
    !ok_map_4
    !ok_filter_empty
    !ok_filter_len
    !ok_filter_0
    !ok_filter_1
    !ok_filter_map_empty
    !ok_filter_map_len
    !ok_filter_map_0
    !ok_filter_map_1
    !ok_composed_empty
    !ok_composed_len
    !ok_composed_0
    !ok_composed_1
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !composed_iter
    !filtered_slice
    !filter_map_iter
    !filter_iter
    !map_iter
    !collect_iter
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE composed_vec
    EXPAND VEC_FREE filter_map_vec
    EXPAND VEC_FREE filter_vec
    EXPAND VEC_FREE map_vec
    EXPAND VEC_FREE collect_vec
    panic(10862)

L_PASS:
    !ok
    EXPAND VEC_FREE composed_vec
    EXPAND VEC_FREE filter_map_vec
    EXPAND VEC_FREE filter_vec
    EXPAND VEC_FREE map_vec
    EXPAND VEC_FREE collect_vec
    return 0
