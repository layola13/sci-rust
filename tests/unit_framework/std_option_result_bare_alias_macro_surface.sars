@import "sa_std/option.sars"
@import "sa_std/result.sars"

@test "sa_std option result bare alias macro surface"():
L_ENTRY:
    // Constructor bare aliases (Rust Some/None/Ok/Err names).
    EXPAND OPTION_SOME some, 11
    EXPAND OPTION_NONE none
    EXPAND RESULT_OK ok_res, 22
    EXPAND RESULT_ERR err_res, 33

    EXPAND OPTION_IS_SOME is_some, some
    EXPAND OPTION_IS_NONE is_none, none
    EXPAND RESULT_IS_OK is_ok, ok_res
    EXPAND RESULT_IS_ERR is_err, err_res

    EXPAND OPTION_UNWRAP_OR unwrap_some, some, 99
    EXPAND OPTION_UNWRAP_OR unwrap_none, none, 99
    EXPAND OPTION_UNWRAP_OR_DEFAULT unwrap_def_none, none
    EXPAND RESULT_UNWRAP_OR unwrap_ok, ok_res, 88
    EXPAND RESULT_UNWRAP_OR unwrap_err, err_res, 88
    EXPAND RESULT_UNWRAP_OR_DEFAULT unwrap_def_err, err_res

    EXPAND OPTION_CONTAINS contains_hit, some, 11
    EXPAND OPTION_CONTAINS contains_miss, some, 12

    // copied/cloned bare aliases over *_U64 helpers.
    value_slot = stack_alloc 8
    store value_slot+0, 44 as u64
    opt_ptr_some = alloc Option_SIZE
    store opt_ptr_some+Option_tag, Option_SOME as u64
    store opt_ptr_some+Option_value, value_slot as ptr
    EXPAND OPTION_COPIED opt_copied, opt_ptr_some
    EXPAND OPTION_CLONED opt_cloned, opt_ptr_some
    opt_copied_value = load opt_copied+Option_value as u64
    opt_cloned_value = load opt_cloned+Option_value as u64

    ok_slot = stack_alloc 8
    err_slot = stack_alloc 8
    store ok_slot+0, 55 as u64
    store err_slot+0, 66 as u64
    res_ptr_ok = alloc Result_SIZE
    store res_ptr_ok+Result_tag, Result_OK as u64
    store res_ptr_ok+Result_ok, ok_slot as ptr
    store res_ptr_ok+Result_err, 0 as u64
    res_ptr_err = alloc Result_SIZE
    store res_ptr_err+Result_tag, Result_ERR as u64
    store res_ptr_err+Result_ok, 0 as u64
    store res_ptr_err+Result_err, err_slot as ptr
    EXPAND RESULT_COPIED res_copied_ok, res_ptr_ok
    EXPAND RESULT_CLONED res_cloned_ok, res_ptr_ok
    EXPAND RESULT_COPIED res_copied_err, res_ptr_err
    res_copied_ok_value = load res_copied_ok+Result_ok as u64
    res_cloned_ok_value = load res_cloned_ok+Result_ok as u64
    res_copied_err_value = load res_copied_err+Result_err as u64

    // zip/unzip bare aliases over *_U64 helpers.
    EXPAND OPTION_SOME zip_a, 7
    EXPAND OPTION_SOME zip_b, 8
    EXPAND OPTION_ZIP pair, zip_a, zip_b
    pair_tag = load pair+OptionPairU64_tag as u64
    pair_v1 = load pair+OptionPairU64_value1 as u64
    pair_v2 = load pair+OptionPairU64_value2 as u64
    EXPAND OPTION_UNZIP_TO unz_a, unz_b, pair
    unz_a_value = load unz_a+Option_value as u64
    unz_b_value = load unz_b+Option_value as u64

    // matches / match-name aliases.
    EXPAND MATCHES_OPTION matches_some, some, Option_SOME
    EXPAND MATCHES_OPTION matches_none_as_some, none, Option_SOME
    EXPAND MATCHES_RESULT matches_ok, ok_res, Result_OK
    EXPAND MATCHES_RESULT matches_err_as_ok, err_res, Result_OK

    some_tag = load some+Option_tag as u64
    some_value = load some+Option_value as u64
    none_tag = load none+Option_tag as u64
    ok_tag = load ok_res+Result_tag as u64
    ok_value = load ok_res+Result_ok as u64
    err_tag = load err_res+Result_tag as u64
    err_value = load err_res+Result_err as u64
    contains_miss_false = eq contains_miss, 0
    matches_none_false = eq matches_none_as_some, 0
    matches_err_false = eq matches_err_as_ok, 0

    ok01 = eq some_tag, Option_SOME
    ok02 = eq some_value, 11
    ok03 = eq none_tag, Option_NONE
    ok04 = eq ok_tag, Result_OK
    ok05 = eq ok_value, 22
    ok06 = eq err_tag, Result_ERR
    ok07 = eq err_value, 33
    ok08 = eq is_some, 1
    ok09 = eq is_none, 1
    ok10 = eq is_ok, 1
    ok11 = eq is_err, 1
    ok12 = eq unwrap_some, 11
    ok13 = eq unwrap_none, 99
    ok14 = eq unwrap_def_none, 0
    ok15 = eq unwrap_ok, 22
    ok16 = eq unwrap_err, 88
    ok17 = eq unwrap_def_err, 0
    ok18 = eq contains_hit, 1
    ok19 = eq contains_miss_false, 1
    ok20 = eq opt_copied_value, 44
    ok21 = eq opt_cloned_value, 44
    ok22 = eq res_copied_ok_value, 55
    ok23 = eq res_cloned_ok_value, 55
    ok24 = eq res_copied_err_value, 66
    ok25 = eq pair_tag, Option_SOME
    ok26 = eq pair_v1, 7
    ok27 = eq pair_v2, 8
    ok28 = eq unz_a_value, 7
    ok29 = eq unz_b_value, 8
    ok30 = eq matches_some, 1
    ok31 = eq matches_none_false, 1
    ok32 = eq matches_ok, 1
    ok33 = eq matches_err_false, 1

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok09
    all09 = and all08, ok10
    all10 = and all09, ok11
    all11 = and all10, ok12
    all12 = and all11, ok13
    all13 = and all12, ok14
    all14 = and all13, ok15
    all15 = and all14, ok16
    all16 = and all15, ok17
    all17 = and all16, ok18
    all18 = and all17, ok19
    all19 = and all18, ok20
    all20 = and all19, ok21
    all21 = and all20, ok22
    all22 = and all21, ok23
    all23 = and all22, ok24
    all24 = and all23, ok25
    all25 = and all24, ok26
    all26 = and all25, ok27
    all27 = and all26, ok28
    all28 = and all27, ok29
    all29 = and all28, ok30
    all30 = and all29, ok31
    all31 = and all30, ok32
    ok = and all31, ok33

    !is_some
    !is_none
    !is_ok
    !is_err
    !unwrap_some
    !unwrap_none
    !unwrap_def_none
    !unwrap_ok
    !unwrap_err
    !unwrap_def_err
    !contains_hit
    !contains_miss
    !contains_miss_false
    !opt_copied_value
    !opt_cloned_value
    !res_copied_ok_value
    !res_cloned_ok_value
    !res_copied_err_value
    !pair_tag
    !pair_v1
    !pair_v2
    !unz_a_value
    !unz_b_value
    !matches_some
    !matches_none_as_some
    !matches_ok
    !matches_err_as_ok
    !matches_none_false
    !matches_err_false
    !some_tag
    !some_value
    !none_tag
    !ok_tag
    !ok_value
    !err_tag
    !err_value
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    !ok33
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !all11
    !all12
    !all13
    !all14
    !all15
    !all16
    !all17
    !all18
    !all19
    !all20
    !all21
    !all22
    !all23
    !all24
    !all25
    !all26
    !all27
    !all28
    !all29
    !all30
    !all31
    !some
    !none
    !ok_res
    !err_res
    !opt_ptr_some
    !opt_copied
    !opt_cloned
    !res_ptr_ok
    !res_ptr_err
    !res_copied_ok
    !res_cloned_ok
    !res_copied_err
    !zip_a
    !zip_b
    !pair
    !unz_a
    !unz_b

    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10858)

L_OK:
    !ok
    return 0
