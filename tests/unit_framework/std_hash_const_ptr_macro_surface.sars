@import "sa_std/hash.sars"

@test "sa_std hash const raw pointer macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    ptr_slot = stack_alloc 8
    other_slot = stack_alloc 8
    direct_hasher = stack_alloc DefaultHasher_SIZE
    manual_hasher = stack_alloc DefaultHasher_SIZE
    state = stack_alloc RandomState_SIZE
    state_manual_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW direct_hasher
    EXPAND DEFAULT_HASHER_WRITE_CONST_PTR direct_hasher, ptr_slot
    EXPAND DEFAULT_HASHER_FINISH direct_write_hash, direct_hasher

    EXPAND HASH_PTR_VALUE generic_ptr_hash, ptr_slot
    EXPAND HASH_CONST_PTR_VALUE const_ptr_hash, ptr_slot
    EXPAND HASH_CONST_PTR_VALUE other_const_ptr_hash, other_slot
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_CONST_PTR_VALUE build_const_ptr_hash, builder, ptr_slot

    EXPAND DEFAULT_HASHER_NEW manual_hasher
    EXPAND DEFAULT_HASHER_WRITE_PTR manual_hasher, ptr_slot
    EXPAND DEFAULT_HASHER_WRITE_UNIT manual_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH manual_hash, manual_hasher

    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_CONST_PTR_VALUE state_const_ptr_hash, state, ptr_slot
    EXPAND RANDOM_STATE_BUILD state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_PTR state_manual_hasher, ptr_slot
    EXPAND DEFAULT_HASHER_WRITE_UNIT state_manual_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH state_manual_hash, state_manual_hasher

    direct_write_matches_generic = eq direct_write_hash, generic_ptr_hash
    const_matches_generic = eq const_ptr_hash, generic_ptr_hash
    build_matches_manual = eq build_const_ptr_hash, manual_hash
    state_matches_manual = eq state_const_ptr_hash, state_manual_hash
    address_matters = ne const_ptr_hash, other_const_ptr_hash
    seeded_differs_default = ne state_const_ptr_hash, const_ptr_hash
    changed = ne const_ptr_hash, HASHER_DEFAULT_SEED

    c01 = and direct_write_matches_generic, const_matches_generic
    c02 = and c01, build_matches_manual
    c03 = and c02, state_matches_manual
    c04 = and c03, address_matters
    c05 = and c04, seeded_differs_default
    ok = and c05, changed

    !builder
    !direct_write_hash
    !generic_ptr_hash
    !const_ptr_hash
    !other_const_ptr_hash
    !build_const_ptr_hash
    !manual_hash
    !state_const_ptr_hash
    !state_manual_hash
    !direct_write_matches_generic
    !const_matches_generic
    !build_matches_manual
    !state_matches_manual
    !address_matters
    !seeded_differs_default
    !changed
    !c01
    !c02
    !c03
    !c04
    !c05
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10578)

L_PASS:
    !ok
    return 0
