@import "sa_std/ffi.sars"
@import "sa_std/hash.sars"

@test "sa_std ffi CStr and CString hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    foo = stack_alloc 4
    store foo+0, 102 as u8
    store foo+1, 111 as u8
    store foo+2, 111 as u8
    store foo+3, 0 as u8
    foo_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW foo_slice, foo, 4
    foo_cstr = stack_alloc CStr_SIZE
    EXPAND CSTR_FROM_BYTES_WITH_NUL foo_cstr_status, foo_cstr, foo_slice
    foo_bytes_with_nul = stack_alloc Slice_SIZE
    foo_bytes_no_nul = stack_alloc Slice_SIZE
    EXPAND CSTR_TO_BYTES_WITH_NUL foo_bytes_with_nul, foo_cstr
    EXPAND CSTR_TO_BYTES foo_bytes_no_nul, foo_cstr

    same = stack_alloc 4
    store same+0, 102 as u8
    store same+1, 111 as u8
    store same+2, 111 as u8
    store same+3, 0 as u8
    same_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW same_slice, same, 4
    same_cstr = stack_alloc CStr_SIZE
    EXPAND CSTR_FROM_BYTES_WITH_NUL same_cstr_status, same_cstr, same_slice

    food = stack_alloc 5
    store food+0, 102 as u8
    store food+1, 111 as u8
    store food+2, 111 as u8
    store food+3, 100 as u8
    store food+4, 0 as u8
    food_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW food_slice, food, 5
    food_cstr = stack_alloc CStr_SIZE
    EXPAND CSTR_FROM_BYTES_WITH_NUL food_cstr_status, food_cstr, food_slice

    writer_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW writer_hasher
    EXPAND DEFAULT_HASHER_WRITE_CSTR writer_hasher, foo_cstr
    EXPAND DEFAULT_HASHER_FINISH writer_hash, writer_hasher

    EXPAND CSTR_HASH cstr_hash, foo_cstr
    EXPAND CSTR_HASH same_cstr_hash, same_cstr
    EXPAND CSTR_HASH food_cstr_hash, food_cstr
    EXPAND HASH_SLICE_U8 bytes_with_nul_hash, foo_bytes_with_nul
    EXPAND HASH_SLICE_U8 bytes_no_nul_hash, foo_bytes_no_nul
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_CSTR build_cstr_hash, builder, foo_cstr

    state = stack_alloc RandomState_SIZE
    state_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 901, 902
    EXPAND RANDOM_STATE_HASH_ONE_CSTR state_cstr_hash, state, foo_cstr
    EXPAND RANDOM_STATE_BUILD state_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_CSTR state_hasher, foo_cstr
    EXPAND DEFAULT_HASHER_FINISH manual_state_cstr_hash, state_hasher

    foo_no_nul = stack_alloc 3
    store foo_no_nul+0, 102 as u8
    store foo_no_nul+1, 111 as u8
    store foo_no_nul+2, 111 as u8
    foo_no_nul_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW foo_no_nul_slice, foo_no_nul, 3
    foo_cstring = stack_alloc CString_SIZE
    EXPAND CSTRING_NEW foo_cstring_status, foo_cstring, foo_no_nul_slice
    foo_cstring_bytes_with_nul = stack_alloc Slice_SIZE
    foo_cstring_bytes = stack_alloc Slice_SIZE
    EXPAND CSTRING_AS_BYTES_WITH_NUL foo_cstring_bytes_with_nul, foo_cstring
    EXPAND CSTRING_AS_BYTES foo_cstring_bytes, foo_cstring

    food_no_nul = stack_alloc 4
    store food_no_nul+0, 102 as u8
    store food_no_nul+1, 111 as u8
    store food_no_nul+2, 111 as u8
    store food_no_nul+3, 100 as u8
    food_no_nul_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW food_no_nul_slice, food_no_nul, 4
    food_cstring = stack_alloc CString_SIZE
    EXPAND CSTRING_NEW food_cstring_status, food_cstring, food_no_nul_slice

    cstring_writer_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW cstring_writer_hasher
    EXPAND DEFAULT_HASHER_WRITE_CSTRING cstring_writer_hasher, foo_cstring
    EXPAND DEFAULT_HASHER_FINISH cstring_writer_hash, cstring_writer_hasher

    EXPAND CSTRING_HASH cstring_hash, foo_cstring
    EXPAND CSTRING_HASH food_cstring_hash, food_cstring
    EXPAND HASH_SLICE_U8 cstring_bytes_with_nul_hash, foo_cstring_bytes_with_nul
    EXPAND HASH_SLICE_U8 cstring_bytes_hash, foo_cstring_bytes
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_CSTRING build_cstring_hash, builder, foo_cstring
    EXPAND RANDOM_STATE_HASH_ONE_CSTRING state_cstring_hash, state, foo_cstring
    cstring_state_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD cstring_state_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_CSTRING cstring_state_hasher, foo_cstring
    EXPAND DEFAULT_HASHER_FINISH manual_state_cstring_hash, cstring_state_hasher

    ok_cstr_status = eq foo_cstr_status, CSTR_FROM_BYTES_OK
    ok_same_cstr_status = eq same_cstr_status, CSTR_FROM_BYTES_OK
    ok_food_cstr_status = eq food_cstr_status, CSTR_FROM_BYTES_OK
    ok_cstr_writer = eq writer_hash, cstr_hash
    ok_cstr_bytes = eq cstr_hash, bytes_with_nul_hash
    ok_cstr_has_nul_domain = ne cstr_hash, bytes_no_nul_hash
    ok_cstr_same = eq same_cstr_hash, cstr_hash
    ok_cstr_value = ne food_cstr_hash, cstr_hash
    ok_cstr_build = eq build_cstr_hash, cstr_hash
    ok_cstr_state = eq state_cstr_hash, manual_state_cstr_hash

    ok_cstring_status = eq foo_cstring_status, CSTRING_NEW_OK
    ok_food_cstring_status = eq food_cstring_status, CSTRING_NEW_OK
    ok_cstring_writer = eq cstring_writer_hash, cstring_hash
    ok_cstring_bytes = eq cstring_hash, cstring_bytes_with_nul_hash
    ok_cstring_has_nul_domain = ne cstring_hash, cstring_bytes_hash
    ok_cstring_cstr_same = eq cstring_hash, cstr_hash
    ok_cstring_value = ne food_cstring_hash, cstring_hash
    ok_cstring_build = eq build_cstring_hash, cstring_hash
    ok_cstring_state = eq state_cstring_hash, manual_state_cstring_hash

    c01 = and ok_cstr_status, ok_same_cstr_status
    c02 = and c01, ok_food_cstr_status
    c03 = and c02, ok_cstr_writer
    c04 = and c03, ok_cstr_bytes
    c05 = and c04, ok_cstr_has_nul_domain
    c06 = and c05, ok_cstr_same
    c07 = and c06, ok_cstr_value
    c08 = and c07, ok_cstr_build
    cstr_ok = and c08, ok_cstr_state

    s01 = and ok_cstring_status, ok_food_cstring_status
    s02 = and s01, ok_cstring_writer
    s03 = and s02, ok_cstring_bytes
    s04 = and s03, ok_cstring_has_nul_domain
    s05 = and s04, ok_cstring_cstr_same
    s06 = and s05, ok_cstring_value
    s07 = and s06, ok_cstring_build
    cstring_ok = and s07, ok_cstring_state
    ok = and cstr_ok, cstring_ok

    EXPAND CSTRING_FREE foo_cstring
    EXPAND CSTRING_FREE food_cstring

    !foo_cstr_status
    !same_cstr_status
    !food_cstr_status
    !writer_hash
    !cstr_hash
    !same_cstr_hash
    !food_cstr_hash
    !bytes_with_nul_hash
    !bytes_no_nul_hash
    !build_cstr_hash
    !state_cstr_hash
    !manual_state_cstr_hash
    !foo_cstring_status
    !food_cstring_status
    !cstring_writer_hash
    !cstring_hash
    !food_cstring_hash
    !cstring_bytes_with_nul_hash
    !cstring_bytes_hash
    !build_cstring_hash
    !state_cstring_hash
    !manual_state_cstring_hash
    !ok_cstr_status
    !ok_same_cstr_status
    !ok_food_cstr_status
    !ok_cstr_writer
    !ok_cstr_bytes
    !ok_cstr_has_nul_domain
    !ok_cstr_same
    !ok_cstr_value
    !ok_cstr_build
    !ok_cstr_state
    !ok_cstring_status
    !ok_food_cstring_status
    !ok_cstring_writer
    !ok_cstring_bytes
    !ok_cstring_has_nul_domain
    !ok_cstring_cstr_same
    !ok_cstring_value
    !ok_cstring_build
    !ok_cstring_state
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !cstr_ok
    !s01
    !s02
    !s03
    !s04
    !s05
    !s06
    !s07
    !cstring_ok
    !builder

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10594)

L_PASS:
    !ok
    return 0
