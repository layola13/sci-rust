@import "sa_std/array.sars"

@test "sa_std array hash macro surface"():
L_ENTRY:
    arr = stack_alloc 24
    store arr+0, 7 as u64
    store arr+8, 99 as u64
    store arr+16, 123 as u64

    slice = stack_alloc Slice_SIZE
    EXPAND ARRAY_AS_SLICE_U64 slice, arr, 3
    EXPAND ARRAY_HASH_U64 array_hash, arr, 3
    EXPAND SLICE_HASH_U64 slice_hash, slice

    array_hasher = stack_alloc DefaultHasher_SIZE
    slice_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW array_hasher
    EXPAND DEFAULT_HASHER_NEW slice_hasher
    EXPAND DEFAULT_HASHER_WRITE_ARRAY_U64 array_hasher, arr, 3
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 slice_hasher, slice
    EXPAND DEFAULT_HASHER_FINISH array_write_hash, array_hasher
    EXPAND DEFAULT_HASHER_FINISH slice_write_hash, slice_hasher

    ok_hash = eq array_hash, slice_hash
    ok_write_hash = eq array_write_hash, slice_write_hash
    ok_cross = eq array_hash, array_write_hash
    c01 = and ok_hash, ok_write_hash
    ok = and c01, ok_cross

    !array_hash
    !slice_hash
    !array_write_hash
    !slice_write_hash
    !ok_hash
    !ok_write_hash
    !ok_cross
    !c01
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10528)

L_PASS:
    !ok
    return 0
