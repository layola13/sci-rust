@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@iter_window_sum(window: ptr, len: u64) -> u64:
L_ENTRY:
    acc = add 0, 0
    index = add 0, 0
    jmp L_WINDOW_SUM_HEAD
L_WINDOW_SUM_HEAD:
    more = ult index, len
    br more -> L_WINDOW_SUM_ADD, L_WINDOW_SUM_DONE
L_WINDOW_SUM_ADD:
    off = mul index, 8
    item = ptr_add window, off
    value = load item+0 as u64
    next_acc = add acc, value
    !acc
    acc = add next_acc, 0
    next_index = add index, 1
    !index
    index = add next_index, 0
    !next_index
    !next_acc
    !value
    !item
    !off
    !more
    jmp L_WINDOW_SUM_HEAD
L_WINDOW_SUM_DONE:
    !more
    !index
    !len
    !window
    return acc

@test "sa_std iter map_windows collect macro surface"():
L_ENTRY:
    values = stack_alloc 32
    partial_values = stack_alloc 40
    empty_values = stack_alloc 8

    store values+0, 1 as u64
    store values+8, 3 as u64
    store values+16, 8 as u64
    store values+24, 1 as u64

    store partial_values+0, 10 as u64
    store partial_values+8, 20 as u64
    store partial_values+16, 30 as u64
    store partial_values+24, 40 as u64
    store partial_values+32, 50 as u64

    slice = alloc Slice_SIZE
    partial_slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 4
    EXPAND SLICE_NEW partial_slice, partial_values, 5
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_MAP_WINDOWS_COLLECT_U64 windows_ok, windows_vec, iter, 2, @iter_window_sum
    EXPAND VEC_LEN windows_len, windows_vec
    EXPAND VEC_GET_U64 windows_0, windows_vec, 0
    EXPAND VEC_GET_U64 windows_1, windows_vec, 1
    EXPAND VEC_GET_U64 windows_2, windows_vec, 2
    EXPAND ITER_IS_EMPTY windows_iter_empty, iter

    EXPAND ITER_FROM_SLICE partial_iter, partial_slice
    EXPAND ITER_NEXT_U64 partial_first_ok, partial_first, partial_iter
    EXPAND ITER_MAP_WINDOWS_COLLECT_U64 partial_ok, partial_vec, partial_iter, 3, @iter_window_sum
    EXPAND VEC_LEN partial_len, partial_vec
    EXPAND VEC_GET_U64 partial_0, partial_vec, 0
    EXPAND VEC_GET_U64 partial_1, partial_vec, 1
    EXPAND ITER_IS_EMPTY partial_iter_empty, partial_iter

    EXPAND ITER_FROM_SLICE large_iter, slice
    EXPAND ITER_MAP_WINDOWS_COLLECT_U64 large_ok, large_vec, large_iter, 8, @iter_window_sum
    EXPAND VEC_LEN large_len, large_vec
    EXPAND ITER_NEXT_U64 large_next_ok, large_next, large_iter

    EXPAND ITER_FROM_SLICE zero_iter, slice
    EXPAND ITER_MAP_WINDOWS_COLLECT_U64 zero_ok, zero_vec, zero_iter, 0, @iter_window_sum
    EXPAND VEC_LEN zero_len, zero_vec
    EXPAND ITER_LEN zero_remaining_before_next, zero_iter
    EXPAND ITER_NEXT_U64 zero_next_ok, zero_next, zero_iter
    EXPAND ITER_LEN zero_remaining_after_next, zero_iter

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_MAP_WINDOWS_COLLECT_U64 empty_ok, empty_vec, empty_iter, 2, @iter_window_sum
    EXPAND VEC_LEN empty_len, empty_vec
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter

    ok_windows_ok = eq windows_ok, 1
    ok_windows_len = eq windows_len, 3
    ok_windows_0 = eq windows_0, 4
    ok_windows_1 = eq windows_1, 11
    ok_windows_2 = eq windows_2, 9
    ok_windows_empty = eq windows_iter_empty, 1
    ok_partial_first_ok = eq partial_first_ok, 1
    ok_partial_first = eq partial_first, 10
    ok_partial_ok = eq partial_ok, 1
    ok_partial_len = eq partial_len, 2
    ok_partial_0 = eq partial_0, 90
    ok_partial_1 = eq partial_1, 120
    ok_partial_empty = eq partial_iter_empty, 1
    ok_large_ok = eq large_ok, 1
    ok_large_len = eq large_len, 0
    ok_large_next_ok = eq large_next_ok, 0
    ok_large_next = eq large_next, 0
    ok_zero_ok = eq zero_ok, 0
    ok_zero_len = eq zero_len, 0
    ok_zero_remaining_before = eq zero_remaining_before_next, 4
    ok_zero_next_ok = eq zero_next_ok, 1
    ok_zero_next = eq zero_next, 1
    ok_zero_remaining_after = eq zero_remaining_after_next, 3
    ok_empty_ok = eq empty_ok, 1
    ok_empty_len = eq empty_len, 0
    ok_empty_iter = eq empty_iter_empty, 1

    c01 = and ok_windows_ok, ok_windows_len
    c02 = and c01, ok_windows_0
    c03 = and c02, ok_windows_1
    c04 = and c03, ok_windows_2
    c05 = and c04, ok_windows_empty
    c06 = and c05, ok_partial_first_ok
    c07 = and c06, ok_partial_first
    c08 = and c07, ok_partial_ok
    c09 = and c08, ok_partial_len
    c10 = and c09, ok_partial_0
    c11 = and c10, ok_partial_1
    c12 = and c11, ok_partial_empty
    c13 = and c12, ok_large_ok
    c14 = and c13, ok_large_len
    c15 = and c14, ok_large_next_ok
    c16 = and c15, ok_large_next
    c17 = and c16, ok_zero_ok
    c18 = and c17, ok_zero_len
    c19 = and c18, ok_zero_remaining_before
    c20 = and c19, ok_zero_next_ok
    c21 = and c20, ok_zero_next
    c22 = and c21, ok_zero_remaining_after
    c23 = and c22, ok_empty_ok
    c24 = and c23, ok_empty_len
    ok = and c24, ok_empty_iter

    !windows_ok
    !windows_len
    !windows_0
    !windows_1
    !windows_2
    !windows_iter_empty
    !partial_first_ok
    !partial_first
    !partial_ok
    !partial_len
    !partial_0
    !partial_1
    !partial_iter_empty
    !large_ok
    !large_len
    !large_next_ok
    !large_next
    !zero_ok
    !zero_len
    !zero_remaining_before_next
    !zero_next_ok
    !zero_next
    !zero_remaining_after_next
    !empty_ok
    !empty_len
    !empty_iter_empty
    !ok_windows_ok
    !ok_windows_len
    !ok_windows_0
    !ok_windows_1
    !ok_windows_2
    !ok_windows_empty
    !ok_partial_first_ok
    !ok_partial_first
    !ok_partial_ok
    !ok_partial_len
    !ok_partial_0
    !ok_partial_1
    !ok_partial_empty
    !ok_large_ok
    !ok_large_len
    !ok_large_next_ok
    !ok_large_next
    !ok_zero_ok
    !ok_zero_len
    !ok_zero_remaining_before
    !ok_zero_next_ok
    !ok_zero_next
    !ok_zero_remaining_after
    !ok_empty_ok
    !ok_empty_len
    !ok_empty_iter
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !c19
    !c20
    !c21
    !c22
    !c23
    !c24
    !empty_iter
    !zero_iter
    !large_iter
    !partial_iter
    !iter
    !empty_slice
    !partial_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE large_vec
    EXPAND VEC_FREE partial_vec
    EXPAND VEC_FREE windows_vec
    panic(10551)

L_PASS:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE large_vec
    EXPAND VEC_FREE partial_vec
    EXPAND VEC_FREE windows_vec
    return 0
