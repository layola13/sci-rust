@import "sa_std/process.sars"

@test "sa_std process id aliases"():
L_ENTRY:
    EXPAND PROCESS_ID pid
    EXPAND PROCESS_PID pid2
    EXPAND PROCESS_PARENT_ID ppid
    a = ne pid, 0
    b = eq pid, pid2
    c = ne ppid, 0
    ok01 = and a, b
    ok = and ok01, c
    !pid
    !pid2
    !ppid
    !a
    !b
    !c
    !ok01
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10914)
