@import "sa_std/collections/linked_list.sars"
@import "sa_std/vec.sars"

@test "sa_std linked_list to_vec from_vec"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 1
    EXPAND LINKED_LIST_PUSH_BACK list, 2
    EXPAND LINKED_LIST_PUSH_BACK list, 3
    EXPAND LINKED_LIST_TO_VEC v, list
    EXPAND VEC_LEN vlen, v
    EXPAND VEC_GET_U64 v0, v, 0
    EXPAND VEC_GET_U64 v2, v, 2
    EXPAND LINKED_LIST_FROM_VEC list2, v
    EXPAND LINKED_LIST_LEN l2, list2
    EXPAND LINKED_LIST_TRY_BACK b_ok, b, list2
    EXPAND LINKED_LIST_FREE list
    EXPAND LINKED_LIST_FREE list2
    EXPAND VEC_FREE v

    ok_len = eq vlen, 3
    ok_v0 = eq v0, 1
    ok_v2 = eq v2, 3
    ok_l2 = eq l2, 3
    ok_b = eq b_ok, 1
    ok_bv = eq b, 3
    ok01 = and ok_len, ok_v0
    ok02 = and ok01, ok_v2
    ok03 = and ok02, ok_l2
    ok04 = and ok03, ok_b
    ok = and ok04, ok_bv

    !vlen
    !v0
    !v2
    !l2
    !b_ok
    !b
    !ok_len
    !ok_v0
    !ok_v2
    !ok_l2
    !ok_b
    !ok_bv
    !ok01
    !ok02
    !ok03
    !ok04
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10873)
