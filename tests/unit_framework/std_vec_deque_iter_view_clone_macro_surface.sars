@import "sa_std/vec_deque.sars"

@test "sa_std vec_deque iterator view clone macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop_ok, popped, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50

    EXPAND VEC_DEQUE_ITER_U64 iter, iter_backing, deque
    EXPAND VEC_DEQUE_ITER_NEXT_U64 first_has, first, iter
    ref_slice = stack_alloc Slice_SIZE
    EXPAND VEC_DEQUE_ITER_AS_REF_SLICE_U64 ref_slice, iter
    EXPAND SLICE_GET_LEN ref_len, ref_slice
    EXPAND SLICE_GET_U64 ref_first, ref_slice, 0
    EXPAND VEC_DEQUE_ITER_CLONE_U64 clone_iter, iter
    EXPAND VEC_DEQUE_ITER_SIZE_HINT_U64 clone_lower, clone_upper, clone_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 original_len_after_clone, iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 clone_next_has, clone_next, clone_iter
    EXPAND VEC_DEQUE_ITER_NEXT_BACK_U64 clone_back_has, clone_back, clone_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 clone_middle_has, clone_middle, clone_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 clone_done_has, clone_done, clone_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 original_next_has, original_next, iter
    EXPAND VEC_DEQUE_ITER_NEXT_BACK_U64 original_back_has, original_back, iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 original_middle_has, original_middle, iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 original_empty, iter
    EXPAND VEC_DEQUE_LEN deque_len_after_borrow, deque

    EXPAND VEC_DEQUE_ITER_DEFAULT_U64 default_iter
    EXPAND VEC_DEQUE_ITER_CLONE_U64 default_clone_iter, default_iter
    EXPAND VEC_DEQUE_ITER_SIZE_HINT_U64 default_lower, default_upper, default_clone_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 default_empty, default_clone_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 default_next_has, default_next, default_clone_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 7
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 8
    EXPAND VEC_DEQUE_TRY_POP_FRONT into_pop_ok, into_popped, into_deque
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 9
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    into_ref_slice = stack_alloc Slice_SIZE
    EXPAND VEC_DEQUE_INTO_ITER_AS_REF_SLICE_U64 into_ref_slice, into_iter
    EXPAND SLICE_GET_LEN into_ref_len, into_ref_slice
    EXPAND SLICE_GET_U64 into_ref_first, into_ref_slice, 0
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_first_has, into_first, into_iter
    into_mut_slice = stack_alloc Slice_SIZE
    EXPAND VEC_DEQUE_INTO_ITER_AS_MUT_SLICE_U64 into_mut_slice, into_iter
    EXPAND SLICE_GET_LEN into_mut_len, into_mut_slice
    EXPAND SLICE_GET_MUT_PTR_U64 into_mut_first_ptr, into_mut_slice, 0
    store into_mut_first_ptr+0, 70 as u64
    EXPAND VEC_DEQUE_INTO_ITER_CLONE_U64 into_clone_iter, into_clone_backing, into_iter
    EXPAND VEC_LEN into_clone_len, into_clone_backing
    clone_mut_slice = stack_alloc Slice_SIZE
    EXPAND VEC_DEQUE_INTO_ITER_AS_MUT_SLICE_U64 clone_mut_slice, into_clone_iter
    EXPAND SLICE_GET_MUT_PTR_U64 clone_mut_first_ptr, clone_mut_slice, 0
    store clone_mut_first_ptr+0, 700 as u64
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_clone_next_has, into_clone_next, into_clone_iter
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_BACK_U64 into_clone_back_has, into_clone_back, into_clone_iter
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_clone_middle_has, into_clone_middle, into_clone_iter
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_clone_done_has, into_clone_done, into_clone_iter
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_LEN_U64 into_original_len_after_clone, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_original_next_has, into_original_next, into_iter
    EXPAND VEC_GET_U64 into_backing_second_after_clone, into_backing, 1
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_DEQUE_INTO_ITER_DEFAULT_U64 empty_into_iter, empty_into_backing
    empty_into_slice = stack_alloc Slice_SIZE
    EXPAND VEC_DEQUE_INTO_ITER_AS_SLICE_U64 empty_into_slice, empty_into_iter
    EXPAND SLICE_GET_LEN empty_into_slice_len, empty_into_slice
    EXPAND VEC_DEQUE_INTO_ITER_CLONE_U64 empty_clone_iter, empty_clone_backing, empty_into_iter
    EXPAND VEC_LEN empty_clone_len, empty_clone_backing
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 empty_clone_next_has, empty_clone_next, empty_clone_iter

    EXPAND VEC_FREE iter_backing
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_clone_backing
    EXPAND VEC_FREE empty_into_backing
    EXPAND VEC_FREE empty_clone_backing
    EXPAND VEC_DEQUE_FREE deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq pop_ok, 1
    check = eq popped, 10
    ok = and ok, check
    check = eq first_has, 1
    ok = and ok, check
    check = eq first, 20
    ok = and ok, check
    check = eq ref_len, 3
    ok = and ok, check
    check = eq ref_first, 30
    ok = and ok, check
    check = eq clone_lower, 3
    ok = and ok, check
    check = eq clone_upper, 3
    ok = and ok, check
    check = eq original_len_after_clone, 3
    ok = and ok, check
    check = eq clone_next_has, 1
    ok = and ok, check
    check = eq clone_next, 30
    ok = and ok, check
    check = eq clone_back_has, 1
    ok = and ok, check
    check = eq clone_back, 50
    ok = and ok, check
    check = eq clone_middle_has, 1
    ok = and ok, check
    check = eq clone_middle, 40
    ok = and ok, check
    check = eq clone_done_has, 0
    ok = and ok, check
    check = eq clone_done, 0
    ok = and ok, check
    check = eq original_next_has, 1
    ok = and ok, check
    check = eq original_next, 30
    ok = and ok, check
    check = eq original_back_has, 1
    ok = and ok, check
    check = eq original_back, 50
    ok = and ok, check
    check = eq original_middle_has, 1
    ok = and ok, check
    check = eq original_middle, 40
    ok = and ok, check
    check = eq original_empty, 1
    ok = and ok, check
    check = eq deque_len_after_borrow, 4
    ok = and ok, check
    check = eq default_lower, 0
    ok = and ok, check
    check = eq default_upper, 0
    ok = and ok, check
    check = eq default_empty, 1
    ok = and ok, check
    check = eq default_next_has, 0
    ok = and ok, check
    check = eq default_next, 0
    ok = and ok, check
    check = eq into_pop_ok, 1
    ok = and ok, check
    check = eq into_popped, 5
    ok = and ok, check
    check = eq into_ref_len, 4
    ok = and ok, check
    check = eq into_ref_first, 6
    ok = and ok, check
    check = eq into_first_has, 1
    ok = and ok, check
    check = eq into_first, 6
    ok = and ok, check
    check = eq into_mut_len, 3
    ok = and ok, check
    check = eq into_clone_len, 3
    ok = and ok, check
    check = eq into_clone_next_has, 1
    ok = and ok, check
    check = eq into_clone_next, 700
    ok = and ok, check
    check = eq into_clone_back_has, 1
    ok = and ok, check
    check = eq into_clone_back, 9
    ok = and ok, check
    check = eq into_clone_middle_has, 1
    ok = and ok, check
    check = eq into_clone_middle, 8
    ok = and ok, check
    check = eq into_clone_done_has, 0
    ok = and ok, check
    check = eq into_clone_done, 0
    ok = and ok, check
    check = eq into_original_len_after_clone, 3
    ok = and ok, check
    check = eq into_original_next_has, 1
    ok = and ok, check
    check = eq into_original_next, 70
    ok = and ok, check
    check = eq into_backing_second_after_clone, 70
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check
    check = eq empty_into_slice_len, 0
    ok = and ok, check
    check = eq empty_clone_len, 0
    ok = and ok, check
    check = eq empty_clone_next_has, 0
    ok = and ok, check
    check = eq empty_clone_next, 0
    ok = and ok, check

    !pop_ok
    !popped
    !first_has
    !first
    !ref_len
    !ref_first
    !clone_lower
    !clone_upper
    !original_len_after_clone
    !clone_next_has
    !clone_next
    !clone_back_has
    !clone_back
    !clone_middle_has
    !clone_middle
    !clone_done_has
    !clone_done
    !original_next_has
    !original_next
    !original_back_has
    !original_back
    !original_middle_has
    !original_middle
    !original_empty
    !deque_len_after_borrow
    !default_lower
    !default_upper
    !default_empty
    !default_next_has
    !default_next
    !into_pop_ok
    !into_popped
    !into_ref_len
    !into_ref_first
    !into_first_has
    !into_first
    !into_mut_len
    !into_mut_first_ptr
    !into_clone_len
    !clone_mut_first_ptr
    !into_clone_next_has
    !into_clone_next
    !into_clone_back_has
    !into_clone_back
    !into_clone_middle_has
    !into_clone_middle
    !into_clone_done_has
    !into_clone_done
    !into_original_len_after_clone
    !into_original_next_has
    !into_original_next
    !into_backing_second_after_clone
    !into_deque_empty
    !empty_into_slice_len
    !empty_clone_len
    !empty_clone_next_has
    !empty_clone_next
    !check
    !iter
    !clone_iter
    !default_iter
    !default_clone_iter
    !into_iter
    !into_clone_iter
    !empty_into_iter
    !empty_clone_iter
    br ok -> L_VEC_DEQUE_ITER_VIEW_CLONE_OK, L_VEC_DEQUE_ITER_VIEW_CLONE_FAIL

L_VEC_DEQUE_ITER_VIEW_CLONE_FAIL:
    !ok
    panic(10801)

L_VEC_DEQUE_ITER_VIEW_CLONE_OK:
    !ok
    return
