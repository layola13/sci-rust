@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_map.sars"

@const K = utf8:"k"

@test "sa_std btree_map is_empty"():
L_ENTRY:
    key = alloc Slice_SIZE
    EXPAND SLICE_NEW key, &K, 1
    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_IS_EMPTY e0, map
    EXPAND BTREE_MAP_INSERT map, key, 1
    EXPAND BTREE_MAP_IS_EMPTY e1, map
    EXPAND BTREE_MAP_FREE map
    a = eq e0, 1
    b = eq e1, 0
    ok = and a, b
    !e0
    !e1
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10967)
