    EXPAND NUM_I32_CHECKED_NEXT_MULTIPLE_OF i32_over_ok, i32_over, NUM_I32_MAX, 2
    EXPAND NUM_I32_CHECKED_NEXT_MULTIPLE_OF i32_min_rhs_ok, i32_min_rhs, -7, NUM_I32_MIN
    EXPAND NUM_I32_NEXT_MULTIPLE_OF i32_direct_ok_value, -1025, 64

    ok01 = eq i8_pos_ok, 1
    ok02 = eq i8_pos, 49
    ok03 = eq i8_neg_value_ok, 1
    ok04 = eq i8_neg_value, -42
    ok05 = eq i8_neg_rhs_ok, 1
    ok06 = eq i8_neg_rhs, 49
    ok07 = eq i8_aligned_ok, 1
    ok08 = eq i8_aligned, -42
    ok09 = eq i8_zero_rhs_ok, 0
    ok10 = eq i8_zero_rhs, 0
    ok11 = eq i8_over_ok, 0
    ok12 = eq i8_over, 0
    ok13 = eq i8_min_rhs_ok, 1
