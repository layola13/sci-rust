@import "sa_std/num.sars"

@test "sa_std num narrow signed next_multiple_of macro surface"():
L_ENTRY:
    EXPAND NUM_I8_CHECKED_NEXT_MULTIPLE_OF i8_pos_ok, i8_pos, 43, 7
    EXPAND NUM_I8_CHECKED_NEXT_MULTIPLE_OF i8_neg_value_ok, i8_neg_value, -43, 7
