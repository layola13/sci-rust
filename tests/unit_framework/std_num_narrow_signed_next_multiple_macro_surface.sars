    EXPAND NUM_I16_CHECKED_NEXT_MULTIPLE_OF i16_min_rhs_ok, i16_min_rhs, -7, NUM_I16_MIN
    EXPAND NUM_I16_NEXT_MULTIPLE_OF i16_direct_ok_value, -43, 7

    EXPAND NUM_I32_CHECKED_NEXT_MULTIPLE_OF i32_pos_ok, i32_pos, 1025, 64
    EXPAND NUM_I32_CHECKED_NEXT_MULTIPLE_OF i32_neg_value_ok, i32_neg_value, -1025, 64
    EXPAND NUM_I32_CHECKED_NEXT_MULTIPLE_OF i32_neg_rhs_ok, i32_neg_rhs, 1025, -64
