@import "sa_std/array.sars"

@test "sa_std array default macro surface"():
L_ENTRY:
    arr_u64 = stack_alloc 24
    arr_i64 = stack_alloc 16
    arr_usize = stack_alloc 16
    arr_bool = stack_alloc 24
    alias_u64 = stack_alloc 16
    alias_bool = stack_alloc 16

    store arr_u64+0, 11 as u64
    store arr_u64+8, 22 as u64
    store arr_u64+16, 33 as u64
    store arr_i64+0, 44 as u64
    store arr_i64+8, 55 as u64
    store arr_usize+0, 66 as u64
    store arr_usize+8, 77 as u64
    store arr_bool+0, 1 as u64
    store arr_bool+8, 1 as u64
    store arr_bool+16, 1 as u64
    store alias_u64+0, 88 as u64
    store alias_u64+8, 99 as u64
    store alias_bool+0, 1 as u64
    store alias_bool+8, 1 as u64

    EXPAND ARRAY_DEFAULT_U64 arr_u64, 3
    EXPAND ARRAY_DEFAULT_I64 arr_i64, 2
    EXPAND ARRAY_DEFAULT_USIZE arr_usize, 2
    EXPAND ARRAY_DEFAULT_BOOL arr_bool, 3
    EXPAND DEFAULT_ARRAY_U64 alias_u64, 2
    EXPAND DEFAULT_ARRAY_BOOL alias_bool, 2

    u64_0 = load arr_u64+0 as u64
    u64_2 = load arr_u64+16 as u64
    i64_1 = load arr_i64+8 as u64
    usize_0 = load arr_usize+0 as u64
    bool_0 = load arr_bool+0 as u64
    bool_2 = load arr_bool+16 as u64
    alias_u64_1 = load alias_u64+8 as u64
    alias_bool_0 = load alias_bool+0 as u64

    ok_u64_0 = eq u64_0, 0
    ok_u64_2 = eq u64_2, 0
    ok_i64_1 = eq i64_1, 0
    ok_usize_0 = eq usize_0, 0
    ok_bool_0 = eq bool_0, 0
    ok_bool_2 = eq bool_2, 0
    ok_alias_u64 = eq alias_u64_1, 0
    ok_alias_bool = eq alias_bool_0, 0

    c01 = and ok_u64_0, ok_u64_2
    c02 = and c01, ok_i64_1
    c03 = and c02, ok_usize_0
    c04 = and c03, ok_bool_0
    c05 = and c04, ok_bool_2
    c06 = and c05, ok_alias_u64
    ok = and c06, ok_alias_bool

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10522)

L_PASS:
    return 0
