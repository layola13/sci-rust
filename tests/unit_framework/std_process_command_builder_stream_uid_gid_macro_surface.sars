@import "sa_std/process.sars"

@const TRUE_BIN = utf8:"/bin/true"

#def TRUE_BIN_LEN = 9
#def TRUE_ARGV1_SIZE = 16

@test "sa_std process Command builder stream uid gid macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV1_SIZE
    dummy = stack_alloc 1
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, TRUE_BIN, TRUE_BIN_LEN
    EXPAND PROCESS_USER_ID current_uid
    EXPAND PROCESS_GROUP_ID current_gid

    EXPAND PROCESS_COMMAND_BUILDER_NEW cwd_len0, has_cwd0, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0
    EXPAND PROCESS_COMMAND_BUILDER_SPAWN_STREAM_UID_GID stream_status, stream_process, stream_stdout, stream_stderr, argv, 1, dummy, cwd_len0, has_cwd0, dummy, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0, current_uid, 1, current_gid, 1
    stream_status_ok = eq stream_status, SA_PROCESS_OK
    stream_process_ok = ne stream_process, 0
    stream_stdout_ok = ne stream_stdout, 0
    stream_stderr_ok = ne stream_stderr, 0
    stream01 = and stream_status_ok, stream_process_ok
    stream02 = and stream01, stream_stdout_ok
    stream_ok = and stream02, stream_stderr_ok
    br stream_ok -> L_STREAM_WAIT, L_FAIL_STREAM

L_FAIL_STREAM:
    !stream_ok
    !stream02
    !stream01
    !stream_stderr_ok
    !stream_stdout_ok
    !stream_process_ok
    !stream_status_ok
    !stream_stderr
    !stream_stdout
    !stream_process
    !stream_status
    !current_uid
    !current_gid
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    panic(10688)

L_STREAM_WAIT:
    EXPAND PROCESS_WAIT stream_wait_status, stream_code, stream_process
    EXPAND PROCESS_CLOSE stream_close_process, stream_process
    EXPAND FS_CLOSE stream_close_stdout, stream_stdout
    EXPAND FS_CLOSE stream_close_stderr, stream_stderr
    stream_wait_ok = eq stream_wait_status, SA_PROCESS_OK
    stream_code_ok = eq stream_code, 0
    stream_close_process_ok = eq stream_close_process, SA_PROCESS_OK
    stream_close_stdout_ok = eq stream_close_stdout, SA_PROCESS_OK
    stream_close_stderr_ok = eq stream_close_stderr, SA_PROCESS_OK
    stream_close01 = and stream_close_process_ok, stream_close_stdout_ok
    stream_close_ok = and stream_close01, stream_close_stderr_ok
    ok00 = and stream_ok, stream_wait_ok
    ok01 = and ok00, stream_code_ok
    ok = and ok01, stream_close_ok

    !stream_wait_status
    !stream_code
    !stream_close_process
    !stream_close_stdout
    !stream_close_stderr
    !stream_wait_ok
    !stream_code_ok
    !stream_close_process_ok
    !stream_close_stdout_ok
    !stream_close_stderr_ok
    !stream_close01
    !stream_close_ok
    !ok00
    !ok01
    !stream_ok
    !stream02
    !stream01
    !stream_stderr_ok
    !stream_stdout_ok
    !stream_process_ok
    !stream_status_ok
    !stream_stderr
    !stream_stdout
    !stream_process
    !stream_status
    !current_uid
    !current_gid
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10688)

L_PASS:
    !ok
    return 0
