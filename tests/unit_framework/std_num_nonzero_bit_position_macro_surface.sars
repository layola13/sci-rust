@import "sa_std/num.sars"

@test "sa_std nonzero integer bit position macro surface"():
L_ENTRY:
    u8_nz = stack_alloc NonZeroU8_SIZE
    u16_nz = stack_alloc NonZeroU16_SIZE
    u32_nz = stack_alloc NonZeroU32_SIZE
    u64_nz = stack_alloc NonZeroU64_SIZE
    usize_nz = stack_alloc NonZeroUsize_SIZE
    i8_nz = stack_alloc NonZeroI8_SIZE
    i16_nz = stack_alloc NonZeroI16_SIZE
    i32_nz = stack_alloc NonZeroI32_SIZE
    i64_nz = stack_alloc NonZeroI64_SIZE
    isize_nz = stack_alloc NonZeroIsize_SIZE

    EXPAND NONZERO_U8_NEW ok_u8, u8_nz, 40
    EXPAND NONZERO_U16_NEW ok_u16, u16_nz, 1032
    EXPAND NONZERO_U32_NEW ok_u32, u32_nz, 16777232
    EXPAND NONZERO_U64_NEW ok_u64, u64_nz, 281474976710688
    EXPAND NONZERO_USIZE_NEW ok_usize, usize_nz, 128
    EXPAND NONZERO_I8_NEW ok_i8, i8_nz, -8
    EXPAND NONZERO_I16_NEW ok_i16, i16_nz, -8
    EXPAND NONZERO_I32_NEW ok_i32, i32_nz, -16
    EXPAND NONZERO_I64_NEW ok_i64, i64_nz, -8
    EXPAND NONZERO_ISIZE_NEW ok_isize, isize_nz, -8

    EXPAND NONZERO_U8_HIGHEST_ONE u8_high, u8_nz
    EXPAND NONZERO_U8_LOWEST_ONE u8_low, u8_nz
    EXPAND NONZERO_U16_HIGHEST_ONE u16_high, u16_nz
    EXPAND NONZERO_U16_LOWEST_ONE u16_low, u16_nz
    EXPAND NONZERO_U32_HIGHEST_ONE u32_high, u32_nz
    EXPAND NONZERO_U32_LOWEST_ONE u32_low, u32_nz
    EXPAND NONZERO_U64_HIGHEST_ONE u64_high, u64_nz
    EXPAND NONZERO_U64_LOWEST_ONE u64_low, u64_nz
    EXPAND NONZERO_USIZE_HIGHEST_ONE usize_high, usize_nz
    EXPAND NONZERO_USIZE_LOWEST_ONE usize_low, usize_nz
    EXPAND NONZERO_I8_HIGHEST_ONE i8_high, i8_nz
    EXPAND NONZERO_I8_LOWEST_ONE i8_low, i8_nz
    EXPAND NONZERO_I16_HIGHEST_ONE i16_high, i16_nz
    EXPAND NONZERO_I16_LOWEST_ONE i16_low, i16_nz
    EXPAND NONZERO_I32_HIGHEST_ONE i32_high, i32_nz
    EXPAND NONZERO_I32_LOWEST_ONE i32_low, i32_nz
    EXPAND NONZERO_I64_HIGHEST_ONE i64_high, i64_nz
    EXPAND NONZERO_I64_LOWEST_ONE i64_low, i64_nz
    EXPAND NONZERO_ISIZE_HIGHEST_ONE isize_high, isize_nz
    EXPAND NONZERO_ISIZE_LOWEST_ONE isize_low, isize_nz

    ok_new_01 = and ok_u8, ok_u16
    ok_new_02 = and ok_new_01, ok_u32
    ok_new_03 = and ok_new_02, ok_u64
    ok_new_04 = and ok_new_03, ok_usize
    ok_new_05 = and ok_new_04, ok_i8
    ok_new_06 = and ok_new_05, ok_i16
    ok_new_07 = and ok_new_06, ok_i32
    ok_new_08 = and ok_new_07, ok_i64
    ok_new_all = and ok_new_08, ok_isize

    ok_u8_high = eq u8_high, 5
    ok_u8_low = eq u8_low, 3
    ok_u16_high = eq u16_high, 10
    ok_u16_low = eq u16_low, 3
    ok_u32_high = eq u32_high, 24
    ok_u32_low = eq u32_low, 4
    ok_u64_high = eq u64_high, 48
    ok_u64_low = eq u64_low, 5
    ok_usize_high = eq usize_high, 7
    ok_usize_low = eq usize_low, 7
    ok_i8_high = eq i8_high, 7
    ok_i8_low = eq i8_low, 3
    ok_i16_high = eq i16_high, 15
    ok_i16_low = eq i16_low, 3
    ok_i32_high = eq i32_high, 31
    ok_i32_low = eq i32_low, 4
    ok_i64_high = eq i64_high, 63
    ok_i64_low = eq i64_low, 3
    ok_isize_high = eq isize_high, 63
    ok_isize_low = eq isize_low, 3

    ok_chain_01 = and ok_new_all, ok_u8_high
    ok_chain_02 = and ok_chain_01, ok_u8_low
    ok_chain_03 = and ok_chain_02, ok_u16_high
    ok_chain_04 = and ok_chain_03, ok_u16_low
    ok_chain_05 = and ok_chain_04, ok_u32_high
    ok_chain_06 = and ok_chain_05, ok_u32_low
    ok_chain_07 = and ok_chain_06, ok_u64_high
    ok_chain_08 = and ok_chain_07, ok_u64_low
    ok_chain_09 = and ok_chain_08, ok_usize_high
    ok_chain_10 = and ok_chain_09, ok_usize_low
    ok_chain_11 = and ok_chain_10, ok_i8_high
    ok_chain_12 = and ok_chain_11, ok_i8_low
    ok_chain_13 = and ok_chain_12, ok_i16_high
    ok_chain_14 = and ok_chain_13, ok_i16_low
    ok_chain_15 = and ok_chain_14, ok_i32_high
    ok_chain_16 = and ok_chain_15, ok_i32_low
    ok_chain_17 = and ok_chain_16, ok_i64_high
    ok_chain_18 = and ok_chain_17, ok_i64_low
    ok_chain_19 = and ok_chain_18, ok_isize_high
    ok = and ok_chain_19, ok_isize_low
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10607)

L_PASS:
    !ok
    return 0
