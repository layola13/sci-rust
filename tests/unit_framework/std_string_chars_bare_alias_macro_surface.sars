@import "sa_std/string.sars"
@import "sa_std/vec.sars"
@import "sa_std/core/slice.sars"

@const UTF8_CHARS_BUILT = utf8:"aé🙂"
@const UTF8_CHARS_EXTENDED = utf8:"aé🙂!"
@const UTF8_BOUNDARY_TEXT = utf8:"aé🙂z"

@test "sa_std string chars bare alias macro surface"():
L_ENTRY:
    // FROM_CHARS bare alias builds a string from codepoint slice.
    EXPAND STR_FROM_PARTS built_expected, &UTF8_CHARS_BUILT, 7
    EXPAND STR_FROM_PARTS extended_expected, &UTF8_CHARS_EXTENDED, 8
    EXPAND STR_FROM_PARTS boundary_expected, &UTF8_BOUNDARY_TEXT, 8

    chars_ptr = stack_alloc 24
    store chars_ptr+0, 97 as u64
    store chars_ptr+8, 233 as u64
    store chars_ptr+16, 128578 as u64
    chars_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW chars_slice, chars_ptr, 3

    EXPAND STRING_BUF_FROM_CHARS from_buf, chars_slice
    EXPAND STRING_BUF_AS_STR from_view, from_buf
    EXPAND STR_EQ from_eq, from_view, built_expected

    // EXTEND_CHARS bare alias appends codepoints to an existing buffer.
    EXPAND STRING_BUF_NEW extend_buf
    EXPAND STRING_BUF_EXTEND_CHARS extend_buf, chars_slice
    EXPAND STRING_BUF_EXTEND_CHAR extend_buf, 33
    EXPAND STRING_BUF_AS_STR extend_view, extend_buf
    EXPAND STR_EQ extend_eq, extend_view, extended_expected

    // FROM_CHAR_REFS / EXTEND_CHAR_REFS bare aliases.
    char_ref_a = stack_alloc 8
    char_ref_e = stack_alloc 8
    char_ref_smile = stack_alloc 8
    store char_ref_a+0, 97 as u64
    store char_ref_e+0, 233 as u64
    store char_ref_smile+0, 128578 as u64
    char_refs_ptr = stack_alloc 24
    store char_refs_ptr+0, char_ref_a as ptr
    store char_refs_ptr+8, char_ref_e as ptr
    store char_refs_ptr+16, char_ref_smile as ptr
    char_refs_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW char_refs_slice, char_refs_ptr, 3

    EXPAND STRING_BUF_FROM_CHAR_REFS ref_from_buf, char_refs_slice
    EXPAND STRING_BUF_AS_STR ref_from_view, ref_from_buf
    EXPAND STR_EQ ref_from_eq, ref_from_view, built_expected

    EXPAND STRING_BUF_NEW ref_extend_buf
    EXPAND STRING_BUF_EXTEND_CHAR_REFS ref_extend_buf, char_refs_slice
    EXPAND STRING_BUF_EXTEND_CHAR ref_extend_buf, 33
    EXPAND STRING_BUF_AS_STR ref_extend_view, ref_extend_buf
    EXPAND STR_EQ ref_extend_eq, ref_extend_view, extended_expected

    // INTO_CHARS bare alias: consume buffer into char vec, then rebuild via FROM_CHARS.
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED roundtrip_src, boundary_expected
    EXPAND STRING_BUF_INTO_CHARS roundtrip_chars, roundtrip_src
    EXPAND VEC_LEN roundtrip_len, roundtrip_chars
    EXPAND VEC_AS_SLICE roundtrip_slice, roundtrip_chars
    EXPAND STRING_BUF_FROM_CHARS roundtrip_buf, roundtrip_slice
    EXPAND STRING_BUF_AS_STR roundtrip_view, roundtrip_buf
    EXPAND STR_EQ roundtrip_eq, roundtrip_view, boundary_expected
    EXPAND VEC_TRY_GET_U64 first_ok, first, roundtrip_chars, 0
    EXPAND VEC_TRY_GET_U64 second_ok, second, roundtrip_chars, 1
    EXPAND VEC_TRY_GET_U64 third_ok, third, roundtrip_chars, 2
    EXPAND VEC_TRY_GET_U64 fourth_ok, fourth, roundtrip_chars, 3

    from_value_ok = eq from_eq, 1
    extend_value_ok = eq extend_eq, 1
    ref_from_value_ok = eq ref_from_eq, 1
    ref_extend_value_ok = eq ref_extend_eq, 1
    roundtrip_value_ok = eq roundtrip_eq, 1
    len_ok = eq roundtrip_len, 4
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first, 97
    second_flag_ok = eq second_ok, 1
    second_value_ok = eq second, 233
    third_flag_ok = eq third_ok, 1
    third_value_ok = eq third, 128578
    fourth_flag_ok = eq fourth_ok, 1
    fourth_value_ok = eq fourth, 122

    ok = and from_value_ok, extend_value_ok
    ok = and ok, ref_from_value_ok
    ok = and ok, ref_extend_value_ok
    ok = and ok, roundtrip_value_ok
    ok = and ok, len_ok
    ok = and ok, first_flag_ok
    ok = and ok, first_value_ok
    ok = and ok, second_flag_ok
    ok = and ok, second_value_ok
    ok = and ok, third_flag_ok
    ok = and ok, third_value_ok
    ok = and ok, fourth_flag_ok
    ok = and ok, fourth_value_ok

    !from_view
    !from_eq
    !extend_view
    !extend_eq
    !ref_from_view
    !ref_from_eq
    !ref_extend_view
    !ref_extend_eq
    !roundtrip_view
    !roundtrip_eq
    !roundtrip_len
    !first_ok
    !first
    !second_ok
    !second
    !third_ok
    !third
    !fourth_ok
    !fourth
    !from_value_ok
    !extend_value_ok
    !ref_from_value_ok
    !ref_extend_value_ok
    !roundtrip_value_ok
    !len_ok
    !first_flag_ok
    !first_value_ok
    !second_flag_ok
    !second_value_ok
    !third_flag_ok
    !third_value_ok
    !fourth_flag_ok
    !fourth_value_ok
    EXPAND STRING_BUF_FREE roundtrip_buf
    !roundtrip_slice
    EXPAND VEC_FREE roundtrip_chars
    EXPAND STRING_BUF_FREE ref_extend_buf
    EXPAND STRING_BUF_FREE ref_from_buf
    EXPAND STRING_BUF_FREE extend_buf
    EXPAND STRING_BUF_FREE from_buf
    !char_refs_slice
    !chars_slice
    !boundary_expected
    !extended_expected
    !built_expected
    br ok -> L_STRING_CHARS_BARE_ALIAS_OK, L_STRING_CHARS_BARE_ALIAS_FAIL

L_STRING_CHARS_BARE_ALIAS_FAIL:
    !ok
    panic(10854)

L_STRING_CHARS_BARE_ALIAS_OK:
    !ok
    return
