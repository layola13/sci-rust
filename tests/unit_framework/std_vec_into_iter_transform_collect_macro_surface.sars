@import "sa_std/vec.sars"

@vec_into_iter_times_ten(value: u64) -> u64:
L_ENTRY:
    out = mul value, 10
    !value
    return out

@vec_into_iter_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    return out

@vec_into_iter_inspect_ignored(value: u64) -> u64:
L_ENTRY:
    out = mul value, 100
    !value
    return out

@vec_into_iter_map_even_tens(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    br is_even -> L_VEC_FILTER_MAP_KEEP, L_VEC_FILTER_MAP_SKIP
L_VEC_FILTER_MAP_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !is_even
    !rem
    !out_mapped
    !value
    return 1
L_VEC_FILTER_MAP_SKIP:
    !is_even
    !rem
    !out_mapped
    !value
    return 0

@vec_into_iter_scan_sum_until_six(&state_ptr: ptr, value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    state = load state_ptr+0 as u64
    next = add state, value
    store state_ptr+0, next as u64
    keep = ule next, 6
    br keep -> L_VEC_SCAN_KEEP, L_VEC_SCAN_STOP
L_VEC_SCAN_KEEP:
    mapped = add next, 100
    store out_mapped+0, mapped as u64
    !mapped
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 1
L_VEC_SCAN_STOP:
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 0

@vec_into_iter_map_while_lt_four(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_VEC_MAP_WHILE_KEEP, L_VEC_MAP_WHILE_STOP
L_VEC_MAP_WHILE_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !out_mapped
    !value
    return keep
L_VEC_MAP_WHILE_STOP:
    !out_mapped
    !value
    return keep

@test "sa_std vec into_iter transform collect macro surface"():
L_ENTRY:
    EXPAND VEC_NEW map_src
    EXPAND VEC_PUSH_U64 map_src, 1
    EXPAND VEC_PUSH_U64 map_src, 2
    EXPAND VEC_PUSH_U64 map_src, 3
    EXPAND VEC_INTO_ITER_U64 map_iter, map_backing, map_src
    EXPAND VEC_INTO_ITER_MAP_COLLECT_U64 map_vec, map_iter, @vec_into_iter_times_ten
    EXPAND VEC_LEN map_len, map_vec
    EXPAND VEC_GET_U64 map_0, map_vec, 0
    EXPAND VEC_GET_U64 map_2, map_vec, 2
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 map_empty, map_iter

    EXPAND VEC_NEW inspect_src
    EXPAND VEC_PUSH_U64 inspect_src, 4
    EXPAND VEC_PUSH_U64 inspect_src, 5
    EXPAND VEC_INTO_ITER_U64 inspect_iter, inspect_backing, inspect_src
    EXPAND VEC_INTO_ITER_INSPECT_COLLECT_U64 inspect_vec, inspect_iter, @vec_into_iter_inspect_ignored
    EXPAND VEC_LEN inspect_len, inspect_vec
    EXPAND VEC_GET_U64 inspect_0, inspect_vec, 0
    EXPAND VEC_GET_U64 inspect_1, inspect_vec, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 inspect_empty, inspect_iter

    EXPAND VEC_NEW scan_src
    EXPAND VEC_PUSH_U64 scan_src, 1
    EXPAND VEC_PUSH_U64 scan_src, 2
    EXPAND VEC_PUSH_U64 scan_src, 3
    EXPAND VEC_PUSH_U64 scan_src, 4
    EXPAND VEC_PUSH_U64 scan_src, 5
    EXPAND VEC_INTO_ITER_U64 scan_iter, scan_backing, scan_src
    EXPAND VEC_INTO_ITER_SCAN_COLLECT_U64 scan_vec, scan_iter, 0, @vec_into_iter_scan_sum_until_six
    EXPAND VEC_LEN scan_len, scan_vec
    EXPAND VEC_GET_U64 scan_0, scan_vec, 0
    EXPAND VEC_GET_U64 scan_2, scan_vec, 2
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 scan_remaining, scan_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 scan_tail_has, scan_tail, scan_iter

    EXPAND VEC_NEW filter_src
    EXPAND VEC_PUSH_U64 filter_src, 1
    EXPAND VEC_PUSH_U64 filter_src, 2
    EXPAND VEC_PUSH_U64 filter_src, 3
    EXPAND VEC_PUSH_U64 filter_src, 4
    EXPAND VEC_PUSH_U64 filter_src, 5
    EXPAND VEC_INTO_ITER_U64 filter_iter, filter_backing, filter_src
    EXPAND VEC_INTO_ITER_FILTER_COLLECT_U64 filter_vec, filter_iter, @vec_into_iter_is_even
    EXPAND VEC_LEN filter_len, filter_vec
    EXPAND VEC_GET_U64 filter_0, filter_vec, 0
    EXPAND VEC_GET_U64 filter_1, filter_vec, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 filter_empty, filter_iter

    EXPAND VEC_NEW filter_map_src
    EXPAND VEC_PUSH_U64 filter_map_src, 1
    EXPAND VEC_PUSH_U64 filter_map_src, 2
    EXPAND VEC_PUSH_U64 filter_map_src, 3
    EXPAND VEC_PUSH_U64 filter_map_src, 4
    EXPAND VEC_PUSH_U64 filter_map_src, 5
    EXPAND VEC_INTO_ITER_U64 filter_map_iter, filter_map_backing, filter_map_src
    EXPAND VEC_INTO_ITER_FILTER_MAP_COLLECT_U64 filter_map_vec, filter_map_iter, @vec_into_iter_map_even_tens
    EXPAND VEC_LEN filter_map_len, filter_map_vec
    EXPAND VEC_GET_U64 filter_map_0, filter_map_vec, 0
    EXPAND VEC_GET_U64 filter_map_1, filter_map_vec, 1
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 filter_map_empty, filter_map_iter

    EXPAND VEC_NEW map_while_src
    EXPAND VEC_PUSH_U64 map_while_src, 1
    EXPAND VEC_PUSH_U64 map_while_src, 2
    EXPAND VEC_PUSH_U64 map_while_src, 3
    EXPAND VEC_PUSH_U64 map_while_src, 4
    EXPAND VEC_PUSH_U64 map_while_src, 5
    EXPAND VEC_INTO_ITER_U64 map_while_iter, map_while_backing, map_while_src
    EXPAND VEC_INTO_ITER_MAP_WHILE_COLLECT_U64 map_while_vec, map_while_iter, @vec_into_iter_map_while_lt_four
    EXPAND VEC_LEN map_while_len, map_while_vec
    EXPAND VEC_GET_U64 map_while_0, map_while_vec, 0
    EXPAND VEC_GET_U64 map_while_2, map_while_vec, 2
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 map_while_remaining, map_while_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 map_while_tail_has, map_while_tail, map_while_iter

    EXPAND VEC_FREE map_backing
    EXPAND VEC_FREE map_vec
    EXPAND VEC_FREE inspect_backing
    EXPAND VEC_FREE inspect_vec
    EXPAND VEC_FREE scan_backing
    EXPAND VEC_FREE scan_vec
    EXPAND VEC_FREE filter_backing
    EXPAND VEC_FREE filter_vec
    EXPAND VEC_FREE filter_map_backing
    EXPAND VEC_FREE filter_map_vec
    EXPAND VEC_FREE map_while_backing
    EXPAND VEC_FREE map_while_vec

    ok_map_len = eq map_len, 3
    ok_map_0 = eq map_0, 10
    ok_map_2 = eq map_2, 30
    ok_map_empty = eq map_empty, 1
    ok_inspect_len = eq inspect_len, 2
    ok_inspect_0 = eq inspect_0, 4
    ok_inspect_1 = eq inspect_1, 5
    ok_inspect_empty = eq inspect_empty, 1
    ok_scan_len = eq scan_len, 3
    ok_scan_0 = eq scan_0, 101
    ok_scan_2 = eq scan_2, 106
    ok_scan_remaining = eq scan_remaining, 1
    ok_scan_tail_has = eq scan_tail_has, 1
    ok_scan_tail = eq scan_tail, 5
    ok_filter_len = eq filter_len, 2
    ok_filter_0 = eq filter_0, 2
    ok_filter_1 = eq filter_1, 4
    ok_filter_empty = eq filter_empty, 1
    ok_filter_map_len = eq filter_map_len, 2
    ok_filter_map_0 = eq filter_map_0, 20
    ok_filter_map_1 = eq filter_map_1, 40
    ok_filter_map_empty = eq filter_map_empty, 1
    ok_map_while_len = eq map_while_len, 3
    ok_map_while_0 = eq map_while_0, 10
    ok_map_while_2 = eq map_while_2, 30
    ok_map_while_remaining = eq map_while_remaining, 1
    ok_map_while_tail_has = eq map_while_tail_has, 1
    ok_map_while_tail = eq map_while_tail, 5

    ok = and ok_map_len, ok_map_0
    ok = and ok, ok_map_2
    ok = and ok, ok_map_empty
    ok = and ok, ok_inspect_len
    ok = and ok, ok_inspect_0
    ok = and ok, ok_inspect_1
    ok = and ok, ok_inspect_empty
    ok = and ok, ok_scan_len
    ok = and ok, ok_scan_0
    ok = and ok, ok_scan_2
    ok = and ok, ok_scan_remaining
    ok = and ok, ok_scan_tail_has
    ok = and ok, ok_scan_tail
    ok = and ok, ok_filter_len
    ok = and ok, ok_filter_0
    ok = and ok, ok_filter_1
    ok = and ok, ok_filter_empty
    ok = and ok, ok_filter_map_len
    ok = and ok, ok_filter_map_0
    ok = and ok, ok_filter_map_1
    ok = and ok, ok_filter_map_empty
    ok = and ok, ok_map_while_len
    ok = and ok, ok_map_while_0
    ok = and ok, ok_map_while_2
    ok = and ok, ok_map_while_remaining
    ok = and ok, ok_map_while_tail_has
    ok = and ok, ok_map_while_tail

    !map_len
    !map_0
    !map_2
    !map_empty
    !inspect_len
    !inspect_0
    !inspect_1
    !inspect_empty
    !scan_len
    !scan_0
    !scan_2
    !scan_remaining
    !scan_tail_has
    !scan_tail
    !filter_len
    !filter_0
    !filter_1
    !filter_empty
    !filter_map_len
    !filter_map_0
    !filter_map_1
    !filter_map_empty
    !map_while_len
    !map_while_0
    !map_while_2
    !map_while_remaining
    !map_while_tail_has
    !map_while_tail
    !ok_map_len
    !ok_map_0
    !ok_map_2
    !ok_map_empty
    !ok_inspect_len
    !ok_inspect_0
    !ok_inspect_1
    !ok_inspect_empty
    !ok_scan_len
    !ok_scan_0
    !ok_scan_2
    !ok_scan_remaining
    !ok_scan_tail_has
    !ok_scan_tail
    !ok_filter_len
    !ok_filter_0
    !ok_filter_1
    !ok_filter_empty
    !ok_filter_map_len
    !ok_filter_map_0
    !ok_filter_map_1
    !ok_filter_map_empty
    !ok_map_while_len
    !ok_map_while_0
    !ok_map_while_2
    !ok_map_while_remaining
    !ok_map_while_tail_has
    !ok_map_while_tail
    !map_iter
    !inspect_iter
    !scan_iter
    !filter_iter
    !filter_map_iter
    !map_while_iter
    br ok -> L_VEC_INTO_ITER_TRANSFORM_COLLECT_OK, L_VEC_INTO_ITER_TRANSFORM_COLLECT_FAIL

L_VEC_INTO_ITER_TRANSFORM_COLLECT_FAIL:
    !ok
    panic(10722)

L_VEC_INTO_ITER_TRANSFORM_COLLECT_OK:
    !ok
    return
