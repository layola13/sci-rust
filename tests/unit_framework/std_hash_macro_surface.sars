@import "sa_std/hash.sars"
@import "sa_std/core/slice.sars"

@test "sa_std hash default hasher macros"():
L_ENTRY:
    hasher_a = stack_alloc DefaultHasher_SIZE
    hasher_b = stack_alloc DefaultHasher_SIZE
    hasher_c = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW hasher_a
    EXPAND DEFAULT_HASHER_NEW hasher_b
    EXPAND DEFAULT_HASHER_NEW hasher_c

    EXPAND DEFAULT_HASHER_WRITE_U64 hasher_a, 7
    EXPAND DEFAULT_HASHER_WRITE_BOOL hasher_a, 1
    EXPAND DEFAULT_HASHER_WRITE_U32 hasher_a, 99
    EXPAND DEFAULT_HASHER_FINISH hash_a, hasher_a

    EXPAND DEFAULT_HASHER_WRITE_U64 hasher_b, 7
    EXPAND DEFAULT_HASHER_WRITE_BOOL hasher_b, 1
    EXPAND DEFAULT_HASHER_WRITE_U32 hasher_b, 99
    EXPAND DEFAULT_HASHER_FINISH hash_b, hasher_b

    EXPAND DEFAULT_HASHER_WRITE_U64 hasher_c, 8
    EXPAND DEFAULT_HASHER_WRITE_BOOL hasher_c, 1
    EXPAND DEFAULT_HASHER_WRITE_U32 hasher_c, 99
    EXPAND DEFAULT_HASHER_FINISH hash_c, hasher_c

    EXPAND DEFAULT_HASHER_RESET hasher_c
    EXPAND DEFAULT_HASHER_FINISH reset_hash, hasher_c

    ptr_slot = stack_alloc 8
    EXPAND HASH_PTR_VALUE ptr_hash, ptr_slot
    EXPAND HASH_U64 direct_hash, 7

    bytes_data = alloc 4
    store bytes_data+0, 114 as u8
    store bytes_data+1, 117 as u8
    store bytes_data+2, 115 as u8
    store bytes_data+3, 116 as u8
    bytes_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW bytes_slice, bytes_data, 4
    EXPAND HASH_STR str_hash, bytes_slice
    EXPAND HASH_STR str_hash_again, bytes_slice
    EXPAND HASH_SLICE_U8 byte_slice_hash, bytes_slice

    nums_data = alloc 16
    store nums_data+0, 7 as u64
    store nums_data+8, 99 as u64
    nums_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW nums_slice, nums_data, 2
    EXPAND SLICE_HASH_U64 nums_hash, nums_slice
    nums_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW nums_hasher
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 nums_hasher, nums_slice
    EXPAND DEFAULT_HASHER_FINISH nums_hash_manual, nums_hasher

    EXPAND BUILD_HASHER_DEFAULT_NEW builder
    EXPAND BUILD_HASHER_DEFAULT_DEFAULT builder_default
    built_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD built_hasher, builder
    EXPAND DEFAULT_HASHER_WRITE_USIZE built_hasher, 7
    EXPAND DEFAULT_HASHER_FINISH built_hash, built_hasher

    default_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_DEFAULT default_hasher
    EXPAND DEFAULT_HASHER_FINISH default_hash, default_hasher
    built_default_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD built_default_hasher, builder_default
    EXPAND DEFAULT_HASHER_FINISH built_default_hash, built_default_hasher

    same_hash = eq hash_a, hash_b
    diff_hash = ne hash_a, hash_c
    reset_ok = eq reset_hash, HASHER_DEFAULT_SEED
    ptr_hash_changed = ne ptr_hash, HASHER_DEFAULT_SEED
    direct_hash_changed = ne direct_hash, HASHER_DEFAULT_SEED
    built_hash_eq = eq built_hash, direct_hash
    builder_default_ok = eq builder_default, 0
    default_hash_ok = eq default_hash, HASHER_DEFAULT_SEED
    built_default_hash_ok = eq built_default_hash, HASHER_DEFAULT_SEED
    str_hash_stable = eq str_hash, str_hash_again
    str_hash_domain_sep = ne str_hash, byte_slice_hash
    nums_hash_eq = eq nums_hash, nums_hash_manual
    ok01 = and same_hash, diff_hash
    ok02 = and ok01, reset_ok
    ok03 = and ok02, ptr_hash_changed
    ok04 = and ok03, direct_hash_changed
    ok05 = and ok04, built_hash_eq
    ok06 = and ok05, builder_default_ok
    ok07 = and ok06, default_hash_ok
    ok08 = and ok07, built_default_hash_ok
    ok09 = and ok08, str_hash_stable
    ok10 = and ok09, str_hash_domain_sep
    ok = and ok10, nums_hash_eq

    !hash_a
    !hash_b
    !hash_c
    !reset_hash
    !ptr_hash
    !direct_hash
    !str_hash
    !str_hash_again
    !byte_slice_hash
    !nums_hash
    !nums_hash_manual
    !builder
    !builder_default
    !built_hash
    !default_hash
    !built_default_hash
    !same_hash
    !diff_hash
    !reset_ok
    !ptr_hash_changed
    !direct_hash_changed
    !built_hash_eq
    !builder_default_ok
    !default_hash_ok
    !built_default_hash_ok
    !str_hash_stable
    !str_hash_domain_sep
    !nums_hash_eq
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !bytes_slice
    !bytes_data
    !nums_slice
    !nums_data

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10041)

L_PASS:
    return 0
