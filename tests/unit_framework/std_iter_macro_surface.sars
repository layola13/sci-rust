@test "sa_std iter enumerate zip chain collect macros"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    other_values = stack_alloc 24
    store other_values+0, 10 as u64
    store other_values+8, 20 as u64
    store other_values+16, 30 as u64

    slice = alloc Slice_SIZE
    other_slice = alloc Slice_SIZE
    short_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW other_slice, other_values, 3
    EXPAND SLICE_NEW short_slice, values, 2

    EXPAND ITER_FROM_SLICE enumerate_iter, slice
    EXPAND ITER_NEXT_U64 enumerate_skip_ok, enumerate_skip_value, enumerate_iter
    EXPAND ITER_ENUMERATE_COLLECT_U64 enumerate_vec, enumerate_iter
    EXPAND ITER_IS_EMPTY enumerate_empty, enumerate_iter
    EXPAND VEC_LEN enumerate_len, enumerate_vec
    EXPAND VEC_TRY_GET_U64 enumerate_get0_ok, enumerate_get0, enumerate_vec, 0
    EXPAND VEC_TRY_GET_U64 enumerate_get1_ok, enumerate_get1, enumerate_vec, 1
    EXPAND VEC_TRY_GET_U64 enumerate_get6_ok, enumerate_get6, enumerate_vec, 6
    EXPAND VEC_TRY_GET_U64 enumerate_get7_ok, enumerate_get7, enumerate_vec, 7

    EXPAND ITER_FROM_SLICE zip_left_iter, slice
    EXPAND ITER_FROM_SLICE zip_right_iter, other_slice
    EXPAND ITER_ZIP_COLLECT_U64 zip_vec, zip_left_iter, zip_right_iter
    EXPAND ITER_LEN zip_left_remaining, zip_left_iter
    EXPAND ITER_IS_EMPTY zip_right_empty, zip_right_iter
    EXPAND VEC_LEN zip_len, zip_vec
    EXPAND VEC_TRY_GET_U64 zip_get0_ok, zip_get0, zip_vec, 0
    EXPAND VEC_TRY_GET_U64 zip_get1_ok, zip_get1, zip_vec, 1
    EXPAND VEC_TRY_GET_U64 zip_get4_ok, zip_get4, zip_vec, 4
    EXPAND VEC_TRY_GET_U64 zip_get5_ok, zip_get5, zip_vec, 5

    EXPAND ITER_FROM_SLICE chain_left_iter, short_slice
    EXPAND ITER_FROM_SLICE chain_right_iter, other_slice
    EXPAND ITER_CHAIN_COLLECT_U64 chain_vec, chain_left_iter, chain_right_iter
    EXPAND ITER_IS_EMPTY chain_left_empty, chain_left_iter
    EXPAND ITER_IS_EMPTY chain_right_empty, chain_right_iter
    EXPAND VEC_LEN chain_len, chain_vec
    EXPAND VEC_TRY_GET_U64 chain_get0_ok, chain_get0, chain_vec, 0
    EXPAND VEC_TRY_GET_U64 chain_get1_ok, chain_get1, chain_vec, 1
    EXPAND VEC_TRY_GET_U64 chain_get2_ok, chain_get2, chain_vec, 2
    EXPAND VEC_TRY_GET_U64 chain_get4_ok, chain_get4, chain_vec, 4

    ok01 = eq enumerate_skip_ok, 1
    ok02 = eq enumerate_skip_value, 1
    ok03 = eq enumerate_empty, 1
