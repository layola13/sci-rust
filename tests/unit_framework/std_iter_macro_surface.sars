@test "sa_std iter try adaptor macros"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5

    EXPAND ITER_FROM_SLICE try_fold_stop_iter, slice
    EXPAND ITER_TRY_FOLD_U64 try_fold_stop_ok, try_fold_stop_value, try_fold_stop_iter, 1, @iter_try_accumulate_tens_lt_four
    EXPAND ITER_LEN try_fold_stop_remaining, try_fold_stop_iter

    EXPAND ITER_FROM_SLICE try_fold_all_iter, slice
    EXPAND ITER_TRY_FOLD_U64 try_fold_all_ok, try_fold_all_value, try_fold_all_iter, 1, @iter_try_accumulate_tens_lt_ten
    EXPAND ITER_IS_EMPTY try_fold_all_empty, try_fold_all_iter

    EXPAND ITER_FROM_SLICE try_each_stop_iter, slice
    EXPAND ITER_TRY_FOR_EACH_U64 try_each_stop_ok, try_each_stop_iter, @iter_try_each_lt_four
    EXPAND ITER_LEN try_each_stop_remaining, try_each_stop_iter

    EXPAND ITER_FROM_SLICE try_each_all_iter, slice
    EXPAND ITER_TRY_FOR_EACH_U64 try_each_all_ok, try_each_all_iter, @iter_try_each_lt_ten
    EXPAND ITER_IS_EMPTY try_each_all_empty, try_each_all_iter

    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW empty_slice, values, 0
    EXPAND ITER_FROM_SLICE empty_try_iter, empty_slice
    EXPAND ITER_TRY_FOLD_U64 empty_try_ok, empty_try_value, empty_try_iter, 7, @iter_try_accumulate_tens_lt_four

    ok01 = eq try_fold_stop_ok, 0
    ok02 = eq try_fold_stop_value, 61
    ok03 = eq try_fold_stop_remaining, 1
    ok04 = eq try_fold_all_ok, 1
    ok05 = eq try_fold_all_value, 151
    ok06 = eq try_fold_all_empty, 1
    ok07 = eq try_each_stop_ok, 0
    ok08 = eq try_each_stop_remaining, 1
    ok09 = eq try_each_all_ok, 1
    ok10 = eq try_each_all_empty, 1
    ok11 = eq empty_try_ok, 1
    ok12 = eq empty_try_value, 7

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok09
    all09 = and all08, ok10
    all10 = and all09, ok11
    all = and all10, ok12

    !try_fold_stop_ok
    !try_fold_stop_value
    !try_fold_stop_remaining
    !try_fold_all_ok
    !try_fold_all_value
    !try_fold_all_empty
    !try_each_stop_ok
    !try_each_stop_remaining
    !try_each_all_ok
    !try_each_all_empty
    !empty_try_ok
    !empty_try_value
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !empty_try_iter
    !empty_slice
    !try_each_all_iter
    !try_each_stop_iter
    !try_fold_all_iter
    !try_fold_stop_iter
    !slice
    br all -> L_TRY_ADAPTORS_PASS, L_TRY_ADAPTORS_FAIL

L_TRY_ADAPTORS_FAIL:
    !all
    panic(10064)

L_TRY_ADAPTORS_PASS:
    !all
    return 0

@test "sa_std iter extended cursor macros"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5

    EXPAND ITER_FROM_SLICE hint_iter, slice
    EXPAND ITER_SIZE_HINT hint_lower, hint_upper, hint_iter

    EXPAND ITER_FROM_SLICE adv_iter, slice
    EXPAND ITER_ADVANCE_BY adv_ok, adv_remaining, adv_iter, 2
    EXPAND ITER_LEN adv_len, adv_iter
    EXPAND ITER_NEXT_U64 adv_next_ok, adv_next_value, adv_iter

    EXPAND ITER_FROM_SLICE adv_short_iter, slice
    EXPAND ITER_ADVANCE_BY adv_short_ok, adv_short_remaining, adv_short_iter, 7
    EXPAND ITER_IS_EMPTY adv_short_empty, adv_short_iter

    EXPAND ITER_FROM_SLICE adv_back_iter, slice
    EXPAND ITER_ADVANCE_BACK_BY adv_back_ok, adv_back_remaining, adv_back_iter, 2
    EXPAND ITER_LEN adv_back_len, adv_back_iter
    EXPAND ITER_NEXT_BACK_U64 adv_back_next_ok, adv_back_next_value, adv_back_iter

    EXPAND ITER_FROM_SLICE adv_back_short_iter, slice
    EXPAND ITER_ADVANCE_BACK_BY adv_back_short_ok, adv_back_short_remaining, adv_back_short_iter, 7
    EXPAND ITER_IS_EMPTY adv_back_short_empty, adv_back_short_iter

    EXPAND ITER_FROM_SLICE nth_back_iter, slice
    EXPAND ITER_NTH_BACK_U64 nth_back_ok, nth_back_value, nth_back_iter, 1
    EXPAND ITER_LEN nth_back_len, nth_back_iter
    EXPAND ITER_NEXT_BACK_U64 nth_back_next_ok, nth_back_next_value, nth_back_iter

    EXPAND ITER_FROM_SLICE nth_back_short_iter, slice
    EXPAND ITER_NTH_BACK_U64 nth_back_short_ok, nth_back_short_value, nth_back_short_iter, 99
    EXPAND ITER_IS_EMPTY nth_back_short_empty, nth_back_short_iter

    EXPAND ITER_FROM_SLICE rfind_iter, slice
    EXPAND ITER_RFIND_U64 rfind_ok, rfind_value, rfind_iter, @iter_is_even
    EXPAND ITER_LEN rfind_remaining, rfind_iter

    EXPAND ITER_FROM_SLICE reduce_iter, slice
    EXPAND ITER_REDUCE_U64 reduce_ok, reduce_value, reduce_iter, @iter_accumulate_tens

    chunk_buf = stack_alloc 24
    EXPAND ITER_FROM_SLICE chunk_iter, slice
    EXPAND ITER_TRY_NEXT_CHUNK_U64 chunk_ok, chunk_filled, chunk_iter, chunk_buf, 3
    chunk0 = load chunk_buf+0 as u64
    chunk1 = load chunk_buf+8 as u64
    chunk2 = load chunk_buf+16 as u64
    EXPAND ITER_LEN chunk_remaining, chunk_iter

    short_chunk_buf = stack_alloc 32
    EXPAND ITER_FROM_SLICE short_chunk_iter, slice
    EXPAND ITER_ADVANCE_BY short_chunk_skip_ok, short_chunk_skip_remaining, short_chunk_iter, 3
    EXPAND ITER_TRY_NEXT_CHUNK_U64 short_chunk_ok, short_chunk_filled, short_chunk_iter, short_chunk_buf, 4
    short_chunk0 = load short_chunk_buf+0 as u64
    short_chunk1 = load short_chunk_buf+8 as u64
    EXPAND ITER_IS_EMPTY short_chunk_empty, short_chunk_iter

    zero_chunk_buf = stack_alloc 8
    EXPAND ITER_FROM_SLICE zero_chunk_iter, slice
    EXPAND ITER_NEXT_U64 zero_chunk_skip_ok, zero_chunk_skip_value, zero_chunk_iter
    EXPAND ITER_TRY_NEXT_CHUNK_U64 zero_chunk_ok, zero_chunk_filled, zero_chunk_iter, zero_chunk_buf, 0
    EXPAND ITER_NEXT_U64 zero_chunk_next_ok, zero_chunk_next_value, zero_chunk_iter

    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW empty_slice, values, 0
    EXPAND ITER_FROM_SLICE empty_reduce_iter, empty_slice
    EXPAND ITER_REDUCE_U64 empty_reduce_ok, empty_reduce_value, empty_reduce_iter, @iter_accumulate_tens

    ok01 = eq hint_lower, 5
    ok02 = eq hint_upper, 5
    ok03 = eq adv_ok, 1
    ok04 = eq adv_remaining, 0
    ok05 = eq adv_len, 3
    ok06 = eq adv_next_ok, 1
    ok07 = eq adv_next_value, 3
    ok08 = eq adv_short_ok, 0
    ok09 = eq adv_short_remaining, 2
    ok10 = eq adv_short_empty, 1
    ok11 = eq adv_back_ok, 1
    ok12 = eq adv_back_remaining, 0
    ok13 = eq adv_back_len, 3
    ok14 = eq adv_back_next_ok, 1
    ok15 = eq adv_back_next_value, 3
    ok16 = eq adv_back_short_ok, 0
    ok17 = eq adv_back_short_remaining, 2
    ok18 = eq adv_back_short_empty, 1
    ok19 = eq nth_back_ok, 1
    ok20 = eq nth_back_value, 4
    ok21 = eq nth_back_len, 3
    ok22 = eq nth_back_next_ok, 1
    ok23 = eq nth_back_next_value, 3
    ok24 = eq nth_back_short_ok, 0
    ok25 = eq nth_back_short_value, 0
    ok26 = eq nth_back_short_empty, 1
    ok27 = eq rfind_ok, 1
    ok28 = eq rfind_value, 4
    ok29 = eq rfind_remaining, 3
    ok30 = eq reduce_ok, 1
    ok31 = eq reduce_value, 141
    ok32 = eq empty_reduce_ok, 0
    ok33 = eq empty_reduce_value, 0
    ok34 = eq chunk_ok, 1
    ok35 = eq chunk_filled, 3
    ok36 = eq chunk0, 1
    ok37 = eq chunk1, 2
    ok38 = eq chunk2, 3
    ok39 = eq chunk_remaining, 2
    ok40 = eq short_chunk_skip_ok, 1
    ok41 = eq short_chunk_skip_remaining, 0
    ok42 = eq short_chunk_ok, 0
    ok43 = eq short_chunk_filled, 2
    ok44 = eq short_chunk0, 4
    ok45 = eq short_chunk1, 5
    ok46 = eq short_chunk_empty, 1
    ok47 = eq zero_chunk_skip_ok, 1
    ok48 = eq zero_chunk_skip_value, 1
    ok49 = eq zero_chunk_ok, 1
    ok50 = eq zero_chunk_filled, 0
    ok51 = eq zero_chunk_next_ok, 1
    ok52 = eq zero_chunk_next_value, 2

    all01 = and ok01, ok02
