@import "sa_std/net.sars"

@test "sa_std network byte aliases expand"():
L_ENTRY:
    [IF 0]
    EXPAND NET_TCP_STREAM_READ_BYTES tcp_read_status, tcp_read_len, 0, read_buf, 8
    EXPAND NET_TCP_STREAM_PEEK_BYTES tcp_peek_status, tcp_peek_len, 0, read_buf, 8
    EXPAND NET_TCP_STREAM_WRITE_BYTES tcp_write_status, tcp_write_len, 0, write_buf, 8
    EXPAND NET_TCP_STREAM_WRITE_ALL_BYTES tcp_write_all_status, 0, write_buf, 8
    EXPAND NET_UNIX_STREAM_PEEK_BYTES unix_peek_status, unix_peek_len, 0, read_buf, 8
    EXPAND NET_UNIX_DATAGRAM_SEND_BYTES unix_send_status, unix_send_len, 0, write_buf, 8
    EXPAND NET_UNIX_DATAGRAM_RECV_BYTES unix_recv_status, unix_recv_len, 0, read_buf, 8
    EXPAND NET_UDP_SEND_BYTES udp_send_status, udp_send_len, 0, write_buf, 8
    EXPAND NET_UDP_RECV_BYTES udp_recv_status, udp_recv_len, 0, read_buf, 8
    EXPAND NET_UDP_PEEK_BYTES udp_peek_status, udp_peek_len, 0, read_buf, 8
    EXPAND NET_UDP_SEND_TO_BYTES udp_send_to_status, udp_send_to_len, 0, write_buf, 8, host, 4, 80
    EXPAND NET_UDP_RECV_FROM_BYTES udp_recv_from_status, udp_recv_from_len, udp_addr, 0, read_buf, 8
    EXPAND NET_UDP_PEEK_FROM_BYTES udp_peek_from_status, udp_peek_from_len, udp_addr2, 0, read_buf, 8
    [END_IF]
    return 0
