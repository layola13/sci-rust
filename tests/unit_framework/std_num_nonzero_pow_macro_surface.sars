@import "sa_std/num.sars"

@test "sa_std nonzero checked and saturating pow macro surface"():
L_ENTRY:
    u8_base = stack_alloc NonZeroU8_SIZE
    u8_checked = stack_alloc NonZeroU8_SIZE
    u8_sat = stack_alloc NonZeroU8_SIZE
    u8_over_base = stack_alloc NonZeroU8_SIZE
    u8_over = stack_alloc NonZeroU8_SIZE
    u16_base = stack_alloc NonZeroU16_SIZE
    u16_checked = stack_alloc NonZeroU16_SIZE
    u16_sat = stack_alloc NonZeroU16_SIZE
    u32_base = stack_alloc NonZeroU32_SIZE
    u32_checked = stack_alloc NonZeroU32_SIZE
    u32_sat = stack_alloc NonZeroU32_SIZE
    u64_base = stack_alloc NonZeroU64_SIZE
    u64_checked = stack_alloc NonZeroU64_SIZE
    u64_sat = stack_alloc NonZeroU64_SIZE
    usize_base = stack_alloc NonZeroUsize_SIZE
    usize_checked = stack_alloc NonZeroUsize_SIZE
    usize_sat = stack_alloc NonZeroUsize_SIZE
    i8_base = stack_alloc NonZeroI8_SIZE
    i8_checked = stack_alloc NonZeroI8_SIZE
    i8_sat = stack_alloc NonZeroI8_SIZE
    i8_over_base = stack_alloc NonZeroI8_SIZE
    i8_over = stack_alloc NonZeroI8_SIZE
    i16_base = stack_alloc NonZeroI16_SIZE
    i16_checked = stack_alloc NonZeroI16_SIZE
    i16_sat = stack_alloc NonZeroI16_SIZE
    i32_base = stack_alloc NonZeroI32_SIZE
    i32_checked = stack_alloc NonZeroI32_SIZE
    i32_sat = stack_alloc NonZeroI32_SIZE
    i64_base = stack_alloc NonZeroI64_SIZE
    i64_checked = stack_alloc NonZeroI64_SIZE
    i64_sat = stack_alloc NonZeroI64_SIZE
    isize_base = stack_alloc NonZeroIsize_SIZE
    isize_checked = stack_alloc NonZeroIsize_SIZE
    isize_sat = stack_alloc NonZeroIsize_SIZE

    EXPAND NONZERO_U8_NEW ok_u8_base, u8_base, 3
    EXPAND NONZERO_U8_NEW ok_u8_over_base, u8_over_base, 20
    EXPAND NONZERO_U16_NEW ok_u16_base, u16_base, 10
    EXPAND NONZERO_U32_NEW ok_u32_base, u32_base, 2
    EXPAND NONZERO_U64_NEW ok_u64_base, u64_base, 3
    EXPAND NONZERO_USIZE_NEW ok_usize_base, usize_base, NUM_U64_MAX
    EXPAND NONZERO_I8_NEW ok_i8_base, i8_base, -3
    EXPAND NONZERO_I8_NEW ok_i8_over_base, i8_over_base, 16
    EXPAND NONZERO_I16_NEW ok_i16_base, i16_base, 10
    EXPAND NONZERO_I32_NEW ok_i32_base, i32_base, 50000
    EXPAND NONZERO_I64_NEW ok_i64_base, i64_base, NUM_I64_MIN
    EXPAND NONZERO_ISIZE_NEW ok_isize_base, isize_base, NUM_I64_MIN

    EXPAND NONZERO_U8_CHECKED_POW ok_u8_checked, u8_checked, u8_base, 4
    EXPAND NONZERO_U8_CHECKED_POW ok_u8_over, u8_over, u8_over_base, 2
    EXPAND NONZERO_U8_SATURATING_POW u8_sat, u8_base, 6
    EXPAND NONZERO_U16_CHECKED_POW ok_u16_checked, u16_checked, u16_base, 4
    EXPAND NONZERO_U16_SATURATING_POW u16_sat, u16_base, 5
    EXPAND NONZERO_U32_CHECKED_POW ok_u32_checked, u32_checked, u32_base, 31
    EXPAND NONZERO_U32_SATURATING_POW u32_sat, u32_base, 32
    EXPAND NONZERO_U64_CHECKED_POW ok_u64_checked, u64_checked, u64_base, 4
    EXPAND NONZERO_U64_SATURATING_POW u64_sat, u64_base, 41
    EXPAND NONZERO_USIZE_CHECKED_POW ok_usize_checked, usize_checked, usize_base, 1
    EXPAND NONZERO_USIZE_SATURATING_POW usize_sat, usize_base, 2
    EXPAND NONZERO_I8_CHECKED_POW ok_i8_checked, i8_checked, i8_base, 3
    EXPAND NONZERO_I8_CHECKED_POW ok_i8_over, i8_over, i8_over_base, 2
    EXPAND NONZERO_I8_SATURATING_POW i8_sat, i8_base, 5
    EXPAND NONZERO_I16_CHECKED_POW ok_i16_checked, i16_checked, i16_base, 4
    EXPAND NONZERO_I16_SATURATING_POW i16_sat, i16_base, 5
    EXPAND NONZERO_I32_CHECKED_POW ok_i32_checked, i32_checked, i32_base, 1
    EXPAND NONZERO_I32_SATURATING_POW i32_sat, i32_base, 2
    EXPAND NONZERO_I64_CHECKED_POW ok_i64_checked, i64_checked, i64_base, 1
    EXPAND NONZERO_I64_SATURATING_POW i64_sat, i64_base, 2
    EXPAND NONZERO_ISIZE_CHECKED_POW ok_isize_checked, isize_checked, isize_base, 1
    EXPAND NONZERO_ISIZE_SATURATING_POW isize_sat, isize_base, 2

    EXPAND NONZERO_U8_GET u8_checked_value, u8_checked
    EXPAND NONZERO_U8_GET u8_sat_value, u8_sat
    EXPAND NONZERO_U16_GET u16_checked_value, u16_checked
    EXPAND NONZERO_U16_GET u16_sat_value, u16_sat
    EXPAND NONZERO_U32_GET u32_checked_value, u32_checked
    EXPAND NONZERO_U32_GET u32_sat_value, u32_sat
    EXPAND NONZERO_U64_GET u64_checked_value, u64_checked
    EXPAND NONZERO_U64_GET u64_sat_value, u64_sat
    EXPAND NONZERO_USIZE_GET usize_checked_value, usize_checked
    EXPAND NONZERO_USIZE_GET usize_sat_value, usize_sat
    EXPAND NONZERO_I8_GET i8_checked_value, i8_checked
    EXPAND NONZERO_I8_GET i8_sat_value, i8_sat
    EXPAND NONZERO_I16_GET i16_checked_value, i16_checked
    EXPAND NONZERO_I16_GET i16_sat_value, i16_sat
    EXPAND NONZERO_I32_GET i32_checked_value, i32_checked
    EXPAND NONZERO_I32_GET i32_sat_value, i32_sat
    EXPAND NONZERO_I64_GET i64_checked_value, i64_checked
    EXPAND NONZERO_I64_GET i64_sat_value, i64_sat
    EXPAND NONZERO_ISIZE_GET isize_checked_value, isize_checked
    EXPAND NONZERO_ISIZE_GET isize_sat_value, isize_sat

    ok_new_01 = and ok_u8_base, ok_u8_over_base
    ok_new_02 = and ok_new_01, ok_u16_base
    ok_new_03 = and ok_new_02, ok_u32_base
    ok_new_04 = and ok_new_03, ok_u64_base
    ok_new_05 = and ok_new_04, ok_usize_base
    ok_new_06 = and ok_new_05, ok_i8_base
    ok_new_07 = and ok_new_06, ok_i8_over_base
    ok_new_08 = and ok_new_07, ok_i16_base
    ok_new_09 = and ok_new_08, ok_i32_base
    ok_new_10 = and ok_new_09, ok_i64_base
    ok_new_all = and ok_new_10, ok_isize_base

    ok_checked_01 = and ok_u8_checked, ok_u16_checked
    ok_checked_02 = and ok_checked_01, ok_u32_checked
    ok_checked_03 = and ok_checked_02, ok_u64_checked
    ok_checked_04 = and ok_checked_03, ok_usize_checked
    ok_checked_05 = and ok_checked_04, ok_i8_checked
    ok_checked_06 = and ok_checked_05, ok_i16_checked
    ok_checked_07 = and ok_checked_06, ok_i32_checked
    ok_checked_08 = and ok_checked_07, ok_i64_checked
    ok_checked_success = and ok_checked_08, ok_isize_checked
    ok_u8_overflow = eq ok_u8_over, 0
    ok_i8_overflow = eq ok_i8_over, 0

    ok_u8_checked_value = eq u8_checked_value, 81
    ok_u8_sat_value = eq u8_sat_value, NUM_U8_MAX
    ok_u16_checked_value = eq u16_checked_value, 10000
    ok_u16_sat_value = eq u16_sat_value, NUM_U16_MAX
    ok_u32_checked_value = eq u32_checked_value, 2147483648
    ok_u32_sat_value = eq u32_sat_value, NUM_U32_MAX
    ok_u64_checked_value = eq u64_checked_value, 81
    ok_u64_sat_value = eq u64_sat_value, NUM_U64_MAX
    ok_usize_checked_value = eq usize_checked_value, NUM_U64_MAX
    ok_usize_sat_value = eq usize_sat_value, NUM_U64_MAX
    ok_i8_checked_value = eq i8_checked_value, -27
    ok_i8_sat_value = eq i8_sat_value, NUM_I8_MIN
    ok_i16_checked_value = eq i16_checked_value, 10000
    ok_i16_sat_value = eq i16_sat_value, NUM_I16_MAX
    ok_i32_checked_value = eq i32_checked_value, 50000
    ok_i32_sat_value = eq i32_sat_value, NUM_I32_MAX
    ok_i64_checked_value = eq i64_checked_value, NUM_I64_MIN
    ok_i64_sat_value = eq i64_sat_value, NUM_I64_MAX
    ok_isize_checked_value = eq isize_checked_value, NUM_I64_MIN
    ok_isize_sat_value = eq isize_sat_value, NUM_I64_MAX

    ok_value_01 = and ok_new_all, ok_checked_success
    ok_value_02 = and ok_value_01, ok_u8_overflow
    ok_value_03 = and ok_value_02, ok_i8_overflow
    ok_value_04 = and ok_value_03, ok_u8_checked_value
    ok_value_05 = and ok_value_04, ok_u8_sat_value
    ok_value_06 = and ok_value_05, ok_u16_checked_value
    ok_value_07 = and ok_value_06, ok_u16_sat_value
    ok_value_08 = and ok_value_07, ok_u32_checked_value
    ok_value_09 = and ok_value_08, ok_u32_sat_value
    ok_value_10 = and ok_value_09, ok_u64_checked_value
    ok_value_11 = and ok_value_10, ok_u64_sat_value
    ok_value_12 = and ok_value_11, ok_usize_checked_value
    ok_value_13 = and ok_value_12, ok_usize_sat_value
    ok_value_14 = and ok_value_13, ok_i8_checked_value
    ok_value_15 = and ok_value_14, ok_i8_sat_value
    ok_value_16 = and ok_value_15, ok_i16_checked_value
    ok_value_17 = and ok_value_16, ok_i16_sat_value
    ok_value_18 = and ok_value_17, ok_i32_checked_value
    ok_value_19 = and ok_value_18, ok_i32_sat_value
    ok_value_20 = and ok_value_19, ok_i64_checked_value
    ok_value_21 = and ok_value_20, ok_i64_sat_value
    ok_value_22 = and ok_value_21, ok_isize_checked_value
    ok = and ok_value_22, ok_isize_sat_value
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10615)

L_PASS:
    !ok
    return 0
