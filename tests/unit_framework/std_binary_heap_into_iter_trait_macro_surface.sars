@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap into_iter trait macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW heap
    EXPAND BINARY_HEAP_PUSH_U64 heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 iter, backing_vec, heap
    EXPAND BINARY_HEAP_INTO_ITER_SIZE_HINT_U64 hint_lower_initial, hint_upper_initial, iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 exact_len_initial, iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_initial, iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 first_has, first, iter
    EXPAND BINARY_HEAP_INTO_ITER_SIZE_HINT_U64 hint_lower_after_first, hint_upper_after_first, iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 exact_len_after_first, iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_BACK_U64 back_has, back, iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 exact_len_after_back, iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 last_has, last, iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_done, iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 done_has, done, iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_BACK_U64 done_back_has, done_back, iter

    EXPAND BINARY_HEAP_INTO_ITER_DEFAULT_U64 default_iter, default_backing
    EXPAND VEC_LEN default_backing_len, default_backing
    EXPAND VEC_CAPACITY default_backing_cap, default_backing
    EXPAND BINARY_HEAP_INTO_ITER_SIZE_HINT_U64 default_hint_lower, default_hint_upper, default_iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 default_exact_len, default_iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 default_empty, default_iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 default_next_has, default_next, default_iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_BACK_U64 default_back_has, default_back, default_iter

    EXPAND VEC_FREE backing_vec
    EXPAND VEC_FREE default_backing

    ok_hint_lower_initial = eq hint_lower_initial, 3
    ok_hint_upper_initial = eq hint_upper_initial, 3
    ok_exact_len_initial = eq exact_len_initial, 3
    ok_empty_initial = eq empty_initial, 0
    ok_first_has = eq first_has, 1
    ok_first = eq first, 9
    ok_hint_lower_after_first = eq hint_lower_after_first, 2
    ok_hint_upper_after_first = eq hint_upper_after_first, 2
    ok_exact_len_after_first = eq exact_len_after_first, 2
    ok_back_has = eq back_has, 1
    ok_back = eq back, 1
    ok_exact_len_after_back = eq exact_len_after_back, 1
    ok_last_has = eq last_has, 1
    ok_last = eq last, 4
    ok_empty_done = eq empty_done, 1
    ok_done_has = eq done_has, 0
    ok_done = eq done, 0
    ok_done_back_has = eq done_back_has, 0
    ok_done_back = eq done_back, 0
    ok_default_backing_len = eq default_backing_len, 0
    ok_default_backing_cap = eq default_backing_cap, 0
    ok_default_hint_lower = eq default_hint_lower, 0
    ok_default_hint_upper = eq default_hint_upper, 0
    ok_default_exact_len = eq default_exact_len, 0
    ok_default_empty = eq default_empty, 1
    ok_default_next_has = eq default_next_has, 0
    ok_default_next = eq default_next, 0
    ok_default_back_has = eq default_back_has, 0
    ok_default_back = eq default_back, 0

    ok = and ok_hint_lower_initial, ok_hint_upper_initial
    ok = and ok, ok_exact_len_initial
    ok = and ok, ok_empty_initial
    ok = and ok, ok_first_has
    ok = and ok, ok_first
    ok = and ok, ok_hint_lower_after_first
    ok = and ok, ok_hint_upper_after_first
    ok = and ok, ok_exact_len_after_first
    ok = and ok, ok_back_has
    ok = and ok, ok_back
    ok = and ok, ok_exact_len_after_back
    ok = and ok, ok_last_has
    ok = and ok, ok_last
    ok = and ok, ok_empty_done
    ok = and ok, ok_done_has
    ok = and ok, ok_done
    ok = and ok, ok_done_back_has
    ok = and ok, ok_done_back
    ok = and ok, ok_default_backing_len
    ok = and ok, ok_default_backing_cap
    ok = and ok, ok_default_hint_lower
    ok = and ok, ok_default_hint_upper
    ok = and ok, ok_default_exact_len
    ok = and ok, ok_default_empty
    ok = and ok, ok_default_next_has
    ok = and ok, ok_default_next
    ok = and ok, ok_default_back_has
    ok = and ok, ok_default_back

    !hint_lower_initial
    !hint_upper_initial
    !exact_len_initial
    !empty_initial
    !first_has
    !first
    !hint_lower_after_first
    !hint_upper_after_first
    !exact_len_after_first
    !back_has
    !back
    !exact_len_after_back
    !last_has
    !last
    !empty_done
    !done_has
    !done
    !done_back_has
    !done_back
    !default_backing_len
    !default_backing_cap
    !default_hint_lower
    !default_hint_upper
    !default_exact_len
    !default_empty
    !default_next_has
    !default_next
    !default_back_has
    !default_back
    !ok_hint_lower_initial
    !ok_hint_upper_initial
    !ok_exact_len_initial
    !ok_empty_initial
    !ok_first_has
    !ok_first
    !ok_hint_lower_after_first
    !ok_hint_upper_after_first
    !ok_exact_len_after_first
    !ok_back_has
    !ok_back
    !ok_exact_len_after_back
    !ok_last_has
    !ok_last
    !ok_empty_done
    !ok_done_has
    !ok_done
    !ok_done_back_has
    !ok_done_back
    !ok_default_backing_len
    !ok_default_backing_cap
    !ok_default_hint_lower
    !ok_default_hint_upper
    !ok_default_exact_len
    !ok_default_empty
    !ok_default_next_has
    !ok_default_next
    !ok_default_back_has
    !ok_default_back
    !iter
    !default_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_TRAIT_OK, L_BINARY_HEAP_INTO_ITER_TRAIT_FAIL

L_BINARY_HEAP_INTO_ITER_TRAIT_FAIL:
    !ok
    panic(10729)

L_BINARY_HEAP_INTO_ITER_TRAIT_OK:
    !ok
    return
