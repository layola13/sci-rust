@import "sa_std/path.sars"
@import "sa_std/core/slice.sars"

@const P = utf8:"/a/b/c"

@test "sa_std path ancestor_at alias"():
L_ENTRY:
    EXPAND STR_FROM_PARTS path, &P, 6
    EXPAND PATH_ANCESTOR_AT ok, anc, path, 0
    EXPAND SLICE_GET_LEN ln, anc
    a = eq ok, 1
    b = ugt ln, 0
    ok_all = and a, b
    !ok
    !ln
    !a
    !b
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(10905)
