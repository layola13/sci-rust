@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap into_iter_sorted cursor ops macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW cursor_heap
    EXPAND BINARY_HEAP_PUSH_U64 cursor_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 cursor_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 cursor_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 cursor_heap, 4
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 cursor_iter, cursor_backing, cursor_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 next_has, next_value, cursor_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NTH_U64 nth_has, nth_value, cursor_iter, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 tail_has, tail_value, cursor_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 len_after_cursor, cursor_iter
    EXPAND VEC_LEN cursor_backing_len, cursor_backing

    EXPAND BINARY_HEAP_NEW last_heap
    EXPAND BINARY_HEAP_PUSH_U64 last_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 last_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 last_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 last_heap, 4
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 last_iter, last_backing, last_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_LAST_U64 last_has, last_value, last_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 last_empty, last_iter

    EXPAND BINARY_HEAP_NEW count_heap
    EXPAND BINARY_HEAP_PUSH_U64 count_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 count_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 count_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 count_heap, 4
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 count_iter, count_backing, count_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_COUNT_U64 count_value, count_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 count_empty, count_iter

    EXPAND BINARY_HEAP_NEW nth_miss_heap
    EXPAND BINARY_HEAP_PUSH_U64 nth_miss_heap, 8
    EXPAND BINARY_HEAP_PUSH_U64 nth_miss_heap, 3
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 nth_miss_iter, nth_miss_backing, nth_miss_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NTH_U64 nth_miss_has, nth_miss_value, nth_miss_iter, 9
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 nth_miss_len_after, nth_miss_iter

    EXPAND BINARY_HEAP_NEW empty_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 empty_iter, empty_backing, empty_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_LAST_U64 empty_last_has, empty_last_value, empty_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_COUNT_U64 empty_count, empty_iter

    EXPAND VEC_FREE cursor_backing
    EXPAND VEC_FREE last_backing
    EXPAND VEC_FREE count_backing
    EXPAND VEC_FREE nth_miss_backing
    EXPAND VEC_FREE empty_backing

    ok_next_has = eq next_has, 1
    ok_next_value = eq next_value, 5
    ok_nth_has = eq nth_has, 1
    ok_nth_value = eq nth_value, 3
    ok_tail_has = eq tail_has, 1
    ok_tail_value = eq tail_value, 1
    ok_len_after_cursor = eq len_after_cursor, 0
    ok_cursor_backing_len = eq cursor_backing_len, 4
    ok_last_has = eq last_has, 1
    ok_last_value = eq last_value, 1
    ok_last_empty = eq last_empty, 1
    ok_count_value = eq count_value, 4
    ok_count_empty = eq count_empty, 1
    ok_nth_miss_has = eq nth_miss_has, 0
    ok_nth_miss_value = eq nth_miss_value, 0
    ok_nth_miss_len_after = eq nth_miss_len_after, 0
    ok_empty_last_has = eq empty_last_has, 0
    ok_empty_last_value = eq empty_last_value, 0
    ok_empty_count = eq empty_count, 0

    ok = and ok_next_has, ok_next_value
    ok = and ok, ok_nth_has
    ok = and ok, ok_nth_value
    ok = and ok, ok_tail_has
    ok = and ok, ok_tail_value
    ok = and ok, ok_len_after_cursor
    ok = and ok, ok_cursor_backing_len
    ok = and ok, ok_last_has
    ok = and ok, ok_last_value
    ok = and ok, ok_last_empty
    ok = and ok, ok_count_value
    ok = and ok, ok_count_empty
    ok = and ok, ok_nth_miss_has
    ok = and ok, ok_nth_miss_value
    ok = and ok, ok_nth_miss_len_after
    ok = and ok, ok_empty_last_has
    ok = and ok, ok_empty_last_value
    ok = and ok, ok_empty_count

    !next_has
    !next_value
    !nth_has
    !nth_value
    !tail_has
    !tail_value
    !len_after_cursor
    !cursor_backing_len
    !last_has
    !last_value
    !last_empty
    !count_value
    !count_empty
    !nth_miss_has
    !nth_miss_value
    !nth_miss_len_after
    !empty_last_has
    !empty_last_value
    !empty_count
    !ok_next_has
    !ok_next_value
    !ok_nth_has
    !ok_nth_value
    !ok_tail_has
    !ok_tail_value
    !ok_len_after_cursor
    !ok_cursor_backing_len
    !ok_last_has
    !ok_last_value
    !ok_last_empty
    !ok_count_value
    !ok_count_empty
    !ok_nth_miss_has
    !ok_nth_miss_value
    !ok_nth_miss_len_after
    !ok_empty_last_has
    !ok_empty_last_value
    !ok_empty_count
    !cursor_iter
    !last_iter
    !count_iter
    !nth_miss_iter
    !empty_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_SORTED_CURSOR_OPS_OK, L_BINARY_HEAP_INTO_ITER_SORTED_CURSOR_OPS_FAIL

L_BINARY_HEAP_INTO_ITER_SORTED_CURSOR_OPS_FAIL:
    !ok
    panic(10772)

L_BINARY_HEAP_INTO_ITER_SORTED_CURSOR_OPS_OK:
    !ok
    return
