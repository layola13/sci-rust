@import "sa_std/collections/hashmap.sars"
@import "sa_std/vec.sars"

@const KEY_A = utf8:"alpha"
@const KEY_B = utf8:"bravo"
@const KEY_C = utf8:"charlie"
@const VALUE_A = utf8:"A"
@const VALUE_B = utf8:"B"
@const VALUE_C = utf8:"C"

@test "sa_std hashmap values_mut alias"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 8
    key_a = &KEY_A
    key_b = &KEY_B
    key_c = &KEY_C
    value_a = &VALUE_A
    value_b = &VALUE_B
    value_c = &VALUE_C

    EXPAND MAP_PUT map, key_a, value_a
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_PUT map, key_c, value_c
    EXPAND MAP_GET_MUT_PTR get_a_ok, a_slot, map, key_a
    EXPAND MAP_GET_MUT_PTR get_b_ok, b_slot, map, key_b
    EXPAND MAP_GET_MUT_PTR get_c_ok, c_slot, map, key_c
    a_slot_bits = bitcast a_slot as u64
    b_slot_bits = bitcast b_slot as u64
    c_slot_bits = bitcast c_slot as u64

    EXPAND MAP_VALUES_MUT value_slots, map
    EXPAND VEC_LEN value_slots_len, value_slots
    EXPAND VEC_CONTAINS_U64 has_a_slot, value_slots, a_slot_bits
    EXPAND VEC_CONTAINS_U64 has_b_slot, value_slots, b_slot_bits
    EXPAND VEC_CONTAINS_U64 has_c_slot, value_slots, c_slot_bits
    store a_slot+0, value_c as ptr
    store b_slot+0, value_a as ptr
    store c_slot+0, value_b as ptr
    EXPAND MAP_GET after_a, map, key_a
    EXPAND MAP_GET after_b, map, key_b
    EXPAND MAP_GET after_c, map, key_c
    EXPAND MAP_LEN map_len, map

    EXPAND MAP_NEW empty_map
    EXPAND MAP_VALUES_MUT empty_slots, empty_map
    EXPAND VEC_LEN empty_slots_len, empty_slots

    ok_get_a = eq get_a_ok, 1
    ok_get_b = eq get_b_ok, 1
    ok_get_c = eq get_c_ok, 1
    ok_len = eq value_slots_len, 3
    ok_has_a = eq has_a_slot, 1
    ok_has_b = eq has_b_slot, 1
    ok_has_c = eq has_c_slot, 1
    ok_after_a = eq after_a, value_c
    ok_after_b = eq after_b, value_a
    ok_after_c = eq after_c, value_b
    ok_map_len = eq map_len, 3
    ok_empty = eq empty_slots_len, 0

    ok01 = and ok_get_a, ok_get_b
    ok02 = and ok01, ok_get_c
    ok03 = and ok02, ok_len
    ok04 = and ok03, ok_has_a
    ok05 = and ok04, ok_has_b
    ok06 = and ok05, ok_has_c
    ok07 = and ok06, ok_after_a
    ok08 = and ok07, ok_after_b
    ok09 = and ok08, ok_after_c
    ok10 = and ok09, ok_map_len
    ok = and ok10, ok_empty

    !get_a_ok
    !get_b_ok
    !get_c_ok
    !a_slot
    !b_slot
    !c_slot
    !a_slot_bits
    !b_slot_bits
    !c_slot_bits
    !value_slots
    !value_slots_len
    !has_a_slot
    !has_b_slot
    !has_c_slot
    !after_a
    !after_b
    !after_c
    !map_len
    !empty_slots
    !empty_slots_len
    !ok_get_a
    !ok_get_b
    !ok_get_c
    !ok_len
    !ok_has_a
    !ok_has_b
    !ok_has_c
    !ok_after_a
    !ok_after_b
    !ok_after_c
    !ok_map_len
    !ok_empty
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !value_c
    !value_b
    !value_a
    !key_c
    !key_b
    !key_a
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND MAP_FREE empty_map
    EXPAND MAP_FREE map
    return 0

L_FAIL:
    panic(10822)
