@import "sa_std/vec_deque.sars"

@vec_deque_iter_try_collect_times_ten_lt_four(value: u64, &out_value: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_VEC_DEQUE_TRY_COLLECT_KEEP, L_VEC_DEQUE_TRY_COLLECT_STOP
L_VEC_DEQUE_TRY_COLLECT_KEEP:
    mapped = mul value, 10
    store out_value+0, mapped as u64
    !mapped
    !out_value
    !value
    return keep
L_VEC_DEQUE_TRY_COLLECT_STOP:
    !out_value
    !value
    return keep

@vec_deque_iter_try_collect_times_ten_lt_ten(value: u64, &out_value: ptr) -> u64:
L_ENTRY:
    keep = ult value, 10
    mapped = mul value, 10
    store out_value+0, mapped as u64
    !mapped
    !out_value
    !value
    return keep

@test "sa_std vec_deque iterator extended collect macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY try_all_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK try_all_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK try_all_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK try_all_deque, 3
    EXPAND VEC_DEQUE_ITER_U64 try_all_iter, try_all_backing, try_all_deque
    EXPAND VEC_DEQUE_ITER_TRY_COLLECT_U64 try_all_ok, try_all_vec, try_all_iter, @vec_deque_iter_try_collect_times_ten_lt_ten
    EXPAND VEC_LEN try_all_len, try_all_vec
    EXPAND VEC_GET_U64 try_all_0, try_all_vec, 0
    EXPAND VEC_GET_U64 try_all_2, try_all_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 try_all_empty, try_all_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY try_stop_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK try_stop_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK try_stop_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK try_stop_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK try_stop_deque, 5
    EXPAND VEC_DEQUE_ITER_U64 try_stop_iter, try_stop_backing, try_stop_deque
    EXPAND VEC_DEQUE_ITER_TRY_COLLECT_U64 try_stop_ok, try_stop_vec, try_stop_iter, @vec_deque_iter_try_collect_times_ten_lt_four
    EXPAND VEC_LEN try_stop_len, try_stop_vec
    EXPAND VEC_GET_U64 try_stop_0, try_stop_vec, 0
    EXPAND VEC_GET_U64 try_stop_1, try_stop_vec, 1
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 try_stop_remaining, try_stop_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 try_stop_next_has, try_stop_next, try_stop_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY collect_into_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK collect_into_deque, 8
    EXPAND VEC_DEQUE_PUSH_BACK collect_into_deque, 9
    EXPAND VEC_DEQUE_ITER_U64 collect_into_iter, collect_into_backing, collect_into_deque
    EXPAND VEC_NEW collect_into_dest
    EXPAND VEC_PUSH_U64 collect_into_dest, 7
    EXPAND VEC_DEQUE_ITER_COLLECT_INTO_U64 collect_into_dest, collect_into_iter
    EXPAND VEC_LEN collect_into_len, collect_into_dest
    EXPAND VEC_GET_U64 collect_into_0, collect_into_dest, 0
    EXPAND VEC_GET_U64 collect_into_2, collect_into_dest, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 collect_into_empty, collect_into_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY copied_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK copied_deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK copied_deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK copied_deque, 40
    EXPAND VEC_DEQUE_ITER_U64 copied_iter, copied_backing, copied_deque
    EXPAND VEC_DEQUE_ITER_COPIED_COLLECT_U64 copied_vec, copied_iter
    EXPAND VEC_LEN copied_len, copied_vec
    EXPAND VEC_GET_U64 copied_0, copied_vec, 0
    EXPAND VEC_GET_U64 copied_2, copied_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 copied_empty, copied_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY cloned_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK cloned_deque, 99
    EXPAND VEC_DEQUE_PUSH_BACK cloned_deque, 50
    EXPAND VEC_DEQUE_PUSH_BACK cloned_deque, 60
    EXPAND VEC_DEQUE_TRY_POP_FRONT cloned_pop_ok, cloned_pop, cloned_deque
    EXPAND VEC_DEQUE_PUSH_BACK cloned_deque, 70
    EXPAND VEC_DEQUE_ITER_U64 cloned_iter, cloned_backing, cloned_deque
    EXPAND VEC_DEQUE_ITER_CLONED_COLLECT_U64 cloned_vec, cloned_iter
    EXPAND VEC_LEN cloned_len, cloned_vec
    EXPAND VEC_GET_U64 cloned_0, cloned_vec, 0
    EXPAND VEC_GET_U64 cloned_2, cloned_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 cloned_empty, cloned_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 7
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 8
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_TRY_COLLECT_U64 into_ok, into_vec, into_iter, @vec_deque_iter_try_collect_times_ten_lt_ten
    EXPAND VEC_LEN into_len, into_vec
    EXPAND VEC_GET_U64 into_0, into_vec, 0
    EXPAND VEC_GET_U64 into_2, into_vec, 2
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_FREE try_all_backing
    EXPAND VEC_FREE try_all_vec
    EXPAND VEC_FREE try_stop_backing
    EXPAND VEC_FREE try_stop_vec
    EXPAND VEC_FREE collect_into_backing
    EXPAND VEC_FREE collect_into_dest
    EXPAND VEC_FREE copied_backing
    EXPAND VEC_FREE copied_vec
    EXPAND VEC_FREE cloned_backing
    EXPAND VEC_FREE cloned_vec
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_vec
    EXPAND VEC_DEQUE_FREE try_all_deque
    EXPAND VEC_DEQUE_FREE try_stop_deque
    EXPAND VEC_DEQUE_FREE collect_into_deque
    EXPAND VEC_DEQUE_FREE copied_deque
    EXPAND VEC_DEQUE_FREE cloned_deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq try_all_ok, 1
    check = eq try_all_len, 3
    ok = and ok, check
    check = eq try_all_0, 10
    ok = and ok, check
    check = eq try_all_2, 30
    ok = and ok, check
    check = eq try_all_empty, 1
    ok = and ok, check
    check = eq try_stop_ok, 0
    ok = and ok, check
    check = eq try_stop_len, 2
    ok = and ok, check
    check = eq try_stop_0, 10
    ok = and ok, check
    check = eq try_stop_1, 20
    ok = and ok, check
    check = eq try_stop_remaining, 1
    ok = and ok, check
    check = eq try_stop_next_has, 1
    ok = and ok, check
    check = eq try_stop_next, 5
    ok = and ok, check
    check = eq collect_into_len, 3
    ok = and ok, check
    check = eq collect_into_0, 7
    ok = and ok, check
    check = eq collect_into_2, 9
    ok = and ok, check
    check = eq collect_into_empty, 1
    ok = and ok, check
    check = eq copied_len, 3
    ok = and ok, check
    check = eq copied_0, 20
    ok = and ok, check
    check = eq copied_2, 40
    ok = and ok, check
    check = eq copied_empty, 1
    ok = and ok, check
    check = eq cloned_pop_ok, 1
    ok = and ok, check
    check = eq cloned_pop, 99
    ok = and ok, check
    check = eq cloned_len, 3
    ok = and ok, check
    check = eq cloned_0, 50
    ok = and ok, check
    check = eq cloned_2, 70
    ok = and ok, check
    check = eq cloned_empty, 1
    ok = and ok, check
    check = eq into_ok, 1
    ok = and ok, check
    check = eq into_len, 3
    ok = and ok, check
    check = eq into_0, 60
    ok = and ok, check
    check = eq into_2, 80
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check

    !try_all_ok
    !try_all_len
    !try_all_0
    !try_all_2
    !try_all_empty
    !try_stop_ok
    !try_stop_len
    !try_stop_0
    !try_stop_1
    !try_stop_remaining
    !try_stop_next_has
    !try_stop_next
    !collect_into_len
    !collect_into_0
    !collect_into_2
    !collect_into_empty
    !copied_len
    !copied_0
    !copied_2
    !copied_empty
    !cloned_pop_ok
    !cloned_pop
    !cloned_len
    !cloned_0
    !cloned_2
    !cloned_empty
    !into_ok
    !into_len
    !into_0
    !into_2
    !into_empty
    !into_deque_empty
    !check
    !try_all_iter
    !try_stop_iter
    !collect_into_iter
    !copied_iter
    !cloned_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_COLLECT_EXT_OK, L_VEC_DEQUE_ITER_COLLECT_EXT_FAIL

L_VEC_DEQUE_ITER_COLLECT_EXT_FAIL:
    !ok
    panic(10799)

L_VEC_DEQUE_ITER_COLLECT_EXT_OK:
    !ok
    return
