@import "sa_std/num.sars"

@test "sa_std narrow unsigned primitive ilog macro surface"():
L_ENTRY:
    EXPAND NUM_U8_CHECKED_ILOG u8_ilog_ok, u8_ilog_value, 255, 2
    EXPAND NUM_U8_CHECKED_ILOG u8_ilog_base_ok, u8_ilog_base_value, 255, 16
    EXPAND NUM_U8_CHECKED_ILOG u8_ilog_lt_ok, u8_ilog_lt_value, 4, 5
    EXPAND NUM_U8_CHECKED_ILOG u8_ilog_zero_value_ok, u8_ilog_zero_value, 0, 2
    EXPAND NUM_U8_CHECKED_ILOG u8_ilog_zero_base_ok, u8_ilog_zero_base_value, 5, 0
    EXPAND NUM_U8_CHECKED_ILOG u8_ilog_one_base_ok, u8_ilog_one_base_value, 5, 1
    EXPAND NUM_U8_CHECKED_ILOG u8_ilog_mask_ok, u8_ilog_mask_value, 300, 260
    EXPAND NUM_U8_ILOG u8_ilog_direct, 255, 2
    EXPAND NUM_U8_ILOG u8_ilog_direct_invalid, 0, 2
    EXPAND NUM_U8_CHECKED_ILOG2 u8_ilog2_ok, u8_ilog2_value, 128
    EXPAND NUM_U8_ILOG2 u8_ilog2_direct, 255
    EXPAND NUM_U8_CHECKED_ILOG10 u8_ilog10_ok, u8_ilog10_value, 255
    EXPAND NUM_U8_ILOG10 u8_ilog10_direct, 99

    EXPAND NUM_U16_CHECKED_ILOG u16_ilog_ok, u16_ilog_value, 65535, 2
    EXPAND NUM_U16_CHECKED_ILOG u16_ilog_base_ok, u16_ilog_base_value, 65535, 256
    EXPAND NUM_U16_CHECKED_ILOG u16_ilog_lt_ok, u16_ilog_lt_value, 4, 5
    EXPAND NUM_U16_CHECKED_ILOG u16_ilog_zero_value_ok, u16_ilog_zero_value, 0, 2
    EXPAND NUM_U16_CHECKED_ILOG u16_ilog_zero_base_ok, u16_ilog_zero_base_value, 5, 0
    EXPAND NUM_U16_CHECKED_ILOG u16_ilog_one_base_ok, u16_ilog_one_base_value, 5, 1
    EXPAND NUM_U16_CHECKED_ILOG u16_ilog_mask_ok, u16_ilog_mask_value, 70000, 65540
    EXPAND NUM_U16_ILOG u16_ilog_direct, 65535, 2
    EXPAND NUM_U16_ILOG u16_ilog_direct_invalid, 0, 2
    EXPAND NUM_U16_CHECKED_ILOG2 u16_ilog2_ok, u16_ilog2_value, 32768
    EXPAND NUM_U16_ILOG2 u16_ilog2_direct, 65535
    EXPAND NUM_U16_CHECKED_ILOG10 u16_ilog10_ok, u16_ilog10_value, 65535
    EXPAND NUM_U16_ILOG10 u16_ilog10_direct, 9999

    EXPAND NUM_U32_CHECKED_ILOG u32_ilog_ok, u32_ilog_value, 4294967295, 2
    EXPAND NUM_U32_CHECKED_ILOG u32_ilog_base_ok, u32_ilog_base_value, 4294967295, 65536
    EXPAND NUM_U32_CHECKED_ILOG u32_ilog_lt_ok, u32_ilog_lt_value, 4, 5
    EXPAND NUM_U32_CHECKED_ILOG u32_ilog_zero_value_ok, u32_ilog_zero_value, 0, 2
    EXPAND NUM_U32_CHECKED_ILOG u32_ilog_zero_base_ok, u32_ilog_zero_base_value, 5, 0
    EXPAND NUM_U32_CHECKED_ILOG u32_ilog_one_base_ok, u32_ilog_one_base_value, 5, 1
    EXPAND NUM_U32_CHECKED_ILOG u32_ilog_mask_ok, u32_ilog_mask_value, 4294967304, 4294967300
    EXPAND NUM_U32_ILOG u32_ilog_direct, 4294967295, 2
    EXPAND NUM_U32_ILOG u32_ilog_direct_invalid, 0, 2
    EXPAND NUM_U32_CHECKED_ILOG2 u32_ilog2_ok, u32_ilog2_value, 2147483648
    EXPAND NUM_U32_ILOG2 u32_ilog2_direct, 4294967295
    EXPAND NUM_U32_CHECKED_ILOG10 u32_ilog10_ok, u32_ilog10_value, 4294967295
    EXPAND NUM_U32_ILOG10 u32_ilog10_direct, 999999999

    ok01 = eq u8_ilog_ok, 1
    ok02 = eq u8_ilog_value, 7
    ok03 = eq u8_ilog_base_ok, 1
    ok04 = eq u8_ilog_base_value, 1
    ok05 = eq u8_ilog_lt_ok, 1
    ok06 = eq u8_ilog_lt_value, 0
    ok07 = eq u8_ilog_zero_value_ok, 0
    ok08 = eq u8_ilog_zero_value, 0
    ok09 = eq u8_ilog_zero_base_ok, 0
    ok10 = eq u8_ilog_zero_base_value, 0
    ok11 = eq u8_ilog_one_base_ok, 0
    ok12 = eq u8_ilog_one_base_value, 0
    ok13 = eq u8_ilog_mask_ok, 1
    ok14 = eq u8_ilog_mask_value, 2
    ok15 = eq u8_ilog_direct, 7
    ok16 = eq u8_ilog_direct_invalid, 0
    ok17 = eq u8_ilog2_ok, 1
    ok18 = eq u8_ilog2_value, 7
    ok19 = eq u8_ilog2_direct, 7
    ok20 = eq u8_ilog10_ok, 1
    ok21 = eq u8_ilog10_value, 2
    ok22 = eq u8_ilog10_direct, 1

    ok23 = eq u16_ilog_ok, 1
    ok24 = eq u16_ilog_value, 15
    ok25 = eq u16_ilog_base_ok, 1
    ok26 = eq u16_ilog_base_value, 1
    ok27 = eq u16_ilog_lt_ok, 1
    ok28 = eq u16_ilog_lt_value, 0
    ok29 = eq u16_ilog_zero_value_ok, 0
    ok30 = eq u16_ilog_zero_value, 0
    ok31 = eq u16_ilog_zero_base_ok, 0
    ok32 = eq u16_ilog_zero_base_value, 0
    ok33 = eq u16_ilog_one_base_ok, 0
    ok34 = eq u16_ilog_one_base_value, 0
    ok35 = eq u16_ilog_mask_ok, 1
    ok36 = eq u16_ilog_mask_value, 6
    ok37 = eq u16_ilog_direct, 15
    ok38 = eq u16_ilog_direct_invalid, 0
    ok39 = eq u16_ilog2_ok, 1
    ok40 = eq u16_ilog2_value, 15
    ok41 = eq u16_ilog2_direct, 15
    ok42 = eq u16_ilog10_ok, 1
    ok43 = eq u16_ilog10_value, 4
    ok44 = eq u16_ilog10_direct, 3

    ok45 = eq u32_ilog_ok, 1
    ok46 = eq u32_ilog_value, 31
    ok47 = eq u32_ilog_base_ok, 1
    ok48 = eq u32_ilog_base_value, 1
    ok49 = eq u32_ilog_lt_ok, 1
    ok50 = eq u32_ilog_lt_value, 0
    ok51 = eq u32_ilog_zero_value_ok, 0
    ok52 = eq u32_ilog_zero_value, 0
    ok53 = eq u32_ilog_zero_base_ok, 0
    ok54 = eq u32_ilog_zero_base_value, 0
    ok55 = eq u32_ilog_one_base_ok, 0
    ok56 = eq u32_ilog_one_base_value, 0
    ok57 = eq u32_ilog_mask_ok, 1
    ok58 = eq u32_ilog_mask_value, 1
    ok59 = eq u32_ilog_direct, 31
    ok60 = eq u32_ilog_direct_invalid, 0
    ok61 = eq u32_ilog2_ok, 1
    ok62 = eq u32_ilog2_value, 31
    ok63 = eq u32_ilog2_direct, 31
    ok64 = eq u32_ilog10_ok, 1
    ok65 = eq u32_ilog10_value, 9
    ok66 = eq u32_ilog10_direct, 8

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    chain22 = and chain21, ok23
    chain23 = and chain22, ok24
    chain24 = and chain23, ok25
    chain25 = and chain24, ok26
    chain26 = and chain25, ok27
    chain27 = and chain26, ok28
    chain28 = and chain27, ok29
    chain29 = and chain28, ok30
    chain30 = and chain29, ok31
    chain31 = and chain30, ok32
    chain32 = and chain31, ok33
    chain33 = and chain32, ok34
    chain34 = and chain33, ok35
    chain35 = and chain34, ok36
    chain36 = and chain35, ok37
    chain37 = and chain36, ok38
    chain38 = and chain37, ok39
    chain39 = and chain38, ok40
    chain40 = and chain39, ok41
    chain41 = and chain40, ok42
    chain42 = and chain41, ok43
    chain43 = and chain42, ok44
    chain44 = and chain43, ok45
    chain45 = and chain44, ok46
    chain46 = and chain45, ok47
    chain47 = and chain46, ok48
    chain48 = and chain47, ok49
    chain49 = and chain48, ok50
    chain50 = and chain49, ok51
    chain51 = and chain50, ok52
    chain52 = and chain51, ok53
    chain53 = and chain52, ok54
    chain54 = and chain53, ok55
    chain55 = and chain54, ok56
    chain56 = and chain55, ok57
    chain57 = and chain56, ok58
    chain58 = and chain57, ok59
    chain59 = and chain58, ok60
    chain60 = and chain59, ok61
    chain61 = and chain60, ok62
    chain62 = and chain61, ok63
    chain63 = and chain62, ok64
    chain64 = and chain63, ok65
    ok = and chain64, ok66

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10667)

L_PASS:
    !ok
    return 0
