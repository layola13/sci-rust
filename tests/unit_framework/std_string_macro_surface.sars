@test "sa_std string splitn char aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS split_hay, &SPLIT_HAY, 5
    EXPAND STR_FROM_PARTS multi_hay, &CHAR_HAY_MULTI, 6
    EXPAND STR_FROM_PARTS p0, &SPLIT_PART0, 1
    EXPAND STR_FROM_PARTS rest, &SPLIT_REST, 3
    EXPAND STR_FROM_PARTS utf8_a_e, &UTF8_A_E, 3
    EXPAND STRING_BUF_FROM_STR split_buf, split_hay
    EXPAND STRING_BUF_FROM_STR multi_buf, multi_hay

    EXPAND STR_SPLIT_N_CHAR_COUNT splitn2_count, split_hay, 58, 2
    EXPAND STRING_SPLIT_N_CHAR_COUNT splitn10_count_s, split_hay, 58, 10
    EXPAND STRING_BUF_SPLIT_N_CHAR_COUNT splitn2_count_b, split_buf, 58, 2
    EXPAND STR_RSPLIT_N_CHAR_COUNT rsplitn2_count, split_hay, 58, 2
    EXPAND STRING_RSPLIT_N_CHAR_COUNT rsplitn10_count_s, split_hay, 58, 10
    EXPAND STRING_BUF_RSPLIT_N_CHAR_COUNT rsplitn2_count_b, split_buf, 58, 2
    EXPAND STR_SPLIT_N_CHAR_COUNT zero_count, split_hay, 58, 0
    EXPAND STR_SPLIT_N_CHAR_COUNT invalid_count, split_hay, 55296, 2
    EXPAND STR_RSPLIT_N_CHAR_COUNT invalid_rcount, split_hay, 55296, 2
    EXPAND STR_SPLIT_N_CHAR_COUNT multi_count, multi_hay, 233, 2
    EXPAND STRING_BUF_RSPLIT_N_CHAR_COUNT multi_rcount_b, multi_buf, 233, 2

    EXPAND STR_TRY_SPLIT_N_CHAR_AT ok_s0, part_s0, split_hay, 58, 2, 0
    EXPAND STRING_TRY_SPLIT_N_CHAR_AT ok_s1t, part_s1t, split_hay, 58, 2, 1
    EXPAND STRING_BUF_TRY_SPLIT_N_CHAR_AT ok_s1bt, part_s1bt, split_buf, 58, 2, 1
    EXPAND STR_SPLIT_N_CHAR_AT ok_s0u, part_s0u, split_hay, 58, 2, 0
    EXPAND STRING_SPLIT_N_CHAR_AT ok_s1u, part_s1u, split_hay, 58, 2, 1
    EXPAND STRING_BUF_SPLIT_N_CHAR_AT ok_s1bu, part_s1bu, split_buf, 58, 2, 1
    EXPAND STR_TRY_SPLIT_N_CHAR_AT ok_s2, part_s2, split_hay, 58, 2, 2
    EXPAND STR_TRY_SPLIT_N_CHAR_AT ok_zero, part_zero, split_hay, 58, 0, 0

    EXPAND STR_TRY_RSPLIT_N_CHAR_AT ok_rs0, part_rs0, split_hay, 58, 2, 0
    EXPAND STRING_TRY_RSPLIT_N_CHAR_AT ok_rs1t, part_rs1t, split_hay, 58, 2, 1
    EXPAND STRING_BUF_TRY_RSPLIT_N_CHAR_AT ok_rs1bt, part_rs1bt, split_buf, 58, 2, 1
    EXPAND STR_RSPLIT_N_CHAR_AT ok_rs0u, part_rs0u, split_hay, 58, 2, 0
    EXPAND STRING_RSPLIT_N_CHAR_AT ok_rs1u, part_rs1u, split_hay, 58, 2, 1
    EXPAND STRING_BUF_RSPLIT_N_CHAR_AT ok_rs1bu, part_rs1bu, split_buf, 58, 2, 1
    EXPAND STR_TRY_RSPLIT_N_CHAR_AT ok_rs2, part_rs2, split_hay, 58, 2, 2

    EXPAND STR_TRY_SPLIT_N_CHAR_AT ok_multi0, part_multi0, multi_hay, 233, 2, 0
    EXPAND STR_SPLIT_N_CHAR_AT ok_multi1, part_multi1, multi_hay, 233, 2, 1
    EXPAND STR_TRY_RSPLIT_N_CHAR_AT ok_rmulti0, part_rmulti0, multi_hay, 233, 2, 0
    EXPAND STRING_BUF_SPLIT_N_CHAR_AT ok_multi1b, part_multi1b, multi_buf, 233, 2, 1
    EXPAND STR_TRY_SPLIT_N_CHAR_AT ok_invalid, part_invalid, split_hay, 55296, 2, 0
    EXPAND STR_TRY_RSPLIT_N_CHAR_AT ok_rinvalid, part_rinvalid, split_hay, 55296, 2, 0

    EXPAND STR_EQ eq_s0, part_s0, p0
    EXPAND STR_EQ eq_s1t, part_s1t, rest
    EXPAND STR_EQ eq_s1bt, part_s1bt, rest
    EXPAND STR_EQ eq_s0u, part_s0u, p0
    EXPAND STR_EQ eq_s1u, part_s1u, rest
    EXPAND STR_EQ eq_s1bu, part_s1bu, rest
    EXPAND STR_EQ eq_rs0, part_rs0, rest
    EXPAND STR_EQ eq_rs1t, part_rs1t, p0
    EXPAND STR_EQ eq_rs1bt, part_rs1bt, p0
    EXPAND STR_EQ eq_rs0u, part_rs0u, rest
    EXPAND STR_EQ eq_rs1u, part_rs1u, p0
    EXPAND STR_EQ eq_rs1bu, part_rs1bu, p0
    EXPAND STR_EQ eq_multi0, part_multi0, p0
    EXPAND STR_EQ eq_multi1, part_multi1, utf8_a_e
    EXPAND STR_EQ eq_rmulti0, part_rmulti0, utf8_a_e
    EXPAND STR_EQ eq_multi1b, part_multi1b, utf8_a_e
    EXPAND STR_IS_EMPTY empty_s2, part_s2
    EXPAND STR_IS_EMPTY empty_zero, part_zero
    EXPAND STR_IS_EMPTY empty_rs2, part_rs2
    EXPAND STR_IS_EMPTY empty_invalid, part_invalid
    EXPAND STR_IS_EMPTY empty_rinvalid, part_rinvalid

    splitn2_count_ok = eq splitn2_count, 2
    splitn10_count_s_ok = eq splitn10_count_s, 4
    splitn2_count_b_ok = eq splitn2_count_b, 2
    rsplitn2_count_ok = eq rsplitn2_count, 2
    rsplitn10_count_s_ok = eq rsplitn10_count_s, 4
    rsplitn2_count_b_ok = eq rsplitn2_count_b, 2
    zero_count_ok = eq zero_count, 0
    invalid_count_ok = eq invalid_count, 0
