@test "sa_std string split and matches char aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS split_hay, &CHAR_HAY_COLON_COUNT, 5
    EXPAND STR_FROM_PARTS multi_hay, &CHAR_HAY_MULTI, 6
    EXPAND STR_FROM_PARTS part_a, &MULTI_PART0, 1
    EXPAND STR_FROM_PARTS part_b, &MULTI_PART1, 1
    EXPAND STR_FROM_PARTS part_c, &MULTI_PART2, 1
    EXPAND STR_FROM_PARTS colon, &MATCHES_NEEDLE, 1
    EXPAND STR_FROM_PARTS eacute, &UTF8_E_ACUTE, 2
    EXPAND STRING_BUF_FROM_STR split_buf, split_hay
    EXPAND STRING_BUF_FROM_STR multi_buf, multi_hay

    EXPAND STR_SPLIT_CHAR_COUNT split_count, split_hay, 58
    EXPAND STRING_SPLIT_CHAR_COUNT split_count_s, split_hay, 58
    EXPAND STRING_BUF_SPLIT_CHAR_COUNT split_count_b, split_buf, 58
    EXPAND STR_RSPLIT_CHAR_COUNT rsplit_count, split_hay, 58
    EXPAND STRING_RSPLIT_CHAR_COUNT rsplit_count_s, split_hay, 58
    EXPAND STRING_BUF_RSPLIT_CHAR_COUNT rsplit_count_b, split_buf, 58
    EXPAND STR_MATCHES_CHAR_COUNT matches_count, split_hay, 58
    EXPAND STRING_MATCHES_CHAR_COUNT matches_count_s, split_hay, 58
    EXPAND STRING_BUF_MATCHES_CHAR_COUNT matches_count_b, split_buf, 58
    EXPAND STR_RMATCHES_CHAR_COUNT rmatches_count, split_hay, 58
    EXPAND STRING_RMATCHES_CHAR_COUNT rmatches_count_s, split_hay, 58
    EXPAND STRING_BUF_RMATCHES_CHAR_COUNT rmatches_count_b, split_buf, 58
    EXPAND STR_SPLIT_CHAR_COUNT multi_split_count, multi_hay, 233
    EXPAND STRING_BUF_MATCHES_CHAR_COUNT multi_matches_count, multi_buf, 233
    EXPAND STR_SPLIT_CHAR_COUNT invalid_split_count, split_hay, 55296
    EXPAND STR_MATCHES_CHAR_COUNT invalid_matches_count, split_hay, 55296

    EXPAND STR_TRY_SPLIT_CHAR_AT ok_s0, part_s0, split_hay, 58, 0
    EXPAND STRING_SPLIT_CHAR_AT ok_s1, part_s1, split_hay, 58, 1
    EXPAND STRING_BUF_TRY_SPLIT_CHAR_AT ok_s2, part_s2, split_buf, 58, 2
    EXPAND STR_SPLIT_CHAR_AT ok_s3, part_s3, split_hay, 58, 3
    EXPAND STR_TRY_RSPLIT_CHAR_AT ok_rs0, part_rs0, split_hay, 58, 0
    EXPAND STRING_RSPLIT_CHAR_AT ok_rs1, part_rs1, split_hay, 58, 1
    EXPAND STRING_BUF_TRY_RSPLIT_CHAR_AT ok_rs2, part_rs2, split_buf, 58, 2
    EXPAND STR_RSPLIT_CHAR_AT ok_rs3, part_rs3, split_hay, 58, 3
    EXPAND STR_TRY_MATCHES_CHAR_AT ok_m0, part_m0, split_hay, 58, 0
    EXPAND STRING_MATCHES_CHAR_AT ok_m1, part_m1, split_hay, 58, 1
    EXPAND STRING_BUF_TRY_MATCHES_CHAR_AT ok_m2, part_m2, split_buf, 58, 2
    EXPAND STR_TRY_RMATCHES_CHAR_AT ok_rm0, part_rm0, split_hay, 58, 0
    EXPAND STRING_RMATCHES_CHAR_AT ok_rm1, part_rm1, split_hay, 58, 1
    EXPAND STRING_BUF_TRY_RMATCHES_CHAR_AT ok_rm2, part_rm2, split_buf, 58, 2
    EXPAND STR_TRY_SPLIT_CHAR_AT ok_multi1, part_multi1, multi_hay, 233, 1
    EXPAND STR_SPLIT_CHAR_AT ok_multi2, part_multi2, multi_hay, 233, 2
    EXPAND STR_MATCHES_CHAR_AT ok_multi_match, part_multi_match, multi_hay, 233, 0
    EXPAND STR_TRY_SPLIT_CHAR_AT ok_invalid_split, part_invalid_split, split_hay, 55296, 0
    EXPAND STR_TRY_MATCHES_CHAR_AT ok_invalid_match, part_invalid_match, split_hay, 55296, 0

    EXPAND STR_EQ eq_s0, part_s0, part_a
    EXPAND STR_EQ eq_s1, part_s1, part_b
    EXPAND STR_EQ eq_s2, part_s2, part_c
    EXPAND STR_EQ eq_rs0, part_rs0, part_c
    EXPAND STR_EQ eq_rs1, part_rs1, part_b
    EXPAND STR_EQ eq_rs2, part_rs2, part_a
    EXPAND STR_EQ eq_m0, part_m0, colon
    EXPAND STR_EQ eq_m1, part_m1, colon
    EXPAND STR_EQ eq_rm0, part_rm0, colon
    EXPAND STR_EQ eq_rm1, part_rm1, colon
    EXPAND STR_EQ eq_multi1, part_multi1, part_a
    EXPAND STR_EQ eq_multi_match, part_multi_match, eacute
    EXPAND SLICE_GET_LEN part_s3_len, part_s3
    EXPAND SLICE_GET_LEN part_rs3_len, part_rs3
    EXPAND SLICE_GET_LEN part_m2_len, part_m2
    EXPAND SLICE_GET_LEN part_rm2_len, part_rm2
    EXPAND SLICE_GET_LEN part_multi2_len, part_multi2
    EXPAND SLICE_GET_LEN invalid_split_len, part_invalid_split
    EXPAND SLICE_GET_LEN invalid_match_len, part_invalid_match

    split_count_ok = eq split_count, 3
    split_count_s_ok = eq split_count_s, 3
    split_count_b_ok = eq split_count_b, 3
    rsplit_count_ok = eq rsplit_count, 3
    rsplit_count_s_ok = eq rsplit_count_s, 3
    rsplit_count_b_ok = eq rsplit_count_b, 3
    matches_count_ok = eq matches_count, 2
    matches_count_s_ok = eq matches_count_s, 2
    matches_count_b_ok = eq matches_count_b, 2
    rmatches_count_ok = eq rmatches_count, 2
    rmatches_count_s_ok = eq rmatches_count_s, 2
    rmatches_count_b_ok = eq rmatches_count_b, 2
    multi_split_count_ok = eq multi_split_count, 3
    multi_matches_count_ok = eq multi_matches_count, 2
    invalid_split_count_ok = eq invalid_split_count, 0
    invalid_matches_count_ok = eq invalid_matches_count, 0
    ok_s0_flag = eq ok_s0, 1
    ok_s1_flag = eq ok_s1, 1
    ok_s2_flag = eq ok_s2, 1
    ok_s3_flag = eq ok_s3, 0
    ok_rs0_flag = eq ok_rs0, 1
