@vec_pop_if_is_99(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 99
    !value
    return is_match

@vec_pop_if_is_88(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 88
    !value
    return is_match

@vec_retain_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@vec_resize_with_42() -> u64:
L_ENTRY:
    return 42

@vec_dedup_by_same_tens(left: u64, right: u64) -> u64:
L_ENTRY:
    left_group = udiv left, 10
    right_group = udiv right, 10
    same = eq left_group, right_group
    !left_group
    !right_group
    !left
    !right
    return same

@vec_key_tens(value: u64) -> u64:
L_ENTRY:
    key = udiv value, 10
    !value
    return key

@vec_extract_if_gt_30(value: u64) -> u64:
L_ENTRY:
    take = ugt value, 30
    !value
    return take

@string_retain_not_smile_z(codepoint: u64) -> u64:
L_ENTRY:
    is_smile = eq codepoint, 128578
    is_z = eq codepoint, 122
    drop = or is_smile, is_z
    keep = eq drop, 0
    !is_smile
    !is_z
    !drop
    !codepoint
    return keep

@string_retain_none(codepoint: u64) -> u64:
L_ENTRY:
    !codepoint
    return 0

@string_pop_if_is_t(codepoint: u64) -> u64:
L_ENTRY:
    ok = eq codepoint, 116
    !codepoint
    return ok

@string_pop_if_is_s(codepoint: u64) -> u64:
L_ENTRY:
    ok = eq codepoint, 115
    !codepoint
    return ok

@string_pop_if_byte_t(byte_value: u64) -> u64:
L_ENTRY:
    ok = eq byte_value, 116
    !byte_value
    return ok

@string_pop_if_byte_s(byte_value: u64) -> u64:
L_ENTRY:
    ok = eq byte_value, 115
    !byte_value
    return ok


@slice_partition_lt_30(value: u64) -> u64:
L_ENTRY:
    keep = ult value, 30
    !value
    return keep

@slice_sorted_le(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = ule left, right
    !left
    !right
    return ok

@slice_sorted_lt(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = ult left, right
    !left
    !right
    return ok

@slice_sorted_ge(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = uge left, right
    !left
    !right
    return ok

@slice_sorted_key_tens(value: u64) -> u64:
L_ENTRY:
    key = udiv value, 10
    !value
    return key

@slice_fill_with_77() -> u64:
L_ENTRY:
    return 77

@test "sa_std string convenience macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word, &WORD, 4
    EXPAND STR_FROM_PARTS prefix, &PREFIX, 2
    EXPAND STR_FROM_PARTS suffix, &SUFFIX, 2
    EXPAND STR_FROM_PARTS infix, &INFIX, 2
    EXPAND STR_FROM_PARTS miss, &MISS, 2
    EXPAND STRING_LEN len, word
    EXPAND STR_AS_PTR as_ptr, word
    EXPAND STRING_AS_BYTES bytes, word
    EXPAND STRING_AS_STR str_view, word
    EXPAND STR_LEN bytes_len, bytes
    EXPAND STRING_LEN str_len, str_view
    EXPAND STRING_NEW new_empty
    EXPAND STR_EMPTY str_empty
    EXPAND STRING_IS_EMPTY new_empty_ok, new_empty
    EXPAND STR_IS_EMPTY str_empty_ok, str_empty
    EXPAND STR_STARTS_WITH starts_ok, word, prefix
    EXPAND STRING_ENDS_WITH ends_ok, word, suffix
    EXPAND STR_CONTAINS contains_ok, word, infix
    EXPAND STR_FIND find_ok, find_idx, word, infix
    EXPAND STRING_RFIND rfind_ok, rfind_idx, word, infix
    EXPAND STRING_CONTAINS contains_empty_ok, word, str_empty
    EXPAND STR_STARTS_WITH starts_miss, word, miss
    EXPAND STRING_ENDS_WITH ends_miss, word, miss
    EXPAND STR_CONTAINS contains_miss, word, miss
    EXPAND STRING_FIND find_miss_ok, find_miss_idx, word, miss
    EXPAND STR_RFIND rfind_miss_ok, rfind_miss_idx, word, miss
    EXPAND STR_STRIP_PREFIX strip_prefix_ok, strip_prefix_tail, word, prefix
    EXPAND STR_STRIP_SUFFIX strip_suffix_ok, strip_suffix_head, word, suffix
    EXPAND STRING_STRIP_PREFIX strip_prefix_miss_ok, strip_prefix_miss, word, miss
    EXPAND STRING_STRIP_SUFFIX strip_suffix_miss_ok, strip_suffix_miss, word, miss
    EXPAND STR_EQ strip_prefix_tail_eq, strip_prefix_tail, suffix
    EXPAND STR_EQ strip_suffix_head_eq, strip_suffix_head, prefix
    EXPAND STR_IS_EMPTY strip_prefix_miss_empty, strip_prefix_miss
    EXPAND STR_IS_EMPTY strip_suffix_miss_empty, strip_suffix_miss
    EXPAND STRING_BUF_FROM_STR owned_word, word
    EXPAND STRING_BUF_BYTES owned_word_bytes, owned_word
    EXPAND STR_LEN owned_word_bytes_len, owned_word_bytes
    EXPAND STR_EQ owned_word_bytes_eq, owned_word_bytes, word
    EXPAND STRING_BUF_STARTS_WITH owned_starts_ok, owned_word, prefix
    EXPAND STRING_BUF_ENDS_WITH owned_ends_ok, owned_word, suffix
    EXPAND STRING_BUF_CONTAINS owned_contains_ok, owned_word, infix
    EXPAND STRING_BUF_FIND owned_find_ok, owned_find_idx, owned_word, infix
    EXPAND STRING_BUF_RFIND owned_rfind_ok, owned_rfind_idx, owned_word, infix
    EXPAND STRING_BUF_STRIP_PREFIX owned_strip_prefix_ok, owned_strip_prefix_tail, owned_word, prefix
    EXPAND STRING_BUF_STRIP_SUFFIX owned_strip_suffix_ok, owned_strip_suffix_head, owned_word, suffix
    EXPAND STR_EQ owned_strip_prefix_tail_eq, owned_strip_prefix_tail, suffix
    EXPAND STR_EQ owned_strip_suffix_head_eq, owned_strip_suffix_head, prefix

    len_ok = eq len, 4
    ptr_ok = ne as_ptr, 0
    bytes_len_ok = eq bytes_len, 4
    str_len_ok = eq str_len, 4
    starts_match_ok = eq starts_ok, 1
    ends_match_ok = eq ends_ok, 1
    contains_match_ok = eq contains_ok, 1
    find_flag_ok = eq find_ok, 1
    find_idx_ok = eq find_idx, 1
    rfind_flag_ok = eq rfind_ok, 1
    rfind_idx_ok = eq rfind_idx, 1
    contains_empty_match_ok = eq contains_empty_ok, 1
    starts_miss_ok = eq starts_miss, 0
    ends_miss_ok = eq ends_miss, 0
    contains_miss_ok = eq contains_miss, 0
    find_miss_flag_ok = eq find_miss_ok, 0
    find_miss_idx_ok = eq find_miss_idx, 0
    rfind_miss_flag_ok = eq rfind_miss_ok, 0
    rfind_miss_idx_ok = eq rfind_miss_idx, 0
    strip_prefix_flag_ok = eq strip_prefix_ok, 1
    strip_suffix_flag_ok = eq strip_suffix_ok, 1
    strip_prefix_miss_flag_ok = eq strip_prefix_miss_ok, 0
    strip_suffix_miss_flag_ok = eq strip_suffix_miss_ok, 0
    strip_prefix_tail_ok = eq strip_prefix_tail_eq, 1
    strip_suffix_head_ok = eq strip_suffix_head_eq, 1
    strip_prefix_miss_empty_ok = eq strip_prefix_miss_empty, 1
    strip_suffix_miss_empty_ok = eq strip_suffix_miss_empty, 1
    owned_word_bytes_len_ok = eq owned_word_bytes_len, 4
    owned_word_bytes_eq_ok = eq owned_word_bytes_eq, 1
    owned_starts_match_ok = eq owned_starts_ok, 1
    owned_ends_match_ok = eq owned_ends_ok, 1
    owned_contains_match_ok = eq owned_contains_ok, 1
    owned_find_flag_ok = eq owned_find_ok, 1
    owned_find_idx_ok = eq owned_find_idx, 1
    owned_rfind_flag_ok = eq owned_rfind_ok, 1
    owned_rfind_idx_ok = eq owned_rfind_idx, 1
    owned_strip_prefix_flag_ok = eq owned_strip_prefix_ok, 1
    owned_strip_suffix_flag_ok = eq owned_strip_suffix_ok, 1
    owned_strip_prefix_tail_ok = eq owned_strip_prefix_tail_eq, 1
    owned_strip_suffix_head_ok = eq owned_strip_suffix_head_eq, 1
    ok01 = and len_ok, ptr_ok
    ok02 = and ok01, bytes_len_ok
    ok03 = and ok02, str_len_ok
    ok04 = and ok03, new_empty_ok
    ok05 = and ok04, str_empty_ok
    ok06 = and ok05, starts_match_ok
    ok07 = and ok06, ends_match_ok
    ok08 = and ok07, contains_match_ok
    ok09 = and ok08, find_flag_ok
    ok10 = and ok09, find_idx_ok
    ok11 = and ok10, rfind_flag_ok
    ok12 = and ok11, rfind_idx_ok
    ok13 = and ok12, contains_empty_match_ok
    ok14 = and ok13, starts_miss_ok
    ok15 = and ok14, ends_miss_ok
    ok16 = and ok15, contains_miss_ok
    ok17 = and ok16, find_miss_flag_ok
    ok18 = and ok17, find_miss_idx_ok
    ok19 = and ok18, rfind_miss_flag_ok
    ok20 = and ok19, rfind_miss_idx_ok
    ok21 = and ok20, strip_prefix_flag_ok
    ok22 = and ok21, strip_suffix_flag_ok
    ok23 = and ok22, strip_prefix_miss_flag_ok
    ok24 = and ok23, strip_suffix_miss_flag_ok
    ok25 = and ok24, strip_prefix_tail_ok
    ok26 = and ok25, strip_suffix_head_ok
    ok27 = and ok26, strip_prefix_miss_empty_ok
    ok28 = and ok27, strip_suffix_miss_empty_ok
    ok29 = and ok28, owned_word_bytes_len_ok
    ok30 = and ok29, owned_word_bytes_eq_ok
    ok31 = and ok30, owned_starts_match_ok
    ok32 = and ok31, owned_ends_match_ok
    ok33 = and ok32, owned_contains_match_ok
    ok34 = and ok33, owned_find_flag_ok
    ok35 = and ok34, owned_find_idx_ok
    ok36 = and ok35, owned_rfind_flag_ok
    ok37 = and ok36, owned_rfind_idx_ok
    ok38 = and ok37, owned_strip_prefix_flag_ok
    ok39 = and ok38, owned_strip_suffix_flag_ok
    ok40 = and ok39, owned_strip_prefix_tail_ok
    ok = and ok40, owned_strip_suffix_head_ok
    EXPAND STRING_BUF_FREE owned_word
    !len
    !as_ptr
    !bytes
    !str_view
    !bytes_len
    !str_len
    !new_empty_ok
    !str_empty_ok
    !starts_ok
    !ends_ok
    !contains_ok
    !find_ok
    !find_idx
    !rfind_ok
    !rfind_idx
    !contains_empty_ok
    !starts_miss
    !ends_miss
    !contains_miss
    !find_miss_ok
    !find_miss_idx
    !rfind_miss_ok
    !rfind_miss_idx
    !strip_prefix_ok
    !strip_prefix_tail
    !strip_suffix_ok
    !strip_suffix_head
    !strip_prefix_miss_ok
    !strip_prefix_miss
    !strip_suffix_miss_ok
    !strip_suffix_miss
    !strip_prefix_tail_eq
    !strip_suffix_head_eq
    !strip_prefix_miss_empty
    !strip_suffix_miss_empty
    !owned_word_bytes
    !owned_word_bytes_len
    !owned_word_bytes_eq
    !owned_starts_ok
    !owned_ends_ok
    !owned_contains_ok
    !owned_find_ok
    !owned_find_idx
    !owned_rfind_ok
    !owned_rfind_idx
    !owned_strip_prefix_ok
    !owned_strip_prefix_tail
    !owned_strip_suffix_ok
    !owned_strip_suffix_head
    !owned_strip_prefix_tail_eq
    !owned_strip_suffix_head_eq
    !len_ok
    !ptr_ok
    !bytes_len_ok
    !str_len_ok
    !starts_match_ok
    !ends_match_ok
    !contains_match_ok
    !find_flag_ok
    !find_idx_ok
    !rfind_flag_ok
    !rfind_idx_ok
    !contains_empty_match_ok
    !starts_miss_ok
    !ends_miss_ok
    !contains_miss_ok
    !find_miss_flag_ok
    !find_miss_idx_ok
    !rfind_miss_flag_ok
    !rfind_miss_idx_ok
    !strip_prefix_flag_ok
    !strip_suffix_flag_ok
    !strip_prefix_miss_flag_ok
    !strip_suffix_miss_flag_ok
    !strip_prefix_tail_ok
    !strip_suffix_head_ok
    !strip_prefix_miss_empty_ok
    !strip_suffix_miss_empty_ok
    !owned_word_bytes_len_ok
    !owned_word_bytes_eq_ok
    !owned_starts_match_ok
    !owned_ends_match_ok
    !owned_contains_match_ok
    !owned_find_flag_ok
    !owned_find_idx_ok
    !owned_rfind_flag_ok
    !owned_rfind_idx_ok
    !owned_strip_prefix_flag_ok
    !owned_strip_suffix_flag_ok
    !owned_strip_prefix_tail_ok
    !owned_strip_suffix_head_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    !ok33
    !ok34
    !ok35
    !ok36
    !ok37
    !ok38
    !ok39
    !ok40
    !word
    !prefix
    !suffix
    !infix
    !miss
    !new_empty
    !str_empty
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(901)

L_OK:
    !ok
    return

@test "sa_std string as_mut_ptr aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word, &WORD, 4
    EXPAND STR_AS_PTR str_ptr, word
    EXPAND STR_AS_MUT_PTR str_mut_ptr, word
    EXPAND STRING_AS_PTR string_ptr, word
    EXPAND STRING_AS_MUT_PTR string_mut_ptr, word
    EXPAND STRING_BUF_FROM_STR owned_word, word
    EXPAND STRING_BUF_AS_MUT_STR owned_mut_view, owned_word
    EXPAND STRING_BUF_AS_MUT_PTR owned_mut_ptr, owned_word
    EXPAND STR_AS_MUT_PTR owned_view_mut_ptr, owned_mut_view

    str_mut_matches = eq str_mut_ptr, str_ptr
    string_mut_matches = eq string_mut_ptr, string_ptr
    string_matches_str = eq string_ptr, str_ptr
    owned_view_matches_buf = eq owned_view_mut_ptr, owned_mut_ptr
    owned_ptr_non_null = ne owned_mut_ptr, 0
    ok01 = and str_mut_matches, string_mut_matches
    ok02 = and ok01, string_matches_str
    ok03 = and ok02, owned_view_matches_buf
    ok = and ok03, owned_ptr_non_null
    EXPAND STRING_BUF_FREE owned_word
    !word
    !str_ptr
    !str_mut_ptr
    !string_ptr
