    ok25 = and ok24, string_unchecked_len_ok
    ok26 = and ok25, string_unchecked_mut_bad_ptr_ok
    ok = and ok26, string_unchecked_mut_bad_len_ok

    !valid_bytes
    !invalid_bytes
    !str_try_ok
    !str_try_view
    !str_ok
    !str_view
    !str_try_mut_ok
    !str_try_mut_view
