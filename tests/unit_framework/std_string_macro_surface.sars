    EXPAND STRING_BUF_FROM_STR owned_ws, ws_text
    EXPAND STRING_BUF_FROM_STR owned_only_ws, only_ws

    EXPAND STR_SPLIT_ASCII_WHITESPACE_COUNT str_count, ws_text
