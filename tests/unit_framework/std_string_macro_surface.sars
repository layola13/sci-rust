@test "sa_std string encode utf16 aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS plain_u16, &ESCAPE_PLAIN, 1
    EXPAND STR_FROM_PARTS multi_u16, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STRING_BUF_FROM_STR multi_buf_u16, multi_u16

    EXPAND STR_ENCODE_UTF16_LEN plain_len, plain_u16
    EXPAND STR_ENCODE_UTF16_LEN multi_len, multi_u16
    EXPAND STRING_ENCODE_UTF16_LEN multi_len_s, multi_u16
    EXPAND STRING_BUF_ENCODE_UTF16_LEN multi_len_b, multi_buf_u16

    EXPAND STR_ENCODE_UTF16 plain_vec, plain_u16
    EXPAND STR_ENCODE_UTF16 multi_vec, multi_u16
    EXPAND STRING_ENCODE_UTF16 multi_vec_s, multi_u16
    EXPAND STRING_BUF_ENCODE_UTF16 multi_vec_b, multi_buf_u16

    EXPAND VEC_LEN plain_vec_len, plain_vec
    EXPAND VEC_LEN multi_vec_len, multi_vec
    EXPAND VEC_LEN multi_vec_s_len, multi_vec_s
    EXPAND VEC_LEN multi_vec_b_len, multi_vec_b
    EXPAND VEC_AS_PTR plain_ptr, plain_vec
    EXPAND VEC_AS_PTR multi_ptr, multi_vec
    EXPAND VEC_AS_PTR multi_ptr_s, multi_vec_s
    EXPAND VEC_AS_PTR multi_ptr_b, multi_vec_b

    plain0 = load plain_ptr+0 as u16
    multi0 = load multi_ptr+0 as u16
    multi1 = load multi_ptr+2 as u16
    multi2 = load multi_ptr+4 as u16
    multi3 = load multi_ptr+6 as u16
    multi4 = load multi_ptr+8 as u16
    multi_s0 = load multi_ptr_s+0 as u16
    multi_s4 = load multi_ptr_s+8 as u16
    multi_b0 = load multi_ptr_b+0 as u16
    multi_b2 = load multi_ptr_b+4 as u16
    multi_b4 = load multi_ptr_b+8 as u16

    plain_len_ok = eq plain_len, 1
    multi_len_ok = eq multi_len, 5
    multi_len_s_ok = eq multi_len_s, 5
    multi_len_b_ok = eq multi_len_b, 5
    plain_vec_len_ok = eq plain_vec_len, 1
    multi_vec_len_ok = eq multi_vec_len, 5
    multi_vec_s_len_ok = eq multi_vec_s_len, 5
    multi_vec_b_len_ok = eq multi_vec_b_len, 5
    plain0_ok = eq plain0, 65
    multi0_ok = eq multi0, 97
    multi1_ok = eq multi1, 233
    multi2_ok = eq multi2, 55357
    multi3_ok = eq multi3, 56898
    multi4_ok = eq multi4, 122
    multi_s0_ok = eq multi_s0, 97
    multi_s4_ok = eq multi_s4, 122
    multi_b0_ok = eq multi_b0, 97
    multi_b2_ok = eq multi_b2, 55357
    multi_b4_ok = eq multi_b4, 122

    ok = and plain_len_ok, multi_len_ok
    ok = and ok, multi_len_s_ok
    ok = and ok, multi_len_b_ok
    ok = and ok, plain_vec_len_ok
    ok = and ok, multi_vec_len_ok
    ok = and ok, multi_vec_s_len_ok
    ok = and ok, multi_vec_b_len_ok
    ok = and ok, plain0_ok
    ok = and ok, multi0_ok
    ok = and ok, multi1_ok
    ok = and ok, multi2_ok
    ok = and ok, multi3_ok
    ok = and ok, multi4_ok
    ok = and ok, multi_s0_ok
    ok = and ok, multi_s4_ok
    ok = and ok, multi_b0_ok
    ok = and ok, multi_b2_ok
    ok = and ok, multi_b4_ok

    EXPAND VEC_FREE plain_vec
    EXPAND VEC_FREE multi_vec
    EXPAND VEC_FREE multi_vec_s
    EXPAND VEC_FREE multi_vec_b
    EXPAND STRING_BUF_FREE multi_buf_u16
    !plain_u16
    !multi_u16
    !plain_len
    !multi_len
    !multi_len_s
    !multi_len_b
    !plain_vec_len
    !multi_vec_len
    !multi_vec_s_len
    !multi_vec_b_len
    !plain_ptr
    !multi_ptr
    !multi_ptr_s
    !multi_ptr_b
    !plain0
    !multi0
    !multi1
    !multi2
    !multi3
    !multi4
    !multi_s0
    !multi_s4
    !multi_b0
    !multi_b2
    !multi_b4
    !plain_len_ok
    !multi_len_ok
    !multi_len_s_ok
    !multi_len_b_ok
    !plain_vec_len_ok
    !multi_vec_len_ok
    !multi_vec_s_len_ok
    !multi_vec_b_len_ok
    !plain0_ok
    !multi0_ok
    !multi1_ok
    !multi2_ok
    !multi3_ok
    !multi4_ok
    !multi_s0_ok
    !multi_s4_ok
    !multi_b0_ok
    !multi_b2_ok
    !multi_b4_ok
    br ok -> L_STR_ENCODE_UTF16_OK, L_STR_ENCODE_UTF16_FAIL

L_STR_ENCODE_UTF16_FAIL:
    !ok
    panic(1113)

L_STR_ENCODE_UTF16_OK:
    !ok
    return

@test "sa_std string utf8 chunks aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS valid_chunk_src, &ESCAPE_PLAIN, 1
    bad_data = stack_alloc 4
    store bad_data+0, 65 as u8
    store bad_data+1, 255 as u8
    store bad_data+2, 66 as u8
    store bad_data+3, 67 as u8
    EXPAND STR_FROM_PARTS mixed_chunk_src, bad_data, 4
    EXPAND STRING_BUF_FROM_STR mixed_chunk_buf, mixed_chunk_src

    EXPAND STR_UTF8_CHUNKS_COUNT valid_count, valid_chunk_src
    EXPAND STR_UTF8_CHUNKS_COUNT mixed_count, mixed_chunk_src
    EXPAND STRING_UTF8_CHUNKS_COUNT mixed_count_s, mixed_chunk_src
    EXPAND STRING_BUF_UTF8_CHUNKS_COUNT mixed_count_b, mixed_chunk_buf

    EXPAND STR_TRY_UTF8_CHUNK_AT ok0, valid0, chunk0, mixed_chunk_src, 0
    EXPAND STR_TRY_UTF8_CHUNK_AT ok1, valid1, chunk1, mixed_chunk_src, 1
    EXPAND STR_TRY_UTF8_CHUNK_AT ok2, valid2, chunk2, mixed_chunk_src, 2
    EXPAND STR_TRY_UTF8_CHUNK_AT ok3, valid3, chunk3, mixed_chunk_src, 3
    EXPAND STRING_TRY_UTF8_CHUNK_AT ok1s, valid1s, chunk1s, mixed_chunk_src, 1
    EXPAND STRING_BUF_TRY_UTF8_CHUNK_AT ok2b, valid2b, chunk2b, mixed_chunk_buf, 2
    EXPAND STR_UTF8_CHUNK_AT ok0u, valid0u, chunk0u, mixed_chunk_src, 0

    EXPAND STR_LEN chunk0_len, chunk0
    EXPAND STR_LEN chunk1_len, chunk1
    EXPAND STR_LEN chunk2_len, chunk2
    EXPAND STR_LEN chunk1s_len, chunk1s
    EXPAND STR_LEN chunk2b_len, chunk2b
    EXPAND STR_AS_PTR chunk0_ptr, chunk0
    EXPAND STR_AS_PTR chunk1_ptr, chunk1
    EXPAND STR_AS_PTR chunk2_ptr, chunk2
    chunk0_b0 = load chunk0_ptr+0 as u8
    chunk1_b0 = load chunk1_ptr+0 as u8
    chunk2_b0 = load chunk2_ptr+0 as u8
    chunk2_b1 = load chunk2_ptr+1 as u8

    valid_count_ok = eq valid_count, 1
    mixed_count_ok = eq mixed_count, 3
    mixed_count_s_ok = eq mixed_count_s, 3
    mixed_count_b_ok = eq mixed_count_b, 3
    ok0_flag = eq ok0, 1
    ok1_flag = eq ok1, 1
    ok2_flag = eq ok2, 1
    ok3_flag = eq ok3, 0
    ok1s_flag = eq ok1s, 1
    ok2b_flag = eq ok2b, 1
    ok0u_flag = eq ok0u, 1
    valid0_flag = eq valid0, 1
    valid1_flag = eq valid1, 0
    valid2_flag = eq valid2, 1
    valid3_flag = eq valid3, 0
    valid1s_flag = eq valid1s, 0
    valid2b_flag = eq valid2b, 1
    valid0u_flag = eq valid0u, 1
    chunk0_len_ok = eq chunk0_len, 1
    chunk1_len_ok = eq chunk1_len, 1
    chunk2_len_ok = eq chunk2_len, 2
    chunk1s_len_ok = eq chunk1s_len, 1
    chunk2b_len_ok = eq chunk2b_len, 2
    chunk0_b0_ok = eq chunk0_b0, 65
    chunk1_b0_ok = eq chunk1_b0, 255
    chunk2_b0_ok = eq chunk2_b0, 66
    chunk2_b1_ok = eq chunk2_b1, 67

    ok = and valid_count_ok, mixed_count_ok
    ok = and ok, mixed_count_s_ok
    ok = and ok, mixed_count_b_ok
    ok = and ok, ok0_flag
    ok = and ok, ok1_flag
    ok = and ok, ok2_flag
    ok = and ok, ok3_flag
    ok = and ok, ok1s_flag
    ok = and ok, ok2b_flag
    ok = and ok, ok0u_flag
    ok = and ok, valid0_flag
    ok = and ok, valid1_flag
    ok = and ok, valid2_flag
    ok = and ok, valid3_flag
    ok = and ok, valid1s_flag
    ok = and ok, valid2b_flag
    ok = and ok, valid0u_flag
    ok = and ok, chunk0_len_ok
    ok = and ok, chunk1_len_ok
    ok = and ok, chunk2_len_ok
    ok = and ok, chunk1s_len_ok
    ok = and ok, chunk2b_len_ok
    ok = and ok, chunk0_b0_ok
    ok = and ok, chunk1_b0_ok
    ok = and ok, chunk2_b0_ok
    ok = and ok, chunk2_b1_ok

    EXPAND STRING_BUF_FREE mixed_chunk_buf
    !valid_chunk_src
    !mixed_chunk_src
    !valid_count
    !mixed_count
    !mixed_count_s
    !mixed_count_b
    !ok0
    !valid0
    !chunk0
    !ok1
    !valid1
    !chunk1
    !ok2
    !valid2
    !chunk2
    !ok3
    !valid3
    !chunk3
    !ok1s
    !valid1s
    !chunk1s
    !ok2b
    !valid2b
    !chunk2b
    !ok0u
    !valid0u
    !chunk0u
    !chunk0_len
    !chunk1_len
    !chunk2_len
    !chunk1s_len
    !chunk2b_len
    !chunk0_ptr
    !chunk1_ptr
    !chunk2_ptr
    !chunk0_b0
    !chunk1_b0
    !chunk2_b0
    !chunk2_b1
    !valid_count_ok
    !mixed_count_ok
    !mixed_count_s_ok
    !mixed_count_b_ok
    !ok0_flag
    !ok1_flag
    !ok2_flag
    !ok3_flag
    !ok1s_flag
    !ok2b_flag
    !ok0u_flag
    !valid0_flag
    !valid1_flag
    !valid2_flag
    !valid3_flag
    !valid1s_flag
    !valid2b_flag
    !valid0u_flag
    !chunk0_len_ok
    !chunk1_len_ok
    !chunk2_len_ok
    !chunk1s_len_ok
    !chunk2b_len_ok
    !chunk0_b0_ok
    !chunk1_b0_ok
    !chunk2_b0_ok
    !chunk2_b1_ok
    br ok -> L_STR_UTF8_CHUNKS_OK, L_STR_UTF8_CHUNKS_FAIL

L_STR_UTF8_CHUNKS_FAIL:
    !ok
    panic(1114)

L_STR_UTF8_CHUNKS_OK:
    !ok
    return


@test "sa_std string escape debug aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS plain_dbg, &ESCAPE_PLAIN, 1
    hay6 = stack_alloc 6
    store hay6+0, 65 as u8
    store hay6+1, 34 as u8
    store hay6+2, 10 as u8
    store hay6+3, 226 as u8
    store hay6+4, 157 as u8
    store hay6+5, 164 as u8
    EXPAND STR_FROM_PARTS hay_dbg, hay6, 6
    EXPAND STRING_BUF_FROM_STR hay_buf_dbg, hay_dbg

    EXPAND STR_ESCAPE_DEBUG dbg_owned, hay_dbg
    EXPAND STRING_ESCAPE_DEBUG dbg_owned_s, hay_dbg
    EXPAND STRING_BUF_ESCAPE_DEBUG dbg_owned_b, hay_buf_dbg
    EXPAND STR_ESCAPE_DEBUG plain_owned, plain_dbg

    EXPAND STRING_BUF_AS_STR dbg_view, dbg_owned
    EXPAND STRING_BUF_AS_STR dbg_view_s, dbg_owned_s
    EXPAND STRING_BUF_AS_STR dbg_view_b, dbg_owned_b
    EXPAND STRING_BUF_AS_STR plain_view, plain_owned

    EXPAND STRING_BUF_LEN dbg_len, dbg_owned
    EXPAND STRING_BUF_LEN plain_len, plain_owned
    EXPAND STRING_BUF_AS_PTR dbg_ptr, dbg_owned
    EXPAND STRING_BUF_AS_PTR plain_ptr, plain_owned

    d0 = load dbg_ptr+0 as u8
    d1 = load dbg_ptr+1 as u8
    d2 = load dbg_ptr+2 as u8
    d3 = load dbg_ptr+3 as u8
    d4 = load dbg_ptr+4 as u8
    d5 = load dbg_ptr+5 as u8
    d6 = load dbg_ptr+6 as u8
    d7 = load dbg_ptr+7 as u8
    plain0 = load plain_ptr+0 as u8

    EXPAND STR_EQ dbg_eq_s, dbg_view, dbg_view_s
    EXPAND STR_EQ dbg_eq_b, dbg_view, dbg_view_b

    dbg_len_ok = eq dbg_len, 8
    plain_len_ok = eq plain_len, 1
    d0_ok = eq d0, 65
    d1_ok = eq d1, 92
    d2_ok = eq d2, 34
    d3_ok = eq d3, 92
    d4_ok = eq d4, 110
    d5_ok = eq d5, 226
    d6_ok = eq d6, 157
    d7_ok = eq d7, 164
    plain0_ok = eq plain0, 65
    dbg_eq_s_ok = eq dbg_eq_s, 1
    dbg_eq_b_ok = eq dbg_eq_b, 1

    ok = and dbg_len_ok, plain_len_ok
    ok = and ok, d0_ok
    ok = and ok, d1_ok
    ok = and ok, d2_ok
    ok = and ok, d3_ok
    ok = and ok, d4_ok
    ok = and ok, d5_ok
    ok = and ok, d6_ok
    ok = and ok, d7_ok
    ok = and ok, plain0_ok
    ok = and ok, dbg_eq_s_ok
    ok = and ok, dbg_eq_b_ok

    EXPAND STRING_BUF_FREE dbg_owned
    EXPAND STRING_BUF_FREE dbg_owned_s
    EXPAND STRING_BUF_FREE dbg_owned_b
    EXPAND STRING_BUF_FREE plain_owned
    EXPAND STRING_BUF_FREE hay_buf_dbg
    !plain_dbg
    !hay_dbg
    !dbg_view
    !dbg_view_s
    !dbg_view_b
    !plain_view
    !dbg_len
    !plain_len
    !dbg_ptr
    !plain_ptr
    !d0
    !d1
    !d2
    !d3
    !d4
    !d5
    !d6
    !d7
    !plain0
    !dbg_eq_s
    !dbg_eq_b
    !dbg_len_ok
    !plain_len_ok
    !d0_ok
    !d1_ok
    !d2_ok
    !d3_ok
    !d4_ok
    !d5_ok
    !d6_ok
    !d7_ok
    !plain0_ok
    !dbg_eq_s_ok
    !dbg_eq_b_ok
    br ok -> L_STR_ESCAPE_DEBUG_OK, L_STR_ESCAPE_DEBUG_FAIL

L_STR_ESCAPE_DEBUG_FAIL:
    !ok
    panic(10311)

L_STR_ESCAPE_DEBUG_OK:
    !ok
    return

@test "sa_std string substr range aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS hay_sub, &WORD, 4
    EXPAND STRING_BUF_FROM_STR hay_buf_sub, hay_sub
    EXPAND STRING_BUF_AS_STR hay_view_b, hay_buf_sub

    EXPAND STR_TRY_GET_RANGE mid_ok, mid_sub, hay_sub, 1, 2
    EXPAND STR_TRY_GET_RANGE prefix_ok, prefix_sub, hay_sub, 0, 2
    EXPAND STR_TRY_GET_RANGE full_ok, full_sub, hay_sub, 0, 4
    EXPAND STR_TRY_GET_RANGE mid_ok_b, mid_sub_b, hay_view_b, 1, 2
    EXPAND STR_TRY_GET_RANGE full_ok_b, full_sub_b, hay_view_b, 0, 4
    EXPAND STR_FROM_PARTS other_sub, &MISS, 2

    EXPAND STR_TRY_SUBSTR_RANGE ok_mid, start_mid, end_mid, hay_sub, mid_sub
    EXPAND STRING_TRY_SUBSTR_RANGE ok_mid_s, start_mid_s, end_mid_s, hay_sub, mid_sub
    EXPAND STRING_BUF_TRY_SUBSTR_RANGE ok_mid_b, start_mid_b, end_mid_b, hay_buf_sub, mid_sub_b
    EXPAND STR_SUBSTR_RANGE ok_prefix, start_prefix, end_prefix, hay_sub, prefix_sub
    EXPAND STR_TRY_SUBSTR_RANGE ok_full, start_full, end_full, hay_sub, full_sub
    EXPAND STR_TRY_SUBSTR_RANGE ok_miss, start_miss, end_miss, hay_sub, other_sub
    EXPAND STRING_SUBSTR_RANGE ok_prefix_s, start_prefix_s, end_prefix_s, hay_sub, prefix_sub
    EXPAND STRING_BUF_SUBSTR_RANGE ok_full_b, start_full_b, end_full_b, hay_buf_sub, full_sub_b

    mid_ok_flag = eq mid_ok, 1
    prefix_ok_flag = eq prefix_ok, 1
    full_ok_flag = eq full_ok, 1
    mid_ok_b_flag = eq mid_ok_b, 1
    full_ok_b_flag = eq full_ok_b, 1
    ok_mid_flag = eq ok_mid, 1
    ok_mid_s_flag = eq ok_mid_s, 1
    ok_mid_b_flag = eq ok_mid_b, 1
    ok_prefix_flag = eq ok_prefix, 1
    ok_full_flag = eq ok_full, 1
    ok_miss_flag = eq ok_miss, 0
    ok_prefix_s_flag = eq ok_prefix_s, 1
    ok_full_b_flag = eq ok_full_b, 1
    start_mid_ok = eq start_mid, 1
    end_mid_ok = eq end_mid, 3
    start_mid_s_ok = eq start_mid_s, 1
    end_mid_s_ok = eq end_mid_s, 3
    start_mid_b_ok = eq start_mid_b, 1
    end_mid_b_ok = eq end_mid_b, 3
    start_prefix_ok = eq start_prefix, 0
    end_prefix_ok = eq end_prefix, 2
    start_full_ok = eq start_full, 0
    end_full_ok = eq end_full, 4
    start_miss_ok = eq start_miss, 0
    end_miss_ok = eq end_miss, 0
    start_prefix_s_ok = eq start_prefix_s, 0
    end_prefix_s_ok = eq end_prefix_s, 2
    start_full_b_ok = eq start_full_b, 0
    end_full_b_ok = eq end_full_b, 4

    ok = and mid_ok_flag, prefix_ok_flag
    ok = and ok, full_ok_flag
    ok = and ok, mid_ok_b_flag
    ok = and ok, full_ok_b_flag
    ok = and ok, ok_mid_flag
    ok = and ok, ok_mid_s_flag
    ok = and ok, ok_mid_b_flag
    ok = and ok, ok_prefix_flag
    ok = and ok, ok_full_flag
    ok = and ok, ok_miss_flag
    ok = and ok, ok_prefix_s_flag
    ok = and ok, ok_full_b_flag
    ok = and ok, start_mid_ok
    ok = and ok, end_mid_ok
    ok = and ok, start_mid_s_ok
    ok = and ok, end_mid_s_ok
    ok = and ok, start_mid_b_ok
    ok = and ok, end_mid_b_ok
    ok = and ok, start_prefix_ok
    ok = and ok, end_prefix_ok
    ok = and ok, start_full_ok
    ok = and ok, end_full_ok
    ok = and ok, start_miss_ok
    ok = and ok, end_miss_ok
    ok = and ok, start_prefix_s_ok
    ok = and ok, end_prefix_s_ok
    ok = and ok, start_full_b_ok
    ok = and ok, end_full_b_ok

    EXPAND STRING_BUF_FREE hay_buf_sub
    !hay_sub
    !hay_view_b
    !mid_sub
    !prefix_sub
    !full_sub
    !mid_sub_b
    !full_sub_b
    !other_sub
    !mid_ok
    !prefix_ok
    !full_ok
    !mid_ok_b
    !full_ok_b
    !ok_mid
    !start_mid
    !end_mid
    !ok_mid_s
    !start_mid_s
    !end_mid_s
    !ok_mid_b
    !start_mid_b
    !end_mid_b
    !ok_prefix
    !start_prefix
    !end_prefix
    !ok_full
    !start_full
    !end_full
    !ok_miss
    !start_miss
    !end_miss
    !ok_prefix_s
    !start_prefix_s
    !end_prefix_s
    !ok_full_b
    !start_full_b
    !end_full_b
    !mid_ok_flag
    !prefix_ok_flag
    !full_ok_flag
    !mid_ok_b_flag
    !full_ok_b_flag
    !ok_mid_flag
    !ok_mid_s_flag
    !ok_mid_b_flag
    !ok_prefix_flag
    !ok_full_flag
    !ok_miss_flag
    !ok_prefix_s_flag
    !ok_full_b_flag
    !start_mid_ok
    !end_mid_ok
    !start_mid_s_ok
    !end_mid_s_ok
    !start_mid_b_ok
    !end_mid_b_ok
    !start_prefix_ok
    !end_prefix_ok
