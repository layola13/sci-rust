    EXPAND STR_FROM_PARTS expected_end, &TRIM_MATCHES_END_EXPECTED, 8
    EXPAND STR_FROM_PARTS expected_both, &TRIM_MATCHES_BOTH_EXPECTED, 4
    EXPAND STR_EMPTY empty_needle
    EXPAND STRING_BUF_FROM_STR owned_hay, hay

    EXPAND STR_TRIM_START_MATCHES_NEEDLE trim_start, hay, needle
    EXPAND STRING_TRIM_END_MATCHES_NEEDLE trim_end, hay, needle
    EXPAND STR_TRIM_MATCHES_NEEDLE trim_both, hay, needle
    EXPAND STRING_TRIM_MATCHES_NEEDLE string_both, hay, needle
    EXPAND STRING_BUF_TRIM_START_MATCHES_NEEDLE owned_start, owned_hay, needle
    EXPAND STRING_BUF_TRIM_END_MATCHES_NEEDLE owned_end, owned_hay, needle
    EXPAND STRING_BUF_TRIM_MATCHES_NEEDLE owned_both, owned_hay, needle
    EXPAND STR_TRIM_MATCHES_NEEDLE empty_noop, hay, empty_needle

    EXPAND STR_EQ trim_start_eq, trim_start, expected_start
    EXPAND STR_EQ trim_end_eq, trim_end, expected_end
    EXPAND STR_EQ trim_both_eq, trim_both, expected_both
    EXPAND STR_EQ string_both_eq, string_both, expected_both
    EXPAND STR_EQ owned_start_eq, owned_start, expected_start
    EXPAND STR_EQ owned_end_eq, owned_end, expected_end
    EXPAND STR_EQ owned_both_eq, owned_both, expected_both
    EXPAND STR_EQ empty_noop_eq, empty_noop, hay

    trim_start_ok = eq trim_start_eq, 1
    trim_end_ok = eq trim_end_eq, 1
    trim_both_ok = eq trim_both_eq, 1
    string_both_ok = eq string_both_eq, 1
    owned_start_ok = eq owned_start_eq, 1
    owned_end_ok = eq owned_end_eq, 1
    owned_both_ok = eq owned_both_eq, 1
    empty_noop_ok = eq empty_noop_eq, 1
    ok01 = and trim_start_ok, trim_end_ok
    ok02 = and ok01, trim_both_ok
    ok03 = and ok02, string_both_ok
    ok04 = and ok03, owned_start_ok
    ok05 = and ok04, owned_end_ok
    ok06 = and ok05, owned_both_ok
    ok = and ok06, empty_noop_ok

    EXPAND STRING_BUF_FREE owned_hay
    !hay
    !needle
    !expected_start
    !expected_end
    !expected_both
    !empty_needle
    !trim_start
    !trim_end
    !trim_both
    !string_both
    !owned_start
    !owned_end
    !owned_both
    !empty_noop
    !trim_start_eq
    !trim_end_eq
    !trim_both_eq
    !string_both_eq
    !owned_start_eq
    !owned_end_eq
    !owned_both_eq
    !empty_noop_eq
    !trim_start_ok
    !trim_end_ok
    !trim_both_ok
    !string_both_ok
    !owned_start_ok
    !owned_end_ok
    !owned_both_ok
    !empty_noop_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    br ok -> L_STRING_TRIM_MATCHES_OK, L_STRING_TRIM_MATCHES_FAIL

