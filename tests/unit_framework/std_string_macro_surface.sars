    eq_rs0_ok = eq eq_rs0, 1
    eq_rs1_ok = eq eq_rs1, 1
    eq_rs2_ok = eq eq_rs2, 1
    eq_m0_ok = eq eq_m0, 1
    eq_m1_ok = eq eq_m1, 1
    eq_rm0_ok = eq eq_rm0, 1
    eq_rm1_ok = eq eq_rm1, 1
    eq_multi1_ok = eq eq_multi1, 1
    eq_multi_match_ok = eq eq_multi_match, 1
    part_s3_len_ok = eq part_s3_len, 0
    part_rs3_len_ok = eq part_rs3_len, 0
    part_m2_len_ok = eq part_m2_len, 0
    part_rm2_len_ok = eq part_rm2_len, 0
    part_multi2_len_ok = eq part_multi2_len, 0
    invalid_split_len_ok = eq invalid_split_len, 0
    invalid_match_len_ok = eq invalid_match_len, 0

    ok = and split_count_ok, split_count_s_ok
    ok = and ok, split_count_b_ok
    ok = and ok, rsplit_count_ok
    ok = and ok, rsplit_count_s_ok
    ok = and ok, rsplit_count_b_ok
    ok = and ok, matches_count_ok
    ok = and ok, matches_count_s_ok
    ok = and ok, matches_count_b_ok
    ok = and ok, rmatches_count_ok
    ok = and ok, rmatches_count_s_ok
    ok = and ok, rmatches_count_b_ok
    ok = and ok, multi_split_count_ok
    ok = and ok, multi_matches_count_ok
    ok = and ok, invalid_split_count_ok
    ok = and ok, invalid_matches_count_ok
    ok = and ok, ok_s0_flag
    ok = and ok, ok_s1_flag
    ok = and ok, ok_s2_flag
    ok = and ok, ok_s3_flag
    ok = and ok, ok_rs0_flag
    ok = and ok, ok_rs1_flag
    ok = and ok, ok_rs2_flag
    ok = and ok, ok_rs3_flag
    ok = and ok, ok_m0_flag
    ok = and ok, ok_m1_flag
    ok = and ok, ok_m2_flag
    ok = and ok, ok_rm0_flag
    ok = and ok, ok_rm1_flag
    ok = and ok, ok_rm2_flag
    ok = and ok, ok_multi1_flag
    ok = and ok, ok_multi2_flag
    ok = and ok, ok_multi_match_flag
    ok = and ok, ok_invalid_split_flag
    ok = and ok, ok_invalid_match_flag
    ok = and ok, eq_s0_ok
    ok = and ok, eq_s1_ok
    ok = and ok, eq_s2_ok
    ok = and ok, eq_rs0_ok
    ok = and ok, eq_rs1_ok
    ok = and ok, eq_rs2_ok
    ok = and ok, eq_m0_ok
    ok = and ok, eq_m1_ok
    ok = and ok, eq_rm0_ok
    ok = and ok, eq_rm1_ok
    ok = and ok, eq_multi1_ok
    ok = and ok, eq_multi_match_ok
    ok = and ok, part_s3_len_ok
    ok = and ok, part_rs3_len_ok
    ok = and ok, part_m2_len_ok
    ok = and ok, part_rm2_len_ok
    ok = and ok, part_multi2_len_ok
    ok = and ok, invalid_split_len_ok
    ok = and ok, invalid_match_len_ok

    !part_s0
    !part_s1
    !part_s2
    !part_s3
    !part_rs0
    !part_rs1
    !part_rs2
    !part_rs3
    !part_m0
    !part_m1
    !part_m2
    !part_rm0
    !part_rm1
    !part_rm2
    !part_multi1
    !part_multi2
    !part_multi_match
    !part_invalid_split
    !part_invalid_match
    EXPAND STRING_BUF_FREE split_buf
    EXPAND STRING_BUF_FREE multi_buf
    !split_hay
    !multi_hay
    !part_a
    !part_b
    !part_c
    !colon
    !eacute
    br ok -> L_STR_SPLIT_MATCHES_CHAR_OK, L_STR_SPLIT_MATCHES_CHAR_FAIL

L_STR_SPLIT_MATCHES_CHAR_FAIL:
    !ok
    panic(10275)

L_STR_SPLIT_MATCHES_CHAR_OK:
    !ok
    return

