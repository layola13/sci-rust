    !insert_byte_eq
    !truncate_len
    !clear_len
    !pop_empty_ok
    !pop_empty_byte
    !insert_miss_ok
    !replace_miss_ok
    !split_miss_ok
    !split_miss_tail
    !split_miss_tail_empty
    !pushed_ok
    !len_after_push_ok
    !pop_flag_ok
