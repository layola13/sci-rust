    EXPAND STRING_FROM_UTF8 string_bad_ok, string_bad_view, invalid_bytes
    EXPAND STRING_TRY_FROM_UTF8_MUT string_try_mut_bad_ok, string_try_mut_bad_view, invalid_bytes
    EXPAND STRING_FROM_UTF8_MUT string_mut_ok, string_mut_view, valid_bytes
    EXPAND STRING_FROM_UTF8_UNCHECKED string_unchecked, valid_bytes
    EXPAND STRING_FROM_UTF8_UNCHECKED_MUT string_unchecked_mut_bad, invalid_bytes
    valid_ptr = load valid_bytes+Slice_ptr as ptr
    invalid_ptr = load invalid_bytes+Slice_ptr as ptr
    null_ptr = 0 as ptr
    str_view_ptr = load str_view+Slice_ptr as ptr
    str_view_len = load str_view+Slice_len as u64
    string_bad_ptr = load string_bad_view+Slice_ptr as ptr
    string_bad_len = load string_bad_view+Slice_len as u64
