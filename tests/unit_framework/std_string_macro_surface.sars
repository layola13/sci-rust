@test "sa_std string prefix suffix char aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS hay, &CHAR_HAY, 6
    EXPAND STR_FROM_PARTS multi_hay, &CHAR_HAY_MULTI, 6
    EXPAND STR_FROM_PARTS prefix_expected, &CHAR_PREFIX_STRIPPED, 5
    EXPAND STR_FROM_PARTS suffix_expected, &CHAR_SUFFIX_STRIPPED, 5
    EXPAND STR_FROM_PARTS multi_prefix_expected, &CHAR_MULTI_PREFIX_STRIPPED, 5
    EXPAND STR_FROM_PARTS multi_suffix_expected, &CHAR_MULTI_SUFFIX_STRIPPED, 4
    EXPAND STRING_BUF_FROM_STR hay_buf, hay
    EXPAND STRING_BUF_FROM_STR multi_buf, multi_hay

    EXPAND STR_STARTS_WITH_CHAR starts_r, hay, 114
    EXPAND STRING_STARTS_WITH_CHAR starts_r_s, hay, 114
