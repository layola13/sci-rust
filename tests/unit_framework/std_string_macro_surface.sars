    EXPAND STR_FROM_PARTS multi_expected, &BUF_REMOVE_MULTI_EXPECTED, 4

    EXPAND STRING_BUF_WITH_CAPACITY buf, 4
    EXPAND STRING_BUF_PUSH_STR buf, hi
    EXPAND STRING_BUF_TRY_REMOVE_MATCHES_WITHIN_CAPACITY ok1, buf, needle
