    store invalid_data+0, 55296 as u64
    invalid_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW invalid_slice, invalid_data, 1
    EXPAND STRING_BUF_TRY_EXTEND_CHARS_WITHIN_CAPACITY_U64 ok_chars_bad, char_buf, invalid_slice
    EXPAND STRING_BUF_LEN clen3, char_buf

    ascii_data = alloc 2
    store ascii_data+0, 120 as u8
    store ascii_data+1, 121 as u8
    ascii_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW ascii_slice, ascii_data, 2
    EXPAND STRING_BUF_WITH_CAPACITY ascii_buf, 3
    EXPAND STRING_BUF_TRY_EXTEND_ASCII_CHARS_WITHIN_CAPACITY ok_ascii, ascii_buf, ascii_slice
