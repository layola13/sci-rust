    EXPAND STR_FROM_PARTS utf8_smile_z, &UTF8_SMILE_Z, 5
    EXPAND STRING_BUF_FROM_STR owned_pathish, pathish
    EXPAND STRING_BUF_FROM_STR owned_utf8, utf8_boundary
    EXPAND STRING_BUF_TRY_SPLIT_ONCE split_once_ok, split_once_left, split_once_right, owned_pathish, colon
    EXPAND STRING_BUF_TRY_RSPLIT_ONCE rsplit_once_ok, rsplit_once_left, rsplit_once_right, owned_pathish, colon
    EXPAND STRING_BUF_TRY_SPLIT_ONCE split_once_miss_ok, split_once_miss_left, split_once_miss_right, owned_pathish, miss
    EXPAND STRING_BUF_TRY_SPLIT_AT try_split_at_ok, try_split_at_left, try_split_at_right, owned_utf8, 3
    EXPAND STRING_BUF_TRY_SPLIT_AT try_split_at_bad_ok, try_split_at_bad_left, try_split_at_bad_right, owned_utf8, 4
    EXPAND STRING_BUF_TRY_SPLIT_AT_CHECKED split_at_ok, split_at_left, split_at_right, owned_utf8, 3
    EXPAND STRING_BUF_TRY_SPLIT_AT_CHECKED split_at_bad_ok, split_at_bad_left, split_at_bad_right, owned_utf8, 4
    EXPAND STR_EQ split_once_left_eq, split_once_left, expected_left
    EXPAND STR_EQ split_once_right_eq, split_once_right, expected_right
    EXPAND STR_EQ rsplit_once_left_eq, rsplit_once_left, expected_rleft
    EXPAND STR_EQ rsplit_once_right_eq, rsplit_once_right, expected_rright
    EXPAND STR_IS_EMPTY split_once_miss_left_empty, split_once_miss_left
    EXPAND STR_IS_EMPTY split_once_miss_right_empty, split_once_miss_right
    EXPAND STR_EQ try_split_at_left_eq, try_split_at_left, utf8_a_e
    EXPAND STR_EQ try_split_at_right_eq, try_split_at_right, utf8_smile_z
    EXPAND STR_IS_EMPTY try_split_at_bad_left_empty, try_split_at_bad_left
    EXPAND STR_IS_EMPTY try_split_at_bad_right_empty, try_split_at_bad_right
    EXPAND STR_EQ split_at_left_eq, split_at_left, utf8_a_e
    EXPAND STR_EQ split_at_right_eq, split_at_right, utf8_smile_z
    EXPAND STR_IS_EMPTY split_at_bad_left_empty, split_at_bad_left
    EXPAND STR_IS_EMPTY split_at_bad_right_empty, split_at_bad_right

    split_once_flag_ok = eq split_once_ok, 1
    split_once_left_ok = eq split_once_left_eq, 1
    split_once_right_ok = eq split_once_right_eq, 1
    rsplit_once_flag_ok = eq rsplit_once_ok, 1
    rsplit_once_left_ok = eq rsplit_once_left_eq, 1
