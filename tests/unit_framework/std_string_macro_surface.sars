    EXPAND STR_FROM_PARTS multi_needle, &MULTI_NEEDLE, 2
    EXPAND STR_EMPTY empty_needle
    EXPAND STRING_BUF_FROM_STR match_buf, matches_hay

    EXPAND STR_MATCH_INDICES_NEEDLE_COUNT count, matches_hay, colon
    EXPAND STRING_MATCH_INDICES_NEEDLE_COUNT count_s, matches_hay, colon
