    empty_part_value_ok = eq empty_part_empty, 1
    only_count_ok = eq only_count, 0
    only_part_flag_ok = eq only_part_ok, 0
    only_part_value_ok = eq only_part_empty, 1
    owned_count_ok = eq owned_count, 3
    owned_part1_flag_ok = eq owned_part1_ok, 1
    owned_part1_value_ok = eq owned_part1_eq, 1
    owned_part3_flag_ok = eq owned_part3_ok, 0
    owned_part3_value_ok = eq owned_part3_empty, 1
    owned_only_count_ok = eq owned_only_count, 0
