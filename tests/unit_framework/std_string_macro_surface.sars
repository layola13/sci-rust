    ok0b_flag = eq ok0b, 1
    idx0b_ok = eq idx0b, 1
    miss_flag = eq ok_miss, 0
    miss_idx_ok = eq idx_miss, 0
    miss_len_ok = eq miss_len, 0
    empty_flag = eq ok_empty, 0
    empty_idx_ok = eq idx_empty, 0
    empty_len_ok = eq empty_len, 0
    multi0_flag = eq ok_multi0, 1
    multi0_idx_ok = eq idx_multi0, 1
    multi1_flag = eq ok_multi1, 1
    multi1_idx_ok = eq idx_multi1, 4
    rok0_flag = eq rok0, 1
