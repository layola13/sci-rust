    bad_ascii_data = alloc 1
    store bad_ascii_data+0, 200 as u8
    bad_ascii_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW bad_ascii_slice, bad_ascii_data, 1
    EXPAND STRING_BUF_TRY_EXTEND_ASCII_CHARS_WITHIN_CAPACITY ok_ascii_bad, ascii_buf, bad_ascii_slice
    EXPAND STRING_BUF_LEN alen3, ascii_buf

    ok_chars_flag = eq ok_chars, 1
    clen1_ok = eq clen1, 2
    cb0_flag = eq cb0_ok, 1
    cb0_val = eq cb0, 97
    cb1_flag = eq cb1_ok, 1
    cb1_val = eq cb1, 98
    ok_chars_full_flag = eq ok_chars_full, 0
    clen2_ok = eq clen2, 2
    ok_chars_bad_flag = eq ok_chars_bad, 0
    clen3_ok = eq clen3, 2
    ok_ascii_flag = eq ok_ascii, 1
    alen1_ok = eq alen1, 2
    ab0_flag = eq ab0_ok, 1
    ab0_val = eq ab0, 120
    ab1_flag = eq ab1_ok, 1
    ab1_val = eq ab1, 121
    ok_ascii_full_flag = eq ok_ascii_full, 0
    alen2_ok = eq alen2, 2
    ok_ascii_bad_flag = eq ok_ascii_bad, 0
    alen3_ok = eq alen3, 2

    ok = and ok_chars_flag, clen1_ok
    ok = and ok, cb0_flag
    ok = and ok, cb0_val
    ok = and ok, cb1_flag
    ok = and ok, cb1_val
    ok = and ok, ok_chars_full_flag
    ok = and ok, clen2_ok
    ok = and ok, ok_chars_bad_flag
