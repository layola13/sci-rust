    EXPAND SLICE_NEW mutated_joined_slice, &LEAK_MUTATED, 8
    EXPAND SLICE_NEW write_expected_slice, &WRITE_EXPECTED, 5
    EXPAND SLICE_NEW e_slice, &UTF8_E_ACUTE, 2

    EXPAND STRING_BUF_DEFAULT default_string
    EXPAND STRING_BUF_IS_EMPTY default_empty, default_string
    EXPAND STRING_BUF_FROM_STR left_string, word_slice
    EXPAND STRING_BUF_ADD_STR added_string, left_string, right_slice
    EXPAND STRING_BUF_AS_REF_STR added_view, added_string
    EXPAND STR_EQ added_eq, added_view, joined_slice
    EXPAND STRING_BUF_DEREF_STR deref_view, added_string
    EXPAND STR_EQ deref_eq, deref_view, joined_slice
    EXPAND STRING_BUF_EQ_STR eq_str, added_string, joined_slice
    EXPAND STRING_BUF_NE_STR ne_str, added_string, word_slice
    EXPAND STR_EQ_STRING_BUF str_eq_string, joined_slice, added_string
    EXPAND STR_NE_STRING_BUF str_ne_string, word_slice, added_string
    EXPAND STR_HASH str_hash, joined_slice
    EXPAND STRING_HASH string_hash, joined_slice
    EXPAND STRING_BUF_HASH string_buf_hash, added_string
    EXPAND STR_HASH word_hash, word_slice
    EXPAND STR_CMP str_cmp_equal, joined_slice, joined_slice
    EXPAND STR_CMP str_cmp_less_item, right_slice, word_slice
    EXPAND STR_CMP str_cmp_greater_len, joined_slice, word_slice
    EXPAND STR_LT str_lt_item, right_slice, word_slice
    EXPAND STR_LE str_le_equal, joined_slice, joined_slice
    EXPAND STR_GT str_gt_len, joined_slice, word_slice
    EXPAND STR_GE str_ge_equal, joined_slice, joined_slice
