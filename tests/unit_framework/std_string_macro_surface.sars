    i16_slice = alloc Slice_SIZE
    i32_slice = alloc Slice_SIZE
    isize_slice = alloc Slice_SIZE
    char_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW true_slice, &TO_STRING_TRUE, 4
    EXPAND SLICE_NEW false_slice, &TO_STRING_FALSE, 5
    EXPAND SLICE_NEW u64_slice, &TO_STRING_U64, 5
    EXPAND SLICE_NEW i64_slice, &TO_STRING_I64, 3
    EXPAND SLICE_NEW u8_slice, &TO_STRING_U8, 3
    EXPAND SLICE_NEW u16_slice, &TO_STRING_U16, 5
    EXPAND SLICE_NEW u32_slice, &TO_STRING_U32, 10
    EXPAND SLICE_NEW usize_slice, &TO_STRING_USIZE, 4
    EXPAND SLICE_NEW i8_slice, &TO_STRING_I8, 2
    EXPAND SLICE_NEW i16_slice, &TO_STRING_I16, 4
    EXPAND SLICE_NEW i32_slice, &TO_STRING_I32, 6
    EXPAND SLICE_NEW isize_slice, &TO_STRING_ISIZE, 5
    EXPAND SLICE_NEW char_slice, &UTF8_E_ACUTE, 2

    neg_42 = sub 0, 42
    neg_8 = sub 0, 8
    neg_160 = sub 0, 160
    neg_32000 = sub 0, 32000
    neg_4096 = sub 0, 4096
    EXPAND CHAR_TO_STRING char_buf, 233
    EXPAND BOOL_TO_STRING true_buf, 1
    EXPAND BOOL_TO_STRING false_buf, 0
    EXPAND U64_TO_STRING u64_buf, 12345
    EXPAND I64_TO_STRING i64_buf, neg_42
    EXPAND U8_TO_STRING u8_buf, 255
    EXPAND U16_TO_STRING u16_buf, 65535
    EXPAND U32_TO_STRING u32_buf, 4294967295
    EXPAND USIZE_TO_STRING usize_buf, 4096
    EXPAND I8_TO_STRING i8_buf, neg_8
    EXPAND I16_TO_STRING i16_buf, neg_160
    EXPAND I32_TO_STRING i32_buf, neg_32000
    EXPAND ISIZE_TO_STRING isize_buf, neg_4096

    EXPAND STRING_BUF_AS_STR char_view, char_buf
    EXPAND STRING_BUF_AS_STR true_view, true_buf
    EXPAND STRING_BUF_AS_STR false_view, false_buf
    EXPAND STRING_BUF_AS_STR u64_view, u64_buf
    EXPAND STRING_BUF_AS_STR i64_view, i64_buf
    EXPAND STRING_BUF_AS_STR u8_view, u8_buf
    EXPAND STRING_BUF_AS_STR u16_view, u16_buf
    EXPAND STRING_BUF_AS_STR u32_view, u32_buf
    EXPAND STRING_BUF_AS_STR usize_view, usize_buf
    EXPAND STRING_BUF_AS_STR i8_view, i8_buf
    EXPAND STRING_BUF_AS_STR i16_view, i16_buf
    EXPAND STRING_BUF_AS_STR i32_view, i32_buf
    EXPAND STRING_BUF_AS_STR isize_view, isize_buf
    EXPAND STR_EQ char_eq, char_view, char_slice
    EXPAND STR_EQ true_eq, true_view, true_slice
    EXPAND STR_EQ false_eq, false_view, false_slice
    EXPAND STR_EQ u64_eq, u64_view, u64_slice
    EXPAND STR_EQ i64_eq, i64_view, i64_slice
    EXPAND STR_EQ u8_eq, u8_view, u8_slice
    EXPAND STR_EQ u16_eq, u16_view, u16_slice
    EXPAND STR_EQ u32_eq, u32_view, u32_slice
    EXPAND STR_EQ usize_eq, usize_view, usize_slice
    EXPAND STR_EQ i8_eq, i8_view, i8_slice
    EXPAND STR_EQ i16_eq, i16_view, i16_slice
    EXPAND STR_EQ i32_eq, i32_view, i32_slice
    EXPAND STR_EQ isize_eq, isize_view, isize_slice

