    part5_value_ok = eq part5_empty, 1
    empty_split_count_ok = eq empty_split_count, 1
    empty_part_flag_ok = eq empty_part_ok, 1
    empty_part_value_ok = eq empty_part_empty, 1
    line_count_ok = eq line_count, 3
    line1_flag_ok = eq line1_ok, 1
    line1_value_ok = eq line1_eq, 1
    line3_flag_ok = eq line3_ok, 0
    line3_value_ok = eq line3_empty, 1
