@test "sa_std string owned buffer utf8 and replace macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS left, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS replace_source, &BUF_REPLACE_SOURCE, 7
    EXPAND STR_FROM_PARTS replace_needle, &BUF_REPLACE_NEEDLE, 1
    EXPAND STR_FROM_PARTS replace_with, &BUF_REPLACE_WITH, 2
    EXPAND STR_FROM_PARTS replace_expected, &BUF_REPLACE_ALL_EXPECTED, 10
    EXPAND STR_FROM_PARTS replace_first_expected, &BUF_REPLACE_FIRST_EXPECTED, 8
    EXPAND STR_FROM_PARTS replace_last_expected, &BUF_REPLACE_LAST_EXPECTED, 8
    EXPAND STR_FROM_PARTS remove_matches_expected, &BUF_REMOVE_MATCHES_EXPECTED, 4
    EXPAND STR_FROM_PARTS replace_empty_expected, &BUF_REPLACE_EMPTY_EXPECTED, 7
    EXPAND STR_FROM_PARTS replace_multi_source, &BUF_REPLACE_MULTI_SOURCE, 10
    EXPAND STR_FROM_PARTS replace_multi_needle, &BUF_REPLACE_MULTI_NEEDLE, 3
    EXPAND STR_FROM_PARTS replace_multi_with, &BUF_REPLACE_MULTI_WITH, 1
    EXPAND STR_FROM_PARTS replace_multi_expected, &BUF_REPLACE_MULTI_EXPECTED, 6
    EXPAND STR_FROM_PARTS remove_multi_expected, &BUF_REMOVE_MULTI_EXPECTED, 4
    EXPAND STR_FROM_PARTS replace_long_needle, &BUF_REPLACE_LONG_NEEDLE, 12
    EXPAND STR_FROM_PARTS utf8_full_expected, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STR_FROM_PARTS title_word, &TITLE_WORD, 4
    EXPAND STR_EMPTY empty_needle

    bad_ptr = stack_alloc 3
    store bad_ptr+0, 114 as u8
    bad_ptr_1 = ptr_add bad_ptr, 1
    store bad_ptr_1+0, 255 as u8
    bad_ptr_2 = ptr_add bad_ptr, 2
    store bad_ptr_2+0, 115 as u8
    EXPAND STR_FROM_PARTS bad_bytes, bad_ptr, 3

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED unchecked_buf, left
    EXPAND STRING_BUF_AS_STR unchecked_view, unchecked_buf
    EXPAND STR_EQ unchecked_eq, unchecked_view, left
    EXPAND STRING_BUF_TRY_FROM_UTF8_ASCII ascii_ok, ascii_buf, left
    EXPAND STRING_BUF_AS_STR ascii_view, ascii_buf
    EXPAND STR_EQ ascii_eq, ascii_view, left
    EXPAND STRING_BUF_TRY_FROM_UTF8_ASCII ascii_bad_ok, ascii_bad_buf, bad_bytes
    EXPAND STRING_BUF_LEN ascii_bad_len, ascii_bad_buf
    EXPAND STRING_BUF_FROM_UTF8 utf8_full_ok, utf8_full_buf, utf8_full_expected
    EXPAND STRING_BUF_AS_STR utf8_full_view, utf8_full_buf
    EXPAND STR_EQ utf8_full_eq, utf8_full_view, utf8_full_expected
    EXPAND STRING_BUF_FROM_UTF8 utf8_bad_ok, utf8_bad_buf, bad_bytes
    EXPAND STRING_BUF_LEN utf8_bad_len, utf8_bad_buf
    EXPAND STRING_BUF_REPLACE replaced_buf, replace_source, replace_needle, replace_with
    EXPAND STRING_BUF_AS_STR replaced_view, replaced_buf
    EXPAND STR_EQ replaced_eq, replaced_view, replace_expected
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED replace_first_buf, replace_source
    EXPAND STRING_BUF_REPLACE_FIRST replace_first_ok, replace_first_buf, replace_needle, replace_with
    EXPAND STRING_BUF_AS_STR replace_first_view, replace_first_buf
    EXPAND STR_EQ replace_first_eq, replace_first_view, replace_first_expected
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED replace_last_buf, replace_source
    EXPAND STRING_BUF_REPLACE_LAST replace_last_ok, replace_last_buf, replace_needle, replace_with
    EXPAND STRING_BUF_AS_STR replace_last_view, replace_last_buf
    EXPAND STR_EQ replace_last_eq, replace_last_view, replace_last_expected
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED replace_miss_buf, left
    EXPAND STRING_BUF_REPLACE_FIRST replace_miss_ok, replace_miss_buf, replace_long_needle, replace_with
    EXPAND STRING_BUF_AS_STR replace_miss_view, replace_miss_buf
    EXPAND STR_EQ replace_miss_eq, replace_miss_view, left
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED remove_matches_buf, replace_source
    EXPAND STRING_BUF_REMOVE_MATCHES remove_matches_buf, replace_needle
    EXPAND STRING_BUF_AS_STR remove_matches_view, remove_matches_buf
    EXPAND STR_EQ remove_matches_eq, remove_matches_view, remove_matches_expected
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED remove_multi_buf, replace_multi_source
    EXPAND STRING_BUF_REMOVE_MATCHES remove_multi_buf, replace_multi_needle
    EXPAND STRING_BUF_AS_STR remove_multi_view, remove_multi_buf
    EXPAND STR_EQ remove_multi_eq, remove_multi_view, remove_multi_expected
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED remove_miss_buf, left
    EXPAND STRING_BUF_REMOVE_MATCHES remove_miss_buf, replace_long_needle
    EXPAND STRING_BUF_AS_STR remove_miss_view, remove_miss_buf
    EXPAND STR_EQ remove_miss_eq, remove_miss_view, left
    EXPAND STRING_BUF_REPLACE replace_empty_buf, replace_source, empty_needle, replace_with
    EXPAND STRING_BUF_AS_STR replace_empty_view, replace_empty_buf
    EXPAND STR_EQ replace_empty_eq, replace_empty_view, replace_empty_expected
    EXPAND STRING_BUF_REPLACE replace_multi_buf, replace_multi_source, replace_multi_needle, replace_multi_with
    EXPAND STRING_BUF_AS_STR replace_multi_view, replace_multi_buf
    EXPAND STR_EQ replace_multi_eq, replace_multi_view, replace_multi_expected
    EXPAND STRING_BUF_REPLACE replace_long_buf, left, replace_long_needle, replace_multi_with
    EXPAND STRING_BUF_AS_STR replace_long_view, replace_long_buf
    EXPAND STR_EQ replace_long_eq, replace_long_view, left
    EXPAND STRING_BUF_INTO_BYTES bytes_vec, unchecked_buf
    EXPAND VEC_LEN bytes_len, bytes_vec
    EXPAND VEC_AS_PTR bytes_ptr, bytes_vec
    first_byte = load bytes_ptr+0 as u8

    EXPAND VEC_WITH_CAPACITY unchecked_vec, 4, 1
    EXPAND VEC_PUSH unchecked_vec, 114, 1
    EXPAND VEC_PUSH unchecked_vec, 117, 1
    EXPAND VEC_PUSH unchecked_vec, 115, 1
    EXPAND VEC_PUSH unchecked_vec, 116, 1
    EXPAND VEC_AS_PTR unchecked_vec_ptr_before, unchecked_vec
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED_VEC unchecked_owned_buf, unchecked_vec
    EXPAND STRING_BUF_AS_PTR unchecked_vec_ptr_after, unchecked_owned_buf
    EXPAND STRING_BUF_AS_STR unchecked_owned_view, unchecked_owned_buf
    EXPAND STR_EQ unchecked_owned_eq, unchecked_owned_view, left

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED mut_str_buf, left
    EXPAND STRING_BUF_AS_MUT_STR mut_str_view, mut_str_buf
    EXPAND STR_AS_PTR mut_str_ptr, mut_str_view
    store mut_str_ptr+0, 82 as u8
    EXPAND STRING_BUF_AS_STR mut_str_after_view, mut_str_buf
    EXPAND STR_EQ mut_str_eq, mut_str_after_view, title_word

    unchecked_ok = eq unchecked_eq, 1
    ascii_flag_ok = eq ascii_ok, 1
    ascii_value_ok = eq ascii_eq, 1
    ascii_bad_flag_ok = eq ascii_bad_ok, 0
    ascii_bad_empty_ok = eq ascii_bad_len, 0
    utf8_full_flag_ok = eq utf8_full_ok, 1
    utf8_full_value_ok = eq utf8_full_eq, 1
    utf8_bad_flag_ok = eq utf8_bad_ok, 0
    utf8_bad_empty_ok = eq utf8_bad_len, 0
    replace_value_ok = eq replaced_eq, 1
    replace_first_flag_ok = eq replace_first_ok, 1
    replace_first_value_ok = eq replace_first_eq, 1
    replace_last_flag_ok = eq replace_last_ok, 1
    replace_last_value_ok = eq replace_last_eq, 1
    replace_miss_flag_ok = eq replace_miss_ok, 0
    replace_miss_value_ok = eq replace_miss_eq, 1
    remove_matches_value_ok = eq remove_matches_eq, 1
    remove_multi_value_ok = eq remove_multi_eq, 1
    remove_miss_value_ok = eq remove_miss_eq, 1
    replace_empty_value_ok = eq replace_empty_eq, 1
    replace_multi_value_ok = eq replace_multi_eq, 1
    replace_long_value_ok = eq replace_long_eq, 1
    bytes_len_ok = eq bytes_len, 4
    first_byte_ok = eq first_byte, 114
    unchecked_owned_value_ok = eq unchecked_owned_eq, 1
    unchecked_owned_reused_ok = eq unchecked_vec_ptr_before, unchecked_vec_ptr_after
    mut_str_value_ok = eq mut_str_eq, 1
    ok01 = and unchecked_ok, ascii_flag_ok
    ok02 = and ok01, ascii_value_ok
    ok03 = and ok02, ascii_bad_flag_ok
    ok04 = and ok03, ascii_bad_empty_ok
    ok05 = and ok04, utf8_full_flag_ok
