    b1_flag = eq b1_ok, 1
    b1_val = eq b1, 116
    cap1_ok = eq cap1, 4
    ok_miss_flag = eq ok_miss, 1
    len2_ok = eq len2, 2
    ok_char_flag = eq ok_char, 1
    len3_ok = eq len3, 1
    b2_flag = eq b2_ok, 1
    b2_val = eq b2, 116
    ok_bad_flag = eq ok_bad, 0
    len4_ok = eq len4, 1
    ok_multi_flag = eq ok_multi, 1
    mlen_ok = eq mlen, 4
    multi_eq_flag = eq multi_eq, 1
    ok_empty_flag = eq ok_empty, 1
    elen_ok = eq elen, 4

    ok = and ok1_flag, len1_ok
    ok = and ok, b0_flag
    ok = and ok, b0_val
    ok = and ok, b1_flag
    ok = and ok, b1_val
    ok = and ok, cap1_ok
    ok = and ok, ok_miss_flag
    ok = and ok, len2_ok
    ok = and ok, ok_char_flag
    ok = and ok, len3_ok
    ok = and ok, b2_flag
    ok = and ok, b2_val
    ok = and ok, ok_bad_flag
    ok = and ok, len4_ok
    ok = and ok, ok_multi_flag
    ok = and ok, mlen_ok
    ok = and ok, multi_eq_flag
    ok = and ok, ok_empty_flag
    ok = and ok, elen_ok

    EXPAND STRING_BUF_FREE buf
    EXPAND STRING_BUF_FREE multi_buf
    EXPAND STRING_BUF_FREE empty_buf
    !hi
    !needle
    !miss
    !multi
    !multi_needle
    !multi_expected
    !empty_needle
    !ok1
    !len1
    !b0_ok
    !b0
    !b1_ok
    !b1
    !cap1
    !ok_miss
    !len2
    !ok_char
    !len3
    !b2_ok
    !b2
    !ok_bad
    !len4
    !ok_multi
    !mlen
    !multi_view
    !multi_eq
    !ok_empty
    !elen
    !ok1_flag
    !len1_ok
    !b0_flag
    !b0_val
    !b1_flag
    !b1_val
    !cap1_ok
    !ok_miss_flag
    !len2_ok
    !ok_char_flag
    !len3_ok
    !b2_flag
    !b2_val
    !ok_bad_flag
    !len4_ok
    !ok_multi_flag
    !mlen_ok
    !multi_eq_flag
    !ok_empty_flag
    !elen_ok
    br ok -> L_STR_RMWC_OK, L_STR_RMWC_FAIL

L_STR_RMWC_FAIL:
