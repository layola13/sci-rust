@test "sa_std string buffer try split aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS pathish, &PATHISH, 5
    EXPAND STR_FROM_PARTS colon, &COLON, 1
    EXPAND STR_FROM_PARTS expected_left, &PATH_LEFT, 1
    EXPAND STR_FROM_PARTS expected_right, &PATH_RIGHT, 3
