    EXPAND STR_FROM_PARTS utf8_removed_expected, &UTF8_E_SMILE, 6
    EXPAND STR_FROM_PARTS utf8_remaining_expected, &UTF8_A_Z, 2
    EXPAND STR_FROM_PARTS ascii_source, &BUF_DRAIN_SOURCE, 8
    EXPAND STR_FROM_PARTS ascii_removed_expected, &BUF_DRAIN_REMOVED, 1
    EXPAND STR_FROM_PARTS ascii_remaining_expected, &BUF_DRAIN_REMAINING, 7

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED utf8_buf, utf8_source
    EXPAND STRING_BUF_TRY_DRAIN drain_ok, drained, utf8_buf, 1, 6
    EXPAND STRING_BUF_AS_STR drained_view, drained
    EXPAND STRING_BUF_AS_STR utf8_after, utf8_buf
    EXPAND STR_EQ drained_eq, drained_view, utf8_removed_expected
    EXPAND STR_EQ utf8_after_eq, utf8_after, utf8_remaining_expected

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED alias_buf, ascii_source
    EXPAND STRING_BUF_DRAIN alias_ok, alias_drained, alias_buf, 4, 1
    EXPAND STRING_BUF_AS_STR alias_drained_view, alias_drained
    EXPAND STRING_BUF_AS_STR alias_after, alias_buf
    EXPAND STR_EQ alias_drained_eq, alias_drained_view, ascii_removed_expected
    EXPAND STR_EQ alias_after_eq, alias_after, ascii_remaining_expected

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED miss_buf, utf8_source
    EXPAND STRING_BUF_TRY_DRAIN miss_ok, miss_drained, miss_buf, 2, 1
    EXPAND STRING_BUF_AS_STR miss_drained_view, miss_drained
    EXPAND STRING_BUF_AS_STR miss_after, miss_buf
    EXPAND STR_IS_EMPTY miss_drained_empty, miss_drained_view
    EXPAND STR_EQ miss_after_eq, miss_after, utf8_source

    drain_flag_ok = eq drain_ok, 1
    drain_value_ok = eq drained_eq, 1
    drain_remaining_ok = eq utf8_after_eq, 1
    alias_flag_ok = eq alias_ok, 1
