    split_at_flag_ok = eq split_at_ok, 1
    split_at_left_ok = eq split_at_left_eq, 1
    split_at_right_ok = eq split_at_right_eq, 1
    split_at_bad_flag_ok = eq split_at_bad_ok, 0
    split_at_bad_left_ok = eq split_at_bad_left_empty, 1
    split_at_bad_right_ok = eq split_at_bad_right_empty, 1
