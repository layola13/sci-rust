@test "sa_std string retain within capacity aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS source, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STR_FROM_PARTS expected, &UTF8_A_E, 3
