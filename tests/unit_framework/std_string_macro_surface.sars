    EXPAND STR_FROM_PARTS expected_b, &SPLIT_B, 1
    EXPAND STR_EMPTY empty

    EXPAND STR_SPLIT_BYTE_COUNT split_count, split_text, 58
    EXPAND STRING_SPLIT_BYTE_AT part0_ok, part0, split_text, 58, 0
    EXPAND STR_SPLIT_BYTE_AT part1_ok, part1, split_text, 58, 1
    EXPAND STRING_SPLIT_BYTE_AT part2_ok, part2, split_text, 58, 2
    EXPAND STR_SPLIT_BYTE_AT part3_ok, part3, split_text, 58, 3
    EXPAND STRING_SPLIT_BYTE_AT part4_ok, part4, split_text, 58, 4
    EXPAND STR_SPLIT_BYTE_AT part5_ok, part5, split_text, 58, 5
    EXPAND STRING_SPLIT_BYTE_COUNT empty_count, empty, 58
    EXPAND STR_SPLIT_BYTE_AT empty_part_ok, empty_part, empty, 58, 0

    EXPAND STR_IS_EMPTY part0_empty, part0
