    EXPAND SLICE_GET_LEN empty_len, part_empty
    EXPAND SLICE_GET_LEN rmiss_len, rpart_miss

    count_ok = eq count, 2
    count_s_ok = eq count_s, 2
    count_b_ok = eq count_b, 2
