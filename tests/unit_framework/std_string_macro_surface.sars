    EXPAND STRING_BUF_STRIP_PREFIX_CHAR mp_ok_b, mp_part_b, multi_buf, 97

    EXPAND STR_TRY_STRIP_SUFFIX_CHAR s_ok, s_part, hay, 114
    EXPAND STRING_TRY_STRIP_SUFFIX_CHAR s_ok_s, s_part_s, hay, 114
    EXPAND STRING_BUF_TRY_STRIP_SUFFIX_CHAR s_ok_b, s_part_b, hay_buf, 114
