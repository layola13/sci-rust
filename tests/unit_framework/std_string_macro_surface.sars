    !ok_b2_flag
    !ok_t0u_flag
    !ok_t1u_flag
    !ok_empty_needle_flag
    !eq_t0_ok
    !eq_t1_ok
    !eq_b1_ok
    !eq_t0u_ok
    !eq_t1u_ok
    !term2_empty_ok
    !bterm2_empty_ok
    !empty_part_empty_ok
    br ok -> L_SPLIT_TERM_NEEDLE_OK, L_SPLIT_TERM_NEEDLE_FAIL

L_SPLIT_TERM_NEEDLE_FAIL:
    !ok
    panic(10280)

L_SPLIT_TERM_NEEDLE_OK:
    !ok
    return

