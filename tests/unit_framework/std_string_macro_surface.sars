    str_unchecked_bad_len = load str_unchecked_bad+Slice_len as u64
    str_unchecked_mut_bad_ptr = load str_unchecked_mut_bad+Slice_ptr as ptr
    str_unchecked_mut_bad_len = load str_unchecked_mut_bad+Slice_len as u64
    string_unchecked_ptr = load string_unchecked+Slice_ptr as ptr
    string_unchecked_len = load string_unchecked+Slice_len as u64
