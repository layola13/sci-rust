    EXPAND STR_IS_EMPTY part4_empty, part4
    EXPAND STR_IS_EMPTY part5_empty, part5
    EXPAND STR_IS_EMPTY empty_part_empty, empty_part

    split_count_ok = eq split_count, 5
    part0_flag_ok = eq part0_ok, 1
    part0_value_ok = eq part0_empty, 1
    part1_flag_ok = eq part1_ok, 1
    part1_value_ok = eq part1_eq, 1
    part2_flag_ok = eq part2_ok, 1
    part2_value_ok = eq part2_empty, 1
    part3_flag_ok = eq part3_ok, 1
    part3_value_ok = eq part3_eq, 1
    part4_flag_ok = eq part4_ok, 1
    part4_value_ok = eq part4_empty, 1
    part5_flag_ok = eq part5_ok, 0
    part5_value_ok = eq part5_empty, 1
    empty_count_ok = eq empty_count, 1
    empty_part_flag_ok = eq empty_part_ok, 1
    empty_part_value_ok = eq empty_part_empty, 1
    ok01 = and split_count_ok, part0_flag_ok
    ok02 = and ok01, part0_value_ok
    ok03 = and ok02, part1_flag_ok
    ok04 = and ok03, part1_value_ok
    ok05 = and ok04, part2_flag_ok
    ok06 = and ok05, part2_value_ok
    ok07 = and ok06, part3_flag_ok
    ok08 = and ok07, part3_value_ok
    ok09 = and ok08, part4_flag_ok
    ok10 = and ok09, part4_value_ok
