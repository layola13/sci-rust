    EXPAND STR_CMP_STRING_BUF str_cmp_string_less, word_slice, added_string
    EXPAND STRING_BUF_CMP_STRING cmp_string_equal, added_string, added_string
    EXPAND STRING_BUF_GT_STR string_gt_str, added_string, word_slice
    EXPAND STRING_BUF_GE_STR string_ge_str, added_string, joined_slice
    EXPAND STR_LT_STRING_BUF str_lt_string, word_slice, added_string
    EXPAND STR_LE_STRING_BUF str_le_string, joined_slice, added_string
    EXPAND STR_GT_STRING_BUF str_gt_string, joined_slice, default_string
    EXPAND STR_GE_STRING_BUF str_ge_string, joined_slice, added_string
    EXPAND STRING_BUF_LE_STRING string_le_string, added_string, added_string
    EXPAND STRING_BUF_LT_STRING string_lt_string, default_string, added_string
    EXPAND STRING_BUF_GT_STRING string_gt_string, added_string, default_string
    EXPAND STRING_BUF_GE_STRING string_ge_string, added_string, added_string
    EXPAND STRING_BUF_TRY_INDEX_RANGE index_ok, index_view, added_string, 4, 4
    EXPAND STR_EQ index_eq, index_view, right_slice
    EXPAND STRING_BUF_TRY_INDEX_RANGE_MUT index_mut_ok, index_mut_view, added_string, 4, 4
    EXPAND STR_EQ index_mut_eq, index_mut_view, right_slice

    EXPAND STRING_BUF_FROM_STR assign_string, word_slice
    EXPAND STRING_BUF_ADD_ASSIGN_STR assign_string, right_slice
    EXPAND STRING_BUF_AS_REF_BYTES assign_bytes, assign_string
    EXPAND STR_EQ assign_eq, assign_bytes, joined_slice
    EXPAND STRING_BUF_EQ_STRING eq_string, added_string, assign_string
    EXPAND STRING_BUF_AS_MUT_BYTES assign_mut_bytes, assign_string
    assign_mut_ptr = load assign_mut_bytes+Slice_ptr as ptr
    assign_ptr_range_expected_end = ptr_add assign_mut_ptr, 8
    store assign_mut_ptr+0, 82 as u8
    EXPAND STRING_BUF_AS_MUT_VEC_PTR assign_mut_vec_ptr, assign_string
    assign_mut_vec_data = load assign_mut_vec_ptr+Vec_ptr as ptr
    assign_mut_vec_len = load assign_mut_vec_ptr+Vec_len as u64
    EXPAND STRING_BUF_AS_PTR_RANGE buf_range_start, buf_range_end, assign_string
    EXPAND STRING_BUF_AS_MUT_PTR_RANGE buf_mut_range_start, buf_mut_range_end, assign_string
    EXPAND STRING_BUF_AS_MUT_REF_BYTES assign_mut_ref_bytes, assign_string
    assign_mut_ref_ptr = load assign_mut_ref_bytes+Slice_ptr as ptr
    assign_mut_ref_first = load assign_mut_ref_ptr+0 as u8
    EXPAND STRING_BUF_AS_MUT_STR assign_mut_str_view, assign_string
    EXPAND STR_AS_PTR_RANGE str_range_start, str_range_end, assign_mut_str_view
    EXPAND STR_AS_MUT_PTR_RANGE str_mut_range_start, str_mut_range_end, assign_mut_str_view
    EXPAND STRING_AS_PTR_RANGE string_range_start, string_range_end, assign_mut_str_view
    EXPAND STRING_AS_MUT_PTR_RANGE string_mut_range_start, string_mut_range_end, assign_mut_str_view
    EXPAND STR_AS_MUT_BYTES str_mut_bytes, assign_mut_str_view
    str_mut_ptr = load str_mut_bytes+Slice_ptr as ptr
    str_mut_first = load str_mut_ptr+0 as u8
    EXPAND STRING_AS_MUT_BYTES string_mut_bytes, assign_mut_str_view
    string_mut_ptr = load string_mut_bytes+Slice_ptr as ptr
    string_mut_first = load string_mut_ptr+0 as u8
    EXPAND STRING_BUF_NE_STRING ne_string, added_string, default_string
    EXPAND STRING_BUF_DEREF_MUT_STR deref_mut_view, assign_string
    EXPAND STR_EQ deref_mut_eq, deref_mut_view, mutated_joined_slice

    EXPAND STRING_BUF_FROM_CHAR e_string, 233
    EXPAND STRING_BUF_AS_STR e_view, e_string
    EXPAND STR_EQ e_eq, e_view, e_slice

    EXPAND STRING_BUF_DEFAULT write_string
    EXPAND STRING_BUF_WRITE_STR write_str_ok, write_string, word_slice
    EXPAND STRING_BUF_WRITE_CHAR write_char_ok, write_string, 33
    EXPAND STRING_BUF_AS_STR write_view, write_string
    EXPAND STR_EQ write_eq, write_view, write_expected_slice

    default_ok = eq default_empty, 1
    ok01 = and default_ok, added_eq
    ok02 = and ok01, deref_eq
    ok03 = and ok02, eq_str
    ok04 = and ok03, ne_str
    ok05 = and ok04, str_eq_string
    ok06 = and ok05, str_ne_string
    str_hash_eq = eq str_hash, string_hash
