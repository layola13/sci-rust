@test "sa_std string buffer raw parts macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS left, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS right, &JOIN_RIGHT, 4
    EXPAND STR_FROM_PARTS expected, &JOINED, 8
    EXPAND STRING_BUF_WITH_CAPACITY buf, 8
    EXPAND STRING_BUF_PUSH_STR buf, left
    EXPAND STRING_BUF_PUSH_STR buf, right
    EXPAND STRING_BUF_INTO_RAW_PARTS raw_ptr, raw_len, raw_cap, buf
    raw_ptr_ok = ne raw_ptr, 0
    raw_len_ok = eq raw_len, 8
    raw_cap_ok = uge raw_cap, 8
    EXPAND STRING_BUF_FROM_RAW_PARTS rebound, raw_ptr, raw_len, raw_cap
    EXPAND STRING_BUF_AS_STR view, rebound
    EXPAND STR_EQ content_eq, view, expected
    content_ok = eq content_eq, 1
    ok01 = and raw_ptr_ok, raw_len_ok
    ok02 = and ok01, raw_cap_ok
    ok = and ok02, content_ok
    !left
    !right
    !expected
    !raw_len
    !raw_cap
    !view
    !content_eq
    !raw_ptr_ok
    !raw_len_ok
    !raw_cap_ok
    !content_ok
    !ok01
    !ok02
    EXPAND STRING_BUF_FREE rebound
    br ok -> L_STRING_BUF_RAW_PARTS_OK, L_STRING_BUF_RAW_PARTS_FAIL

L_STRING_BUF_RAW_PARTS_FAIL:
    !ok
    panic(10266)

L_STRING_BUF_RAW_PARTS_OK:
    !ok
    return

@test "sa_std string buffer leak macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS left, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS right, &JOIN_RIGHT, 4
    EXPAND STR_FROM_PARTS expected, &LEAK_MUTATED, 8
    EXPAND STRING_BUF_WITH_CAPACITY buf, 8
    EXPAND STRING_BUF_PUSH_STR buf, left
    EXPAND STRING_BUF_PUSH_STR buf, right
    EXPAND STRING_BUF_LEAK leaked, buf
    EXPAND STR_LEN leaked_len, leaked
    EXPAND STR_PTR leaked_ptr, leaked
    first_before = load leaked_ptr+0 as u8
    store leaked_ptr+0, 82 as u8
    first_after = load leaked_ptr+0 as u8
    EXPAND STR_EQ content_eq, leaked, expected
    len_ok = eq leaked_len, 8
    first_before_ok = eq first_before, 114
    first_after_ok = eq first_after, 82
    content_ok = eq content_eq, 1
    ok01 = and len_ok, first_before_ok
    ok02 = and ok01, first_after_ok
    ok = and ok02, content_ok
    !left
    !right
    !expected
    !leaked_len
    !leaked_ptr
    !first_before
    !first_after
    !content_eq
    !len_ok
    !first_before_ok
    !first_after_ok
    !content_ok
    !ok01
    !ok02
    !leaked
    br ok -> L_STRING_BUF_LEAK_OK, L_STRING_BUF_LEAK_FAIL

L_STRING_BUF_LEAK_FAIL:
    !ok
    panic(1099)

L_STRING_BUF_LEAK_OK:
    !ok
    return

@test "sa_std string buffer into_chars macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS source, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED buf, source
    EXPAND STRING_BUF_INTO_CHARS_U64 chars, buf
    EXPAND STRING_BUF_NEW empty_buf
    EXPAND STRING_BUF_INTO_CHARS_U64 empty_chars, empty_buf
    EXPAND VEC_LEN len, chars
    EXPAND VEC_LEN empty_len, empty_chars
    EXPAND VEC_TRY_GET_U64 first_ok, first, chars, 0
    EXPAND VEC_TRY_GET_U64 second_ok, second, chars, 1
    EXPAND VEC_TRY_GET_U64 third_ok, third, chars, 2
    EXPAND VEC_TRY_GET_U64 fourth_ok, fourth, chars, 3
    EXPAND VEC_TRY_GET_U64 fifth_ok, fifth, chars, 4
    len_ok = eq len, 4
    empty_len_ok = eq empty_len, 0
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first, 97
    second_flag_ok = eq second_ok, 1
    second_value_ok = eq second, 233
    third_flag_ok = eq third_ok, 1
    third_value_ok = eq third, 128578
    fourth_flag_ok = eq fourth_ok, 1
    fourth_value_ok = eq fourth, 122
    fifth_flag_ok = eq fifth_ok, 0
    fifth_value_ok = eq fifth, 0
    ok01 = and len_ok, empty_len_ok
    ok02 = and ok01, first_flag_ok
    ok03 = and ok02, first_value_ok
    ok04 = and ok03, second_flag_ok
    ok05 = and ok04, second_value_ok
    ok06 = and ok05, third_flag_ok
    ok07 = and ok06, third_value_ok
    ok08 = and ok07, fourth_flag_ok
    ok09 = and ok08, fourth_value_ok
    ok10 = and ok09, fifth_flag_ok
    ok = and ok10, fifth_value_ok
    !source
    !len
    !empty_len
    !first_ok
    !first
    !second_ok
    !second
    !third_ok
    !third
    !fourth_ok
    !fourth
    !fifth_ok
    !fifth
    !len_ok
    !empty_len_ok
    !first_flag_ok
    !first_value_ok
    !second_flag_ok
    !second_value_ok
    !third_flag_ok
    !third_value_ok
    !fourth_flag_ok
    !fourth_value_ok
    !fifth_flag_ok
    !fifth_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    EXPAND VEC_FREE empty_chars
    EXPAND VEC_FREE chars
    br ok -> L_STRING_BUF_INTO_CHARS_OK, L_STRING_BUF_INTO_CHARS_FAIL

L_STRING_BUF_INTO_CHARS_FAIL:
    !ok
    panic(1100)

L_STRING_BUF_INTO_CHARS_OK:
    !ok
    return

@test "sa_std string buffer from and extend chars macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS built_expected, &UTF8_CHARS_BUILT, 7
    EXPAND STR_FROM_PARTS extended_expected, &UTF8_CHARS_EXTENDED, 8
    chars_ptr = stack_alloc 24
    store chars_ptr+0, 97 as u64
    store chars_ptr+8, 233 as u64
    store chars_ptr+16, 128578 as u64
    chars_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW chars_slice, chars_ptr, 3

    EXPAND STRING_BUF_TRY_FROM_CHARS_U64 from_ok, from_buf, chars_slice
    EXPAND STRING_BUF_AS_STR from_view, from_buf
    EXPAND STR_EQ from_eq, from_view, built_expected

    EXPAND STRING_BUF_NEW extend_buf
    EXPAND STRING_BUF_EXTEND_CHARS_U64 extend_buf, chars_slice
    EXPAND STRING_BUF_EXTEND_CHAR extend_buf, 33
    EXPAND STRING_BUF_AS_STR extend_view, extend_buf
    EXPAND STR_EQ extend_eq, extend_view, extended_expected

    char_ref_a = stack_alloc 8
    char_ref_e = stack_alloc 8
    char_ref_smile = stack_alloc 8
    store char_ref_a+0, 97 as u64
    store char_ref_e+0, 233 as u64
    store char_ref_smile+0, 128578 as u64
    char_refs_ptr = stack_alloc 24
    store char_refs_ptr+0, char_ref_a as ptr
    store char_refs_ptr+8, char_ref_e as ptr
    store char_refs_ptr+16, char_ref_smile as ptr
    char_refs_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW char_refs_slice, char_refs_ptr, 3
    EXPAND STRING_BUF_TRY_FROM_CHAR_REFS_U64 ref_from_ok, ref_from_buf, char_refs_slice
    EXPAND STRING_BUF_AS_STR ref_from_view, ref_from_buf
    EXPAND STR_EQ ref_from_eq, ref_from_view, built_expected
    EXPAND STRING_BUF_NEW ref_extend_buf
    EXPAND STRING_BUF_EXTEND_CHAR_REFS_U64 ref_extend_buf, char_refs_slice
    EXPAND STRING_BUF_EXTEND_CHAR ref_extend_buf, 33
    EXPAND STRING_BUF_AS_STR ref_extend_view, ref_extend_buf
    EXPAND STR_EQ ref_extend_eq, ref_extend_view, extended_expected

    invalid_ptr = stack_alloc 8
    store invalid_ptr+0, 55296 as u64
    invalid_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW invalid_slice, invalid_ptr, 1
    EXPAND STRING_BUF_TRY_FROM_CHARS_U64 invalid_from_ok, invalid_from_buf, invalid_slice
    EXPAND STRING_BUF_LEN invalid_from_len, invalid_from_buf
    EXPAND STRING_BUF_NEW invalid_extend_buf
    EXPAND STRING_BUF_TRY_EXTEND_CHARS_U64 invalid_extend_ok, invalid_extend_buf, invalid_slice
    EXPAND STRING_BUF_LEN invalid_extend_len, invalid_extend_buf

    invalid_ref_value = stack_alloc 8
    invalid_refs_ptr = stack_alloc 8
    store invalid_ref_value+0, 55296 as u64
    store invalid_refs_ptr+0, invalid_ref_value as ptr
    invalid_refs_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW invalid_refs_slice, invalid_refs_ptr, 1
    EXPAND STRING_BUF_TRY_FROM_CHAR_REFS_U64 invalid_ref_from_ok, invalid_ref_from_buf, invalid_refs_slice
    EXPAND STRING_BUF_LEN invalid_ref_from_len, invalid_ref_from_buf
    EXPAND STRING_BUF_NEW invalid_ref_extend_buf
    EXPAND STRING_BUF_TRY_EXTEND_CHAR_REFS_U64 invalid_ref_extend_ok, invalid_ref_extend_buf, invalid_refs_slice
    EXPAND STRING_BUF_LEN invalid_ref_extend_len, invalid_ref_extend_buf

    from_flag_ok = eq from_ok, 1
    from_value_ok = eq from_eq, 1
    extend_value_ok = eq extend_eq, 1
    ref_from_flag_ok = eq ref_from_ok, 1
    ref_from_value_ok = eq ref_from_eq, 1
    ref_extend_value_ok = eq ref_extend_eq, 1
    invalid_from_flag_ok = eq invalid_from_ok, 0
    invalid_from_empty_ok = eq invalid_from_len, 0
    invalid_extend_flag_ok = eq invalid_extend_ok, 0
    invalid_extend_empty_ok = eq invalid_extend_len, 0
    invalid_ref_from_flag_ok = eq invalid_ref_from_ok, 0
    invalid_ref_from_empty_ok = eq invalid_ref_from_len, 0
    invalid_ref_extend_flag_ok = eq invalid_ref_extend_ok, 0
    invalid_ref_extend_empty_ok = eq invalid_ref_extend_len, 0
    ok01 = and from_flag_ok, from_value_ok
    ok02 = and ok01, extend_value_ok
    ok03 = and ok02, ref_from_flag_ok
    ok04 = and ok03, ref_from_value_ok
    ok05 = and ok04, ref_extend_value_ok
    ok06 = and ok05, invalid_from_flag_ok
    ok07 = and ok06, invalid_from_empty_ok
    ok08 = and ok07, invalid_extend_flag_ok
    ok09 = and ok08, invalid_extend_empty_ok
    ok10 = and ok09, invalid_ref_from_flag_ok
    ok11 = and ok10, invalid_ref_from_empty_ok
    ok12 = and ok11, invalid_ref_extend_flag_ok
    ok = and ok12, invalid_ref_extend_empty_ok
    !from_ok
    !from_view
    !from_eq
    !extend_view
    !extend_eq
    !ref_from_ok
    !ref_from_view
    !ref_from_eq
    !ref_extend_view
    !ref_extend_eq
    !invalid_from_ok
    !invalid_from_len
    !invalid_extend_ok
    !invalid_extend_len
    !invalid_ref_from_ok
    !invalid_ref_from_len
    !invalid_ref_extend_ok
    !invalid_ref_extend_len
    !from_flag_ok
    !from_value_ok
    !extend_value_ok
    !ref_from_flag_ok
    !ref_from_value_ok
    !ref_extend_value_ok
    !invalid_from_flag_ok
    !invalid_from_empty_ok
    !invalid_extend_flag_ok
    !invalid_extend_empty_ok
    !invalid_ref_from_flag_ok
    !invalid_ref_from_empty_ok
    !invalid_ref_extend_flag_ok
    !invalid_ref_extend_empty_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    EXPAND STRING_BUF_FREE invalid_ref_extend_buf
    EXPAND STRING_BUF_FREE invalid_ref_from_buf
    EXPAND STRING_BUF_FREE invalid_extend_buf
    EXPAND STRING_BUF_FREE invalid_from_buf
    EXPAND STRING_BUF_FREE ref_extend_buf
    EXPAND STRING_BUF_FREE ref_from_buf
    EXPAND STRING_BUF_FREE extend_buf
    EXPAND STRING_BUF_FREE from_buf
    !invalid_refs_slice
    !invalid_slice
    !char_refs_slice
    !chars_slice
    !extended_expected
    !built_expected
    br ok -> L_STRING_BUF_FROM_CHARS_OK, L_STRING_BUF_FROM_CHARS_FAIL

L_STRING_BUF_FROM_CHARS_FAIL:
    !ok
    panic(10267)

L_STRING_BUF_FROM_CHARS_OK:
    !ok
    return

@test "sa_std string buffer ascii char iterator aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS expected, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS extended_expected, &WRITE_EXPECTED, 5

    ascii_data = stack_alloc 4
    store ascii_data+0, 114 as u8
    store ascii_data+1, 117 as u8
    store ascii_data+2, 115 as u8
    store ascii_data+3, 116 as u8
    ascii_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW ascii_slice, ascii_data, 4
    EXPAND STRING_BUF_TRY_FROM_ASCII_CHARS from_ok, from_buf, ascii_slice
    EXPAND STRING_BUF_AS_STR from_view, from_buf
    EXPAND STR_EQ from_eq, from_view, expected
    EXPAND STRING_BUF_NEW extend_buf
    EXPAND STRING_BUF_EXTEND_ASCII_CHARS extend_buf, ascii_slice
    EXPAND STRING_BUF_EXTEND_CHAR extend_buf, 33
    EXPAND STRING_BUF_AS_STR extend_view, extend_buf
    EXPAND STR_EQ extend_eq, extend_view, extended_expected

    ascii_ref_r = stack_alloc 1
    ascii_ref_u = stack_alloc 1
    ascii_ref_s = stack_alloc 1
    ascii_ref_t = stack_alloc 1
    store ascii_ref_r+0, 114 as u8
    store ascii_ref_u+0, 117 as u8
    store ascii_ref_s+0, 115 as u8
    store ascii_ref_t+0, 116 as u8
    ascii_refs_ptr = stack_alloc 32
    store ascii_refs_ptr+0, ascii_ref_r as ptr
    store ascii_refs_ptr+8, ascii_ref_u as ptr
    store ascii_refs_ptr+16, ascii_ref_s as ptr
    store ascii_refs_ptr+24, ascii_ref_t as ptr
    ascii_refs_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW ascii_refs_slice, ascii_refs_ptr, 4
    EXPAND STRING_BUF_TRY_FROM_ASCII_CHAR_REFS ref_from_ok, ref_from_buf, ascii_refs_slice
    EXPAND STRING_BUF_AS_STR ref_from_view, ref_from_buf
    EXPAND STR_EQ ref_from_eq, ref_from_view, expected
    EXPAND STRING_BUF_NEW ref_extend_buf
    EXPAND STRING_BUF_EXTEND_ASCII_CHAR_REFS ref_extend_buf, ascii_refs_slice
    EXPAND STRING_BUF_EXTEND_CHAR ref_extend_buf, 33
    EXPAND STRING_BUF_AS_STR ref_extend_view, ref_extend_buf
    EXPAND STR_EQ ref_extend_eq, ref_extend_view, extended_expected

    invalid_ascii_data = stack_alloc 1
    store invalid_ascii_data+0, 200 as u8
    invalid_ascii_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW invalid_ascii_slice, invalid_ascii_data, 1
    EXPAND STRING_BUF_TRY_FROM_ASCII_CHARS invalid_from_ok, invalid_from_buf, invalid_ascii_slice
    EXPAND STRING_BUF_LEN invalid_from_len, invalid_from_buf
    EXPAND STRING_BUF_NEW invalid_extend_buf
    EXPAND STRING_BUF_TRY_EXTEND_ASCII_CHARS invalid_extend_ok, invalid_extend_buf, invalid_ascii_slice
    EXPAND STRING_BUF_LEN invalid_extend_len, invalid_extend_buf

    invalid_ascii_ref = stack_alloc 1
    invalid_ascii_refs_ptr = stack_alloc 8
    store invalid_ascii_ref+0, 200 as u8
    store invalid_ascii_refs_ptr+0, invalid_ascii_ref as ptr
    invalid_ascii_refs_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW invalid_ascii_refs_slice, invalid_ascii_refs_ptr, 1
    EXPAND STRING_BUF_TRY_FROM_ASCII_CHAR_REFS invalid_ref_from_ok, invalid_ref_from_buf, invalid_ascii_refs_slice
    EXPAND STRING_BUF_LEN invalid_ref_from_len, invalid_ref_from_buf
    EXPAND STRING_BUF_NEW invalid_ref_extend_buf
    EXPAND STRING_BUF_TRY_EXTEND_ASCII_CHAR_REFS invalid_ref_extend_ok, invalid_ref_extend_buf, invalid_ascii_refs_slice
    EXPAND STRING_BUF_LEN invalid_ref_extend_len, invalid_ref_extend_buf

    from_flag_ok = eq from_ok, 1
    from_value_ok = eq from_eq, 1
    extend_value_ok = eq extend_eq, 1
    ref_from_flag_ok = eq ref_from_ok, 1
    ref_from_value_ok = eq ref_from_eq, 1
    ref_extend_value_ok = eq ref_extend_eq, 1
    invalid_from_flag_ok = eq invalid_from_ok, 0
    invalid_from_empty_ok = eq invalid_from_len, 0
    invalid_extend_flag_ok = eq invalid_extend_ok, 0
    invalid_extend_empty_ok = eq invalid_extend_len, 0
    invalid_ref_from_flag_ok = eq invalid_ref_from_ok, 0
    invalid_ref_from_empty_ok = eq invalid_ref_from_len, 0
    invalid_ref_extend_flag_ok = eq invalid_ref_extend_ok, 0
    invalid_ref_extend_empty_ok = eq invalid_ref_extend_len, 0
    ok01 = and from_flag_ok, from_value_ok
    ok02 = and ok01, extend_value_ok
    ok03 = and ok02, ref_from_flag_ok
    ok04 = and ok03, ref_from_value_ok
    ok05 = and ok04, ref_extend_value_ok
    ok06 = and ok05, invalid_from_flag_ok
    ok07 = and ok06, invalid_from_empty_ok
    ok08 = and ok07, invalid_extend_flag_ok
    ok09 = and ok08, invalid_extend_empty_ok
    ok10 = and ok09, invalid_ref_from_flag_ok
    ok11 = and ok10, invalid_ref_from_empty_ok
    ok12 = and ok11, invalid_ref_extend_flag_ok
    ok = and ok12, invalid_ref_extend_empty_ok
    !from_ok
    !from_view
    !from_eq
    !extend_view
    !extend_eq
    !ref_from_ok
    !ref_from_view
    !ref_from_eq
    !ref_extend_view
    !ref_extend_eq
    !invalid_from_ok
    !invalid_from_len
    !invalid_extend_ok
    !invalid_extend_len
    !invalid_ref_from_ok
    !invalid_ref_from_len
    !invalid_ref_extend_ok
    !invalid_ref_extend_len
    !from_flag_ok
    !from_value_ok
    !extend_value_ok
    !ref_from_flag_ok
    !ref_from_value_ok
    !ref_extend_value_ok
    !invalid_from_flag_ok
    !invalid_from_empty_ok
    !invalid_extend_flag_ok
    !invalid_extend_empty_ok
    !invalid_ref_from_flag_ok
    !invalid_ref_from_empty_ok
    !invalid_ref_extend_flag_ok
    !invalid_ref_extend_empty_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    EXPAND STRING_BUF_FREE invalid_ref_extend_buf
    EXPAND STRING_BUF_FREE invalid_ref_from_buf
    EXPAND STRING_BUF_FREE invalid_extend_buf
    EXPAND STRING_BUF_FREE invalid_from_buf
    EXPAND STRING_BUF_FREE ref_extend_buf
    EXPAND STRING_BUF_FREE ref_from_buf
    EXPAND STRING_BUF_FREE extend_buf
    EXPAND STRING_BUF_FREE from_buf
    !invalid_ascii_refs_slice
    !invalid_ascii_slice
    !ascii_refs_slice
    !ascii_slice
    !extended_expected
    !expected
    br ok -> L_STRING_ASCII_ITER_OK, L_STRING_ASCII_ITER_FAIL

L_STRING_ASCII_ITER_FAIL:
    !ok
    panic(10268)

L_STRING_ASCII_ITER_OK:
    !ok
    return

@test "sa_std string buffer from_utf16 macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS expected, &UTF8_BOUNDARY_TEXT, 8
    valid_ptr = stack_alloc 10
    store valid_ptr+0, 97 as u16
    store valid_ptr+2, 233 as u16
    store valid_ptr+4, 55357 as u16
    store valid_ptr+6, 56898 as u16
    store valid_ptr+8, 122 as u16
    EXPAND STR_FROM_PARTS valid_units, valid_ptr, 5
    high_bad_ptr = stack_alloc 4
    store high_bad_ptr+0, 97 as u16
    store high_bad_ptr+2, 55357 as u16
    EXPAND STR_FROM_PARTS high_bad_units, high_bad_ptr, 2
    low_bad_ptr = stack_alloc 2
    store low_bad_ptr+0, 56898 as u16
    EXPAND STR_FROM_PARTS low_bad_units, low_bad_ptr, 1
    EXPAND STRING_BUF_FROM_UTF16 valid_ok, valid_buf, valid_units
    EXPAND STRING_BUF_AS_STR valid_view, valid_buf
    EXPAND STR_EQ valid_eq, valid_view, expected
    EXPAND STRING_BUF_FROM_UTF16 high_bad_ok, high_bad_buf, high_bad_units
    EXPAND STRING_BUF_LEN high_bad_len, high_bad_buf
    EXPAND STRING_BUF_FROM_UTF16 low_bad_ok, low_bad_buf, low_bad_units
    EXPAND STRING_BUF_LEN low_bad_len, low_bad_buf
    valid_flag_ok = eq valid_ok, 1
    valid_value_ok = eq valid_eq, 1
    high_bad_flag_ok = eq high_bad_ok, 0
    high_bad_empty_ok = eq high_bad_len, 0
    low_bad_flag_ok = eq low_bad_ok, 0
    low_bad_empty_ok = eq low_bad_len, 0
    ok01 = and valid_flag_ok, valid_value_ok
    ok02 = and ok01, high_bad_flag_ok
    ok03 = and ok02, high_bad_empty_ok
    ok04 = and ok03, low_bad_flag_ok
    ok = and ok04, low_bad_empty_ok
    !expected
    !valid_units
    !high_bad_units
    !low_bad_units
    !valid_ok
    !valid_view
    !valid_eq
    !high_bad_ok
    !high_bad_len
    !low_bad_ok
    !low_bad_len
    !valid_flag_ok
    !valid_value_ok
    !high_bad_flag_ok
    !high_bad_empty_ok
    !low_bad_flag_ok
    !low_bad_empty_ok
    !ok01
    !ok02
    !ok03
    !ok04
    EXPAND STRING_BUF_FREE low_bad_buf
    EXPAND STRING_BUF_FREE high_bad_buf
    EXPAND STRING_BUF_FREE valid_buf
    br ok -> L_STRING_BUF_FROM_UTF16_OK, L_STRING_BUF_FROM_UTF16_FAIL

L_STRING_BUF_FROM_UTF16_FAIL:
    !ok
    panic(1101)

L_STRING_BUF_FROM_UTF16_OK:
    !ok
    return

@test "sa_std string buffer from_utf16 lossy macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS expected, &UTF16_LOSSY_EXPECTED, 8
    lossy_ptr = stack_alloc 10
    store lossy_ptr+0, 97 as u16
    store lossy_ptr+2, 55357 as u16
    store lossy_ptr+4, 122 as u16
    store lossy_ptr+6, 56898 as u16
    store lossy_ptr+8, 0 as u16
    EXPAND STR_FROM_PARTS lossy_units, lossy_ptr, 4
    valid_ptr = stack_alloc 10
    store valid_ptr+0, 97 as u16
    store valid_ptr+2, 233 as u16
    store valid_ptr+4, 55357 as u16
    store valid_ptr+6, 56898 as u16
    store valid_ptr+8, 122 as u16
    EXPAND STR_FROM_PARTS valid_units, valid_ptr, 5
    EXPAND STR_FROM_PARTS valid_expected, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STRING_BUF_FROM_UTF16_LOSSY lossy_buf, lossy_units
    EXPAND STRING_BUF_AS_STR lossy_view, lossy_buf
    EXPAND STR_EQ lossy_eq, lossy_view, expected
    EXPAND STRING_BUF_FROM_UTF16_LOSSY valid_buf, valid_units
    EXPAND STRING_BUF_AS_STR valid_view, valid_buf
    EXPAND STR_EQ valid_eq, valid_view, valid_expected
    lossy_ok = eq lossy_eq, 1
    valid_ok = eq valid_eq, 1
    ok = and lossy_ok, valid_ok
    !expected
    !lossy_units
    !valid_units
    !valid_expected
    !lossy_view
    !lossy_eq
    !valid_view
    !valid_eq
    !lossy_ok
    !valid_ok
    EXPAND STRING_BUF_FREE valid_buf
    EXPAND STRING_BUF_FREE lossy_buf
