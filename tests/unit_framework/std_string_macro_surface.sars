    EXPAND STRING_BUF_TRY_INSERT_BYTE insert_miss_ok, string_buf, 99, 63
    EXPAND STRING_BUF_TRY_INSERT_STR insert_str_miss_ok, string_buf, 99, insert_text
    EXPAND STRING_BUF_TRY_REPLACE_RANGE replace_miss_ok, string_buf, 6, 99, replace_text
    EXPAND STRING_BUF_CLEAR string_buf
