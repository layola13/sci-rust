@test "sa_std string split ascii whitespace aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS ws_text, &ASCII_WS_TEXT, 17
    EXPAND STR_FROM_PARTS expected_rust, &ASCII_WS_RUST, 4
    EXPAND STR_FROM_PARTS expected_std, &ASCII_WS_STD, 3
