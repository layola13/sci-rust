    EXPAND STR_TRY_STRIP_SUFFIX_CHAR s_invalid_ok, s_invalid, hay, 55296
    EXPAND STR_TRY_STRIP_SUFFIX_CHAR ms_ok, ms_part, multi_hay, 233
    EXPAND STRING_BUF_STRIP_SUFFIX_CHAR ms_ok_b, ms_part_b, multi_buf, 233

    EXPAND STR_EQ p_eq, p_part, prefix_expected
    EXPAND STR_EQ p_eq_s, p_part_s, prefix_expected
    EXPAND STR_EQ p_eq_b, p_part_b, prefix_expected
    EXPAND STR_EQ p_eq_u, p_part_u, prefix_expected
    EXPAND STR_EQ p_eq_su, p_part_su, prefix_expected
    EXPAND STR_EQ p_eq_bu, p_part_bu, prefix_expected
    EXPAND STR_EQ mp_eq, mp_part, multi_prefix_expected
    EXPAND STR_EQ mp_eq_b, mp_part_b, multi_prefix_expected
    EXPAND STR_EQ s_eq, s_part, suffix_expected
    EXPAND STR_EQ s_eq_s, s_part_s, suffix_expected
    EXPAND STR_EQ s_eq_b, s_part_b, suffix_expected
    EXPAND STR_EQ s_eq_u, s_part_u, suffix_expected
    EXPAND STR_EQ s_eq_su, s_part_su, suffix_expected
    EXPAND STR_EQ s_eq_bu, s_part_bu, suffix_expected
    EXPAND STR_EQ ms_eq, ms_part, multi_suffix_expected
    EXPAND STR_EQ ms_eq_b, ms_part_b, multi_suffix_expected
    EXPAND STR_IS_EMPTY p_miss_empty, p_miss
    EXPAND STR_IS_EMPTY p_invalid_empty, p_invalid
    EXPAND STR_IS_EMPTY s_miss_empty, s_miss
    EXPAND STR_IS_EMPTY s_invalid_empty, s_invalid

    starts_miss_ok = eq starts_miss, 0
    starts_invalid_ok = eq starts_invalid, 0
    ends_miss_ok = eq ends_miss, 0
    ends_invalid_ok = eq ends_invalid, 0
    p_miss_flag = eq p_miss_ok, 0
