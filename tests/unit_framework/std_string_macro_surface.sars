@test "sa_std string split once char aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS pathish, &PATHISH, 5
    EXPAND STR_FROM_PARTS left_exp, &PATH_LEFT, 1
    EXPAND STR_FROM_PARTS right_exp, &PATH_RIGHT, 3
    EXPAND STR_FROM_PARTS rleft_exp, &PATH_RLEFT, 3
    EXPAND STR_FROM_PARTS rright_exp, &PATH_RRIGHT, 1
    EXPAND STR_FROM_PARTS multi_hay, &CHAR_HAY_MULTI, 6
    EXPAND STR_FROM_PARTS multi_left_exp, &MULTI_PART0, 1
    EXPAND STR_FROM_PARTS multi_right_exp, &UTF8_A_E, 3
    EXPAND STR_FROM_PARTS multi_rleft_exp, &CHAR_HAY_MULTI, 4
    EXPAND STRING_BUF_FROM_STR path_buf, pathish
    EXPAND STRING_BUF_FROM_STR multi_buf, multi_hay

    EXPAND STR_TRY_SPLIT_ONCE_CHAR ok0, left0, right0, pathish, 58
    EXPAND STRING_TRY_SPLIT_ONCE_CHAR ok1t, left1t, right1t, pathish, 58
    EXPAND STRING_BUF_TRY_SPLIT_ONCE_CHAR ok1bt, left1bt, right1bt, path_buf, 58
    EXPAND STR_SPLIT_ONCE_CHAR ok0u, left0u, right0u, pathish, 58
    EXPAND STRING_SPLIT_ONCE_CHAR ok1u, left1u, right1u, pathish, 58
    EXPAND STRING_BUF_SPLIT_ONCE_CHAR ok1bu, left1bu, right1bu, path_buf, 58

    EXPAND STR_TRY_RSPLIT_ONCE_CHAR rok0, rleft0, rright0, pathish, 58
    EXPAND STRING_TRY_RSPLIT_ONCE_CHAR rok1t, rleft1t, rright1t, pathish, 58
    EXPAND STRING_BUF_TRY_RSPLIT_ONCE_CHAR rok1bt, rleft1bt, rright1bt, path_buf, 58
    EXPAND STR_RSPLIT_ONCE_CHAR rok0u, rleft0u, rright0u, pathish, 58
    EXPAND STRING_RSPLIT_ONCE_CHAR rok1u, rleft1u, rright1u, pathish, 58
    EXPAND STRING_BUF_RSPLIT_ONCE_CHAR rok1bu, rleft1bu, rright1bu, path_buf, 58

    EXPAND STR_TRY_SPLIT_ONCE_CHAR ok_multi, left_multi, right_multi, multi_hay, 233
    EXPAND STR_TRY_RSPLIT_ONCE_CHAR rok_multi, rleft_multi, rright_multi, multi_hay, 233
    EXPAND STRING_BUF_RSPLIT_ONCE_CHAR rok_multi_b, rleft_multi_b, rright_multi_b, multi_buf, 233
    EXPAND STR_TRY_SPLIT_ONCE_CHAR ok_invalid, left_invalid, right_invalid, pathish, 55296
    EXPAND STR_TRY_RSPLIT_ONCE_CHAR rok_invalid, rleft_invalid, rright_invalid, pathish, 55296

    EXPAND STR_EQ eq_left0, left0, left_exp
    EXPAND STR_EQ eq_right0, right0, right_exp
    EXPAND STR_EQ eq_left1t, left1t, left_exp
    EXPAND STR_EQ eq_right1t, right1t, right_exp
    EXPAND STR_EQ eq_left1bt, left1bt, left_exp
    EXPAND STR_EQ eq_right1bt, right1bt, right_exp
    EXPAND STR_EQ eq_left0u, left0u, left_exp
    EXPAND STR_EQ eq_right0u, right0u, right_exp
    EXPAND STR_EQ eq_left1u, left1u, left_exp
    EXPAND STR_EQ eq_right1u, right1u, right_exp
    EXPAND STR_EQ eq_left1bu, left1bu, left_exp
    EXPAND STR_EQ eq_right1bu, right1bu, right_exp
    EXPAND STR_EQ eq_rleft0, rleft0, rleft_exp
    EXPAND STR_EQ eq_rright0, rright0, rright_exp
    EXPAND STR_EQ eq_rleft1t, rleft1t, rleft_exp
    EXPAND STR_EQ eq_rright1t, rright1t, rright_exp
    EXPAND STR_EQ eq_rleft1bt, rleft1bt, rleft_exp
    EXPAND STR_EQ eq_rright1bt, rright1bt, rright_exp
    EXPAND STR_EQ eq_rleft0u, rleft0u, rleft_exp
    EXPAND STR_EQ eq_rright0u, rright0u, rright_exp
    EXPAND STR_EQ eq_rleft1u, rleft1u, rleft_exp
    EXPAND STR_EQ eq_rright1u, rright1u, rright_exp
    EXPAND STR_EQ eq_rleft1bu, rleft1bu, rleft_exp
    EXPAND STR_EQ eq_rright1bu, rright1bu, rright_exp
    EXPAND STR_EQ eq_multi_left, left_multi, multi_left_exp
    EXPAND STR_EQ eq_multi_right, right_multi, multi_right_exp
    EXPAND STR_EQ eq_rmulti_left, rleft_multi, multi_rleft_exp
    EXPAND STR_IS_EMPTY rmulti_right_empty, rright_multi
    EXPAND STR_EQ eq_rmulti_left_b, rleft_multi_b, multi_rleft_exp
    EXPAND STR_IS_EMPTY rmulti_right_b_empty, rright_multi_b
    EXPAND STR_IS_EMPTY invalid_left_empty, left_invalid
    EXPAND STR_IS_EMPTY invalid_right_empty, right_invalid
    EXPAND STR_IS_EMPTY rinvalid_left_empty, rleft_invalid
    EXPAND STR_IS_EMPTY rinvalid_right_empty, rright_invalid

    ok0_flag = eq ok0, 1
    ok1t_flag = eq ok1t, 1
    ok1bt_flag = eq ok1bt, 1
    ok0u_flag = eq ok0u, 1
    ok1u_flag = eq ok1u, 1
    ok1bu_flag = eq ok1bu, 1
    rok0_flag = eq rok0, 1
    rok1t_flag = eq rok1t, 1
    rok1bt_flag = eq rok1bt, 1
    rok0u_flag = eq rok0u, 1
    rok1u_flag = eq rok1u, 1
    rok1bu_flag = eq rok1bu, 1
    ok_multi_flag = eq ok_multi, 1
    rok_multi_flag = eq rok_multi, 1
    rok_multi_b_flag = eq rok_multi_b, 1
    ok_invalid_flag = eq ok_invalid, 0
    rok_invalid_flag = eq rok_invalid, 0

    ok = and ok0_flag, ok1t_flag
    ok = and ok, ok1bt_flag
    ok = and ok, ok0u_flag
    ok = and ok, ok1u_flag
    ok = and ok, ok1bu_flag
    ok = and ok, rok0_flag
    ok = and ok, rok1t_flag
    ok = and ok, rok1bt_flag
    ok = and ok, rok0u_flag
    ok = and ok, rok1u_flag
    ok = and ok, rok1bu_flag
    ok = and ok, ok_multi_flag
    ok = and ok, rok_multi_flag
    ok = and ok, rok_multi_b_flag
    ok = and ok, ok_invalid_flag
    ok = and ok, rok_invalid_flag
    ok = and ok, eq_left0
    ok = and ok, eq_right0
    ok = and ok, eq_left1t
    ok = and ok, eq_right1t
    ok = and ok, eq_left1bt
    ok = and ok, eq_right1bt
    ok = and ok, eq_left0u
    ok = and ok, eq_right0u
    ok = and ok, eq_left1u
    ok = and ok, eq_right1u
    ok = and ok, eq_left1bu
    ok = and ok, eq_right1bu
    ok = and ok, eq_rleft0
    ok = and ok, eq_rright0
    ok = and ok, eq_rleft1t
    ok = and ok, eq_rright1t
    ok = and ok, eq_rleft1bt
    ok = and ok, eq_rright1bt
    ok = and ok, eq_rleft0u
    ok = and ok, eq_rright0u
    ok = and ok, eq_rleft1u
    ok = and ok, eq_rright1u
    ok = and ok, eq_rleft1bu
    ok = and ok, eq_rright1bu
    ok = and ok, eq_multi_left
    ok = and ok, eq_multi_right
    ok = and ok, eq_rmulti_left
    ok = and ok, rmulti_right_empty
    ok = and ok, eq_rmulti_left_b
    ok = and ok, rmulti_right_b_empty
    ok = and ok, invalid_left_empty
    ok = and ok, invalid_right_empty
    ok = and ok, rinvalid_left_empty
    ok = and ok, rinvalid_right_empty

    EXPAND STRING_BUF_FREE path_buf
    EXPAND STRING_BUF_FREE multi_buf
    br ok -> L_SPLIT_ONCE_CHAR_OK, L_SPLIT_ONCE_CHAR_FAIL

L_SPLIT_ONCE_CHAR_FAIL:
    !ok
    panic(10254)

L_SPLIT_ONCE_CHAR_OK:
    !ok
    return

@test "sa_std string ascii case conversion macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS mixed_utf8, &MIXED_UTF8_WORD, 7
    EXPAND STR_FROM_PARTS upper_utf8, &UPPER_UTF8_WORD, 7
    EXPAND STR_FROM_PARTS lower_utf8, &LOWER_UTF8_WORD, 7
    EXPAND STRING_BUF_FROM_STR make_upper_buf, mixed_utf8
    EXPAND STRING_BUF_FROM_STR make_lower_buf, mixed_utf8
    EXPAND STRING_BUF_AS_MUT_STR make_upper_view, make_upper_buf
    EXPAND STRING_BUF_AS_MUT_STR make_lower_view, make_lower_buf
    EXPAND STR_MAKE_ASCII_UPPERCASE make_upper_ok, make_upper_view
    EXPAND STRING_MAKE_ASCII_LOWERCASE make_lower_ok, make_lower_view
    EXPAND STR_TO_ASCII_UPPERCASE copied_upper, mixed_utf8
    EXPAND STRING_TO_ASCII_LOWERCASE copied_lower, mixed_utf8
    EXPAND STRING_BUF_AS_STR upper_after, make_upper_buf
    EXPAND STRING_BUF_AS_STR lower_after, make_lower_buf
    EXPAND STRING_BUF_AS_STR copied_upper_view, copied_upper
    EXPAND STRING_BUF_AS_STR copied_lower_view, copied_lower
    EXPAND STR_EQ upper_after_eq, upper_after, upper_utf8
    EXPAND STR_EQ lower_after_eq, lower_after, lower_utf8
    EXPAND STR_EQ copied_upper_eq, copied_upper_view, upper_utf8
    EXPAND STR_EQ copied_lower_eq, copied_lower_view, lower_utf8

    make_upper_flag_ok = eq make_upper_ok, 1
    make_lower_flag_ok = eq make_lower_ok, 1
    upper_value_ok = eq upper_after_eq, 1
    lower_value_ok = eq lower_after_eq, 1
    copied_upper_value_ok = eq copied_upper_eq, 1
    copied_lower_value_ok = eq copied_lower_eq, 1
    ok01 = and make_upper_flag_ok, make_lower_flag_ok
    ok02 = and ok01, upper_value_ok
    ok03 = and ok02, lower_value_ok
    ok04 = and ok03, copied_upper_value_ok
    ok = and ok04, copied_lower_value_ok
    EXPAND STRING_BUF_FREE make_upper_buf
    EXPAND STRING_BUF_FREE make_lower_buf
    EXPAND STRING_BUF_FREE copied_upper
    EXPAND STRING_BUF_FREE copied_lower
    !mixed_utf8
    !upper_utf8
    !lower_utf8
    !make_upper_view
    !make_lower_view
    !make_upper_ok
    !make_lower_ok
    !upper_after
    !lower_after
    !copied_upper_view
    !copied_lower_view
    !upper_after_eq
    !lower_after_eq
    !copied_upper_eq
    !copied_lower_eq
    !make_upper_flag_ok
    !make_lower_flag_ok
    !upper_value_ok
    !lower_value_ok
    !copied_upper_value_ok
    !copied_lower_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    br ok -> L_STRING_ASCII_CASE_CONVERSION_OK, L_STRING_ASCII_CASE_CONVERSION_FAIL

L_STRING_ASCII_CASE_CONVERSION_FAIL:
    !ok
    panic(10255)

L_STRING_ASCII_CASE_CONVERSION_OK:
    !ok
    return

@test "sa_std string as_ascii aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word, &WORD, 4
    EXPAND STR_FROM_PARTS utf8_boundary, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STR_AS_ASCII str_ascii_ok, str_ascii, word
    EXPAND STRING_AS_ASCII string_ascii_ok, string_ascii, word
    EXPAND STR_AS_ASCII str_utf8_ok, str_utf8_ascii, utf8_boundary
    EXPAND STRING_AS_ASCII_UNCHECKED string_unchecked, utf8_boundary
    EXPAND STRING_BUF_FROM_STR owned_word, word
    EXPAND STRING_BUF_FROM_STR owned_utf8, utf8_boundary
    EXPAND STRING_BUF_AS_ASCII buf_ascii_ok, buf_ascii, owned_word
    EXPAND STRING_BUF_AS_ASCII buf_utf8_ok, buf_utf8_ascii, owned_utf8
    EXPAND STRING_BUF_AS_ASCII_UNCHECKED buf_unchecked, owned_utf8
    word_ptr = load word+Slice_ptr as ptr
    utf8_ptr = load utf8_boundary+Slice_ptr as ptr
    EXPAND STRING_BUF_AS_PTR owned_word_ptr, owned_word
    EXPAND STRING_BUF_AS_PTR owned_utf8_ptr, owned_utf8
    null_ptr = 0 as ptr

    str_ascii_ptr = load str_ascii+Slice_ptr as ptr
    str_ascii_len = load str_ascii+Slice_len as u64
    string_ascii_ptr = load string_ascii+Slice_ptr as ptr
    string_ascii_len = load string_ascii+Slice_len as u64
    str_utf8_ptr = load str_utf8_ascii+Slice_ptr as ptr
    str_utf8_len = load str_utf8_ascii+Slice_len as u64
    unchecked_ptr = load string_unchecked+Slice_ptr as ptr
    unchecked_len = load string_unchecked+Slice_len as u64
    buf_ascii_ptr = load buf_ascii+Slice_ptr as ptr
    buf_ascii_len = load buf_ascii+Slice_len as u64
    buf_utf8_ptr = load buf_utf8_ascii+Slice_ptr as ptr
    buf_utf8_len = load buf_utf8_ascii+Slice_len as u64
    buf_unchecked_ptr = load buf_unchecked+Slice_ptr as ptr
    buf_unchecked_len = load buf_unchecked+Slice_len as u64

    str_ascii_flag_ok = eq str_ascii_ok, 1
    string_ascii_flag_ok = eq string_ascii_ok, 1
    str_utf8_flag_ok = eq str_utf8_ok, 0
    buf_ascii_flag_ok = eq buf_ascii_ok, 1
    buf_utf8_flag_ok = eq buf_utf8_ok, 0
    str_ascii_ptr_ok = eq str_ascii_ptr, word_ptr
    str_ascii_len_ok = eq str_ascii_len, 4
    string_ascii_ptr_ok = eq string_ascii_ptr, word_ptr
    string_ascii_len_ok = eq string_ascii_len, 4
    str_utf8_ptr_ok = eq str_utf8_ptr, null_ptr
    str_utf8_len_ok = eq str_utf8_len, 0
    unchecked_ptr_ok = eq unchecked_ptr, utf8_ptr
    unchecked_len_ok = eq unchecked_len, 8
    buf_ascii_ptr_ok = eq buf_ascii_ptr, owned_word_ptr
    buf_ascii_len_ok = eq buf_ascii_len, 4
    buf_utf8_ptr_ok = eq buf_utf8_ptr, null_ptr
    buf_utf8_len_ok = eq buf_utf8_len, 0
    buf_unchecked_ptr_ok = eq buf_unchecked_ptr, owned_utf8_ptr
    buf_unchecked_len_ok = eq buf_unchecked_len, 8

    ok01 = and str_ascii_flag_ok, string_ascii_flag_ok
    ok02 = and ok01, str_utf8_flag_ok
    ok03 = and ok02, buf_ascii_flag_ok
    ok04 = and ok03, buf_utf8_flag_ok
    ok05 = and ok04, str_ascii_ptr_ok
    ok06 = and ok05, str_ascii_len_ok
    ok07 = and ok06, string_ascii_ptr_ok
    ok08 = and ok07, string_ascii_len_ok
    ok09 = and ok08, str_utf8_ptr_ok
    ok10 = and ok09, str_utf8_len_ok
    ok11 = and ok10, unchecked_ptr_ok
    ok12 = and ok11, unchecked_len_ok
    ok13 = and ok12, buf_ascii_ptr_ok
    ok14 = and ok13, buf_ascii_len_ok
    ok15 = and ok14, buf_utf8_ptr_ok
    ok16 = and ok15, buf_utf8_len_ok
    ok17 = and ok16, buf_unchecked_ptr_ok
    ok = and ok17, buf_unchecked_len_ok
    EXPAND STRING_BUF_FREE owned_word
    EXPAND STRING_BUF_FREE owned_utf8
    !word
    !utf8_boundary
    !str_ascii_ok
    !str_ascii
    !string_ascii_ok
    !string_ascii
    !str_utf8_ok
    !str_utf8_ascii
    !string_unchecked
    !buf_ascii_ok
    !buf_ascii
    !buf_utf8_ok
    !buf_utf8_ascii
    !buf_unchecked
    !word_ptr
    !utf8_ptr
    !owned_word_ptr
    !owned_utf8_ptr
    !null_ptr
    !str_ascii_ptr
    !str_ascii_len
    !string_ascii_ptr
    !string_ascii_len
    !str_utf8_ptr
    !str_utf8_len
    !unchecked_ptr
    !unchecked_len
    !buf_ascii_ptr
    !buf_ascii_len
    !buf_utf8_ptr
    !buf_utf8_len
    !buf_unchecked_ptr
    !buf_unchecked_len
    !str_ascii_flag_ok
    !string_ascii_flag_ok
    !str_utf8_flag_ok
    !buf_ascii_flag_ok
    !buf_utf8_flag_ok
    !str_ascii_ptr_ok
    !str_ascii_len_ok
    !string_ascii_ptr_ok
    !string_ascii_len_ok
    !str_utf8_ptr_ok
    !str_utf8_len_ok
    !unchecked_ptr_ok
    !unchecked_len_ok
    !buf_ascii_ptr_ok
    !buf_ascii_len_ok
    !buf_utf8_ptr_ok
    !buf_utf8_len_ok
    !buf_unchecked_ptr_ok
    !buf_unchecked_len_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    br ok -> L_STRING_AS_ASCII_ALIAS_OK, L_STRING_AS_ASCII_ALIAS_FAIL

L_STRING_AS_ASCII_ALIAS_FAIL:
    !ok
    panic(10256)

L_STRING_AS_ASCII_ALIAS_OK:
    !ok
    return

@test "sa_std string from_utf8 view aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS valid_bytes, &UTF8_BOUNDARY_TEXT, 8
    invalid_data = stack_alloc 2
