    ok06 = and ok05, line2_value_ok
    ok07 = and ok06, line3_flag_ok
    ok08 = and ok07, line3_value_ok
    ok09 = and ok08, no_trail_count_ok
    ok10 = and ok09, no_trail_0_flag_ok
    ok11 = and ok10, no_trail_0_value_ok
    ok12 = and ok11, no_trail_1_flag_ok
    ok13 = and ok12, no_trail_1_value_ok
    ok14 = and ok13, empty_count_ok
    ok15 = and ok14, empty_line_flag_ok
    ok = and ok15, empty_line_value_ok
