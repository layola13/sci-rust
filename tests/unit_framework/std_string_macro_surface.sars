@test "sa_std string split inclusive char aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS hay_colon, &CHAR_HAY_COLON_COUNT, 5
    EXPAND STR_FROM_PARTS hay_multi, &CHAR_HAY_MULTI, 6
    EXPAND STR_FROM_PARTS incl0_exp, &SPLIT_INCL_PART0, 2
    EXPAND STR_FROM_PARTS incl1_exp, &SPLIT_INCL_PART1, 2
    EXPAND STR_FROM_PARTS tail_exp, &MULTI_PART2, 1
    EXPAND STR_FROM_PARTS eacute_exp, &UTF8_A_E, 3
    EXPAND STRING_BUF_FROM_STR char_buf, hay_colon

    EXPAND STR_SPLIT_INCLUSIVE_CHAR_COUNT colon_count, hay_colon, 58
    EXPAND STRING_SPLIT_INCLUSIVE_CHAR_COUNT eacute_count, hay_multi, 233
    EXPAND STRING_BUF_SPLIT_INCLUSIVE_CHAR_COUNT buf_count, char_buf, 58
    EXPAND STR_SPLIT_INCLUSIVE_CHAR_COUNT invalid_count, hay_colon, 55296

    EXPAND STR_TRY_SPLIT_INCLUSIVE_CHAR_AT ok0, part0, hay_colon, 58, 0
    EXPAND STRING_SPLIT_INCLUSIVE_CHAR_AT ok1, part1, hay_colon, 58, 1
    EXPAND STRING_BUF_TRY_SPLIT_INCLUSIVE_CHAR_AT ok2, part2, char_buf, 58, 2
    EXPAND STRING_BUF_SPLIT_INCLUSIVE_CHAR_AT ok3, part3, char_buf, 58, 3
    EXPAND STR_TRY_SPLIT_INCLUSIVE_CHAR_AT ok_e0, epart0, hay_multi, 233, 0
    EXPAND STR_SPLIT_INCLUSIVE_CHAR_AT ok_e1, epart1, hay_multi, 233, 1
    EXPAND STR_TRY_SPLIT_INCLUSIVE_CHAR_AT ok_invalid, invalid_part, hay_colon, 55296, 0

    EXPAND STR_EQ eq0, part0, incl0_exp
    EXPAND STR_EQ eq1, part1, incl1_exp
    EXPAND STR_EQ eq2, part2, tail_exp
    EXPAND STR_EQ eq_e0, epart0, eacute_exp
    EXPAND STR_EQ eq_e1, epart1, eacute_exp
    EXPAND SLICE_GET_LEN part3_len, part3
    EXPAND SLICE_GET_LEN invalid_len, invalid_part

    colon_count_ok = eq colon_count, 3
    eacute_count_ok = eq eacute_count, 2
    buf_count_ok = eq buf_count, 3
    invalid_count_ok = eq invalid_count, 0
    ok0_flag = eq ok0, 1
    ok1_flag = eq ok1, 1
    ok2_flag = eq ok2, 1
    ok3_flag = eq ok3, 0
    ok_e0_flag = eq ok_e0, 1
    ok_e1_flag = eq ok_e1, 1
    ok_invalid_flag = eq ok_invalid, 0
    eq0_ok = eq eq0, 1
    eq1_ok = eq eq1, 1
    eq2_ok = eq eq2, 1
    eq_e0_ok = eq eq_e0, 1
    eq_e1_ok = eq eq_e1, 1
    part3_len_ok = eq part3_len, 0
    invalid_len_ok = eq invalid_len, 0

    ok = and colon_count_ok, eacute_count_ok
    ok = and ok, buf_count_ok
    ok = and ok, invalid_count_ok
    ok = and ok, ok0_flag
    ok = and ok, ok1_flag
    ok = and ok, ok2_flag
    ok = and ok, ok3_flag
    ok = and ok, ok_e0_flag
    ok = and ok, ok_e1_flag
    ok = and ok, ok_invalid_flag
    ok = and ok, eq0_ok
    ok = and ok, eq1_ok
    ok = and ok, eq2_ok
    ok = and ok, eq_e0_ok
    ok = and ok, eq_e1_ok
    ok = and ok, part3_len_ok
    ok = and ok, invalid_len_ok

    !part0
    !part1
    !part2
    !part3
    !epart0
    !epart1
    !invalid_part
    !colon_count
    !eacute_count
    !buf_count
    !invalid_count
    !ok0
    !ok1
    !ok2
    !ok3
    !ok_e0
    !ok_e1
    !ok_invalid
    !eq0
    !eq1
    !eq2
    !eq_e0
    !eq_e1
    !part3_len
    !invalid_len
    !colon_count_ok
    !eacute_count_ok
    !buf_count_ok
    !invalid_count_ok
    !ok0_flag
    !ok1_flag
    !ok2_flag
    !ok3_flag
    !ok_e0_flag
    !ok_e1_flag
    !ok_invalid_flag
    !eq0_ok
    !eq1_ok
    !eq2_ok
    !eq_e0_ok
    !eq_e1_ok
    !part3_len_ok
    !invalid_len_ok
    EXPAND STRING_BUF_FREE char_buf
    !hay_colon
    !hay_multi
    !incl0_exp
    !incl1_exp
    !tail_exp
    !eacute_exp
    br ok -> L_STR_SPLIT_INCL_CHAR_OK, L_STR_SPLIT_INCL_CHAR_FAIL

L_STR_SPLIT_INCL_CHAR_FAIL:
    !ok
    panic(10279)

L_STR_SPLIT_INCL_CHAR_OK:
    !ok
    return

