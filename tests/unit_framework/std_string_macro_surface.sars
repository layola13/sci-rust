@test "sa_std string buffer from_utf8 lossy macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS valid_expected, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STR_FROM_PARTS lossy_expected, &UTF8_LOSSY_EXPECTED, 8
    EXPAND STR_FROM_PARTS sequence_expected, &UTF8_LOSSY_SEQUENCE_EXPECTED, 5

    bad_ptr = stack_alloc 4
    store bad_ptr+0, 97 as u8
    bad_ptr_1 = ptr_add bad_ptr, 1
    store bad_ptr_1+0, 255 as u8
    bad_ptr_2 = ptr_add bad_ptr, 2
    store bad_ptr_2+0, 40 as u8
    bad_ptr_3 = ptr_add bad_ptr, 3
    store bad_ptr_3+0, 226 as u8
    EXPAND STR_FROM_PARTS bad_bytes, bad_ptr, 4

    EXPAND STRING_BUF_FROM_UTF8_LOSSY valid_buf, valid_expected
    EXPAND STRING_BUF_AS_STR valid_view, valid_buf
    EXPAND STR_EQ valid_eq, valid_view, valid_expected
    EXPAND STRING_BUF_FROM_UTF8_LOSSY lossy_buf, bad_bytes
    EXPAND STRING_BUF_AS_STR lossy_view, lossy_buf
    EXPAND STR_EQ lossy_eq, lossy_view, lossy_expected

    sequence_ptr = stack_alloc 5
    store sequence_ptr+0, 97 as u8
    sequence_ptr_1 = ptr_add sequence_ptr, 1
    store sequence_ptr_1+0, 240 as u8
    sequence_ptr_2 = ptr_add sequence_ptr, 2
    store sequence_ptr_2+0, 144 as u8
    sequence_ptr_3 = ptr_add sequence_ptr, 3
    store sequence_ptr_3+0, 128 as u8
    sequence_ptr_4 = ptr_add sequence_ptr, 4
    store sequence_ptr_4+0, 87 as u8
    EXPAND STR_FROM_PARTS sequence_bytes, sequence_ptr, 5
    EXPAND STRING_BUF_FROM_UTF8_LOSSY sequence_buf, sequence_bytes
    EXPAND STRING_BUF_AS_STR sequence_view, sequence_buf
    EXPAND STR_EQ sequence_eq, sequence_view, sequence_expected

    EXPAND VEC_WITH_CAPACITY owned_valid_vec, 8, 1
    EXPAND VEC_PUSH owned_valid_vec, 97, 1
    EXPAND VEC_PUSH owned_valid_vec, 195, 1
    EXPAND VEC_PUSH owned_valid_vec, 169, 1
    EXPAND VEC_PUSH owned_valid_vec, 240, 1
    EXPAND VEC_PUSH owned_valid_vec, 159, 1
    EXPAND VEC_PUSH owned_valid_vec, 153, 1
    EXPAND VEC_PUSH owned_valid_vec, 130, 1
    EXPAND VEC_PUSH owned_valid_vec, 122, 1
    EXPAND VEC_AS_PTR owned_valid_ptr_before, owned_valid_vec
    EXPAND STRING_BUF_FROM_UTF8_LOSSY_OWNED owned_valid_buf, owned_valid_vec
    EXPAND STRING_BUF_AS_PTR owned_valid_ptr_after, owned_valid_buf
    EXPAND STRING_BUF_AS_STR owned_valid_view, owned_valid_buf
    EXPAND STR_EQ owned_valid_eq, owned_valid_view, valid_expected
    owned_valid_reused = eq owned_valid_ptr_before, owned_valid_ptr_after

    EXPAND VEC_WITH_CAPACITY owned_bad_vec, 4, 1
    EXPAND VEC_PUSH owned_bad_vec, 97, 1
    EXPAND VEC_PUSH owned_bad_vec, 255, 1
    EXPAND VEC_PUSH owned_bad_vec, 40, 1
    EXPAND VEC_PUSH owned_bad_vec, 226, 1
    EXPAND STRING_BUF_FROM_UTF8_LOSSY_VEC owned_lossy_buf, owned_bad_vec
    EXPAND STRING_BUF_AS_STR owned_lossy_view, owned_lossy_buf
    EXPAND STR_EQ owned_lossy_eq, owned_lossy_view, lossy_expected

    ok01 = and valid_eq, lossy_eq
    ok02 = and ok01, sequence_eq
    ok03 = and ok02, owned_valid_eq
    ok04 = and ok03, owned_valid_reused
    ok = and ok04, owned_lossy_eq
    !valid_expected
    !lossy_expected
    !sequence_expected
    !bad_ptr_1
    !bad_ptr_2
    !bad_ptr_3
    !bad_bytes
    !sequence_ptr_1
    !sequence_ptr_2
    !sequence_ptr_3
    !sequence_ptr_4
    !sequence_bytes
    !valid_view
    !valid_eq
    !lossy_view
    !lossy_eq
    !sequence_view
    !sequence_eq
    !owned_valid_ptr_before
    !owned_valid_ptr_after
    !owned_valid_view
    !owned_valid_eq
    !owned_valid_reused
    !owned_lossy_view
    !owned_lossy_eq
    !ok01
    !ok02
    !ok03
    !ok04
    EXPAND STRING_BUF_FREE owned_lossy_buf
    EXPAND STRING_BUF_FREE owned_valid_buf
    EXPAND STRING_BUF_FREE sequence_buf
    EXPAND STRING_BUF_FREE lossy_buf
    EXPAND STRING_BUF_FREE valid_buf
    br ok -> L_STRING_BUF_FROM_UTF8_LOSSY_OK, L_STRING_BUF_FROM_UTF8_LOSSY_FAIL

L_STRING_BUF_FROM_UTF8_LOSSY_FAIL:
    !ok
    panic(1105)

L_STRING_BUF_FROM_UTF8_LOSSY_OK:
    !ok
    return

