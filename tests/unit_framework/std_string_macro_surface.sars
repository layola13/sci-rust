    EXPAND STRING_BUF_TRY_REMOVE_MATCHES_WITHIN_CAPACITY ok_multi, multi_buf, multi_needle
    EXPAND STRING_BUF_LEN mlen, multi_buf
    EXPAND STRING_BUF_AS_STR multi_view, multi_buf
    EXPAND STR_EQ multi_eq, multi_view, multi_expected

    EXPAND STRING_BUF_WITH_CAPACITY empty_buf, 4
    EXPAND STRING_BUF_PUSH_STR empty_buf, hi
    EXPAND STR_EMPTY empty_needle
    EXPAND STRING_BUF_TRY_REMOVE_MATCHES_WITHIN_CAPACITY ok_empty, empty_buf, empty_needle
