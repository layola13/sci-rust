@test "sa_std string splitn count aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS split_hay, &SPLIT_HAY, 5
    EXPAND STR_FROM_PARTS colon, &SPLIT_NEEDLE, 1
    EXPAND STR_EMPTY empty_needle
    EXPAND STRING_BUF_FROM_STR split_buf, split_hay

    EXPAND STR_SPLIT_N_NEEDLE_COUNT splitn2_count, split_hay, colon, 2
    EXPAND STRING_SPLIT_N_NEEDLE_COUNT splitn10_count, split_hay, colon, 10
    EXPAND STRING_BUF_SPLIT_N_NEEDLE_COUNT splitn2_count_b, split_buf, colon, 2
    EXPAND STR_RSPLIT_N_NEEDLE_COUNT rsplitn2_count, split_hay, colon, 2
    EXPAND STRING_RSPLIT_N_NEEDLE_COUNT rsplitn10_count, split_hay, colon, 10
    EXPAND STRING_BUF_RSPLIT_N_NEEDLE_COUNT rsplitn2_count_b, split_buf, colon, 2
    EXPAND STR_SPLIT_N_NEEDLE_COUNT zero_count, split_hay, colon, 0
    EXPAND STR_RSPLIT_N_NEEDLE_COUNT zero_r_count, split_hay, colon, 0
    EXPAND STR_SPLIT_N_NEEDLE_COUNT empty_needle_count, split_hay, empty_needle, 3
    EXPAND STR_TRY_SPLIT_N_NEEDLE_AT zero_ok, zero_part, split_hay, colon, 0, 0
    EXPAND STR_TRY_RSPLIT_N_NEEDLE_AT zero_r_ok, zero_r_part, split_hay, colon, 0, 0
    EXPAND STR_TRY_SPLIT_N_NEEDLE_AT empty0_ok, empty0_part, split_hay, empty_needle, 3, 0
    EXPAND STR_TRY_SPLIT_N_NEEDLE_AT empty1_ok, empty1_part, split_hay, empty_needle, 3, 1
    EXPAND STR_TRY_RSPLIT_N_NEEDLE_AT empty_r0_ok, empty_r0_part, split_hay, empty_needle, 3, 0
    EXPAND STR_TRY_RSPLIT_N_NEEDLE_AT empty_r1_ok, empty_r1_part, split_hay, empty_needle, 3, 1

    EXPAND STR_IS_EMPTY zero_part_empty, zero_part
    EXPAND STR_IS_EMPTY zero_r_part_empty, zero_r_part
    EXPAND STR_EQ empty0_eq, empty0_part, split_hay
    EXPAND STR_IS_EMPTY empty1_empty, empty1_part
    EXPAND STR_EQ empty_r0_eq, empty_r0_part, split_hay
    EXPAND STR_IS_EMPTY empty_r1_empty, empty_r1_part

    splitn2_count_ok = eq splitn2_count, 2
    splitn10_count_ok = eq splitn10_count, 4
    splitn2_count_b_ok = eq splitn2_count_b, 2
    rsplitn2_count_ok = eq rsplitn2_count, 2
    rsplitn10_count_ok = eq rsplitn10_count, 4
    rsplitn2_count_b_ok = eq rsplitn2_count_b, 2
    zero_count_ok = eq zero_count, 0
    zero_r_count_ok = eq zero_r_count, 0
    empty_needle_count_ok = eq empty_needle_count, 1
    zero_flag_ok = eq zero_ok, 0
    zero_value_ok = eq zero_part_empty, 1
    zero_r_flag_ok = eq zero_r_ok, 0
    zero_r_value_ok = eq zero_r_part_empty, 1
    empty0_flag_ok = eq empty0_ok, 1
    empty0_value_ok = eq empty0_eq, 1
    empty1_flag_ok = eq empty1_ok, 0
    empty1_value_ok = eq empty1_empty, 1
    empty_r0_flag_ok = eq empty_r0_ok, 1
    empty_r0_value_ok = eq empty_r0_eq, 1
    empty_r1_flag_ok = eq empty_r1_ok, 0
    empty_r1_value_ok = eq empty_r1_empty, 1
    ok = and splitn2_count_ok, splitn10_count_ok
    ok = and ok, splitn2_count_b_ok
    ok = and ok, rsplitn2_count_ok
    ok = and ok, rsplitn10_count_ok
    ok = and ok, rsplitn2_count_b_ok
    ok = and ok, zero_count_ok
    ok = and ok, zero_r_count_ok
    ok = and ok, empty_needle_count_ok
    ok = and ok, zero_flag_ok
    ok = and ok, zero_value_ok
    ok = and ok, zero_r_flag_ok
    ok = and ok, zero_r_value_ok
    ok = and ok, empty0_flag_ok
    ok = and ok, empty0_value_ok
    ok = and ok, empty1_flag_ok
    ok = and ok, empty1_value_ok
    ok = and ok, empty_r0_flag_ok
    ok = and ok, empty_r0_value_ok
    ok = and ok, empty_r1_flag_ok
    ok = and ok, empty_r1_value_ok
    EXPAND STRING_BUF_FREE split_buf
    !split_hay
    !colon
    !empty_needle
    !splitn2_count
    !splitn10_count
    !splitn2_count_b
    !rsplitn2_count
    !rsplitn10_count
    !rsplitn2_count_b
    !zero_count
    !zero_r_count
