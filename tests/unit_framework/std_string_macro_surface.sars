@test "sa_std string owned buffer unicode char macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS expected_push, &BUF_CHAR_EXPECTED, 2
    EXPAND STR_FROM_PARTS expected_insert, &BUF_INSERT_CHAR_EXPECTED, 3
    EXPAND STR_FROM_PARTS expected_alias, &BUF_INSERT_CHAR_ALIAS_EXPECTED, 4
    EXPAND STR_FROM_PARTS expected_push_unicode, &BUF_PUSH_UNICODE_EXPECTED, 6
    EXPAND STR_FROM_PARTS expected_insert_unicode, &BUF_INSERT_UNICODE_EXPECTED, 10

    EXPAND STRING_BUF_NEW string_buf
    EXPAND STRING_BUF_TRY_PUSH_CHAR push_char_ok, string_buf, 114
    EXPAND STRING_BUF_TRY_PUSH_CHAR push_char_ok2, string_buf, 33
    EXPAND STRING_BUF_AS_STR after_push, string_buf
    EXPAND STR_EQ after_push_eq, after_push, expected_push
    EXPAND STRING_BUF_TRY_INSERT_CHAR insert_char_ok, string_buf, 2, 63
    EXPAND STRING_BUF_AS_STR after_insert, string_buf
    EXPAND STR_EQ after_insert_eq, after_insert, expected_insert
    EXPAND STRING_BUF_INSERT_CHAR insert_char_alias_ok, string_buf, 1, 45
    EXPAND STRING_BUF_AS_STR after_alias, string_buf
    EXPAND STR_EQ after_alias_eq, after_alias, expected_alias
    EXPAND STRING_BUF_TRY_PUSH_CHAR push_unicode_ok, string_buf, 233
    EXPAND STRING_BUF_AS_STR after_push_unicode, string_buf
    EXPAND STR_EQ after_push_unicode_eq, after_push_unicode, expected_push_unicode
    EXPAND STRING_BUF_TRY_INSERT_CHAR insert_unicode_ok, string_buf, 1, 128578
    EXPAND STRING_BUF_AS_STR after_insert_unicode, string_buf
    EXPAND STR_EQ after_insert_unicode_eq, after_insert_unicode, expected_insert_unicode
    EXPAND STRING_BUF_TRY_PUSH_CHAR push_invalid_ok, string_buf, 55296
    EXPAND STRING_BUF_TRY_INSERT_CHAR insert_boundary_miss_ok, string_buf, 2, 233
    EXPAND STRING_BUF_AS_STR after_miss, string_buf
    EXPAND STR_EQ after_miss_eq, after_miss, expected_insert_unicode
    EXPAND STRING_BUF_LEN final_len, string_buf

    push_flag_ok = eq push_char_ok, 1
    push_flag2_ok = eq push_char_ok2, 1
    push_value_ok = eq after_push_eq, 1
    insert_flag_ok = eq insert_char_ok, 1
    insert_value_ok = eq after_insert_eq, 1
    alias_flag_ok = eq insert_char_alias_ok, 1
    alias_value_ok = eq after_alias_eq, 1
    push_unicode_flag_ok = eq push_unicode_ok, 1
    push_unicode_value_ok = eq after_push_unicode_eq, 1
    insert_unicode_flag_ok = eq insert_unicode_ok, 1
    insert_unicode_value_ok = eq after_insert_unicode_eq, 1
    push_invalid_flag_ok = eq push_invalid_ok, 0
    insert_boundary_miss_flag_ok = eq insert_boundary_miss_ok, 0
    after_miss_value_ok = eq after_miss_eq, 1
    final_len_ok = eq final_len, 10
    ok00 = and push_flag_ok, push_flag2_ok
    ok01 = and ok00, push_value_ok
    ok02 = and ok01, insert_flag_ok
    ok03 = and ok02, insert_value_ok
    ok04 = and ok03, alias_flag_ok
    ok05 = and ok04, alias_value_ok
    ok06 = and ok05, push_unicode_flag_ok
    ok07 = and ok06, push_unicode_value_ok
    ok08 = and ok07, insert_unicode_flag_ok
    ok09 = and ok08, insert_unicode_value_ok
    ok10 = and ok09, push_invalid_flag_ok
    ok11 = and ok10, insert_boundary_miss_flag_ok
    ok12 = and ok11, after_miss_value_ok
    ok = and ok12, final_len_ok
    !expected_push
    !expected_insert
    !expected_alias
    !expected_push_unicode
    !expected_insert_unicode
    !push_char_ok
    !push_char_ok2
    !after_push
