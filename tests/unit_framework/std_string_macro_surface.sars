@test "sa_std string buffer remove char at byte macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS source, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STR_FROM_PARTS after_a_expected, &UTF8_AFTER_REMOVE_A, 7
    EXPAND STR_FROM_PARTS after_e_expected, &UTF8_AFTER_REMOVE_E, 6
    EXPAND STR_FROM_PARTS after_smile_expected, &UTF8_AFTER_REMOVE_SMILE, 4
    EXPAND STR_FROM_PARTS after_z_expected, &UTF8_AFTER_REMOVE_Z, 7

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED ascii_buf, source
    EXPAND STRING_BUF_TRY_REMOVE_CHAR_AT ascii_ok, ascii_cp, ascii_buf, 0
    EXPAND STRING_BUF_AS_STR ascii_after, ascii_buf
    EXPAND STR_EQ ascii_eq, ascii_after, after_a_expected

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED e_buf, source
    EXPAND STRING_BUF_TRY_REMOVE_CHAR_AT e_ok, e_cp, e_buf, 1
    EXPAND STRING_BUF_AS_STR e_after, e_buf
    EXPAND STR_EQ e_eq, e_after, after_e_expected

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED smile_buf, source
    EXPAND STRING_BUF_TRY_REMOVE_CHAR_AT smile_ok, smile_cp, smile_buf, 3
    EXPAND STRING_BUF_AS_STR smile_after, smile_buf
    EXPAND STR_EQ smile_eq, smile_after, after_smile_expected

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED alias_buf, source
    EXPAND STRING_BUF_REMOVE_CHAR_AT alias_ok, alias_cp, alias_buf, 7
    EXPAND STRING_BUF_AS_STR alias_after, alias_buf
