@test "sa_std string buffer reference conversion aliases"():
L_STRING_BUF_REF_CONV_ENTRY:
    word_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW word_slice, &WORD, 4

    EXPAND STRING_BUF_FROM_MUT_STR from_mut, word_slice
    EXPAND STRING_BUF_AS_STR from_mut_view, from_mut
    EXPAND STR_EQ from_mut_eq, from_mut_view, word_slice

    EXPAND STRING_BUF_FROM_STR source, word_slice
    EXPAND STRING_BUF_FROM_STRING_REF from_ref, source
    EXPAND STRING_BUF_AS_MUT_STR source_mut, source
    EXPAND SLICE_GET_PTR source_mut_ptr, source_mut
    store source_mut_ptr+0, 82 as u8
    EXPAND STRING_BUF_AS_STR from_ref_view, from_ref
    EXPAND STR_EQ from_ref_eq, from_ref_view, word_slice

    EXPAND VEC_WITH_CAPACITY valid_vec, 4, 1
    EXPAND VEC_PUSH valid_vec, 114, 1
    EXPAND VEC_PUSH valid_vec, 117, 1
    EXPAND VEC_PUSH valid_vec, 115, 1
    EXPAND VEC_PUSH valid_vec, 116, 1
    EXPAND STRING_BUF_FROM_VEC_U8 valid_ok, valid_buf, valid_err_vec, valid_vec
    EXPAND STRING_BUF_AS_STR valid_view, valid_buf
    EXPAND STR_EQ valid_eq, valid_view, word_slice
    EXPAND VEC_LEN valid_err_len, valid_err_vec

    EXPAND VEC_WITH_CAPACITY bad_vec, 2, 1
    EXPAND VEC_PUSH bad_vec, 255, 1
    EXPAND VEC_PUSH bad_vec, 40, 1
    EXPAND STRING_BUF_FROM_BYTES_VEC bad_ok, bad_buf, bad_err_vec, bad_vec
    EXPAND STRING_BUF_LEN bad_buf_len, bad_buf
    EXPAND VEC_LEN bad_err_len, bad_err_vec
    EXPAND VEC_TRY_GET_TYPED_U8 bad_first_ok, bad_first, bad_err_vec, 0, 1

    from_mut_ok = eq from_mut_eq, 1
    from_ref_ok = eq from_ref_eq, 1
    valid_flag_ok = eq valid_ok, 1
    valid_value_ok = eq valid_eq, 1
    valid_err_empty_ok = eq valid_err_len, 0
    bad_flag_ok = eq bad_ok, 0
    bad_buf_empty_ok = eq bad_buf_len, 0
    bad_err_len_ok = eq bad_err_len, 2
    bad_first_flag_ok = eq bad_first_ok, 1
    bad_first_value_ok = eq bad_first, 255
    ok01 = and from_mut_ok, from_ref_ok
    ok02 = and ok01, valid_flag_ok
    ok03 = and ok02, valid_value_ok
    ok04 = and ok03, valid_err_empty_ok
    ok05 = and ok04, bad_flag_ok
    ok06 = and ok05, bad_buf_empty_ok
    ok07 = and ok06, bad_err_len_ok
    ok08 = and ok07, bad_first_flag_ok
    ok = and ok08, bad_first_value_ok

    !from_mut_eq
    !source_mut_ptr
    !from_ref_eq
    !valid_ok
    !valid_eq
    !valid_err_len
    !bad_ok
    !bad_buf_len
    !bad_err_len
    !bad_first_ok
    !bad_first
    !from_mut_ok
    !from_ref_ok
    !valid_flag_ok
    !valid_value_ok
    !valid_err_empty_ok
    !bad_flag_ok
    !bad_buf_empty_ok
    !bad_err_len_ok
    !bad_first_flag_ok
    !bad_first_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !word_slice
    !from_mut_view
    !source_mut
    !from_ref_view
    !valid_view
    EXPAND VEC_FREE bad_err_vec
    EXPAND STRING_BUF_FREE bad_buf
    EXPAND VEC_FREE valid_err_vec
    EXPAND STRING_BUF_FREE valid_buf
    EXPAND STRING_BUF_FREE from_ref
    EXPAND STRING_BUF_FREE source
    EXPAND STRING_BUF_FREE from_mut
    br ok -> L_STRING_BUF_REF_CONV_OK, L_STRING_BUF_REF_CONV_FAIL

L_STRING_BUF_REF_CONV_FAIL:
    !ok
    panic(10270)

L_STRING_BUF_REF_CONV_OK:
    !ok
    return

@test "sa_std string repeat aliases"():
L_STRING_REPEAT_ENTRY:
    word_slice = alloc Slice_SIZE
    repeat_twice_slice = alloc Slice_SIZE
    repeat_thrice_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW word_slice, &JOIN_LEFT, 4
    EXPAND SLICE_NEW repeat_twice_slice, &REPEAT_TWICE, 8
    EXPAND SLICE_NEW repeat_thrice_slice, &REPEAT_THRICE, 12

    EXPAND STR_REPEAT str_repeat_buf, word_slice, 3
    EXPAND STRING_BUF_AS_STR str_repeat_view, str_repeat_buf
    EXPAND STR_EQ str_repeat_eq, str_repeat_view, repeat_thrice_slice

    EXPAND STR_REPEAT zero_repeat_buf, word_slice, 0
    EXPAND STRING_BUF_LEN zero_repeat_len, zero_repeat_buf

    EXPAND STRING_BUF_FROM_STR source_buf, word_slice
    EXPAND STRING_BUF_REPEAT string_repeat_buf, source_buf, 2
    EXPAND STRING_BUF_AS_STR string_repeat_view, string_repeat_buf
    EXPAND STR_EQ string_repeat_eq, string_repeat_view, repeat_twice_slice

    str_repeat_ok = eq str_repeat_eq, 1
    zero_repeat_ok = eq zero_repeat_len, 0
    string_repeat_ok = eq string_repeat_eq, 1
    ok01 = and str_repeat_ok, zero_repeat_ok
    ok = and ok01, string_repeat_ok

    !str_repeat_view
    !str_repeat_eq
    !zero_repeat_len
    !string_repeat_view
    !string_repeat_eq
    !str_repeat_ok
    !zero_repeat_ok
    !string_repeat_ok
    !ok01
    !word_slice
    !repeat_twice_slice
    !repeat_thrice_slice
    EXPAND STRING_BUF_FREE string_repeat_buf
    EXPAND STRING_BUF_FREE source_buf
    EXPAND STRING_BUF_FREE zero_repeat_buf
    EXPAND STRING_BUF_FREE str_repeat_buf
    br ok -> L_STRING_REPEAT_OK, L_STRING_REPEAT_FAIL

L_STRING_REPEAT_FAIL:
    !ok
    panic(1108)

L_STRING_REPEAT_OK:
    !ok
    return

@test "sa_std string to_owned and to_string aliases"():
L_STRING_TO_OWNED_ENTRY:
    word_slice = alloc Slice_SIZE
    title_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW word_slice, &WORD, 4
    EXPAND SLICE_NEW title_slice, &TITLE_WORD, 4

    EXPAND STRING_BUF_FROM_STR source, word_slice
    EXPAND STR_TO_OWNED str_owned, word_slice
    EXPAND STR_TO_STRING str_string, word_slice
    EXPAND STRING_BUF_TO_OWNED string_owned, source
    EXPAND STRING_BUF_TO_STRING string_string, source

    EXPAND STRING_BUF_AS_MUT_STR source_mut, source
    EXPAND SLICE_GET_PTR source_mut_ptr, source_mut
    store source_mut_ptr+0, 82 as u8

    EXPAND STRING_BUF_AS_STR source_view, source
    EXPAND STRING_BUF_AS_STR str_owned_view, str_owned
    EXPAND STRING_BUF_AS_STR str_string_view, str_string
    EXPAND STRING_BUF_AS_STR string_owned_view, string_owned
    EXPAND STRING_BUF_AS_STR string_string_view, string_string
    EXPAND STR_EQ source_eq, source_view, title_slice
    EXPAND STR_EQ str_owned_eq, str_owned_view, word_slice
    EXPAND STR_EQ str_string_eq, str_string_view, word_slice
    EXPAND STR_EQ string_owned_eq, string_owned_view, word_slice
    EXPAND STR_EQ string_string_eq, string_string_view, word_slice
    EXPAND STRING_BUF_AS_PTR source_ptr, source
    EXPAND STRING_BUF_AS_PTR string_owned_ptr, string_owned
    EXPAND STRING_BUF_AS_PTR string_string_ptr, string_string
    owned_distinct = ne source_ptr, string_owned_ptr
    string_distinct = ne source_ptr, string_string_ptr

    source_ok = eq source_eq, 1
    str_owned_ok = eq str_owned_eq, 1
    str_string_ok = eq str_string_eq, 1
    string_owned_ok = eq string_owned_eq, 1
    string_string_ok = eq string_string_eq, 1
    ok01 = and source_ok, str_owned_ok
    ok02 = and ok01, str_string_ok
    ok03 = and ok02, string_owned_ok
    ok04 = and ok03, string_string_ok
    ok05 = and ok04, owned_distinct
    ok = and ok05, string_distinct

    !source_mut_ptr
    !source_eq
    !str_owned_eq
    !str_string_eq
    !string_owned_eq
    !string_string_eq
    !source_ptr
    !string_owned_ptr
    !string_string_ptr
    !owned_distinct
    !string_distinct
    !source_ok
    !str_owned_ok
    !str_string_ok
    !string_owned_ok
    !string_string_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !word_slice
    !title_slice
    !source_mut
    !source_view
    !str_owned_view
    !str_string_view
    !string_owned_view
    !string_string_view
    EXPAND STRING_BUF_FREE string_string
    EXPAND STRING_BUF_FREE string_owned
    EXPAND STRING_BUF_FREE str_string
    EXPAND STRING_BUF_FREE str_owned
    EXPAND STRING_BUF_FREE source
    br ok -> L_STRING_TO_OWNED_OK, L_STRING_TO_OWNED_FAIL

L_STRING_TO_OWNED_FAIL:
    !ok
    panic(1109)

L_STRING_TO_OWNED_OK:
    !ok
    return

@test "sa_std primitive to_string aliases"():
L_STRING_PRIMITIVE_TO_STRING_ENTRY:
    true_slice = alloc Slice_SIZE
    false_slice = alloc Slice_SIZE
    u64_slice = alloc Slice_SIZE
    i64_slice = alloc Slice_SIZE
    u8_slice = alloc Slice_SIZE
    u16_slice = alloc Slice_SIZE
    u32_slice = alloc Slice_SIZE
    usize_slice = alloc Slice_SIZE
