    !insert_unicode_ok
    !after_insert_unicode
    !after_insert_unicode_eq
    !push_invalid_ok
    !insert_boundary_miss_ok
    !after_miss
    !after_miss_eq
    !final_len
    !push_flag_ok
    !push_flag2_ok
    !push_value_ok
    !insert_flag_ok
