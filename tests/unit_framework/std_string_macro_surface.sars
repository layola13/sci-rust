    ok18 = and ok17, remove_miss_value_ok
    ok19 = and ok18, replace_empty_value_ok
    ok20 = and ok19, replace_multi_value_ok
    ok21 = and ok20, replace_long_value_ok
    ok22 = and ok21, bytes_len_ok
    ok23 = and ok22, first_byte_ok
    ok24 = and ok23, unchecked_owned_value_ok
    ok25 = and ok24, unchecked_owned_reused_ok
    ok = and ok25, mut_str_value_ok
    !left
    !replace_source
