@test "sa_std string match indices char aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS matches_hay, &MATCHES_HAY, 5
    EXPAND STR_FROM_PARTS multi_hay, &CHAR_HAY_MULTI, 6
    EXPAND STR_FROM_PARTS colon, &MATCHES_NEEDLE, 1
    EXPAND STR_FROM_PARTS eacute, &UTF8_E_ACUTE, 2
    EXPAND STRING_BUF_FROM_STR match_buf, matches_hay
    EXPAND STRING_BUF_FROM_STR multi_buf, multi_hay

    EXPAND STR_MATCH_INDICES_CHAR_COUNT count, matches_hay, 58
    EXPAND STRING_MATCH_INDICES_CHAR_COUNT count_s, matches_hay, 58
    EXPAND STRING_BUF_MATCH_INDICES_CHAR_COUNT count_b, match_buf, 58
    EXPAND STR_RMATCH_INDICES_CHAR_COUNT rcount, matches_hay, 58
    EXPAND STRING_RMATCH_INDICES_CHAR_COUNT rcount_s, matches_hay, 58
    EXPAND STRING_BUF_RMATCH_INDICES_CHAR_COUNT rcount_b, match_buf, 58
    EXPAND STR_MATCH_INDICES_CHAR_COUNT multi_count, multi_hay, 233
    EXPAND STRING_BUF_RMATCH_INDICES_CHAR_COUNT multi_rcount_b, multi_buf, 233
    EXPAND STR_MATCH_INDICES_CHAR_COUNT invalid_count, matches_hay, 55296

    EXPAND STR_TRY_MATCH_INDICES_CHAR_AT ok0, idx0, part0, matches_hay, 58, 0
    EXPAND STR_MATCH_INDICES_CHAR_AT ok1, idx1, part1, matches_hay, 58, 1
    EXPAND STRING_TRY_MATCH_INDICES_CHAR_AT ok1s, idx1s, part1s, matches_hay, 58, 1
    EXPAND STRING_BUF_MATCH_INDICES_CHAR_AT ok0b, idx0b, part0b, match_buf, 58, 0
    EXPAND STR_TRY_MATCH_INDICES_CHAR_AT ok_miss, idx_miss, part_miss, matches_hay, 58, 2
    EXPAND STR_TRY_MATCH_INDICES_CHAR_AT ok_invalid, idx_invalid, part_invalid, matches_hay, 55296, 0

    EXPAND STR_TRY_MATCH_INDICES_CHAR_AT ok_multi0, idx_multi0, part_multi0, multi_hay, 233, 0
    EXPAND STRING_BUF_MATCH_INDICES_CHAR_AT ok_multi1b, idx_multi1b, part_multi1b, multi_buf, 233, 1
    EXPAND STR_TRY_RMATCH_INDICES_CHAR_AT rok_multi0, ridx_multi0, rpart_multi0, multi_hay, 233, 0
    EXPAND STRING_RMATCH_INDICES_CHAR_AT rok_multi1, ridx_multi1, rpart_multi1, multi_hay, 233, 1

    EXPAND STR_TRY_RMATCH_INDICES_CHAR_AT rok0, ridx0, rpart0, matches_hay, 58, 0
    EXPAND STR_RMATCH_INDICES_CHAR_AT rok1, ridx1, rpart1, matches_hay, 58, 1
    EXPAND STRING_TRY_RMATCH_INDICES_CHAR_AT rok1s, ridx1s, rpart1s, matches_hay, 58, 1
    EXPAND STRING_BUF_RMATCH_INDICES_CHAR_AT rok0b, ridx0b, rpart0b, match_buf, 58, 0
    EXPAND STR_TRY_RMATCH_INDICES_CHAR_AT rok_miss, ridx_miss, rpart_miss, matches_hay, 58, 2
    EXPAND STR_TRY_RMATCH_INDICES_CHAR_AT rok_invalid, ridx_invalid, rpart_invalid, matches_hay, 55296, 0

    EXPAND STR_EQ eq0, part0, colon
    EXPAND STR_EQ eq1, part1, colon
    EXPAND STR_EQ eq1s, part1s, colon
    EXPAND STR_EQ eq0b, part0b, colon
    EXPAND STR_EQ req0, rpart0, colon
    EXPAND STR_EQ req1, rpart1, colon
    EXPAND STR_EQ req1s, rpart1s, colon
    EXPAND STR_EQ req0b, rpart0b, colon
    EXPAND STR_EQ eq_multi0, part_multi0, eacute
    EXPAND STR_EQ eq_multi1b, part_multi1b, eacute
    EXPAND STR_EQ req_multi0, rpart_multi0, eacute
    EXPAND STR_EQ req_multi1, rpart_multi1, eacute
    EXPAND SLICE_GET_LEN miss_len, part_miss
    EXPAND SLICE_GET_LEN invalid_len, part_invalid
    EXPAND SLICE_GET_LEN rmiss_len, rpart_miss
    EXPAND SLICE_GET_LEN rinvalid_len, rpart_invalid

    count_ok = eq count, 2
    count_s_ok = eq count_s, 2
    count_b_ok = eq count_b, 2
    rcount_ok = eq rcount, 2
    rcount_s_ok = eq rcount_s, 2
    rcount_b_ok = eq rcount_b, 2
    multi_count_ok = eq multi_count, 2
    multi_rcount_b_ok = eq multi_rcount_b, 2
    invalid_count_ok = eq invalid_count, 0
    ok0_flag = eq ok0, 1
    idx0_ok = eq idx0, 1
    ok1_flag = eq ok1, 1
    idx1_ok = eq idx1, 3
    ok1s_flag = eq ok1s, 1
    idx1s_ok = eq idx1s, 3
    ok0b_flag = eq ok0b, 1
    idx0b_ok = eq idx0b, 1
    miss_flag = eq ok_miss, 0
    miss_idx_ok = eq idx_miss, 0
    miss_len_ok = eq miss_len, 0
    invalid_flag = eq ok_invalid, 0
    invalid_idx_ok = eq idx_invalid, 0
    invalid_len_ok = eq invalid_len, 0
    multi0_flag = eq ok_multi0, 1
