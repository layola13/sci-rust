    !part_rs1bu
    !part_rs2
    !part_multi0
    !part_multi1
    !part_rmulti0
    !part_multi1b
    !part_invalid
    !part_rinvalid
    br ok -> L_SPLITN_CHAR_OK, L_SPLITN_CHAR_FAIL

L_SPLITN_CHAR_FAIL:
    !ok
    panic(10283)

L_SPLITN_CHAR_OK:
    !ok
    return

