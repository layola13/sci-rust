    string_unchecked_mut_bad_len = load string_unchecked_mut_bad+Slice_len as u64
    EXPAND STR_EQ str_try_eq, str_try_view, valid_bytes
    EXPAND STR_EQ str_eq, str_view, valid_bytes
    EXPAND STR_EQ str_try_mut_eq, str_try_mut_view, valid_bytes
    EXPAND STR_EQ str_mut_eq, str_mut_view, valid_bytes
    EXPAND STR_EQ string_try_eq, string_try_view, valid_bytes
    EXPAND STR_EQ string_mut_eq, string_mut_view, valid_bytes

    str_try_flag_ok = eq str_try_ok, 1
    str_flag_ok = eq str_ok, 1
    str_try_mut_flag_ok = eq str_try_mut_ok, 1
    str_mut_flag_ok = eq str_mut_ok, 1
    string_try_flag_ok = eq string_try_ok, 1
    string_mut_flag_ok = eq string_mut_ok, 1
    string_bad_flag_ok = eq string_bad_ok, 0
    string_try_mut_bad_flag_ok = eq string_try_mut_bad_ok, 0
    str_try_value_ok = eq str_try_eq, 1
    str_value_ok = eq str_eq, 1
    str_try_mut_value_ok = eq str_try_mut_eq, 1
    str_mut_value_ok = eq str_mut_eq, 1
    string_try_value_ok = eq string_try_eq, 1
    string_mut_value_ok = eq string_mut_eq, 1
    str_view_ptr_ok = eq str_view_ptr, valid_ptr
    str_view_len_ok = eq str_view_len, 8
    string_bad_ptr_ok = eq string_bad_ptr, null_ptr
    string_bad_len_ok = eq string_bad_len, 0
    string_try_mut_bad_ptr_ok = eq string_try_mut_bad_ptr, null_ptr
    string_try_mut_bad_len_ok = eq string_try_mut_bad_len, 0
    str_unchecked_bad_ptr_ok = eq str_unchecked_bad_ptr, invalid_ptr
    str_unchecked_bad_len_ok = eq str_unchecked_bad_len, 2
    str_unchecked_mut_bad_ptr_ok = eq str_unchecked_mut_bad_ptr, invalid_ptr
    str_unchecked_mut_bad_len_ok = eq str_unchecked_mut_bad_len, 2
    string_unchecked_ptr_ok = eq string_unchecked_ptr, valid_ptr
    string_unchecked_len_ok = eq string_unchecked_len, 8
    string_unchecked_mut_bad_ptr_ok = eq string_unchecked_mut_bad_ptr, invalid_ptr
    string_unchecked_mut_bad_len_ok = eq string_unchecked_mut_bad_len, 2

    ok01 = and str_try_flag_ok, str_flag_ok
    ok02 = and ok01, str_try_mut_flag_ok
