@test "sa_std string buffer split line aliases"():
L_ENTRY:
    EXPAND STR_FROM_PARTS split_text, &SPLIT_TEXT, 6
    EXPAND STR_FROM_PARTS expected_a, &SPLIT_A, 1
    EXPAND STR_FROM_PARTS expected_b, &SPLIT_B, 1
    EXPAND STR_FROM_PARTS lines_text, &LINES_TEXT, 18
    EXPAND STR_FROM_PARTS expected_beta, &LINES_BETA, 4
    EXPAND STR_FROM_PARTS no_trail, &LINES_NO_TRAIL, 7
    EXPAND STR_FROM_PARTS expected_two, &LINES_TWO, 3
    EXPAND STR_EMPTY empty
    EXPAND STRING_BUF_FROM_STR split_owned, split_text
    EXPAND STRING_BUF_FROM_STR lines_owned, lines_text
    EXPAND STRING_BUF_FROM_STR no_trail_owned, no_trail
    EXPAND STRING_BUF_FROM_STR empty_owned, empty
    EXPAND STRING_BUF_COUNT_BYTE count_colon, split_owned, 58
