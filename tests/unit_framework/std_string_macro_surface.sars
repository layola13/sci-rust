    EXPAND STR_SPLIT_INCLUSIVE_NEEDLE_COUNT empty_needle_count, term_hay, empty_needle

    EXPAND STR_TRY_SPLIT_INCLUSIVE_NEEDLE_AT ok_t0, term0, term_hay, colon, 0
    EXPAND STRING_SPLIT_INCLUSIVE_NEEDLE_AT ok_t1, term1, term_hay, colon, 1
    EXPAND STR_TRY_SPLIT_INCLUSIVE_NEEDLE_AT ok_t2, term2, term_hay, colon, 2
    EXPAND STR_SPLIT_INCLUSIVE_NEEDLE_AT ok_s2, split2, split_hay, colon, 2
    EXPAND STRING_BUF_TRY_SPLIT_INCLUSIVE_NEEDLE_AT ok_b2, bpart2, match_buf, colon, 2
    EXPAND STRING_BUF_SPLIT_INCLUSIVE_NEEDLE_AT ok_b3, bpart3, match_buf, colon, 3
    EXPAND STR_TRY_SPLIT_INCLUSIVE_NEEDLE_AT ok_m0, mpart0, multi_hay, multi_needle, 0
    EXPAND STR_SPLIT_INCLUSIVE_NEEDLE_AT ok_m1, mpart1, multi_hay, multi_needle, 1
    EXPAND STR_TRY_SPLIT_INCLUSIVE_NEEDLE_AT ok_m2, mpart2, multi_hay, multi_needle, 2
    EXPAND STR_TRY_SPLIT_INCLUSIVE_NEEDLE_AT ok_empty_hay, empty_hay_part, empty_hay, colon, 0
    EXPAND STR_TRY_SPLIT_INCLUSIVE_NEEDLE_AT ok_empty_needle, empty_needle_part, term_hay, empty_needle, 0

    EXPAND STR_EQ eq_t0, term0, incl0_exp
    EXPAND STR_EQ eq_t1, term1, incl1_exp
    EXPAND STR_EQ eq_s2, split2, colon
    EXPAND STR_EQ eq_b2, bpart2, tail_exp
    EXPAND STR_EQ eq_m0, mpart0, multi0_exp
    EXPAND STR_EQ eq_m1, mpart1, multi1_exp
    EXPAND STR_EQ eq_m2, mpart2, tail_exp
    EXPAND SLICE_GET_LEN term2_len, term2
    EXPAND SLICE_GET_LEN bpart3_len, bpart3
    EXPAND SLICE_GET_LEN empty_hay_len, empty_hay_part
    EXPAND SLICE_GET_LEN empty_needle_len, empty_needle_part

    term_count_ok = eq term_count, 2
    match_count_s_ok = eq match_count_s, 3
    match_count_b_ok = eq match_count_b, 3
    split_count_ok = eq split_count, 3
    multi_count_ok = eq multi_count, 3
