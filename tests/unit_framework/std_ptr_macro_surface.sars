@import "sa_std/ptr.sars"

@test "sa_std ptr primitive macros"():
L_ENTRY:
    slot = stack_alloc 8
    other = stack_alloc 8
    bytes = stack_alloc 4
    copy = stack_alloc 4
    copy_nonoverlap = stack_alloc 4

    EXPAND PTR_NULL null_ptr
    EXPAND PTR_IS_NULL null_is_null, null_ptr
    EXPAND PTR_IS_NONNULL null_is_nonnull, null_ptr
    EXPAND PTR_IS_NONNULL slot_is_nonnull, slot
    EXPAND PTR_EQ same_ptr, slot, slot
    EXPAND PTR_NE different_ptr, slot, other
    EXPAND PTR_ADDR slot_addr, slot
    EXPAND PTR_EXPOSE_ADDR exposed_addr, slot
    EXPAND PTR_EXPOSE_PROVENANCE exposed_provenance, slot
    EXPAND PTR_CAST cast_slot, slot
    EXPAND PTR_CAST_CONST cast_const_slot, slot
    EXPAND PTR_CAST_MUT cast_mut_slot, slot
    EXPAND PTR_IS_ALIGNED_TO slot_aligned, slot, 8
    EXPAND PTR_GUARANTEED_EQ guaranteed_eq_ok, guaranteed_eq_value, slot, slot
    EXPAND PTR_GUARANTEED_NE guaranteed_ne_ok, guaranteed_ne_value, slot, other

    store slot+0, 11 as u64
    store other+0, 22 as u64
    EXPAND PTR_READ_U64 read_slot, slot
    EXPAND PTR_WRITE_U64 slot, 33
    EXPAND PTR_READ_U64 read_slot_after_write, slot
    EXPAND PTR_SWAP_U64 slot, other
    EXPAND PTR_READ_U64 read_slot_after_swap, slot
    EXPAND PTR_READ_U64 read_other_after_swap, other
    EXPAND PTR_REPLACE_U64 old_slot, slot, 44
    EXPAND PTR_TAKE_U64 old_other, other
    EXPAND PTR_READ_U64 read_slot_after_replace, slot
    EXPAND PTR_READ_U64 read_other_after_take, other
    EXPAND PTR_WRITE_UNALIGNED_U64 slot, 55
    EXPAND PTR_READ_UNALIGNED_U64 read_slot_unaligned, slot
    EXPAND PTR_WRITE_VOLATILE_U64 slot, 66
    EXPAND PTR_READ_VOLATILE_U64 read_slot_volatile, slot

    EXPAND PTR_WRITE_U8 bytes, 65
    EXPAND PTR_OFFSET_BYTES byte1, bytes, 1
    EXPAND PTR_WRITE_U8 byte1, 66
    EXPAND PTR_BYTE_ADD byte2, bytes, 2
    EXPAND PTR_WRAPPING_BYTE_ADD byte3, bytes, 3
    EXPAND PTR_WRITE_UNALIGNED_U8 byte2, 67
    EXPAND PTR_WRITE_U8 byte3, 69
    EXPAND PTR_READ_UNALIGNED_U8 read_byte2_unaligned, byte2
    EXPAND PTR_READ_U8 read_byte3, byte3
    EXPAND PTR_WRITE_VOLATILE_U8 byte2, 68
    EXPAND PTR_READ_VOLATILE_U8 read_byte2_volatile, byte2
    EXPAND PTR_BYTE_SUB byte0_again, byte2, 2
    EXPAND PTR_WRAPPING_BYTE_SUB byte1_again, byte3, 2
    EXPAND PTR_OFFSET_FROM_BYTES byte_delta, byte2, bytes
    EXPAND PTR_BYTE_OFFSET_FROM_UNSIGNED byte_delta_unsigned, byte3, bytes
    EXPAND PTR_READ_U8 read_byte0, bytes
    EXPAND PTR_READ_U8 read_byte1, byte1
    EXPAND PTR_READ_U8 read_byte1_again, byte1_again
    EXPAND PTR_READ_U8 read_byte0_again, byte0_again
    EXPAND PTR_WRITE_BYTES bytes, 90, 4
    EXPAND PTR_COPY_BYTES copy, bytes, 4
    EXPAND PTR_COPY_NONOVERLAPPING_BYTES copy_nonoverlap, bytes, 4
    copy0 = load copy+0 as u8
    copy3 = load copy+3 as u8
    copy_nonoverlap2 = load copy_nonoverlap+2 as u8

    values = stack_alloc 16
    values_copy = stack_alloc 16
    store values+0, 101 as u64
    store values+8, 202 as u64
    EXPAND PTR_OFFSET_U64 values_second, values, 1
    EXPAND PTR_ADD_U64 values_second_add, values, 1
    EXPAND PTR_WRAPPING_ADD_U64 values_second_wrap, values, 1
    EXPAND PTR_READ_U64 read_values_second, values_second
    EXPAND PTR_READ_U64 read_values_second_add, values_second_add
    EXPAND PTR_READ_U64 read_values_second_wrap, values_second_wrap
    EXPAND PTR_SUB_U64 values_base_from_second, values_second, 1
    EXPAND PTR_WRAPPING_SUB_U64 values_base_from_wrap, values_second_wrap, 1
    EXPAND PTR_OFFSET_FROM_U64 u64_delta, values_second, values
    EXPAND PTR_OFFSET_FROM_UNSIGNED_U64 u64_delta_unsigned, values_second_add, values
    EXPAND PTR_COPY_U64S values_copy, values, 2
    EXPAND PTR_COPY_NONOVERLAPPING_U64S values_copy, values, 2
    values_copy0 = load values_copy+0 as u64
    values_copy1 = load values_copy+8 as u64

    ok_null = eq null_is_null, 1
    ok_null_not_nonnull = eq null_is_nonnull, 0
    ok_slot_nonnull = eq slot_is_nonnull, 1
    ok_same = eq same_ptr, 1
    ok_diff = eq different_ptr, 1
    ok_addr = ne slot_addr, 0
    ok_expose_addr = eq exposed_addr, slot_addr
    ok_expose_provenance = eq exposed_provenance, slot_addr
    ok_cast = eq cast_slot, slot
    ok_cast_const = eq cast_const_slot, slot
    ok_cast_mut = eq cast_mut_slot, slot
    ok_align = eq slot_aligned, 1
    ok_guaranteed_eq_ok = eq guaranteed_eq_ok, 1
    ok_guaranteed_eq_value = eq guaranteed_eq_value, 1
    ok_guaranteed_ne_ok = eq guaranteed_ne_ok, 1
    ok_guaranteed_ne_value = eq guaranteed_ne_value, 1
    ok_read = eq read_slot, 11
    ok_write = eq read_slot_after_write, 33
    ok_swap_slot = eq read_slot_after_swap, 22
    ok_swap_other = eq read_other_after_swap, 33
    ok_replace_old = eq old_slot, 22
    ok_replace_new = eq read_slot_after_replace, 44
    ok_take_old = eq old_other, 33
    ok_take_new = eq read_other_after_take, 0
    ok_unaligned_u64 = eq read_slot_unaligned, 55
    ok_volatile_u64 = eq read_slot_volatile, 66
    ok_byte0 = eq read_byte0, 65
    ok_byte1 = eq read_byte1, 66
    ok_byte2_unaligned = eq read_byte2_unaligned, 67
    ok_byte3 = eq read_byte3, 69
    ok_byte2_volatile = eq read_byte2_volatile, 68
    ok_byte0_again = eq read_byte0_again, 65
    ok_byte1_again = eq read_byte1_again, 66
    ok_byte_delta = eq byte_delta, 2
    ok_byte_delta_unsigned = eq byte_delta_unsigned, 3
    ok_copy0 = eq copy0, 90
    ok_copy3 = eq copy3, 90
    ok_copy_nonoverlap = eq copy_nonoverlap2, 90
    ok_second = eq read_values_second, 202
    ok_second_add = eq read_values_second_add, 202
    ok_second_wrap = eq read_values_second_wrap, 202
    ok_base_from_second = eq values_base_from_second, values
    ok_base_from_wrap = eq values_base_from_wrap, values
    ok_u64_delta = eq u64_delta, 1
    ok_u64_delta_unsigned = eq u64_delta_unsigned, 1
    ok_copy_u64_0 = eq values_copy0, 101
    ok_copy_u64_1 = eq values_copy1, 202

    ok01 = and ok_null, ok_null_not_nonnull
    ok02 = and ok01, ok_slot_nonnull
    ok03 = and ok02, ok_same
    ok04 = and ok03, ok_diff
    ok05 = and ok04, ok_addr
    ok06 = and ok05, ok_expose_addr
    ok06a = and ok06, ok_expose_provenance
    ok06b = and ok06a, ok_cast
    ok06c = and ok06b, ok_cast_const
    ok06d = and ok06c, ok_cast_mut
    ok07 = and ok06d, ok_align
    ok07a = and ok07, ok_guaranteed_eq_ok
    ok07b = and ok07a, ok_guaranteed_eq_value
    ok07c = and ok07b, ok_guaranteed_ne_ok
    ok07d = and ok07c, ok_guaranteed_ne_value
    ok08 = and ok07d, ok_read
    ok09 = and ok08, ok_write
    ok10 = and ok09, ok_swap_slot
    ok11 = and ok10, ok_swap_other
    ok12 = and ok11, ok_replace_old
    ok13 = and ok12, ok_replace_new
    ok14 = and ok13, ok_take_old
    ok15 = and ok14, ok_take_new
    ok16 = and ok15, ok_unaligned_u64
    ok17 = and ok16, ok_volatile_u64
    ok18 = and ok17, ok_byte0
    ok19 = and ok18, ok_byte1
    ok20 = and ok19, ok_byte2_unaligned
    ok20a = and ok20, ok_byte3
    ok21 = and ok20a, ok_byte2_volatile
    ok22 = and ok21, ok_byte0_again
    ok22a = and ok22, ok_byte1_again
    ok23 = and ok22a, ok_byte_delta
    ok23a = and ok23, ok_byte_delta_unsigned
    ok24 = and ok23a, ok_copy0
    ok25 = and ok24, ok_copy3
    ok26 = and ok25, ok_copy_nonoverlap
    ok27 = and ok26, ok_second
    ok27a = and ok27, ok_second_add
    ok27b = and ok27a, ok_second_wrap
    ok27c = and ok27b, ok_base_from_second
    ok27d = and ok27c, ok_base_from_wrap
    ok28 = and ok27d, ok_u64_delta
    ok28a = and ok28, ok_u64_delta_unsigned
    ok29 = and ok28a, ok_copy_u64_0
    ok = and ok29, ok_copy_u64_1

    !values_base_from_wrap
    !values_base_from_second
    !values_second_wrap
    !values_second_add
    !values_second
    !byte1_again
    !byte0_again
    !byte3
    !byte2
    !byte1
    !cast_mut_slot
    !cast_const_slot
    !cast_slot
    !null_ptr

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10214)

L_PASS:
    return 0

@test "sa_std ptr NonNull primitive macros"():
L_ENTRY:
    slot = stack_alloc 8
    other = stack_alloc 8
    wide = stack_alloc 16
    store slot+0, 123 as u64
    store other+0, 456 as u64
    store wide+0, 111 as u64
    store wide+8, 222 as u64

    nonnull = stack_alloc NonNull_SIZE
    nonnull_copy = stack_alloc NonNull_SIZE
    nonnull_other = stack_alloc NonNull_SIZE
    nonnull_wide = stack_alloc NonNull_SIZE
    nonnull_wide_second = stack_alloc NonNull_SIZE
    nonnull_wide_base = stack_alloc NonNull_SIZE
    null_nonnull = stack_alloc NonNull_SIZE

    EXPAND NONNULL_NEW new_ok, nonnull, slot
    EXPAND NONNULL_NEW_UNCHECKED nonnull_copy, slot
    EXPAND NONNULL_NEW_UNCHECKED nonnull_other, other
    EXPAND NONNULL_NEW_UNCHECKED nonnull_wide, wide
    EXPAND PTR_NULL null_ptr
    EXPAND NONNULL_NEW null_ok, null_nonnull, null_ptr

    EXPAND NONNULL_AS_PTR raw_ptr, nonnull
    EXPAND NONNULL_AS_REF ref_ptr, nonnull
    EXPAND NONNULL_AS_MUT mut_ptr, nonnull
    EXPAND NONNULL_ADDR nonnull_addr, nonnull
    EXPAND NONNULL_EXPOSE_PROVENANCE nonnull_exposed, nonnull
    raw_value = load raw_ptr+0 as u64
    ref_value = load ref_ptr+0 as u64
    store mut_ptr+0, 124 as u64
    mut_value = load slot+0 as u64
    EXPAND NONNULL_IS_NONNULL is_nonnull, nonnull
    EXPAND NONNULL_IS_NULL is_null, nonnull
    EXPAND NONNULL_IS_NULL null_is_null, null_nonnull
    EXPAND NONNULL_IS_ALIGNED_TO nonnull_aligned, nonnull, 8
    EXPAND NONNULL_EQ eq_copy, nonnull, nonnull_copy
    EXPAND NONNULL_NE ne_other, nonnull, nonnull_other
    EXPAND NONNULL_GUARANTEED_EQ nonnull_guaranteed_eq_ok, nonnull_guaranteed_eq_value, nonnull, nonnull_copy
    EXPAND NONNULL_GUARANTEED_NE nonnull_guaranteed_ne_ok, nonnull_guaranteed_ne_value, nonnull, nonnull_other

    casted = stack_alloc NonNull_SIZE
    EXPAND NONNULL_CAST casted, nonnull
    EXPAND NONNULL_AS_PTR casted_ptr, casted
    casted_value = load casted_ptr+0 as u64

    EXPAND NONNULL_BYTE_ADD nonnull_wide_second, nonnull_wide, 8
    EXPAND NONNULL_AS_PTR wide_second_ptr, nonnull_wide_second
    wide_second_value = load wide_second_ptr+0 as u64
    expected_wide_second = ptr_add wide, 8
    EXPAND NONNULL_BYTE_SUB nonnull_wide_base, nonnull_wide_second, 8
    EXPAND NONNULL_AS_PTR wide_base_ptr, nonnull_wide_base
    wide_base_value = load wide_base_ptr+0 as u64
    EXPAND NONNULL_WRAPPING_BYTE_ADD nonnull_wide_second, nonnull_wide, 8
    EXPAND NONNULL_BYTE_OFFSET_FROM_UNSIGNED nonnull_byte_delta, nonnull_wide_second, nonnull_wide
    EXPAND NONNULL_OFFSET_FROM_BYTES nonnull_byte_delta_signed, nonnull_wide_second, nonnull_wide
    EXPAND NONNULL_WRAPPING_BYTE_SUB nonnull_wide_base, nonnull_wide_second, 8
    EXPAND NONNULL_ADD_U64 nonnull_wide_second, nonnull_wide, 1
    EXPAND NONNULL_OFFSET_FROM_U64 nonnull_u64_delta, nonnull_wide_second, nonnull_wide
    EXPAND NONNULL_OFFSET_FROM_UNSIGNED_U64 nonnull_u64_delta_unsigned, nonnull_wide_second, nonnull_wide
    EXPAND NONNULL_SUB_U64 nonnull_wide_base, nonnull_wide_second, 1
    EXPAND NONNULL_AS_PTR wide_base_ptr_after_sub, nonnull_wide_base
    EXPAND NONNULL_WRAPPING_ADD_U64 nonnull_wide_second, nonnull_wide, 1
    EXPAND NONNULL_WRAPPING_SUB_U64 nonnull_wide_base, nonnull_wide_second, 1
    EXPAND NONNULL_AS_PTR wide_base_ptr_after_wrap_sub, nonnull_wide_base

    ok_new = eq new_ok, 1
    ok_null_new = eq null_ok, 0
    ok_raw_ptr = eq raw_ptr, slot
    ok_raw_value = eq raw_value, 123
    ok_ref_ptr = eq ref_ptr, slot
    ok_ref_value = eq ref_value, 123
    ok_mut_ptr = eq mut_ptr, slot
    ok_mut_value = eq mut_value, 124
    slot_addr = bitcast slot as u64
    ok_nonnull_addr = eq nonnull_addr, slot_addr
    ok_nonnull_exposed = eq nonnull_exposed, slot_addr
    ok_nonnull = eq is_nonnull, 1
    ok_not_null = eq is_null, 0
    ok_null_stored = eq null_is_null, 1
    ok_nonnull_aligned = eq nonnull_aligned, 1
    ok_eq = eq eq_copy, 1
    ok_ne = eq ne_other, 1
    ok_nonnull_guaranteed_eq_ok = eq nonnull_guaranteed_eq_ok, 1
    ok_nonnull_guaranteed_eq_value = eq nonnull_guaranteed_eq_value, 1
    ok_nonnull_guaranteed_ne_ok = eq nonnull_guaranteed_ne_ok, 1
    ok_nonnull_guaranteed_ne_value = eq nonnull_guaranteed_ne_value, 1
    ok_cast_ptr = eq casted_ptr, slot
    ok_casted_value = eq casted_value, 124
    ok_wide_second_ptr = eq wide_second_ptr, expected_wide_second
    ok_wide_second_value = eq wide_second_value, 222
    ok_wide_base_ptr = eq wide_base_ptr, wide
    ok_wide_base_value = eq wide_base_value, 111
    ok_nonnull_byte_delta = eq nonnull_byte_delta, 8
    ok_nonnull_byte_delta_signed = eq nonnull_byte_delta_signed, 8
    ok_nonnull_u64_delta = eq nonnull_u64_delta, 1
    ok_nonnull_u64_delta_unsigned = eq nonnull_u64_delta_unsigned, 1
    ok_wide_base_after_sub = eq wide_base_ptr_after_sub, wide
    ok_wide_base_after_wrap_sub = eq wide_base_ptr_after_wrap_sub, wide

    ok01 = and ok_new, ok_null_new
    ok02 = and ok01, ok_raw_ptr
    ok03 = and ok02, ok_raw_value
    ok04 = and ok03, ok_ref_ptr
    ok05 = and ok04, ok_ref_value
    ok06 = and ok05, ok_mut_ptr
    ok07 = and ok06, ok_mut_value
    ok08 = and ok07, ok_nonnull_addr
    ok08a = and ok08, ok_nonnull_exposed
    ok09 = and ok08a, ok_nonnull
    ok10 = and ok09, ok_not_null
    ok11 = and ok10, ok_null_stored
    ok11a = and ok11, ok_nonnull_aligned
    ok12 = and ok11a, ok_eq
    ok13 = and ok12, ok_ne
    ok13a = and ok13, ok_nonnull_guaranteed_eq_ok
    ok13b = and ok13a, ok_nonnull_guaranteed_eq_value
    ok13c = and ok13b, ok_nonnull_guaranteed_ne_ok
    ok13d = and ok13c, ok_nonnull_guaranteed_ne_value
    ok14 = and ok13d, ok_cast_ptr
    ok15 = and ok14, ok_casted_value
    ok16 = and ok15, ok_wide_second_ptr
    ok17 = and ok16, ok_wide_second_value
    ok18 = and ok17, ok_wide_base_ptr
    ok19 = and ok18, ok_wide_base_value
    ok20 = and ok19, ok_nonnull_byte_delta
    ok21 = and ok20, ok_nonnull_byte_delta_signed
    ok22 = and ok21, ok_nonnull_u64_delta
    ok23 = and ok22, ok_nonnull_u64_delta_unsigned
    ok24 = and ok23, ok_wide_base_after_sub
    ok = and ok24, ok_wide_base_after_wrap_sub

    !null_ptr
    !expected_wide_second
    !wide_base_ptr_after_wrap_sub
    !wide_base_ptr_after_sub
    !wide_base_ptr
    !wide_second_ptr
    !raw_ptr
    !ref_ptr
    !mut_ptr
    !casted_ptr

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10215)

L_PASS:
    return 0
