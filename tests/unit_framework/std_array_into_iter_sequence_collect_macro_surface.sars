@import "sa_std/array.sars"

@array_into_iter_separator_ninety() -> u64:
L_ENTRY:
    return 90

@array_into_iter_lt_four(value: u64) -> u64:
L_ENTRY:
    out = ult value, 4
    !value
    return out

@array_into_iter_lt_ten(value: u64) -> u64:
L_ENTRY:
    out = ult value, 10
    !value
    return out

@test "sa_std array into_iter sequence collect macro surface"():
L_ENTRY:
    intersperse_arr = stack_alloc 24
    store intersperse_arr+0, 2 as u64
    store intersperse_arr+8, 4 as u64
    store intersperse_arr+16, 6 as u64
    EXPAND ARRAY_INTO_ITER_U64 intersperse_iter, intersperse_backing, intersperse_arr, 3
    EXPAND ARRAY_INTO_ITER_INTERSPERSE_COLLECT_U64 intersperse_vec, intersperse_iter, 99
    EXPAND VEC_LEN intersperse_len, intersperse_vec
    EXPAND VEC_GET_U64 intersperse_0, intersperse_vec, 0
    EXPAND VEC_GET_U64 intersperse_1, intersperse_vec, 1
    EXPAND VEC_GET_U64 intersperse_4, intersperse_vec, 4
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 intersperse_empty, intersperse_iter

    intersperse_with_arr = stack_alloc 24
    store intersperse_with_arr+0, 3 as u64
    store intersperse_with_arr+8, 5 as u64
    store intersperse_with_arr+16, 7 as u64
    EXPAND ARRAY_INTO_ITER_U64 intersperse_with_iter, intersperse_with_backing, intersperse_with_arr, 3
    EXPAND ARRAY_INTO_ITER_INTERSPERSE_WITH_COLLECT_U64 intersperse_with_vec, intersperse_with_iter, @array_into_iter_separator_ninety
    EXPAND VEC_LEN intersperse_with_len, intersperse_with_vec
    EXPAND VEC_GET_U64 intersperse_with_0, intersperse_with_vec, 0
    EXPAND VEC_GET_U64 intersperse_with_1, intersperse_with_vec, 1
    EXPAND VEC_GET_U64 intersperse_with_4, intersperse_with_vec, 4
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 intersperse_with_empty, intersperse_with_iter

    cycle_arr = stack_alloc 24
    store cycle_arr+0, 3 as u64
    store cycle_arr+8, 5 as u64
    store cycle_arr+16, 7 as u64
    EXPAND ARRAY_INTO_ITER_U64 cycle_iter, cycle_backing, cycle_arr, 3
    EXPAND ARRAY_INTO_ITER_CYCLE_TAKE_COLLECT_U64 cycle_vec, cycle_iter, 8
    EXPAND VEC_LEN cycle_len, cycle_vec
    EXPAND VEC_GET_U64 cycle_0, cycle_vec, 0
    EXPAND VEC_GET_U64 cycle_3, cycle_vec, 3
    EXPAND VEC_GET_U64 cycle_7, cycle_vec, 7
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 cycle_empty, cycle_iter

    zero_cycle_arr = stack_alloc 16
    store zero_cycle_arr+0, 11 as u64
    store zero_cycle_arr+8, 12 as u64
    EXPAND ARRAY_INTO_ITER_U64 zero_cycle_iter, zero_cycle_backing, zero_cycle_arr, 2
    EXPAND ARRAY_INTO_ITER_CYCLE_TAKE_COLLECT_U64 zero_cycle_vec, zero_cycle_iter, 0
    EXPAND VEC_LEN zero_cycle_len, zero_cycle_vec
    EXPAND ARRAY_INTO_ITER_NEXT_U64 zero_cycle_next_has, zero_cycle_next, zero_cycle_iter
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 zero_cycle_remaining, zero_cycle_iter

    take_while_arr = stack_alloc 40
    store take_while_arr+0, 1 as u64
    store take_while_arr+8, 2 as u64
    store take_while_arr+16, 3 as u64
    store take_while_arr+24, 4 as u64
    store take_while_arr+32, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 take_while_iter, take_while_backing, take_while_arr, 5
    EXPAND ARRAY_INTO_ITER_TAKE_WHILE_COLLECT_U64 take_while_vec, take_while_iter, @array_into_iter_lt_four
    EXPAND VEC_LEN take_while_len, take_while_vec
    EXPAND VEC_GET_U64 take_while_0, take_while_vec, 0
    EXPAND VEC_GET_U64 take_while_2, take_while_vec, 2
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 take_while_remaining, take_while_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 take_while_tail_has, take_while_tail, take_while_iter

    take_all_arr = stack_alloc 16
    store take_all_arr+0, 1 as u64
    store take_all_arr+8, 2 as u64
    EXPAND ARRAY_INTO_ITER_U64 take_all_iter, take_all_backing, take_all_arr, 2
    EXPAND ARRAY_INTO_ITER_TAKE_WHILE_COLLECT_U64 take_all_vec, take_all_iter, @array_into_iter_lt_ten
    EXPAND VEC_LEN take_all_len, take_all_vec
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 take_all_empty, take_all_iter

    skip_while_arr = stack_alloc 40
    store skip_while_arr+0, 1 as u64
    store skip_while_arr+8, 2 as u64
    store skip_while_arr+16, 3 as u64
    store skip_while_arr+24, 4 as u64
    store skip_while_arr+32, 5 as u64
    EXPAND ARRAY_INTO_ITER_U64 skip_while_iter, skip_while_backing, skip_while_arr, 5
    EXPAND ARRAY_INTO_ITER_SKIP_WHILE_COLLECT_U64 skip_while_vec, skip_while_iter, @array_into_iter_lt_four
    EXPAND VEC_LEN skip_while_len, skip_while_vec
    EXPAND VEC_GET_U64 skip_while_0, skip_while_vec, 0
    EXPAND VEC_GET_U64 skip_while_1, skip_while_vec, 1
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_while_empty, skip_while_iter

    skip_all_arr = stack_alloc 16
    store skip_all_arr+0, 1 as u64
    store skip_all_arr+8, 2 as u64
    EXPAND ARRAY_INTO_ITER_U64 skip_all_iter, skip_all_backing, skip_all_arr, 2
    EXPAND ARRAY_INTO_ITER_SKIP_WHILE_COLLECT_U64 skip_all_vec, skip_all_iter, @array_into_iter_lt_ten
    EXPAND VEC_LEN skip_all_len, skip_all_vec
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_all_empty, skip_all_iter

    EXPAND VEC_FREE intersperse_backing
    EXPAND VEC_FREE intersperse_vec
    EXPAND VEC_FREE intersperse_with_backing
    EXPAND VEC_FREE intersperse_with_vec
    EXPAND VEC_FREE cycle_backing
    EXPAND VEC_FREE cycle_vec
    EXPAND VEC_FREE zero_cycle_backing
    EXPAND VEC_FREE zero_cycle_vec
    EXPAND VEC_FREE take_while_backing
    EXPAND VEC_FREE take_while_vec
    EXPAND VEC_FREE take_all_backing
    EXPAND VEC_FREE take_all_vec
    EXPAND VEC_FREE skip_while_backing
    EXPAND VEC_FREE skip_while_vec
    EXPAND VEC_FREE skip_all_backing
    EXPAND VEC_FREE skip_all_vec

    ok_intersperse_len = eq intersperse_len, 5
    ok_intersperse_0 = eq intersperse_0, 2
    ok_intersperse_1 = eq intersperse_1, 99
    ok_intersperse_4 = eq intersperse_4, 6
    ok_intersperse_empty = eq intersperse_empty, 1
    ok_intersperse_with_len = eq intersperse_with_len, 5
    ok_intersperse_with_0 = eq intersperse_with_0, 3
    ok_intersperse_with_1 = eq intersperse_with_1, 90
    ok_intersperse_with_4 = eq intersperse_with_4, 7
    ok_intersperse_with_empty = eq intersperse_with_empty, 1
    ok_cycle_len = eq cycle_len, 8
    ok_cycle_0 = eq cycle_0, 3
    ok_cycle_3 = eq cycle_3, 3
    ok_cycle_7 = eq cycle_7, 5
    ok_cycle_empty = eq cycle_empty, 1
    ok_zero_cycle_len = eq zero_cycle_len, 0
    ok_zero_cycle_next_has = eq zero_cycle_next_has, 1
    ok_zero_cycle_next = eq zero_cycle_next, 11
    ok_zero_cycle_remaining = eq zero_cycle_remaining, 1
    ok_take_while_len = eq take_while_len, 3
    ok_take_while_0 = eq take_while_0, 1
    ok_take_while_2 = eq take_while_2, 3
    ok_take_while_remaining = eq take_while_remaining, 1
    ok_take_while_tail_has = eq take_while_tail_has, 1
    ok_take_while_tail = eq take_while_tail, 5
    ok_take_all_len = eq take_all_len, 2
    ok_take_all_empty = eq take_all_empty, 1
    ok_skip_while_len = eq skip_while_len, 2
    ok_skip_while_0 = eq skip_while_0, 4
    ok_skip_while_1 = eq skip_while_1, 5
    ok_skip_while_empty = eq skip_while_empty, 1
    ok_skip_all_len = eq skip_all_len, 0
    ok_skip_all_empty = eq skip_all_empty, 1

    ok = and ok_intersperse_len, ok_intersperse_0
    ok = and ok, ok_intersperse_1
    ok = and ok, ok_intersperse_4
    ok = and ok, ok_intersperse_empty
    ok = and ok, ok_intersperse_with_len
    ok = and ok, ok_intersperse_with_0
    ok = and ok, ok_intersperse_with_1
    ok = and ok, ok_intersperse_with_4
    ok = and ok, ok_intersperse_with_empty
    ok = and ok, ok_cycle_len
    ok = and ok, ok_cycle_0
    ok = and ok, ok_cycle_3
    ok = and ok, ok_cycle_7
    ok = and ok, ok_cycle_empty
    ok = and ok, ok_zero_cycle_len
    ok = and ok, ok_zero_cycle_next_has
    ok = and ok, ok_zero_cycle_next
    ok = and ok, ok_zero_cycle_remaining
    ok = and ok, ok_take_while_len
    ok = and ok, ok_take_while_0
    ok = and ok, ok_take_while_2
    ok = and ok, ok_take_while_remaining
    ok = and ok, ok_take_while_tail_has
    ok = and ok, ok_take_while_tail
    ok = and ok, ok_take_all_len
    ok = and ok, ok_take_all_empty
    ok = and ok, ok_skip_while_len
    ok = and ok, ok_skip_while_0
    ok = and ok, ok_skip_while_1
    ok = and ok, ok_skip_while_empty
    ok = and ok, ok_skip_all_len
    ok = and ok, ok_skip_all_empty

    !intersperse_len
    !intersperse_0
    !intersperse_1
    !intersperse_4
    !intersperse_empty
    !intersperse_with_len
    !intersperse_with_0
    !intersperse_with_1
    !intersperse_with_4
    !intersperse_with_empty
    !cycle_len
    !cycle_0
    !cycle_3
    !cycle_7
    !cycle_empty
    !zero_cycle_len
    !zero_cycle_next_has
    !zero_cycle_next
    !zero_cycle_remaining
    !take_while_len
    !take_while_0
    !take_while_2
    !take_while_remaining
    !take_while_tail_has
    !take_while_tail
    !take_all_len
    !take_all_empty
    !skip_while_len
    !skip_while_0
    !skip_while_1
    !skip_while_empty
    !skip_all_len
    !skip_all_empty
    !ok_intersperse_len
    !ok_intersperse_0
    !ok_intersperse_1
    !ok_intersperse_4
    !ok_intersperse_empty
    !ok_intersperse_with_len
    !ok_intersperse_with_0
    !ok_intersperse_with_1
    !ok_intersperse_with_4
    !ok_intersperse_with_empty
    !ok_cycle_len
    !ok_cycle_0
    !ok_cycle_3
    !ok_cycle_7
    !ok_cycle_empty
    !ok_zero_cycle_len
    !ok_zero_cycle_next_has
    !ok_zero_cycle_next
    !ok_zero_cycle_remaining
    !ok_take_while_len
    !ok_take_while_0
    !ok_take_while_2
    !ok_take_while_remaining
    !ok_take_while_tail_has
    !ok_take_while_tail
    !ok_take_all_len
    !ok_take_all_empty
    !ok_skip_while_len
    !ok_skip_while_0
    !ok_skip_while_1
    !ok_skip_while_empty
    !ok_skip_all_len
    !ok_skip_all_empty
    !intersperse_iter
    !intersperse_with_iter
    !cycle_iter
    !zero_cycle_iter
    !take_while_iter
    !take_all_iter
    !skip_while_iter
    !skip_all_iter
    br ok -> L_ARRAY_INTO_ITER_SEQUENCE_COLLECT_OK, L_ARRAY_INTO_ITER_SEQUENCE_COLLECT_FAIL

L_ARRAY_INTO_ITER_SEQUENCE_COLLECT_FAIL:
    !ok
    panic(10749)

L_ARRAY_INTO_ITER_SEQUENCE_COLLECT_OK:
    !ok
    return
