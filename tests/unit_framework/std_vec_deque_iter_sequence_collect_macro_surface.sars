@import "sa_std/vec_deque.sars"

@vec_deque_iter_sequence_separator_ninety() -> u64:
L_ENTRY:
    return 90

@vec_deque_iter_sequence_lt_50(value: u64) -> u64:
L_ENTRY:
    out = ult value, 50
    !value
    return out

@vec_deque_iter_sequence_lt_100(value: u64) -> u64:
L_ENTRY:
    out = ult value, 100
    !value
    return out

@test "sa_std vec_deque iterator sequence collect macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop_ok, pop_value, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50
    EXPAND VEC_DEQUE_PUSH_BACK deque, 60

    EXPAND VEC_DEQUE_ITER_U64 intersperse_iter, intersperse_backing, deque
    EXPAND VEC_DEQUE_ITER_INTERSPERSE_COLLECT_U64 intersperse_vec, intersperse_iter, 99
    EXPAND VEC_LEN intersperse_len, intersperse_vec
    EXPAND VEC_GET_U64 intersperse_0, intersperse_vec, 0
    EXPAND VEC_GET_U64 intersperse_1, intersperse_vec, 1
    EXPAND VEC_GET_U64 intersperse_8, intersperse_vec, 8
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 intersperse_empty, intersperse_iter

    EXPAND VEC_DEQUE_ITER_U64 intersperse_with_iter, intersperse_with_backing, deque
    EXPAND VEC_DEQUE_ITER_INTERSPERSE_WITH_COLLECT_U64 intersperse_with_vec, intersperse_with_iter, @vec_deque_iter_sequence_separator_ninety
    EXPAND VEC_LEN intersperse_with_len, intersperse_with_vec
    EXPAND VEC_GET_U64 intersperse_with_0, intersperse_with_vec, 0
    EXPAND VEC_GET_U64 intersperse_with_1, intersperse_with_vec, 1
    EXPAND VEC_GET_U64 intersperse_with_8, intersperse_with_vec, 8
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 intersperse_with_empty, intersperse_with_iter

    EXPAND VEC_DEQUE_ITER_U64 cycle_iter, cycle_backing, deque
    EXPAND VEC_DEQUE_ITER_CYCLE_TAKE_COLLECT_U64 cycle_vec, cycle_iter, 8
    EXPAND VEC_LEN cycle_len, cycle_vec
    EXPAND VEC_GET_U64 cycle_0, cycle_vec, 0
    EXPAND VEC_GET_U64 cycle_4, cycle_vec, 4
    EXPAND VEC_GET_U64 cycle_7, cycle_vec, 7
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 cycle_empty, cycle_iter

    EXPAND VEC_DEQUE_ITER_U64 zero_cycle_iter, zero_cycle_backing, deque
    EXPAND VEC_DEQUE_ITER_CYCLE_TAKE_COLLECT_U64 zero_cycle_vec, zero_cycle_iter, 0
    EXPAND VEC_LEN zero_cycle_len, zero_cycle_vec
    EXPAND VEC_DEQUE_ITER_NEXT_U64 zero_cycle_next_has, zero_cycle_next, zero_cycle_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 zero_cycle_remaining, zero_cycle_iter

    EXPAND VEC_DEQUE_ITER_U64 take_while_iter, take_while_backing, deque
    EXPAND VEC_DEQUE_ITER_TAKE_WHILE_COLLECT_U64 take_while_vec, take_while_iter, @vec_deque_iter_sequence_lt_50
    EXPAND VEC_LEN take_while_len, take_while_vec
    EXPAND VEC_GET_U64 take_while_0, take_while_vec, 0
    EXPAND VEC_GET_U64 take_while_2, take_while_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 take_while_remaining, take_while_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 take_while_tail_has, take_while_tail, take_while_iter

    EXPAND VEC_DEQUE_ITER_U64 take_all_iter, take_all_backing, deque
    EXPAND VEC_DEQUE_ITER_TAKE_WHILE_COLLECT_U64 take_all_vec, take_all_iter, @vec_deque_iter_sequence_lt_100
    EXPAND VEC_LEN take_all_len, take_all_vec
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 take_all_empty, take_all_iter

    EXPAND VEC_DEQUE_ITER_U64 skip_while_iter, skip_while_backing, deque
    EXPAND VEC_DEQUE_ITER_SKIP_WHILE_COLLECT_U64 skip_while_vec, skip_while_iter, @vec_deque_iter_sequence_lt_50
    EXPAND VEC_LEN skip_while_len, skip_while_vec
    EXPAND VEC_GET_U64 skip_while_0, skip_while_vec, 0
    EXPAND VEC_GET_U64 skip_while_1, skip_while_vec, 1
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_while_empty, skip_while_iter

    EXPAND VEC_DEQUE_ITER_U64 skip_all_iter, skip_all_backing, deque
    EXPAND VEC_DEQUE_ITER_SKIP_WHILE_COLLECT_U64 skip_all_vec, skip_all_iter, @vec_deque_iter_sequence_lt_100
    EXPAND VEC_LEN skip_all_len, skip_all_vec
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_all_empty, skip_all_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 3
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_INTERSPERSE_COLLECT_U64 into_vec, into_iter, 7
    EXPAND VEC_LEN into_len, into_vec
    EXPAND VEC_GET_U64 into_0, into_vec, 0
    EXPAND VEC_GET_U64 into_1, into_vec, 1
    EXPAND VEC_GET_U64 into_4, into_vec, 4
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_FREE intersperse_backing
    EXPAND VEC_FREE intersperse_vec
    EXPAND VEC_FREE intersperse_with_backing
    EXPAND VEC_FREE intersperse_with_vec
    EXPAND VEC_FREE cycle_backing
    EXPAND VEC_FREE cycle_vec
    EXPAND VEC_FREE zero_cycle_backing
    EXPAND VEC_FREE zero_cycle_vec
    EXPAND VEC_FREE take_while_backing
    EXPAND VEC_FREE take_while_vec
    EXPAND VEC_FREE take_all_backing
    EXPAND VEC_FREE take_all_vec
    EXPAND VEC_FREE skip_while_backing
    EXPAND VEC_FREE skip_while_vec
    EXPAND VEC_FREE skip_all_backing
    EXPAND VEC_FREE skip_all_vec
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_vec
    EXPAND VEC_DEQUE_FREE deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq pop_ok, 1
    check = eq pop_value, 10
    ok = and ok, check
    check = eq intersperse_len, 9
    ok = and ok, check
    check = eq intersperse_0, 20
    ok = and ok, check
    check = eq intersperse_1, 99
    ok = and ok, check
    check = eq intersperse_8, 60
    ok = and ok, check
    check = eq intersperse_empty, 1
    ok = and ok, check
    check = eq intersperse_with_len, 9
    ok = and ok, check
    check = eq intersperse_with_0, 20
    ok = and ok, check
    check = eq intersperse_with_1, 90
    ok = and ok, check
    check = eq intersperse_with_8, 60
    ok = and ok, check
    check = eq intersperse_with_empty, 1
    ok = and ok, check
    check = eq cycle_len, 8
    ok = and ok, check
    check = eq cycle_0, 20
    ok = and ok, check
    check = eq cycle_4, 60
    ok = and ok, check
    check = eq cycle_7, 40
    ok = and ok, check
    check = eq cycle_empty, 1
    ok = and ok, check
    check = eq zero_cycle_len, 0
    ok = and ok, check
    check = eq zero_cycle_next_has, 1
    ok = and ok, check
    check = eq zero_cycle_next, 20
    ok = and ok, check
    check = eq zero_cycle_remaining, 4
    ok = and ok, check
    check = eq take_while_len, 3
    ok = and ok, check
    check = eq take_while_0, 20
    ok = and ok, check
    check = eq take_while_2, 40
    ok = and ok, check
    check = eq take_while_remaining, 1
    ok = and ok, check
    check = eq take_while_tail_has, 1
    ok = and ok, check
    check = eq take_while_tail, 60
    ok = and ok, check
    check = eq take_all_len, 5
    ok = and ok, check
    check = eq take_all_empty, 1
    ok = and ok, check
    check = eq skip_while_len, 2
    ok = and ok, check
    check = eq skip_while_0, 50
    ok = and ok, check
    check = eq skip_while_1, 60
    ok = and ok, check
    check = eq skip_while_empty, 1
    ok = and ok, check
    check = eq skip_all_len, 0
    ok = and ok, check
    check = eq skip_all_empty, 1
    ok = and ok, check
    check = eq into_len, 5
    ok = and ok, check
    check = eq into_0, 1
    ok = and ok, check
    check = eq into_1, 7
    ok = and ok, check
    check = eq into_4, 3
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check

    !pop_ok
    !pop_value
    !intersperse_len
    !intersperse_0
    !intersperse_1
    !intersperse_8
    !intersperse_empty
    !intersperse_with_len
    !intersperse_with_0
    !intersperse_with_1
    !intersperse_with_8
    !intersperse_with_empty
    !cycle_len
    !cycle_0
    !cycle_4
    !cycle_7
    !cycle_empty
    !zero_cycle_len
    !zero_cycle_next_has
    !zero_cycle_next
    !zero_cycle_remaining
    !take_while_len
    !take_while_0
    !take_while_2
    !take_while_remaining
    !take_while_tail_has
    !take_while_tail
    !take_all_len
    !take_all_empty
    !skip_while_len
    !skip_while_0
    !skip_while_1
    !skip_while_empty
    !skip_all_len
    !skip_all_empty
    !into_len
    !into_0
    !into_1
    !into_4
    !into_empty
    !into_deque_empty
    !check
    !intersperse_iter
    !intersperse_with_iter
    !cycle_iter
    !zero_cycle_iter
    !take_while_iter
    !take_all_iter
    !skip_while_iter
    !skip_all_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_SEQUENCE_OK, L_VEC_DEQUE_ITER_SEQUENCE_FAIL
L_VEC_DEQUE_ITER_SEQUENCE_FAIL:
    !ok
    panic(10795)
L_VEC_DEQUE_ITER_SEQUENCE_OK:
    !ok
    return
