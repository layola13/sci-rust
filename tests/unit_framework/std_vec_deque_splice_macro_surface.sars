@import "sa_std/vec_deque.sars"
@import "sa_std/vec.sars"

@test "sa_std vec_deque splice macro surface"():
L_ENTRY:
    repl_mem = stack_alloc 16
    store repl_mem+0, 77 as u64
    store repl_mem+8, 88 as u64
    repl_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW repl_slice, repl_mem, 2

    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT wrap_pop_ok, wrap_pop, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50

    EXPAND VEC_DEQUE_SPLICE_U64 splice_ok, spliced, deque, 1, 2, repl_slice
    EXPAND VEC_DEQUE_LEN deque_len_after_splice, deque
    EXPAND VEC_LEN spliced_len, spliced
    EXPAND VEC_DEQUE_GET_U64 deque0, deque, 0
    EXPAND VEC_DEQUE_GET_U64 deque1, deque, 1
    EXPAND VEC_DEQUE_GET_U64 deque2, deque, 2
    EXPAND VEC_DEQUE_GET_U64 deque3, deque, 3
    EXPAND VEC_TRY_GET_U64 spliced0_ok, spliced0, spliced, 0
    EXPAND VEC_TRY_GET_U64 spliced1_ok, spliced1, spliced, 1

    EXPAND VEC_WITH_CAPACITY_U64 miss_repl_vec, 1
    EXPAND VEC_PUSH_U64 miss_repl_vec, 99
    EXPAND VEC_AS_SLICE miss_repl_slice, miss_repl_vec
    EXPAND VEC_DEQUE_SPLICE_U64 splice_miss_ok, splice_miss, deque, 9, 1, miss_repl_slice
    EXPAND VEC_DEQUE_LEN deque_len_after_miss, deque
    EXPAND VEC_LEN splice_miss_len, splice_miss

    ok = eq wrap_pop_ok, 1
    check = eq wrap_pop, 10
    ok = and ok, check
    check = eq splice_ok, 1
    ok = and ok, check
    check = eq deque_len_after_splice, 4
    ok = and ok, check
    check = eq spliced_len, 2
    ok = and ok, check
    check = eq deque0, 20
    ok = and ok, check
    check = eq deque1, 77
    ok = and ok, check
    check = eq deque2, 88
    ok = and ok, check
    check = eq deque3, 50
    ok = and ok, check
    check = eq spliced0_ok, 1
    ok = and ok, check
    check = eq spliced0, 30
    ok = and ok, check
    check = eq spliced1_ok, 1
    ok = and ok, check
    check = eq spliced1, 40
    ok = and ok, check
    check = eq splice_miss_ok, 0
    ok = and ok, check
    check = eq deque_len_after_miss, 4
    ok = and ok, check
    check = eq splice_miss_len, 0
    ok = and ok, check

    !repl_slice
    !miss_repl_slice
    !wrap_pop_ok
    !wrap_pop
    !splice_ok
    !spliced_len
    !deque_len_after_splice
    !deque0
    !deque1
    !deque2
    !deque3
    !spliced0_ok
    !spliced0
    !spliced1_ok
    !spliced1
    !splice_miss_ok
    !splice_miss_len
    !deque_len_after_miss
    !check
    EXPAND VEC_FREE miss_repl_vec
    EXPAND VEC_FREE spliced
    EXPAND VEC_DEQUE_FREE deque
    br ok -> L_VEC_DEQUE_SPLICE_OK, L_VEC_DEQUE_SPLICE_FAIL

L_VEC_DEQUE_SPLICE_FAIL:
    !ok
    panic(10804)

L_VEC_DEQUE_SPLICE_OK:
    !ok
    return
