@import "sa_std/num.sars"

@test "sa_std num narrow signed pow macro surface"():
L_ENTRY:
    EXPAND NUM_I8_POW i8_pos, 3, 4
    EXPAND NUM_I8_POW i8_neg_odd, -3, 3
    EXPAND NUM_I8_POW i8_neg_even, -3, 2
    EXPAND NUM_I8_POW i8_zero_exp, 0, 0
    EXPAND NUM_I8_POW i8_wrap, 3, 5
    EXPAND NUM_I8_POW i8_raw, 255, 3

    EXPAND NUM_I16_POW i16_pos, 3, 5
    EXPAND NUM_I16_POW i16_neg_odd, -2, 15
    EXPAND NUM_I16_POW i16_wrap, 2, 15
    EXPAND NUM_I16_POW i16_raw, 65535, 3

    EXPAND NUM_I32_POW i32_pos, 3, 8
    EXPAND NUM_I32_POW i32_neg_odd, -2, 31
    EXPAND NUM_I32_POW i32_wrap, 2, 31
    EXPAND NUM_I32_POW i32_raw, 4294967295, 3

    ok01 = eq i8_pos, 81
    ok02 = eq i8_neg_odd, -27
    ok03 = eq i8_neg_even, 9
    ok04 = eq i8_zero_exp, 1
    ok05 = eq i8_wrap, -13
    ok06 = eq i8_raw, -1
    ok07 = eq i16_pos, 243
    ok08 = eq i16_neg_odd, -32768
    ok09 = eq i16_wrap, -32768
    ok10 = eq i16_raw, -1
    ok11 = eq i32_pos, 6561
    ok12 = eq i32_neg_odd, -2147483648
    ok13 = eq i32_wrap, -2147483648
    ok14 = eq i32_raw, -1

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    ok = and chain12, ok14

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10677)

L_PASS:
    return 0
