@import "sa_std/vec_deque.sars"

@vec_deque_iter_transform_times_ten(value: u64) -> u64:
L_ENTRY:
    out = mul value, 10
    !value
    return out

@vec_deque_iter_transform_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    return out

@vec_deque_iter_transform_inspect_ignored(value: u64) -> u64:
L_ENTRY:
    out = mul value, 100
    !value
    return out

@vec_deque_iter_transform_even_tens(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    rem = urem value, 2
    keep = eq rem, 0
    br keep -> L_VEC_DEQUE_FILTER_MAP_KEEP, L_VEC_DEQUE_FILTER_MAP_SKIP
L_VEC_DEQUE_FILTER_MAP_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !keep
    !rem
    !out_mapped
    !value
    return 1
L_VEC_DEQUE_FILTER_MAP_SKIP:
    !keep
    !rem
    !out_mapped
    !value
    return 0

@vec_deque_iter_transform_scan_sum_until_100(&state_ptr: ptr, value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    state = load state_ptr+0 as u64
    next = add state, value
    store state_ptr+0, next as u64
    keep = ule next, 100
    br keep -> L_VEC_DEQUE_SCAN_KEEP, L_VEC_DEQUE_SCAN_STOP
L_VEC_DEQUE_SCAN_KEEP:
    mapped = add next, 1000
    store out_mapped+0, mapped as u64
    !mapped
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 1
L_VEC_DEQUE_SCAN_STOP:
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 0

@vec_deque_iter_transform_map_while_lt_50(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    keep = ult value, 50
    br keep -> L_VEC_DEQUE_MAP_WHILE_KEEP, L_VEC_DEQUE_MAP_WHILE_STOP
L_VEC_DEQUE_MAP_WHILE_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !out_mapped
    !value
    return keep
L_VEC_DEQUE_MAP_WHILE_STOP:
    !out_mapped
    !value
    return keep

@test "sa_std vec_deque iterator transform collect macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop_ok, pop_value, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50
    EXPAND VEC_DEQUE_PUSH_BACK deque, 60

    EXPAND VEC_DEQUE_ITER_U64 map_iter, map_backing, deque
    EXPAND VEC_DEQUE_ITER_MAP_COLLECT_U64 map_vec, map_iter, @vec_deque_iter_transform_times_ten
    EXPAND VEC_LEN map_len, map_vec
    EXPAND VEC_GET_U64 map_0, map_vec, 0
    EXPAND VEC_GET_U64 map_4, map_vec, 4
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 map_empty, map_iter

    EXPAND VEC_DEQUE_ITER_U64 inspect_iter, inspect_backing, deque
    EXPAND VEC_DEQUE_ITER_INSPECT_COLLECT_U64 inspect_vec, inspect_iter, @vec_deque_iter_transform_inspect_ignored
    EXPAND VEC_LEN inspect_len, inspect_vec
    EXPAND VEC_GET_U64 inspect_0, inspect_vec, 0
    EXPAND VEC_GET_U64 inspect_4, inspect_vec, 4
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 inspect_empty, inspect_iter

    EXPAND VEC_DEQUE_ITER_U64 scan_iter, scan_backing, deque
    EXPAND VEC_DEQUE_ITER_SCAN_COLLECT_U64 scan_vec, scan_iter, 0, @vec_deque_iter_transform_scan_sum_until_100
    EXPAND VEC_LEN scan_len, scan_vec
    EXPAND VEC_GET_U64 scan_0, scan_vec, 0
    EXPAND VEC_GET_U64 scan_2, scan_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 scan_remaining, scan_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 scan_tail_has, scan_tail, scan_iter

    EXPAND VEC_DEQUE_ITER_U64 filter_iter, filter_backing, deque
    EXPAND VEC_DEQUE_ITER_FILTER_COLLECT_U64 filter_vec, filter_iter, @vec_deque_iter_transform_is_even
    EXPAND VEC_LEN filter_len, filter_vec
    EXPAND VEC_GET_U64 filter_0, filter_vec, 0
    EXPAND VEC_GET_U64 filter_4, filter_vec, 4
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 filter_empty, filter_iter

    EXPAND VEC_DEQUE_ITER_U64 filter_map_iter, filter_map_backing, deque
    EXPAND VEC_DEQUE_ITER_FILTER_MAP_COLLECT_U64 filter_map_vec, filter_map_iter, @vec_deque_iter_transform_even_tens
    EXPAND VEC_LEN filter_map_len, filter_map_vec
    EXPAND VEC_GET_U64 filter_map_0, filter_map_vec, 0
    EXPAND VEC_GET_U64 filter_map_4, filter_map_vec, 4
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 filter_map_empty, filter_map_iter

    EXPAND VEC_DEQUE_ITER_U64 map_while_iter, map_while_backing, deque
    EXPAND VEC_DEQUE_ITER_MAP_WHILE_COLLECT_U64 map_while_vec, map_while_iter, @vec_deque_iter_transform_map_while_lt_50
    EXPAND VEC_LEN map_while_len, map_while_vec
    EXPAND VEC_GET_U64 map_while_0, map_while_vec, 0
    EXPAND VEC_GET_U64 map_while_2, map_while_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 map_while_remaining, map_while_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 map_while_tail_has, map_while_tail, map_while_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 3
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_MAP_COLLECT_U64 into_map_vec, into_iter, @vec_deque_iter_transform_times_ten
    EXPAND VEC_LEN into_map_len, into_map_vec
    EXPAND VEC_GET_U64 into_map_0, into_map_vec, 0
    EXPAND VEC_GET_U64 into_map_2, into_map_vec, 2
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_FREE map_backing
    EXPAND VEC_FREE map_vec
    EXPAND VEC_FREE inspect_backing
    EXPAND VEC_FREE inspect_vec
    EXPAND VEC_FREE scan_backing
    EXPAND VEC_FREE scan_vec
    EXPAND VEC_FREE filter_backing
    EXPAND VEC_FREE filter_vec
    EXPAND VEC_FREE filter_map_backing
    EXPAND VEC_FREE filter_map_vec
    EXPAND VEC_FREE map_while_backing
    EXPAND VEC_FREE map_while_vec
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_map_vec
    EXPAND VEC_DEQUE_FREE deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq pop_ok, 1
    check = eq pop_value, 10
    ok = and ok, check
    check = eq map_len, 5
    ok = and ok, check
    check = eq map_0, 200
    ok = and ok, check
    check = eq map_4, 600
    ok = and ok, check
    check = eq map_empty, 1
    ok = and ok, check
    check = eq inspect_len, 5
    ok = and ok, check
    check = eq inspect_0, 20
    ok = and ok, check
    check = eq inspect_4, 60
    ok = and ok, check
    check = eq inspect_empty, 1
    ok = and ok, check
    check = eq scan_len, 3
    ok = and ok, check
    check = eq scan_0, 1020
    ok = and ok, check
    check = eq scan_2, 1090
    ok = and ok, check
    check = eq scan_remaining, 1
    ok = and ok, check
    check = eq scan_tail_has, 1
    ok = and ok, check
    check = eq scan_tail, 60
    ok = and ok, check
    check = eq filter_len, 5
    ok = and ok, check
    check = eq filter_0, 20
    ok = and ok, check
    check = eq filter_4, 60
    ok = and ok, check
    check = eq filter_empty, 1
    ok = and ok, check
    check = eq filter_map_len, 5
    ok = and ok, check
    check = eq filter_map_0, 200
    ok = and ok, check
    check = eq filter_map_4, 600
    ok = and ok, check
    check = eq filter_map_empty, 1
    ok = and ok, check
    check = eq map_while_len, 3
    ok = and ok, check
    check = eq map_while_0, 200
    ok = and ok, check
    check = eq map_while_2, 400
    ok = and ok, check
    check = eq map_while_remaining, 1
    ok = and ok, check
    check = eq map_while_tail_has, 1
    ok = and ok, check
    check = eq map_while_tail, 60
    ok = and ok, check
    check = eq into_map_len, 3
    ok = and ok, check
    check = eq into_map_0, 10
    ok = and ok, check
    check = eq into_map_2, 30
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check

    !pop_ok
    !pop_value
    !map_len
    !map_0
    !map_4
    !map_empty
    !inspect_len
    !inspect_0
    !inspect_4
    !inspect_empty
    !scan_len
    !scan_0
    !scan_2
    !scan_remaining
    !scan_tail_has
    !scan_tail
    !filter_len
    !filter_0
    !filter_4
    !filter_empty
    !filter_map_len
    !filter_map_0
    !filter_map_4
    !filter_map_empty
    !map_while_len
    !map_while_0
    !map_while_2
    !map_while_remaining
    !map_while_tail_has
    !map_while_tail
    !into_map_len
    !into_map_0
    !into_map_2
    !into_empty
    !into_deque_empty
    !check
    !map_iter
    !inspect_iter
    !scan_iter
    !filter_iter
    !filter_map_iter
    !map_while_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_TRANSFORM_OK, L_VEC_DEQUE_ITER_TRANSFORM_FAIL
L_VEC_DEQUE_ITER_TRANSFORM_FAIL:
    !ok
    panic(10794)
L_VEC_DEQUE_ITER_TRANSFORM_OK:
    !ok
    return
