@import "sa_std/default.sars"
@import "sa_std/num.sars"

@test "sa_std Wrapping and Saturating clone/default macro surface"():
L_ENTRY:
    EXPAND DEFAULT_WRAPPING_U64 default_wrapping_u64
    EXPAND DEFAULT_WRAPPING_U32 default_wrapping_u32
    EXPAND DEFAULT_WRAPPING_I64 default_wrapping_i64
    EXPAND DEFAULT_SATURATING_U64 default_saturating_u64
    EXPAND DEFAULT_SATURATING_I64 default_saturating_i64

    wrapping_u64_default = stack_alloc WrappingU64_SIZE
    wrapping_u64_source = stack_alloc WrappingU64_SIZE
    wrapping_u64_copy = stack_alloc WrappingU64_SIZE
    wrapping_u64_clone = stack_alloc WrappingU64_SIZE
    wrapping_u64_clone_from = stack_alloc WrappingU64_SIZE
    EXPAND WRAPPING_U64_NEW wrapping_u64_default, 9
    EXPAND WRAPPING_U64_DEFAULT wrapping_u64_default
    EXPAND WRAPPING_U64_NEW wrapping_u64_source, 41
    EXPAND WRAPPING_U64_NEW wrapping_u64_copy, 1
    EXPAND WRAPPING_U64_NEW wrapping_u64_clone, 2
    EXPAND WRAPPING_U64_NEW wrapping_u64_clone_from, 3
    EXPAND WRAPPING_U64_COPY wrapping_u64_copy, wrapping_u64_source
    EXPAND WRAPPING_U64_CLONE wrapping_u64_clone, wrapping_u64_source
    EXPAND WRAPPING_U64_CLONE_FROM wrapping_u64_clone_from, wrapping_u64_source
    EXPAND WRAPPING_U64_NEW wrapping_u64_source, 71

    wrapping_u32_default = stack_alloc WrappingU32_SIZE
    wrapping_u32_source = stack_alloc WrappingU32_SIZE
    wrapping_u32_copy = stack_alloc WrappingU32_SIZE
    wrapping_u32_clone = stack_alloc WrappingU32_SIZE
    wrapping_u32_clone_from = stack_alloc WrappingU32_SIZE
    EXPAND WRAPPING_U32_NEW wrapping_u32_default, 9
    EXPAND WRAPPING_U32_DEFAULT wrapping_u32_default
    EXPAND WRAPPING_U32_NEW wrapping_u32_source, 42
    EXPAND WRAPPING_U32_NEW wrapping_u32_copy, 1
    EXPAND WRAPPING_U32_NEW wrapping_u32_clone, 2
    EXPAND WRAPPING_U32_NEW wrapping_u32_clone_from, 3
    EXPAND WRAPPING_U32_COPY wrapping_u32_copy, wrapping_u32_source
    EXPAND WRAPPING_U32_CLONE wrapping_u32_clone, wrapping_u32_source
    EXPAND WRAPPING_U32_CLONE_FROM wrapping_u32_clone_from, wrapping_u32_source
    EXPAND WRAPPING_U32_NEW wrapping_u32_source, 72

    wrapping_i64_default = stack_alloc WrappingI64_SIZE
    wrapping_i64_source = stack_alloc WrappingI64_SIZE
    wrapping_i64_copy = stack_alloc WrappingI64_SIZE
    wrapping_i64_clone = stack_alloc WrappingI64_SIZE
    wrapping_i64_clone_from = stack_alloc WrappingI64_SIZE
    EXPAND WRAPPING_I64_NEW wrapping_i64_default, -9
    EXPAND WRAPPING_I64_DEFAULT wrapping_i64_default
    EXPAND WRAPPING_I64_NEW wrapping_i64_source, -43
    EXPAND WRAPPING_I64_NEW wrapping_i64_copy, 1
    EXPAND WRAPPING_I64_NEW wrapping_i64_clone, 2
    EXPAND WRAPPING_I64_NEW wrapping_i64_clone_from, 3
    EXPAND WRAPPING_I64_COPY wrapping_i64_copy, wrapping_i64_source
    EXPAND WRAPPING_I64_CLONE wrapping_i64_clone, wrapping_i64_source
    EXPAND WRAPPING_I64_CLONE_FROM wrapping_i64_clone_from, wrapping_i64_source
    EXPAND WRAPPING_I64_NEW wrapping_i64_source, -73

    saturating_u64_default = stack_alloc SaturatingU64_SIZE
    saturating_u64_source = stack_alloc SaturatingU64_SIZE
    saturating_u64_copy = stack_alloc SaturatingU64_SIZE
    saturating_u64_clone = stack_alloc SaturatingU64_SIZE
    saturating_u64_clone_from = stack_alloc SaturatingU64_SIZE
    EXPAND SATURATING_U64_NEW saturating_u64_default, 9
    EXPAND SATURATING_U64_DEFAULT saturating_u64_default
    EXPAND SATURATING_U64_NEW saturating_u64_source, 44
    EXPAND SATURATING_U64_NEW saturating_u64_copy, 1
    EXPAND SATURATING_U64_NEW saturating_u64_clone, 2
    EXPAND SATURATING_U64_NEW saturating_u64_clone_from, 3
    EXPAND SATURATING_U64_COPY saturating_u64_copy, saturating_u64_source
    EXPAND SATURATING_U64_CLONE saturating_u64_clone, saturating_u64_source
    EXPAND SATURATING_U64_CLONE_FROM saturating_u64_clone_from, saturating_u64_source
    EXPAND SATURATING_U64_NEW saturating_u64_source, 74

    saturating_i64_default = stack_alloc SaturatingI64_SIZE
    saturating_i64_source = stack_alloc SaturatingI64_SIZE
    saturating_i64_copy = stack_alloc SaturatingI64_SIZE
    saturating_i64_clone = stack_alloc SaturatingI64_SIZE
    saturating_i64_clone_from = stack_alloc SaturatingI64_SIZE
    EXPAND SATURATING_I64_NEW saturating_i64_default, -9
    EXPAND SATURATING_I64_DEFAULT saturating_i64_default
    EXPAND SATURATING_I64_NEW saturating_i64_source, -45
    EXPAND SATURATING_I64_NEW saturating_i64_copy, 1
    EXPAND SATURATING_I64_NEW saturating_i64_clone, 2
    EXPAND SATURATING_I64_NEW saturating_i64_clone_from, 3
    EXPAND SATURATING_I64_COPY saturating_i64_copy, saturating_i64_source
    EXPAND SATURATING_I64_CLONE saturating_i64_clone, saturating_i64_source
    EXPAND SATURATING_I64_CLONE_FROM saturating_i64_clone_from, saturating_i64_source
    EXPAND SATURATING_I64_NEW saturating_i64_source, -75

    EXPAND WRAPPING_U64_GET wrapping_u64_default_value, wrapping_u64_default
    EXPAND WRAPPING_U64_GET wrapping_u64_source_value, wrapping_u64_source
    EXPAND WRAPPING_U64_GET wrapping_u64_copy_value, wrapping_u64_copy
    EXPAND WRAPPING_U64_GET wrapping_u64_clone_value, wrapping_u64_clone
    EXPAND WRAPPING_U64_GET wrapping_u64_clone_from_value, wrapping_u64_clone_from
    EXPAND WRAPPING_U32_GET wrapping_u32_default_value, wrapping_u32_default
    EXPAND WRAPPING_U32_GET wrapping_u32_source_value, wrapping_u32_source
    EXPAND WRAPPING_U32_GET wrapping_u32_copy_value, wrapping_u32_copy
    EXPAND WRAPPING_U32_GET wrapping_u32_clone_value, wrapping_u32_clone
    EXPAND WRAPPING_U32_GET wrapping_u32_clone_from_value, wrapping_u32_clone_from
    EXPAND WRAPPING_I64_GET wrapping_i64_default_value, wrapping_i64_default
    EXPAND WRAPPING_I64_GET wrapping_i64_source_value, wrapping_i64_source
    EXPAND WRAPPING_I64_GET wrapping_i64_copy_value, wrapping_i64_copy
    EXPAND WRAPPING_I64_GET wrapping_i64_clone_value, wrapping_i64_clone
    EXPAND WRAPPING_I64_GET wrapping_i64_clone_from_value, wrapping_i64_clone_from
    EXPAND SATURATING_U64_GET saturating_u64_default_value, saturating_u64_default
    EXPAND SATURATING_U64_GET saturating_u64_source_value, saturating_u64_source
    EXPAND SATURATING_U64_GET saturating_u64_copy_value, saturating_u64_copy
    EXPAND SATURATING_U64_GET saturating_u64_clone_value, saturating_u64_clone
    EXPAND SATURATING_U64_GET saturating_u64_clone_from_value, saturating_u64_clone_from
    EXPAND SATURATING_I64_GET saturating_i64_default_value, saturating_i64_default
    EXPAND SATURATING_I64_GET saturating_i64_source_value, saturating_i64_source
    EXPAND SATURATING_I64_GET saturating_i64_copy_value, saturating_i64_copy
    EXPAND SATURATING_I64_GET saturating_i64_clone_value, saturating_i64_clone
    EXPAND SATURATING_I64_GET saturating_i64_clone_from_value, saturating_i64_clone_from

    ok01 = eq default_wrapping_u64, 0
    ok02 = eq default_wrapping_u32, 0
    ok03 = eq default_wrapping_i64, 0
    ok04 = eq default_saturating_u64, 0
    ok05 = eq default_saturating_i64, 0
    ok06 = eq wrapping_u64_default_value, 0
    ok07 = eq wrapping_u64_source_value, 71
    ok08 = eq wrapping_u64_copy_value, 41
    ok09 = eq wrapping_u64_clone_value, 41
    ok10 = eq wrapping_u64_clone_from_value, 41
    ok11 = eq wrapping_u32_default_value, 0
    ok12 = eq wrapping_u32_source_value, 72
    ok13 = eq wrapping_u32_copy_value, 42
    ok14 = eq wrapping_u32_clone_value, 42
    ok15 = eq wrapping_u32_clone_from_value, 42
    ok16 = eq wrapping_i64_default_value, 0
    ok17 = eq wrapping_i64_source_value, -73
    ok18 = eq wrapping_i64_copy_value, -43
    ok19 = eq wrapping_i64_clone_value, -43
    ok20 = eq wrapping_i64_clone_from_value, -43
    ok21 = eq saturating_u64_default_value, 0
    ok22 = eq saturating_u64_source_value, 74
    ok23 = eq saturating_u64_copy_value, 44
    ok24 = eq saturating_u64_clone_value, 44
    ok25 = eq saturating_u64_clone_from_value, 44
    ok26 = eq saturating_i64_default_value, 0
    ok27 = eq saturating_i64_source_value, -75
    ok28 = eq saturating_i64_copy_value, -45
    ok29 = eq saturating_i64_clone_value, -45
    ok30 = eq saturating_i64_clone_from_value, -45

    c01 = and ok01, ok02
    c02 = and c01, ok03
    c03 = and c02, ok04
    c04 = and c03, ok05
    c05 = and c04, ok06
    c06 = and c05, ok07
    c07 = and c06, ok08
    c08 = and c07, ok09
    c09 = and c08, ok10
    c10 = and c09, ok11
    c11 = and c10, ok12
    c12 = and c11, ok13
    c13 = and c12, ok14
    c14 = and c13, ok15
    c15 = and c14, ok16
    c16 = and c15, ok17
    c17 = and c16, ok18
    c18 = and c17, ok19
    c19 = and c18, ok20
    c20 = and c19, ok21
    c21 = and c20, ok22
    c22 = and c21, ok23
    c23 = and c22, ok24
    c24 = and c23, ok25
    c25 = and c24, ok26
    c26 = and c25, ok27
    c27 = and c26, ok28
    c28 = and c27, ok29
    ok = and c28, ok30

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10602)

L_PASS:
    return 0
