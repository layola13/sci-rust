@import "sa_std/collections/hashmap.sars"
@import "sa_std/vec.sars"

@const KEY_A = utf8:"alpha"
@const KEY_B = utf8:"bravo"
@const KEY_C = utf8:"charlie"
@const VALUE_A = utf8:"A\n"
@const VALUE_B = utf8:"B\n"
@const VALUE_C = utf8:"C\n"

@test "sa_std hashmap eager iter aliases"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 4
    key_a = &KEY_A
    key_b = &KEY_B
    key_c = &KEY_C
    value_a = &VALUE_A
    value_b = &VALUE_B
    value_c = &VALUE_C

    EXPAND MAP_PUT map, key_a, value_a
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_PUT map, key_c, value_c

    EXPAND MAP_GET_MUT_PTR key_b_value_slot_ok, key_b_value_slot, map, key_b
    key_b_value_slot_bits = bitcast key_b_value_slot as u64

    EXPAND MAP_ITER iter_vec, map
    EXPAND MAP_ITER_MUT_PTRS iter_mut_vec, map
    EXPAND VEC_LEN iter_len, iter_vec
    EXPAND VEC_LEN iter_mut_len, iter_mut_vec

    key_a_bits = bitcast key_a as u64
    key_b_bits = bitcast key_b as u64
    key_c_bits = bitcast key_c as u64
    value_a_bits = bitcast value_a as u64
    value_b_bits = bitcast value_b as u64
    value_c_bits = bitcast value_c as u64
    EXPAND VEC_CONTAINS_U64 iter_has_key_a, iter_vec, key_a_bits
    EXPAND VEC_CONTAINS_U64 iter_has_key_b, iter_vec, key_b_bits
    EXPAND VEC_CONTAINS_U64 iter_has_key_c, iter_vec, key_c_bits
    EXPAND VEC_CONTAINS_U64 iter_has_value_a, iter_vec, value_a_bits
    EXPAND VEC_CONTAINS_U64 iter_has_value_b, iter_vec, value_b_bits
    EXPAND VEC_CONTAINS_U64 iter_has_value_c, iter_vec, value_c_bits
    EXPAND VEC_CONTAINS_U64 iter_mut_has_key_b, iter_mut_vec, key_b_bits
    EXPAND VEC_CONTAINS_U64 iter_mut_has_key_b_slot, iter_mut_vec, key_b_value_slot_bits

    store key_b_value_slot+0, value_a as ptr
    EXPAND MAP_GET value_b_after_mut, map, key_b

    EXPAND MAP_NEW empty_map
    EXPAND MAP_ITER empty_iter, empty_map
    EXPAND MAP_ITER_MUT_PTRS empty_iter_mut, empty_map
    EXPAND VEC_LEN empty_iter_len, empty_iter
    EXPAND VEC_LEN empty_iter_mut_len, empty_iter_mut

    ok_iter_len = eq iter_len, 6
    ok_iter_mut_len = eq iter_mut_len, 6
    ok_key_b_value_slot = eq key_b_value_slot_ok, 1
    ok_value_b_after_mut = eq value_b_after_mut, value_a
    ok_empty_iter = eq empty_iter_len, 0
    ok_empty_iter_mut = eq empty_iter_mut_len, 0

    ok01 = and ok_iter_len, ok_iter_mut_len
    ok02 = and ok01, iter_has_key_a
    ok03 = and ok02, iter_has_key_b
    ok04 = and ok03, iter_has_key_c
    ok05 = and ok04, iter_has_value_a
    ok06 = and ok05, iter_has_value_b
    ok07 = and ok06, iter_has_value_c
    ok08 = and ok07, ok_key_b_value_slot
    ok09 = and ok08, iter_mut_has_key_b
    ok10 = and ok09, iter_mut_has_key_b_slot
    ok11 = and ok10, ok_value_b_after_mut
    ok12 = and ok11, ok_empty_iter
    ok = and ok12, ok_empty_iter_mut

    !iter_vec
    !iter_mut_vec
    !iter_len
    !iter_mut_len
    !key_a_bits
    !key_b_bits
    !key_c_bits
    !value_a_bits
    !value_b_bits
    !value_c_bits
    !key_b_value_slot_ok
    !key_b_value_slot
    !key_b_value_slot_bits
    !iter_has_key_a
    !iter_has_key_b
    !iter_has_key_c
    !iter_has_value_a
    !iter_has_value_b
    !iter_has_value_c
    !iter_mut_has_key_b
    !iter_mut_has_key_b_slot
    !value_b_after_mut
    !empty_iter
    !empty_iter_mut
    !empty_iter_len
    !empty_iter_mut_len
    !ok_iter_len
    !ok_iter_mut_len
    !ok_key_b_value_slot
    !ok_value_b_after_mut
    !ok_empty_iter
    !ok_empty_iter_mut
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !value_c
    !value_b
    !value_a
    !key_c
    !key_b
    !key_a
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND MAP_FREE map
    EXPAND MAP_FREE empty_map
    return 0

L_FAIL:
    panic(10806)
