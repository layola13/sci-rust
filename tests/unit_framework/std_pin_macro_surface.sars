@import "sa_std/pin.sars"

@test "sa_std pin transparent pointer macros"():
L_ENTRY:
    data = stack_alloc 16
    other = stack_alloc 8
    store data+0, 8 as i32
    store data+8, 13 as i32
    store other+0, 21 as i32

    pin_ref = stack_alloc Pin_SIZE
    pin_ref_copy = stack_alloc Pin_SIZE
    pin_ref_other = stack_alloc Pin_SIZE
    EXPAND PIN_NEW pin_ref, data
    EXPAND PIN_AS_REF pin_ref_copy, pin_ref
    EXPAND PIN_NEW_UNCHECKED pin_ref_other, other
    EXPAND PIN_GET_REF ref_ptr, pin_ref
    EXPAND PIN_INTO_INNER_UNCHECKED inner_ptr, pin_ref
    EXPAND PIN_PTR_EQ ref_eq, pin_ref, pin_ref_copy
    EXPAND PIN_PTR_EQ ref_ne, pin_ref, pin_ref_other
    ref_value = load ref_ptr+0 as i32
    inner_value = load inner_ptr+8 as i32

    pin_mut = stack_alloc PinMut_SIZE
    pin_mut_copy = stack_alloc PinMut_SIZE
    pin_mut_ref = stack_alloc Pin_SIZE
    EXPAND PIN_MUT_NEW pin_mut, data
    EXPAND PIN_MUT_AS_MUT pin_mut_copy, pin_mut
    EXPAND PIN_MUT_AS_REF pin_mut_ref, pin_mut
    EXPAND PIN_MUT_GET_REF mut_ref_ptr, pin_mut
    EXPAND PIN_MUT_GET_MUT mut_ptr, pin_mut
    EXPAND PIN_MUT_GET_UNCHECKED_MUT unchecked_mut_ptr, pin_mut
    into_ref_pin = stack_alloc Pin_SIZE
    EXPAND PIN_MUT_INTO_REF into_ref_pin, pin_mut
    EXPAND PIN_MUT_INTO_INNER_UNCHECKED mut_inner_ptr, pin_mut
    EXPAND PIN_MUT_PTR_EQ mut_eq, pin_mut, pin_mut_copy
    store mut_ptr+0, 34 as i32
    mut_ref_value = load mut_ref_ptr+0 as i32
    unchecked_value = load unchecked_mut_ptr+8 as i32
    mut_inner_value = load mut_inner_ptr+0 as i32
    EXPAND PIN_GET_REF into_ref_ptr, into_ref_pin
    into_ref_value = load into_ref_ptr+0 as i32
    EXPAND PIN_GET_REF mut_ref_pin_ptr, pin_mut_ref
    mut_ref_pin_value = load mut_ref_pin_ptr+8 as i32

    ok_ref_ptr = eq ref_ptr, data
    ok_inner_ptr = eq inner_ptr, data
    ok_ref_eq = eq ref_eq, 1
    ok_ref_ne = eq ref_ne, 0
    ok_ref_value = eq ref_value, 8
    ok_inner_value = eq inner_value, 13
    ok_mut_ref_ptr = eq mut_ref_ptr, data
    ok_mut_ptr = eq mut_ptr, data
    ok_unchecked_ptr = eq unchecked_mut_ptr, data
    ok_mut_inner_ptr = eq mut_inner_ptr, data
    ok_mut_eq = eq mut_eq, 1
    ok_mut_ref_value = eq mut_ref_value, 34
    ok_unchecked_value = eq unchecked_value, 13
    ok_mut_inner_value = eq mut_inner_value, 34
    ok_into_ref_ptr = eq into_ref_ptr, data
    ok_into_ref_value = eq into_ref_value, 34
    ok_mut_ref_pin_ptr = eq mut_ref_pin_ptr, data
    ok_mut_ref_pin_value = eq mut_ref_pin_value, 13

    ok01 = and ok_ref_ptr, ok_inner_ptr
    ok02 = and ok01, ok_ref_eq
    ok03 = and ok02, ok_ref_ne
    ok04 = and ok03, ok_ref_value
    ok05 = and ok04, ok_inner_value
    ok06 = and ok05, ok_mut_ref_ptr
    ok07 = and ok06, ok_mut_ptr
    ok08 = and ok07, ok_unchecked_ptr
    ok09 = and ok08, ok_mut_inner_ptr
    ok10 = and ok09, ok_mut_eq
    ok11 = and ok10, ok_mut_ref_value
    ok12 = and ok11, ok_unchecked_value
    ok13 = and ok12, ok_mut_inner_value
    ok14 = and ok13, ok_into_ref_ptr
    ok15 = and ok14, ok_into_ref_value
    ok16 = and ok15, ok_mut_ref_pin_ptr
    ok = and ok16, ok_mut_ref_pin_value

    !ref_ptr
    !inner_ptr
    !ref_eq
    !ref_ne
    !ref_value
    !inner_value
    !mut_ref_ptr
    !mut_ptr
    !unchecked_mut_ptr
    !mut_inner_ptr
    !mut_eq
    !mut_ref_value
    !unchecked_value
    !mut_inner_value
    !into_ref_ptr
    !into_ref_value
    !mut_ref_pin_ptr
    !mut_ref_pin_value
    !ok_ref_ptr
    !ok_inner_ptr
    !ok_ref_eq
    !ok_ref_ne
    !ok_ref_value
    !ok_inner_value
    !ok_mut_ref_ptr
    !ok_mut_ptr
    !ok_unchecked_ptr
    !ok_mut_inner_ptr
    !ok_mut_eq
    !ok_mut_ref_value
    !ok_unchecked_value
    !ok_mut_inner_value
    !ok_into_ref_ptr
    !ok_into_ref_value
    !ok_mut_ref_pin_ptr
    !ok_mut_ref_pin_value
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10194)

L_PASS:
    return 0
