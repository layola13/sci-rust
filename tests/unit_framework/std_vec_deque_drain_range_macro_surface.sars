@import "sa_std/vec_deque.sars"
@import "sa_std/vec.sars"

@test "sa_std vec_deque drain range macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 7
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50
    EXPAND VEC_DEQUE_TRY_POP_FRONT wrap_pop_ok, wrap_pop, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 60

    EXPAND VEC_DEQUE_TRY_DRAIN_RANGE_U64 drain_ok, drained, deque, 1, 3
    EXPAND VEC_DEQUE_LEN deque_len_after_drain, deque
    EXPAND VEC_LEN drained_len, drained
    EXPAND VEC_DEQUE_GET_U64 deque0, deque, 0
    EXPAND VEC_DEQUE_GET_U64 deque1, deque, 1
    EXPAND VEC_TRY_GET_U64 drained0_ok, drained0, drained, 0
    EXPAND VEC_TRY_GET_U64 drained1_ok, drained1, drained, 1
    EXPAND VEC_TRY_GET_U64 drained2_ok, drained2, drained, 2

    EXPAND VEC_DEQUE_DRAIN_RANGE_U64 zero_ok, zero_drained, deque, 1, 0
    EXPAND VEC_DEQUE_LEN deque_len_after_zero, deque
    EXPAND VEC_LEN zero_len, zero_drained

    EXPAND VEC_DEQUE_TRY_DRAIN_RANGE_U64 miss_ok, miss_drained, deque, 9, 1
    EXPAND VEC_DEQUE_LEN deque_len_after_miss, deque
    EXPAND VEC_LEN miss_len, miss_drained

    ok = eq wrap_pop_ok, 1
    check = eq wrap_pop, 10
    ok = and ok, check
    check = eq drain_ok, 1
    ok = and ok, check
    check = eq deque_len_after_drain, 2
    ok = and ok, check
    check = eq drained_len, 3
    ok = and ok, check
    check = eq deque0, 20
    ok = and ok, check
    check = eq deque1, 60
    ok = and ok, check
    check = eq drained0_ok, 1
    ok = and ok, check
    check = eq drained0, 30
    ok = and ok, check
    check = eq drained1_ok, 1
    ok = and ok, check
    check = eq drained1, 40
    ok = and ok, check
    check = eq drained2_ok, 1
    ok = and ok, check
    check = eq drained2, 50
    ok = and ok, check
    check = eq zero_ok, 1
    ok = and ok, check
    check = eq zero_len, 0
    ok = and ok, check
    check = eq deque_len_after_zero, 2
    ok = and ok, check
    check = eq miss_ok, 0
    ok = and ok, check
    check = eq miss_len, 0
    ok = and ok, check
    check = eq deque_len_after_miss, 2
    ok = and ok, check

    !wrap_pop_ok
    !wrap_pop
    !drain_ok
    !deque_len_after_drain
    !drained_len
    !deque0
    !deque1
    !drained0_ok
    !drained0
    !drained1_ok
    !drained1
    !drained2_ok
    !drained2
    !zero_ok
    !zero_len
    !deque_len_after_zero
    !miss_ok
    !miss_len
    !deque_len_after_miss
    !check
    EXPAND VEC_FREE miss_drained
    EXPAND VEC_FREE zero_drained
    EXPAND VEC_FREE drained
    EXPAND VEC_DEQUE_FREE deque
    br ok -> L_VEC_DEQUE_DRAIN_RANGE_OK, L_VEC_DEQUE_DRAIN_RANGE_FAIL

L_VEC_DEQUE_DRAIN_RANGE_FAIL:
    !ok
    panic(10805)

L_VEC_DEQUE_DRAIN_RANGE_OK:
    !ok
    return
