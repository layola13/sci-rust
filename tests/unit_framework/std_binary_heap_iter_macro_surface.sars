@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap iter helper"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW heap
    EXPAND BINARY_HEAP_PUSH_U64 heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 heap, 1

    EXPAND BINARY_HEAP_ITER_U64 iter, heap
    EXPAND ITER_LEN len0, iter
    EXPAND ITER_NEXT_U64 first_ok, first, iter
    rest_slice = stack_alloc Slice_SIZE
    EXPAND ITER_AS_SLICE_U64 rest_slice, iter
    EXPAND SLICE_GET_LEN rest_len, rest_slice
    EXPAND ITER_NEXT_U64 second_ok, second, iter
    EXPAND ITER_NEXT_BACK_U64 last_ok, last, iter
    EXPAND ITER_LEN len_after, iter
    EXPAND ITER_NEXT_U64 empty_next_ok, empty_next, iter
    EXPAND BINARY_HEAP_LEN heap_len_after_iter, heap
    EXPAND BINARY_HEAP_PEEK_U64 peek_after_iter, heap
    EXPAND BINARY_HEAP_FREE heap

    EXPAND BINARY_HEAP_NEW empty_heap
    EXPAND BINARY_HEAP_ITER_U64 empty_iter, empty_heap
    EXPAND ITER_LEN empty_iter_len, empty_iter
    EXPAND ITER_NEXT_U64 empty_iter_next_ok, empty_iter_next, empty_iter
    EXPAND BINARY_HEAP_FREE empty_heap

    ok_len0 = eq len0, 3
    ok_first_flag = eq first_ok, 1
    ok_first = eq first, 9
    ok_rest_len = eq rest_len, 2
    ok_second_flag = eq second_ok, 1
    ok_second = eq second, 4
    ok_last_flag = eq last_ok, 1
    ok_last = eq last, 1
    ok_len_after = eq len_after, 0
    ok_empty_next_flag = eq empty_next_ok, 0
    ok_empty_next = eq empty_next, 0
    ok_heap_len = eq heap_len_after_iter, 3
    ok_peek_after = eq peek_after_iter, 9
    ok_empty_iter_len = eq empty_iter_len, 0
    ok_empty_iter_next_flag = eq empty_iter_next_ok, 0
    ok_empty_iter_next = eq empty_iter_next, 0

    ok = and ok_len0, ok_first_flag
    ok = and ok, ok_first
    ok = and ok, ok_rest_len
    ok = and ok, ok_second_flag
    ok = and ok, ok_second
    ok = and ok, ok_last_flag
    ok = and ok, ok_last
    ok = and ok, ok_len_after
    ok = and ok, ok_empty_next_flag
    ok = and ok, ok_empty_next
    ok = and ok, ok_heap_len
    ok = and ok, ok_peek_after
    ok = and ok, ok_empty_iter_len
    ok = and ok, ok_empty_iter_next_flag
    ok = and ok, ok_empty_iter_next

    !len0
    !first_ok
    !first
    !rest_len
    !second_ok
    !second
    !last_ok
    !last
    !len_after
    !empty_next_ok
    !empty_next
    !heap_len_after_iter
    !peek_after_iter
    !empty_iter_len
    !empty_iter_next_ok
    !empty_iter_next
    !ok_len0
    !ok_first_flag
    !ok_first
    !ok_rest_len
    !ok_second_flag
    !ok_second
    !ok_last_flag
    !ok_last
    !ok_len_after
    !ok_empty_next_flag
    !ok_empty_next
    !ok_heap_len
    !ok_peek_after
    !ok_empty_iter_len
    !ok_empty_iter_next_flag
    !ok_empty_iter_next
    !iter
    !empty_iter
    br ok -> L_BINARY_HEAP_ITER_OK, L_BINARY_HEAP_ITER_FAIL

L_BINARY_HEAP_ITER_FAIL:
    !ok
    panic(10702)

L_BINARY_HEAP_ITER_OK:
    !ok
    return
