@import "sa_std/sync/once.sars"

@init_9() -> u64:
L_ENTRY:
    return 9

@test "sa_std once lazy default"():
L_ENTRY:
    EXPAND ONCE_DEFAULT once
    EXPAND ONCE_IS_READY r0, once
    EXPAND ONCE_CALL_ONCE v, once, @init_9
    EXPAND LAZY_LOCK_DEFAULT lazy
    EXPAND LAZY_LOCK_IS_READY lr0, lazy
    EXPAND LAZY_LOCK_FORCE lv, lazy, @init_9
    EXPAND LAZY_LOCK_IS_READY lr1, lazy
    a = eq r0, 0
    b = eq v, 9
    c = eq lr0, 0
    d = eq lv, 9
    e = eq lr1, 1
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok = and ok03, e
    !r0
    !v
    !lr0
    !lv
    !lr1
    !a
    !b
    !c
    !d
    !e
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10955)
