@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"

@test "sa_std iter Rust naming aliases"():
L_ENTRY:
    values = stack_alloc 32
    same = stack_alloc 32
    high = stack_alloc 32
    short = stack_alloc 16

    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store same+0, 1 as u64
    store same+8, 2 as u64
    store same+16, 3 as u64
    store same+24, 4 as u64
    store high+0, 1 as u64
    store high+8, 2 as u64
    store high+16, 9 as u64
    store high+24, 0 as u64
    store short+0, 1 as u64
    store short+8, 2 as u64

    slice = alloc Slice_SIZE
    same_slice = alloc Slice_SIZE
    high_slice = alloc Slice_SIZE
    short_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 4
    EXPAND SLICE_NEW same_slice, same, 4
    EXPAND SLICE_NEW high_slice, high, 4
    EXPAND SLICE_NEW short_slice, short, 2

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_NEXT_U64 first_ok, first_value, iter
    EXPAND ITER_BY_REF by_ref_iter, iter
    EXPAND ITER_NEXT_U64 by_ref_ok, by_ref_value, by_ref_iter
    EXPAND ITER_NEXT_U64 after_ref_ok, after_ref_value, iter
    EXPAND ITER_EXACT_SIZE_LEN len_after_ref, iter
    EXPAND ITER_EXACT_SIZE_IS_EMPTY empty_after_ref, iter
    EXPAND ITER_NEXT_U64 last_ok, last_value, iter
    EXPAND ITER_EXACT_SIZE_IS_EMPTY empty_final, iter

    EXPAND ITER_FROM_SLICE eq_left, slice
    EXPAND ITER_FROM_SLICE eq_right, same_slice
    EXPAND ITER_PARTIAL_EQ_U64 partial_eq_same, eq_left, eq_right

    EXPAND ITER_FROM_SLICE ne_left, slice
    EXPAND ITER_FROM_SLICE ne_right, high_slice
    EXPAND ITER_PARTIAL_EQ_U64 partial_eq_diff, ne_left, ne_right

    EXPAND ITER_FROM_SLICE cmp_left_less, slice
    EXPAND ITER_FROM_SLICE cmp_right_less, high_slice
    EXPAND ITER_PARTIAL_CMP_U64 partial_cmp_less, cmp_left_less, cmp_right_less

    EXPAND ITER_FROM_SLICE cmp_left_greater, high_slice
    EXPAND ITER_FROM_SLICE cmp_right_greater, slice
    EXPAND ITER_PARTIAL_CMP_U64 partial_cmp_greater, cmp_left_greater, cmp_right_greater

    EXPAND ITER_FROM_SLICE cmp_left_short, short_slice
    EXPAND ITER_FROM_SLICE cmp_right_short, slice
    EXPAND ITER_PARTIAL_CMP_U64 partial_cmp_short, cmp_left_short, cmp_right_short

    neg_one = sub 0, 1
    ok_first = eq first_value, 1
    ok_first_flag = eq first_ok, 1
    ok_by_ref = eq by_ref_value, 2
    ok_by_ref_flag = eq by_ref_ok, 1
    ok_after_ref = eq after_ref_value, 3
    ok_after_ref_flag = eq after_ref_ok, 1
    ok_len = eq len_after_ref, 1
    ok_empty_after = eq empty_after_ref, 0
    ok_last = eq last_value, 4
    ok_last_flag = eq last_ok, 1
    ok_empty_final = eq empty_final, 1
    ok_partial_eq_same = eq partial_eq_same, 1
    ok_partial_eq_diff = eq partial_eq_diff, 0
    ok_partial_less = eq partial_cmp_less, neg_one
    ok_partial_greater = eq partial_cmp_greater, 1
    ok_partial_short = eq partial_cmp_short, neg_one

    c01 = and ok_first_flag, ok_first
    c02 = and c01, ok_by_ref_flag
    c03 = and c02, ok_by_ref
    c04 = and c03, ok_after_ref_flag
    c05 = and c04, ok_after_ref
    c06 = and c05, ok_len
    c07 = and c06, ok_empty_after
    c08 = and c07, ok_last_flag
    c09 = and c08, ok_last
    c10 = and c09, ok_empty_final
    c11 = and c10, ok_partial_eq_same
    c12 = and c11, ok_partial_eq_diff
    c13 = and c12, ok_partial_less
    c14 = and c13, ok_partial_greater
    ok = and c14, ok_partial_short

    !first_ok
    !first_value
    !by_ref_ok
    !by_ref_value
    !after_ref_ok
    !after_ref_value
    !len_after_ref
    !empty_after_ref
    !last_ok
    !last_value
    !empty_final
    !partial_eq_same
    !partial_eq_diff
    !partial_cmp_less
    !partial_cmp_greater
    !partial_cmp_short
    !neg_one
    !ok_first
    !ok_first_flag
    !ok_by_ref
    !ok_by_ref_flag
    !ok_after_ref
    !ok_after_ref_flag
    !ok_len
    !ok_empty_after
    !ok_last
    !ok_last_flag
    !ok_empty_final
    !ok_partial_eq_same
    !ok_partial_eq_diff
    !ok_partial_less
    !ok_partial_greater
    !ok_partial_short
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !cmp_right_short
    !cmp_left_short
    !cmp_right_greater
    !cmp_left_greater
    !cmp_right_less
    !cmp_left_less
    !ne_right
    !ne_left
    !eq_right
    !eq_left
    !by_ref_iter
    !iter
    !short_slice
    !high_slice
    !same_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10532)

L_PASS:
    !ok
    return 0
