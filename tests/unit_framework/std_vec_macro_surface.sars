@test "vec stores vtable function pointer values"():
L_ENTRY:
    EXPAND VEC_NEW vec
    false_fn = &VEC_FN_PTR_FALSE_VT
    true_fn = &VEC_FN_PTR_TRUE_VT
    EXPAND VEC_PUSH vec, false_fn, 8
    EXPAND VEC_PUSH vec, true_fn, 8
    EXPAND VEC_GET first_fn, vec, 0
    EXPAND VEC_GET second_fn, vec, 1
    first_call = load first_fn+0 as ptr
    second_call = load second_fn+0 as ptr
    first = call_indirect first_call(11)
    second = call_indirect second_call(22)
    first_ok = eq first, 0
    second_ok = eq second, 1
    ok = and first_ok, second_ok
    !first_call
    !second_call
    !first
    !second
    !first_ok
    !second_ok
    !first_fn
    !second_fn
    !false_fn
    !true_fn
    EXPAND VEC_FREE vec
    br ok -> L_VEC_FN_PTR_OK, L_VEC_FN_PTR_FAIL

L_VEC_FN_PTR_FAIL:
    !ok
    panic(10372)

L_VEC_FN_PTR_OK:
    !ok
    return

@test "sa_std vec raw parts macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 4
    EXPAND VEC_PUSH_U64 vec, 11
    EXPAND VEC_PUSH_U64 vec, 22
    EXPAND VEC_AS_NON_NULL borrowed_nonnull, vec
    EXPAND NONNULL_AS_PTR borrowed_ptr, borrowed_nonnull
    borrowed_first = load borrowed_ptr+0 as u64
    EXPAND VEC_LEN borrowed_vec_len, vec
    EXPAND VEC_INTO_RAW_PARTS raw_ptr, raw_len, raw_cap, vec
    raw_ptr_ok = ne raw_ptr, 0
    raw_len_ok = eq raw_len, 2
    raw_cap_ok = uge raw_cap, 2
    EXPAND VEC_FROM_RAW_PARTS rebound, raw_ptr, raw_len, raw_cap
    EXPAND VEC_GET_U64 first, rebound, 0
    EXPAND VEC_GET_U64 second, rebound, 1
    borrowed_ptr_ok = ne borrowed_ptr, 0
    borrowed_first_ok = eq borrowed_first, 11
    borrowed_len_ok = eq borrowed_vec_len, 2
    first_ok = eq first, 11
    second_ok = eq second, 22
    ok01 = and raw_ptr_ok, raw_len_ok
    ok02 = and ok01, raw_cap_ok
    ok03 = and ok02, borrowed_ptr_ok
    ok04 = and ok03, borrowed_first_ok
    ok05 = and ok04, borrowed_len_ok
    ok06 = and ok05, first_ok
    ok = and ok06, second_ok
    !borrowed_ptr
    !borrowed_first
    !borrowed_vec_len
    !raw_len
    !raw_cap
    !first
    !second
    !borrowed_ptr_ok
    !borrowed_first_ok
    !borrowed_len_ok
    !raw_ptr_ok
    !raw_len_ok
    !raw_cap_ok
    !first_ok
    !second_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !borrowed_nonnull
    EXPAND VEC_FREE rebound
    br ok -> L_VEC_RAW_PARTS_OK, L_VEC_RAW_PARTS_FAIL

L_VEC_RAW_PARTS_FAIL:
    !ok
    panic(10373)

L_VEC_RAW_PARTS_OK:
    !ok
    return

