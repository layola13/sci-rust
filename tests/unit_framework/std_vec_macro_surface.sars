    EXPAND VEC_TRY_GET_U64 grow_second_ok, grow_second, vec, 4
    EXPAND VEC_RESIZE_WITH_U64 resize_truncate_len, vec, 2, @vec_resize_with_42
    EXPAND VEC_LEN len_after_truncate, vec
