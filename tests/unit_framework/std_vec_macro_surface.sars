@test "sa_std vec leak macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 4
    EXPAND VEC_PUSH_U64 vec, 7
    EXPAND VEC_PUSH_U64 vec, 9
