    ok14 = and ok13, from_iter_second_ok
    ok = and ok14, from_iter_second_value_ok
    !len
    !from_iter_len
    !first_ok
    !first
    !second_ok
    !second
    !third_ok
    !third
    !fourth_ok
    !fourth
    !fifth_ok
    !fifth
    !from_iter_first_ok
    !from_iter_first
    !from_iter_second_ok
    !from_iter_second
    !len_ok
    !from_iter_len_ok
    !first_value_ok
