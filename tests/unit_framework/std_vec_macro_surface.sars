    EXPAND VEC_TRY_GET_U64 middle_ok, middle, repeated_vec, 3
    EXPAND VEC_TRY_GET_U64 last_ok, last, repeated_vec, 5

    EXPAND VEC_REPEAT_U64 zero_vec, repeat_slice, 0
