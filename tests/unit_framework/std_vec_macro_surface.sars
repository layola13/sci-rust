    !first_mut_rest_len
    !last_mut_ok
    !last_mut_ptr
    !last_mut_rest
    !last_after_ok
    !last_after
    !last_mut_rest_len
    EXPAND VEC_FREE empty_vec
    !empty_first_ok
    !empty_first_value
    !empty_first_rest
    !empty_first_rest_len
    !empty_last_mut_ok
    !empty_last_mut_ptr
    !empty_last_mut_rest
    !empty_last_mut_rest_len
    EXPAND VEC_FREE vec
    !first_flag_ok
    !first_value_ok
    !first_rest_len_ok
    !first_rest_first_ok
    !last_flag_ok
    !last_value_ok
    !last_rest_len_ok
