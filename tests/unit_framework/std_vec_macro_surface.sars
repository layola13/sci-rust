    EXPAND VEC_BINARY_SEARCH_U64 vec_bs_hit_ok, vec_bs_hit_idx, search_vec, 20
    EXPAND VEC_BINARY_SEARCH_U64 vec_bs_miss_ok, vec_bs_miss_idx, search_vec, 30
