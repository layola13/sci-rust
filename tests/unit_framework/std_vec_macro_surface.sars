    !vec_bs_hit_ok
    !vec_bs_hit_idx
    !vec_bs_miss_ok
    !vec_bs_miss_idx
    !vec_partition_idx
    !vec_lower_20_idx
    !vec_lower_30_idx
    !vec_upper_20_idx
    !vec_upper_4_idx
    !vec_eq20_start
    !vec_eq20_end
    !vec_eq30_start
    !vec_eq30_end
    !vec_bs_hit_flag_ok
    !vec_bs_hit_idx_ok
    !vec_bs_miss_flag_ok
    !vec_bs_miss_idx_ok
    !vec_partition_idx_ok
    !vec_lower_20_idx_ok
    !vec_lower_30_idx_ok
    !vec_upper_20_idx_ok
    !vec_upper_4_idx_ok
    !vec_eq20_start_ok
    !vec_eq20_end_ok
    !vec_eq30_start_ok
    !vec_eq30_end_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
