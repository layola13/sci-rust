@test "sa_std vec capacity/view macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_RESIZE_U64 vec, 5, 30
    EXPAND VEC_CAPACITY cap_after_resize, vec
    EXPAND VEC_AS_MUT_SLICE mut_slice, vec
    EXPAND SLICE_GET_LEN mut_slice_len, mut_slice
    EXPAND VEC_AS_REF_SLICE as_ref_slice, vec
    EXPAND SLICE_GET_LEN as_ref_slice_len, as_ref_slice
    EXPAND VEC_AS_MUT_REF_SLICE as_mut_ref_slice, vec
    EXPAND SLICE_GET_LEN as_mut_ref_slice_len, as_mut_ref_slice
    EXPAND VEC_AS_REF_VEC_PTR as_ref_vec_ptr, vec
    as_ref_vec_len = load as_ref_vec_ptr+Vec_len as u64
    !as_ref_vec_ptr
    EXPAND VEC_AS_MUT_VEC_PTR as_mut_vec_ptr, vec
    as_mut_vec_len = load as_mut_vec_ptr+Vec_len as u64
    !as_mut_vec_ptr
    EXPAND VEC_DEREF_SLICE deref_slice, vec
    EXPAND SLICE_GET_LEN deref_slice_len, deref_slice
    EXPAND VEC_DEREF_MUT_SLICE deref_mut_slice, vec
    EXPAND SLICE_GET_LEN deref_mut_slice_len, deref_mut_slice
    EXPAND VEC_AS_PTR vec_data_ptr, vec
    EXPAND VEC_AS_PTR_RANGE_U64 vec_range_start, vec_range_end, vec
    EXPAND VEC_AS_MUT_PTR_RANGE_U64 vec_mut_range_start, vec_mut_range_end, vec
    EXPAND SLICE_AS_PTR_RANGE_U64 slice_range_start, slice_range_end, mut_slice
    EXPAND SLICE_AS_MUT_PTR_RANGE_U64 slice_mut_range_start, slice_mut_range_end, mut_slice
    vec_range_expected_end = ptr_add vec_range_start, 40
    EXPAND VEC_SET_LEN vec, 3
    EXPAND VEC_LEN len_after_set_len, vec
    EXPAND VEC_SHRINK_TO_U64 vec, 2
    EXPAND VEC_CAPACITY cap_after_shrink_to, vec
