    EXPAND SLICE_GET_LEN leaked_len, leaked
    EXPAND SLICE_TRY_GET_U64 first_ok, first, leaked, 0
    EXPAND SLICE_TRY_GET_U64 second_ok, second, leaked, 1
    EXPAND SLICE_GET_MUT_PTR_U64 second_ptr, leaked, 1
    store second_ptr+0, 99 as u64
    EXPAND SLICE_TRY_GET_U64 mutated_ok, mutated, leaked, 1
    len_ok = eq leaked_len, 2
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first, 7
    second_flag_ok = eq second_ok, 1
    second_value_ok = eq second, 9
    mutated_flag_ok = eq mutated_ok, 1
    mutated_value_ok = eq mutated, 99
    ok01 = and len_ok, first_flag_ok
    ok02 = and ok01, first_value_ok
    ok03 = and ok02, second_flag_ok
    ok04 = and ok03, second_value_ok
    ok05 = and ok04, mutated_flag_ok
    ok = and ok05, mutated_value_ok
    !leaked_len
    !first_ok
    !first
    !second_ok
    !second
    !second_ptr
    !mutated_ok
    !mutated
    !len_ok
    !first_flag_ok
    !first_value_ok
    !second_flag_ok
    !second_value_ok
    !mutated_flag_ok
    !mutated_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !leaked
    br ok -> L_VEC_LEAK_OK, L_VEC_LEAK_FAIL

L_VEC_LEAK_FAIL:
    !ok
    panic(10378)

L_VEC_LEAK_OK:
    !ok
    return

@test "sa_std vec spare capacity macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 4
    EXPAND VEC_PUSH_U64 vec, 11
    EXPAND VEC_PUSH_U64 vec, 22
    EXPAND VEC_CAPACITY cap, vec
    expected_spare_len = sub cap, 2
    EXPAND VEC_SPARE_CAPACITY_MUT_U64 spare, vec
    EXPAND SLICE_GET_LEN spare_len, spare
    EXPAND SLICE_GET_MUT_PTR_U64 spare0, spare, 0
    EXPAND SLICE_GET_MUT_PTR_U64 spare1, spare, 1
    store spare0+0, 33 as u64
    store spare1+0, 44 as u64
    EXPAND VEC_SET_LEN vec, 4
    EXPAND VEC_TRY_GET_U64 first_ok, first, vec, 0
    EXPAND VEC_TRY_GET_U64 third_ok, third, vec, 2
    EXPAND VEC_TRY_GET_U64 fourth_ok, fourth, vec, 3
    EXPAND VEC_SPLIT_AT_SPARE_MUT_U64 init, spare_after, vec
    EXPAND SLICE_GET_LEN init_len, init
    EXPAND SLICE_GET_LEN spare_after_len, spare_after
    expected_spare_after_len = sub cap, 4
    EXPAND SLICE_GET_MUT_PTR_U64 init0, init, 0
    store init0+0, 10 as u64
    EXPAND VEC_TRY_GET_U64 mutated_ok, mutated, vec, 0
    cap_ok = uge cap, 4
    spare_len_ok = eq spare_len, expected_spare_len
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first, 11
    third_flag_ok = eq third_ok, 1
    third_value_ok = eq third, 33
    fourth_flag_ok = eq fourth_ok, 1
    fourth_value_ok = eq fourth, 44
    init_len_ok = eq init_len, 4
    spare_after_len_ok = eq spare_after_len, expected_spare_after_len
    mutated_flag_ok = eq mutated_ok, 1
    mutated_value_ok = eq mutated, 10
    ok01 = and cap_ok, spare_len_ok
    ok02 = and ok01, first_flag_ok
    ok03 = and ok02, first_value_ok
    ok04 = and ok03, third_flag_ok
    ok05 = and ok04, third_value_ok
    ok06 = and ok05, fourth_flag_ok
    ok07 = and ok06, fourth_value_ok
    ok08 = and ok07, init_len_ok
    ok09 = and ok08, spare_after_len_ok
    ok10 = and ok09, mutated_flag_ok
    ok = and ok10, mutated_value_ok
    !cap
    !expected_spare_len
    !spare_len
    !spare0
    !spare1
    !first_ok
    !first
    !third_ok
    !third
    !fourth_ok
    !fourth
    !init_len
    !spare_after_len
    !expected_spare_after_len
    !init0
    !mutated_ok
    !mutated
    !cap_ok
    !spare_len_ok
    !first_flag_ok
    !first_value_ok
    !third_flag_ok
    !third_value_ok
    !fourth_flag_ok
    !fourth_value_ok
    !init_len_ok
    !spare_after_len_ok
    !mutated_flag_ok
    !mutated_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !spare
    !init
    !spare_after
    EXPAND VEC_FREE vec
    br ok -> L_VEC_SPARE_OK, L_VEC_SPARE_FAIL

L_VEC_SPARE_FAIL:
    !ok
    panic(10379)

L_VEC_SPARE_OK:
    !ok
    return

@test "sa_std vec clone and from-slice macros"():
L_VEC_CLONE_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 source, 3
    EXPAND VEC_PUSH_U64 source, 11
    EXPAND VEC_PUSH_U64 source, 22
    EXPAND VEC_PUSH_U64 source, 33
    EXPAND VEC_CLONE_U64 cloned, source
    EXPAND VEC_WITH_CAPACITY_U64 clone_from_dst, 1
    EXPAND VEC_PUSH_U64 clone_from_dst, 99
    EXPAND VEC_CLONE_FROM_U64 clone_from_dst, source

    slice_data = alloc 16
    store slice_data+0, 44 as u64
    store slice_data+8, 55 as u64
    from_slice_view = alloc Slice_SIZE
    EXPAND SLICE_NEW from_slice_view, slice_data, 2
    EXPAND VEC_FROM_SLICE_U64 from_slice_vec, from_slice_view
    EXPAND VEC_FROM_MUT_SLICE_U64 from_mut_slice_vec, from_slice_view
    EXPAND VEC_FROM_ARRAY_U64 from_array_vec, from_slice_view
    EXPAND VEC_FROM_MUT_ARRAY_U64 from_mut_array_vec, from_slice_view

    EXPAND VEC_GET_MUT_U64 source_first_mut_ok, source_first_ptr, source, 0
    store source_first_ptr+0, 77 as u64
    EXPAND VEC_TRY_GET_MUT_PTR_U64 source_miss_mut_ok, source_miss_ptr, source, 9
    source_miss_ptr_ok = eq source_miss_ptr, 0
    !source_miss_ptr
    EXPAND VEC_TRY_GET_U64 source_first_ok, source_first, source, 0
    EXPAND VEC_TRY_GET_U64 cloned_first_ok, cloned_first, cloned, 0
    EXPAND VEC_TRY_GET_U64 cloned_second_ok, cloned_second, cloned, 1
    EXPAND VEC_TRY_GET_U64 clone_from_first_ok, clone_from_first, clone_from_dst, 0
    EXPAND VEC_TRY_GET_U64 clone_from_third_ok, clone_from_third, clone_from_dst, 2
    EXPAND VEC_LEN clone_from_len, clone_from_dst
    EXPAND VEC_LEN from_slice_len, from_slice_vec
    EXPAND VEC_TRY_GET_U64 from_slice_first_ok, from_slice_first, from_slice_vec, 0
    EXPAND VEC_TRY_GET_U64 from_slice_second_ok, from_slice_second, from_slice_vec, 1
    EXPAND VEC_LEN from_mut_slice_len, from_mut_slice_vec
    EXPAND VEC_TRY_GET_U64 from_mut_slice_second_ok, from_mut_slice_second, from_mut_slice_vec, 1
    EXPAND VEC_LEN from_array_len, from_array_vec
    EXPAND VEC_TRY_GET_U64 from_array_second_ok, from_array_second, from_array_vec, 1
    EXPAND VEC_LEN from_mut_array_len, from_mut_array_vec
    EXPAND VEC_TRY_GET_U64 from_mut_array_second_ok, from_mut_array_second, from_mut_array_vec, 1

    source_first_mut_flag_ok = eq source_first_mut_ok, 1
    source_miss_mut_flag_ok = eq source_miss_mut_ok, 0
    source_first_flag_ok = eq source_first_ok, 1
    source_first_value_ok = eq source_first, 77
    cloned_first_flag_ok = eq cloned_first_ok, 1
    cloned_first_value_ok = eq cloned_first, 11
    cloned_second_flag_ok = eq cloned_second_ok, 1
    cloned_second_value_ok = eq cloned_second, 22
    clone_from_first_flag_ok = eq clone_from_first_ok, 1
    clone_from_first_value_ok = eq clone_from_first, 11
    clone_from_third_flag_ok = eq clone_from_third_ok, 1
    clone_from_third_value_ok = eq clone_from_third, 33
    clone_from_len_ok = eq clone_from_len, 3
    from_slice_len_ok = eq from_slice_len, 2
    from_slice_first_flag_ok = eq from_slice_first_ok, 1
    from_slice_first_value_ok = eq from_slice_first, 44
    from_slice_second_flag_ok = eq from_slice_second_ok, 1
    from_slice_second_value_ok = eq from_slice_second, 55
    from_mut_slice_len_ok = eq from_mut_slice_len, 2
    from_mut_slice_second_flag_ok = eq from_mut_slice_second_ok, 1
    from_mut_slice_second_value_ok = eq from_mut_slice_second, 55
    from_array_len_ok = eq from_array_len, 2
    from_array_second_flag_ok = eq from_array_second_ok, 1
    from_array_second_value_ok = eq from_array_second, 55
    from_mut_array_len_ok = eq from_mut_array_len, 2
    from_mut_array_second_flag_ok = eq from_mut_array_second_ok, 1
    from_mut_array_second_value_ok = eq from_mut_array_second, 55
    ok01 = and source_first_mut_flag_ok, source_miss_mut_flag_ok
    ok02 = and ok01, source_miss_ptr_ok
    ok03 = and ok02, source_first_flag_ok
    ok04 = and ok03, source_first_value_ok
    ok05 = and ok04, cloned_first_flag_ok
    ok06 = and ok05, cloned_first_value_ok
    ok07 = and ok06, cloned_second_flag_ok
    ok08 = and ok07, cloned_second_value_ok
    ok09 = and ok08, clone_from_first_flag_ok
    ok10 = and ok09, clone_from_first_value_ok
    ok11 = and ok10, clone_from_third_flag_ok
