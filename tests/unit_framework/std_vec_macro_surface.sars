    first_after_flag_ok = eq first_after_ok, 1
    first_after_value_ok = eq first_after, 11
    first_mut_rest_len_ok = eq first_mut_rest_len, 2
    last_mut_flag_ok = eq last_mut_ok, 1
    last_after_flag_ok = eq last_after_ok, 1
    last_after_value_ok = eq last_after, 33
    last_mut_rest_len_ok = eq last_mut_rest_len, 2
    empty_first_flag_ok = eq empty_first_ok, 0
    empty_first_value_ok = eq empty_first_value, 0
    empty_first_rest_len_ok = eq empty_first_rest_len, 0
    empty_last_mut_flag_ok = eq empty_last_mut_ok, 0
    empty_last_mut_rest_len_ok = eq empty_last_mut_rest_len, 0
    ok01 = and first_flag_ok, first_value_ok
    ok02 = and ok01, first_rest_len_ok
    ok03 = and ok02, first_rest_first_ok
    ok04 = and ok03, last_flag_ok
    ok05 = and ok04, last_value_ok
    ok06 = and ok05, last_rest_len_ok
    ok07 = and ok06, last_rest_last_ok
    ok08 = and ok07, first_mut_flag_ok
    ok09 = and ok08, first_after_flag_ok
    ok10 = and ok09, first_after_value_ok
    ok11 = and ok10, first_mut_rest_len_ok
    ok12 = and ok11, last_mut_flag_ok
    ok13 = and ok12, last_after_flag_ok
    ok14 = and ok13, last_after_value_ok
    ok15 = and ok14, last_mut_rest_len_ok
    ok16 = and ok15, empty_first_flag_ok
    ok17 = and ok16, empty_first_value_ok
    ok18 = and ok17, empty_first_rest_len_ok
    ok19 = and ok18, empty_last_mut_flag_ok
    ok = and ok19, empty_last_mut_rest_len_ok
    !first_ok
    !first_value
    !first_rest
    !first_rest_len
    !first_rest_first
    !last_ok
    !last_value
    !last_rest
    !last_rest_len
