    EXPAND VEC_PUSH_U64 dst, 2
    EXPAND VEC_WITH_CAPACITY_U64 src, 2
    EXPAND VEC_PUSH_U64 src, 3
    EXPAND VEC_PUSH_U64 src, 4
    EXPAND VEC_TRY_APPEND_WITHIN_CAPACITY_U64 ok1, dst, src
    EXPAND VEC_LEN dlen1, dst
    EXPAND VEC_LEN slen1, src
    EXPAND VEC_TRY_GET_U64 g2_ok, v2, dst, 2
    EXPAND VEC_TRY_GET_U64 g3_ok, v3, dst, 3
    EXPAND VEC_PUSH_U64 src, 5
    EXPAND VEC_PUSH_U64 src, 6
    EXPAND VEC_TRY_APPEND_WITHIN_CAPACITY_U64 ok2, dst, src
    EXPAND VEC_LEN dlen2, dst
    EXPAND VEC_LEN slen2, src

    ok1_flag = eq ok1, 1
    dlen1_ok = eq dlen1, 4
    slen1_ok = eq slen1, 0
    g2_flag = eq g2_ok, 1
    g2_val = eq v2, 3
    g3_flag = eq g3_ok, 1
    g3_val = eq v3, 4
    ok2_flag = eq ok2, 0
    dlen2_ok = eq dlen2, 4
    slen2_ok = eq slen2, 2

    ok = and ok1_flag, dlen1_ok
    ok = and ok, slen1_ok
    ok = and ok, g2_flag
    ok = and ok, g2_val
    ok = and ok, g3_flag
    ok = and ok, g3_val
    ok = and ok, ok2_flag
    ok = and ok, dlen2_ok
    ok = and ok, slen2_ok

    EXPAND VEC_FREE dst
    EXPAND VEC_FREE src
    !ok1
    !dlen1
    !slen1
    !g2_ok
    !v2
    !g3_ok
    !v3
    !ok2
    !dlen2
    !slen2
    !ok1_flag
    !dlen1_ok
    !slen1_ok
    !g2_flag
    !g2_val
    !g3_flag
    !g3_val
    !ok2_flag
    !dlen2_ok
    !slen2_ok
    br ok -> L_VEC_AWC_OK, L_VEC_AWC_FAIL

L_VEC_AWC_FAIL:
    !ok
    panic(10395)

L_VEC_AWC_OK:
    !ok
    return

@test "sa_std vec lit constructors"():
L_ENTRY:
    EXPAND VEC_LIT3_U64 v, 1, 2, 3
    EXPAND VEC_LEN len0, v
    len0_ok = eq len0, 3
    EXPAND VEC_TRY_GET_U64 ok0, g0, v, 0
    EXPAND VEC_TRY_GET_U64 ok1, g1, v, 1
    EXPAND VEC_TRY_GET_U64 ok2, g2, v, 2
    ok0_ok = eq ok0, 1
    ok1_ok = eq ok1, 1
    ok2_ok = eq ok2, 1
    g0_ok = eq g0, 1
    g1_ok = eq g1, 2
    g2_ok = eq g2, 3
    EXPAND VEC_FREE v
    ok = and len0_ok, ok0_ok
    ok = and ok, ok1_ok
    ok = and ok, ok2_ok
    ok = and ok, g0_ok
    ok = and ok, g1_ok
    ok = and ok, g2_ok
    !len0
    !ok0
    !g0
    !ok1
    !g1
    !ok2
    !g2
    !len0_ok
    !ok0_ok
    !ok1_ok
    !ok2_ok
    !g0_ok
    !g1_ok
    !g2_ok
    br ok -> L_VEC_LIT_OK, L_VEC_LIT_FAIL
L_VEC_LIT_FAIL:
    !ok
    panic(10396)
L_VEC_LIT_OK:
    !ok
    return
