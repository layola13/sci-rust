    ok13 = and ok12, grow_first_value_ok
    ok14 = and ok13, grow_second_flag_ok
    ok15 = and ok14, grow_second_value_ok
    ok16 = and ok15, len_after_truncate_ok
    ok17 = and ok16, resize_truncate_len_ok
    ok18 = and ok17, truncated_flag_ok
