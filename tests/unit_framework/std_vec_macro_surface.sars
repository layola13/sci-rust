    EXPAND VEC_CAPACITY cap_after_try_shrink_to_fit, vec
    EXPAND VEC_TRY_SHRINK_TO try_shrink_to_generic_ok, vec, 2, 8
    EXPAND VEC_CAPACITY cap_after_try_shrink_to_generic, vec
    EXPAND VEC_TRY_SHRINK_TO_FIT try_shrink_to_fit_generic_ok, vec, 8
    EXPAND VEC_CAPACITY cap_after_try_shrink_to_fit_generic, vec
    EXPAND VEC_TRY_GET_U64 tail_ok, tail_value, vec, 2

    resize_cap_ok = eq cap_after_resize, 5
    mut_slice_len_ok = eq mut_slice_len, 5
    as_ref_slice_len_ok = eq as_ref_slice_len, 5
    as_mut_ref_slice_len_ok = eq as_mut_ref_slice_len, 5
    as_ref_vec_len_ok = eq as_ref_vec_len, 5
    as_mut_vec_len_ok = eq as_mut_vec_len, 5
    deref_slice_len_ok = eq deref_slice_len, 5
    deref_mut_slice_len_ok = eq deref_mut_slice_len, 5
    vec_range_start_ok = eq vec_range_start, vec_data_ptr
    vec_range_end_ok = eq vec_range_end, vec_range_expected_end
    vec_mut_range_start_ok = eq vec_mut_range_start, vec_range_start
    vec_mut_range_end_ok = eq vec_mut_range_end, vec_range_expected_end
    slice_range_start_ok = eq slice_range_start, vec_range_start
    slice_range_end_ok = eq slice_range_end, vec_range_expected_end
    slice_mut_range_start_ok = eq slice_mut_range_start, vec_range_start
    slice_mut_range_end_ok = eq slice_mut_range_end, vec_range_expected_end
    ptr_range_ok01 = and vec_range_start_ok, vec_range_end_ok
    ptr_range_ok02 = and ptr_range_ok01, vec_mut_range_start_ok
    ptr_range_ok03 = and ptr_range_ok02, vec_mut_range_end_ok
    ptr_range_ok04 = and ptr_range_ok03, slice_range_start_ok
    ptr_range_ok05 = and ptr_range_ok04, slice_range_end_ok
    ptr_range_ok06 = and ptr_range_ok05, slice_mut_range_start_ok
    ptr_range_ok = and ptr_range_ok06, slice_mut_range_end_ok
    set_len_ok = eq len_after_set_len, 3
    shrink_to_ok = eq cap_after_shrink_to, 3
    try_shrink_to_flag_ok = eq try_shrink_to_ok, 1
    try_shrink_to_cap_ok = eq cap_after_try_shrink_to, 3
    shrink_to_fit_ok = eq cap_after_shrink_to_fit, 3
