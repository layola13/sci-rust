    ok02 = and ok01, as_ref_slice_len_ok
    ok03 = and ok02, as_mut_ref_slice_len_ok
    ok04 = and ok03, as_ref_vec_len_ok
    ok05 = and ok04, as_mut_vec_len_ok
    ok06 = and ok05, deref_slice_len_ok
    ok06a = and ok06, deref_mut_slice_len_ok
    ok06b = and ok06a, ptr_range_ok
    ok07 = and ok06b, set_len_ok
    ok08 = and ok07, shrink_to_ok
