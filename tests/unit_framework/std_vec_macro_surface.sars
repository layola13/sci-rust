    ok17 = and ok16, try_shrink_to_fit_generic_cap_ok
    ok18 = and ok17, tail_flag_ok
    ok = and ok18, tail_value_ok
    !cap_after_resize
    !mut_slice
    !mut_slice_len
    !as_ref_slice
    !as_ref_slice_len
    !as_mut_ref_slice
    !as_mut_ref_slice_len
    !as_ref_vec_len
    !as_mut_vec_len
    !deref_slice
    !deref_slice_len
    !deref_mut_slice
    !deref_mut_slice_len
    !vec_data_ptr
    !vec_range_start
