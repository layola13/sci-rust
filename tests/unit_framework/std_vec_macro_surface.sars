    !repeat_len
    !first_ok
    !first
    !middle_ok
    !middle
    !last_ok
    !last
    !zero_len
    !len_ok
    !first_flag_ok
    !first_value_ok
    !middle_flag_ok
    !middle_value_ok
    !last_flag_ok
    !last_value_ok
    !zero_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !repeat_data
    !repeat_slice
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE repeated_vec
