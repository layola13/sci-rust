    !vec_mut_range_start
    !vec_mut_range_end
    !slice_range_start
    !slice_range_end
    !slice_mut_range_start
    !slice_mut_range_end
    !vec_range_expected_end
    !len_after_set_len
    !cap_after_shrink_to
    !try_shrink_to_ok
    !cap_after_try_shrink_to
    !cap_after_shrink_to_fit
    !try_shrink_to_fit_ok
    !cap_after_try_shrink_to_fit
    !try_shrink_to_generic_ok
    !cap_after_try_shrink_to_generic
    !try_shrink_to_fit_generic_ok
    !cap_after_try_shrink_to_fit_generic
    !tail_ok
    !tail_value
    !resize_cap_ok
    !mut_slice_len_ok
    !as_ref_slice_len_ok
    !as_mut_ref_slice_len_ok
    !as_mut_vec_len_ok
    !deref_slice_len_ok
    !deref_mut_slice_len_ok
    !vec_range_start_ok
    !vec_range_end_ok
    !vec_mut_range_start_ok
    !vec_mut_range_end_ok
    !slice_range_start_ok
    !slice_range_end_ok
    !slice_mut_range_start_ok
    !slice_mut_range_end_ok
    !ptr_range_ok01
    !ptr_range_ok02
    !ptr_range_ok03
    !ptr_range_ok04
    !ptr_range_ok05
    !ptr_range_ok06
    !ptr_range_ok
    !set_len_ok
    !shrink_to_ok
    !try_shrink_to_flag_ok
    !try_shrink_to_cap_ok
    !shrink_to_fit_ok
    !try_shrink_to_fit_flag_ok
    !try_shrink_to_fit_cap_ok
    !try_shrink_to_generic_flag_ok
