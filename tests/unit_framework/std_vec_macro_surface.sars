    third_flag_ok = eq third_ok, 1
    third_value_ok = eq third, 31
    fourth_flag_ok = eq fourth_ok, 0
    fourth_value_ok = eq fourth, 0
    len_after_grow_ok = eq len_after_grow, 5
    resize_grow_len_ok = eq resize_grow_len, 5
    grow_first_flag_ok = eq grow_first_ok, 1
    grow_first_value_ok = eq grow_first, 42
    grow_second_flag_ok = eq grow_second_ok, 1
    grow_second_value_ok = eq grow_second, 42
    len_after_truncate_ok = eq len_after_truncate, 2
    resize_truncate_len_ok = eq resize_truncate_len, 2
    truncated_flag_ok = eq truncated_ok, 0
    truncated_value_ok = eq truncated_value, 0
    small_len_ok = eq small_len, 0
    ok01 = and dedup_by_len_ok, len_after_dedup_by_ok
    ok02 = and ok01, first_flag_ok
