@import "sa_std/marker.sars"

@test "sa_std marker hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    state = stack_alloc RandomState_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22

    phantom_writer_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW phantom_writer_hasher
    EXPAND DEFAULT_HASHER_WRITE_PHANTOM_DATA phantom_writer_hasher, 99
    EXPAND DEFAULT_HASHER_FINISH phantom_writer_hash, phantom_writer_hasher
    EXPAND PHANTOM_DATA_HASH phantom_hash, 99
    EXPAND PHANTOM_DATA_HASH phantom_hash_zero, 0
    EXPAND HASH_UNIT unit_hash, 0
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_PHANTOM_DATA phantom_build_hash, builder, 99
    EXPAND RANDOM_STATE_HASH_ONE_PHANTOM_DATA phantom_state_hash, state, 99

    phantom_manual_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD phantom_manual_hasher, state
    EXPAND DEFAULT_HASHER_FINISH phantom_manual_state_hash, phantom_manual_hasher

    pinned_writer_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW pinned_writer_hasher
    EXPAND DEFAULT_HASHER_WRITE_PHANTOM_PINNED pinned_writer_hasher, 77
    EXPAND DEFAULT_HASHER_FINISH pinned_writer_hash, pinned_writer_hasher
    EXPAND PHANTOM_PINNED_HASH pinned_hash, 77
    EXPAND PHANTOM_PINNED_HASH pinned_hash_zero, 0
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_PHANTOM_PINNED pinned_build_hash, builder, 77
    EXPAND RANDOM_STATE_HASH_ONE_PHANTOM_PINNED pinned_state_hash, state, 77

    pinned_manual_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD pinned_manual_hasher, state
    EXPAND DEFAULT_HASHER_FINISH pinned_manual_state_hash, pinned_manual_hasher

    phantom_writer_matches = eq phantom_writer_hash, phantom_hash
    phantom_unit_matches = eq phantom_hash, unit_hash
    phantom_build_matches = eq phantom_build_hash, phantom_hash
    phantom_state_matches = eq phantom_state_hash, phantom_manual_state_hash
    phantom_token_ignored = eq phantom_hash, phantom_hash_zero

    pinned_writer_matches = eq pinned_writer_hash, pinned_hash
    pinned_unit_matches = eq pinned_hash, unit_hash
    pinned_build_matches = eq pinned_build_hash, pinned_hash
    pinned_state_matches = eq pinned_state_hash, pinned_manual_state_hash
    pinned_token_ignored = eq pinned_hash, pinned_hash_zero

    c01 = and phantom_writer_matches, phantom_unit_matches
    c02 = and c01, phantom_build_matches
    c03 = and c02, phantom_state_matches
    c04 = and c03, phantom_token_ignored
    c05 = and c04, pinned_writer_matches
    c06 = and c05, pinned_unit_matches
    c07 = and c06, pinned_build_matches
    c08 = and c07, pinned_state_matches
    ok = and c08, pinned_token_ignored

    !builder
    !phantom_writer_hash
    !phantom_hash
    !phantom_hash_zero
    !unit_hash
    !phantom_build_hash
    !phantom_state_hash
    !phantom_manual_state_hash
    !pinned_writer_hash
    !pinned_hash
    !pinned_hash_zero
    !pinned_build_hash
    !pinned_state_hash
    !pinned_manual_state_hash
    !phantom_writer_matches
    !phantom_unit_matches
    !phantom_build_matches
    !phantom_state_matches
    !phantom_token_ignored
    !pinned_writer_matches
    !pinned_unit_matches
    !pinned_build_matches
    !pinned_state_matches
    !pinned_token_ignored
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10596)

L_PASS:
    !ok
    return 0
