@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap clear"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW heap
    EXPAND BINARY_HEAP_PUSH heap, 1
    EXPAND BINARY_HEAP_PUSH heap, 2
    EXPAND BINARY_HEAP_CLEAR heap
    EXPAND BINARY_HEAP_LEN ln, heap
    EXPAND BINARY_HEAP_IS_EMPTY e, heap
    EXPAND BINARY_HEAP_FREE heap
    a = eq ln, 0
    b = eq e, 1
    ok = and a, b
    !ln
    !e
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10989)
