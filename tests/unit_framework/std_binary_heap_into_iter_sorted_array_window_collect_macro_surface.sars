@import "sa_std/collections/binary_heap.sars"

@sorted_window_sum(window: ptr, len: u64) -> u64:
L_ENTRY:
    acc = add 0, 0
    index = add 0, 0
    jmp L_SORTED_WINDOW_SUM_HEAD
L_SORTED_WINDOW_SUM_HEAD:
    more = ult index, len
    br more -> L_SORTED_WINDOW_SUM_ADD, L_SORTED_WINDOW_SUM_DONE
L_SORTED_WINDOW_SUM_ADD:
    off = mul index, 8
    item = ptr_add window, off
    value = load item+0 as u64
    next_acc = add acc, value
    !acc
    acc = add next_acc, 0
    next_index = add index, 1
    !index
    index = add next_index, 0
    !next_index
    !next_acc
    !value
    !item
    !off
    !more
    jmp L_SORTED_WINDOW_SUM_HEAD
L_SORTED_WINDOW_SUM_DONE:
    !more
    !index
    !len
    !window
    return acc

@test "sa_std binary_heap into_iter_sorted array window collect macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW chunks_heap
    EXPAND BINARY_HEAP_PUSH_U64 chunks_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 chunks_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 chunks_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 chunks_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 chunks_heap, 5
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 chunks_iter, chunks_backing, chunks_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_ARRAY_CHUNKS_COLLECT_U64 chunks_ok, chunks_vec, chunks_iter, 2
    EXPAND VEC_GET_U64 chunks_0, chunks_vec, 0
    EXPAND VEC_GET_U64 chunks_3, chunks_vec, 3
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 chunks_remaining, chunks_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 chunks_tail_has, chunks_tail, chunks_iter

    EXPAND BINARY_HEAP_NEW zero_heap
    EXPAND BINARY_HEAP_PUSH_U64 zero_heap, 7
    EXPAND BINARY_HEAP_PUSH_U64 zero_heap, 8
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 zero_iter, zero_backing, zero_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_ARRAY_CHUNKS_COLLECT_U64 zero_ok, zero_vec, zero_iter, 0
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 zero_next_has, zero_next, zero_iter

    EXPAND BINARY_HEAP_NEW windows_heap
    EXPAND BINARY_HEAP_PUSH_U64 windows_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 windows_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 windows_heap, 8
    EXPAND BINARY_HEAP_PUSH_U64 windows_heap, 9
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 windows_iter, windows_backing, windows_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_MAP_WINDOWS_COLLECT_U64 windows_ok, windows_vec, windows_iter, 2, @sorted_window_sum
    EXPAND VEC_GET_U64 windows_0, windows_vec, 0
    EXPAND VEC_GET_U64 windows_2, windows_vec, 2

    EXPAND VEC_FREE chunks_backing
    EXPAND VEC_FREE chunks_vec
    EXPAND VEC_FREE zero_backing
    EXPAND VEC_FREE zero_vec
    EXPAND VEC_FREE windows_backing
    EXPAND VEC_FREE windows_vec

    ok = eq chunks_ok, 1
    check = eq chunks_0, 5
    ok = and ok, check
    check = eq chunks_3, 2
    ok = and ok, check
    check = eq chunks_remaining, 1
    ok = and ok, check
    check = eq chunks_tail_has, 1
    ok = and ok, check
    check = eq chunks_tail, 1
    ok = and ok, check
    check = eq zero_ok, 0
    ok = and ok, check
    check = eq zero_next_has, 1
    ok = and ok, check
    check = eq zero_next, 8
    ok = and ok, check
    check = eq windows_ok, 1
    ok = and ok, check
    check = eq windows_0, 17
    ok = and ok, check
    check = eq windows_2, 4
    ok = and ok, check

    !chunks_ok
    !chunks_0
    !chunks_3
    !chunks_remaining
    !chunks_tail_has
    !chunks_tail
    !zero_ok
    !zero_next_has
    !zero_next
    !windows_ok
    !windows_0
    !windows_2
    !check
    !chunks_iter
    !zero_iter
    !windows_iter
    br ok -> L_SORTED_ARRAY_WINDOW_OK, L_SORTED_ARRAY_WINDOW_FAIL
L_SORTED_ARRAY_WINDOW_FAIL:
    !ok
    panic(10783)
L_SORTED_ARRAY_WINDOW_OK:
    !ok
    return
