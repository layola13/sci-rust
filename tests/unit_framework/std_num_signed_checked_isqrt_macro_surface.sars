@import "sa_std/num.sars"

@test "sa_std signed checked isqrt macro surface"():
L_ENTRY:
    EXPAND NUM_I8_CHECKED_ISQRT ok_i8, sqrt_i8, NUM_I8_MAX
    EXPAND NUM_I16_CHECKED_ISQRT ok_i16, sqrt_i16, NUM_I16_MAX
    EXPAND NUM_I32_CHECKED_ISQRT ok_i32, sqrt_i32, NUM_I32_MAX
    EXPAND NUM_I64_CHECKED_ISQRT ok_i64, sqrt_i64, NUM_I64_MAX
    EXPAND NUM_ISIZE_CHECKED_ISQRT ok_isize, sqrt_isize, 10

    EXPAND NUM_I8_CHECKED_ISQRT neg_ok_i8, neg_sqrt_i8, -1
    EXPAND NUM_I16_CHECKED_ISQRT neg_ok_i16, neg_sqrt_i16, -1
    EXPAND NUM_I32_CHECKED_ISQRT neg_ok_i32, neg_sqrt_i32, -1
    EXPAND NUM_I64_CHECKED_ISQRT neg_ok_i64, neg_sqrt_i64, -1
    EXPAND NUM_ISIZE_CHECKED_ISQRT neg_ok_isize, neg_sqrt_isize, -1

    ok_positive_01 = and ok_i8, ok_i16
    ok_positive_02 = and ok_positive_01, ok_i32
    ok_positive_03 = and ok_positive_02, ok_i64
    ok_positive_all = and ok_positive_03, ok_isize

    ok_value_01 = eq sqrt_i8, 11
    ok_value_02 = eq sqrt_i16, 181
    ok_value_03 = eq sqrt_i32, 46340
    ok_value_04 = eq sqrt_i64, 3037000499
    ok_value_05 = eq sqrt_isize, 3

    ok_negative_flag_01 = eq neg_ok_i8, 0
    ok_negative_flag_02 = eq neg_ok_i16, 0
    ok_negative_flag_03 = eq neg_ok_i32, 0
    ok_negative_flag_04 = eq neg_ok_i64, 0
    ok_negative_flag_05 = eq neg_ok_isize, 0

    ok_negative_value_01 = eq neg_sqrt_i8, 0
    ok_negative_value_02 = eq neg_sqrt_i16, 0
    ok_negative_value_03 = eq neg_sqrt_i32, 0
    ok_negative_value_04 = eq neg_sqrt_i64, 0
    ok_negative_value_05 = eq neg_sqrt_isize, 0

    ok_all_01 = and ok_positive_all, ok_value_01
    ok_all_02 = and ok_all_01, ok_value_02
    ok_all_03 = and ok_all_02, ok_value_03
    ok_all_04 = and ok_all_03, ok_value_04
    ok_all_05 = and ok_all_04, ok_value_05
    ok_all_06 = and ok_all_05, ok_negative_flag_01
    ok_all_07 = and ok_all_06, ok_negative_flag_02
    ok_all_08 = and ok_all_07, ok_negative_flag_03
    ok_all_09 = and ok_all_08, ok_negative_flag_04
    ok_all_10 = and ok_all_09, ok_negative_flag_05
    ok_all_11 = and ok_all_10, ok_negative_value_01
    ok_all_12 = and ok_all_11, ok_negative_value_02
    ok_all_13 = and ok_all_12, ok_negative_value_03
    ok_all_14 = and ok_all_13, ok_negative_value_04
    ok = and ok_all_14, ok_negative_value_05
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10627)

L_PASS:
    !ok
    return 0
