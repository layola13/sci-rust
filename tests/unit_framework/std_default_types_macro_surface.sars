@import "sa_std/core/slice.sars"
@import "sa_std/core/option.sars"
@import "sa_std/core/result.sars"
@import "sa_std/ops.sars"

@test "sa_std Slice Option Range Bound Default macros"():
L_ENTRY:
    s = alloc Slice_SIZE
    EXPAND SLICE_DEFAULT s
    s_ptr = load s+Slice_ptr as ptr
    s_len = load s+Slice_len as u64
    ok_slice_ptr = eq s_ptr, 0
    ok_slice_len = eq s_len, 0
    !s_ptr
    !s_len
    !s

    EXPAND OPTION_DEFAULT opt
    opt_tag = load opt+Option_tag as u64
    ok_opt_none = eq opt_tag, Option_NONE
    !opt_tag
    !opt

    r = alloc RangeU64_SIZE
    EXPAND RANGE_U64_DEFAULT r
    r_start = load r+RangeU64_start as u64
    r_end = load r+RangeU64_end as u64
    ok_r_start = eq r_start, 0
    ok_r_end = eq r_end, 0
    !r_start
    !r_end
    !r

    EXPAND RANGE_FULL_DEFAULT tok
    ok_rf = eq 1, 1

    b = alloc BoundU64_SIZE
    EXPAND BOUND_U64_DEFAULT b
    b_tag = load b+BoundU64_tag as u64
    ok_b_unbounded = eq b_tag, BOUND_U64_UNBOUNDED
    !b_tag
    !b

    rf2 = alloc RangeFromU64_SIZE
    EXPAND RANGE_FROM_U64_DEFAULT rf2
    rf2_start = load rf2+RangeFromU64_start as u64
    ok_rf2_start = eq rf2_start, 0
    !rf2_start
    !rf2

    rt = alloc RangeToU64_SIZE
    EXPAND RANGE_TO_U64_DEFAULT rt
    rt_end = load rt+RangeToU64_end as u64
    ok_rt_end = eq rt_end, 0
    !rt_end
    !rt

    rti = alloc RangeToInclusiveU64_SIZE
    EXPAND RANGE_TO_INCLUSIVE_U64_DEFAULT rti
    rti_end = load rti+RangeToInclusiveU64_end as u64
    ok_rti_end = eq rti_end, 0
    !rti_end
    !rti

    EXPAND RESULT_DEFAULT rdef
    rdef_tag = load rdef+Result_tag as u64
    rdef_ok = load rdef+Result_ok as u64
    rdef_err = load rdef+Result_err as u64
    ok_rdef_tag = eq rdef_tag, Result_OK
    ok_rdef_ok = eq rdef_ok, 0
    ok_rdef_err = eq rdef_err, 0
    !rdef_tag
    !rdef_ok
    !rdef_err
    !rdef

    ri = alloc RangeInclusiveU64_SIZE
    EXPAND RANGE_INCLUSIVE_U64_DEFAULT ri
    ri_start = load ri+RangeInclusiveU64_start as u64
    ri_end = load ri+RangeInclusiveU64_end as u64
    ri_exhausted = load ri+RangeInclusiveU64_exhausted as u64
    ok_ri_start = eq ri_start, 0
    ok_ri_end = eq ri_end, 0
    ok_ri_exhausted = eq ri_exhausted, 0
    !ri_start
    !ri_end
    !ri_exhausted
    !ri

    c1 = and ok_slice_ptr, ok_slice_len
    c2 = and c1, ok_opt_none
    c3 = and c2, ok_r_start
    c4 = and c3, ok_r_end
    c5 = and c4, ok_rf
    c6 = and c5, ok_b_unbounded
    c7 = and c6, ok_rf2_start
    c8 = and c7, ok_rt_end
    c9 = and c8, ok_rti_end
    c10 = and c9, ok_rdef_tag
    c11 = and c10, ok_rdef_ok
    c12 = and c11, ok_rdef_err
    c13 = and c12, ok_ri_start
    c14 = and c13, ok_ri_end
    ok = and c14, ok_ri_exhausted

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    !c1
    !c2
    !c3
    !c4
    !c5
    !c6
    !c7
    !c8
    !c9
    !c10
    !c11
    !c12
    !c13
    !c14
    !ok_rf
    !ok_rdef_tag
    !ok_rdef_ok
    !ok_rdef_err
    !ok_ri_start
    !ok_ri_end
    !ok_ri_exhausted
    panic(10464)

L_PASS:
    return 0
