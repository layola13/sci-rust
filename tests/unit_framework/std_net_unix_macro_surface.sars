@test "sa_std net unix datagram pathname address macros"():
L_ENTRY:
    EXPAND NET_UNIX_DATAGRAM_BIND bind_server_status, server, UDS_DGRAM_PATH_A, UDS_DGRAM_PATH_LEN
    call @sa_assert_eq_i64(bind_server_status, SA_NET_OK, 10417)
    server_nonzero = ne server, 0
    call @sa_assert_eq_i64(server_nonzero, 1, 10417)
    EXPAND NET_UNIX_DATAGRAM_BIND bind_client_status, client, UDS_DGRAM_PATH_B, UDS_DGRAM_PATH_LEN
    call @sa_assert_eq_i64(bind_client_status, SA_NET_OK, 10417)
    client_nonzero = ne client, 0
    call @sa_assert_eq_i64(client_nonzero, 1, 10417)
    EXPAND NET_UNIX_DATAGRAM_SET_READ_TIMEOUT timeout_status, server, UDS_TEST_TIMEOUT_NS
    call @sa_assert_eq_i64(timeout_status, SA_NET_OK, 10417)

    EXPAND NET_UNIX_DATAGRAM_CONNECT connect_status, client, UDS_DGRAM_PATH_A, UDS_DGRAM_PATH_LEN
    call @sa_assert_eq_i64(connect_status, SA_NET_OK, 10417)
    EXPAND NET_UNIX_DATAGRAM_SEND send_status, send_len, client, UDS_DGRAM_PATH_MSG, UDS_DGRAM_PATH_MSG_LEN
    call @sa_assert_eq_i64(send_status, SA_NET_OK, 10417)
    call @sa_assert_eq_i64(send_len, UDS_DGRAM_PATH_MSG_LEN, 10417)

    peek_buf = stack_alloc 8
    recv_buf = stack_alloc 8
    recv2_buf = stack_alloc 8
    recv3_buf = stack_alloc 8
    EXPAND NET_UNIX_DATAGRAM_PEEK_FROM peek_status, peek_len, peek_addr, server, peek_buf, 8
    call @sa_assert_eq_i64(peek_status, SA_NET_OK, 10417)
    call @sa_assert_eq_i64(peek_len, UDS_DGRAM_PATH_MSG_LEN, 10417)
    peek_b0 = load peek_buf+0 as u8
    peek_b1 = load peek_buf+1 as u8
    call @sa_assert_eq_i64(peek_b0, 114, 10417)
    call @sa_assert_eq_i64(peek_b1, 120, 10417)
    EXPAND NET_UNIX_ADDR_KIND peek_addr_kind, peek_addr
    call @sa_assert_eq_i64(peek_addr_kind, SA_NET_UNIX_ADDR_PATHNAME, 10417)
    EXPAND NET_UNIX_ADDR_AS_PATHNAME_LEN peek_addr_len, peek_addr
    call @sa_assert_eq_i64(peek_addr_len, UDS_DGRAM_PATH_LEN, 10417)
    EXPAND NET_UNIX_ADDR_AS_PATHNAME_PTR peek_addr_ptr, peek_addr
    peek_addr_b0 = load peek_addr_ptr+0 as u8
    peek_addr_b23 = load peek_addr_ptr+23 as u8
    call @sa_assert_eq_i64(peek_addr_b0, 47, 10417)
    call @sa_assert_eq_i64(peek_addr_b23, 107, 10417)
    EXPAND NET_UNIX_ADDR_FREE peek_addr_free_status, peek_addr
    call @sa_assert_eq_i64(peek_addr_free_status, SA_NET_OK, 10417)

    EXPAND NET_UNIX_DATAGRAM_RECV_FROM recv_status, recv_len, recv_addr, server, recv_buf, 8
    call @sa_assert_eq_i64(recv_status, SA_NET_OK, 10417)
    call @sa_assert_eq_i64(recv_len, UDS_DGRAM_PATH_MSG_LEN, 10417)
    recv_b0 = load recv_buf+0 as u8
    recv_b1 = load recv_buf+1 as u8
    call @sa_assert_eq_i64(recv_b0, 114, 10417)
    call @sa_assert_eq_i64(recv_b1, 120, 10417)
    EXPAND NET_UNIX_ADDR_KIND recv_addr_kind, recv_addr
    call @sa_assert_eq_i64(recv_addr_kind, SA_NET_UNIX_ADDR_PATHNAME, 10417)
    EXPAND NET_UNIX_ADDR_FREE recv_addr_free_status, recv_addr
    call @sa_assert_eq_i64(recv_addr_free_status, SA_NET_OK, 10417)

    EXPAND NET_UNIX_DATAGRAM_SEND_TO send_to_status, send_to_len, client, UDS_DGRAM_ADDR_MSG, UDS_DGRAM_ADDR_MSG_LEN, UDS_DGRAM_PATH_A, UDS_DGRAM_PATH_LEN
    call @sa_assert_eq_i64(send_to_status, SA_NET_OK, 10417)
    call @sa_assert_eq_i64(send_to_len, UDS_DGRAM_ADDR_MSG_LEN, 10417)
    EXPAND NET_UNIX_DATAGRAM_RECV_FROM recv2_status, recv2_len, recv2_addr, server, recv2_buf, 8
    call @sa_assert_eq_i64(recv2_status, SA_NET_OK, 10417)
    call @sa_assert_eq_i64(recv2_len, UDS_DGRAM_ADDR_MSG_LEN, 10417)
    recv2_b0 = load recv2_buf+0 as u8
    recv2_b1 = load recv2_buf+1 as u8
    call @sa_assert_eq_i64(recv2_b0, 116, 10417)
    call @sa_assert_eq_i64(recv2_b1, 111, 10417)
    EXPAND NET_UNIX_ADDR_FREE recv2_addr_free_status, recv2_addr
    call @sa_assert_eq_i64(recv2_addr_free_status, SA_NET_OK, 10417)

    EXPAND NET_UNIX_ADDR_FROM_PATHNAME path_addr_status, path_addr, UDS_DGRAM_PATH_A, UDS_DGRAM_PATH_LEN
    call @sa_assert_eq_i64(path_addr_status, SA_NET_OK, 10417)
    EXPAND NET_UNIX_DATAGRAM_CONNECT_ADDR connect_addr_status, client, path_addr
    call @sa_assert_eq_i64(connect_addr_status, SA_NET_OK, 10417)
    EXPAND NET_UNIX_DATAGRAM_SEND send3_status, send3_len, client, UDS_DGRAM_NEXT, UDS_DGRAM_NEXT_LEN
    call @sa_assert_eq_i64(send3_status, SA_NET_OK, 10417)
    call @sa_assert_eq_i64(send3_len, UDS_DGRAM_NEXT_LEN, 10417)
    EXPAND NET_UNIX_DATAGRAM_RECV_FROM recv3_status, recv3_len, recv3_addr, server, recv3_buf, 8
    call @sa_assert_eq_i64(recv3_status, SA_NET_OK, 10417)
    call @sa_assert_eq_i64(recv3_len, UDS_DGRAM_NEXT_LEN, 10417)
    recv3_b0 = load recv3_buf+0 as u8
    recv3_b1 = load recv3_buf+1 as u8
    call @sa_assert_eq_i64(recv3_b0, 111, 10417)
    call @sa_assert_eq_i64(recv3_b1, 107, 10417)
    EXPAND NET_UNIX_ADDR_FREE recv3_addr_free_status, recv3_addr
    call @sa_assert_eq_i64(recv3_addr_free_status, SA_NET_OK, 10417)
    EXPAND NET_UNIX_ADDR_FREE path_addr_free_status, path_addr
    call @sa_assert_eq_i64(path_addr_free_status, SA_NET_OK, 10417)

    EXPAND NET_UNIX_DATAGRAM_CLOSE close_client_status, client
    call @sa_assert_eq_i64(close_client_status, SA_NET_OK, 10417)
    EXPAND NET_UNIX_DATAGRAM_CLOSE close_server_status, server
    call @sa_assert_eq_i64(close_server_status, SA_NET_OK, 10417)

    !bind_server_status
    !server_nonzero
    !bind_client_status
    !client_nonzero
    !timeout_status
    !connect_status
    !send_status
    !send_len
    !peek_status
    !peek_len
    !peek_addr
    !peek_b0
    !peek_b1
    !peek_addr_kind
    !peek_addr_len
    !peek_addr_ptr
    !peek_addr_b0
    !peek_addr_b23
    !peek_addr_free_status
    !recv_status
    !recv_len
    !recv_addr
    !recv_b0
    !recv_b1
    !recv_addr_kind
    !recv_addr_free_status
    !send_to_status
    !send_to_len
    !recv2_status
    !recv2_len
    !recv2_addr
    !recv2_b0
    !recv2_b1
    !recv2_addr_free_status
    !path_addr_status
    !path_addr
    !connect_addr_status
    !send3_status
    !send3_len
    !recv3_status
    !recv3_len
    !recv3_addr
    !recv3_b0
    !recv3_b1
    !recv3_addr_free_status
    !path_addr_free_status
    !client
    !server
    !close_client_status
    !close_server_status
    return 0

@test "sa_std net unix datagram abstract address macros"():
L_ENTRY:
    EXPAND NET_UNIX_ADDR_FROM_ABSTRACT_NAME abstract_status, abstract_addr, UDS_DGRAM_ABSTRACT, UDS_DGRAM_ABSTRACT_LEN
    call @sa_assert_eq_i64(abstract_status, SA_NET_OK, 10418)
    EXPAND NET_UNIX_DATAGRAM_BIND_ADDR bind_status, server, abstract_addr
    call @sa_assert_eq_i64(bind_status, SA_NET_OK, 10418)
    server_nonzero = ne server, 0
    call @sa_assert_eq_i64(server_nonzero, 1, 10418)
    EXPAND NET_UNIX_DATAGRAM_UNBOUND client_status, client
    call @sa_assert_eq_i64(client_status, SA_NET_OK, 10418)
    client_nonzero = ne client, 0
    call @sa_assert_eq_i64(client_nonzero, 1, 10418)
    EXPAND NET_UNIX_DATAGRAM_SET_READ_TIMEOUT timeout_status, server, UDS_TEST_TIMEOUT_NS
    call @sa_assert_eq_i64(timeout_status, SA_NET_OK, 10418)

    recv_buf = stack_alloc 8
    recv2_buf = stack_alloc 8
    EXPAND NET_UNIX_DATAGRAM_SEND_TO_ADDR send_to_status, send_to_len, client, UDS_DGRAM_ADDR_MSG, UDS_DGRAM_ADDR_MSG_LEN, abstract_addr
    call @sa_assert_eq_i64(send_to_status, SA_NET_OK, 10418)
    call @sa_assert_eq_i64(send_to_len, UDS_DGRAM_ADDR_MSG_LEN, 10418)
    EXPAND NET_UNIX_DATAGRAM_RECV_FROM recv_status, recv_len, recv_addr, server, recv_buf, 8
    call @sa_assert_eq_i64(recv_status, SA_NET_OK, 10418)
    call @sa_assert_eq_i64(recv_len, UDS_DGRAM_ADDR_MSG_LEN, 10418)
    recv_b0 = load recv_buf+0 as u8
    recv_b1 = load recv_buf+1 as u8
    call @sa_assert_eq_i64(recv_b0, 116, 10418)
    call @sa_assert_eq_i64(recv_b1, 111, 10418)
    EXPAND NET_UNIX_ADDR_KIND recv_addr_kind, recv_addr
    call @sa_assert_eq_i64(recv_addr_kind, SA_NET_UNIX_ADDR_UNNAMED, 10418)
    EXPAND NET_UNIX_ADDR_FREE recv_addr_free_status, recv_addr
    call @sa_assert_eq_i64(recv_addr_free_status, SA_NET_OK, 10418)

    EXPAND NET_UNIX_DATAGRAM_CONNECT_ADDR connect_status, client, abstract_addr
    call @sa_assert_eq_i64(connect_status, SA_NET_OK, 10418)
    EXPAND NET_UNIX_DATAGRAM_SEND send_status, send_len, client, UDS_DGRAM_NEXT, UDS_DGRAM_NEXT_LEN
    call @sa_assert_eq_i64(send_status, SA_NET_OK, 10418)
    call @sa_assert_eq_i64(send_len, UDS_DGRAM_NEXT_LEN, 10418)
    EXPAND NET_UNIX_DATAGRAM_RECV_FROM recv2_status, recv2_len, recv2_addr, server, recv2_buf, 8
    call @sa_assert_eq_i64(recv2_status, SA_NET_OK, 10418)
    call @sa_assert_eq_i64(recv2_len, UDS_DGRAM_NEXT_LEN, 10418)
    recv2_b0 = load recv2_buf+0 as u8
    recv2_b1 = load recv2_buf+1 as u8
    call @sa_assert_eq_i64(recv2_b0, 111, 10418)
    call @sa_assert_eq_i64(recv2_b1, 107, 10418)
    EXPAND NET_UNIX_ADDR_FREE recv2_addr_free_status, recv2_addr
    call @sa_assert_eq_i64(recv2_addr_free_status, SA_NET_OK, 10418)

    EXPAND NET_UNIX_DATAGRAM_CLOSE close_client_status, client
    call @sa_assert_eq_i64(close_client_status, SA_NET_OK, 10418)
    EXPAND NET_UNIX_DATAGRAM_CLOSE close_server_status, server
    call @sa_assert_eq_i64(close_server_status, SA_NET_OK, 10418)
    EXPAND NET_UNIX_ADDR_FREE abstract_free_status, abstract_addr
    call @sa_assert_eq_i64(abstract_free_status, SA_NET_OK, 10418)

    !abstract_status
    !abstract_addr
    !bind_status
    !server_nonzero
    !client_status
    !client_nonzero
    !timeout_status
    !send_to_status
    !send_to_len
    !recv_status
    !recv_len
    !recv_addr
    !recv_b0
    !recv_b1
    !recv_addr_kind
    !recv_addr_free_status
    !connect_status
    !send_status
    !send_len
    !recv2_status
    !recv2_len
    !recv2_addr
    !recv2_b0
    !recv2_b1
    !recv2_addr_free_status
    !client
    !server
    !close_client_status
    !close_server_status
    !abstract_free_status
    return 0
