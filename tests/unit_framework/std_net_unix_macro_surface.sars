L_PAIR_CLONE_WRITE_DONE:
    clone_send = stack_alloc 4
    store clone_send+0, 67 as u8
    store clone_send+1, 76 as u8
    store clone_send+2, 79 as u8
    store clone_send+3, 78 as u8
    EXPAND NET_TCP_STREAM_WRITE clone_write_status, clone_write_len, pair_left_clone, clone_send, 4
    clone_write_status_ok = eq clone_write_status, SA_NET_OK
    clone_write_len_ok = eq clone_write_len, 4
    clone_write_ok = and clone_write_status_ok, clone_write_len_ok
