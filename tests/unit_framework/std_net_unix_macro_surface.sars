    ok13 = and ok12, take_error_ok
    ok14 = and ok13, sock_error_ok
    ok15 = and ok14, local_addr_ok
    ok16 = and ok15, local_kind_ok
    ok17 = and ok16, peer_addr_ok
    ok18 = and ok17, peer_kind_ok
    ok19 = and ok18, local_free_ok
    ok20 = and ok19, peer_free_ok
    ok21 = and ok20, passcred_set_ok
    ok22 = and ok21, passcred_get_ok
    ok23 = and ok22, passcred_value_mark_ok
    ok24 = and ok23, clone_ok
    ok25 = and ok24, clone_handle_ok
    ok26 = and ok25, as_raw_ok
    ok27 = and ok26, clone_fd_ok
    ok28 = and ok27, into_raw_ok
    ok29 = and ok28, raw_match_ok
    ok30 = and ok29, from_raw_ok
    ok31 = and ok30, clone_from_raw_ok
    ok32 = and ok31, into_owned_ok
    ok33 = and ok32, owned_fd_ok
    ok34 = and ok33, from_owned_ok
    ok35 = and ok34, clone_from_owned_ok
    ok36 = and ok35, clone_close_ok
    ok37 = and ok36, send_ok
