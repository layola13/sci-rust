@test "sa_std net unix pathname socket address constructor"():
L_PATHNAME_ADDR_ENTRY:
    path_len = add 0, 21
    EXPAND NET_UNIX_ADDR_FROM_PATHNAME path_addr_status, path_addr, UDS_TEST_PATH, path_len
    path_addr_status_ok = eq path_addr_status, SA_NET_OK
    path_addr_handle_ok = ne path_addr, 0
    path_addr_make_ok = and path_addr_status_ok, path_addr_handle_ok
    br path_addr_make_ok -> L_PATHNAME_ADDR_CHECK, L_PATHNAME_ADDR_FAIL_MAKE

L_PATHNAME_ADDR_FAIL_MAKE:
    !path_addr_make_ok
    !path_addr_handle_ok
    !path_addr_status_ok
    !path_addr
    !path_addr_status
    panic(10149)

L_PATHNAME_ADDR_CHECK:
    EXPAND NET_UNIX_ADDR_KIND path_addr_kind, path_addr
    path_addr_kind_ok = eq path_addr_kind, SA_NET_UNIX_ADDR_PATHNAME
    EXPAND NET_UNIX_ADDR_AS_PATHNAME_LEN path_addr_len, path_addr
    path_addr_len_ok = eq path_addr_len, 21
    EXPAND NET_UNIX_ADDR_AS_PATHNAME_PTR path_addr_ptr, path_addr
    path_addr_ptr_ok = ne path_addr_ptr, 0
    path_addr_b0 = load path_addr_ptr+0 as u8
    path_addr_b20 = load path_addr_ptr+20 as u8
    path_addr_b0_ok = eq path_addr_b0, 47
    path_addr_b20_ok = eq path_addr_b20, 107
    path_addr01 = and path_addr_kind_ok, path_addr_len_ok
    path_addr02 = and path_addr01, path_addr_ptr_ok
    path_addr03 = and path_addr02, path_addr_b0_ok
    path_addr_ok = and path_addr03, path_addr_b20_ok
    EXPAND NET_UNIX_ADDR_FREE path_addr_free_status, path_addr
    path_addr_free_ok = eq path_addr_free_status, SA_NET_OK
    path_addr_done = and path_addr_ok, path_addr_free_ok
    br path_addr_done -> L_PATHNAME_ADDR_PASS, L_PATHNAME_ADDR_FAIL_CHECK

L_PATHNAME_ADDR_FAIL_CHECK:
    !path_addr_done
    !path_addr_free_ok
    !path_addr_free_status
    !path_addr_ok
    !path_addr03
    !path_addr02
    !path_addr01
    !path_addr_b20_ok
    !path_addr_b0_ok
    !path_addr_b20
    !path_addr_b0
    !path_addr_ptr_ok
    !path_addr_ptr
    !path_addr_len_ok
    !path_addr_len
    !path_addr_kind_ok
    !path_addr_kind
    !path_addr_make_ok
    panic(10150)

L_PATHNAME_ADDR_PASS:
    !path_addr_done
    return 0

@test "sa_std net unix abstract address roundtrip"():
L_ABSTRACT_ENTRY:
    EXPAND NET_UNIX_ADDR_FROM_ABSTRACT_NAME make_status, abstract_addr, UDS_ABSTRACT_NAME, UDS_ABSTRACT_NAME_LEN
    make_status_ok = eq make_status, SA_NET_OK
    abstract_addr_ok = ne abstract_addr, 0
    make_ok = and make_status_ok, abstract_addr_ok
    br make_ok -> L_ABSTRACT_KIND, L_ABSTRACT_FAIL_MAKE

L_ABSTRACT_FAIL_MAKE:
    !make_ok
    !abstract_addr_ok
    !make_status_ok
    !abstract_addr
    !make_status
    panic(10151)

L_ABSTRACT_KIND:
    EXPAND NET_UNIX_ADDR_KIND abstract_kind, abstract_addr
    abstract_kind_ok = eq abstract_kind, SA_NET_UNIX_ADDR_ABSTRACT
    EXPAND NET_UNIX_ADDR_AS_ABSTRACT_NAME_LEN abstract_len, abstract_addr
    abstract_len_ok = eq abstract_len, UDS_ABSTRACT_NAME_LEN
    EXPAND NET_UNIX_ADDR_AS_ABSTRACT_NAME_PTR abstract_ptr, abstract_addr
    abstract_ptr_ok = ne abstract_ptr, 0
    abstract_b0 = load abstract_ptr+0 as u8
    abstract_b14 = load abstract_ptr+14 as u8
    abstract_b0_ok = eq abstract_b0, 115
    abstract_b14_ok = eq abstract_b14, 116
    abstract01 = and abstract_kind_ok, abstract_len_ok
    abstract02 = and abstract01, abstract_ptr_ok
    abstract03 = and abstract02, abstract_b0_ok
    abstract_ok = and abstract03, abstract_b14_ok
    br abstract_ok -> L_ABSTRACT_LISTEN, L_ABSTRACT_FAIL_KIND

L_ABSTRACT_FAIL_KIND:
    !abstract_ok
    !abstract03
    !abstract02
    !abstract01
    !abstract_b14_ok
    !abstract_b0_ok
    !abstract_b14
    !abstract_b0
    !abstract_ptr_ok
    !abstract_ptr
    !abstract_len_ok
    !abstract_len
    !abstract_kind_ok
    !abstract_kind
    !abstract_addr
    panic(10152)

L_ABSTRACT_LISTEN:
    EXPAND NET_UNIX_LISTEN_ADDR listen_status, listener, abstract_addr
    listen_status_ok = eq listen_status, SA_NET_OK
    listener_ok = ne listener, 0
    listen_ok = and listen_status_ok, listener_ok
    br listen_ok -> L_ABSTRACT_LOCAL, L_ABSTRACT_FAIL_LISTEN

L_ABSTRACT_FAIL_LISTEN:
    !listen_ok
    !listener_ok
    !listen_status_ok
    !listener
    !listen_status
    !abstract_addr
    panic(10153)

L_ABSTRACT_LOCAL:
    EXPAND NET_UNIX_LISTENER_LOCAL_ADDR local_status, local_addr, listener
    local_status_ok = eq local_status, SA_NET_OK
    local_addr_ok = ne local_addr, 0
    EXPAND NET_UNIX_ADDR_KIND local_kind, local_addr
    local_kind_ok = eq local_kind, SA_NET_UNIX_ADDR_ABSTRACT
    EXPAND NET_UNIX_ADDR_AS_ABSTRACT_NAME_LEN local_len, local_addr
    local_len_ok = eq local_len, UDS_ABSTRACT_NAME_LEN
    EXPAND NET_UNIX_ADDR_AS_ABSTRACT_NAME_PTR local_ptr, local_addr
    local_ptr_ok = ne local_ptr, 0
    local_b0 = load local_ptr+0 as u8
    local_b14 = load local_ptr+14 as u8
    local_b0_ok = eq local_b0, 115
    local_b14_ok = eq local_b14, 116
    local01 = and local_status_ok, local_addr_ok
    local02 = and local01, local_kind_ok
    local03 = and local02, local_len_ok
    local04 = and local03, local_ptr_ok
    local05 = and local04, local_b0_ok
    local_ok = and local05, local_b14_ok
    EXPAND NET_UNIX_ADDR_FREE local_free_status, local_addr
    local_free_ok = eq local_free_status, SA_NET_OK
    local_all = and local_ok, local_free_ok
    br local_all -> L_ABSTRACT_INCOMING, L_ABSTRACT_FAIL_LOCAL

L_ABSTRACT_FAIL_LOCAL:
    !local_all
    !local_free_ok
    !local_free_status
    !local_ok
    !local05
    !local04
    !local03
    !local02
    !local01
    !local_b14_ok
    !local_b0_ok
    !local_b14
    !local_b0
    !local_ptr_ok
    !local_ptr
    !local_len_ok
    !local_len
    !local_kind_ok
    !local_kind
    !local_addr_ok
    !local_status_ok
    !local_addr
    !local_status
    !listener
    !abstract_addr
    panic(10154)

L_ABSTRACT_INCOMING:
    incoming = stack_alloc NetTcpIncoming_SIZE
    EXPAND NET_UNIX_LISTENER_INCOMING incoming, listener
    EXPAND NET_UNIX_INCOMING_LISTENER incoming_listener, incoming
    incoming_listener_ok = eq incoming_listener, listener
    !incoming_listener
    br incoming_listener_ok -> L_ABSTRACT_CONNECT, L_ABSTRACT_FAIL_INCOMING

L_ABSTRACT_FAIL_INCOMING:
    !incoming_listener_ok
    !listener
    !abstract_addr
    panic(979)

L_ABSTRACT_CONNECT:
    EXPAND NET_UNIX_CONNECT_ADDR connect_status, client, abstract_addr
    connect_status_ok = eq connect_status, SA_NET_OK
    client_ok = ne client, 0
    connect_ok = and connect_status_ok, client_ok
    br connect_ok -> L_ABSTRACT_ACCEPT, L_ABSTRACT_FAIL_CONNECT

L_ABSTRACT_FAIL_CONNECT:
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !incoming_listener_ok
    !listener
    !abstract_addr
    panic(10155)

L_ABSTRACT_ACCEPT:
    EXPAND NET_UNIX_INCOMING_NEXT accept_status, accept_flag, server, incoming
    accept_status_ok = eq accept_status, SA_NET_OK
    accept_flag_ok = eq accept_flag, 1
    server_ok = ne server, 0
    accept01 = and accept_status_ok, accept_flag_ok
    accept_ok = and accept01, server_ok
    br accept_ok -> L_ABSTRACT_WRITE, L_ABSTRACT_FAIL_ACCEPT

L_ABSTRACT_FAIL_ACCEPT:
    !accept_ok
    !accept01
    !server_ok
    !accept_flag_ok
    !accept_status_ok
    !server
    !accept_flag
    !accept_status
    !client
    !incoming_listener_ok
    !listener
    !abstract_addr
    panic(975)

L_ABSTRACT_WRITE:
    abstract_send = stack_alloc 4
    store abstract_send+0, 65 as u8
    store abstract_send+1, 66 as u8
    store abstract_send+2, 83 as u8
    store abstract_send+3, 33 as u8
    EXPAND NET_TCP_STREAM_WRITE write_status, write_len, client, abstract_send, 4
    write_status_ok = eq write_status, SA_NET_OK
    write_len_ok = eq write_len, 4
    write_ok = and write_status_ok, write_len_ok
    br write_ok -> L_ABSTRACT_READ, L_ABSTRACT_FAIL_WRITE

L_ABSTRACT_FAIL_WRITE:
    !write_ok
    !write_len_ok
    !write_status_ok
    !write_len
    !write_status
    !incoming_listener_ok
    !server
    !client
    !listener
    !abstract_addr
    panic(976)

L_ABSTRACT_READ:
    abstract_recv = stack_alloc 8
    EXPAND NET_TCP_STREAM_READ read_status, read_len, server, abstract_recv, 8
    read_status_ok = eq read_status, SA_NET_OK
    read_len_ok = eq read_len, 4
    read_b0 = load abstract_recv+0 as u8
    read_b3 = load abstract_recv+3 as u8
    read_b0_ok = eq read_b0, 65
    read_b3_ok = eq read_b3, 33
    read01 = and read_status_ok, read_len_ok
    read02 = and read01, read_b0_ok
    read_ok = and read02, read_b3_ok
    br read_ok -> L_ABSTRACT_CLOSE, L_ABSTRACT_FAIL_READ

L_ABSTRACT_FAIL_READ:
    !read_ok
    !read02
    !read01
    !read_b3_ok
    !read_b0_ok
    !read_b3
    !read_b0
    !read_len_ok
    !read_status_ok
    !read_len
    !read_status
    !incoming_listener_ok
    !server
    !client
    !listener
    !abstract_addr
    panic(977)

L_ABSTRACT_CLOSE:
    EXPAND NET_TCP_STREAM_CLOSE close_client_status, client
    EXPAND NET_TCP_STREAM_CLOSE close_server_status, server
    EXPAND NET_TCP_LISTENER_CLOSE close_listener_status, listener
    EXPAND NET_UNIX_ADDR_FREE abstract_free_status, abstract_addr
    close_client_ok = eq close_client_status, SA_NET_OK
    close_server_ok = eq close_server_status, SA_NET_OK
    close_listener_ok = eq close_listener_status, SA_NET_OK
    abstract_free_ok = eq abstract_free_status, SA_NET_OK
    close01 = and close_client_ok, close_server_ok
    close02 = and close01, close_listener_ok
    close_ok = and close02, abstract_free_ok
    br close_ok -> L_ABSTRACT_PASS, L_ABSTRACT_FAIL_CLOSE

L_ABSTRACT_FAIL_CLOSE:
    !close_ok
    !close02
    !close01
    !abstract_free_ok
    !close_listener_ok
    !close_server_ok
    !close_client_ok
    !abstract_free_status
    !close_listener_status
    !close_server_status
    !close_client_status
    !incoming_listener_ok
    panic(978)

L_ABSTRACT_PASS:
    !incoming_listener_ok
    return 0

@test "sa_std net unix datagram pair macros"():
L_ENTRY:
    EXPAND NET_UNIX_DATAGRAM_UNBOUND unbound_status, unbound
    EXPAND NET_UNIX_DATAGRAM_CLOSE unbound_close_status, unbound
    EXPAND NET_UNIX_DATAGRAM_PAIR pair_status, left, right
    EXPAND NET_UNIX_DATAGRAM_SET_READ_TIMEOUT read_timeout_status, right, UDS_TEST_TIMEOUT_NS
    EXPAND NET_UNIX_DATAGRAM_READ_TIMEOUT read_timeout_get_status, read_timeout_ns, right
    EXPAND NET_UNIX_DATAGRAM_SET_WRITE_TIMEOUT write_timeout_status, left, UDS_TEST_TIMEOUT_NS
    EXPAND NET_UNIX_DATAGRAM_WRITE_TIMEOUT write_timeout_get_status, write_timeout_ns, left
    EXPAND NET_UNIX_DATAGRAM_SET_NONBLOCKING nonblock_status, right, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_UNIX_DATAGRAM_TAKE_ERROR take_error_status, sock_error, left

    EXPAND NET_UNIX_DATAGRAM_LOCAL_ADDR local_addr_status, local_addr, left
    EXPAND NET_UNIX_ADDR_KIND local_kind, local_addr
    EXPAND NET_UNIX_DATAGRAM_PEER_ADDR peer_addr_status, peer_addr, left
    EXPAND NET_UNIX_ADDR_KIND peer_kind, peer_addr
    EXPAND NET_UNIX_ADDR_FREE local_free_status, local_addr
    EXPAND NET_UNIX_ADDR_FREE peer_free_status, peer_addr

    EXPAND NET_UNIX_DATAGRAM_SET_PASSCRED passcred_set_status, left, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_UNIX_DATAGRAM_PASSCRED passcred_get_status, passcred_enabled, left
    EXPAND NET_UNIX_DATAGRAM_SET_MARK datagram_mark_status, left, 32

    EXPAND NET_UNIX_DATAGRAM_TRY_CLONE clone_status, clone, left
    EXPAND NET_UNIX_DATAGRAM_AS_RAW_FD as_raw_status, clone_fd, clone
    EXPAND NET_UNIX_DATAGRAM_INTO_RAW_FD into_raw_status, raw_taken, clone
    EXPAND NET_UNIX_DATAGRAM_FROM_RAW_FD from_raw_status, clone_from_raw, raw_taken
    EXPAND NET_UNIX_DATAGRAM_INTO_OWNED_FD into_owned_status, owned_fd, clone_from_raw
    EXPAND NET_UNIX_DATAGRAM_FROM_OWNED_FD from_owned_status, clone_from_owned, owned_fd
    EXPAND NET_UNIX_DATAGRAM_CLOSE clone_close_status, clone_from_owned

    peek_buf = stack_alloc 8
    recv_buf = stack_alloc 8
    recv_left_buf = stack_alloc 8
    EXPAND NET_UNIX_DATAGRAM_SEND send_status, send_len, left, UDS_DGRAM_MSG, UDS_DGRAM_MSG_LEN
    EXPAND NET_UNIX_DATAGRAM_PEEK peek_status, peek_len, right, peek_buf, 8
    peek_b0 = load peek_buf+0 as u8
    peek_b2 = load peek_buf+2 as u8
    EXPAND NET_UNIX_DATAGRAM_RECV recv_status, recv_len, right, recv_buf, 8
    recv_b0 = load recv_buf+0 as u8
    recv_b2 = load recv_buf+2 as u8
    EXPAND NET_UNIX_DATAGRAM_SEND send_back_status, send_back_len, right, UDS_DGRAM_NEXT, UDS_DGRAM_NEXT_LEN
    EXPAND NET_UNIX_DATAGRAM_RECV recv_left_status, recv_left_len, left, recv_left_buf, 8
    recv_left_b0 = load recv_left_buf+0 as u8
    recv_left_b1 = load recv_left_buf+1 as u8
    EXPAND NET_UNIX_DATAGRAM_SHUTDOWN shutdown_status, left, SA_NET_SHUTDOWN_BOTH
    EXPAND NET_UNIX_DATAGRAM_CLOSE close_left_status, left
    EXPAND NET_UNIX_DATAGRAM_CLOSE close_right_status, right

    unbound_ok = eq unbound_status, SA_NET_OK
    unbound_handle_ok = ne unbound, 0
    unbound_close_ok = eq unbound_close_status, SA_NET_OK
    pair_ok = eq pair_status, SA_NET_OK
    left_ok = ne left, 0
    right_ok = ne right, 0
    read_timeout_ok = eq read_timeout_status, SA_NET_OK
    read_timeout_get_ok = eq read_timeout_get_status, SA_NET_OK
    read_timeout_value_ok = eq read_timeout_ns, UDS_TEST_TIMEOUT_NS
    write_timeout_ok = eq write_timeout_status, SA_NET_OK
    write_timeout_get_ok = eq write_timeout_get_status, SA_NET_OK
    write_timeout_value_ok = eq write_timeout_ns, UDS_TEST_TIMEOUT_NS
    nonblock_ok = eq nonblock_status, SA_NET_OK
    take_error_ok = eq take_error_status, SA_NET_OK
    sock_error_ok = eq sock_error, 0
    local_addr_ok = eq local_addr_status, SA_NET_OK
    local_kind_ok = eq local_kind, SA_NET_UNIX_ADDR_UNNAMED
    peer_addr_ok = eq peer_addr_status, SA_NET_OK
    peer_kind_ok = eq peer_kind, SA_NET_UNIX_ADDR_UNNAMED
    local_free_ok = eq local_free_status, SA_NET_OK
    peer_free_ok = eq peer_free_status, SA_NET_OK
    passcred_set_ok = eq passcred_set_status, SA_NET_OK
    passcred_get_ok = eq passcred_get_status, SA_NET_OK
    passcred_value_ok = eq passcred_enabled, SA_NET_SOCKET_OPTION_ENABLE
    datagram_mark_ok = eq datagram_mark_status, SA_NET_OK
    datagram_mark_access = eq datagram_mark_status, SA_NET_ERR_ACCESS
    datagram_mark_unsupported = eq datagram_mark_status, SA_NET_ERR_UNSUPPORTED
    datagram_mark_allowed1 = or datagram_mark_ok, datagram_mark_access
    datagram_mark_allowed = or datagram_mark_allowed1, datagram_mark_unsupported
    passcred_value_mark_ok = and passcred_value_ok, datagram_mark_allowed
    clone_ok = eq clone_status, SA_NET_OK
    clone_handle_ok = ne clone, 0
    as_raw_ok = eq as_raw_status, SA_NET_OK
    clone_fd_ok = ne clone_fd, -1
    into_raw_ok = eq into_raw_status, SA_NET_OK
    raw_match_ok = eq raw_taken, clone_fd
    from_raw_ok = eq from_raw_status, SA_NET_OK
    clone_from_raw_ok = ne clone_from_raw, 0
    into_owned_ok = eq into_owned_status, SA_NET_OK
    owned_fd_ok = ne owned_fd, 0
    from_owned_ok = eq from_owned_status, SA_NET_OK
    clone_from_owned_ok = ne clone_from_owned, 0
    clone_close_ok = eq clone_close_status, SA_NET_OK
    send_ok = eq send_status, SA_NET_OK
    send_len_ok = eq send_len, UDS_DGRAM_MSG_LEN
    peek_ok = eq peek_status, SA_NET_OK
    peek_len_ok = eq peek_len, UDS_DGRAM_MSG_LEN
    peek_b0_ok = eq peek_b0, 100
    peek_b2_ok = eq peek_b2, 33
    recv_ok = eq recv_status, SA_NET_OK
    recv_len_ok = eq recv_len, UDS_DGRAM_MSG_LEN
    recv_b0_ok = eq recv_b0, 100
    recv_b2_ok = eq recv_b2, 33
    send_back_ok = eq send_back_status, SA_NET_OK
    send_back_len_ok = eq send_back_len, UDS_DGRAM_NEXT_LEN
    recv_left_ok = eq recv_left_status, SA_NET_OK
    recv_left_len_ok = eq recv_left_len, UDS_DGRAM_NEXT_LEN
    recv_left_b0_ok = eq recv_left_b0, 111
    recv_left_b1_ok = eq recv_left_b1, 107
    shutdown_ok = eq shutdown_status, SA_NET_OK
    close_left_ok = eq close_left_status, SA_NET_OK
    close_right_ok = eq close_right_status, SA_NET_OK

    ok01 = and unbound_ok, unbound_handle_ok
    ok02 = and ok01, unbound_close_ok
    ok03 = and ok02, pair_ok
    ok04 = and ok03, left_ok
    ok05 = and ok04, right_ok
    ok06 = and ok05, read_timeout_ok
    ok07 = and ok06, read_timeout_get_ok
    ok08 = and ok07, read_timeout_value_ok
    ok09 = and ok08, write_timeout_ok
