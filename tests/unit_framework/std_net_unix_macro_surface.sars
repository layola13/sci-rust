L_PAIR_PASSCRED:
    !clone_close_ok
    EXPAND NET_UNIX_STREAM_SET_PASSCRED passcred_enable_status, left, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_UNIX_STREAM_PASSCRED passcred_get_status, passcred_enabled, left
    EXPAND NET_UNIX_STREAM_SET_PASSCRED passcred_disable_status, left, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_UNIX_STREAM_PASSCRED passcred_get2_status, passcred_enabled2, left
    EXPAND NET_UNIX_STREAM_SET_MARK stream_mark_status, left, 32
    passcred_enable_ok = eq passcred_enable_status, SA_NET_OK
    passcred_get_ok = eq passcred_get_status, SA_NET_OK
    passcred_enabled_ok = eq passcred_enabled, 1
    passcred_disable_ok = eq passcred_disable_status, SA_NET_OK
    passcred_get2_ok = eq passcred_get2_status, SA_NET_OK
    passcred_enabled2_ok = eq passcred_enabled2, 0
    stream_mark_ok = eq stream_mark_status, SA_NET_OK
    stream_mark_access = eq stream_mark_status, SA_NET_ERR_ACCESS
    stream_mark_unsupported = eq stream_mark_status, SA_NET_ERR_UNSUPPORTED
    stream_mark_allowed1 = or stream_mark_ok, stream_mark_access
    stream_mark_allowed = or stream_mark_allowed1, stream_mark_unsupported
    passcred01 = and passcred_enable_ok, passcred_get_ok
    passcred02 = and passcred01, passcred_enabled_ok
    passcred03 = and passcred02, passcred_disable_ok
    passcred04 = and passcred03, passcred_get2_ok
    passcred05 = and passcred04, passcred_enabled2_ok
    passcred_ok = and passcred05, stream_mark_allowed
    br passcred_ok -> L_PAIR_PEER_CRED, L_PAIR_FAIL_PASSCRED

