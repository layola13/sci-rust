@import "sa_std/net.sars"
@import "sa_std/process.sars"
@import "sa_std/testing/assert.sai"

// Unix domain socket 宏表面测试 + socket 选项 setter。
// UDS 是本地流 socket：单线程 listen -> connect(入队即返回) -> accept -> write -> read 可行。
@const UDS_TEST_PATH = utf8:"/tmp/sa_uds_test.sock"
@const DBG_REUSE_STATUS = utf8:"uds_reuse_status"
@const DBG_REUSEPORT_STATUS = utf8:"uds_reuseport_status"
@const DBG_CONNECT_STATUS = utf8:"uds_connect_status"
@const DBG_CLIENT = utf8:"uds_client"
@const UDS_ABSTRACT_NAME = utf8:"sa-uds-abstract"
@const UDS_DGRAM_MSG = utf8:"dg!"
@const UDS_DGRAM_NEXT = utf8:"ok"
@const UDS_DGRAM_PATH_A = utf8:"/tmp/sa_uds_dgram_a.sock"
@const UDS_DGRAM_PATH_B = utf8:"/tmp/sa_uds_dgram_b.sock"
@const UDS_DGRAM_ABSTRACT = utf8:"sa-uds-dgram-abstract"
@const UDS_DGRAM_ADDR_MSG = utf8:"to"
@const UDS_DGRAM_PATH_MSG = utf8:"rx"

#def DBG_REUSE_STATUS_LEN = 16
#def DBG_REUSEPORT_STATUS_LEN = 20
#def DBG_CONNECT_STATUS_LEN = 18
#def DBG_CLIENT_LEN = 10
#def UDS_ABSTRACT_NAME_LEN = 15
#def UDS_DGRAM_MSG_LEN = 3
#def UDS_DGRAM_NEXT_LEN = 2
#def UDS_DGRAM_PATH_LEN = 24
#def UDS_DGRAM_ABSTRACT_LEN = 21
#def UDS_DGRAM_ADDR_MSG_LEN = 2
#def UDS_DGRAM_PATH_MSG_LEN = 2
#def UDS_TEST_TIMEOUT_NS = 100000000

@test "sa_std net unix domain socket roundtrip"():
L_ENTRY:
    path_len = add 0, 21
    client = add 0, 0
    connect_all = add 0, 0

    EXPAND NET_UNIX_LISTEN listen_status, listener, UDS_TEST_PATH, path_len
    listen_ok = eq listen_status, SA_NET_OK
    listener_ok = ne listener, 0
    listen_all = and listen_ok, listener_ok
    br listen_all -> L_ADDR, L_FAIL_LISTEN

L_FAIL_LISTEN:
    !listener
    !listen_status
    panic(10123)

L_ADDR:
    EXPAND NET_UNIX_LISTENER_LOCAL_ADDR addr_status, listener_addr, listener
    addr_status_ok = eq addr_status, SA_NET_OK
    addr_handle_ok = ne listener_addr, 0
    EXPAND NET_UNIX_ADDR_KIND addr_kind, listener_addr
    addr_kind_ok = eq addr_kind, SA_NET_UNIX_ADDR_PATHNAME
    EXPAND NET_UNIX_ADDR_PATH_LEN addr_path_len, listener_addr
    addr_len_ok = eq addr_path_len, 21
    EXPAND NET_UNIX_ADDR_PATH_PTR addr_path_ptr, listener_addr
    addr_ptr_ok = ne addr_path_ptr, 0
    addr_b0 = load addr_path_ptr+0 as u8
    addr_b20 = load addr_path_ptr+20 as u8
    addr_b0_ok = eq addr_b0, 47
    addr_b20_ok = eq addr_b20, 107
    addr01 = and addr_status_ok, addr_handle_ok
    addr02 = and addr01, addr_kind_ok
    addr03 = and addr02, addr_len_ok
    addr04 = and addr03, addr_ptr_ok
    addr05 = and addr04, addr_b0_ok
    addr_all = and addr05, addr_b20_ok
    EXPAND NET_UNIX_ADDR_FREE addr_free_status, listener_addr
    addr_free_ok = eq addr_free_status, SA_NET_OK
    addr_all2 = and addr_all, addr_free_ok
    !addr_free_status
    !addr_all
    !addr05
    !addr04
    !addr03
    !addr02
    !addr01
    !addr_b20_ok
    !addr_b0_ok
    !addr_b20
    !addr_b0
    !addr_ptr_ok
    !addr_path_ptr
    !addr_len_ok
    !addr_path_len
    !addr_kind_ok
    !addr_kind
    !addr_handle_ok
    !addr_status_ok
    !addr_status
    !listener_addr
    br addr_all2 -> L_LISTENER_OPTIONS, L_FAIL_ADDR

L_FAIL_ADDR:
    !addr_all2
    !listener
    panic(10124)

L_LISTENER_OPTIONS:
    EXPAND NET_UNIX_LISTENER_SET_NONBLOCKING listener_nonblock_status, listener, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_UNIX_LISTENER_TAKE_ERROR listener_error_status, listener_error, listener
    listener_nonblock_ok = eq listener_nonblock_status, SA_NET_OK
    listener_error_status_ok = eq listener_error_status, SA_NET_OK
    listener_error_ok = eq listener_error, 0
    listener_option01 = and listener_nonblock_ok, listener_error_status_ok
    listener_options_ok = and listener_option01, listener_error_ok
    !listener_option01
    !listener_error_ok
    !listener_error_status_ok
    !listener_nonblock_ok
    !listener_error
    !listener_error_status
    !listener_nonblock_status
    br listener_options_ok -> L_LISTENER_CLONE, L_FAIL_LISTENER_OPTIONS

L_FAIL_LISTENER_OPTIONS:
    !listener_options_ok
    !addr_all2
    !listener
    panic(10125)

L_LISTENER_CLONE:
    !listener_options_ok
    EXPAND NET_UNIX_LISTENER_TRY_CLONE listener_clone_status, listener_clone, listener
    listener_clone_status_ok = eq listener_clone_status, SA_NET_OK
    listener_clone_handle_ok = ne listener_clone, 0
    listener_clone_ready = and listener_clone_status_ok, listener_clone_handle_ok
    br listener_clone_ready -> L_LISTENER_CLONE_OWNED, L_FAIL_LISTENER_CLONE

L_FAIL_LISTENER_CLONE:
    !listener_clone_ready
    !listener_clone_handle_ok
    !listener_clone_status_ok
    !listener_clone
    !listener_clone_status
    !addr_all2
    !listener
    panic(10126)

L_LISTENER_CLONE_OWNED:
    EXPAND NET_UNIX_LISTENER_INTO_OWNED_FD listener_into_owned_status, listener_owned_fd, listener_clone
    listener_into_owned_status_ok = eq listener_into_owned_status, SA_NET_OK
    listener_owned_fd_ok = ne listener_owned_fd, 0
    listener_into_owned_ok = and listener_into_owned_status_ok, listener_owned_fd_ok
    br listener_into_owned_ok -> L_LISTENER_CLONE_FROM_OWNED, L_FAIL_LISTENER_INTO_OWNED

L_FAIL_LISTENER_INTO_OWNED:
    !listener_into_owned_ok
    !listener_owned_fd_ok
    !listener_into_owned_status_ok
    !listener_owned_fd
    !listener_into_owned_status
    !listener_clone_ready
    !addr_all2
    !listener
    panic(10127)

L_LISTENER_CLONE_FROM_OWNED:
    EXPAND NET_UNIX_LISTENER_FROM_OWNED_FD listener_from_owned_status, listener_clone, listener_owned_fd
    listener_from_owned_status_ok = eq listener_from_owned_status, SA_NET_OK
    listener_from_owned_handle_ok = ne listener_clone, 0
    listener_from_owned_ok = and listener_from_owned_status_ok, listener_from_owned_handle_ok
    br listener_from_owned_ok -> L_LISTENER_CLONE_CLOSE, L_FAIL_LISTENER_FROM_OWNED

L_FAIL_LISTENER_FROM_OWNED:
    !listener_from_owned_ok
    !listener_from_owned_handle_ok
    !listener_from_owned_status_ok
    !listener_clone
    !listener_from_owned_status
    !listener_into_owned_ok
    !listener_clone_ready
    !addr_all2
    !listener
    panic(10128)

L_LISTENER_CLONE_CLOSE:
    EXPAND NET_UNIX_LISTENER_AS_RAW_FD listener_raw_status, listener_raw_fd, listener_clone
    listener_raw_status_ok = eq listener_raw_status, SA_NET_OK
    listener_raw_fd_ok = ne listener_raw_fd, -1
    listener_raw_ok = and listener_raw_status_ok, listener_raw_fd_ok
    br listener_raw_ok -> L_LISTENER_CLONE_INTO_RAW, L_FAIL_LISTENER_RAW

L_FAIL_LISTENER_RAW:
    !listener_raw_ok
    !listener_raw_fd_ok
    !listener_raw_status_ok
    !listener_raw_fd
    !listener_raw_status
    !listener_from_owned_ok
    !addr_all2
    !listener
    panic(10129)

L_LISTENER_CLONE_INTO_RAW:
    EXPAND NET_UNIX_LISTENER_INTO_RAW_FD listener_into_raw_status, listener_raw_taken, listener_clone
    listener_into_raw_ok = eq listener_into_raw_status, SA_NET_OK
    listener_raw_match = eq listener_raw_taken, listener_raw_fd
    listener_take_ok = and listener_into_raw_ok, listener_raw_match
    br listener_take_ok -> L_LISTENER_CLONE_FROM_RAW, L_FAIL_LISTENER_INTO_RAW

L_FAIL_LISTENER_INTO_RAW:
    !listener_take_ok
    !listener_raw_match
    !listener_into_raw_ok
    !listener_raw_taken
    !listener_into_raw_status
    !listener_raw_ok
    !addr_all2
    !listener
    panic(10130)

L_LISTENER_CLONE_FROM_RAW:
    EXPAND NET_UNIX_LISTENER_FROM_RAW_FD listener_from_raw_status, listener_clone, listener_raw_taken
    listener_from_raw_status_ok = eq listener_from_raw_status, SA_NET_OK
    listener_from_raw_handle_ok = ne listener_clone, 0
    listener_from_raw_ok = and listener_from_raw_status_ok, listener_from_raw_handle_ok
    br listener_from_raw_ok -> L_LISTENER_CLONE_CLOSE_DONE, L_FAIL_LISTENER_FROM_RAW

L_FAIL_LISTENER_FROM_RAW:
    !listener_from_raw_ok
    !listener_from_raw_handle_ok
    !listener_from_raw_status_ok
    !listener_clone
    !listener_from_raw_status
    !listener_take_ok
    !listener_raw_ok
    !listener_from_owned_ok
    !addr_all2
    !listener
    panic(10131)

L_LISTENER_CLONE_CLOSE_DONE:
    EXPAND NET_TCP_LISTENER_CLOSE listener_clone_close_status, listener_clone
    listener_clone_close_ok = eq listener_clone_close_status, SA_NET_OK
    !listener_from_raw_ok
    !listener_take_ok
    !listener_raw_ok
    !listener_from_owned_ok
    !listener_clone_ready
    !listener_clone_handle_ok
    !listener_clone_status_ok
    !listener_clone_status
    !listener_clone
    !listener_clone_close_status
    br listener_clone_close_ok -> L_REUSE, L_FAIL_LISTENER_CLONE_CLOSE

L_FAIL_LISTENER_CLONE_CLOSE:
    !listener_clone_close_ok
    !addr_all2
    !listener
    panic(985)

L_REUSE:
    !listener_clone_close_ok
    // 在 listener 上验证 reuseaddr/reuseport setter 返回 OK。
    EXPAND NET_TCP_LISTENER_SET_REUSEADDR reuse_status, listener, SA_NET_SOCKET_OPTION_ENABLE
    reuse_ok = eq reuse_status, SA_NET_OK
    EXPAND NET_TCP_LISTENER_SET_REUSEPORT reuseport_status, listener, SA_NET_SOCKET_OPTION_ENABLE
    reuseport_ok = eq reuseport_status, SA_NET_OK
    reuse_both = and reuse_ok, reuseport_ok
    call @sa_test_debug_i64(&DBG_REUSE_STATUS, DBG_REUSE_STATUS_LEN, reuse_status)
    call @sa_test_debug_i64(&DBG_REUSEPORT_STATUS, DBG_REUSEPORT_STATUS_LEN, reuseport_status)
    !reuseport_status
    !reuse_status
    br reuse_both -> L_CONNECT, L_FAIL_REUSE

L_FAIL_REUSE:
    !addr_all2
    !listener
    panic(10132)

L_CONNECT:
    EXPAND NET_UNIX_CONNECT connect_status, client, UDS_TEST_PATH, path_len
    connect_ok = eq connect_status, SA_NET_OK
    client_ok = ne client, 0
    connect_all = and connect_ok, client_ok
    call @sa_test_debug_i64(&DBG_CONNECT_STATUS, DBG_CONNECT_STATUS_LEN, connect_status)
    call @sa_test_debug_i64(&DBG_CLIENT, DBG_CLIENT_LEN, client)
    !connect_status
    br connect_all -> L_ACCEPT, L_FAIL_CONNECT

L_FAIL_CONNECT:
    !client
    !connect_all
    !listener
    panic(10133)

L_ACCEPT:
    EXPAND NET_UNIX_ACCEPT_ADDR accept_status, server, accept_addr, listener
    accept_ok = eq accept_status, SA_NET_OK
    server_ok = ne server, 0
    accept_addr_ok = ne accept_addr, 0
    EXPAND NET_UNIX_ADDR_KIND accept_addr_kind, accept_addr
    accept_addr_kind_ok = eq accept_addr_kind, SA_NET_UNIX_ADDR_UNNAMED
    accept01 = and accept_ok, server_ok
    accept02 = and accept01, accept_addr_ok
    accept_all = and accept02, accept_addr_kind_ok
    EXPAND NET_UNIX_ADDR_FREE accept_addr_free_status, accept_addr
    accept_addr_free_ok = eq accept_addr_free_status, SA_NET_OK
    accept_done = and accept_all, accept_addr_free_ok
    !accept_addr_free_ok
    !accept_addr_free_status
    !accept_all
    !accept02
    !accept01
    !accept_addr_kind_ok
    !accept_addr_kind
    !accept_addr_ok
    !accept_addr
    !accept_status
    br accept_done -> L_KEEPALIVE, L_FAIL_ACCEPT

L_FAIL_ACCEPT:
    !accept_done
    !server
    !client
    !listener
    panic(10134)

L_KEEPALIVE:
    !accept_done
    // 在 accept 出来的 stream 上验证 keepalive setter 返回 OK。
    EXPAND NET_TCP_STREAM_SET_KEEPALIVE ka_status, server, SA_NET_SOCKET_OPTION_ENABLE
    ka_ok = eq ka_status, SA_NET_OK
    // keepalive 参数 setter：idle=60s intvl=10s cnt=5。
    EXPAND NET_TCP_STREAM_SET_KEEPALIVE_PARAMS kap_status, server, 60, 10, 5
    kap_ok = eq kap_status, SA_NET_OK
    ka_both = and ka_ok, kap_ok
    !kap_status
    !ka_status
    br ka_both -> L_WRITE, L_FAIL_IO

L_WRITE:
    // client -> server 写入。
    send_buf = stack_alloc 8
    store send_buf+0, 85 as u8
    store send_buf+1, 68 as u8
    store send_buf+2, 83 as u8
    store send_buf+3, 33 as u8
    EXPAND NET_TCP_STREAM_WRITE write_status, write_len, client, send_buf, 4
    write_ok = eq write_status, SA_NET_OK
    wrote_4 = eq write_len, 4
    write_all = and write_ok, wrote_4
    !write_status
    !write_len
    br write_all -> L_READ, L_FAIL_IO

L_READ:
    recv_buf = stack_alloc 16
    EXPAND NET_TCP_STREAM_READ read_status, read_len, server, recv_buf, 16
    read_ok = eq read_status, SA_NET_OK
    read_4 = eq read_len, 4
    b0 = load recv_buf+0 as u8
    b3 = load recv_buf+3 as u8
    b0_ok = eq b0, 85
    b3_ok = eq b3, 33
    io01 = and read_ok, read_4
    io02 = and io01, b0_ok
    io_all = and io02, b3_ok
    !read_status
    !read_len
    !b0
    !b3
    br io_all -> L_CLOSE, L_FAIL_IO

L_FAIL_IO:
    !server
    !client
    !listener
    panic(10135)

L_CLOSE:
    EXPAND NET_TCP_STREAM_CLOSE close_client, client
    EXPAND NET_TCP_STREAM_CLOSE close_server, server
    EXPAND NET_TCP_LISTENER_CLOSE close_listener, listener
    !close_listener
    !close_server
    !close_client
    return 0

@test "sa_std net unix pair and unnamed addresses"():
L_PAIR_ENTRY:
    EXPAND NET_UNIX_PAIR pair_status, left, right
    pair_status_ok = eq pair_status, SA_NET_OK
    left_ok = ne left, 0
    right_ok = ne right, 0
    pair01 = and pair_status_ok, left_ok
    pair_all = and pair01, right_ok
    !pair01
    !right_ok
    !left_ok
    !pair_status_ok
    !pair_status
    br pair_all -> L_PAIR_STREAM_OPTIONS, L_PAIR_FAIL_PAIR

L_PAIR_FAIL_PAIR:
    !pair_all
    !right
    !left
    panic(10136)

L_PAIR_STREAM_OPTIONS:
    EXPAND NET_UNIX_STREAM_SET_READ_TIMEOUT pair_set_read_timeout_status, left, UDS_TEST_TIMEOUT_NS
    EXPAND NET_UNIX_STREAM_SET_WRITE_TIMEOUT pair_set_write_timeout_status, right, UDS_TEST_TIMEOUT_NS
    EXPAND NET_UNIX_STREAM_SET_NONBLOCKING pair_nonblock_status, left, SA_NET_SOCKET_OPTION_DISABLE
    EXPAND NET_UNIX_STREAM_READ_TIMEOUT pair_read_timeout_status, pair_read_timeout_ns, left
    EXPAND NET_UNIX_STREAM_WRITE_TIMEOUT pair_write_timeout_status, pair_write_timeout_ns, right
    EXPAND NET_UNIX_STREAM_TAKE_ERROR pair_error_status, pair_error, left
    pair_set_read_timeout_ok = eq pair_set_read_timeout_status, SA_NET_OK
    pair_set_write_timeout_ok = eq pair_set_write_timeout_status, SA_NET_OK
    pair_nonblock_ok = eq pair_nonblock_status, SA_NET_OK
    pair_read_timeout_status_ok = eq pair_read_timeout_status, SA_NET_OK
    pair_read_timeout_ok = eq pair_read_timeout_ns, UDS_TEST_TIMEOUT_NS
    pair_write_timeout_status_ok = eq pair_write_timeout_status, SA_NET_OK
    pair_write_timeout_ok = eq pair_write_timeout_ns, UDS_TEST_TIMEOUT_NS
    pair_error_status_ok = eq pair_error_status, SA_NET_OK
    pair_error_ok = eq pair_error, 0
    pair_option01 = and pair_set_read_timeout_ok, pair_set_write_timeout_ok
    pair_option02 = and pair_option01, pair_nonblock_ok
    pair_option03 = and pair_option02, pair_read_timeout_status_ok
    pair_option04 = and pair_option03, pair_read_timeout_ok
    pair_option05 = and pair_option04, pair_write_timeout_status_ok
    pair_option06 = and pair_option05, pair_write_timeout_ok
    pair_option07 = and pair_option06, pair_error_status_ok
    pair_options_ok = and pair_option07, pair_error_ok
    br pair_options_ok -> L_PAIR_STREAM_CLONE, L_PAIR_FAIL_STREAM_OPTIONS

L_PAIR_FAIL_STREAM_OPTIONS:
    !pair_options_ok
    !pair_option07
    !pair_option06
    !pair_option05
    !pair_option04
    !pair_option03
    !pair_option02
    !pair_option01
    !pair_error_ok
    !pair_error_status_ok
    !pair_write_timeout_ok
    !pair_write_timeout_status_ok
    !pair_read_timeout_ok
    !pair_read_timeout_status_ok
    !pair_nonblock_ok
    !pair_set_write_timeout_ok
    !pair_set_read_timeout_ok
    !pair_error
    !pair_error_status
    !pair_write_timeout_ns
    !pair_write_timeout_status
    !pair_read_timeout_ns
    !pair_read_timeout_status
    !pair_nonblock_status
    !pair_set_write_timeout_status
    !pair_set_read_timeout_status
    !pair_all
    !right
    !left
    panic(10137)

L_PAIR_STREAM_CLONE:
    !pair_options_ok
    !pair_option07
    !pair_option06
    !pair_option05
    !pair_option04
    !pair_option03
    !pair_option02
    !pair_option01
    !pair_error_ok
    !pair_error_status_ok
    !pair_write_timeout_ok
    !pair_write_timeout_status_ok
    !pair_read_timeout_ok
    !pair_read_timeout_status_ok
    !pair_nonblock_ok
    !pair_set_write_timeout_ok
    !pair_set_read_timeout_ok
    !pair_error
    !pair_error_status
    !pair_write_timeout_ns
    !pair_write_timeout_status
    !pair_read_timeout_ns
    !pair_read_timeout_status
    !pair_nonblock_status
    !pair_set_write_timeout_status
    !pair_set_read_timeout_status
    EXPAND NET_UNIX_STREAM_TRY_CLONE pair_clone_status, pair_left_clone, left
    pair_clone_status_ok = eq pair_clone_status, SA_NET_OK
    pair_clone_handle_ok = ne pair_left_clone, 0
    pair_clone_ready = and pair_clone_status_ok, pair_clone_handle_ok
    br pair_clone_ready -> L_PAIR_CLONE_OWNED, L_PAIR_FAIL_STREAM_CLONE

L_PAIR_FAIL_STREAM_CLONE:
    !pair_clone_ready
    !pair_clone_handle_ok
    !pair_clone_status_ok
    !pair_left_clone
    !pair_clone_status
    !pair_all
    !right
    !left
    panic(986)

L_PAIR_CLONE_OWNED:
    EXPAND NET_UNIX_STREAM_INTO_OWNED_FD pair_clone_into_owned_status, pair_clone_owned_fd, pair_left_clone
    pair_clone_into_owned_status_ok = eq pair_clone_into_owned_status, SA_NET_OK
    pair_clone_owned_fd_ok = ne pair_clone_owned_fd, 0
    pair_clone_into_owned_ok = and pair_clone_into_owned_status_ok, pair_clone_owned_fd_ok
    br pair_clone_into_owned_ok -> L_PAIR_CLONE_FROM_OWNED, L_PAIR_FAIL_CLONE_INTO_OWNED

L_PAIR_FAIL_CLONE_INTO_OWNED:
    !pair_clone_into_owned_ok
    !pair_clone_owned_fd_ok
    !pair_clone_into_owned_status_ok
    !pair_clone_owned_fd
    !pair_clone_into_owned_status
    !pair_clone_ready
    !pair_all
    !right
    !left
    panic(10138)

L_PAIR_CLONE_FROM_OWNED:
    EXPAND NET_UNIX_STREAM_FROM_OWNED_FD pair_clone_from_owned_status, pair_left_clone, pair_clone_owned_fd
    pair_clone_from_owned_status_ok = eq pair_clone_from_owned_status, SA_NET_OK
    pair_clone_from_owned_handle_ok = ne pair_left_clone, 0
    pair_clone_from_owned_ok = and pair_clone_from_owned_status_ok, pair_clone_from_owned_handle_ok
    br pair_clone_from_owned_ok -> L_PAIR_CLONE_WRITE, L_PAIR_FAIL_CLONE_FROM_OWNED

L_PAIR_FAIL_CLONE_FROM_OWNED:
    !pair_clone_from_owned_ok
    !pair_clone_from_owned_handle_ok
    !pair_clone_from_owned_status_ok
    !pair_left_clone
    !pair_clone_from_owned_status
    !pair_clone_into_owned_ok
    !pair_clone_ready
    !pair_all
    !right
    !left
    panic(10139)

L_PAIR_CLONE_WRITE:
    EXPAND NET_UNIX_STREAM_AS_RAW_FD pair_clone_raw_status, pair_clone_raw_fd, pair_left_clone
    pair_clone_raw_status_ok = eq pair_clone_raw_status, SA_NET_OK
    pair_clone_raw_fd_ok = ne pair_clone_raw_fd, -1
    pair_clone_raw_ok = and pair_clone_raw_status_ok, pair_clone_raw_fd_ok
    br pair_clone_raw_ok -> L_PAIR_CLONE_INTO_RAW, L_PAIR_FAIL_CLONE_RAW

L_PAIR_FAIL_CLONE_RAW:
    !pair_clone_raw_ok
    !pair_clone_raw_fd_ok
    !pair_clone_raw_status_ok
    !pair_clone_raw_fd
    !pair_clone_raw_status
    !pair_clone_from_owned_ok
    !pair_clone_ready
    !pair_left_clone
    !pair_all
    !right
    !left
    panic(10140)

L_PAIR_CLONE_INTO_RAW:
    EXPAND NET_UNIX_STREAM_INTO_RAW_FD pair_clone_into_raw_status, pair_clone_raw_taken, pair_left_clone
    pair_clone_into_raw_ok = eq pair_clone_into_raw_status, SA_NET_OK
    pair_clone_raw_match = eq pair_clone_raw_taken, pair_clone_raw_fd
    pair_clone_take_ok = and pair_clone_into_raw_ok, pair_clone_raw_match
    br pair_clone_take_ok -> L_PAIR_CLONE_FROM_RAW, L_PAIR_FAIL_CLONE_INTO_RAW

L_PAIR_FAIL_CLONE_INTO_RAW:
    !pair_clone_take_ok
    !pair_clone_raw_match
    !pair_clone_into_raw_ok
    !pair_clone_raw_taken
    !pair_clone_into_raw_status
    !pair_clone_raw_ok
    !pair_clone_from_owned_ok
    !pair_clone_ready
    !pair_all
    !right
    !left
    panic(999)

L_PAIR_CLONE_FROM_RAW:
    EXPAND NET_UNIX_STREAM_FROM_RAW_FD pair_clone_from_raw_status, pair_left_clone, pair_clone_raw_taken
    pair_clone_from_raw_status_ok = eq pair_clone_from_raw_status, SA_NET_OK
    pair_clone_from_raw_handle_ok = ne pair_left_clone, 0
    pair_clone_from_raw_ok = and pair_clone_from_raw_status_ok, pair_clone_from_raw_handle_ok
    br pair_clone_from_raw_ok -> L_PAIR_CLONE_WRITE_DONE, L_PAIR_FAIL_CLONE_FROM_RAW

