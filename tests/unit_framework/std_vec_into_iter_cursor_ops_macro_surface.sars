@import "sa_std/vec.sars"

@test "sa_std vec into_iter cursor ops macro surface"():
L_ENTRY:
    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 1
    EXPAND VEC_PUSH_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 3
    EXPAND VEC_PUSH_U64 vec, 4
    EXPAND VEC_PUSH_U64 vec, 5
    EXPAND VEC_PUSH_U64 vec, 6

    EXPAND VEC_INTO_ITER_U64 iter, backing_vec, vec
    EXPAND VEC_INTO_ITER_NEXT_U64 next_ok, next_value, iter
    EXPAND VEC_INTO_ITER_NTH_U64 nth_ok, nth_value, iter, 1
    EXPAND VEC_INTO_ITER_NEXT_BACK_U64 back_ok, back_value, iter
    EXPAND VEC_INTO_ITER_NTH_BACK_U64 nth_back_ok, nth_back_value, iter, 0
    EXPAND VEC_INTO_ITER_ADVANCE_BY adv_ok, adv_remaining, iter, 1
    EXPAND VEC_INTO_ITER_NEXT_U64 done_ok, done_value, iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_adv, iter

    EXPAND VEC_NEW last_vec
    EXPAND VEC_PUSH_U64 last_vec, 10
    EXPAND VEC_PUSH_U64 last_vec, 20
    EXPAND VEC_PUSH_U64 last_vec, 30
    EXPAND VEC_PUSH_U64 last_vec, 40
    EXPAND VEC_INTO_ITER_U64 last_iter, last_backing, last_vec
    EXPAND VEC_INTO_ITER_ADVANCE_BACK_BY adv_back_ok, adv_back_remaining, last_iter, 1
    EXPAND VEC_INTO_ITER_LAST_U64 last_ok, last_value, last_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_last, last_iter

    EXPAND VEC_NEW count_vec
    EXPAND VEC_PUSH_U64 count_vec, 7
    EXPAND VEC_PUSH_U64 count_vec, 8
    EXPAND VEC_PUSH_U64 count_vec, 9
    EXPAND VEC_INTO_ITER_U64 count_iter, count_backing, count_vec
    EXPAND VEC_INTO_ITER_COUNT_U64 count_value, count_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_count, count_iter

    EXPAND VEC_NEW short_vec
    EXPAND VEC_PUSH_U64 short_vec, 100
    EXPAND VEC_PUSH_U64 short_vec, 200
    EXPAND VEC_INTO_ITER_U64 short_iter, short_backing, short_vec
    EXPAND VEC_INTO_ITER_ADVANCE_BY short_ok, short_remaining, short_iter, 5
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_short, short_iter

    EXPAND VEC_NEW short_back_vec
    EXPAND VEC_PUSH_U64 short_back_vec, 300
    EXPAND VEC_PUSH_U64 short_back_vec, 400
    EXPAND VEC_INTO_ITER_U64 short_back_iter, short_backing_vec, short_back_vec
    EXPAND VEC_INTO_ITER_ADVANCE_BACK_BY short_back_ok, short_back_remaining, short_back_iter, 5
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 len_after_short_back, short_back_iter

    EXPAND VEC_FREE backing_vec
    EXPAND VEC_FREE last_backing
    EXPAND VEC_FREE count_backing
    EXPAND VEC_FREE short_backing
    EXPAND VEC_FREE short_backing_vec

    ok_next_flag = eq next_ok, 1
    ok_next_value = eq next_value, 1
    ok_nth_flag = eq nth_ok, 1
    ok_nth_value = eq nth_value, 3
    ok_back_flag = eq back_ok, 1
    ok_back_value = eq back_value, 6
    ok_nth_back_flag = eq nth_back_ok, 1
    ok_nth_back_value = eq nth_back_value, 5
    ok_adv_flag = eq adv_ok, 1
    ok_adv_remaining = eq adv_remaining, 0
    ok_done_flag = eq done_ok, 0
    ok_done_value = eq done_value, 0
    ok_len_after_adv = eq len_after_adv, 0
    ok_adv_back_flag = eq adv_back_ok, 1
    ok_adv_back_remaining = eq adv_back_remaining, 0
    ok_last_flag = eq last_ok, 1
    ok_last_value = eq last_value, 30
    ok_len_after_last = eq len_after_last, 0
    ok_count_value = eq count_value, 3
    ok_len_after_count = eq len_after_count, 0
    ok_short_flag = eq short_ok, 0
    ok_short_remaining = eq short_remaining, 3
    ok_len_after_short = eq len_after_short, 0
    ok_short_back_flag = eq short_back_ok, 0
    ok_short_back_remaining = eq short_back_remaining, 3
    ok_len_after_short_back = eq len_after_short_back, 0

    ok = and ok_next_flag, ok_next_value
    ok = and ok, ok_nth_flag
    ok = and ok, ok_nth_value
    ok = and ok, ok_back_flag
    ok = and ok, ok_back_value
    ok = and ok, ok_nth_back_flag
    ok = and ok, ok_nth_back_value
    ok = and ok, ok_adv_flag
    ok = and ok, ok_adv_remaining
    ok = and ok, ok_done_flag
    ok = and ok, ok_done_value
    ok = and ok, ok_len_after_adv
    ok = and ok, ok_adv_back_flag
    ok = and ok, ok_adv_back_remaining
    ok = and ok, ok_last_flag
    ok = and ok, ok_last_value
    ok = and ok, ok_len_after_last
    ok = and ok, ok_count_value
    ok = and ok, ok_len_after_count
    ok = and ok, ok_short_flag
    ok = and ok, ok_short_remaining
    ok = and ok, ok_len_after_short
    ok = and ok, ok_short_back_flag
    ok = and ok, ok_short_back_remaining
    ok = and ok, ok_len_after_short_back

    !next_ok
    !next_value
    !nth_ok
    !nth_value
    !back_ok
    !back_value
    !nth_back_ok
    !nth_back_value
    !adv_ok
    !adv_remaining
    !done_ok
    !done_value
    !len_after_adv
    !adv_back_ok
    !adv_back_remaining
    !last_ok
    !last_value
    !len_after_last
    !count_value
    !len_after_count
    !short_ok
    !short_remaining
    !len_after_short
    !short_back_ok
    !short_back_remaining
    !len_after_short_back
    !ok_next_flag
    !ok_next_value
    !ok_nth_flag
    !ok_nth_value
    !ok_back_flag
    !ok_back_value
    !ok_nth_back_flag
    !ok_nth_back_value
    !ok_adv_flag
    !ok_adv_remaining
    !ok_done_flag
    !ok_done_value
    !ok_len_after_adv
    !ok_adv_back_flag
    !ok_adv_back_remaining
    !ok_last_flag
    !ok_last_value
    !ok_len_after_last
    !ok_count_value
    !ok_len_after_count
    !ok_short_flag
    !ok_short_remaining
    !ok_len_after_short
    !ok_short_back_flag
    !ok_short_back_remaining
    !ok_len_after_short_back
    !iter
    !last_iter
    !count_iter
    !short_iter
    !short_back_iter
    br ok -> L_VEC_INTO_ITER_CURSOR_OPS_OK, L_VEC_INTO_ITER_CURSOR_OPS_FAIL

L_VEC_INTO_ITER_CURSOR_OPS_FAIL:
    !ok
    panic(10712)

L_VEC_INTO_ITER_CURSOR_OPS_OK:
    !ok
    return
