@import "sa_std/sync/mpsc.sars"

@test "sa_std mpsc unbounded channel alias"():
L_ENTRY:
    EXPAND MPSC_UNBOUNDED tx, rx
    EXPAND MPSC_TX_TRY_SEND s, tx, 9
    EXPAND MPSC_RX_TRY_RECV r_ok, r, rx
    EXPAND MPSC_CHANNEL_FREE tx, rx
    a = eq s, 1
    b = eq r_ok, 1
    c = eq r, 9
    ok01 = and a, b
    ok = and ok01, c
    !s
    !r_ok
    !r
    !a
    !b
    !c
    !ok01
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10888)
