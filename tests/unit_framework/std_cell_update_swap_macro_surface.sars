@import "sa_std/core/cell.sars"

@cell_add_ten(v: i32) -> i32:
L_ENTRY:
    out = add v, 10
    !v
    return out

@test "sa_std cell update and swap"():
L_ENTRY:
    EXPAND CELL_NEW_VALUE a, 5
    EXPAND CELL_NEW_VALUE b, 7
    EXPAND CELL_UPDATE old, a, @cell_add_ten
    EXPAND CELL_GET a_after, a
    EXPAND CELL_SWAP a, b
    EXPAND CELL_GET a2, a
    EXPAND CELL_GET b2, b

    ok_old = eq old, 5
    ok_a = eq a_after, 15
    ok_a2 = eq a2, 7
    ok_b2 = eq b2, 15
    ok01 = and ok_old, ok_a
    ok02 = and ok01, ok_a2
    ok = and ok02, ok_b2
    !old
    !a_after
    !a2
    !b2
    !ok_old
    !ok_a
    !ok_a2
    !ok_b2
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10882)
