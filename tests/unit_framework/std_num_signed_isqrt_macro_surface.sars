@import "sa_std/num.sars"

@test "sa_std signed isqrt macro surface"():
L_ENTRY:
    EXPAND NUM_I8_ISQRT sqrt_i8, NUM_I8_MAX
    EXPAND NUM_I16_ISQRT sqrt_i16, NUM_I16_MAX
    EXPAND NUM_I32_ISQRT sqrt_i32, NUM_I32_MAX
    EXPAND NUM_I64_ISQRT sqrt_i64, NUM_I64_MAX
    EXPAND NUM_ISIZE_ISQRT sqrt_isize, 10

    ok_value_01 = eq sqrt_i8, 11
    ok_value_02 = eq sqrt_i16, 181
    ok_value_03 = eq sqrt_i32, 46340
    ok_value_04 = eq sqrt_i64, 3037000499
    ok_value_05 = eq sqrt_isize, 3

    ok_01 = and ok_value_01, ok_value_02
    ok_02 = and ok_01, ok_value_03
    ok_03 = and ok_02, ok_value_04
    ok = and ok_03, ok_value_05
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10631)

L_PASS:
    !ok
    return 0

@test should_panic "sa_std i8 isqrt panics on negative input"():
L_ENTRY:
    EXPAND NUM_I8_ISQRT sqrt_i8, -1
    !sqrt_i8
    return 0

@test should_panic "sa_std i16 isqrt panics on negative input"():
L_ENTRY:
    EXPAND NUM_I16_ISQRT sqrt_i16, -1
    !sqrt_i16
    return 0

@test should_panic "sa_std i32 isqrt panics on negative input"():
L_ENTRY:
    EXPAND NUM_I32_ISQRT sqrt_i32, -1
    !sqrt_i32
    return 0

@test should_panic "sa_std i64 isqrt panics on negative input"():
L_ENTRY:
    EXPAND NUM_I64_ISQRT sqrt_i64, -1
    !sqrt_i64
    return 0

@test should_panic "sa_std isize isqrt panics on negative input"():
L_ENTRY:
    EXPAND NUM_ISIZE_ISQRT sqrt_isize, -1
    !sqrt_isize
    return 0
