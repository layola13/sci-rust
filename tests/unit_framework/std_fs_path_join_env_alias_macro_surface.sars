@import "sa_std/path.sars"
@import "sa_std/string.sars"

@const PATH_BASE = utf8:"/tmp/sa"
@const PATH_BASE_SLASH = utf8:"/tmp/sa/"
@const PATH_CHILD = utf8:"child"
@const PATH_ABS_CHILD = utf8:"/var/log"
@const EXPECT_JOINED = utf8:"/tmp/sa/child"

#def PATH_BASE_LEN = 7
#def PATH_BASE_SLASH_LEN = 8
#def PATH_CHILD_LEN = 5
#def PATH_ABS_CHILD_LEN = 8
#def EXPECT_JOINED_LEN = 13

@test "sa_std path_join alias macro surface"():
L_ENTRY:
    EXPAND STR_FROM_PARTS base, &PATH_BASE, PATH_BASE_LEN
    EXPAND STR_FROM_PARTS base_slash, &PATH_BASE_SLASH, PATH_BASE_SLASH_LEN
    EXPAND STR_FROM_PARTS child, &PATH_CHILD, PATH_CHILD_LEN
    EXPAND STR_FROM_PARTS abs_child, &PATH_ABS_CHILD, PATH_ABS_CHILD_LEN
    EXPAND STR_FROM_PARTS expect_joined, &EXPECT_JOINED, EXPECT_JOINED_LEN
    EXPAND PATH_MAKE_EMPTY empty_base

    EXPAND PATH_JOIN joined, base, child
    EXPAND PATH_JOIN joined_slash, base_slash, child
    EXPAND PATH_JOIN joined_abs, base, abs_child
    EXPAND PATH_JOIN joined_empty, empty_base, child

    EXPAND STR_EQ joined_eq, joined, expect_joined
    EXPAND STR_EQ joined_slash_eq, joined_slash, expect_joined
    EXPAND STR_EQ joined_abs_eq, joined_abs, abs_child
    EXPAND STR_EQ joined_empty_eq, joined_empty, child

    EXPAND PATH_IS_ABSOLUTE abs_flag, joined
    EXPAND PATH_IS_RELATIVE rel_flag, child
    EXPAND PATH_ENDS_WITH ends_child, joined, child
    EXPAND PATH_STARTS_WITH starts_tmp, joined, base

    ok_join = eq joined_eq, 1
    ok_slash = eq joined_slash_eq, 1
    ok_abs_join = eq joined_abs_eq, 1
    ok_empty = eq joined_empty_eq, 1
    ok_abs = eq abs_flag, 1
    ok_rel = eq rel_flag, 1
    ok_ends = eq ends_child, 1
    ok_starts = eq starts_tmp, 1

    ok01 = and ok_join, ok_slash
    ok02 = and ok01, ok_abs_join
    ok03 = and ok02, ok_empty
    ok04 = and ok03, ok_abs
    ok05 = and ok04, ok_rel
    ok06 = and ok05, ok_ends
    ok = and ok06, ok_starts

    !base
    !base_slash
    !child
    !abs_child
    !expect_joined
    !empty_base
    !joined
    !joined_slash
    !joined_abs
    !joined_empty
    !joined_eq
    !joined_slash_eq
    !joined_abs_eq
    !joined_empty_eq
    !abs_flag
    !rel_flag
    !ends_child
    !starts_tmp
    !ok_join
    !ok_slash
    !ok_abs_join
    !ok_empty
    !ok_abs
    !ok_rel
    !ok_ends
    !ok_starts
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10860)
