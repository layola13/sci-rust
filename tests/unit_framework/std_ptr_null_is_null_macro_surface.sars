@import "sa_std/ptr.sars"

@test "sa_std ptr null is_null"():
L_ENTRY:
    EXPAND PTR_NULL n
    EXPAND PTR_IS_NULL isn, n
    p = stack_alloc 8
    EXPAND PTR_IS_NULL isp, p
    a = eq isn, 1
    b = eq isp, 0
    ok = and a, b
    !n
    !isn
    !isp
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10962)
