@import "sa_std/option.sars"
@import "sa_std/result.sars"

@const EXPECT_SHOULD_BE_SOME = utf8:"option should be some"
@const EXPECT_SHOULD_BE_OK = utf8:"result should be ok"
@const EXPECT_SHOULD_BE_ERR = utf8:"result should be err"

@opt_double(value: u64) -> u64:
L_ENTRY:
    out = mul value, 2
    return out

@opt_gt_five(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 5
    return out

@opt_default_value() -> u64:
L_ENTRY:
    return 77

@opt_default_option() -> ptr:
L_ENTRY:
    opt = alloc Option_SIZE
    EXPAND OPTION_SET_SOME opt, 44
    return opt

@opt_then_some(value: u64) -> ptr:
L_ENTRY:
    opt = alloc Option_SIZE
    doubled = mul value, 2
    EXPAND OPTION_SET_SOME opt, doubled
    !doubled
    return opt

@opt_err_value() -> u64:
L_ENTRY:
    return 91

@res_err_plus(value: u64) -> u64:
L_ENTRY:
    out = add value, 100
    return out

@res_then_ok(value: u64) -> ptr:
L_ENTRY:
    res = alloc Result_SIZE
    out = add value, 9
    EXPAND RESULT_SET_OK res, out
    !out
    return res

@res_else_ok(err: u64) -> ptr:
L_ENTRY:
    res = alloc Result_SIZE
    out = add err, 1
    EXPAND RESULT_SET_OK res, out
    !out
    return res

@test "sa_std option rust-style combinator macros"():
L_ENTRY:
    some = alloc Option_SIZE
    none = alloc Option_SIZE
    other = alloc Option_SIZE
    small = alloc Option_SIZE
    take_src = alloc Option_SIZE
    take_if_keep_src = alloc Option_SIZE
    take_if_drop_src = alloc Option_SIZE
    take_if_none_src = alloc Option_SIZE
    replace_none_src = alloc Option_SIZE
    replace_some_src = alloc Option_SIZE
    insert_src = alloc Option_SIZE
    get_or_some_src = alloc Option_SIZE
    get_or_none_src = alloc Option_SIZE
    get_or_with_src = alloc Option_SIZE
    get_or_default_src = alloc Option_SIZE
    slice_some_src = alloc Option_SIZE
    slice_none_src = alloc Option_SIZE
    EXPAND OPTION_SET_SOME some, 8
    EXPAND OPTION_SET_NONE none
    EXPAND OPTION_SET_SOME other, 21
    EXPAND OPTION_SET_SOME small, 3
    EXPAND OPTION_SET_SOME take_src, 55
    EXPAND OPTION_SET_SOME take_if_keep_src, 9
    EXPAND OPTION_SET_SOME take_if_drop_src, 3
    EXPAND OPTION_SET_NONE take_if_none_src
    EXPAND OPTION_SET_NONE replace_none_src
    EXPAND OPTION_SET_SOME replace_some_src, 67
    EXPAND OPTION_SET_SOME insert_src, 1
    EXPAND OPTION_SET_SOME get_or_some_src, 71
    EXPAND OPTION_SET_NONE get_or_none_src
    EXPAND OPTION_SET_NONE get_or_with_src
    EXPAND OPTION_SET_NONE get_or_default_src
    EXPAND OPTION_SET_SOME slice_some_src, 88
    EXPAND OPTION_SET_NONE slice_none_src

    EXPAND OPTION_COPY copy_some, some
    EXPAND OPTION_MAP mapped_some, some, @opt_double
    EXPAND OPTION_MAP mapped_none, none, @opt_double
    EXPAND OPTION_FILTER filter_keep, some, @opt_gt_five
    EXPAND OPTION_FILTER filter_drop, other, @opt_gt_five
    EXPAND OPTION_CONTAINS_U64 contains_8, some, 8
    EXPAND OPTION_CONTAINS_U64 contains_9, some, 9
    EXPAND OPTION_IS_SOME_AND some_and_true, some, @opt_gt_five
    EXPAND OPTION_IS_SOME_AND none_and_false, none, @opt_gt_five
    EXPAND OPTION_IS_NONE_OR some_none_or_true, some, @opt_gt_five
    EXPAND OPTION_IS_NONE_OR none_none_or_true, none, @opt_gt_five
    EXPAND OPTION_IS_NONE_OR small_none_or_false, small, @opt_gt_five
    EXPAND OPTION_UNWRAP_OR_ELSE unwrap_else_some, some, @opt_default_value
    EXPAND OPTION_UNWRAP_OR_ELSE unwrap_else_none, none, @opt_default_value
    EXPAND OPTION_UNWRAP_OR_DEFAULT unwrap_default_some, some
    EXPAND OPTION_UNWRAP_OR_DEFAULT unwrap_default_none, none
    EXPAND OPTION_INSPECT inspect_some, some, @opt_double
    EXPAND OPTION_INSPECT inspect_none, none, @opt_double
    EXPAND OPTION_TAKE taken, take_src
    EXPAND OPTION_TAKE_IF take_if_keep, take_if_keep_src, @opt_gt_five
    EXPAND OPTION_TAKE_IF take_if_drop, take_if_drop_src, @opt_gt_five
    EXPAND OPTION_TAKE_IF take_if_none, take_if_none_src, @opt_gt_five
    EXPAND OPTION_REPLACE replaced_none_old, replace_none_src, 66
    EXPAND OPTION_REPLACE replaced_some_old, replace_some_src, 68
    EXPAND OPTION_INSERT insert_ptr, insert_src, 77
    store insert_ptr+0, 78 as u64
    EXPAND OPTION_GET_OR_INSERT get_or_some_ptr, get_or_some_src, 72
    store get_or_some_ptr+0, 73 as u64
    EXPAND OPTION_GET_OR_INSERT get_or_none_ptr, get_or_none_src, 74
    store get_or_none_ptr+0, 75 as u64
    EXPAND OPTION_GET_OR_INSERT_WITH get_or_with_ptr, get_or_with_src, @opt_default_value
    store get_or_with_ptr+0, 79 as u64
    EXPAND OPTION_GET_OR_INSERT_DEFAULT get_or_default_ptr, get_or_default_src
    store get_or_default_ptr+0, 80 as u64
    EXPAND OPTION_AS_SLICE option_slice_some, slice_some_src
    EXPAND OPTION_AS_SLICE option_slice_none, slice_none_src
    EXPAND OPTION_AS_MUT_SLICE option_mut_slice, slice_some_src
    option_mut_ptr = load option_mut_slice+Slice_ptr as ptr
    store option_mut_ptr+0, 89 as u64
    EXPAND OPTION_AND and_some, some, other
    EXPAND OPTION_AND and_none, none, other
    EXPAND OPTION_OR or_some, some, other
    EXPAND OPTION_OR or_other, none, other
    EXPAND OPTION_XOR xor_left, some, none
    EXPAND OPTION_XOR xor_none, some, other
    EXPAND OPTION_AND_THEN then_some, some, @opt_then_some
    EXPAND OPTION_AND_THEN then_none, none, @opt_then_some
    EXPAND OPTION_OR_ELSE or_else_some, some, @opt_default_option
    EXPAND OPTION_OR_ELSE or_else_default, none, @opt_default_option
    EXPAND OPTION_OK_OR ok_or_some, some, 90
    EXPAND OPTION_OK_OR ok_or_none, none, 90
    EXPAND OPTION_OK_OR_ELSE ok_or_else_some, some, @opt_err_value
    EXPAND OPTION_OK_OR_ELSE ok_or_else_none, none, @opt_err_value

    copy_tag = load copy_some+Option_tag as u64
    copy_value = load copy_some+Option_value as u64
    mapped_some_tag = load mapped_some+Option_tag as u64
    mapped_some_value = load mapped_some+Option_value as u64
    mapped_none_tag = load mapped_none+Option_tag as u64
    filter_keep_tag = load filter_keep+Option_tag as u64
    filter_keep_value = load filter_keep+Option_value as u64
    filter_drop_tag = load filter_drop+Option_tag as u64
    and_some_value = load and_some+Option_value as u64
    and_none_tag = load and_none+Option_tag as u64
    or_some_value = load or_some+Option_value as u64
    or_other_value = load or_other+Option_value as u64
    xor_left_tag = load xor_left+Option_tag as u64
    xor_left_value = load xor_left+Option_value as u64
    xor_none_tag = load xor_none+Option_tag as u64
    then_some_value = load then_some+Option_value as u64
    then_none_tag = load then_none+Option_tag as u64
    or_else_some_value = load or_else_some+Option_value as u64
    or_else_default_value = load or_else_default+Option_value as u64
    ok_or_some_tag = load ok_or_some+Result_tag as u64
    ok_or_some_value = load ok_or_some+Result_ok as u64
    ok_or_none_tag = load ok_or_none+Result_tag as u64
    ok_or_none_err = load ok_or_none+Result_err as u64
    ok_or_else_some_tag = load ok_or_else_some+Result_tag as u64
