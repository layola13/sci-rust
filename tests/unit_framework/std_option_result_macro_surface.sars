    ok51 = eq take_if_keep_tag, Option_SOME
    ok52 = eq take_if_keep_value, 9
    ok53 = eq take_if_keep_src_tag, Option_NONE
    ok54 = eq take_if_drop_tag, Option_NONE
    ok55 = eq take_if_drop_src_tag, Option_SOME
    ok56 = eq take_if_drop_src_value, 3
    ok57 = eq take_if_none_tag, Option_NONE
    ok58 = eq insert_src_value, 78
    ok59 = eq get_or_some_src_value, 73
    ok60 = eq get_or_none_src_tag, Option_SOME
    ok61 = eq get_or_none_src_value, 75
    ok62 = eq get_or_with_src_value, 79
    ok63 = eq get_or_default_src_value, 80
    ok64 = eq option_slice_some_len, 1
    ok65 = eq option_slice_some_value, 89
    ok66 = eq option_slice_none_len, 0
    ok67 = eq option_mut_slice_len, 1
    ok68 = eq slice_some_src_value, 89

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
