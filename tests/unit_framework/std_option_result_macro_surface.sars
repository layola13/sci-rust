@test "sa_std option result expect unchecked macros"():
L_ENTRY:
    opt_some = alloc Option_SIZE
    opt_none = alloc Option_SIZE
    res_ok = alloc Result_SIZE
    res_err = alloc Result_SIZE
    EXPAND OPTION_SET_SOME opt_some, 31
    EXPAND OPTION_SET_NONE opt_none
    EXPAND RESULT_SET_OK res_ok, 41
    EXPAND RESULT_SET_ERR res_err, 51

    EXPAND OPTION_EXPECT opt_expect, opt_some, *EXPECT_SHOULD_BE_SOME, 21
    EXPAND OPTION_UNWRAP_UNCHECKED opt_unchecked, opt_some
    EXPAND RESULT_EXPECT res_expect, res_ok, *EXPECT_SHOULD_BE_OK, 19
    EXPAND RESULT_UNWRAP_UNCHECKED res_unchecked, res_ok
    EXPAND RESULT_EXPECT_ERR res_expect_err, res_err, *EXPECT_SHOULD_BE_ERR, 20
    EXPAND RESULT_UNWRAP_ERR_UNCHECKED res_err_unchecked, res_err
    EXPAND RESULT_INTO_OK res_into_ok, res_ok
    EXPAND RESULT_INTO_ERR res_into_err, res_err
    EXPAND OPTION_MAP_OR_DEFAULT opt_map_default_some, opt_some, @opt_double
    EXPAND OPTION_MAP_OR_DEFAULT opt_map_default_none, opt_none, @opt_double
    EXPAND RESULT_MAP_OR_DEFAULT res_map_default_ok, res_ok, @opt_double
    EXPAND RESULT_MAP_OR_DEFAULT res_map_default_err, res_err, @opt_double

