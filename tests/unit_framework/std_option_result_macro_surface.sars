@test "sa_std option result nested rust-style macros"():
L_ENTRY:
    inner_some = alloc Option_SIZE
    inner_none = alloc Option_SIZE
    outer_some_some = alloc Option_SIZE
    outer_some_none = alloc Option_SIZE
    outer_none = alloc Option_SIZE
    EXPAND OPTION_SET_SOME inner_some, 12
    EXPAND OPTION_SET_NONE inner_none
    store outer_some_some+Option_tag, Option_SOME as u64
    store outer_some_some+Option_value, inner_some as ptr
    store outer_some_none+Option_tag, Option_SOME as u64
    store outer_some_none+Option_value, inner_none as ptr
    EXPAND OPTION_SET_NONE outer_none

    inner_ok = alloc Result_SIZE
    inner_err = alloc Result_SIZE
    opt_res_ok = alloc Option_SIZE
    opt_res_err = alloc Option_SIZE
    opt_res_none = alloc Option_SIZE
    EXPAND RESULT_SET_OK inner_ok, 22
    EXPAND RESULT_SET_ERR inner_err, 31
    store opt_res_ok+Option_tag, Option_SOME as u64
    store opt_res_ok+Option_value, inner_ok as ptr
    store opt_res_err+Option_tag, Option_SOME as u64
    store opt_res_err+Option_value, inner_err as ptr
    EXPAND OPTION_SET_NONE opt_res_none

    flat_inner_ok = alloc Result_SIZE
    flat_inner_err = alloc Result_SIZE
    flat_outer_ok_ok = alloc Result_SIZE
    flat_outer_ok_err = alloc Result_SIZE
    flat_outer_err = alloc Result_SIZE
    EXPAND RESULT_SET_OK flat_inner_ok, 41
    EXPAND RESULT_SET_ERR flat_inner_err, 42
    store flat_outer_ok_ok+Result_tag, Result_OK as u64
    store flat_outer_ok_ok+Result_ok, flat_inner_ok as ptr
    store flat_outer_ok_ok+Result_err, 0 as u64
    store flat_outer_ok_err+Result_tag, Result_OK as u64
    store flat_outer_ok_err+Result_ok, flat_inner_err as ptr
    store flat_outer_ok_err+Result_err, 0 as u64
    EXPAND RESULT_SET_ERR flat_outer_err, 43

    trans_inner_some = alloc Option_SIZE
    trans_inner_none = alloc Option_SIZE
    res_opt_some = alloc Result_SIZE
    res_opt_none = alloc Result_SIZE
    res_opt_err = alloc Result_SIZE
    EXPAND OPTION_SET_SOME trans_inner_some, 51
    EXPAND OPTION_SET_NONE trans_inner_none
    store res_opt_some+Result_tag, Result_OK as u64
    store res_opt_some+Result_ok, trans_inner_some as ptr
    store res_opt_some+Result_err, 0 as u64
    store res_opt_none+Result_tag, Result_OK as u64
    store res_opt_none+Result_ok, trans_inner_none as ptr
    store res_opt_none+Result_err, 0 as u64
    EXPAND RESULT_SET_ERR res_opt_err, 61

    EXPAND OPTION_FLATTEN flat_some_some, outer_some_some
    EXPAND OPTION_FLATTEN flat_some_none, outer_some_none
    EXPAND OPTION_FLATTEN flat_none, outer_none
    EXPAND OPTION_TRANSPOSE trans_opt_ok, opt_res_ok
    EXPAND OPTION_TRANSPOSE trans_opt_err, opt_res_err
    EXPAND OPTION_TRANSPOSE trans_opt_none, opt_res_none
    EXPAND RESULT_FLATTEN result_flat_ok, flat_outer_ok_ok
    EXPAND RESULT_FLATTEN result_flat_inner_err, flat_outer_ok_err
    EXPAND RESULT_FLATTEN result_flat_outer_err, flat_outer_err
    EXPAND RESULT_TRANSPOSE result_trans_some, res_opt_some
    EXPAND RESULT_TRANSPOSE result_trans_none, res_opt_none
    EXPAND RESULT_TRANSPOSE result_trans_err, res_opt_err

    flat_some_some_tag = load flat_some_some+Option_tag as u64
    flat_some_some_value = load flat_some_some+Option_value as u64
    flat_some_none_tag = load flat_some_none+Option_tag as u64
    flat_none_tag = load flat_none+Option_tag as u64
    trans_opt_ok_tag = load trans_opt_ok+Result_tag as u64
    trans_opt_ok_ptr = load trans_opt_ok+Result_ok as ptr
    trans_opt_ok_option_tag = load trans_opt_ok_ptr+Option_tag as u64
    trans_opt_ok_option_value = load trans_opt_ok_ptr+Option_value as u64
    trans_opt_err_tag = load trans_opt_err+Result_tag as u64
    trans_opt_err_value = load trans_opt_err+Result_err as u64
    trans_opt_none_tag = load trans_opt_none+Result_tag as u64
    trans_opt_none_ptr = load trans_opt_none+Result_ok as ptr
    trans_opt_none_option_tag = load trans_opt_none_ptr+Option_tag as u64
    result_flat_ok_tag = load result_flat_ok+Result_tag as u64
    result_flat_ok_value = load result_flat_ok+Result_ok as u64
    result_flat_inner_err_tag = load result_flat_inner_err+Result_tag as u64
    result_flat_inner_err_value = load result_flat_inner_err+Result_err as u64
    result_flat_outer_err_tag = load result_flat_outer_err+Result_tag as u64
    result_flat_outer_err_value = load result_flat_outer_err+Result_err as u64
    result_trans_some_tag = load result_trans_some+Option_tag as u64
    result_trans_some_ptr = load result_trans_some+Option_value as ptr
    result_trans_some_result_tag = load result_trans_some_ptr+Result_tag as u64
    result_trans_some_result_value = load result_trans_some_ptr+Result_ok as u64
    result_trans_none_tag = load result_trans_none+Option_tag as u64
    result_trans_err_tag = load result_trans_err+Option_tag as u64
    result_trans_err_ptr = load result_trans_err+Option_value as ptr
    result_trans_err_result_tag = load result_trans_err_ptr+Result_tag as u64
    result_trans_err_result_value = load result_trans_err_ptr+Result_err as u64

    ok01 = eq flat_some_some_tag, Option_SOME
    ok02 = eq flat_some_some_value, 12
    ok03 = eq flat_some_none_tag, Option_NONE
    ok04 = eq flat_none_tag, Option_NONE
    ok05 = eq trans_opt_ok_tag, Result_OK
    ok06 = eq trans_opt_ok_option_tag, Option_SOME
    ok07 = eq trans_opt_ok_option_value, 22
    ok08 = eq trans_opt_err_tag, Result_ERR
    ok09 = eq trans_opt_err_value, 31
    ok10 = eq trans_opt_none_tag, Result_OK
    ok11 = eq trans_opt_none_option_tag, Option_NONE
    ok12 = eq result_flat_ok_tag, Result_OK
    ok13 = eq result_flat_ok_value, 41
    ok14 = eq result_flat_inner_err_tag, Result_ERR
    ok15 = eq result_flat_inner_err_value, 42
    ok16 = eq result_flat_outer_err_tag, Result_ERR
    ok17 = eq result_flat_outer_err_value, 43
    ok18 = eq result_trans_some_tag, Option_SOME
    ok19 = eq result_trans_some_result_tag, Result_OK
    ok20 = eq result_trans_some_result_value, 51
    ok21 = eq result_trans_none_tag, Option_NONE
    ok22 = eq result_trans_err_tag, Option_SOME
    ok23 = eq result_trans_err_result_tag, Result_ERR
    ok24 = eq result_trans_err_result_value, 61

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
