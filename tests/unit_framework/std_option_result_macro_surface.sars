    take_if_drop_src_value = load take_if_drop_src+Option_value as u64
    take_if_none_tag = load take_if_none+Option_tag as u64
    replaced_none_old_tag = load replaced_none_old+Option_tag as u64
    replace_none_src_tag = load replace_none_src+Option_tag as u64
    replace_none_src_value = load replace_none_src+Option_value as u64
    replaced_some_old_tag = load replaced_some_old+Option_tag as u64
    replaced_some_old_value = load replaced_some_old+Option_value as u64
    replace_some_src_value = load replace_some_src+Option_value as u64
    insert_src_value = load insert_src+Option_value as u64
    get_or_some_src_value = load get_or_some_src+Option_value as u64
    get_or_none_src_tag = load get_or_none_src+Option_tag as u64
    get_or_none_src_value = load get_or_none_src+Option_value as u64
    get_or_with_src_value = load get_or_with_src+Option_value as u64
    get_or_default_src_value = load get_or_default_src+Option_value as u64
    option_slice_some_len = load option_slice_some+Slice_len as u64
    option_slice_some_ptr = load option_slice_some+Slice_ptr as ptr
    option_slice_some_value = load option_slice_some_ptr+0 as u64
    option_slice_none_len = load option_slice_none+Slice_len as u64
    option_mut_slice_len = load option_mut_slice+Slice_len as u64
    slice_some_src_value = load slice_some_src+Option_value as u64
    none_and_is_false = eq none_and_false, 0
    small_none_or_is_false = eq small_none_or_false, 0
    contains_9_false = eq contains_9, 0

    ok01 = eq copy_tag, Option_SOME
    ok02 = eq copy_value, 8
    ok03 = eq mapped_some_tag, Option_SOME
    ok04 = eq mapped_some_value, 16
    ok05 = eq mapped_none_tag, Option_NONE
    ok06 = eq filter_keep_tag, Option_SOME
    ok07 = eq filter_keep_value, 8
    ok08 = eq filter_drop_tag, Option_SOME
    ok09 = eq contains_8, 1
    ok10 = eq contains_9_false, 1
    ok11 = eq some_and_true, 1
    ok12 = eq none_and_is_false, 1
    ok13 = eq and_some_value, 21
    ok14 = eq and_none_tag, Option_NONE
    ok15 = eq or_some_value, 8
    ok16 = eq or_other_value, 21
    ok17 = eq xor_left_tag, Option_SOME
    ok18 = eq xor_left_value, 8
    ok19 = eq xor_none_tag, Option_NONE
    ok20 = eq then_some_value, 16
    ok21 = eq then_none_tag, Option_NONE
    ok22 = eq or_else_some_value, 8
    ok23 = eq or_else_default_value, 44
    ok24 = eq ok_or_some_tag, Result_OK
    ok25 = eq ok_or_some_value, 8
    ok26 = eq ok_or_none_tag, Result_ERR
    ok27 = eq ok_or_none_err, 90
    ok28 = eq ok_or_else_some_tag, Result_OK
    ok29 = eq ok_or_else_some_value, 8
    ok30 = eq ok_or_else_none_tag, Result_ERR
    ok31 = eq ok_or_else_none_err, 91
    ok32 = eq some_none_or_true, 1
    ok33 = eq none_none_or_true, 1
    ok34 = eq small_none_or_is_false, 1
    ok35 = eq unwrap_else_some, 8
    ok36 = eq unwrap_else_none, 77
    ok37 = eq unwrap_default_some, 8
    ok38 = eq unwrap_default_none, 0
    ok39 = eq taken_tag, Option_SOME
    ok40 = eq taken_value, 55
    ok41 = eq take_src_tag, Option_NONE
    ok42 = eq replaced_none_old_tag, Option_NONE
    ok43 = eq replace_none_src_tag, Option_SOME
    ok44 = eq replace_none_src_value, 66
    ok45 = eq replaced_some_old_tag, Option_SOME
    ok46 = eq replaced_some_old_value, 67
    ok47 = eq replace_some_src_value, 68
