@test "sa_std result rust-style combinator macros"():
L_ENTRY:
    ok_res = alloc Result_SIZE
    err_res = alloc Result_SIZE
    other_ok = alloc Result_SIZE
    other_err = alloc Result_SIZE
    EXPAND RESULT_SET_OK ok_res, 5
    EXPAND RESULT_SET_ERR err_res, 7
    EXPAND RESULT_SET_OK other_ok, 33
    EXPAND RESULT_SET_ERR other_err, 44

    EXPAND RESULT_COPY copy_ok, ok_res
    EXPAND RESULT_IS_OK_AND ok_and_true, ok_res, @opt_gt_five
    EXPAND RESULT_IS_OK_AND err_and_false, err_res, @opt_gt_five
    EXPAND RESULT_IS_ERR_AND err_and_true, err_res, @opt_gt_five
    EXPAND RESULT_MAP mapped_ok, ok_res, @opt_double
    EXPAND RESULT_MAP mapped_err, err_res, @opt_double
    EXPAND RESULT_INSPECT inspect_ok, ok_res, @opt_double
    EXPAND RESULT_INSPECT inspect_err_skip, err_res, @opt_double
    EXPAND RESULT_INSPECT_ERR inspect_err_value, err_res, @res_err_plus
    EXPAND RESULT_INSPECT_ERR inspect_ok_skip, ok_res, @res_err_plus
    EXPAND RESULT_MAP_ERR_RESULT mapped_err_value, err_res, @res_err_plus
    EXPAND RESULT_AND and_ok, ok_res, other_ok
    EXPAND RESULT_AND and_err, err_res, other_ok
    EXPAND RESULT_OR or_ok, ok_res, other_err
    EXPAND RESULT_OR or_err, err_res, other_ok
    EXPAND RESULT_AND_THEN then_ok, ok_res, @res_then_ok
    EXPAND RESULT_AND_THEN then_err, err_res, @res_then_ok
    EXPAND RESULT_OR_ELSE else_ok, ok_res, @res_else_ok
    EXPAND RESULT_OR_ELSE else_err, err_res, @res_else_ok
    EXPAND RESULT_OK_TO_OPTION ok_to_opt, ok_res
    EXPAND RESULT_OK_TO_OPTION err_to_none, err_res
    EXPAND RESULT_ERR_TO_OPTION err_to_opt, err_res
    EXPAND RESULT_ERR_TO_OPTION ok_to_none, ok_res
    EXPAND RESULT_UNWRAP_OR_ELSE unwrap_else_ok, ok_res, @res_err_plus
    EXPAND RESULT_UNWRAP_OR_ELSE unwrap_else_err, err_res, @res_err_plus
    EXPAND RESULT_UNWRAP_OR_DEFAULT unwrap_default_ok, ok_res
    EXPAND RESULT_UNWRAP_OR_DEFAULT unwrap_default_err, err_res

