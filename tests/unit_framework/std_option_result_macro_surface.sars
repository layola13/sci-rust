@test "sa_std option result reference copy macros"():
L_ENTRY:
    opt_some = alloc Option_SIZE
    opt_none = alloc Option_SIZE
    opt_ptr_some = alloc Option_SIZE
    opt_ptr_none = alloc Option_SIZE
    opt_value_slot = stack_alloc 8
    store opt_value_slot+0, 92 as u64
    EXPAND OPTION_SET_SOME opt_some, 70
    EXPAND OPTION_SET_NONE opt_none
    store opt_ptr_some+Option_tag, Option_SOME as u64
    store opt_ptr_some+Option_value, opt_value_slot as ptr
    EXPAND OPTION_SET_NONE opt_ptr_none

    EXPAND OPTION_AS_REF opt_ref, opt_some
    opt_ref_ptr = load opt_ref+Option_value as ptr
    opt_ref_value = load opt_ref_ptr+0 as u64
    EXPAND OPTION_AS_REF opt_ref_none, opt_none
    opt_ref_none_tag = load opt_ref_none+Option_tag as u64
    EXPAND OPTION_AS_MUT opt_mut, opt_some
    opt_mut_ptr = load opt_mut+Option_value as ptr
    store opt_mut_ptr+0, 71 as u64
    opt_some_value_after_mut = load opt_some+Option_value as u64
    EXPAND OPTION_COPIED_U64 opt_copied, opt_ptr_some
    EXPAND OPTION_CLONED_U64 opt_cloned, opt_ptr_some
    EXPAND OPTION_COPIED_U64 opt_copied_none, opt_ptr_none
    opt_copied_tag = load opt_copied+Option_tag as u64
    opt_copied_value = load opt_copied+Option_value as u64
    opt_cloned_value = load opt_cloned+Option_value as u64
    opt_copied_none_tag = load opt_copied_none+Option_tag as u64

    res_ok = alloc Result_SIZE
    res_err = alloc Result_SIZE
    res_ptr_ok = alloc Result_SIZE
    res_ptr_err = alloc Result_SIZE
    res_ok_slot = stack_alloc 8
    res_err_slot = stack_alloc 8
    store res_ok_slot+0, 101 as u64
    store res_err_slot+0, 202 as u64
    EXPAND RESULT_SET_OK res_ok, 80
    EXPAND RESULT_SET_ERR res_err, 81
    store res_ptr_ok+Result_tag, Result_OK as u64
    store res_ptr_ok+Result_ok, res_ok_slot as ptr
    store res_ptr_ok+Result_err, 0 as u64
    store res_ptr_err+Result_tag, Result_ERR as u64
    store res_ptr_err+Result_ok, 0 as u64
    store res_ptr_err+Result_err, res_err_slot as ptr

    EXPAND RESULT_AS_REF res_ok_ref, res_ok
    res_ok_ref_ptr = load res_ok_ref+Result_ok as ptr
    res_ok_ref_value = load res_ok_ref_ptr+0 as u64
    EXPAND RESULT_AS_REF res_err_ref, res_err
    res_err_ref_ptr = load res_err_ref+Result_err as ptr
    res_err_ref_value = load res_err_ref_ptr+0 as u64
    EXPAND RESULT_AS_MUT res_ok_mut, res_ok
    res_ok_mut_ptr = load res_ok_mut+Result_ok as ptr
    store res_ok_mut_ptr+0, 82 as u64
    res_ok_after_mut = load res_ok+Result_ok as u64
    EXPAND RESULT_COPIED_U64 res_copied_ok, res_ptr_ok
    EXPAND RESULT_COPIED_U64 res_copied_err, res_ptr_err
    EXPAND RESULT_CLONED_U64 res_cloned_ok, res_ptr_ok
    res_copied_ok_tag = load res_copied_ok+Result_tag as u64
    res_copied_ok_value = load res_copied_ok+Result_ok as u64
    res_copied_err_tag = load res_copied_err+Result_tag as u64
    res_copied_err_value = load res_copied_err+Result_err as u64
    res_cloned_ok_value = load res_cloned_ok+Result_ok as u64

    ok01 = eq opt_ref_value, 70
    ok02 = eq opt_ref_none_tag, Option_NONE
    ok03 = eq opt_some_value_after_mut, 71
    ok04 = eq opt_copied_tag, Option_SOME
    ok05 = eq opt_copied_value, 92
    ok06 = eq opt_cloned_value, 92
    ok07 = eq opt_copied_none_tag, Option_NONE
    ok08 = eq res_ok_ref_value, 80
    ok09 = eq res_err_ref_value, 81
    ok10 = eq res_ok_after_mut, 82
    ok11 = eq res_copied_ok_tag, Result_OK
    ok12 = eq res_copied_ok_value, 101
    ok13 = eq res_copied_err_tag, Result_ERR
    ok14 = eq res_copied_err_value, 202
