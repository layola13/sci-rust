@import "sa_std/sync/barrier.sars"

@test "sa_std barrier single waiter is leader"():
L_ENTRY:
    EXPAND BARRIER_NEW barrier, 1
    EXPAND BARRIER_N n, barrier
    EXPAND BARRIER_WAIT leader, barrier
    EXPAND BARRIER_WAIT leader2, barrier

    ok_n = eq n, 1
    ok_leader = eq leader, 1
    ok_leader2 = eq leader2, 1
    ok01 = and ok_n, ok_leader
    ok = and ok01, ok_leader2

    !n
    !leader
    !leader2
    !ok_n
    !ok_leader
    !ok_leader2
    !ok01
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10865)

@test "sa_std barrier default alias"():
L_ENTRY:
    EXPAND BARRIER_DEFAULT barrier
    EXPAND BARRIER_N n, barrier
    ok = eq n, 2
    !n
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10866)
