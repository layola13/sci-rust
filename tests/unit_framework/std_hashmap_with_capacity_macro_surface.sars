@import "sa_std/collections/hashmap.sars"

@test "sa_std hashmap with_capacity"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 16
    EXPAND MAP_LEN ln, map
    EXPAND MAP_CAPACITY cap, map
    EXPAND MAP_FREE map
    a = eq ln, 0
    b = uge cap, 16
    ok = and a, b
    !ln
    !cap
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10953)
