@import "sa_std/net.sars"

@const NET_TIMEOUT_ALL_HOST = utf8:"localhost"

@test "sa_std TCP connect timeout all validates duration and output handle"():
L_ENTRY:
    EXPAND NET_TCP_CONNECT_TIMEOUT_ALL status, stream, NET_TIMEOUT_ALL_HOST, 9, 65536, 1000000
    status_ok = eq status, SA_NET_STATUS_INVALID_ARGUMENT
    stream_ok = eq stream, 0
    ok = and status_ok, stream_ok
    br ok -> L_PASS, L_FAIL
L_FAIL:
    !ok
    !stream_ok
    !status_ok
    !stream
    !status
    panic(10623)
L_PASS:
    !ok
    !stream_ok
    !status_ok
    !stream
    !status
    return 0
