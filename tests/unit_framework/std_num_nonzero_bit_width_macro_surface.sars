@import "sa_std/num.sars"

@test "sa_std nonzero unsigned bit_width NonZeroU32 macro surface"():
L_ENTRY:
    u8_nz = stack_alloc NonZeroU8_SIZE
    u16_nz = stack_alloc NonZeroU16_SIZE
    u32_nz = stack_alloc NonZeroU32_SIZE
    u64_nz = stack_alloc NonZeroU64_SIZE
    usize_nz = stack_alloc NonZeroUsize_SIZE

    u8_width = stack_alloc NonZeroU32_SIZE
    u16_width = stack_alloc NonZeroU32_SIZE
    u32_width = stack_alloc NonZeroU32_SIZE
    u64_width = stack_alloc NonZeroU32_SIZE
    usize_width = stack_alloc NonZeroU32_SIZE

    u64_high = shl 1, 63

    EXPAND NONZERO_U8_NEW ok_u8, u8_nz, 1
    EXPAND NONZERO_U16_NEW ok_u16, u16_nz, 7
    EXPAND NONZERO_U32_NEW ok_u32, u32_nz, 14
    EXPAND NONZERO_U64_NEW ok_u64, u64_nz, u64_high
    EXPAND NONZERO_USIZE_NEW ok_usize, usize_nz, 4096

    EXPAND NONZERO_U8_BIT_WIDTH_NZ_U32 u8_width, u8_nz
    EXPAND NONZERO_U16_BIT_WIDTH_NZ_U32 u16_width, u16_nz
    EXPAND NONZERO_U32_BIT_WIDTH_NZ_U32 u32_width, u32_nz
    EXPAND NONZERO_U64_BIT_WIDTH_NZ_U32 u64_width, u64_nz
    EXPAND NONZERO_USIZE_BIT_WIDTH_NZ_U32 usize_width, usize_nz

    EXPAND NONZERO_U32_GET u8_value, u8_width
    EXPAND NONZERO_U32_GET u16_value, u16_width
    EXPAND NONZERO_U32_GET u32_value, u32_width
    EXPAND NONZERO_U32_GET u64_value, u64_width
    EXPAND NONZERO_U32_GET usize_value, usize_width

    ok_new_01 = and ok_u8, ok_u16
    ok_new_02 = and ok_new_01, ok_u32
    ok_new_03 = and ok_new_02, ok_u64
    ok_new_all = and ok_new_03, ok_usize

    ok_u8_value = eq u8_value, 1
    ok_u16_value = eq u16_value, 3
    ok_u32_value = eq u32_value, 4
    ok_u64_value = eq u64_value, 64
    ok_usize_value = eq usize_value, 13

    ok_value_01 = and ok_new_all, ok_u8_value
    ok_value_02 = and ok_value_01, ok_u16_value
    ok_value_03 = and ok_value_02, ok_u32_value
    ok_value_04 = and ok_value_03, ok_u64_value
    ok = and ok_value_04, ok_usize_value
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    !u64_high
    panic(10624)

L_PASS:
    !ok
    !u64_high
    return 0
