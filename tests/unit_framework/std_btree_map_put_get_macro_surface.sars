@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_map.sars"

@const K1 = utf8:"a"
@const K2 = utf8:"b"

@test "sa_std btree_map put get"():
L_ENTRY:
    key1 = alloc Slice_SIZE
    key2 = alloc Slice_SIZE
    EXPAND SLICE_NEW key1, &K1, 1
    EXPAND SLICE_NEW key2, &K2, 1
    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, key1, 10
    EXPAND BTREE_MAP_INSERT map, key2, 20
    EXPAND BTREE_MAP_GET g1, map, key1
    EXPAND BTREE_MAP_GET g2, map, key2
    EXPAND BTREE_MAP_LEN ln, map
    EXPAND BTREE_MAP_FREE map
    a = eq g1, 10
    b = eq g2, 20
    c = eq ln, 2
    ok01 = and a, b
    ok = and ok01, c
    !g1
    !g2
    !ln
    !a
    !b
    !c
    !ok01
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10921)
