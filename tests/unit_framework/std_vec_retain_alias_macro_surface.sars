@import "sa_std/vec.sars"

@vec_retain_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@vec_retain_mut_add_ten_keep_original_odd(value_ptr: ptr) -> u64:
L_ENTRY:
    value = load value_ptr+0 as u64
    next_value = add value, 10
    store value_ptr+0, next_value as u64
    rem = urem value, 2
    keep = eq rem, 1
    !next_value
    !rem
    !value
    !value_ptr
    return keep

@test "sa_std vec retain aliases"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 6
    EXPAND VEC_PUSH_U64 vec, 1
    EXPAND VEC_PUSH_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 3
    EXPAND VEC_PUSH_U64 vec, 4
    EXPAND VEC_PUSH_U64 vec, 5
    EXPAND VEC_PUSH_U64 vec, 6
    EXPAND VEC_RETAIN retain_len, vec, @vec_retain_even
    EXPAND VEC_LEN len_after_retain, vec
    EXPAND VEC_TRY_GET_U64 first_ok, first, vec, 0
    EXPAND VEC_TRY_GET_U64 second_ok, second, vec, 1
    EXPAND VEC_TRY_GET_U64 third_ok, third, vec, 2
    EXPAND VEC_TRY_GET_U64 fourth_ok, fourth, vec, 3
    EXPAND VEC_FREE vec

    EXPAND VEC_WITH_CAPACITY_U64 mut_vec, 4
    EXPAND VEC_PUSH_U64 mut_vec, 1
    EXPAND VEC_PUSH_U64 mut_vec, 2
    EXPAND VEC_PUSH_U64 mut_vec, 3
    EXPAND VEC_PUSH_U64 mut_vec, 4
    EXPAND VEC_RETAIN_MUT retain_mut_len, mut_vec, @vec_retain_mut_add_ten_keep_original_odd
    EXPAND VEC_LEN len_after_retain_mut, mut_vec
    EXPAND VEC_TRY_GET_U64 mut_first_ok, mut_first, mut_vec, 0
    EXPAND VEC_TRY_GET_U64 mut_second_ok, mut_second, mut_vec, 1
    EXPAND VEC_TRY_GET_U64 mut_third_ok, mut_third, mut_vec, 2
    EXPAND VEC_FREE mut_vec

    retain_len_ok = eq retain_len, 3
    len_after_retain_ok = eq len_after_retain, 3
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first, 2
    second_flag_ok = eq second_ok, 1
    second_value_ok = eq second, 4
    third_flag_ok = eq third_ok, 1
    third_value_ok = eq third, 6
    fourth_flag_ok = eq fourth_ok, 0
    fourth_value_ok = eq fourth, 0
    retain_mut_len_ok = eq retain_mut_len, 2
    len_after_retain_mut_ok = eq len_after_retain_mut, 2
    mut_first_flag_ok = eq mut_first_ok, 1
    mut_first_value_ok = eq mut_first, 11
    mut_second_flag_ok = eq mut_second_ok, 1
    mut_second_value_ok = eq mut_second, 13
    mut_third_flag_ok = eq mut_third_ok, 0
    mut_third_value_ok = eq mut_third, 0

    ok01 = and retain_len_ok, len_after_retain_ok
    ok02 = and ok01, first_flag_ok
    ok03 = and ok02, first_value_ok
    ok04 = and ok03, second_flag_ok
    ok05 = and ok04, second_value_ok
    ok06 = and ok05, third_flag_ok
    ok07 = and ok06, third_value_ok
    ok08 = and ok07, fourth_flag_ok
    ok09 = and ok08, fourth_value_ok
    ok10 = and ok09, retain_mut_len_ok
    ok11 = and ok10, len_after_retain_mut_ok
    ok12 = and ok11, mut_first_flag_ok
    ok13 = and ok12, mut_first_value_ok
    ok14 = and ok13, mut_second_flag_ok
    ok15 = and ok14, mut_second_value_ok
    ok16 = and ok15, mut_third_flag_ok
    ok = and ok16, mut_third_value_ok

    !retain_len
    !len_after_retain
    !first_ok
    !first
    !second_ok
    !second
    !third_ok
    !third
    !fourth_ok
    !fourth
    !retain_mut_len
    !len_after_retain_mut
    !mut_first_ok
    !mut_first
    !mut_second_ok
    !mut_second
    !mut_third_ok
    !mut_third
    !retain_len_ok
    !len_after_retain_ok
    !first_flag_ok
    !first_value_ok
    !second_flag_ok
    !second_value_ok
    !third_flag_ok
    !third_value_ok
    !fourth_flag_ok
    !fourth_value_ok
    !retain_mut_len_ok
    !len_after_retain_mut_ok
    !mut_first_flag_ok
    !mut_first_value_ok
    !mut_second_flag_ok
    !mut_second_value_ok
    !mut_third_flag_ok
    !mut_third_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10830)

L_OK:
    !ok
    return
