@import "sa_std/net.sars"

@const NET_CURSOR_HOST = utf8:"localhost"

@test "sa_std socket address list remaining and reset"():
L_ENTRY:
    EXPAND NET_TO_SOCKET_ADDR_LIST open_status, list, NET_CURSOR_HOST, 9, 0
    open_ok = eq open_status, SA_NET_OK
    list_ok = ne list, 0
    open_all = and open_ok, list_ok
    br open_all -> L_REMAIN, L_FAIL_OPEN
L_FAIL_OPEN:
    !open_all
    !list_ok
    !open_ok
    !list
    !open_status
    panic(10105)
L_REMAIN:
    EXPAND NET_ADDR_LIST_REMAINING before_status, before_remaining, list
    before_status_ok = eq before_status, SA_NET_OK
    before_nonzero = ne before_remaining, 0
    before_all = and before_status_ok, before_nonzero
    br before_all -> L_NEXT, L_FAIL_REMAIN
L_FAIL_REMAIN:
    !before_all
    !before_nonzero
    !before_status_ok
    !before_remaining
    !before_status
    EXPAND NET_ADDR_LIST_FREE free_status, list
    !free_status
    !list
    panic(10106)
L_NEXT:
    EXPAND NET_ADDR_LIST_NEXT next_status, next_ok, addr, list
    next_status_ok = eq next_status, SA_NET_OK
    next_ok_value = eq next_ok, 1
    addr_ok = ne addr, 0
    next_all = and next_status_ok, next_ok_value
    next_all2 = and next_all, addr_ok
    br next_all2 -> L_AFTER_NEXT, L_FAIL_NEXT
L_FAIL_NEXT:
    !next_all2
    !next_all
    !addr_ok
    !next_ok_value
    !next_status_ok
    !addr
    !next_ok
    !next_status
    EXPAND NET_ADDR_LIST_FREE free_status2, list
    !free_status2
    !list
    panic(10107)
L_AFTER_NEXT:
    EXPAND NET_ADDR_FREE addr_status, addr
    EXPAND NET_ADDR_LIST_REMAINING after_status, after_remaining, list
    after_status_ok = eq after_status, SA_NET_OK
    after_decreased = gt before_remaining, after_remaining
    after_all = and after_status_ok, after_decreased
    br after_all -> L_RESET, L_FAIL_AFTER
L_FAIL_AFTER:
    !after_all
    !after_decreased
    !after_status_ok
    !after_remaining
    !after_status
    !addr_status
    EXPAND NET_ADDR_LIST_FREE free_status3, list
    !free_status3
    !list
    panic(10108)
L_RESET:
    EXPAND NET_ADDR_LIST_RESET reset_status, list
    reset_status_ok = eq reset_status, SA_NET_OK
    EXPAND NET_ADDR_LIST_REMAINING reset_remaining_status, reset_remaining, list
    reset_remaining_status_ok = eq reset_remaining_status, SA_NET_OK
    reset_equal = eq reset_remaining, before_remaining
    reset_all1 = and reset_status_ok, reset_remaining_status_ok
    reset_all = and reset_all1, reset_equal
    EXPAND NET_ADDR_LIST_FREE list_status, list
    list_status_ok = eq list_status, SA_NET_OK
    EXPAND NET_ADDR_LIST_REMAINING invalid_status, invalid_remaining, list
    invalid_status_ok = eq invalid_status, SA_NET_STATUS_INVALID_HANDLE
    invalid_remaining_zero = eq invalid_remaining, 0
    ok1 = and reset_all, list_status_ok
    ok2 = and ok1, invalid_status_ok
    ok = and ok2, invalid_remaining_zero
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    !ok2
    !ok1
    !invalid_remaining_zero
    !invalid_status_ok
    !invalid_remaining
    !invalid_status
    !list_status_ok
    !list_status
    !reset_status
    !reset_remaining_status
    !reset_all
    !reset_all1
    !reset_equal
    !reset_remaining
    !reset_remaining_status_ok
    !reset_status_ok
    !after_all
    !after_decreased
    !after_status_ok
    !after_remaining
    !after_status
    !addr_status
    !next_all2
    !next_all
    !addr_ok
    !next_ok_value
    !next_status_ok
    !before_all
    !before_nonzero
    !before_status_ok
    !before_remaining
    !before_status
    !list_ok
    !open_ok
    !list
    !open_status
    panic(10109)
L_OK:
    !ok
    !ok2
    !ok1
    !invalid_remaining_zero
    !invalid_status_ok
    !invalid_remaining
    !invalid_status
    !list_status_ok
    !list_status
    !reset_status
    !reset_remaining_status
    !reset_all
    !reset_all1
    !reset_equal
    !reset_remaining
    !reset_remaining_status_ok
    !reset_status_ok
    !after_all
    !after_decreased
    !after_status_ok
    !after_remaining
    !after_status
    !addr_status
    !next_all2
    !next_all
    !addr_ok
    !next_ok_value
    !next_status_ok
    !before_all
    !before_nonzero
    !before_status_ok
    !before_remaining
    !before_status
    !list_ok
    !open_ok
    !list
    !open_status
    return 0
