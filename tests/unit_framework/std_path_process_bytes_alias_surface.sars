@import "sa_std/path.sars"
@import "sa_std/process.sars"

@test "sa_std path and process byte aliases expand"():
L_ENTRY:
    [IF 0]
    EXPAND PATH_READ_FILE_BYTES path_read_status, path_read_buf, path_slice, 64
    EXPAND PATH_WRITE_FILE_BYTES path_write_status, path_slice, write_buf, 8
    EXPAND PATH_READ_TO_STRING_BYTES path_string_status, path_string_buf, path_slice, 64
    EXPAND PATH_BUF_READ_FILE_BYTES path_buf_read_status, path_buf_read_buf, path_buf, 64
    EXPAND PATH_BUF_WRITE_FILE_BYTES path_buf_write_status, path_buf, write_buf, 8
    EXPAND PROCESS_OUTPUT_STDOUT_BYTES stdout_ptr, output
    EXPAND PROCESS_OUTPUT_STDERR_BYTES stderr_ptr, output
    EXPAND PROCESS_OUTPUT_STDOUT_BYTE_LEN stdout_len, output
    EXPAND PROCESS_OUTPUT_STDERR_BYTE_LEN stderr_len, output
    [END_IF]
    return 0
