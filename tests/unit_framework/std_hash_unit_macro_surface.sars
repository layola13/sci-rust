@import "sa_std/hash.sars"

@test "sa_std hash unit macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    default_hasher = stack_alloc DefaultHasher_SIZE
    changed_hasher = stack_alloc DefaultHasher_SIZE
    changed_manual_hasher = stack_alloc DefaultHasher_SIZE
    state = stack_alloc RandomState_SIZE
    state_manual_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW default_hasher
    EXPAND DEFAULT_HASHER_WRITE_UNIT default_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH unit_manual, default_hasher

    EXPAND HASH_UNIT unit_hash, 0
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_UNIT build_unit, builder, 0

    EXPAND DEFAULT_HASHER_NEW changed_hasher
    EXPAND DEFAULT_HASHER_WRITE_U64 changed_hasher, 77
    EXPAND DEFAULT_HASHER_WRITE_UNIT changed_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH changed_with_unit, changed_hasher

    EXPAND DEFAULT_HASHER_NEW changed_manual_hasher
    EXPAND DEFAULT_HASHER_WRITE_U64 changed_manual_hasher, 77
    EXPAND DEFAULT_HASHER_FINISH changed_without_unit, changed_manual_hasher

    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_UNIT state_unit, state, 0
    EXPAND RANDOM_STATE_BUILD state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_UNIT state_manual_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH state_manual, state_manual_hasher

    unit_matches_default = eq unit_manual, HASHER_DEFAULT_SEED
    hash_matches_manual = eq unit_hash, unit_manual
    build_matches_hash = eq build_unit, unit_hash
    no_op_after_write = eq changed_with_unit, changed_without_unit
    random_state_matches = eq state_unit, state_manual
    seeded_differs_default = ne state_unit, unit_hash

    c01 = and unit_matches_default, hash_matches_manual
    c02 = and c01, build_matches_hash
    c03 = and c02, no_op_after_write
    c04 = and c03, random_state_matches
    ok = and c04, seeded_differs_default

    !builder
    !unit_manual
    !unit_hash
    !build_unit
    !changed_with_unit
    !changed_without_unit
    !state_unit
    !state_manual
    !unit_matches_default
    !hash_matches_manual
    !build_matches_hash
    !no_op_after_write
    !random_state_matches
    !seeded_differs_default
    !c01
    !c02
    !c03
    !c04
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10563)

L_PASS:
    !ok
    return 0
