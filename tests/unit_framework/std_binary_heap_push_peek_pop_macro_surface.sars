@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap push peek pop"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW heap
    EXPAND BINARY_HEAP_PUSH heap, 3
    EXPAND BINARY_HEAP_PUSH heap, 9
    EXPAND BINARY_HEAP_PUSH heap, 1
    EXPAND BINARY_HEAP_PEEK peek, heap
    EXPAND BINARY_HEAP_TRY_POP pop_ok, pop, heap
    EXPAND BINARY_HEAP_LEN ln, heap
    EXPAND BINARY_HEAP_FREE heap
    a = eq peek, 9
    b = eq pop_ok, 1
    c = eq pop, 9
    d = eq ln, 2
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !peek
    !pop_ok
    !pop
    !ln
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10922)
