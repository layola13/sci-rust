@import "sa_std/thread.sars"

@test "sa_std thread yield_now"():
L_ENTRY:
    EXPAND THREAD_YIELD_NOW st
    EXPAND THREAD_CURRENT_ID id
    a = eq st, 0
    b = ne id, 0
    ok = and a, b
    !st
    !id
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10960)
