    ok59 = and ok58, checked_weeks_fail_flag_ok
    ok60 = and ok59, checked_weeks_fail_value_ok
    ok61 = and ok60, as_secs_ok
    ok62 = and ok61, as_millis_ok
    ok63 = and ok62, as_micros_ok
    ok64 = and ok63, as_nanos_ok
    ok65 = and ok64, floor_flag_ok
    ok66 = and ok65, floor_value_ok
    ok67 = and ok66, ceil_flag_ok
    ok68 = and ok67, ceil_value_ok
    ok69 = and ok68, ceil_exact_flag_ok
    ok70 = and ok69, ceil_exact_value_ok
    ok71 = and ok70, floor_zero_flag_ok
    ok72 = and ok71, floor_zero_value_ok
    ok73 = and ok72, ceil_zero_flag_ok
    ok = and ok73, ceil_zero_value_ok

    !zero_ns
    !max_ns
    !expected_max
    !zero_is_zero
    !nonzero_is_zero
    !checked_add_ok
    !checked_add_value
    !checked_sub_ok
    !checked_sub_value
    !checked_mul_ok
    !checked_mul_value
    !checked_div_ok
    !checked_div_value
    !sat_add_value
    !sat_sub_value
    !sat_mul_value
    !sat_div_value
    !abs_diff_left
    !abs_diff_right
