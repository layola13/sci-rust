    ok28 = and ok27, checked_new_value_ok
    ok29 = and ok28, checked_new_over_flag_ok
    ok30 = and ok29, checked_new_over_value_ok
    ok31 = and ok30, checked_secs_flag_ok
    ok32 = and ok31, checked_secs_value_ok
    ok33 = and ok32, checked_secs_fail_flag_ok
    ok34 = and ok33, checked_secs_fail_value_ok
    ok35 = and ok34, checked_millis_flag_ok
