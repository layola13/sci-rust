@import "sa_std/core/mem.sars"

@test "sa_std mem copy bytes"():
L_ENTRY:
    src = alloc 16
    dst = alloc 16
    store src+0, 11 as u64
    store src+8, 22 as u64
    call @sa_mem_copy(&dst, &src, 16)
    a = load dst+0 as u64
    b = load dst+8 as u64
    x = eq a, 11
    y = eq b, 22
    ok = and x, y
    !a
    !b
    !x
    !y
    !src
    !dst
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10963)
