@import "sa_std/net.sars"

@const RE_HOST = utf8:"127.0.0.1"
#def RE_HOST_LEN = 9
@const RE_MSG1 = utf8:"abcde"
#def RE_MSG1_LEN = 5
@const RE_MSG2 = utf8:"fghij"
#def RE_MSG2_LEN = 5
#def RE_TOTAL_LEN = 10

@test "sa_std tcp read exact behavior"():
L_ENTRY:
    EXPAND NET_TCP_LISTENER_BIND_PORT listen_status, listener, bound_port, RE_HOST, RE_HOST_LEN, 0
    listen_ok = eq listen_status, SA_NET_OK
    listener_ok = ne listener, 0
    port_ok = ne bound_port, 0
    listen_all = and listen_ok, listener_ok
    listen_all2 = and listen_all, port_ok
    br listen_all2 -> L_CONNECT, L_FAIL_LISTEN
L_FAIL_LISTEN:
    !listen_all2
    !listen_all
    !port_ok
    !listener_ok
    !listen_ok
    !bound_port
    !listener
    !listen_status
    panic(10800)
L_CONNECT:
    EXPAND NET_TCP_CONNECT connect_status, client, RE_HOST, RE_HOST_LEN, bound_port
    connect_ok = eq connect_status, SA_NET_OK
    client_ok = ne client, 0
    connect_all = and connect_ok, client_ok
    br connect_all -> L_ACCEPT, L_FAIL_CONNECT
L_FAIL_CONNECT:
    !connect_all
    !client_ok
    !connect_ok
    !client
    !connect_status
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_failed, listener
    !listener_close_failed
    !listener
    panic(10801)
L_ACCEPT:
    EXPAND NET_TCP_LISTENER_ACCEPT accept_status, server, listener
    accept_ok = eq accept_status, SA_NET_OK
    server_ok = ne server, 0
    accept_all = and accept_ok, server_ok
    br accept_all -> L_CLIENT_WRITE, L_FAIL_ACCEPT
L_FAIL_ACCEPT:
    !accept_all
    !server_ok
    !accept_ok
    !server
    !accept_status
    EXPAND NET_TCP_STREAM_CLOSE client_close_failed, client
    !client_close_failed
    !client
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_failed2, listener
    !listener_close_failed2
    !listener
    panic(10802)
L_CLIENT_WRITE:
    write_buf1 = stack_alloc 8
    write_buf2 = stack_alloc 8
    store write_buf1+0, 97 as u8
    store write_buf1+1, 98 as u8
    store write_buf1+2, 99 as u8
    store write_buf1+3, 100 as u8
    store write_buf1+4, 101 as u8
    store write_buf2+0, 102 as u8
    store write_buf2+1, 103 as u8
    store write_buf2+2, 104 as u8
    store write_buf2+3, 105 as u8
    store write_buf2+4, 106 as u8
    EXPAND NET_TCP_STREAM_WRITE_ALL write_status1, client, write_buf1, RE_MSG1_LEN
    write_ok1 = eq write_status1, SA_NET_OK
    EXPAND NET_TCP_STREAM_WRITE_ALL write_status2, client, write_buf2, RE_MSG2_LEN
    write_ok2 = eq write_status2, SA_NET_OK
    write_all = and write_ok1, write_ok2
    br write_all -> L_SERVER_READ, L_FAIL_CLIENT_WRITE
L_FAIL_CLIENT_WRITE:
    !write_all
    !write_ok2
    !write_ok1
    !write_status2
    !write_status1
    EXPAND NET_TCP_STREAM_CLOSE client_close_failed2, client
    !client_close_failed2
    !client
    EXPAND NET_TCP_STREAM_CLOSE server_close_failed, server
    !server_close_failed
    !server
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_failed3, listener
    !listener_close_failed3
    !listener
    panic(10803)
L_SERVER_READ:
    read_buf = stack_alloc 16
    EXPAND NET_TCP_STREAM_READ_EXACT read_exact_status, server, read_buf, RE_TOTAL_LEN
    read_exact_ok = eq read_exact_status, SA_NET_OK
    r_b0 = load read_buf+0 as u8
    r_b1 = load read_buf+1 as u8
    r_b2 = load read_buf+2 as u8
    r_b3 = load read_buf+3 as u8
    r_b4 = load read_buf+4 as u8
    r_b5 = load read_buf+5 as u8
    r_b6 = load read_buf+6 as u8
    r_b7 = load read_buf+7 as u8
    r_b8 = load read_buf+8 as u8
    r_b9 = load read_buf+9 as u8
    r_b0_ok = eq r_b0, 97
    r_b1_ok = eq r_b1, 98
    r_b2_ok = eq r_b2, 99
    r_b3_ok = eq r_b3, 100
    r_b4_ok = eq r_b4, 101
    r_b5_ok = eq r_b5, 102
    r_b6_ok = eq r_b6, 103
    r_b7_ok = eq r_b7, 104
    r_b8_ok = eq r_b8, 105
    r_b9_ok = eq r_b9, 106
    r_match1 = and r_b0_ok, r_b1_ok
    r_match2 = and r_match1, r_b2_ok
    r_match3 = and r_match2, r_b3_ok
    r_match4 = and r_match3, r_b4_ok
    r_match5 = and r_match4, r_b5_ok
    r_match6 = and r_match5, r_b6_ok
    r_match7 = and r_match6, r_b7_ok
    r_match8 = and r_match7, r_b8_ok
    r_match9 = and r_match8, r_b9_ok
    read_exact_match = and read_exact_ok, r_match9
    br read_exact_match -> L_ZERO_LEN, L_FAIL_SERVER_READ
L_FAIL_SERVER_READ:
    !read_exact_match
    !r_match9
    !r_match8
    !r_match7
    !r_match6
    !r_match5
    !r_match4
    !r_match3
    !r_match2
    !r_match1
    !r_b0_ok
    !r_b1_ok
    !r_b2_ok
    !r_b3_ok
    !r_b4_ok
    !r_b5_ok
    !r_b6_ok
    !r_b7_ok
    !r_b8_ok
    !r_b9_ok
    !read_exact_ok
    !read_exact_status
    EXPAND NET_TCP_STREAM_CLOSE client_close_failed3, client
    !client_close_failed3
    !client
    EXPAND NET_TCP_STREAM_CLOSE server_close_failed2, server
    !server_close_failed2
    !server
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_failed4, listener
    !listener_close_failed4
    !listener
    panic(10804)
L_ZERO_LEN:
    zero_buf = stack_alloc 8
    EXPAND NET_TCP_STREAM_READ_EXACT zero_status, server, zero_buf, 0
    zero_ok = eq zero_status, SA_NET_OK
    br zero_ok -> L_EOF, L_FAIL_ZERO
L_FAIL_ZERO:
    !zero_ok
    !zero_status
    EXPAND NET_TCP_STREAM_CLOSE client_close_failed4, client
    !client_close_failed4
    !client
    EXPAND NET_TCP_STREAM_CLOSE server_close_failed3, server
    !server_close_failed3
    !server
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_failed5, listener
    !listener_close_failed5
    !listener
    panic(10805)
L_EOF:
    EXPAND NET_TCP_STREAM_CLOSE client_close_status, client
    client_close_ok = eq client_close_status, SA_NET_OK
    !client_close_ok
    !client_close_status
    !client
    eof_buf = stack_alloc 8
    EXPAND NET_TCP_STREAM_READ_EXACT eof_status, server, eof_buf, 1
    eof_is_io = eq eof_status, SA_NET_STATUS_IO
    br eof_is_io -> L_CLEANUP, L_FAIL_EOF
L_FAIL_EOF:
    !eof_is_io
    !eof_status
    EXPAND NET_TCP_STREAM_CLOSE server_close_failed4, server
    !server_close_failed4
    !server
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_failed6, listener
    !listener_close_failed6
    !listener
    panic(10806)
L_CLEANUP:
    EXPAND NET_TCP_STREAM_CLOSE server_close_status, server
    server_close_ok = eq server_close_status, SA_NET_OK
    br server_close_ok -> L_LISTENER_CLEANUP, L_FAIL_CLEANUP
L_FAIL_CLEANUP:
    !server_close_ok
    !server_close_status
    !server
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_failed7, listener
    !listener_close_failed7
    !listener
    panic(10807)
L_LISTENER_CLEANUP:
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_status, listener
    listener_close_ok = eq listener_close_status, SA_NET_OK
    !listener_close_ok
    !listener_close_status
    !listener
    return
