@import "sa_std/collections/linked_list.sars"

@ll_keep_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@test "sa_std linked_list retain"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 1
    EXPAND LINKED_LIST_PUSH_BACK list, 2
    EXPAND LINKED_LIST_PUSH_BACK list, 3
    EXPAND LINKED_LIST_PUSH_BACK list, 4
    EXPAND LINKED_LIST_RETAIN remain, list, @ll_keep_even
    EXPAND LINKED_LIST_LEN len, list
    EXPAND LINKED_LIST_TRY_FRONT f_ok, f, list
    EXPAND LINKED_LIST_TRY_BACK b_ok, b, list
    EXPAND LINKED_LIST_FREE list

    ok_remain = eq remain, 2
    ok_len = eq len, 2
    ok_f = eq f_ok, 1
    ok_fv = eq f, 2
    ok_b = eq b_ok, 1
    ok_bv = eq b, 4
    ok01 = and ok_remain, ok_len
    ok02 = and ok01, ok_f
    ok03 = and ok02, ok_fv
    ok04 = and ok03, ok_b
    ok = and ok04, ok_bv

    !remain
    !len
    !f_ok
    !f
    !b_ok
    !b
    !ok_remain
    !ok_len
    !ok_f
    !ok_fv
    !ok_b
    !ok_bv
    !ok01
    !ok02
    !ok03
    !ok04
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10877)
