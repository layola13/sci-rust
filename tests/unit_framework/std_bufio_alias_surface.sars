@import "sa_std/io/bufio.sars"

@test "sa_std buffered io byte aliases expand"():
L_ENTRY:
    [IF 0]
    EXPAND BUF_READER_READ_BYTES reader_count, 0, reader_buf, 8
    EXPAND BUF_READER_READ_EXACT_BYTES reader_exact_count, 0, reader_buf, 8
    EXPAND BUF_WRITER_WRITE_BYTES writer_count, 0, writer_buf, 8
    EXPAND BUF_WRITER_WRITE_ALL_BYTES writer_ok, 0, writer_buf, 8
    [END_IF]
    return 0
