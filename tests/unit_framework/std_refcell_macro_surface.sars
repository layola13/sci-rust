@import "sa_std/core/refcell.sars"

@refcell_add_five(value: u64) -> u64:
L_ENTRY:
    out = add value, 5
    return out

@test "sa_std refcell u64 borrow and mutation macros"():
L_ENTRY:
    EXPAND REFCELL_U64_NEW cell, 11
    EXPAND REFCELL_U64_NEW other, 99
    EXPAND REFCELL_U64_BORROW_COUNT count0, cell
    EXPAND REFCELL_U64_TRY_BORROW borrow1_ok, borrow1_ptr, cell
    borrow1_value = load borrow1_ptr+0 as u64
    EXPAND REFCELL_U64_TRY_BORROW borrow2_ok, borrow2_ptr, cell
    EXPAND REFCELL_U64_BORROW_COUNT count_shared, cell
    EXPAND REFCELL_U64_TRY_BORROW_MUT mut_blocked_ok, mut_blocked_ptr, cell
    EXPAND REFCELL_U64_TRY_REPLACE replace_blocked_ok, replace_blocked_old, cell, 77
    EXPAND REFCELL_U64_TRY_TAKE take_blocked_ok, take_blocked_old, cell
    EXPAND REFCELL_U64_RELEASE_SHARED cell
    EXPAND REFCELL_U64_BORROW_COUNT count_after_one_release, cell
    EXPAND REFCELL_U64_RELEASE_SHARED cell
    EXPAND REFCELL_U64_TRY_BORROW_MUT mut_ok, mut_ptr, cell
    store mut_ptr+0, 21 as u64
    EXPAND REFCELL_U64_TRY_BORROW borrow_blocked_ok, borrow_blocked_ptr, cell
    EXPAND REFCELL_U64_TRY_SWAP swap_blocked_ok, cell, other
    EXPAND REFCELL_U64_RELEASE_MUT cell
    EXPAND REFCELL_U64_GET after_mut, cell
    EXPAND REFCELL_U64_REPLACE old_value, cell, 31
    EXPAND REFCELL_U64_GET after_replace, cell
    EXPAND REFCELL_U64_SWAP cell, other
    EXPAND REFCELL_U64_GET after_swap_cell, cell
    EXPAND REFCELL_U64_GET after_swap_other, other
    EXPAND REFCELL_U64_UPDATE update_old, update_new, cell, @refcell_add_five
    EXPAND REFCELL_U64_REPLACE_WITH replace_with_old, replace_with_new, cell, @refcell_add_five
    EXPAND REFCELL_U64_TRY_REPLACE try_replace_ok, try_replace_old, cell, 200
    EXPAND REFCELL_U64_TRY_REPLACE_WITH try_replace_with_ok, try_replace_with_old, try_replace_with_new, cell, @refcell_add_five
    EXPAND REFCELL_U64_GET_MUT_PTR cell_mut_ptr, cell
    store cell_mut_ptr+0, 222 as u64
    EXPAND REFCELL_U64_GET after_get_mut_ptr, cell
    EXPAND REFCELL_U64_TRY_TAKE try_taken_ok, taken_value, cell
    EXPAND REFCELL_U64_GET after_take, cell
    EXPAND REFCELL_U64_TRY_SWAP try_swap_ok, cell, other
    EXPAND REFCELL_U64_GET after_try_swap_cell, cell
    EXPAND REFCELL_U64_GET after_try_swap_other, other
    EXPAND REFCELL_U64_INTO_INNER inner_other, other
    EXPAND REFCELL_U64_AS_PTR cell_ptr, cell
    ptr_value = load cell_ptr+0 as u64
    EXPAND REFCELL_U64_IS_BORROWED borrowed_final, cell

    mut_blocked_is_false = eq mut_blocked_ok, 0
    mut_blocked_is_null = eq mut_blocked_ptr, 0
    replace_blocked_is_false = eq replace_blocked_ok, 0
    replace_blocked_old_zero = eq replace_blocked_old, 0
    take_blocked_is_false = eq take_blocked_ok, 0
    take_blocked_old_zero = eq take_blocked_old, 0
    borrow_blocked_is_false = eq borrow_blocked_ok, 0
    borrow_blocked_is_null = eq borrow_blocked_ptr, 0
    swap_blocked_is_false = eq swap_blocked_ok, 0
    borrowed_final_false = eq borrowed_final, 0

    ok01 = eq count0, 0
    ok02 = eq borrow1_ok, 1
    ok03 = eq borrow1_value, 11
    ok04 = eq borrow2_ok, 1
    ok05 = eq count_shared, 2
    ok06 = eq mut_blocked_is_false, 1
    ok07 = eq mut_blocked_is_null, 1
    ok08 = eq replace_blocked_is_false, 1
    ok09 = eq replace_blocked_old_zero, 1
    ok10 = eq take_blocked_is_false, 1
    ok11 = eq take_blocked_old_zero, 1
    ok12 = eq count_after_one_release, 1
    ok13 = eq mut_ok, 1
    ok14 = eq borrow_blocked_is_false, 1
    ok15 = eq borrow_blocked_is_null, 1
    ok16 = eq swap_blocked_is_false, 1
    ok17 = eq after_mut, 21
    ok18 = eq old_value, 21
    ok19 = eq after_replace, 31
    ok20 = eq after_swap_cell, 99
    ok21 = eq after_swap_other, 31
    ok22 = eq update_old, 99
    ok23 = eq update_new, 104
    ok24 = eq replace_with_old, 104
    ok25 = eq replace_with_new, 109
    ok26 = eq try_replace_ok, 1
    ok27 = eq try_replace_old, 109
    ok28 = eq try_replace_with_ok, 1
    ok29 = eq try_replace_with_old, 200
    ok30 = eq try_replace_with_new, 205
    ok31 = eq after_get_mut_ptr, 222
    ok32 = eq try_taken_ok, 1
    ok33 = eq taken_value, 222
    ok34 = eq after_take, 0
    ok35 = eq try_swap_ok, 1
    ok36 = eq after_try_swap_cell, 31
    ok37 = eq after_try_swap_other, 0
    ok38 = eq inner_other, 0
    ok39 = eq ptr_value, 31
    ok40 = eq borrowed_final_false, 1

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok08
    all09 = and all08, ok09
    all10 = and all09, ok10
    all11 = and all10, ok11
    all12 = and all11, ok12
    all13 = and all12, ok13
    all14 = and all13, ok14
    all15 = and all14, ok15
    all16 = and all15, ok16
    all17 = and all16, ok17
    all18 = and all17, ok18
    all19 = and all18, ok19
    all20 = and all19, ok20
    all21 = and all20, ok21
    all22 = and all21, ok22
    all23 = and all22, ok23
    all24 = and all23, ok24
    all25 = and all24, ok25
    all26 = and all25, ok26
    all27 = and all26, ok27
    all28 = and all27, ok28
    all29 = and all28, ok29
    all30 = and all29, ok30
    all31 = and all30, ok31
    all32 = and all31, ok32
    all33 = and all32, ok33
    all34 = and all33, ok34
    all35 = and all34, ok35
    all36 = and all35, ok36
    all37 = and all36, ok37
    all38 = and all37, ok38
    all39 = and all38, ok39
    all = and all39, ok40

    !cell
    !other
    !count0
    !borrow1_ok
    !borrow1_ptr
    !borrow1_value
    !borrow2_ok
    !borrow2_ptr
    !count_shared
    !mut_blocked_ok
    !mut_blocked_ptr
    !replace_blocked_ok
    !replace_blocked_old
    !take_blocked_ok
    !take_blocked_old
    !count_after_one_release
    !mut_ok
    !mut_ptr
    !borrow_blocked_ok
    !borrow_blocked_ptr
    !swap_blocked_ok
    !after_mut
    !old_value
    !after_replace
    !after_swap_cell
    !after_swap_other
    !update_old
    !update_new
    !replace_with_old
    !replace_with_new
    !try_replace_ok
    !try_replace_old
    !try_replace_with_ok
    !try_replace_with_old
    !try_replace_with_new
    !cell_mut_ptr
    !after_get_mut_ptr
    !try_taken_ok
    !taken_value
    !after_take
    !try_swap_ok
    !after_try_swap_cell
    !after_try_swap_other
    !inner_other
    !cell_ptr
    !ptr_value
    !borrowed_final
    !mut_blocked_is_false
    !mut_blocked_is_null
    !replace_blocked_is_false
    !replace_blocked_old_zero
    !take_blocked_is_false
    !take_blocked_old_zero
    !borrow_blocked_is_false
    !borrow_blocked_is_null
    !swap_blocked_is_false
    !borrowed_final_false
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    !ok33
    !ok34
    !ok35
    !ok36
    !ok37
    !ok38
    !ok39
    !ok40
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !all11
    !all12
    !all13
    !all14
    !all15
    !all16
    !all17
    !all18
    !all19
    !all20
    !all21
    !all22
    !all23
    !all24
    !all25
    !all26
    !all27
    !all28
    !all29
    !all30
    !all31
    !all32
    !all33
    !all34
    !all35
    !all36
    !all37
    !all38
    !all39

    br all -> L_PASS, L_FAIL

L_FAIL:
    !all
    panic(10217)

L_PASS:
    !all
    return 0


@test "sa_std refcell u64 default helper"():
L_ENTRY:
    EXPAND REFCELL_U64_DEFAULT cell
    EXPAND REFCELL_U64_GET value, cell
    EXPAND REFCELL_U64_IS_BORROWED borrowed, cell
    EXPAND REFCELL_U64_BORROW_COUNT count, cell
    ok_value = eq value, 0
    ok_borrowed = eq borrowed, 0
    ok_count = eq count, 0
    ok01 = and ok_value, ok_borrowed
    ok = and ok01, ok_count
    !value
    !borrowed
    !count
    !ok_value
    !ok_borrowed
    !ok_count
    !ok01
    br ok -> L_OK, L_FAIL
L_FAIL:
    !cell
    !ok
    panic(10457)
L_OK:
    !cell
    !ok
    return
