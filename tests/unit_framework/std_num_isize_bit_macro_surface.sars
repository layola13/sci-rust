@import "sa_std/num.sars"

@test "sa_std num isize bit helper macro surface"():
L_ENTRY:
    high_bit = add 0, NUM_ISIZE_MIN

    EXPAND NUM_ISIZE_COUNT_ONES count_ones_neg1, -1
    EXPAND NUM_ISIZE_COUNT_ZEROS count_zeros_neg1, -1
    EXPAND NUM_ISIZE_LEADING_ZEROS leading_zeros_8, 8
    EXPAND NUM_ISIZE_TRAILING_ZEROS trailing_zeros_8, 8
    EXPAND NUM_ISIZE_LEADING_ONES leading_ones_neg1, -1
    EXPAND NUM_ISIZE_TRAILING_ONES trailing_ones_15, 15
    EXPAND NUM_ISIZE_ISOLATE_HIGHEST_ONE isolate_high_neg8, -8
    EXPAND NUM_ISIZE_ISOLATE_LOWEST_ONE isolate_low_neg8, -8
    EXPAND NUM_ISIZE_HIGHEST_ONE highest_neg8_ok, highest_neg8_idx, -8
    EXPAND NUM_ISIZE_LOWEST_ONE lowest_neg8_ok, lowest_neg8_idx, -8
    EXPAND NUM_ISIZE_HIGHEST_ONE highest_zero_ok, highest_zero_idx, 0
    EXPAND NUM_ISIZE_LOWEST_ONE lowest_zero_ok, lowest_zero_idx, 0

    ok01 = eq count_ones_neg1, 64
    ok02 = eq count_zeros_neg1, 0
    ok03 = eq leading_zeros_8, 60
    ok04 = eq trailing_zeros_8, 3
    ok05 = eq leading_ones_neg1, 64
    ok06 = eq trailing_ones_15, 4
    ok07 = eq isolate_high_neg8, high_bit
    ok08 = eq isolate_low_neg8, 8
    ok09 = eq highest_neg8_ok, 1
    ok10 = eq highest_neg8_idx, 63
    ok11 = eq lowest_neg8_ok, 1
    ok12 = eq lowest_neg8_idx, 3
    ok13 = eq highest_zero_ok, 0
    ok14 = eq highest_zero_idx, 0
    ok15 = eq lowest_zero_ok, 0
    ok16 = eq lowest_zero_idx, 0

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    ok = and chain14, ok16

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10670)

L_PASS:
    return 0
