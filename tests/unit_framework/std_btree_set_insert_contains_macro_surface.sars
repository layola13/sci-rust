@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_set.sars"

@const A = utf8:"a"
@const B = utf8:"b"

@test "sa_std btree_set insert contains"():
L_ENTRY:
    ka = alloc Slice_SIZE
    kb = alloc Slice_SIZE
    EXPAND SLICE_NEW ka, &A, 1
    EXPAND SLICE_NEW kb, &B, 1
    EXPAND BTREE_SET_NEW set
    EXPAND BTREE_SET_INSERT ins_a, set, ka
    EXPAND BTREE_SET_INSERT ins_b, set, kb
    EXPAND BTREE_SET_CONTAINS has_a, set, ka
    EXPAND BTREE_SET_CONTAINS has_b, set, kb
    EXPAND BTREE_SET_LEN ln, set
    EXPAND BTREE_SET_FREE set
    a = eq ins_a, 1
    b = eq ins_b, 1
    c = eq has_a, 1
    d = eq has_b, 1
    e = eq ln, 2
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok = and ok03, e
    !ins_a
    !ins_b
    !has_a
    !has_b
    !ln
    !a
    !b
    !c
    !d
    !e
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10926)
