@import "sa_std/num.sars"

@test "sa_std num narrow signed div_ceil macro surface"():
L_ENTRY:
    EXPAND NUM_I8_CHECKED_DIV_CEIL i8_pos_ok, i8_pos, 7, 3
    EXPAND NUM_I8_CHECKED_DIV_CEIL i8_neg_lhs_ok, i8_neg_lhs, -7, 3
    EXPAND NUM_I8_CHECKED_DIV_CEIL i8_neg_rhs_ok, i8_neg_rhs, 7, -3
    EXPAND NUM_I8_CHECKED_DIV_CEIL i8_both_neg_ok, i8_both_neg, -7, -3
    EXPAND NUM_I8_CHECKED_DIV_CEIL i8_exact_ok, i8_exact, -6, 3
    EXPAND NUM_I8_CHECKED_DIV_CEIL i8_zero_ok, i8_zero, 7, 0
    EXPAND NUM_I8_CHECKED_DIV_CEIL i8_over_ok, i8_over, NUM_I8_MIN, -1
    EXPAND NUM_I8_DIV_CEIL i8_direct_ok_value, -7, -3
    EXPAND NUM_I8_DIV_CEIL i8_direct_fail_value, NUM_I8_MIN, -1

    EXPAND NUM_I16_CHECKED_DIV_CEIL i16_pos_ok, i16_pos, 7, 3
    EXPAND NUM_I16_CHECKED_DIV_CEIL i16_neg_lhs_ok, i16_neg_lhs, -7, 3
    EXPAND NUM_I16_CHECKED_DIV_CEIL i16_neg_rhs_ok, i16_neg_rhs, 7, -3
    EXPAND NUM_I16_CHECKED_DIV_CEIL i16_both_neg_ok, i16_both_neg, -7, -3
    EXPAND NUM_I16_CHECKED_DIV_CEIL i16_zero_ok, i16_zero, 7, 0
    EXPAND NUM_I16_CHECKED_DIV_CEIL i16_over_ok, i16_over, NUM_I16_MIN, -1
    EXPAND NUM_I16_DIV_CEIL i16_direct_ok_value, -7, -3

    EXPAND NUM_I32_CHECKED_DIV_CEIL i32_pos_ok, i32_pos, 1025, 64
    EXPAND NUM_I32_CHECKED_DIV_CEIL i32_neg_lhs_ok, i32_neg_lhs, -1025, 64
    EXPAND NUM_I32_CHECKED_DIV_CEIL i32_neg_rhs_ok, i32_neg_rhs, 1025, -64
    EXPAND NUM_I32_CHECKED_DIV_CEIL i32_both_neg_ok, i32_both_neg, -1025, -64
    EXPAND NUM_I32_CHECKED_DIV_CEIL i32_zero_ok, i32_zero, 7, 0
    EXPAND NUM_I32_CHECKED_DIV_CEIL i32_over_ok, i32_over, NUM_I32_MIN, -1
    EXPAND NUM_I32_DIV_CEIL i32_direct_ok_value, -1025, -64

    ok01 = eq i8_pos_ok, 1
    ok02 = eq i8_pos, 3
    ok03 = eq i8_neg_lhs_ok, 1
    ok04 = eq i8_neg_lhs, -2
    ok05 = eq i8_neg_rhs_ok, 1
    ok06 = eq i8_neg_rhs, -2
    ok07 = eq i8_both_neg_ok, 1
    ok08 = eq i8_both_neg, 3
    ok09 = eq i8_exact_ok, 1
    ok10 = eq i8_exact, -2
    ok11 = eq i8_zero_ok, 0
    ok12 = eq i8_zero, 0
    ok13 = eq i8_over_ok, 0
    ok14 = eq i8_over, 0
    ok15 = eq i8_direct_ok_value, 3
    ok16 = eq i8_direct_fail_value, 0

    ok17 = eq i16_pos_ok, 1
    ok18 = eq i16_pos, 3
    ok19 = eq i16_neg_lhs_ok, 1
    ok20 = eq i16_neg_lhs, -2
    ok21 = eq i16_neg_rhs_ok, 1
    ok22 = eq i16_neg_rhs, -2
    ok23 = eq i16_both_neg_ok, 1
    ok24 = eq i16_both_neg, 3
    ok25 = eq i16_zero_ok, 0
    ok26 = eq i16_zero, 0
    ok27 = eq i16_over_ok, 0
    ok28 = eq i16_over, 0
    ok29 = eq i16_direct_ok_value, 3

    ok30 = eq i32_pos_ok, 1
    ok31 = eq i32_pos, 17
    ok32 = eq i32_neg_lhs_ok, 1
    ok33 = eq i32_neg_lhs, -16
    ok34 = eq i32_neg_rhs_ok, 1
    ok35 = eq i32_neg_rhs, -16
    ok36 = eq i32_both_neg_ok, 1
    ok37 = eq i32_both_neg, 17
    ok38 = eq i32_zero_ok, 0
    ok39 = eq i32_zero, 0
    ok40 = eq i32_over_ok, 0
    ok41 = eq i32_over, 0
    ok42 = eq i32_direct_ok_value, 17

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    chain20 = and chain19, ok21
    chain21 = and chain20, ok22
    chain22 = and chain21, ok23
    chain23 = and chain22, ok24
    chain24 = and chain23, ok25
    chain25 = and chain24, ok26
    chain26 = and chain25, ok27
    chain27 = and chain26, ok28
    chain28 = and chain27, ok29
    chain29 = and chain28, ok30
    chain30 = and chain29, ok31
    chain31 = and chain30, ok32
    chain32 = and chain31, ok33
    chain33 = and chain32, ok34
    chain34 = and chain33, ok35
    chain35 = and chain34, ok36
    chain36 = and chain35, ok37
    chain37 = and chain36, ok38
    chain38 = and chain37, ok39
    chain39 = and chain38, ok40
    chain40 = and chain39, ok41
    ok = and chain40, ok42

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10674)

L_PASS:
    return 0
