@import "sa_std/core/arc.sars"

@test "sa_std arc and weak primitive macros"():
L_ENTRY:
    EXPAND ARC_NEW arc, 52
    EXPAND ARC_GET value0, arc
    EXPAND ARC_AS_PTR arc_ptr, arc
    ptr_value0 = load arc_ptr+0 as u64
    EXPAND ARC_STRONG_COUNT strong0, arc
    EXPAND ARC_WEAK_COUNT weak0, arc
    EXPAND ARC_GET_MUT mut0_ok, mut0_ptr, arc
    store mut0_ptr+0, 53 as u64
    EXPAND ARC_GET value_after_mut, arc
    EXPAND ARC_CLONE arc
    EXPAND ARC_STRONG_COUNT strong_after_clone, arc
    EXPAND ARC_GET_MUT mut_after_clone_ok, mut_after_clone_ptr, arc
    EXPAND ARC_TRY_UNWRAP unwrap_clone_ok, unwrap_clone_value, arc
    EXPAND ARC_DOWNGRADE weak, arc
    EXPAND ARC_WEAK_COUNT weak_after_downgrade, arc
    EXPAND ARC_WEAK_STRONG_COUNT weak_strong, weak
    EXPAND ARC_WEAK_WEAK_COUNT weak_weak, weak
    EXPAND ARC_WEAK_CLONE weak
    EXPAND ARC_WEAK_WEAK_COUNT weak_after_clone, weak
    EXPAND ARC_WEAK_UPGRADE upgraded, upgrade_ok, weak
    EXPAND ARC_STRONG_COUNT strong_after_upgrade, arc
    EXPAND ARC_PTR_EQ arc_ptr_eq, arc, upgraded
    EXPAND ARC_WEAK_PTR_EQ weak_ptr_eq, weak, weak
    EXPAND ARC_UNWRAP_OR_CLONE_U64 unwrap_or_clone, arc
    EXPAND ARC_MAKE_MUT_U64 make_mut_ptr, arc
    make_mut_value = load make_mut_ptr+0 as u64
    EXPAND ARC_INTO_RAW raw_ptr, arc
    raw_value = load raw_ptr+0 as u64
    EXPAND ARC_FROM_RAW raw_arc, raw_ptr
    EXPAND ARC_PTR_EQ raw_ptr_eq, arc, raw_arc
    EXPAND ARC_INCREMENT_STRONG_COUNT raw_ptr
    EXPAND ARC_STRONG_COUNT strong_after_raw_inc, arc
    EXPAND ARC_DECREMENT_STRONG_COUNT raw_ptr
    EXPAND ARC_STRONG_COUNT strong_after_raw_dec, arc

    EXPAND ARC_WEAK_NEW empty_weak
    EXPAND ARC_WEAK_UPGRADE empty_upgrade, empty_upgrade_ok, empty_weak
    EXPAND ARC_WEAK_STRONG_COUNT empty_strong, empty_weak
    EXPAND ARC_WEAK_WEAK_COUNT empty_weak_count, empty_weak
    empty_upgrade_null = eq empty_upgrade, 0

    unique = alloc ArcBox_SIZE
    store unique+ArcBox_strong, 1 as u64
    store unique+ArcBox_weak, 1 as u64
    store unique+ArcBox_data, 88 as u64
    EXPAND ARC_TRY_UNWRAP unique_unwrap_ok, unique_unwrap_value, unique

    mut_after_clone_false = eq mut_after_clone_ok, 0
    mut_after_clone_null = eq mut_after_clone_ptr, 0
    unwrap_clone_false = eq unwrap_clone_ok, 0
    empty_upgrade_false = eq empty_upgrade_ok, 0

    ok01 = eq value0, 52
    ok02 = eq ptr_value0, 52
    ok03 = eq strong0, 1
    ok04 = eq weak0, 0
    ok05 = eq mut0_ok, 1
    ok06 = eq value_after_mut, 53
    ok07 = eq strong_after_clone, 2
    ok08 = eq mut_after_clone_false, 1
    ok09 = eq mut_after_clone_null, 1
    ok10 = eq unwrap_clone_false, 1
    ok11 = eq unwrap_clone_value, 0
    ok12 = eq weak_after_downgrade, 1
    ok13 = eq weak_strong, 2
    ok14 = eq weak_weak, 1
    ok15 = eq weak_after_clone, 2
    ok16 = eq upgrade_ok, 1
    ok17 = eq strong_after_upgrade, 3
    ok18 = eq arc_ptr_eq, 1
    ok19 = eq weak_ptr_eq, 1
    ok20 = eq unwrap_or_clone, 53
    ok21 = eq make_mut_value, 53
    ok22 = eq empty_upgrade_false, 1
    ok23 = eq empty_upgrade_null, 1
    ok24 = eq empty_strong, 0
    ok25 = eq empty_weak_count, 0
    ok26 = eq unique_unwrap_ok, 1
    ok27 = eq unique_unwrap_value, 88
    ok28 = eq raw_value, 53
    ok29 = eq raw_ptr_eq, 1
    ok30 = eq strong_after_raw_inc, 4
    ok31 = eq strong_after_raw_dec, 3

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok09
    all09 = and all08, ok10
    all10 = and all09, ok11
    all11 = and all10, ok12
    all12 = and all11, ok13
    all13 = and all12, ok14
    all14 = and all13, ok15
    all15 = and all14, ok16
    all16 = and all15, ok17
    all17 = and all16, ok18
    all18 = and all17, ok19
    all19 = and all18, ok20
    all20 = and all19, ok21
    all21 = and all20, ok22
    all22 = and all21, ok23
    all23 = and all22, ok24
    all24 = and all23, ok25
    all25 = and all24, ok26
    all26 = and all25, ok27
    all27 = and all26, ok28
    all28 = and all27, ok29
    all29 = and all28, ok30
    all = and all29, ok31

    !arc
    !arc_ptr
    !mut0_ptr
    !weak
    !upgraded
    !make_mut_ptr
    !raw_ptr
    !raw_arc
    !empty_weak
    !empty_upgrade
    !unique
    !value0
    !ptr_value0
    !strong0
    !weak0
    !mut0_ok
    !value_after_mut
    !strong_after_clone
    !mut_after_clone_ok
    !mut_after_clone_ptr
    !unwrap_clone_ok
    !unwrap_clone_value
    !weak_after_downgrade
    !weak_strong
    !weak_weak
    !weak_after_clone
    !upgrade_ok
    !strong_after_upgrade
    !arc_ptr_eq
    !weak_ptr_eq
    !unwrap_or_clone
    !make_mut_value
    !empty_upgrade_ok
    !empty_strong
    !empty_weak_count
    !empty_upgrade_null
    !unique_unwrap_ok
    !unique_unwrap_value
    !raw_value
    !raw_ptr_eq
    !strong_after_raw_inc
    !strong_after_raw_dec
    !mut_after_clone_false
    !mut_after_clone_null
    !unwrap_clone_false
    !empty_upgrade_false
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !all11
    !all12
    !all13
    !all14
    !all15
    !all16
    !all17
    !all18
    !all19
    !all20
    !all21
    !all22
    !all23
    !all24
    !all25
    !all26
    !all27
    !all28
    !all29

    br all -> L_PASS, L_FAIL

L_FAIL:
    !all
    panic(949)

L_PASS:
    !all
    return 0


@test "sa_std arc/weak default helpers"():
L_ENTRY:
    EXPAND ARC_DEFAULT_U64 arc
    EXPAND ARC_GET value, arc
    EXPAND ARC_STRONG_COUNT strong, arc
    EXPAND ARC_WEAK_COUNT weak_count, arc

    EXPAND ARC_WEAK_DEFAULT weak
    EXPAND ARC_WEAK_STRONG_COUNT weak_strong, weak
    EXPAND ARC_WEAK_WEAK_COUNT weak_weak, weak
    EXPAND ARC_WEAK_UPGRADE upgraded, upgraded_ok, weak
    upgraded_null = eq upgraded, 0

    ok_value = eq value, 0
    ok_strong = eq strong, 1
    ok_weak_count = eq weak_count, 0
    ok_weak_strong = eq weak_strong, 0
    ok_weak_weak = eq weak_weak, 0
    ok_upgraded = eq upgraded_ok, 0

    ok01 = and ok_value, ok_strong
    ok02 = and ok01, ok_weak_count
    ok03 = and ok02, ok_weak_strong
    ok04 = and ok03, ok_weak_weak
    ok05 = and ok04, ok_upgraded
    ok = and ok05, upgraded_null

    !arc
    !weak
    !upgraded
    !value
    !strong
    !weak_count
    !weak_strong
    !weak_weak
    !upgraded_ok
    !upgraded_null
    !ok_value
    !ok_strong
    !ok_weak_count
    !ok_weak_strong
    !ok_weak_weak
    !ok_upgraded
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10460)
L_OK:
    !ok
    return
