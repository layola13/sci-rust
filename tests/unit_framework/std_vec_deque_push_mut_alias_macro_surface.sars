@import "sa_std/collections/vec_deque.sars"

@test "sa_std vec_deque push mut aliases"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK_MUT back_ptr, deque, 30
    store back_ptr+0, 31 as u64
    EXPAND VEC_DEQUE_PUSH_FRONT_MUT front_ptr, deque, 10
    store front_ptr+0, 9 as u64

    EXPAND VEC_DEQUE_LEN len, deque
    EXPAND VEC_DEQUE_TRY_FRONT front_ok, front, deque
    EXPAND VEC_DEQUE_TRY_BACK back_ok, back, deque
    EXPAND VEC_DEQUE_TRY_GET mid_ok, mid, deque, 1
    null_ptr = 0 as ptr

    ok_len = eq len, 3
    ok_front_ptr = ne front_ptr, null_ptr
    ok_back_ptr = ne back_ptr, null_ptr
    ok_front_flag = eq front_ok, 1
    ok_front = eq front, 9
    ok_mid_flag = eq mid_ok, 1
    ok_mid = eq mid, 20
    ok_back_flag = eq back_ok, 1
    ok_back = eq back, 31

    ok = and ok_len, ok_front_ptr
    ok = and ok, ok_back_ptr
    ok = and ok, ok_front_flag
    ok = and ok, ok_front
    ok = and ok, ok_mid_flag
    ok = and ok, ok_mid
    ok = and ok, ok_back_flag
    ok = and ok, ok_back

    EXPAND VEC_DEQUE_FREE deque
    !len
    !front_ok
    !front
    !back_ok
    !back
    !mid_ok
    !mid
    !front_ptr
    !back_ptr
    !null_ptr
    !ok_len
    !ok_front_ptr
    !ok_back_ptr
    !ok_front_flag
    !ok_front
    !ok_mid_flag
    !ok_mid
    !ok_back_flag
    !ok_back
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10699)

L_OK:
    !ok
    return
