@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list try_get"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 10
    EXPAND LINKED_LIST_PUSH_BACK list, 20
    EXPAND LINKED_LIST_PUSH_BACK list, 30
    EXPAND LINKED_LIST_TRY_GET ok0, v0, list, 0
    EXPAND LINKED_LIST_TRY_GET ok1, v1, list, 1
    EXPAND LINKED_LIST_TRY_GET ok2, v2, list, 2
    EXPAND LINKED_LIST_TRY_GET ok3, v3, list, 3
    EXPAND LINKED_LIST_FREE list

    a = eq ok0, 1
    b = eq v0, 10
    c = eq ok1, 1
    d = eq v1, 20
    e = eq ok2, 1
    f = eq v2, 30
    g = eq ok3, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok04 = and ok03, e
    ok05 = and ok04, f
    ok = and ok05, g

    !ok0
    !v0
    !ok1
    !v1
    !ok2
    !v2
    !ok3
    !v3
    !a
    !b
    !c
    !d
    !e
    !f
    !g
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10878)
