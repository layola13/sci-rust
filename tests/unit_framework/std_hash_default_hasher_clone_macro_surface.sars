@import "sa_std/hash.sars"

@test "sa_std hash DefaultHasher clone macro"():
L_ENTRY:
    original = stack_alloc DefaultHasher_SIZE
    clone = stack_alloc DefaultHasher_SIZE
    default_original = stack_alloc DefaultHasher_SIZE
    default_clone = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW original
    EXPAND DEFAULT_HASHER_WRITE_U64 original, 17
    EXPAND DEFAULT_HASHER_CLONE clone, original

    EXPAND DEFAULT_HASHER_FINISH original_before, original
    EXPAND DEFAULT_HASHER_FINISH clone_before, clone

    EXPAND DEFAULT_HASHER_WRITE_U64 original, 99
    EXPAND DEFAULT_HASHER_FINISH original_after, original
    EXPAND DEFAULT_HASHER_FINISH clone_still_before, clone

    EXPAND DEFAULT_HASHER_WRITE_U64 clone, 99
    EXPAND DEFAULT_HASHER_FINISH clone_after_same_write, clone

    EXPAND DEFAULT_HASHER_DEFAULT default_original
    EXPAND DEFAULT_HASHER_CLONE default_clone, default_original
    EXPAND DEFAULT_HASHER_FINISH default_original_hash, default_original
    EXPAND DEFAULT_HASHER_FINISH default_clone_hash, default_clone

    clone_same_start = eq original_before, clone_before
    clone_independent = eq clone_still_before, clone_before
    same_after_same_write = eq original_after, clone_after_same_write
    changed_after_write = ne original_after, original_before
    default_clone_same = eq default_original_hash, default_clone_hash
    default_seed_ok = eq default_clone_hash, HASHER_DEFAULT_SEED

    c01 = and clone_same_start, clone_independent
    c02 = and c01, same_after_same_write
    c03 = and c02, changed_after_write
    c04 = and c03, default_clone_same
    ok = and c04, default_seed_ok

    !original_before
    !clone_before
    !original_after
    !clone_still_before
    !clone_after_same_write
    !default_original_hash
    !default_clone_hash
    !clone_same_start
    !clone_independent
    !same_after_same_write
    !changed_after_write
    !default_clone_same
    !default_seed_ok
    !c01
    !c02
    !c03
    !c04
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10555)

L_PASS:
    !ok
    return 0
