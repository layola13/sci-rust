@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const S = utf8:"xy"

@test "sa_std string_buf byte_at alias"():
L_ENTRY:
    EXPAND STR_FROM_PARTS slice, &S, 2
    EXPAND STRING_BUF_FROM_STR buf, slice
    EXPAND STRING_BUF_BYTE_AT ok, b, buf, 1
    EXPAND STRING_BUF_BYTE_AT miss, m, buf, 5
    a = eq ok, 1
    b1 = eq b, 121
    c = eq miss, 0
    ok01 = and a, b1
    ok_all = and ok01, c
    !ok
    !b
    !miss
    !m
    !a
    !b1
    !c
    !ok01
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(10910)
