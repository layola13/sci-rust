@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@test "sa_std iter by_ref collect macro surface"():
L_ENTRY:
    values = stack_alloc 32
    empty_values = stack_alloc 8

    store values+0, 5 as u64
    store values+8, 8 as u64
    store values+16, 13 as u64
    store values+24, 21 as u64

    slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 4
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_NEXT_U64 first_ok, first_value, iter
    EXPAND ITER_CLONE clone_iter, iter
    EXPAND ITER_BY_REF_COLLECT_U64 by_ref_vec, iter
    EXPAND ITER_IS_EMPTY iter_empty, iter
    EXPAND ITER_LEN clone_remaining, clone_iter
    EXPAND ITER_NEXT_U64 clone_next_ok, clone_next_value, clone_iter
    EXPAND VEC_LEN by_ref_len, by_ref_vec
    EXPAND VEC_GET_U64 by_ref_0, by_ref_vec, 0
    EXPAND VEC_GET_U64 by_ref_1, by_ref_vec, 1
    EXPAND VEC_GET_U64 by_ref_2, by_ref_vec, 2

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_BY_REF_COLLECT_U64 empty_vec, empty_iter
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter
    EXPAND VEC_LEN empty_len, empty_vec

    ok_first_ok = eq first_ok, 1
    ok_first_value = eq first_value, 5
    ok_iter_empty = eq iter_empty, 1
    ok_clone_remaining = eq clone_remaining, 3
    ok_clone_next_ok = eq clone_next_ok, 1
    ok_clone_next_value = eq clone_next_value, 8
    ok_by_ref_len = eq by_ref_len, 3
    ok_by_ref_0 = eq by_ref_0, 8
    ok_by_ref_1 = eq by_ref_1, 13
    ok_by_ref_2 = eq by_ref_2, 21
    ok_empty_iter_empty = eq empty_iter_empty, 1
    ok_empty_len = eq empty_len, 0

    c01 = and ok_first_ok, ok_first_value
    c02 = and c01, ok_iter_empty
    c03 = and c02, ok_clone_remaining
    c04 = and c03, ok_clone_next_ok
    c05 = and c04, ok_clone_next_value
    c06 = and c05, ok_by_ref_len
    c07 = and c06, ok_by_ref_0
    c08 = and c07, ok_by_ref_1
    c09 = and c08, ok_by_ref_2
    c10 = and c09, ok_empty_iter_empty
    ok = and c10, ok_empty_len

    !first_ok
    !first_value
    !iter_empty
    !clone_remaining
    !clone_next_ok
    !clone_next_value
    !by_ref_len
    !by_ref_0
    !by_ref_1
    !by_ref_2
    !empty_iter_empty
    !empty_len
    !ok_first_ok
    !ok_first_value
    !ok_iter_empty
    !ok_clone_remaining
    !ok_clone_next_ok
    !ok_clone_next_value
    !ok_by_ref_len
    !ok_by_ref_0
    !ok_by_ref_1
    !ok_by_ref_2
    !ok_empty_iter_empty
    !ok_empty_len
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !empty_vec
    !empty_iter
    !by_ref_vec
    !clone_iter
    !iter
    !empty_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10547)

L_PASS:
    !ok
    return 0
