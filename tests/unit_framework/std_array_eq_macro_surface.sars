@import "sa_std/array.sars"

@test "sa_std array equality macro surface"():
L_ENTRY:
    left = stack_alloc 32
    same = stack_alloc 32
    diff = stack_alloc 32
    store left+0, 1 as u64
    store left+8, 2 as u64
    store left+16, 3 as u64
    store left+24, 4 as u64
    store same+0, 1 as u64
    store same+8, 2 as u64
    store same+16, 3 as u64
    store same+24, 4 as u64
    store diff+0, 1 as u64
    store diff+8, 2 as u64
    store diff+16, 30 as u64
    store diff+24, 4 as u64

    EXPAND ARRAY_EQ_U64 eq_same, left, same, 4
    EXPAND ARRAY_EQ_U64 eq_diff, left, diff, 4
    EXPAND ARRAY_NE_U64 ne_same, left, same, 4
    EXPAND ARRAY_NE_U64 ne_diff, left, diff, 4
    EXPAND ARRAY_PARTIAL_EQ_U64 partial_eq_same, left, same, 4
    EXPAND ARRAY_PARTIAL_EQ_U64 partial_eq_diff, left, diff, 4

    ok_eq_same = eq eq_same, 1
    ok_eq_diff = eq eq_diff, 0
    ok_ne_same = eq ne_same, 0
    ok_ne_diff = eq ne_diff, 1
    ok_partial_same = eq partial_eq_same, 1
    ok_partial_diff = eq partial_eq_diff, 0

    c01 = and ok_eq_same, ok_eq_diff
    c02 = and c01, ok_ne_same
    c03 = and c02, ok_ne_diff
    c04 = and c03, ok_partial_same
    ok = and c04, ok_partial_diff

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10524)

L_PASS:
    return 0
