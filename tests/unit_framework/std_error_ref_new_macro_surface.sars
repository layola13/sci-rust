@import "sa_std/error.sars"
@import "sa_std/error.sal"

@const MSG = utf8:"boom"

@test "sa_std error_ref static code"():
L_ENTRY:
    err = stack_alloc ErrorRef_SIZE
    EXPAND ERROR_REF_STATIC err, ERROR_TYPE_GENERIC_LO, ERROR_CODE_INVALID_INPUT, *MSG, 4
    EXPAND ERROR_REF_CODE code, err
    EXPAND ERROR_REF_IS_INVALID_INPUT is_inv, err
    a = eq code, ERROR_CODE_INVALID_INPUT
    b = eq is_inv, 1
    ok = and a, b
    !code
    !is_inv
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10938)
