@test "sa_std convert primitive macros"():
L_ENTRY:
    EXPAND CONVERT_BOOL_TO_U64 bool_true_u64, 1
    EXPAND CONVERT_BOOL_TO_I32 bool_false_i32, 0
    EXPAND CONVERT_U64_TO_BOOL zero_bool, 0
    EXPAND CONVERT_U64_TO_BOOL nonzero_bool, 42

    EXPAND CONVERT_U8_TO_U64 u8_to_u64, 255
    EXPAND CONVERT_U16_TO_U64 u16_to_u64, 65535
    EXPAND CONVERT_U32_TO_U64 u32_to_u64, 4294967295
    neg_four = sub 0, 4
    EXPAND CONVERT_I32_TO_I64 i32_to_i64, neg_four

    EXPAND CONVERT_TRY_U64_TO_U8 u8_ok, u8_value, 255
    EXPAND CONVERT_TRY_U64_TO_U8 u8_miss_ok, u8_miss_value, 256
    EXPAND CONVERT_TRY_U64_TO_U16 u16_ok, u16_value, 65535
    EXPAND CONVERT_TRY_U64_TO_U16 u16_miss_ok, u16_miss_value, 65536
    EXPAND CONVERT_TRY_U64_TO_U32 u32_ok, u32_value, 4294967295
    too_big_u32 = add CONVERT_U32_MAX, 1
    EXPAND CONVERT_TRY_U64_TO_U32 u32_miss_ok, u32_miss_value, too_big_u32
    EXPAND CONVERT_TRY_U64_TO_I64 i64_ok, i64_value, CONVERT_I64_MAX
    too_big_i64 = add CONVERT_I64_MAX, 1
    EXPAND CONVERT_TRY_U64_TO_I64 i64_miss_ok, i64_miss_value, too_big_i64

    EXPAND CONVERT_TRY_I64_TO_U64 i_to_u_ok, i_to_u_value, 7
    neg_one = sub 0, 1
    EXPAND CONVERT_TRY_I64_TO_U64 i_to_u_miss_ok, i_to_u_miss_value, neg_one
    EXPAND CONVERT_TRY_I64_TO_U8 i_to_u8_ok, i_to_u8_value, 255
    EXPAND CONVERT_TRY_I64_TO_U8 i_to_u8_neg_ok, i_to_u8_neg_value, neg_one
    EXPAND CONVERT_TRY_I64_TO_U8 i_to_u8_big_ok, i_to_u8_big_value, 256

    EXPAND CONVERT_SAT_U64_TO_U8 sat_u8_mid, 12
    EXPAND CONVERT_SAT_U64_TO_U8 sat_u8_high, 999
    EXPAND CONVERT_SAT_U64_TO_U16 sat_u16_mid, 12
    EXPAND CONVERT_SAT_U64_TO_U16 sat_u16_high, 99999
    EXPAND CONVERT_SAT_U64_TO_U32 sat_u32_mid, 12
    too_big_u32_sat = add CONVERT_U32_MAX, 1
    EXPAND CONVERT_SAT_U64_TO_U32 sat_u32_high, too_big_u32_sat

    ok_bool_true = eq bool_true_u64, 1
    ok_bool_false = eq bool_false_i32, 0
    ok_zero_bool = eq zero_bool, 0
    ok_nonzero_bool = eq nonzero_bool, 1
    ok_u8_to_u64 = eq u8_to_u64, 255
    ok_u16_to_u64 = eq u16_to_u64, 65535
    ok_u32_to_u64 = eq u32_to_u64, 4294967295
    ok_i32_to_i64 = eq i32_to_i64, neg_four

    ok_u8_flag = eq u8_ok, 1
    ok_u8_value = eq u8_value, 255
    ok_u8_miss_flag = eq u8_miss_ok, 0
    ok_u8_miss_value = eq u8_miss_value, 0
    ok_u16_flag = eq u16_ok, 1
    ok_u16_value = eq u16_value, 65535
    ok_u16_miss_flag = eq u16_miss_ok, 0
    ok_u16_miss_value = eq u16_miss_value, 0
    ok_u32_flag = eq u32_ok, 1
    ok_u32_value = eq u32_value, 4294967295
    ok_u32_miss_flag = eq u32_miss_ok, 0
    ok_u32_miss_value = eq u32_miss_value, 0
    ok_i64_flag = eq i64_ok, 1
    ok_i64_value = eq i64_value, CONVERT_I64_MAX
    ok_i64_miss_flag = eq i64_miss_ok, 0
    ok_i64_miss_value = eq i64_miss_value, 0

    ok_i_to_u_flag = eq i_to_u_ok, 1
    ok_i_to_u_value = eq i_to_u_value, 7
    ok_i_to_u_miss_flag = eq i_to_u_miss_ok, 0
    ok_i_to_u_miss_value = eq i_to_u_miss_value, 0
    ok_i_to_u8_flag = eq i_to_u8_ok, 1
    ok_i_to_u8_value = eq i_to_u8_value, 255
    ok_i_to_u8_neg_flag = eq i_to_u8_neg_ok, 0
    ok_i_to_u8_neg_value = eq i_to_u8_neg_value, 0
    ok_i_to_u8_big_flag = eq i_to_u8_big_ok, 0
    ok_i_to_u8_big_value = eq i_to_u8_big_value, 0

    ok_sat_u8_mid = eq sat_u8_mid, 12
    ok_sat_u8_high = eq sat_u8_high, 255
    ok_sat_u16_mid = eq sat_u16_mid, 12
    ok_sat_u16_high = eq sat_u16_high, 65535
    ok_sat_u32_mid = eq sat_u32_mid, 12
    ok_sat_u32_high = eq sat_u32_high, CONVERT_U32_MAX

    ok01 = and ok_bool_true, ok_bool_false
    ok02 = and ok01, ok_zero_bool
    ok03 = and ok02, ok_nonzero_bool
    ok04 = and ok03, ok_u8_to_u64
    ok05 = and ok04, ok_u16_to_u64
    ok06 = and ok05, ok_u32_to_u64
    ok07 = and ok06, ok_i32_to_i64
    ok08 = and ok07, ok_u8_flag
    ok09 = and ok08, ok_u8_value
    ok10 = and ok09, ok_u8_miss_flag
    ok11 = and ok10, ok_u8_miss_value
    ok12 = and ok11, ok_u16_flag
    ok13 = and ok12, ok_u16_value
    ok14 = and ok13, ok_u16_miss_flag
    ok15 = and ok14, ok_u16_miss_value
    ok16 = and ok15, ok_u32_flag
    ok17 = and ok16, ok_u32_value
    ok18 = and ok17, ok_u32_miss_flag
    ok19 = and ok18, ok_u32_miss_value
    ok20 = and ok19, ok_i64_flag
    ok21 = and ok20, ok_i64_value
    ok22 = and ok21, ok_i64_miss_flag
    ok23 = and ok22, ok_i64_miss_value
    ok24 = and ok23, ok_i_to_u_flag
    ok25 = and ok24, ok_i_to_u_value
    ok26 = and ok25, ok_i_to_u_miss_flag
    ok27 = and ok26, ok_i_to_u_miss_value
    ok28 = and ok27, ok_i_to_u8_flag
    ok29 = and ok28, ok_i_to_u8_value
    ok30 = and ok29, ok_i_to_u8_neg_flag
    ok31 = and ok30, ok_i_to_u8_neg_value
    ok32 = and ok31, ok_i_to_u8_big_flag
    ok33 = and ok32, ok_i_to_u8_big_value
    ok34 = and ok33, ok_sat_u8_mid
    ok35 = and ok34, ok_sat_u8_high
    ok36 = and ok35, ok_sat_u16_mid
    ok37 = and ok36, ok_sat_u16_high
    ok38 = and ok37, ok_sat_u32_mid
    ok = and ok38, ok_sat_u32_high

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10031)

L_PASS:
    return 0
