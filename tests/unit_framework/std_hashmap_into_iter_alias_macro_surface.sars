@import "sa_std/collections/hashmap.sars"
@import "sa_std/vec.sars"

@const KEY_A = utf8:"alpha"
@const KEY_B = utf8:"bravo"
@const KEY_C = utf8:"charlie"
@const VALUE_A = utf8:"A\n"
@const VALUE_B = utf8:"B\n"
@const VALUE_C = utf8:"C\n"

@test "sa_std hashmap into-iterator aliases"():
L_ENTRY:
    key_a = &KEY_A
    key_b = &KEY_B
    key_c = &KEY_C
    value_a = &VALUE_A
    value_b = &VALUE_B
    value_c = &VALUE_C

    EXPAND MAP_WITH_CAPACITY borrowed_map, 4
    EXPAND MAP_PUT borrowed_map, key_a, value_a
    EXPAND MAP_PUT borrowed_map, key_b, value_b
    EXPAND MAP_PUT borrowed_map, key_c, value_c
    EXPAND MAP_GET_MUT_PTR key_b_value_slot_ok, key_b_value_slot, borrowed_map, key_b
    key_b_value_slot_bits = bitcast key_b_value_slot as u64

    EXPAND MAP_REF_INTO_ITER ref_iter_vec, borrowed_map
    EXPAND MAP_MUT_REF_INTO_ITER mut_ref_iter_vec, borrowed_map
    EXPAND VEC_LEN ref_iter_len, ref_iter_vec
    EXPAND VEC_LEN mut_ref_iter_len, mut_ref_iter_vec

    key_a_bits = bitcast key_a as u64
    key_b_bits = bitcast key_b as u64
    key_c_bits = bitcast key_c as u64
    value_a_bits = bitcast value_a as u64
    value_b_bits = bitcast value_b as u64
    value_c_bits = bitcast value_c as u64
    EXPAND VEC_CONTAINS_U64 ref_has_key_a, ref_iter_vec, key_a_bits
    EXPAND VEC_CONTAINS_U64 ref_has_key_b, ref_iter_vec, key_b_bits
    EXPAND VEC_CONTAINS_U64 ref_has_key_c, ref_iter_vec, key_c_bits
    EXPAND VEC_CONTAINS_U64 ref_has_value_a, ref_iter_vec, value_a_bits
    EXPAND VEC_CONTAINS_U64 ref_has_value_b, ref_iter_vec, value_b_bits
    EXPAND VEC_CONTAINS_U64 ref_has_value_c, ref_iter_vec, value_c_bits
    EXPAND VEC_CONTAINS_U64 mut_has_key_b, mut_ref_iter_vec, key_b_bits
    EXPAND VEC_CONTAINS_U64 mut_has_key_b_slot, mut_ref_iter_vec, key_b_value_slot_bits

    store key_b_value_slot+0, value_a as ptr
    EXPAND MAP_GET value_b_after_mut, borrowed_map, key_b
    EXPAND MAP_LEN borrowed_len_after, borrowed_map

    EXPAND MAP_WITH_CAPACITY owned_map, 4
    EXPAND MAP_PUT owned_map, key_a, value_a
    EXPAND MAP_PUT owned_map, key_b, value_b
    EXPAND MAP_INTO_ITER into_iter_vec, owned_map
    EXPAND VEC_LEN into_iter_len, into_iter_vec
    EXPAND VEC_CONTAINS_U64 into_has_key_a, into_iter_vec, key_a_bits
    EXPAND VEC_CONTAINS_U64 into_has_key_b, into_iter_vec, key_b_bits
    EXPAND VEC_CONTAINS_U64 into_has_value_a, into_iter_vec, value_a_bits
    EXPAND VEC_CONTAINS_U64 into_has_value_b, into_iter_vec, value_b_bits
    EXPAND MAP_LEN owned_len_after, owned_map

    EXPAND MAP_NEW empty_map
    EXPAND MAP_REF_INTO_ITER empty_ref_iter, empty_map
    EXPAND MAP_MUT_REF_INTO_ITER empty_mut_ref_iter, empty_map
    EXPAND MAP_INTO_ITER empty_into_iter, empty_map
    EXPAND VEC_LEN empty_ref_iter_len, empty_ref_iter
    EXPAND VEC_LEN empty_mut_ref_iter_len, empty_mut_ref_iter
    EXPAND VEC_LEN empty_into_iter_len, empty_into_iter
    EXPAND MAP_LEN empty_len_after, empty_map

    ok_key_b_value_slot = eq key_b_value_slot_ok, 1
    ok_ref_iter_len = eq ref_iter_len, 6
    ok_mut_ref_iter_len = eq mut_ref_iter_len, 6
    ok_ref_has_key_a = eq ref_has_key_a, 1
    ok_ref_has_key_b = eq ref_has_key_b, 1
    ok_ref_has_key_c = eq ref_has_key_c, 1
    ok_ref_has_value_a = eq ref_has_value_a, 1
    ok_ref_has_value_b = eq ref_has_value_b, 1
    ok_ref_has_value_c = eq ref_has_value_c, 1
    ok_mut_has_key_b = eq mut_has_key_b, 1
    ok_mut_has_key_b_slot = eq mut_has_key_b_slot, 1
    ok_value_b_after_mut = eq value_b_after_mut, value_a
    ok_borrowed_len_after = eq borrowed_len_after, 3
    ok_into_iter_len = eq into_iter_len, 4
    ok_into_has_key_a = eq into_has_key_a, 1
    ok_into_has_key_b = eq into_has_key_b, 1
    ok_into_has_value_a = eq into_has_value_a, 1
    ok_into_has_value_b = eq into_has_value_b, 1
    ok_owned_len_after = eq owned_len_after, 0
    ok_empty_ref_iter = eq empty_ref_iter_len, 0
    ok_empty_mut_ref_iter = eq empty_mut_ref_iter_len, 0
    ok_empty_into_iter = eq empty_into_iter_len, 0
    ok_empty_len_after = eq empty_len_after, 0

    ok01 = and ok_key_b_value_slot, ok_ref_iter_len
    ok02 = and ok01, ok_mut_ref_iter_len
    ok03 = and ok02, ok_ref_has_key_a
    ok04 = and ok03, ok_ref_has_key_b
    ok05 = and ok04, ok_ref_has_key_c
    ok06 = and ok05, ok_ref_has_value_a
    ok07 = and ok06, ok_ref_has_value_b
    ok08 = and ok07, ok_ref_has_value_c
    ok09 = and ok08, ok_mut_has_key_b
    ok10 = and ok09, ok_mut_has_key_b_slot
    ok11 = and ok10, ok_value_b_after_mut
    ok12 = and ok11, ok_borrowed_len_after
    ok13 = and ok12, ok_into_iter_len
    ok14 = and ok13, ok_into_has_key_a
    ok15 = and ok14, ok_into_has_key_b
    ok16 = and ok15, ok_into_has_value_a
    ok17 = and ok16, ok_into_has_value_b
    ok18 = and ok17, ok_owned_len_after
    ok19 = and ok18, ok_empty_ref_iter
    ok20 = and ok19, ok_empty_mut_ref_iter
    ok21 = and ok20, ok_empty_into_iter
    ok = and ok21, ok_empty_len_after

    !key_b_value_slot_ok
    !key_b_value_slot
    !key_b_value_slot_bits
    !ref_iter_vec
    !mut_ref_iter_vec
    !ref_iter_len
    !mut_ref_iter_len
    !key_a_bits
    !key_b_bits
    !key_c_bits
    !value_a_bits
    !value_b_bits
    !value_c_bits
    !ref_has_key_a
    !ref_has_key_b
    !ref_has_key_c
    !ref_has_value_a
    !ref_has_value_b
    !ref_has_value_c
    !mut_has_key_b
    !mut_has_key_b_slot
    !value_b_after_mut
    !borrowed_len_after
    !into_iter_vec
    !into_iter_len
    !into_has_key_a
    !into_has_key_b
    !into_has_value_a
    !into_has_value_b
    !owned_len_after
    !empty_ref_iter
    !empty_mut_ref_iter
    !empty_into_iter
    !empty_ref_iter_len
    !empty_mut_ref_iter_len
    !empty_into_iter_len
    !empty_len_after
    !ok_key_b_value_slot
    !ok_ref_iter_len
    !ok_mut_ref_iter_len
    !ok_ref_has_key_a
    !ok_ref_has_key_b
    !ok_ref_has_key_c
    !ok_ref_has_value_a
    !ok_ref_has_value_b
    !ok_ref_has_value_c
    !ok_mut_has_key_b
    !ok_mut_has_key_b_slot
    !ok_value_b_after_mut
    !ok_borrowed_len_after
    !ok_into_iter_len
    !ok_into_has_key_a
    !ok_into_has_key_b
    !ok_into_has_value_a
    !ok_into_has_value_b
    !ok_owned_len_after
    !ok_empty_ref_iter
    !ok_empty_mut_ref_iter
    !ok_empty_into_iter
    !ok_empty_len_after
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !value_c
    !value_b
    !value_a
    !key_c
    !key_b
    !key_a
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND MAP_FREE empty_map
    EXPAND MAP_FREE owned_map
    EXPAND MAP_FREE borrowed_map
    return 0

L_FAIL:
    panic(10812)
