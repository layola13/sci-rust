@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_map.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"
@const KEY_DELTA = utf8:"delta"

@mutate_range_extract_bravo(&key: ptr, value_ptr: ptr) -> u64:
L_ENTRY:
    value = load value_ptr+0 as u64
    next_value = add value, 100
    store value_ptr+0, next_value as u64
    key_ptr = load key+Slice_ptr as ptr
    bravo_ptr = &KEY_BRAVO
    take = eq key_ptr, bravo_ptr
    !bravo_ptr
    !key_ptr
    !next_value
    !value
    !value_ptr
    !key
    return take

@test "sa_std btree_map ranged eager extract_if"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    delta = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7
    EXPAND SLICE_NEW delta, &KEY_DELTA, 5

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, delta, 40
    EXPAND BTREE_MAP_INSERT map, charlie, 30
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, bravo, 20
    EXPAND BTREE_MAP_EXTRACT_IF_RANGE remain_len, extracted, map, bravo, delta, @mutate_range_extract_bravo

    EXPAND BTREE_MAP_LEN source_len, map
    EXPAND BTREE_MAP_LEN extracted_len, extracted
    EXPAND BTREE_MAP_GET alpha_value, map, alpha
    EXPAND BTREE_MAP_GET charlie_value, map, charlie
    EXPAND BTREE_MAP_GET delta_value, map, delta
    EXPAND BTREE_MAP_CONTAINS_KEY source_bravo, map, bravo
    EXPAND BTREE_MAP_GET extracted_bravo_value, extracted, bravo
    EXPAND BTREE_MAP_CONTAINS_KEY extracted_charlie, extracted, charlie

    EXPAND BTREE_MAP_EXTRACT_IF_RANGE equal_remain_len, equal_extracted, map, delta, delta, @mutate_range_extract_bravo
    EXPAND BTREE_MAP_LEN equal_extracted_len, equal_extracted
    EXPAND BTREE_MAP_GET delta_after_equal, map, delta

    ok_remain_len = eq remain_len, 3
    ok_source_len = eq source_len, 3
    ok_extracted_len = eq extracted_len, 1
    ok_alpha_value = eq alpha_value, 10
    ok_charlie_value = eq charlie_value, 130
    ok_delta_value = eq delta_value, 40
    ok_source_bravo = eq source_bravo, 0
    ok_extracted_bravo = eq extracted_bravo_value, 120
    ok_extracted_charlie = eq extracted_charlie, 0
    ok_equal_remain = eq equal_remain_len, 3
    ok_equal_extracted = eq equal_extracted_len, 0
    ok_delta_after_equal = eq delta_after_equal, 40

    ok01 = and ok_remain_len, ok_source_len
    ok02 = and ok01, ok_extracted_len
    ok03 = and ok02, ok_alpha_value
    ok04 = and ok03, ok_charlie_value
    ok05 = and ok04, ok_delta_value
    ok06 = and ok05, ok_source_bravo
    ok07 = and ok06, ok_extracted_bravo
    ok08 = and ok07, ok_extracted_charlie
    ok09 = and ok08, ok_equal_remain
    ok10 = and ok09, ok_equal_extracted
    ok = and ok10, ok_delta_after_equal

    !remain_len
    !source_len
    !extracted_len
    !alpha_value
    !charlie_value
    !delta_value
    !source_bravo
    !extracted_bravo_value
    !extracted_charlie
    !equal_remain_len
    !equal_extracted_len
    !delta_after_equal
    !ok_remain_len
    !ok_source_len
    !ok_extracted_len
    !ok_alpha_value
    !ok_charlie_value
    !ok_delta_value
    !ok_source_bravo
    !ok_extracted_bravo
    !ok_extracted_charlie
    !ok_equal_remain
    !ok_equal_extracted
    !ok_delta_after_equal
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !delta
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_MAP_FREE equal_extracted
    EXPAND BTREE_MAP_FREE extracted
    EXPAND BTREE_MAP_FREE map
    return 0

L_FAIL:
    panic(10819)
