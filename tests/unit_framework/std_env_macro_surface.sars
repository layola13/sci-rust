@import "sa_std/env.sars"
@import "sa_std/core/slice.sars"
@import "sa_std/string.sars"
@const ENV_OS_ALIAS_KEY = utf8:"SA_ENV_OS_ALIAS_TEST_KEY"
@const ENV_OS_ALIAS_VAL = utf8:"xyz"

@const PATH_KEY = utf8:"PATH"
@const MISSING_KEY = utf8:"__SA_STD_ENV_SHOULD_NOT_EXIST__"
@const MUTATION_KEY = utf8:"__SA_STD_ENV_MUTATION_TEST__"
@const MUTATION_VALUE = utf8:"sa-env-value"
@const PATH_LIST = utf8:"alpha:beta:gamma"
@const PATH_SEGMENT = utf8:"beta"
@const PATH_LIST_JSON = utf8:"[\"alpha\",\"beta\",\"gamma\"]"
@const XDG_DATA_HOME_KEY = utf8:"XDG_DATA_HOME"
@const XDG_CONFIG_HOME_KEY = utf8:"XDG_CONFIG_HOME"
@const XDG_STATE_HOME_KEY = utf8:"XDG_STATE_HOME"
@const XDG_CACHE_HOME_KEY = utf8:"XDG_CACHE_HOME"
@const XDG_DATA_DIRS_KEY = utf8:"XDG_DATA_DIRS"
@const XDG_CONFIG_DIRS_KEY = utf8:"XDG_CONFIG_DIRS"
@const XDG_DATA_HOME_VALUE = utf8:"/tmp/sa-xdg-data"
@const XDG_CONFIG_HOME_VALUE = utf8:"/tmp/sa-xdg-config"
@const XDG_STATE_HOME_VALUE = utf8:"/tmp/sa-xdg-state"
@const XDG_CACHE_HOME_VALUE = utf8:"/tmp/sa-xdg-cache"
@const XDG_DATA_DIRS_VALUE = utf8:"/opt/share:/srv/share"
@const XDG_CONFIG_DIRS_VALUE = utf8:"/opt/xdg:/etc/xdg-test"
@const XDG_DATA_DIRS_DEFAULT = utf8:"/usr/local/share/:/usr/share/"
@const XDG_CONFIG_DIRS_DEFAULT = utf8:"/etc/xdg"

#def PATH_KEY_LEN = 4
#def MISSING_KEY_LEN = 31
#def MUTATION_KEY_LEN = 28
#def MUTATION_VALUE_LEN = 12
#def PATH_LIST_LEN = 16
#def PATH_SEGMENT_LEN = 4
#def PATH_LIST_JSON_LEN = 24
#def XDG_DATA_HOME_KEY_LEN = 13
#def XDG_CONFIG_HOME_KEY_LEN = 15
#def XDG_STATE_HOME_KEY_LEN = 14
#def XDG_CACHE_HOME_KEY_LEN = 14
#def XDG_DATA_DIRS_KEY_LEN = 13
#def XDG_CONFIG_DIRS_KEY_LEN = 15
#def XDG_DATA_HOME_VALUE_LEN = 16
#def XDG_CONFIG_HOME_VALUE_LEN = 18
#def XDG_STATE_HOME_VALUE_LEN = 17
#def XDG_CACHE_HOME_VALUE_LEN = 17
#def XDG_DATA_DIRS_VALUE_LEN = 21
#def XDG_CONFIG_DIRS_VALUE_LEN = 22
#def XDG_DATA_DIRS_DEFAULT_LEN = 29
#def XDG_CONFIG_DIRS_DEFAULT_LEN = 8

@test "sa_std env buffer and slice macros"():
L_ENTRY:
    key = stack_alloc Slice_SIZE
    slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW key, &PATH_KEY, PATH_KEY_LEN
    EXPAND ENV_EXISTS exists, key
    EXPAND SLICE_GET_PTR raw_key_ptr, key
    EXPAND ENV_EXISTS_PTR exists_ptr, raw_key_ptr, PATH_KEY_LEN
    EXPAND ENV_HAS_PTR has_status_ptr, raw_key_ptr, PATH_KEY_LEN
    EXPAND ENV_STATUS_IS_OK has_ok_ptr, has_status_ptr
    br exists -> L_FETCH, L_FAIL_EXISTS

L_FETCH:
    try_slice = stack_alloc Slice_SIZE
    try_slice_ptr_slice = stack_alloc Slice_SIZE
    EXPAND ENV_GET_SLICE buffer, slice, key
    EXPAND ENV_TRY_GET try_buffer_ok, try_buffer, key
    EXPAND ENV_TRY_GET_PTR try_ptr_ok, try_ptr_buffer, raw_key_ptr, PATH_KEY_LEN
    EXPAND ENV_TRY_GET_SLICE try_slice_ok, try_slice_buffer, try_slice, key
    EXPAND ENV_TRY_GET_SLICE_PTR try_slice_ptr_ok, try_slice_ptr_buffer, try_slice_ptr_slice, raw_key_ptr, PATH_KEY_LEN
    EXPAND ENV_GET_PARTS_PTR parts_buffer, parts_ptr, parts_len, raw_key_ptr, PATH_KEY_LEN
    EXPAND ENV_BUFFER_DATA data_ptr, buffer
    EXPAND ENV_BUFFER_LEN data_len, buffer
    EXPAND ENV_BUFFER_LEN try_data_len, try_buffer
    EXPAND ENV_BUFFER_LEN try_slice_data_len, try_slice_buffer
    EXPAND SLICE_GET_LEN try_slice_len, try_slice
    EXPAND ENV_BUFFER_LEN try_slice_ptr_data_len, try_slice_ptr_buffer
    EXPAND SLICE_GET_LEN try_slice_ptr_len, try_slice_ptr_slice
    EXPAND SLICE_GET_PTR slice_ptr, slice
    EXPAND SLICE_GET_LEN slice_len, slice
    EXPAND SLICE_IS_EMPTY slice_empty, slice
    EXPAND ENV_BUFFER_FREE parts_free_status, parts_buffer
    EXPAND ENV_STATUS_IS_OK parts_free_ok, parts_free_status
    EXPAND ENV_BUFFER_FREE try_free_status, try_buffer
    EXPAND ENV_STATUS_IS_OK try_free_ok, try_free_status
    EXPAND ENV_BUFFER_FREE try_ptr_free_status, try_ptr_buffer
    EXPAND ENV_STATUS_IS_OK try_ptr_free_ok, try_ptr_free_status
    EXPAND ENV_BUFFER_FREE try_slice_free_status, try_slice_buffer
    EXPAND ENV_STATUS_IS_OK try_slice_free_ok, try_slice_free_status
    EXPAND ENV_BUFFER_FREE try_slice_ptr_free_status, try_slice_ptr_buffer
    EXPAND ENV_STATUS_IS_OK try_slice_ptr_free_ok, try_slice_ptr_free_status
    EXPAND ENV_BUFFER_FREE free_status, buffer
    EXPAND ENV_STATUS_IS_OK free_ok, free_status

    data_nonzero = ne data_ptr, 0
    parts_ptr_nonzero = ne parts_ptr, 0
    lens_eq = eq data_len, slice_len
    try_lens_eq = eq try_data_len, data_len
    try_slice_lens_eq = eq try_slice_data_len, try_slice_len
    try_slice_ptr_lens_eq = eq try_slice_ptr_data_len, try_slice_ptr_len
    parts_lens_eq = eq parts_len, data_len
    ptrs_eq = eq data_ptr, slice_ptr
    slice_not_empty = eq slice_empty, 0
    ok01 = and exists, data_nonzero
    ok02 = and ok01, exists_ptr
    ok03 = and ok02, has_ok_ptr
    ok04 = and ok03, parts_ptr_nonzero
    ok05 = and ok04, parts_lens_eq
    ok06 = and ok05, lens_eq
    ok07 = and ok06, ptrs_eq
    ok08 = and ok07, slice_not_empty
    ok09 = and ok08, parts_free_ok
    ok10 = and ok09, try_buffer_ok
    ok11 = and ok10, try_ptr_ok
    ok12 = and ok11, try_slice_ok
    ok13 = and ok12, try_slice_ptr_ok
    ok14 = and ok13, try_lens_eq
    ok15 = and ok14, try_slice_lens_eq
    ok16 = and ok15, try_slice_ptr_lens_eq
    ok17 = and ok16, try_free_ok
    ok18 = and ok17, try_ptr_free_ok
    ok19 = and ok18, try_slice_free_ok
    ok20 = and ok19, try_slice_ptr_free_ok
    ok = and ok20, free_ok

    !exists
    !exists_ptr
    !has_status_ptr
    !has_ok_ptr
    !raw_key_ptr
    !data_ptr
    !data_len
    !try_buffer_ok
    !try_ptr_ok
    !try_slice_ok
    !try_slice_ptr_ok
    !try_data_len
    !try_slice_data_len
    !try_slice_len
    !try_slice_ptr_data_len
    !try_slice_ptr_len
    !parts_ptr
    !parts_len
    !slice_ptr
    !slice_len
    !slice_empty
    !parts_free_status
    !parts_free_ok
    !try_free_status
    !try_free_ok
    !try_ptr_free_status
    !try_ptr_free_ok
    !try_slice_free_status
    !try_slice_free_ok
    !try_slice_ptr_free_status
    !try_slice_ptr_free_ok
    !free_status
    !free_ok
    !data_nonzero
    !parts_ptr_nonzero
    !lens_eq
    !try_lens_eq
    !try_slice_lens_eq
    !try_slice_ptr_lens_eq
    !parts_lens_eq
    !ptrs_eq
    !slice_not_empty
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20

    br ok -> L_PASS, L_FAIL_FETCH

L_FAIL_EXISTS:
    !exists
    panic(1003)

L_FAIL_FETCH:
    !ok
    panic(1004)

L_PASS:
    !ok
    return 0

@test "sa_std env try macros return none for missing key"():
L_MISSING_ENTRY:
    missing_key = stack_alloc Slice_SIZE
    missing_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW missing_key, &MISSING_KEY, MISSING_KEY_LEN
    EXPAND ENV_TRY_GET missing_ok, missing_buffer, missing_key
    EXPAND ENV_TRY_GET_PTR missing_ptr_ok, missing_ptr_buffer, &MISSING_KEY, MISSING_KEY_LEN
    EXPAND ENV_TRY_GET_SLICE missing_slice_ok, missing_slice_buffer, missing_slice, missing_key
    EXPAND SLICE_GET_PTR missing_slice_ptr, missing_slice
    EXPAND SLICE_GET_LEN missing_slice_len, missing_slice

    missing_ok_zero = eq missing_ok, 0
    missing_buffer_zero = eq missing_buffer, 0
    missing_ptr_ok_zero = eq missing_ptr_ok, 0
    missing_ptr_buffer_zero = eq missing_ptr_buffer, 0
    missing_slice_ok_zero = eq missing_slice_ok, 0
    missing_slice_buffer_zero = eq missing_slice_buffer, 0
    missing_slice_ptr_zero = eq missing_slice_ptr, 0
    missing_slice_len_zero = eq missing_slice_len, 0
    miss01 = and missing_ok_zero, missing_buffer_zero
    miss02 = and miss01, missing_ptr_ok_zero
    miss03 = and miss02, missing_ptr_buffer_zero
    miss04 = and miss03, missing_slice_ok_zero
    miss05 = and miss04, missing_slice_buffer_zero
    miss06 = and miss05, missing_slice_ptr_zero
    miss_ok = and miss06, missing_slice_len_zero

    !missing_ok
    !missing_buffer
    !missing_ptr_ok
    !missing_ptr_buffer
    !missing_slice_ok
    !missing_slice_buffer
    !missing_slice_ptr
    !missing_slice_len
    !missing_ok_zero
    !missing_buffer_zero
    !missing_ptr_ok_zero
    !missing_ptr_buffer_zero
    !missing_slice_ok_zero
    !missing_slice_buffer_zero
    !missing_slice_ptr_zero
    !missing_slice_len_zero
    !miss01
    !miss02
    !miss03
    !miss04
    !miss05
    !miss06

    br miss_ok -> L_MISSING_PASS, L_MISSING_FAIL

L_MISSING_FAIL:
    !miss_ok
    panic(1005)

L_MISSING_PASS:
    !miss_ok
    return 0

@test "sa_std env path query macros"():
L_PATH_ENTRY:
    cwd_slice = stack_alloc Slice_SIZE
    temp_slice = stack_alloc Slice_SIZE
    exe_slice = stack_alloc Slice_SIZE
    EXPAND ENV_CURRENT_DIR cwd_buffer
    EXPAND ENV_TEMP_DIR temp_buffer
    EXPAND ENV_CURRENT_EXE exe_buffer
    EXPAND ENV_BUFFER_AS_SLICE cwd_slice, cwd_buffer
    EXPAND ENV_BUFFER_AS_SLICE temp_slice, temp_buffer
    EXPAND ENV_BUFFER_AS_SLICE exe_slice, exe_buffer
    EXPAND SLICE_GET_PTR cwd_ptr, cwd_slice
    EXPAND SLICE_GET_LEN cwd_len, cwd_slice
    EXPAND SLICE_GET_PTR temp_ptr, temp_slice
    EXPAND SLICE_GET_LEN temp_len, temp_slice
    EXPAND SLICE_GET_PTR exe_ptr, exe_slice
    EXPAND SLICE_GET_LEN exe_len, exe_slice

    cwd_buffer_nonzero = ne cwd_buffer, 0
    temp_buffer_nonzero = ne temp_buffer, 0
    exe_buffer_nonzero = ne exe_buffer, 0
    cwd_ptr_nonzero = ne cwd_ptr, 0
    temp_ptr_nonzero = ne temp_ptr, 0
    exe_ptr_nonzero = ne exe_ptr, 0
    cwd_len_nonzero = ne cwd_len, 0
    temp_len_nonzero = ne temp_len, 0
    exe_len_nonzero = ne exe_len, 0

    EXPAND ENV_BUFFER_FREE cwd_free_status, cwd_buffer
    EXPAND ENV_STATUS_IS_OK cwd_free_ok, cwd_free_status
    EXPAND ENV_BUFFER_FREE temp_free_status, temp_buffer
    EXPAND ENV_STATUS_IS_OK temp_free_ok, temp_free_status
    EXPAND ENV_BUFFER_FREE exe_free_status, exe_buffer
    EXPAND ENV_STATUS_IS_OK exe_free_ok, exe_free_status

    path01 = and cwd_buffer_nonzero, temp_buffer_nonzero
    path02 = and path01, exe_buffer_nonzero
    path03 = and path02, cwd_ptr_nonzero
    path04 = and path03, temp_ptr_nonzero
    path05 = and path04, exe_ptr_nonzero
    path06 = and path05, cwd_len_nonzero
    path07 = and path06, temp_len_nonzero
    path08 = and path07, exe_len_nonzero
    path09 = and path08, cwd_free_ok
    path10 = and path09, temp_free_ok
    path_ok = and path10, exe_free_ok

    !cwd_ptr
    !cwd_len
    !temp_ptr
    !temp_len
    !exe_ptr
    !exe_len
    !cwd_free_status
    !cwd_free_ok
    !temp_free_status
    !temp_free_ok
    !exe_free_status
    !exe_free_ok
    !cwd_buffer_nonzero
    !temp_buffer_nonzero
    !exe_buffer_nonzero
    !cwd_ptr_nonzero
    !temp_ptr_nonzero
    !exe_ptr_nonzero
    !cwd_len_nonzero
    !temp_len_nonzero
    !exe_len_nonzero
    !path01
    !path02
    !path03
    !path04
    !path05
    !path06
    !path07
    !path08
    !path09
    !path10

    br path_ok -> L_PATH_PASS, L_PATH_FAIL

L_PATH_FAIL:
    !path_ok
    panic(1006)

L_PATH_PASS:
    !path_ok
    return 0

@test "sa_std env XDG directory macros"():
L_XDG_ENTRY:
    data_home_key = stack_alloc Slice_SIZE
    config_home_key = stack_alloc Slice_SIZE
    state_home_key = stack_alloc Slice_SIZE
    cache_home_key = stack_alloc Slice_SIZE
    data_dirs_key = stack_alloc Slice_SIZE
    config_dirs_key = stack_alloc Slice_SIZE
    data_home_value = stack_alloc Slice_SIZE
    config_home_value = stack_alloc Slice_SIZE
    state_home_value = stack_alloc Slice_SIZE
    cache_home_value = stack_alloc Slice_SIZE
    data_dirs_value = stack_alloc Slice_SIZE
    config_dirs_value = stack_alloc Slice_SIZE
    data_dirs_default = stack_alloc Slice_SIZE
    config_dirs_default = stack_alloc Slice_SIZE

    EXPAND SLICE_NEW data_home_key, &XDG_DATA_HOME_KEY, XDG_DATA_HOME_KEY_LEN
    EXPAND SLICE_NEW config_home_key, &XDG_CONFIG_HOME_KEY, XDG_CONFIG_HOME_KEY_LEN
    EXPAND SLICE_NEW state_home_key, &XDG_STATE_HOME_KEY, XDG_STATE_HOME_KEY_LEN
    EXPAND SLICE_NEW cache_home_key, &XDG_CACHE_HOME_KEY, XDG_CACHE_HOME_KEY_LEN
    EXPAND SLICE_NEW data_dirs_key, &XDG_DATA_DIRS_KEY, XDG_DATA_DIRS_KEY_LEN
    EXPAND SLICE_NEW config_dirs_key, &XDG_CONFIG_DIRS_KEY, XDG_CONFIG_DIRS_KEY_LEN
    EXPAND SLICE_NEW data_home_value, &XDG_DATA_HOME_VALUE, XDG_DATA_HOME_VALUE_LEN
    EXPAND SLICE_NEW config_home_value, &XDG_CONFIG_HOME_VALUE, XDG_CONFIG_HOME_VALUE_LEN
    EXPAND SLICE_NEW state_home_value, &XDG_STATE_HOME_VALUE, XDG_STATE_HOME_VALUE_LEN
    EXPAND SLICE_NEW cache_home_value, &XDG_CACHE_HOME_VALUE, XDG_CACHE_HOME_VALUE_LEN
    EXPAND SLICE_NEW data_dirs_value, &XDG_DATA_DIRS_VALUE, XDG_DATA_DIRS_VALUE_LEN
    EXPAND SLICE_NEW config_dirs_value, &XDG_CONFIG_DIRS_VALUE, XDG_CONFIG_DIRS_VALUE_LEN
    EXPAND SLICE_NEW data_dirs_default, &XDG_DATA_DIRS_DEFAULT, XDG_DATA_DIRS_DEFAULT_LEN
    EXPAND SLICE_NEW config_dirs_default, &XDG_CONFIG_DIRS_DEFAULT, XDG_CONFIG_DIRS_DEFAULT_LEN
    EXPAND STR_EMPTY empty_value

    EXPAND ENV_SET_VAR set_data_home_status, data_home_key, data_home_value
    EXPAND ENV_SET_VAR set_config_home_status, config_home_key, config_home_value
    EXPAND ENV_SET_VAR set_state_home_status, state_home_key, state_home_value
    EXPAND ENV_SET_VAR set_cache_home_status, cache_home_key, cache_home_value
    EXPAND ENV_SET_VAR set_data_dirs_status, data_dirs_key, data_dirs_value
    EXPAND ENV_SET_VAR set_config_dirs_status, config_dirs_key, config_dirs_value

    data_home_slice = stack_alloc Slice_SIZE
    config_home_slice = stack_alloc Slice_SIZE
    state_home_slice = stack_alloc Slice_SIZE
    cache_home_slice = stack_alloc Slice_SIZE
    data_dirs_slice = stack_alloc Slice_SIZE
    config_dirs_slice = stack_alloc Slice_SIZE
    EXPAND ENV_XDG_DATA_HOME_DIR data_home_buffer
    EXPAND ENV_XDG_CONFIG_HOME_DIR config_home_buffer
    EXPAND ENV_XDG_STATE_HOME_DIR state_home_buffer
    EXPAND ENV_XDG_CACHE_HOME_DIR cache_home_buffer
    EXPAND ENV_XDG_DATA_DIRS data_dirs_buffer
    EXPAND ENV_XDG_CONFIG_DIRS config_dirs_buffer
    EXPAND ENV_BUFFER_AS_SLICE data_home_slice, data_home_buffer
    EXPAND ENV_BUFFER_AS_SLICE config_home_slice, config_home_buffer
    EXPAND ENV_BUFFER_AS_SLICE state_home_slice, state_home_buffer
    EXPAND ENV_BUFFER_AS_SLICE cache_home_slice, cache_home_buffer
    EXPAND ENV_BUFFER_AS_SLICE data_dirs_slice, data_dirs_buffer
    EXPAND ENV_BUFFER_AS_SLICE config_dirs_slice, config_dirs_buffer
    EXPAND STR_EQ data_home_eq, data_home_slice, data_home_value
    EXPAND STR_EQ config_home_eq, config_home_slice, config_home_value
    EXPAND STR_EQ state_home_eq, state_home_slice, state_home_value
    EXPAND STR_EQ cache_home_eq, cache_home_slice, cache_home_value
    EXPAND STR_EQ data_dirs_eq, data_dirs_slice, data_dirs_value
    EXPAND STR_EQ config_dirs_eq, config_dirs_slice, config_dirs_value

    EXPAND ENV_SET_VAR set_empty_data_dirs_status, data_dirs_key, empty_value
    EXPAND ENV_REMOVE_VAR remove_config_dirs_status, config_dirs_key
    default_data_dirs_slice = stack_alloc Slice_SIZE
    default_config_dirs_slice = stack_alloc Slice_SIZE
    EXPAND ENV_XDG_DATA_DIRS default_data_dirs_buffer
    EXPAND ENV_XDG_CONFIG_DIRS default_config_dirs_buffer
    EXPAND ENV_BUFFER_AS_SLICE default_data_dirs_slice, default_data_dirs_buffer
    EXPAND ENV_BUFFER_AS_SLICE default_config_dirs_slice, default_config_dirs_buffer
    EXPAND STR_EQ default_data_dirs_eq, default_data_dirs_slice, data_dirs_default
    EXPAND STR_EQ default_config_dirs_eq, default_config_dirs_slice, config_dirs_default

    EXPAND ENV_BUFFER_FREE data_home_free_status, data_home_buffer
    EXPAND ENV_BUFFER_FREE config_home_free_status, config_home_buffer
    EXPAND ENV_BUFFER_FREE state_home_free_status, state_home_buffer
    EXPAND ENV_BUFFER_FREE cache_home_free_status, cache_home_buffer
    EXPAND ENV_BUFFER_FREE data_dirs_free_status, data_dirs_buffer
    EXPAND ENV_BUFFER_FREE config_dirs_free_status, config_dirs_buffer
    EXPAND ENV_BUFFER_FREE default_data_dirs_free_status, default_data_dirs_buffer
    EXPAND ENV_BUFFER_FREE default_config_dirs_free_status, default_config_dirs_buffer
    EXPAND ENV_REMOVE_VAR cleanup_data_home_status, data_home_key
    EXPAND ENV_REMOVE_VAR cleanup_config_home_status, config_home_key
    EXPAND ENV_REMOVE_VAR cleanup_state_home_status, state_home_key
    EXPAND ENV_REMOVE_VAR cleanup_cache_home_status, cache_home_key
    EXPAND ENV_REMOVE_VAR cleanup_data_dirs_status, data_dirs_key
    EXPAND ENV_REMOVE_VAR cleanup_config_dirs_status, config_dirs_key

    EXPAND ENV_STATUS_IS_OK set_data_home_ok, set_data_home_status
    EXPAND ENV_STATUS_IS_OK set_config_home_ok, set_config_home_status
    EXPAND ENV_STATUS_IS_OK set_state_home_ok, set_state_home_status
    EXPAND ENV_STATUS_IS_OK set_cache_home_ok, set_cache_home_status
    EXPAND ENV_STATUS_IS_OK set_data_dirs_ok, set_data_dirs_status
    EXPAND ENV_STATUS_IS_OK set_config_dirs_ok, set_config_dirs_status
    EXPAND ENV_STATUS_IS_OK set_empty_data_dirs_ok, set_empty_data_dirs_status
    EXPAND ENV_STATUS_IS_OK remove_config_dirs_ok, remove_config_dirs_status
    EXPAND ENV_STATUS_IS_OK data_home_free_ok, data_home_free_status
    EXPAND ENV_STATUS_IS_OK config_home_free_ok, config_home_free_status
    EXPAND ENV_STATUS_IS_OK state_home_free_ok, state_home_free_status
    EXPAND ENV_STATUS_IS_OK cache_home_free_ok, cache_home_free_status
    EXPAND ENV_STATUS_IS_OK data_dirs_free_ok, data_dirs_free_status
    EXPAND ENV_STATUS_IS_OK config_dirs_free_ok, config_dirs_free_status
    EXPAND ENV_STATUS_IS_OK default_data_dirs_free_ok, default_data_dirs_free_status
    EXPAND ENV_STATUS_IS_OK default_config_dirs_free_ok, default_config_dirs_free_status

    ok01 = and set_data_home_ok, set_config_home_ok
    ok02 = and ok01, set_state_home_ok
    ok03 = and ok02, set_cache_home_ok
    ok04 = and ok03, set_data_dirs_ok
    ok05 = and ok04, set_config_dirs_ok
    ok06 = and ok05, data_home_eq
    ok07 = and ok06, config_home_eq
    ok08 = and ok07, state_home_eq
    ok09 = and ok08, cache_home_eq
    ok10 = and ok09, data_dirs_eq
    ok11 = and ok10, config_dirs_eq
    ok12 = and ok11, set_empty_data_dirs_ok
    ok13 = and ok12, remove_config_dirs_ok
    ok14 = and ok13, default_data_dirs_eq
    ok15 = and ok14, default_config_dirs_eq
    ok16 = and ok15, data_home_free_ok
    ok17 = and ok16, config_home_free_ok
    ok18 = and ok17, state_home_free_ok
    ok19 = and ok18, cache_home_free_ok
    ok20 = and ok19, data_dirs_free_ok
    ok21 = and ok20, config_dirs_free_ok
    ok22 = and ok21, default_data_dirs_free_ok
    ok = and ok22, default_config_dirs_free_ok

    !set_data_home_status
    !set_config_home_status
    !set_state_home_status
    !set_cache_home_status
    !set_data_dirs_status
    !set_config_dirs_status
    !data_home_eq
    !config_home_eq
    !state_home_eq
    !cache_home_eq
    !data_dirs_eq
    !config_dirs_eq
    !set_empty_data_dirs_status
    !remove_config_dirs_status
    !default_data_dirs_eq
    !default_config_dirs_eq
    !data_home_free_status
    !config_home_free_status
    !state_home_free_status
    !cache_home_free_status
    !data_dirs_free_status
    !config_dirs_free_status
    !default_data_dirs_free_status
    !default_config_dirs_free_status
    !cleanup_data_home_status
    !cleanup_config_home_status
    !cleanup_state_home_status
    !cleanup_cache_home_status
    !cleanup_data_dirs_status
    !cleanup_config_dirs_status
    !set_data_home_ok
    !set_config_home_ok
    !set_state_home_ok
    !set_cache_home_ok
    !set_data_dirs_ok
    !set_config_dirs_ok
    !set_empty_data_dirs_ok
    !remove_config_dirs_ok
    !data_home_free_ok
    !config_home_free_ok
    !state_home_free_ok
    !cache_home_free_ok
