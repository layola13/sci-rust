    EXPAND ENV_STATUS_IS_OK free1_ok, free1
    ok01 = and ok_match, ok_len
    ok02 = and ok01, free0_ok
    ok = and ok02, free1_ok
    !home_len
    !home_os_len
    !free0
    !free1
    !free0_ok
    !free1_ok
    !ok01
    !ok02
    jmp L_CHECK

L_NO_HOME:
    ok = and ok_match, 1
    !home_buf
    !home_os_buf

L_CHECK:
    !home_ok
    !home_os_ok
    !ok_match
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10442)
L_OK:
    !ok
    return


@test "sa_std env xdg *_os aliases"():
L_ENTRY:
    EXPAND ENV_XDG_DATA_HOME_DIR data0
    EXPAND ENV_XDG_DATA_HOME_DIR_OS data1
    EXPAND ENV_BUFFER_LEN data0_len, data0
    EXPAND ENV_BUFFER_LEN data1_len, data1
