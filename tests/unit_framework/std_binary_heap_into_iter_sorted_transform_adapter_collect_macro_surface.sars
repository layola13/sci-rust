@import "sa_std/collections/binary_heap.sars"

@sorted_adapter_inspect(value: u64) -> u64:
L_ENTRY:
    !value
    return 1

@sorted_adapter_scan(&state_ptr: ptr, value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    state = load state_ptr+0 as u64
    next = add state, value
    store state_ptr+0, next as u64
    keep = ule next, 9
    br keep -> L_SORTED_SCAN_KEEP, L_SORTED_SCAN_STOP
L_SORTED_SCAN_KEEP:
    mapped = add next, 100
    store out_mapped+0, mapped as u64
    !mapped
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 1
L_SORTED_SCAN_STOP:
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 0

@test "sa_std binary_heap into_iter_sorted inspect scan step_by collect macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW inspect_heap
    EXPAND BINARY_HEAP_PUSH_U64 inspect_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 inspect_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 inspect_heap, 6
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 inspect_iter, inspect_backing, inspect_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_INSPECT_COLLECT_U64 inspect_vec, inspect_iter, @sorted_adapter_inspect
    EXPAND VEC_GET_U64 inspect_0, inspect_vec, 0
    EXPAND VEC_GET_U64 inspect_2, inspect_vec, 2
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 inspect_empty, inspect_iter

    EXPAND BINARY_HEAP_NEW scan_heap
    EXPAND BINARY_HEAP_PUSH_U64 scan_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 scan_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 scan_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 scan_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 scan_heap, 5
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 scan_iter, scan_backing, scan_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_SCAN_COLLECT_U64 scan_vec, scan_iter, 0, @sorted_adapter_scan
    EXPAND VEC_GET_U64 scan_0, scan_vec, 0
    EXPAND VEC_GET_U64 scan_1, scan_vec, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 scan_remaining, scan_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 scan_tail_has, scan_tail, scan_iter

    EXPAND BINARY_HEAP_NEW step_heap
    EXPAND BINARY_HEAP_PUSH_U64 step_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 step_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 step_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 step_heap, 7
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 step_iter, step_backing, step_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_STEP_BY_COLLECT_U64 step_vec, step_iter, 2
    EXPAND VEC_GET_U64 step_0, step_vec, 0
    EXPAND VEC_GET_U64 step_1, step_vec, 1
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 step_empty, step_iter

    EXPAND BINARY_HEAP_NEW invalid_heap
    EXPAND BINARY_HEAP_PUSH_U64 invalid_heap, 8
    EXPAND BINARY_HEAP_PUSH_U64 invalid_heap, 9
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 invalid_iter, invalid_backing, invalid_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_TRY_STEP_BY_COLLECT_U64 invalid_ok, invalid_vec, invalid_iter, 0
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 invalid_next_has, invalid_next, invalid_iter

    EXPAND VEC_FREE inspect_backing
    EXPAND VEC_FREE inspect_vec
    EXPAND VEC_FREE scan_backing
    EXPAND VEC_FREE scan_vec
    EXPAND VEC_FREE step_backing
    EXPAND VEC_FREE step_vec
    EXPAND VEC_FREE invalid_backing
    EXPAND VEC_FREE invalid_vec

    ok = eq inspect_0, 6
    check = eq inspect_2, 2
    ok = and ok, check
    check = eq inspect_empty, 1
    ok = and ok, check
    check = eq scan_0, 105
    ok = and ok, check
    check = eq scan_1, 109
    ok = and ok, check
    check = eq scan_remaining, 2
    ok = and ok, check
    check = eq scan_tail_has, 1
    ok = and ok, check
    check = eq scan_tail, 2
    ok = and ok, check
    check = eq step_0, 7
    ok = and ok, check
    check = eq step_1, 3
    ok = and ok, check
    check = eq step_empty, 1
    ok = and ok, check
    check = eq invalid_ok, 0
    ok = and ok, check
    check = eq invalid_next_has, 1
    ok = and ok, check
    check = eq invalid_next, 9
    ok = and ok, check

    !inspect_0
    !inspect_2
    !inspect_empty
    !scan_0
    !scan_1
    !scan_remaining
    !scan_tail_has
    !scan_tail
    !step_0
    !step_1
    !step_empty
    !invalid_ok
    !invalid_next_has
    !invalid_next
    !check
    !inspect_iter
    !scan_iter
    !step_iter
    !invalid_iter
    br ok -> L_SORTED_ADAPTER_OK, L_SORTED_ADAPTER_FAIL
L_SORTED_ADAPTER_FAIL:
    !ok
    panic(10786)
L_SORTED_ADAPTER_OK:
    !ok
    return
