@import "sa_std/array.sars"

@array_into_iter_accumulate_tens(acc: u64, value: u64) -> u64:
L_ENTRY:
    scaled = mul value, 10
    out = add acc, scaled
    !scaled
    return out

@array_into_iter_try_accumulate_lt_four(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_ARRAY_TRY_FOLD_KEEP, L_ARRAY_TRY_FOLD_STOP
L_ARRAY_TRY_FOLD_KEEP:
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep
L_ARRAY_TRY_FOLD_STOP:
    !out_next
    !value
    !acc
    return keep

@array_into_iter_try_accumulate_lt_ten(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 10
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep

@test "sa_std array into_iter fold macro surface"():
L_ENTRY:
    fold_arr = stack_alloc 24
    store fold_arr+0, 1 as u64
    store fold_arr+8, 2 as u64
    store fold_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 fold_iter, fold_backing, fold_arr, 3
    EXPAND ARRAY_INTO_ITER_FOLD_U64 fold_value, fold_iter, 1, @array_into_iter_accumulate_tens
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 fold_empty, fold_iter

    rfold_arr = stack_alloc 24
    store rfold_arr+0, 1 as u64
    store rfold_arr+8, 2 as u64
    store rfold_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 rfold_iter, rfold_backing, rfold_arr, 3
    EXPAND ARRAY_INTO_ITER_RFOLD_U64 rfold_value, rfold_iter, 1, @array_into_iter_accumulate_tens
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 rfold_empty, rfold_iter

    try_stop_arr = stack_alloc 32
    store try_stop_arr+0, 1 as u64
    store try_stop_arr+8, 2 as u64
    store try_stop_arr+16, 3 as u64
    store try_stop_arr+24, 4 as u64
    EXPAND ARRAY_INTO_ITER_U64 try_stop_iter, try_stop_backing, try_stop_arr, 4
    EXPAND ARRAY_INTO_ITER_TRY_FOLD_U64 try_stop_ok, try_stop_value, try_stop_iter, 1, @array_into_iter_try_accumulate_lt_four
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 try_stop_remaining, try_stop_iter
    EXPAND ARRAY_INTO_ITER_NEXT_U64 try_stop_next_has, try_stop_next, try_stop_iter

    try_all_arr = stack_alloc 24
    store try_all_arr+0, 1 as u64
    store try_all_arr+8, 2 as u64
    store try_all_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 try_all_iter, try_all_backing, try_all_arr, 3
    EXPAND ARRAY_INTO_ITER_TRY_FOLD_U64 try_all_ok, try_all_value, try_all_iter, 1, @array_into_iter_try_accumulate_lt_ten
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 try_all_empty, try_all_iter

    try_rstop_arr = stack_alloc 24
    store try_rstop_arr+0, 1 as u64
    store try_rstop_arr+8, 2 as u64
    store try_rstop_arr+16, 4 as u64
    EXPAND ARRAY_INTO_ITER_U64 try_rstop_iter, try_rstop_backing, try_rstop_arr, 3
    EXPAND ARRAY_INTO_ITER_TRY_RFOLD_U64 try_rstop_ok, try_rstop_value, try_rstop_iter, 1, @array_into_iter_try_accumulate_lt_four
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_LEN_U64 try_rstop_remaining, try_rstop_iter
    EXPAND ARRAY_INTO_ITER_NEXT_BACK_U64 try_rstop_back_has, try_rstop_back, try_rstop_iter

    try_rall_arr = stack_alloc 24
    store try_rall_arr+0, 1 as u64
    store try_rall_arr+8, 2 as u64
    store try_rall_arr+16, 3 as u64
    EXPAND ARRAY_INTO_ITER_U64 try_rall_iter, try_rall_backing, try_rall_arr, 3
    EXPAND ARRAY_INTO_ITER_TRY_RFOLD_U64 try_rall_ok, try_rall_value, try_rall_iter, 1, @array_into_iter_try_accumulate_lt_ten
    EXPAND ARRAY_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 try_rall_empty, try_rall_iter

    EXPAND VEC_FREE fold_backing
    EXPAND VEC_FREE rfold_backing
    EXPAND VEC_FREE try_stop_backing
    EXPAND VEC_FREE try_all_backing
    EXPAND VEC_FREE try_rstop_backing
    EXPAND VEC_FREE try_rall_backing

    ok_fold_value = eq fold_value, 61
    ok_fold_empty = eq fold_empty, 1
    ok_rfold_value = eq rfold_value, 61
    ok_rfold_empty = eq rfold_empty, 1
    ok_try_stop_flag = eq try_stop_ok, 0
    ok_try_stop_value = eq try_stop_value, 61
    ok_try_stop_remaining = eq try_stop_remaining, 0
    ok_try_stop_next_flag = eq try_stop_next_has, 0
    ok_try_stop_next = eq try_stop_next, 0
    ok_try_all_flag = eq try_all_ok, 1
    ok_try_all_value = eq try_all_value, 61
    ok_try_all_empty = eq try_all_empty, 1
    ok_try_rstop_flag = eq try_rstop_ok, 0
    ok_try_rstop_value = eq try_rstop_value, 1
    ok_try_rstop_remaining = eq try_rstop_remaining, 2
    ok_try_rstop_back_flag = eq try_rstop_back_has, 1
    ok_try_rstop_back = eq try_rstop_back, 2
    ok_try_rall_flag = eq try_rall_ok, 1
    ok_try_rall_value = eq try_rall_value, 61
    ok_try_rall_empty = eq try_rall_empty, 1

    ok = and ok_fold_value, ok_fold_empty
    ok = and ok, ok_rfold_value
    ok = and ok, ok_rfold_empty
    ok = and ok, ok_try_stop_flag
    ok = and ok, ok_try_stop_value
    ok = and ok, ok_try_stop_remaining
    ok = and ok, ok_try_stop_next_flag
    ok = and ok, ok_try_stop_next
    ok = and ok, ok_try_all_flag
    ok = and ok, ok_try_all_value
    ok = and ok, ok_try_all_empty
    ok = and ok, ok_try_rstop_flag
    ok = and ok, ok_try_rstop_value
    ok = and ok, ok_try_rstop_remaining
    ok = and ok, ok_try_rstop_back_flag
    ok = and ok, ok_try_rstop_back
    ok = and ok, ok_try_rall_flag
    ok = and ok, ok_try_rall_value
    ok = and ok, ok_try_rall_empty

    !fold_value
    !fold_empty
    !rfold_value
    !rfold_empty
    !try_stop_ok
    !try_stop_value
    !try_stop_remaining
    !try_stop_next_has
    !try_stop_next
    !try_all_ok
    !try_all_value
    !try_all_empty
    !try_rstop_ok
    !try_rstop_value
    !try_rstop_remaining
    !try_rstop_back_has
    !try_rstop_back
    !try_rall_ok
    !try_rall_value
    !try_rall_empty
    !ok_fold_value
    !ok_fold_empty
    !ok_rfold_value
    !ok_rfold_empty
    !ok_try_stop_flag
    !ok_try_stop_value
    !ok_try_stop_remaining
    !ok_try_stop_next_flag
    !ok_try_stop_next
    !ok_try_all_flag
    !ok_try_all_value
    !ok_try_all_empty
    !ok_try_rstop_flag
    !ok_try_rstop_value
    !ok_try_rstop_remaining
    !ok_try_rstop_back_flag
    !ok_try_rstop_back
    !ok_try_rall_flag
    !ok_try_rall_value
    !ok_try_rall_empty
    !fold_iter
    !rfold_iter
    !try_stop_iter
    !try_all_iter
    !try_rstop_iter
    !try_rall_iter
    br ok -> L_ARRAY_INTO_ITER_FOLD_OK, L_ARRAY_INTO_ITER_FOLD_FAIL

L_ARRAY_INTO_ITER_FOLD_FAIL:
    !ok
    panic(10739)

L_ARRAY_INTO_ITER_FOLD_OK:
    !ok
    return
