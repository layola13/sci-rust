@import "sa_std/num.sars"

@test "sa_std SaturatingI64 arithmetic macro surface"():
L_ENTRY:
    lhs = stack_alloc SaturatingI64_SIZE
    rhs = stack_alloc SaturatingI64_SIZE
    out = stack_alloc SaturatingI64_SIZE

    EXPAND SATURATING_I64_NEW lhs, NUM_I64_MAX
    EXPAND SATURATING_I64_NEW rhs, 1
    EXPAND SATURATING_I64_ADD out, lhs, rhs
    add_value = load out+SaturatingI64_value as i64

    EXPAND SATURATING_I64_NEW lhs, NUM_I64_MIN
    EXPAND SATURATING_I64_NEW rhs, 1
    EXPAND SATURATING_I64_SUB out, lhs, rhs
    sub_value = load out+SaturatingI64_value as i64

    EXPAND SATURATING_I64_NEW lhs, NUM_I64_MAX
    EXPAND SATURATING_I64_NEW rhs, 2
    EXPAND SATURATING_I64_MUL out, lhs, rhs
    mul_value = load out+SaturatingI64_value as i64

    EXPAND SATURATING_I64_SET out, -7
    set_value = load out+SaturatingI64_value as i64

    ok01 = eq add_value, NUM_I64_MAX
    ok02 = eq sub_value, NUM_I64_MIN
    ok03 = eq mul_value, NUM_I64_MAX
    ok04 = eq set_value, -7
    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    ok = and chain02, ok04

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10682)

L_PASS:
    return 0
