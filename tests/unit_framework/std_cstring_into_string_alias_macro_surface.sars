@import "sa_std/ffi.sars"
@import "sa_std/core/slice.sars"

@test "sa_std cstring into_string alias"():
L_ENTRY:
    cbuf = stack_alloc 4
    store cbuf+0, 104 as u8
    store cbuf+1, 105 as u8
    store cbuf+2, 0 as u8
    slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW slice, cbuf, 3
    cstring = stack_alloc CString_SIZE
    EXPAND CSTRING_FROM_BYTES_WITH_NUL st, cstring, slice
    out = stack_alloc Slice_SIZE
    EXPAND CSTRING_INTO_STRING st2, out, cstring
    EXPAND SLICE_GET_LEN ln, out
    a = eq st, CSTR_FROM_BYTES_OK
    b = eq st2, CSTR_FROM_BYTES_OK
    c = eq ln, 2
    ok01 = and a, b
    ok = and ok01, c
    !st
    !st2
    !ln
    !a
    !b
    !c
    !ok01
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10900)
