@import "sa_std/time.sars"
@import "sa_std/hash.sars"

@test "sa_std Instant and SystemTime hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    EXPAND TIME_DURATION_NEW instant_ns, 12, 345
    EXPAND TIME_DURATION_NEW same_instant_ns, 12, 345
    EXPAND TIME_DURATION_NEW diff_instant_nanos_ns, 12, 346
    EXPAND TIME_DURATION_NEW diff_instant_secs_ns, 13, 345
    EXPAND TIME_SYSTEM_TIME_FROM_UNIX_NS system_ns, instant_ns
    EXPAND TIME_SYSTEM_TIME_FROM_UNIX_NS same_system_ns, same_instant_ns
    EXPAND TIME_SYSTEM_TIME_FROM_UNIX_NS diff_system_nanos_ns, diff_instant_nanos_ns
    EXPAND TIME_SYSTEM_TIME_FROM_UNIX_NS diff_system_secs_ns, diff_instant_secs_ns

    instant_secs = udiv instant_ns, Time_NS_PER_S
    instant_nanos = urem instant_ns, Time_NS_PER_S

    manual_instant_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW manual_instant_hasher
    EXPAND DEFAULT_HASHER_WRITE_I64 manual_instant_hasher, instant_secs
    EXPAND DEFAULT_HASHER_WRITE_U32 manual_instant_hasher, instant_nanos
    EXPAND DEFAULT_HASHER_FINISH manual_instant_hash, manual_instant_hasher

    writer_instant_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW writer_instant_hasher
    EXPAND DEFAULT_HASHER_WRITE_INSTANT writer_instant_hasher, instant_ns
    EXPAND DEFAULT_HASHER_FINISH writer_instant_hash, writer_instant_hasher

    EXPAND TIME_INSTANT_HASH instant_hash, instant_ns
    EXPAND TIME_INSTANT_HASH same_instant_hash, same_instant_ns
    EXPAND TIME_INSTANT_HASH diff_instant_nanos_hash, diff_instant_nanos_ns
    EXPAND TIME_INSTANT_HASH diff_instant_secs_hash, diff_instant_secs_ns
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_INSTANT build_instant_hash, builder, instant_ns

    system_secs = udiv system_ns, Time_NS_PER_S
    system_nanos = urem system_ns, Time_NS_PER_S

    manual_system_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW manual_system_hasher
    EXPAND DEFAULT_HASHER_WRITE_I64 manual_system_hasher, system_secs
    EXPAND DEFAULT_HASHER_WRITE_U32 manual_system_hasher, system_nanos
    EXPAND DEFAULT_HASHER_FINISH manual_system_hash, manual_system_hasher

    writer_system_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW writer_system_hasher
    EXPAND DEFAULT_HASHER_WRITE_SYSTEM_TIME writer_system_hasher, system_ns
    EXPAND DEFAULT_HASHER_FINISH writer_system_hash, writer_system_hasher

    EXPAND TIME_SYSTEM_TIME_HASH system_hash, system_ns
    EXPAND TIME_SYSTEM_TIME_HASH same_system_hash, same_system_ns
    EXPAND TIME_SYSTEM_TIME_HASH diff_system_nanos_hash, diff_system_nanos_ns
    EXPAND TIME_SYSTEM_TIME_HASH diff_system_secs_hash, diff_system_secs_ns
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_SYSTEM_TIME build_system_hash, builder, system_ns

    state = stack_alloc RandomState_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 444, 555
    EXPAND RANDOM_STATE_HASH_ONE_INSTANT state_instant_hash, state, instant_ns
    state_instant_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD state_instant_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_INSTANT state_instant_hasher, instant_ns
    EXPAND DEFAULT_HASHER_FINISH manual_state_instant_hash, state_instant_hasher
    EXPAND RANDOM_STATE_HASH_ONE_SYSTEM_TIME state_system_hash, state, system_ns
    state_system_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD state_system_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_SYSTEM_TIME state_system_hasher, system_ns
    EXPAND DEFAULT_HASHER_FINISH manual_state_system_hash, state_system_hasher

    instant_writer_matches = eq writer_instant_hash, instant_hash
    instant_manual_matches = eq manual_instant_hash, instant_hash
    instant_same_matches = eq same_instant_hash, instant_hash
    instant_nanos_matters = ne diff_instant_nanos_hash, instant_hash
    instant_secs_matters = ne diff_instant_secs_hash, instant_hash
    instant_build_matches = eq build_instant_hash, instant_hash
    instant_state_matches = eq state_instant_hash, manual_state_instant_hash

    system_writer_matches = eq writer_system_hash, system_hash
    system_manual_matches = eq manual_system_hash, system_hash
    system_same_matches = eq same_system_hash, system_hash
    system_nanos_matters = ne diff_system_nanos_hash, system_hash
    system_secs_matters = ne diff_system_secs_hash, system_hash
    system_build_matches = eq build_system_hash, system_hash
    system_state_matches = eq state_system_hash, manual_state_system_hash

    i01 = and instant_writer_matches, instant_manual_matches
    i02 = and i01, instant_same_matches
    i03 = and i02, instant_nanos_matters
    i04 = and i03, instant_secs_matters
    i05 = and i04, instant_build_matches
    instant_ok = and i05, instant_state_matches

    s01 = and system_writer_matches, system_manual_matches
    s02 = and s01, system_same_matches
    s03 = and s02, system_nanos_matters
    s04 = and s03, system_secs_matters
    s05 = and s04, system_build_matches
    system_ok = and s05, system_state_matches

    ok = and instant_ok, system_ok

    !instant_ns
    !same_instant_ns
    !diff_instant_nanos_ns
    !diff_instant_secs_ns
    !system_ns
    !same_system_ns
    !diff_system_nanos_ns
    !diff_system_secs_ns
    !instant_secs
    !instant_nanos
    !manual_instant_hash
    !writer_instant_hash
    !instant_hash
    !same_instant_hash
    !diff_instant_nanos_hash
    !diff_instant_secs_hash
    !build_instant_hash
    !system_secs
    !system_nanos
    !manual_system_hash
    !writer_system_hash
    !system_hash
    !same_system_hash
    !diff_system_nanos_hash
    !diff_system_secs_hash
    !build_system_hash
    !state_instant_hash
    !manual_state_instant_hash
    !state_system_hash
    !manual_state_system_hash
    !instant_writer_matches
    !instant_manual_matches
    !instant_same_matches
    !instant_nanos_matters
    !instant_secs_matters
    !instant_build_matches
    !instant_state_matches
    !system_writer_matches
    !system_manual_matches
    !system_same_matches
    !system_nanos_matters
    !system_secs_matters
    !system_build_matches
    !system_state_matches
    !i01
    !i02
    !i03
    !i04
    !i05
    !instant_ok
    !s01
    !s02
    !s03
    !s04
    !s05
    !system_ok
    !builder

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10593)

L_PASS:
    !ok
    return 0
