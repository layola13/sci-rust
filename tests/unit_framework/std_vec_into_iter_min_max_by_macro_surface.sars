@import "sa_std/vec.sars"

@vec_into_iter_compare_u64(left: u64, right: u64) -> i64:
L_ENTRY:
    is_less = ult left, right
    br is_less -> L_VEC_COMPARE_LESS, L_VEC_COMPARE_CHECK_GREATER
L_VEC_COMPARE_LESS:
    out_less = sub 0, 1
    !is_less
    !right
    !left
    return out_less
L_VEC_COMPARE_CHECK_GREATER:
    is_greater = ugt left, right
    br is_greater -> L_VEC_COMPARE_GREATER, L_VEC_COMPARE_EQUAL
L_VEC_COMPARE_GREATER:
    out_greater = add 0, 1
    !is_greater
    !is_less
    !right
    !left
    return out_greater
L_VEC_COMPARE_EQUAL:
    out_equal = add 0, 0
    !is_greater
    !is_less
    !right
    !left
    return out_equal

@vec_into_iter_key_ones(value: u64) -> u64:
L_ENTRY:
    out = urem value, 10
    !value
    return out

@test "sa_std vec into_iter min max by macro surface"():
L_ENTRY:
    EXPAND VEC_NEW min_by_vec
    EXPAND VEC_PUSH_U64 min_by_vec, 8
    EXPAND VEC_PUSH_U64 min_by_vec, 3
    EXPAND VEC_PUSH_U64 min_by_vec, 5
    EXPAND VEC_INTO_ITER_U64 min_by_iter, min_by_backing, min_by_vec
    EXPAND VEC_INTO_ITER_MIN_BY_U64 min_by_ok, min_by_value, min_by_iter, @vec_into_iter_compare_u64
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 min_by_empty, min_by_iter

    EXPAND VEC_NEW max_by_vec
    EXPAND VEC_PUSH_U64 max_by_vec, 8
    EXPAND VEC_PUSH_U64 max_by_vec, 3
    EXPAND VEC_PUSH_U64 max_by_vec, 5
    EXPAND VEC_INTO_ITER_U64 max_by_iter, max_by_backing, max_by_vec
    EXPAND VEC_INTO_ITER_MAX_BY_U64 max_by_ok, max_by_value, max_by_iter, @vec_into_iter_compare_u64
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 max_by_empty, max_by_iter

    EXPAND VEC_NEW min_key_vec
    EXPAND VEC_PUSH_U64 min_key_vec, 29
    EXPAND VEC_PUSH_U64 min_key_vec, 34
    EXPAND VEC_PUSH_U64 min_key_vec, 42
    EXPAND VEC_PUSH_U64 min_key_vec, 51
    EXPAND VEC_INTO_ITER_U64 min_key_iter, min_key_backing, min_key_vec
    EXPAND VEC_INTO_ITER_MIN_BY_KEY_U64 min_key_ok, min_key_value, min_key_iter, @vec_into_iter_key_ones
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 min_key_empty, min_key_iter

    EXPAND VEC_NEW max_key_vec
    EXPAND VEC_PUSH_U64 max_key_vec, 21
    EXPAND VEC_PUSH_U64 max_key_vec, 38
    EXPAND VEC_PUSH_U64 max_key_vec, 47
    EXPAND VEC_PUSH_U64 max_key_vec, 55
    EXPAND VEC_INTO_ITER_U64 max_key_iter, max_key_backing, max_key_vec
    EXPAND VEC_INTO_ITER_MAX_BY_KEY_U64 max_key_ok, max_key_value, max_key_iter, @vec_into_iter_key_ones
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 max_key_empty, max_key_iter

    EXPAND VEC_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND VEC_INTO_ITER_MIN_BY_U64 empty_min_ok, empty_min_value, empty_iter, @vec_into_iter_compare_u64
    EXPAND VEC_INTO_ITER_MAX_BY_KEY_U64 empty_max_key_ok, empty_max_key_value, empty_iter, @vec_into_iter_key_ones

    EXPAND VEC_FREE min_by_backing
    EXPAND VEC_FREE max_by_backing
    EXPAND VEC_FREE min_key_backing
    EXPAND VEC_FREE max_key_backing
    EXPAND VEC_FREE empty_backing

    ok_min_by_flag = eq min_by_ok, 1
    ok_min_by_value = eq min_by_value, 3
    ok_min_by_empty = eq min_by_empty, 1
    ok_max_by_flag = eq max_by_ok, 1
    ok_max_by_value = eq max_by_value, 8
    ok_max_by_empty = eq max_by_empty, 1
    ok_min_key_flag = eq min_key_ok, 1
    ok_min_key_value = eq min_key_value, 51
    ok_min_key_empty = eq min_key_empty, 1
    ok_max_key_flag = eq max_key_ok, 1
    ok_max_key_value = eq max_key_value, 38
    ok_max_key_empty = eq max_key_empty, 1
    ok_empty_min_flag = eq empty_min_ok, 0
    ok_empty_min_value = eq empty_min_value, 0
    ok_empty_max_key_flag = eq empty_max_key_ok, 0
    ok_empty_max_key_value = eq empty_max_key_value, 0

    ok = and ok_min_by_flag, ok_min_by_value
    ok = and ok, ok_min_by_empty
    ok = and ok, ok_max_by_flag
    ok = and ok, ok_max_by_value
    ok = and ok, ok_max_by_empty
    ok = and ok, ok_min_key_flag
    ok = and ok, ok_min_key_value
    ok = and ok, ok_min_key_empty
    ok = and ok, ok_max_key_flag
    ok = and ok, ok_max_key_value
    ok = and ok, ok_max_key_empty
    ok = and ok, ok_empty_min_flag
    ok = and ok, ok_empty_min_value
    ok = and ok, ok_empty_max_key_flag
    ok = and ok, ok_empty_max_key_value

    !min_by_ok
    !min_by_value
    !min_by_empty
    !max_by_ok
    !max_by_value
    !max_by_empty
    !min_key_ok
    !min_key_value
    !min_key_empty
    !max_key_ok
    !max_key_value
    !max_key_empty
    !empty_min_ok
    !empty_min_value
    !empty_max_key_ok
    !empty_max_key_value
    !ok_min_by_flag
    !ok_min_by_value
    !ok_min_by_empty
    !ok_max_by_flag
    !ok_max_by_value
    !ok_max_by_empty
    !ok_min_key_flag
    !ok_min_key_value
    !ok_min_key_empty
    !ok_max_key_flag
    !ok_max_key_value
    !ok_max_key_empty
    !ok_empty_min_flag
    !ok_empty_min_value
    !ok_empty_max_key_flag
    !ok_empty_max_key_value
    !min_by_iter
    !max_by_iter
    !min_key_iter
    !max_key_iter
    !empty_iter
    br ok -> L_VEC_INTO_ITER_MIN_MAX_BY_OK, L_VEC_INTO_ITER_MIN_MAX_BY_FAIL

L_VEC_INTO_ITER_MIN_MAX_BY_FAIL:
    !ok
    panic(10717)

L_VEC_INTO_ITER_MIN_MAX_BY_OK:
    !ok
    return
