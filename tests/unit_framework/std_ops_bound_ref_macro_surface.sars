@import "sa_std/ops.sars"

@test "sa_std ops Bound as_ref as_mut copied cloned macros"():
L_ENTRY:
    included = stack_alloc BoundU64_SIZE
    excluded = stack_alloc BoundU64_SIZE
    unbounded = stack_alloc BoundU64_SIZE
    included_ref = stack_alloc BoundU64Ref_SIZE
    excluded_ref = stack_alloc BoundU64Ref_SIZE
    unbounded_ref = stack_alloc BoundU64Ref_SIZE
    included_mut = stack_alloc BoundU64Ref_SIZE
    copied = stack_alloc BoundU64_SIZE
    cloned = stack_alloc BoundU64_SIZE
    copied_unbounded = stack_alloc BoundU64_SIZE

    included_usize = stack_alloc BoundUsize_SIZE
    included_usize_ref = stack_alloc BoundUsizeRef_SIZE
    cloned_usize = stack_alloc BoundUsize_SIZE

    EXPAND BOUND_U64_INCLUDED_NEW included, 5
    EXPAND BOUND_U64_EXCLUDED_NEW excluded, 7
    EXPAND BOUND_U64_UNBOUNDED_NEW unbounded
    EXPAND BOUND_USIZE_INCLUDED_NEW included_usize, 11

    EXPAND BOUND_U64_AS_REF included_ref, included
    EXPAND BOUND_U64_AS_REF excluded_ref, excluded
    EXPAND BOUND_U64_AS_REF unbounded_ref, unbounded
    EXPAND BOUND_U64_AS_MUT included_mut, included
    EXPAND BOUND_USIZE_AS_REF included_usize_ref, included_usize

    EXPAND BOUND_U64_REF_TAG included_ref_tag, included_ref
    EXPAND BOUND_U64_REF_PTR included_ref_ptr, included_ref
    included_ref_value = load included_ref_ptr+0 as u64
    EXPAND BOUND_U64_REF_TAG excluded_ref_tag, excluded_ref
    EXPAND BOUND_U64_REF_PTR excluded_ref_ptr, excluded_ref
    excluded_ref_value = load excluded_ref_ptr+0 as u64
    EXPAND BOUND_U64_REF_TAG unbounded_ref_tag, unbounded_ref
    raw_unbounded_ref_ptr = load unbounded_ref+BoundU64Ref_ptr as u64

    EXPAND BOUND_U64_REF_PTR included_mut_ptr, included_mut
    store included_mut_ptr+0, 17 as u64
    EXPAND BOUND_U64_VALUE mutated_value, included

    EXPAND BOUND_U64_REF_COPIED copied, included_ref
    EXPAND BOUND_U64_REF_CLONED cloned, excluded_ref
    EXPAND BOUND_U64_REF_COPIED copied_unbounded, unbounded_ref
    EXPAND BOUND_U64_TAG copied_tag, copied
    EXPAND BOUND_U64_VALUE copied_value, copied
    EXPAND BOUND_U64_TAG cloned_tag, cloned
    EXPAND BOUND_U64_VALUE cloned_value, cloned
    EXPAND BOUND_U64_TAG copied_unbounded_tag, copied_unbounded
    EXPAND BOUND_U64_VALUE copied_unbounded_value, copied_unbounded

    EXPAND BOUND_USIZE_REF_TAG included_usize_ref_tag, included_usize_ref
    EXPAND BOUND_USIZE_REF_PTR included_usize_ref_ptr, included_usize_ref
    included_usize_ref_value = load included_usize_ref_ptr+0 as u64
    EXPAND BOUND_USIZE_REF_CLONED cloned_usize, included_usize_ref
    EXPAND BOUND_USIZE_TAG cloned_usize_tag, cloned_usize
    EXPAND BOUND_USIZE_VALUE cloned_usize_value, cloned_usize

    ok_layout_size = eq BoundU64Ref_SIZE, 16
    ok_layout_tag = eq BoundU64Ref_tag, +0
    ok_layout_ptr = eq BoundU64Ref_ptr, +8
    ok_usize_layout = eq BoundUsizeRef_SIZE, 16
    ok_included_ref_tag = eq included_ref_tag, BOUND_U64_INCLUDED
    ok_included_ref_value = eq included_ref_value, 5
    ok_excluded_ref_tag = eq excluded_ref_tag, BOUND_U64_EXCLUDED
    ok_excluded_ref_value = eq excluded_ref_value, 7
    ok_unbounded_ref_tag = eq unbounded_ref_tag, BOUND_U64_UNBOUNDED
    ok_unbounded_ref_ptr = eq raw_unbounded_ref_ptr, 0
    ok_mutated_value = eq mutated_value, 17
    ok_copied_tag = eq copied_tag, BOUND_U64_INCLUDED
    ok_copied_value = eq copied_value, 17
    ok_cloned_tag = eq cloned_tag, BOUND_U64_EXCLUDED
    ok_cloned_value = eq cloned_value, 7
    ok_copied_unbounded_tag = eq copied_unbounded_tag, BOUND_U64_UNBOUNDED
    ok_copied_unbounded_value = eq copied_unbounded_value, 0
    ok_usize_ref_tag = eq included_usize_ref_tag, BOUND_USIZE_INCLUDED
    ok_usize_ref_value = eq included_usize_ref_value, 11
    ok_cloned_usize_tag = eq cloned_usize_tag, BOUND_USIZE_INCLUDED
    ok_cloned_usize_value = eq cloned_usize_value, 11

    !included_usize_ref_ptr
    !included_mut_ptr
    !excluded_ref_ptr
    !included_ref_ptr

    c01 = and ok_layout_size, ok_layout_tag
    c02 = and c01, ok_layout_ptr
    c03 = and c02, ok_usize_layout
    c04 = and c03, ok_included_ref_tag
    c05 = and c04, ok_included_ref_value
    c06 = and c05, ok_excluded_ref_tag
    c07 = and c06, ok_excluded_ref_value
    c08 = and c07, ok_unbounded_ref_tag
    c09 = and c08, ok_unbounded_ref_ptr
    c10 = and c09, ok_mutated_value
    c11 = and c10, ok_copied_tag
    c12 = and c11, ok_copied_value
    c13 = and c12, ok_cloned_tag
    c14 = and c13, ok_cloned_value
    c15 = and c14, ok_copied_unbounded_tag
    c16 = and c15, ok_copied_unbounded_value
    c17 = and c16, ok_usize_ref_tag
    c18 = and c17, ok_usize_ref_value
    c19 = and c18, ok_cloned_usize_tag
    ok = and c19, ok_cloned_usize_value

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10515)

L_PASS:
    return 0
