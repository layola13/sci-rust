@import "sa_std/vec_deque.sars"

@test "sa_std vec_deque iterator adapter collect macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY take_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK take_deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK take_deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK take_deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK take_deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT take_pop_ok, take_pop_value, take_deque
    EXPAND VEC_DEQUE_PUSH_BACK take_deque, 50
    EXPAND VEC_DEQUE_PUSH_BACK take_deque, 60
    EXPAND VEC_DEQUE_ITER_U64 take_iter, take_backing, take_deque
    EXPAND VEC_DEQUE_ITER_TAKE_COLLECT_U64 take_vec, take_iter, 2
    EXPAND VEC_LEN take_len, take_vec
    EXPAND VEC_GET_U64 take_0, take_vec, 0
    EXPAND VEC_GET_U64 take_1, take_vec, 1
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 take_remaining, take_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 take_next_has, take_next, take_iter

    EXPAND VEC_DEQUE_ITER_U64 take_all_iter, take_all_backing, take_deque
    EXPAND VEC_DEQUE_ITER_TAKE_COLLECT_U64 take_all_vec, take_all_iter, 9
    EXPAND VEC_LEN take_all_len, take_all_vec
    EXPAND VEC_GET_U64 take_all_4, take_all_vec, 4
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 take_all_empty, take_all_iter

    EXPAND VEC_DEQUE_ITER_U64 skip_iter, skip_backing, take_deque
    EXPAND VEC_DEQUE_ITER_SKIP_COLLECT_U64 skip_vec, skip_iter, 2
    EXPAND VEC_LEN skip_len, skip_vec
    EXPAND VEC_GET_U64 skip_0, skip_vec, 0
    EXPAND VEC_GET_U64 skip_2, skip_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_empty, skip_iter

    EXPAND VEC_DEQUE_ITER_U64 skip_all_iter, skip_all_backing, take_deque
    EXPAND VEC_DEQUE_ITER_SKIP_COLLECT_U64 skip_all_vec, skip_all_iter, 9
    EXPAND VEC_LEN skip_all_len, skip_all_vec
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 skip_all_empty, skip_all_iter

    EXPAND VEC_DEQUE_ITER_U64 rev_iter, rev_backing, take_deque
    EXPAND VEC_DEQUE_ITER_REV_COLLECT_U64 rev_vec, rev_iter
    EXPAND VEC_LEN rev_len, rev_vec
    EXPAND VEC_GET_U64 rev_0, rev_vec, 0
    EXPAND VEC_GET_U64 rev_4, rev_vec, 4
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 rev_empty, rev_iter

    EXPAND VEC_DEQUE_ITER_U64 step2_iter, step2_backing, take_deque
    EXPAND VEC_DEQUE_ITER_STEP_BY_COLLECT_U64 step2_vec, step2_iter, 2
    EXPAND VEC_LEN step2_len, step2_vec
    EXPAND VEC_GET_U64 step2_0, step2_vec, 0
    EXPAND VEC_GET_U64 step2_1, step2_vec, 1
    EXPAND VEC_GET_U64 step2_2, step2_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 step2_empty, step2_iter

    EXPAND VEC_DEQUE_ITER_U64 step3_iter, step3_backing, take_deque
    EXPAND VEC_DEQUE_ITER_TRY_STEP_BY_COLLECT_U64 step3_ok, step3_vec, step3_iter, 3
    EXPAND VEC_LEN step3_len, step3_vec
    EXPAND VEC_GET_U64 step3_0, step3_vec, 0
    EXPAND VEC_GET_U64 step3_1, step3_vec, 1
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 step3_empty, step3_iter

    EXPAND VEC_DEQUE_ITER_U64 invalid_iter, invalid_backing, take_deque
    EXPAND VEC_DEQUE_ITER_TRY_STEP_BY_COLLECT_U64 invalid_ok, invalid_vec, invalid_iter, 0
    EXPAND VEC_LEN invalid_len, invalid_vec
    EXPAND VEC_DEQUE_ITER_NEXT_U64 invalid_next_has, invalid_next, invalid_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 4
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_REV_COLLECT_U64 into_rev_vec, into_iter
    EXPAND VEC_LEN into_rev_len, into_rev_vec
    EXPAND VEC_GET_U64 into_rev_0, into_rev_vec, 0
    EXPAND VEC_GET_U64 into_rev_3, into_rev_vec, 3
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_FREE take_backing
    EXPAND VEC_FREE take_vec
    EXPAND VEC_FREE take_all_backing
    EXPAND VEC_FREE take_all_vec
    EXPAND VEC_FREE skip_backing
    EXPAND VEC_FREE skip_vec
    EXPAND VEC_FREE skip_all_backing
    EXPAND VEC_FREE skip_all_vec
    EXPAND VEC_FREE rev_backing
    EXPAND VEC_FREE rev_vec
    EXPAND VEC_FREE step2_backing
    EXPAND VEC_FREE step2_vec
    EXPAND VEC_FREE step3_backing
    EXPAND VEC_FREE step3_vec
    EXPAND VEC_FREE invalid_backing
    EXPAND VEC_FREE invalid_vec
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_rev_vec
    EXPAND VEC_DEQUE_FREE take_deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq take_pop_ok, 1
    check = eq take_pop_value, 10
    ok = and ok, check
    check = eq take_len, 2
    ok = and ok, check
    check = eq take_0, 20
    ok = and ok, check
    check = eq take_1, 30
    ok = and ok, check
    check = eq take_remaining, 3
    ok = and ok, check
    check = eq take_next_has, 1
    ok = and ok, check
    check = eq take_next, 40
    ok = and ok, check
    check = eq take_all_len, 5
    ok = and ok, check
    check = eq take_all_4, 60
    ok = and ok, check
    check = eq take_all_empty, 1
    ok = and ok, check
    check = eq skip_len, 3
    ok = and ok, check
    check = eq skip_0, 40
    ok = and ok, check
    check = eq skip_2, 60
    ok = and ok, check
    check = eq skip_empty, 1
    ok = and ok, check
    check = eq skip_all_len, 0
    ok = and ok, check
    check = eq skip_all_empty, 1
    ok = and ok, check
    check = eq rev_len, 5
    ok = and ok, check
    check = eq rev_0, 60
    ok = and ok, check
    check = eq rev_4, 20
    ok = and ok, check
    check = eq rev_empty, 1
    ok = and ok, check
    check = eq step2_len, 3
    ok = and ok, check
    check = eq step2_0, 20
    ok = and ok, check
    check = eq step2_1, 40
    ok = and ok, check
    check = eq step2_2, 60
    ok = and ok, check
    check = eq step2_empty, 1
    ok = and ok, check
    check = eq step3_ok, 1
    ok = and ok, check
    check = eq step3_len, 2
    ok = and ok, check
    check = eq step3_0, 20
    ok = and ok, check
    check = eq step3_1, 50
    ok = and ok, check
    check = eq step3_empty, 1
    ok = and ok, check
    check = eq invalid_ok, 0
    ok = and ok, check
    check = eq invalid_len, 0
    ok = and ok, check
    check = eq invalid_next_has, 1
    ok = and ok, check
    check = eq invalid_next, 20
    ok = and ok, check
    check = eq into_rev_len, 4
    ok = and ok, check
    check = eq into_rev_0, 4
    ok = and ok, check
    check = eq into_rev_3, 1
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check

    !take_pop_ok
    !take_pop_value
    !take_len
    !take_0
    !take_1
    !take_remaining
    !take_next_has
    !take_next
    !take_all_len
    !take_all_4
    !take_all_empty
    !skip_len
    !skip_0
    !skip_2
    !skip_empty
    !skip_all_len
    !skip_all_empty
    !rev_len
    !rev_0
    !rev_4
    !rev_empty
    !step2_len
    !step2_0
    !step2_1
    !step2_2
    !step2_empty
    !step3_ok
    !step3_len
    !step3_0
    !step3_1
    !step3_empty
    !invalid_ok
    !invalid_len
    !invalid_next_has
    !invalid_next
    !into_rev_len
    !into_rev_0
    !into_rev_3
    !into_empty
    !into_deque_empty
    !check
    !take_iter
    !take_all_iter
    !skip_iter
    !skip_all_iter
    !rev_iter
    !step2_iter
    !step3_iter
    !invalid_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_ADAPTER_OK, L_VEC_DEQUE_ITER_ADAPTER_FAIL
L_VEC_DEQUE_ITER_ADAPTER_FAIL:
    !ok
    panic(10793)
L_VEC_DEQUE_ITER_ADAPTER_OK:
    !ok
    return
