@import "sa_std/sync/condvar.sars"
@import "sa_std/sync/mutex.sars"

@test "sa_std condvar wait_timeout times out"():
L_ENTRY:
    EXPAND CONDVAR_NEW cond
    EXPAND MUTEX_NEW mutex
    EXPAND MUTEX_LOCK mutex
    // No notify: short timeout must return 0 (timeout).
    EXPAND CONDVAR_WAIT_TIMEOUT_NS notified, cond, mutex, 50000
    EXPAND CONDVAR_WAITERS waiters_after, cond
    EXPAND MUTEX_IS_LOCKED locked, mutex
    EXPAND MUTEX_UNLOCK mutex

    ok_to = eq notified, 0
    ok_waiters = eq waiters_after, 0
    ok_locked = eq locked, 1
    ok0 = and ok_to, ok_waiters
    ok = and ok0, ok_locked

    !notified
    !waiters_after
    !locked
    !ok_to
    !ok_waiters
    !ok_locked
    !ok0
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10871)

@test "sa_std condvar wait_timeout notified"():
L_ENTRY:
    EXPAND CONDVAR_NEW cond
    EXPAND MUTEX_NEW mutex
    EXPAND MUTEX_LOCK mutex
    EXPAND CONDVAR_NOTIFY_ONE cond
    EXPAND CONDVAR_WAIT_TIMEOUT_NS notified, cond, mutex, 1000000000
    EXPAND CONDVAR_WAITERS waiters_after, cond
    EXPAND MUTEX_UNLOCK mutex

    ok_notified = eq notified, 1
    ok_waiters = eq waiters_after, 0
    ok = and ok_notified, ok_waiters
    !notified
    !waiters_after
    !ok_notified
    !ok_waiters
    br ok -> L_OK, L_FAIL

L_OK:
    !ok
    return 0

L_FAIL:
    !ok
    panic(10872)
