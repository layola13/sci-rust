@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const S = utf8:"hello world"
@const N = utf8:"world"
@const B = utf8:"xyz"

@test "sa_std string contains"():
L_ENTRY:
    EXPAND STR_FROM_PARTS s, &S, 11
    EXPAND STR_FROM_PARTS n, &N, 5
    EXPAND STR_FROM_PARTS b, &B, 3
    EXPAND STR_CONTAINS hit, s, n
    EXPAND STR_CONTAINS miss, s, b
    a = eq hit, 1
    c = eq miss, 0
    ok = and a, c
    !hit
    !miss
    !a
    !c
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10993)
