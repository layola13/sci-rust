@import "sa_std/hash.sars"

@test "sa_std hash tuple2 u64 macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    manual_hasher = stack_alloc DefaultHasher_SIZE
    state = stack_alloc RandomState_SIZE
    state_manual_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW manual_hasher
    EXPAND DEFAULT_HASHER_WRITE_U64 manual_hasher, 7
    EXPAND DEFAULT_HASHER_WRITE_U64 manual_hasher, 9
    EXPAND DEFAULT_HASHER_FINISH manual_hash, manual_hasher

    EXPAND HASH_TUPLE2_U64 tuple_hash, 7, 9
    EXPAND HASH_TUPLE2_U64 tuple_swapped_hash, 9, 7
    EXPAND HASH_TUPLE2_U64 tuple_other_hash, 7, 10
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_TUPLE2_U64 build_tuple_hash, builder, 7, 9

    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_TUPLE2_U64 state_tuple_hash, state, 7, 9
    EXPAND RANDOM_STATE_BUILD state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_TUPLE2_U64 state_manual_hasher, 7, 9
    EXPAND DEFAULT_HASHER_FINISH state_manual_hash, state_manual_hasher

    matches_manual = eq tuple_hash, manual_hash
    build_matches = eq build_tuple_hash, tuple_hash
    state_matches = eq state_tuple_hash, state_manual_hash
    order_matters = ne tuple_hash, tuple_swapped_hash
    value_matters = ne tuple_hash, tuple_other_hash
    seeded_differs_default = ne state_tuple_hash, tuple_hash

    c01 = and matches_manual, build_matches
    c02 = and c01, state_matches
    c03 = and c02, order_matters
    c04 = and c03, value_matters
    ok = and c04, seeded_differs_default

    !builder
    !manual_hash
    !tuple_hash
    !tuple_swapped_hash
    !tuple_other_hash
    !build_tuple_hash
    !state_tuple_hash
    !state_manual_hash
    !matches_manual
    !build_matches
    !state_matches
    !order_matters
    !value_matters
    !seeded_differs_default
    !c01
    !c02
    !c03
    !c04
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10565)

L_PASS:
    !ok
    return 0
