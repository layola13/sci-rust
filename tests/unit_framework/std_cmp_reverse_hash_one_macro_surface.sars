@import "sa_std/cmp.sars"

@test "sa_std cmp Reverse hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    state = stack_alloc RandomState_SIZE
    EXPAND RANDOM_STATE_WITH_SEEDS state, 31, 32

    rev_u64 = stack_alloc CmpReverseU64_SIZE
    rev_u64_other = stack_alloc CmpReverseU64_SIZE
    EXPAND CMP_REVERSE_U64_NEW rev_u64, 42
    EXPAND CMP_REVERSE_U64_NEW rev_u64_other, 43

    u64_writer_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW u64_writer_hasher
    EXPAND DEFAULT_HASHER_WRITE_CMP_REVERSE_U64 u64_writer_hasher, rev_u64
    EXPAND DEFAULT_HASHER_FINISH u64_writer_hash, u64_writer_hasher
    EXPAND CMP_REVERSE_U64_HASH u64_hash, rev_u64
    EXPAND CMP_REVERSE_U64_HASH u64_other_hash, rev_u64_other
    EXPAND HASH_U64 primitive_u64_hash, 42
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_CMP_REVERSE_U64 u64_build_hash, builder, rev_u64
    EXPAND RANDOM_STATE_HASH_ONE_CMP_REVERSE_U64 u64_state_hash, state, rev_u64

    u64_state_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD u64_state_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_U64 u64_state_hasher, 42
    EXPAND DEFAULT_HASHER_FINISH u64_manual_state_hash, u64_state_hasher

    rev_i64 = stack_alloc CmpReverseI64_SIZE
    rev_i64_other = stack_alloc CmpReverseI64_SIZE
    neg_42 = sub 0, 42
    neg_43 = sub 0, 43
    EXPAND CMP_REVERSE_I64_NEW rev_i64, neg_42
    EXPAND CMP_REVERSE_I64_NEW rev_i64_other, neg_43

    i64_writer_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW i64_writer_hasher
    EXPAND DEFAULT_HASHER_WRITE_CMP_REVERSE_I64 i64_writer_hasher, rev_i64
    EXPAND DEFAULT_HASHER_FINISH i64_writer_hash, i64_writer_hasher
    EXPAND CMP_REVERSE_I64_HASH i64_hash, rev_i64
    EXPAND CMP_REVERSE_I64_HASH i64_other_hash, rev_i64_other
    EXPAND HASH_I64 primitive_i64_hash, neg_42
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_CMP_REVERSE_I64 i64_build_hash, builder, rev_i64
    EXPAND RANDOM_STATE_HASH_ONE_CMP_REVERSE_I64 i64_state_hash, state, rev_i64

    i64_state_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD i64_state_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_I64 i64_state_hasher, neg_42
    EXPAND DEFAULT_HASHER_FINISH i64_manual_state_hash, i64_state_hasher

    ok_u64_writer = eq u64_writer_hash, u64_hash
    ok_u64_primitive = eq u64_hash, primitive_u64_hash
    ok_u64_value = ne u64_hash, u64_other_hash
    ok_u64_build = eq u64_build_hash, u64_hash
    ok_u64_state = eq u64_state_hash, u64_manual_state_hash

    ok_i64_writer = eq i64_writer_hash, i64_hash
    ok_i64_primitive = eq i64_hash, primitive_i64_hash
    ok_i64_value = ne i64_hash, i64_other_hash
    ok_i64_build = eq i64_build_hash, i64_hash
    ok_i64_state = eq i64_state_hash, i64_manual_state_hash

    c01 = and ok_u64_writer, ok_u64_primitive
    c02 = and c01, ok_u64_value
    c03 = and c02, ok_u64_build
    c04 = and c03, ok_u64_state
    c05 = and c04, ok_i64_writer
    c06 = and c05, ok_i64_primitive
    c07 = and c06, ok_i64_value
    c08 = and c07, ok_i64_build
    ok = and c08, ok_i64_state

    !builder
    !u64_writer_hash
    !u64_hash
    !u64_other_hash
    !primitive_u64_hash
    !u64_build_hash
    !u64_state_hash
    !u64_manual_state_hash
    !neg_42
    !neg_43
    !i64_writer_hash
    !i64_hash
    !i64_other_hash
    !primitive_i64_hash
    !i64_build_hash
    !i64_state_hash
    !i64_manual_state_hash
    !ok_u64_writer
    !ok_u64_primitive
    !ok_u64_value
    !ok_u64_build
    !ok_u64_state
    !ok_i64_writer
    !ok_i64_primitive
    !ok_i64_value
    !ok_i64_build
    !ok_i64_state
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10597)

L_PASS:
    !ok
    return 0
