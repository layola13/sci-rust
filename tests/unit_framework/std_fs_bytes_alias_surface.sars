@import "sa_std/fs.sars"

@test "sa_std fs byte aliases expand"():
L_ENTRY:
    [IF 0]
    EXPAND FS_READ_BYTES read_status, read_len, 0, read_buf, 8
    EXPAND FS_READ_EXACT_BYTES exact_status, 0, read_buf, 8
    EXPAND FS_READ_AT_BYTES read_at_status, read_at_len, 0, read_buf, 8, 0
    EXPAND FS_READ_EXACT_AT_BYTES exact_at_status, 0, read_buf, 8, 0
    EXPAND FS_WRITE_BYTES write_status, write_len, 0, write_buf, 8
    EXPAND FS_WRITE_ALL_BYTES write_all_status, 0, write_buf, 8
    EXPAND FS_WRITE_AT_BYTES write_at_status, write_at_len, 0, write_buf, 8, 0
    EXPAND FS_WRITE_ALL_AT_BYTES write_all_at_status, 0, write_buf, 8, 0
    EXPAND FS_READ_FILE_BYTES file_status, file_buf, path, 4, 32
    EXPAND FS_WRITE_FILE_BYTES file_write_status, path, 4, write_buf, 8
    [END_IF]
    return 0
