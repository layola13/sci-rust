@import "sa_std/num.sars"

@test "sa_std narrow unsigned primitive unchecked macro surface"():
L_ENTRY:
    EXPAND NUM_U8_UNCHECKED_ADD u8_add, 7, 5
    EXPAND NUM_U8_UNCHECKED_SUB u8_sub, 7, 5
    EXPAND NUM_U8_UNCHECKED_MUL u8_mul, 7, 6
    EXPAND NUM_U8_UNCHECKED_DIV u8_div, 42, 7
    EXPAND NUM_U8_UNCHECKED_REM u8_rem, 43, 7
    EXPAND NUM_U8_UNCHECKED_SHL u8_shl, 3, 4
    EXPAND NUM_U8_UNCHECKED_SHR u8_shr, 128, 3

    EXPAND NUM_U16_UNCHECKED_ADD u16_add, 1000, 234
    EXPAND NUM_U16_UNCHECKED_SUB u16_sub, 1000, 234
    EXPAND NUM_U16_UNCHECKED_MUL u16_mul, 300, 200
    EXPAND NUM_U16_UNCHECKED_DIV u16_div, 60000, 300
    EXPAND NUM_U16_UNCHECKED_REM u16_rem, 60001, 300
    EXPAND NUM_U16_UNCHECKED_SHL u16_shl, 1, 12
    EXPAND NUM_U16_UNCHECKED_SHR u16_shr, 32768, 12

    EXPAND NUM_U32_UNCHECKED_ADD u32_add, 100000, 234567
    EXPAND NUM_U32_UNCHECKED_SUB u32_sub, 334567, 234567
    EXPAND NUM_U32_UNCHECKED_MUL u32_mul, 60000, 70000
    EXPAND NUM_U32_UNCHECKED_DIV u32_div, 4200000000, 70000
    EXPAND NUM_U32_UNCHECKED_REM u32_rem, 4200000001, 70000
    EXPAND NUM_U32_UNCHECKED_SHL u32_shl, 1, 31
    EXPAND NUM_U32_UNCHECKED_SHR u32_shr, 2147483648, 31

    ok01 = eq u8_add, 12
    ok02 = eq u8_sub, 2
    ok03 = eq u8_mul, 42
    ok04 = eq u8_div, 6
    ok05 = eq u8_rem, 1
    ok06 = eq u8_shl, 48
    ok07 = eq u8_shr, 16

    ok08 = eq u16_add, 1234
    ok09 = eq u16_sub, 766
    ok10 = eq u16_mul, 60000
    ok11 = eq u16_div, 200
    ok12 = eq u16_rem, 1
    ok13 = eq u16_shl, 4096
    ok14 = eq u16_shr, 8

    ok15 = eq u32_add, 334567
    ok16 = eq u32_sub, 100000
    ok17 = eq u32_mul, 4200000000
    ok18 = eq u32_div, 60000
    ok19 = eq u32_rem, 1
    ok20 = eq u32_shl, 2147483648
    ok21 = eq u32_shr, 1

    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    chain03 = and chain02, ok04
    chain04 = and chain03, ok05
    chain05 = and chain04, ok06
    chain06 = and chain05, ok07
    chain07 = and chain06, ok08
    chain08 = and chain07, ok09
    chain09 = and chain08, ok10
    chain10 = and chain09, ok11
    chain11 = and chain10, ok12
    chain12 = and chain11, ok13
    chain13 = and chain12, ok14
    chain14 = and chain13, ok15
    chain15 = and chain14, ok16
    chain16 = and chain15, ok17
    chain17 = and chain16, ok18
    chain18 = and chain17, ok19
    chain19 = and chain18, ok20
    ok = and chain19, ok21

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10669)

L_PASS:
    !ok
    return 0
