@import "sa_std/vec.sars"

@test "sa_std vec into_iter pair collect macro surface"():
L_ENTRY:
    EXPAND VEC_NEW enumerate_src
    EXPAND VEC_PUSH_U64 enumerate_src, 5
    EXPAND VEC_PUSH_U64 enumerate_src, 6
    EXPAND VEC_PUSH_U64 enumerate_src, 7
    EXPAND VEC_INTO_ITER_U64 enumerate_iter, enumerate_backing, enumerate_src
    EXPAND VEC_INTO_ITER_NEXT_U64 enumerate_skip_has, enumerate_skip, enumerate_iter
    EXPAND VEC_INTO_ITER_ENUMERATE_COLLECT_U64 enumerate_vec, enumerate_iter
    EXPAND VEC_LEN enumerate_len, enumerate_vec
    EXPAND VEC_GET_U64 enumerate_0, enumerate_vec, 0
    EXPAND VEC_GET_U64 enumerate_1, enumerate_vec, 1
    EXPAND VEC_GET_U64 enumerate_2, enumerate_vec, 2
    EXPAND VEC_GET_U64 enumerate_3, enumerate_vec, 3
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 enumerate_empty, enumerate_iter

    EXPAND VEC_NEW zip_left_src
    EXPAND VEC_PUSH_U64 zip_left_src, 1
    EXPAND VEC_PUSH_U64 zip_left_src, 2
    EXPAND VEC_PUSH_U64 zip_left_src, 3
    EXPAND VEC_PUSH_U64 zip_left_src, 4
    EXPAND VEC_NEW zip_right_src
    EXPAND VEC_PUSH_U64 zip_right_src, 10
    EXPAND VEC_PUSH_U64 zip_right_src, 20
    EXPAND VEC_INTO_ITER_U64 zip_left_iter, zip_left_backing, zip_left_src
    EXPAND VEC_INTO_ITER_U64 zip_right_iter, zip_right_backing, zip_right_src
    EXPAND VEC_INTO_ITER_ZIP_COLLECT_U64 zip_vec, zip_left_iter, zip_right_iter
    EXPAND VEC_LEN zip_len, zip_vec
    EXPAND VEC_GET_U64 zip_0, zip_vec, 0
    EXPAND VEC_GET_U64 zip_1, zip_vec, 1
    EXPAND VEC_GET_U64 zip_2, zip_vec, 2
    EXPAND VEC_GET_U64 zip_3, zip_vec, 3
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 zip_left_remaining, zip_left_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 zip_left_tail_has, zip_left_tail, zip_left_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 zip_right_empty, zip_right_iter

    EXPAND VEC_NEW chain_left_src
    EXPAND VEC_PUSH_U64 chain_left_src, 8
    EXPAND VEC_PUSH_U64 chain_left_src, 9
    EXPAND VEC_NEW chain_right_src
    EXPAND VEC_PUSH_U64 chain_right_src, 30
    EXPAND VEC_PUSH_U64 chain_right_src, 40
    EXPAND VEC_PUSH_U64 chain_right_src, 50
    EXPAND VEC_INTO_ITER_U64 chain_left_iter, chain_left_backing, chain_left_src
    EXPAND VEC_INTO_ITER_U64 chain_right_iter, chain_right_backing, chain_right_src
    EXPAND VEC_INTO_ITER_CHAIN_COLLECT_U64 chain_vec, chain_left_iter, chain_right_iter
    EXPAND VEC_LEN chain_len, chain_vec
    EXPAND VEC_GET_U64 chain_0, chain_vec, 0
    EXPAND VEC_GET_U64 chain_1, chain_vec, 1
    EXPAND VEC_GET_U64 chain_2, chain_vec, 2
    EXPAND VEC_GET_U64 chain_4, chain_vec, 4
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 chain_left_empty, chain_left_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 chain_right_empty, chain_right_iter

    EXPAND VEC_FREE enumerate_backing
    EXPAND VEC_FREE enumerate_vec
    EXPAND VEC_FREE zip_left_backing
    EXPAND VEC_FREE zip_right_backing
    EXPAND VEC_FREE zip_vec
    EXPAND VEC_FREE chain_left_backing
    EXPAND VEC_FREE chain_right_backing
    EXPAND VEC_FREE chain_vec

    ok_enumerate_skip_has = eq enumerate_skip_has, 1
    ok_enumerate_skip = eq enumerate_skip, 5
    ok_enumerate_len = eq enumerate_len, 4
    ok_enumerate_0 = eq enumerate_0, 0
    ok_enumerate_1 = eq enumerate_1, 6
    ok_enumerate_2 = eq enumerate_2, 1
    ok_enumerate_3 = eq enumerate_3, 7
    ok_enumerate_empty = eq enumerate_empty, 1
    ok_zip_len = eq zip_len, 4
    ok_zip_0 = eq zip_0, 1
    ok_zip_1 = eq zip_1, 10
    ok_zip_2 = eq zip_2, 2
    ok_zip_3 = eq zip_3, 20
    ok_zip_left_remaining = eq zip_left_remaining, 1
    ok_zip_left_tail_has = eq zip_left_tail_has, 1
    ok_zip_left_tail = eq zip_left_tail, 4
    ok_zip_right_empty = eq zip_right_empty, 1
    ok_chain_len = eq chain_len, 5
    ok_chain_0 = eq chain_0, 8
    ok_chain_1 = eq chain_1, 9
    ok_chain_2 = eq chain_2, 30
    ok_chain_4 = eq chain_4, 50
    ok_chain_left_empty = eq chain_left_empty, 1
    ok_chain_right_empty = eq chain_right_empty, 1

    ok = and ok_enumerate_skip_has, ok_enumerate_skip
    ok = and ok, ok_enumerate_len
    ok = and ok, ok_enumerate_0
    ok = and ok, ok_enumerate_1
    ok = and ok, ok_enumerate_2
    ok = and ok, ok_enumerate_3
    ok = and ok, ok_enumerate_empty
    ok = and ok, ok_zip_len
    ok = and ok, ok_zip_0
    ok = and ok, ok_zip_1
    ok = and ok, ok_zip_2
    ok = and ok, ok_zip_3
    ok = and ok, ok_zip_left_remaining
    ok = and ok, ok_zip_left_tail_has
    ok = and ok, ok_zip_left_tail
    ok = and ok, ok_zip_right_empty
    ok = and ok, ok_chain_len
    ok = and ok, ok_chain_0
    ok = and ok, ok_chain_1
    ok = and ok, ok_chain_2
    ok = and ok, ok_chain_4
    ok = and ok, ok_chain_left_empty
    ok = and ok, ok_chain_right_empty

    !enumerate_skip_has
    !enumerate_skip
    !enumerate_len
    !enumerate_0
    !enumerate_1
    !enumerate_2
    !enumerate_3
    !enumerate_empty
    !zip_len
    !zip_0
    !zip_1
    !zip_2
    !zip_3
    !zip_left_remaining
    !zip_left_tail_has
    !zip_left_tail
    !zip_right_empty
    !chain_len
    !chain_0
    !chain_1
    !chain_2
    !chain_4
    !chain_left_empty
    !chain_right_empty
    !ok_enumerate_skip_has
    !ok_enumerate_skip
    !ok_enumerate_len
    !ok_enumerate_0
    !ok_enumerate_1
    !ok_enumerate_2
    !ok_enumerate_3
    !ok_enumerate_empty
    !ok_zip_len
    !ok_zip_0
    !ok_zip_1
    !ok_zip_2
    !ok_zip_3
    !ok_zip_left_remaining
    !ok_zip_left_tail_has
    !ok_zip_left_tail
    !ok_zip_right_empty
    !ok_chain_len
    !ok_chain_0
    !ok_chain_1
    !ok_chain_2
    !ok_chain_4
    !ok_chain_left_empty
    !ok_chain_right_empty
    !enumerate_iter
    !zip_left_iter
    !zip_right_iter
    !chain_left_iter
    !chain_right_iter
    br ok -> L_VEC_INTO_ITER_PAIR_COLLECT_OK, L_VEC_INTO_ITER_PAIR_COLLECT_FAIL

L_VEC_INTO_ITER_PAIR_COLLECT_FAIL:
    !ok
    panic(10724)

L_VEC_INTO_ITER_PAIR_COLLECT_OK:
    !ok
    return
