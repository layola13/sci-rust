@import "sa_std/vec_deque.sars"

@vec_deque_iter_sorted_le(left: u64, right: u64) -> u64:
L_ENTRY:
    out = ule left, right
    !right
    !left
    return out

@vec_deque_iter_sorted_lt(left: u64, right: u64) -> u64:
L_ENTRY:
    out = ult left, right
    !right
    !left
    return out

@vec_deque_iter_sorted_key_tens(value: u64) -> u64:
L_ENTRY:
    out = udiv value, 10
    !value
    return out

@vec_deque_iter_partition_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    !value
    return out

@vec_deque_iter_partition_gt_zero(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 0
    !value
    return out

@test "sa_std vec_deque iterator sorted partition macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY sorted_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK sorted_deque, 0
    EXPAND VEC_DEQUE_PUSH_BACK sorted_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK sorted_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK sorted_deque, 2
    EXPAND VEC_DEQUE_TRY_POP_FRONT sorted_pop_ok, sorted_pop_value, sorted_deque
    EXPAND VEC_DEQUE_PUSH_BACK sorted_deque, 4
    EXPAND VEC_DEQUE_ITER_U64 sorted_iter, sorted_backing, sorted_deque
    EXPAND VEC_DEQUE_ITER_IS_SORTED_U64 sorted_value, sorted_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 sorted_empty, sorted_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY unsorted_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK unsorted_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK unsorted_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK unsorted_deque, 3
    EXPAND VEC_DEQUE_ITER_U64 unsorted_iter, unsorted_backing, unsorted_deque
    EXPAND VEC_DEQUE_ITER_IS_SORTED_U64 unsorted_value, unsorted_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 unsorted_empty, unsorted_iter

    EXPAND VEC_DEQUE_ITER_U64 sorted_by_iter, sorted_by_backing, sorted_deque
    EXPAND VEC_DEQUE_ITER_IS_SORTED_BY_U64 sorted_by_value, sorted_by_iter, @vec_deque_iter_sorted_le
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 sorted_by_empty, sorted_by_iter
    EXPAND VEC_DEQUE_ITER_U64 unsorted_by_iter, unsorted_by_backing, sorted_deque
    EXPAND VEC_DEQUE_ITER_IS_SORTED_BY_U64 unsorted_by_value, unsorted_by_iter, @vec_deque_iter_sorted_lt
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 unsorted_by_empty, unsorted_by_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY key_sorted_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK key_sorted_deque, 11
    EXPAND VEC_DEQUE_PUSH_BACK key_sorted_deque, 19
    EXPAND VEC_DEQUE_PUSH_BACK key_sorted_deque, 22
    EXPAND VEC_DEQUE_PUSH_BACK key_sorted_deque, 35
    EXPAND VEC_DEQUE_ITER_U64 key_sorted_iter, key_sorted_backing, key_sorted_deque
    EXPAND VEC_DEQUE_ITER_IS_SORTED_BY_KEY_U64 key_sorted_value, key_sorted_iter, @vec_deque_iter_sorted_key_tens
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 key_sorted_empty, key_sorted_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY key_unsorted_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK key_unsorted_deque, 11
    EXPAND VEC_DEQUE_PUSH_BACK key_unsorted_deque, 35
    EXPAND VEC_DEQUE_PUSH_BACK key_unsorted_deque, 22
    EXPAND VEC_DEQUE_ITER_U64 key_unsorted_iter, key_unsorted_backing, key_unsorted_deque
    EXPAND VEC_DEQUE_ITER_IS_SORTED_BY_KEY_U64 key_unsorted_value, key_unsorted_iter, @vec_deque_iter_sorted_key_tens
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 key_unsorted_empty, key_unsorted_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY partition_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK partition_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK partition_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK partition_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK partition_deque, 4
    EXPAND VEC_DEQUE_TRY_POP_FRONT partition_pop_ok, partition_pop_value, partition_deque
    EXPAND VEC_DEQUE_PUSH_BACK partition_deque, 5
    EXPAND VEC_DEQUE_ITER_U64 partition_iter, partition_backing, partition_deque
    EXPAND VEC_DEQUE_ITER_PARTITION_U64 true_vec, false_vec, partition_iter, @vec_deque_iter_partition_is_even
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 partition_empty, partition_iter
    EXPAND VEC_LEN true_len, true_vec
    EXPAND VEC_LEN false_len, false_vec
    EXPAND VEC_GET_U64 true_0, true_vec, 0
    EXPAND VEC_GET_U64 true_1, true_vec, 1
    EXPAND VEC_GET_U64 false_0, false_vec, 0
    EXPAND VEC_GET_U64 false_1, false_vec, 1

    EXPAND VEC_DEQUE_WITH_CAPACITY partitioned_deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK partitioned_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK partitioned_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK partitioned_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK partitioned_deque, 0
    EXPAND VEC_DEQUE_PUSH_BACK partitioned_deque, 0
    EXPAND VEC_DEQUE_ITER_U64 partitioned_iter, partitioned_backing, partitioned_deque
    EXPAND VEC_DEQUE_ITER_IS_PARTITIONED_U64 partitioned_ok, partitioned_iter, @vec_deque_iter_partition_gt_zero
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 partitioned_empty, partitioned_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY not_partitioned_deque, 5
    EXPAND VEC_DEQUE_PUSH_BACK not_partitioned_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK not_partitioned_deque, 0
    EXPAND VEC_DEQUE_PUSH_BACK not_partitioned_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK not_partitioned_deque, 0
    EXPAND VEC_DEQUE_PUSH_BACK not_partitioned_deque, 0
    EXPAND VEC_DEQUE_ITER_U64 not_partitioned_iter, not_partitioned_backing, not_partitioned_deque
    EXPAND VEC_DEQUE_ITER_IS_PARTITIONED_U64 not_partitioned_ok, not_partitioned_iter, @vec_deque_iter_partition_gt_zero
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 not_partitioned_remaining, not_partitioned_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 not_partitioned_next_has, not_partitioned_next, not_partitioned_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 not_partitioned_next2_has, not_partitioned_next2, not_partitioned_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 not_partitioned_empty, not_partitioned_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 3
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_IS_SORTED_BY_U64 into_sorted_by_value, into_iter, @vec_deque_iter_sorted_le
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_DEQUE_WITH_CAPACITY into_partition_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_partition_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK into_partition_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_partition_deque, 4
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_partition_iter, into_partition_backing, into_partition_deque
    EXPAND VEC_DEQUE_INTO_ITER_PARTITION_U64 into_true_vec, into_false_vec, into_partition_iter, @vec_deque_iter_partition_is_even
    EXPAND VEC_LEN into_true_len, into_true_vec
    EXPAND VEC_LEN into_false_len, into_false_vec

    EXPAND VEC_FREE sorted_backing
    EXPAND VEC_FREE unsorted_backing
    EXPAND VEC_FREE sorted_by_backing
    EXPAND VEC_FREE unsorted_by_backing
    EXPAND VEC_FREE key_sorted_backing
    EXPAND VEC_FREE key_unsorted_backing
    EXPAND VEC_FREE partition_backing
    EXPAND VEC_FREE true_vec
    EXPAND VEC_FREE false_vec
    EXPAND VEC_FREE partitioned_backing
    EXPAND VEC_FREE not_partitioned_backing
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_partition_backing
    EXPAND VEC_FREE into_true_vec
    EXPAND VEC_FREE into_false_vec

    EXPAND VEC_DEQUE_FREE sorted_deque
    EXPAND VEC_DEQUE_FREE unsorted_deque
    EXPAND VEC_DEQUE_FREE key_sorted_deque
    EXPAND VEC_DEQUE_FREE key_unsorted_deque
    EXPAND VEC_DEQUE_FREE partition_deque
    EXPAND VEC_DEQUE_FREE partitioned_deque
    EXPAND VEC_DEQUE_FREE not_partitioned_deque
    EXPAND VEC_DEQUE_FREE into_deque
    EXPAND VEC_DEQUE_FREE into_partition_deque

    ok = eq sorted_pop_ok, 1
    check = eq sorted_pop_value, 0
    ok = and ok, check
    check = eq sorted_value, 1
    ok = and ok, check
    check = eq sorted_empty, 1
    ok = and ok, check
    check = eq unsorted_value, 0
    ok = and ok, check
    check = eq unsorted_empty, 1
    ok = and ok, check
    check = eq sorted_by_value, 1
    ok = and ok, check
    check = eq sorted_by_empty, 1
    ok = and ok, check
    check = eq unsorted_by_value, 0
    ok = and ok, check
    check = eq unsorted_by_empty, 1
    ok = and ok, check
    check = eq key_sorted_value, 1
    ok = and ok, check
    check = eq key_sorted_empty, 1
    ok = and ok, check
    check = eq key_unsorted_value, 0
    ok = and ok, check
    check = eq key_unsorted_empty, 1
    ok = and ok, check
    check = eq partition_pop_ok, 1
    ok = and ok, check
    check = eq partition_pop_value, 1
    ok = and ok, check
    check = eq partition_empty, 1
    ok = and ok, check
    check = eq true_len, 2
    ok = and ok, check
    check = eq false_len, 2
    ok = and ok, check
    check = eq true_0, 2
    ok = and ok, check
    check = eq true_1, 4
    ok = and ok, check
    check = eq false_0, 3
    ok = and ok, check
    check = eq false_1, 5
    ok = and ok, check
    check = eq partitioned_ok, 1
    ok = and ok, check
    check = eq partitioned_empty, 1
    ok = and ok, check
    check = eq not_partitioned_ok, 0
    ok = and ok, check
    check = eq not_partitioned_remaining, 2
    ok = and ok, check
    check = eq not_partitioned_next_has, 1
    ok = and ok, check
    check = eq not_partitioned_next, 0
    ok = and ok, check
    check = eq not_partitioned_next2_has, 1
    ok = and ok, check
    check = eq not_partitioned_next2, 0
    ok = and ok, check
    check = eq not_partitioned_empty, 1
    ok = and ok, check
    check = eq into_sorted_by_value, 1
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check
    check = eq into_true_len, 2
    ok = and ok, check
    check = eq into_false_len, 1
    ok = and ok, check

    !sorted_pop_ok
    !sorted_pop_value
    !partition_pop_ok
    !partition_pop_value
    !sorted_value
    !sorted_empty
    !unsorted_value
    !unsorted_empty
    !sorted_by_value
    !sorted_by_empty
    !unsorted_by_value
    !unsorted_by_empty
    !key_sorted_value
    !key_sorted_empty
    !key_unsorted_value
    !key_unsorted_empty
    !partition_empty
    !true_len
    !false_len
    !true_0
    !true_1
    !false_0
    !false_1
    !partitioned_ok
    !partitioned_empty
    !not_partitioned_ok
    !not_partitioned_remaining
    !not_partitioned_next_has
    !not_partitioned_next
    !not_partitioned_next2_has
    !not_partitioned_next2
    !not_partitioned_empty
    !into_sorted_by_value
    !into_empty
    !into_deque_empty
    !into_true_len
    !into_false_len
    !check
    !sorted_iter
    !unsorted_iter
    !sorted_by_iter
    !unsorted_by_iter
    !key_sorted_iter
    !key_unsorted_iter
    !partition_iter
    !partitioned_iter
    !not_partitioned_iter
    !into_iter
    !into_partition_iter
    br ok -> L_VEC_DEQUE_ITER_SORTED_PARTITION_OK, L_VEC_DEQUE_ITER_SORTED_PARTITION_FAIL
L_VEC_DEQUE_ITER_SORTED_PARTITION_FAIL:
    !ok
    panic(10792)
L_VEC_DEQUE_ITER_SORTED_PARTITION_OK:
    !ok
    return
