@import "sa_std/thread.sal"

@test "sa_std JoinHandle layout constants"():
L_ENTRY:
    ok_jh_size = eq JoinHandle_SIZE, 16
    ok_jh_handle = eq JoinHandle_handle, +0
    ok_jh_result = eq JoinHandle_result, +8
    ok_default_id = eq THREAD_DEFAULT_ID, 0

    c01 = and ok_jh_size, ok_jh_handle
    c02 = and c01, ok_jh_result
    c03 = and c02, ok_default_id

    br c03 -> L_PASS, L_FAIL

L_FAIL:
    panic(10490)

L_PASS:
    return 0
