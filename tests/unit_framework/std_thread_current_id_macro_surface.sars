@import "sa_std/thread.sars"

@test "sa_std thread current id"():
L_ENTRY:
    EXPAND THREAD_CURRENT_ID id1
    EXPAND THREAD_CURRENT id2
    a = ne id1, 0
    b = eq id1, id2
    ok = and a, b
    !id1
    !id2
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10915)
