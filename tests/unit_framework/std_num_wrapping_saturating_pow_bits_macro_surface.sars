@import "sa_std/num.sars"

@test "sa_std Wrapping and Saturating pow bits macro surface"():
L_ENTRY:
    wrap_u64 = stack_alloc WrappingU64_SIZE
    wrap_u64_pow2 = stack_alloc WrappingU64_SIZE
    wrap_u64_pow_out = stack_alloc WrappingU64_SIZE
    wrap_u32 = stack_alloc WrappingU32_SIZE
    wrap_u32_pow2 = stack_alloc WrappingU32_SIZE
    wrap_u32_pow_out = stack_alloc WrappingU32_SIZE
    wrap_i64 = stack_alloc WrappingI64_SIZE
    wrap_i64_pow_out = stack_alloc WrappingI64_SIZE
    sat_u64 = stack_alloc SaturatingU64_SIZE
    sat_u64_pow2 = stack_alloc SaturatingU64_SIZE
    sat_u64_not_pow2 = stack_alloc SaturatingU64_SIZE
    sat_u64_pow_out = stack_alloc SaturatingU64_SIZE
    sat_i64_max = stack_alloc SaturatingI64_SIZE
    sat_i64_neg = stack_alloc SaturatingI64_SIZE
    sat_i64_pow_max_out = stack_alloc SaturatingI64_SIZE
    sat_i64_pow_min_out = stack_alloc SaturatingI64_SIZE

    EXPAND WRAPPING_U64_NEW wrap_u64, 3
    EXPAND WRAPPING_U64_NEW wrap_u64_pow2, 16
    EXPAND WRAPPING_U64_POW wrap_u64_pow_out, wrap_u64, 5
    EXPAND WRAPPING_U64_GET wrap_u64_pow_value, wrap_u64_pow_out
    EXPAND WRAPPING_U64_IS_POWER_OF_TWO wrap_u64_pow2_true, wrap_u64_pow2
    EXPAND WRAPPING_U64_IS_POWER_OF_TWO wrap_u64_pow2_false, wrap_u64

    EXPAND WRAPPING_U32_NEW wrap_u32, 4294967299
    EXPAND WRAPPING_U32_NEW wrap_u32_pow2, 4294967304
    EXPAND WRAPPING_U32_POW wrap_u32_pow_out, wrap_u32, 5
    EXPAND WRAPPING_U32_GET wrap_u32_pow_value, wrap_u32_pow_out
    EXPAND WRAPPING_U32_IS_POWER_OF_TWO wrap_u32_pow2_true, wrap_u32_pow2
    EXPAND WRAPPING_U32_IS_POWER_OF_TWO wrap_u32_pow2_false, wrap_u32

    EXPAND WRAPPING_I64_NEW wrap_i64, -3
    EXPAND WRAPPING_I64_POW wrap_i64_pow_out, wrap_i64, 3
    EXPAND WRAPPING_I64_GET wrap_i64_pow_value, wrap_i64_pow_out

    EXPAND SATURATING_U64_NEW sat_u64, NUM_U64_MAX
    EXPAND SATURATING_U64_NEW sat_u64_pow2, 8
    EXPAND SATURATING_U64_NEW sat_u64_not_pow2, 10
    EXPAND SATURATING_U64_POW sat_u64_pow_out, sat_u64, 2
    EXPAND SATURATING_U64_GET sat_u64_pow_value, sat_u64_pow_out
    EXPAND SATURATING_U64_IS_POWER_OF_TWO sat_u64_pow2_true, sat_u64_pow2
    EXPAND SATURATING_U64_IS_POWER_OF_TWO sat_u64_pow2_false, sat_u64_not_pow2

    EXPAND SATURATING_I64_NEW sat_i64_max, NUM_I64_MAX
    EXPAND SATURATING_I64_NEW sat_i64_neg, -3037000500
    EXPAND SATURATING_I64_POW sat_i64_pow_max_out, sat_i64_max, 2
    EXPAND SATURATING_I64_GET sat_i64_pow_max_value, sat_i64_pow_max_out
    EXPAND SATURATING_I64_POW sat_i64_pow_min_out, sat_i64_neg, 3
    EXPAND SATURATING_I64_GET sat_i64_pow_min_value, sat_i64_pow_min_out

    ok01 = eq WRAPPING_U64_BITS, 64
    ok02 = eq WRAPPING_U32_BITS, 32
    ok03 = eq WRAPPING_I64_BITS, 64
    ok04 = eq SATURATING_U64_BITS, 64
    ok05 = eq SATURATING_I64_BITS, 64
    ok06 = eq wrap_u64_pow_value, 243
    ok07 = eq wrap_u64_pow2_true, 1
    ok08 = eq wrap_u64_pow2_false, 0
    ok09 = eq wrap_u32_pow_value, 243
    ok10 = eq wrap_u32_pow2_true, 1
    ok11 = eq wrap_u32_pow2_false, 0
    ok12 = eq wrap_i64_pow_value, -27
    ok13 = eq sat_u64_pow_value, NUM_U64_MAX
    ok14 = eq sat_u64_pow2_true, 1
    ok15 = eq sat_u64_pow2_false, 0
    ok16 = eq sat_i64_pow_max_value, NUM_I64_MAX
    ok17 = eq sat_i64_pow_min_value, NUM_I64_MIN

    c01 = and ok01, ok02
    c02 = and c01, ok03
    c03 = and c02, ok04
    c04 = and c03, ok05
    c05 = and c04, ok06
    c06 = and c05, ok07
    c07 = and c06, ok08
    c08 = and c07, ok09
    c09 = and c08, ok10
    c10 = and c09, ok11
    c11 = and c10, ok12
    c12 = and c11, ok13
    c13 = and c12, ok14
    c14 = and c13, ok15
    c15 = and c14, ok16
    ok = and c15, ok17

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10622)

L_PASS:
    !ok
    return 0
