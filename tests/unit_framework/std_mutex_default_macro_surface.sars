@import "sa_std/sync/mutex.sars"

@test "sa_std mutex default"():
L_ENTRY:
    EXPAND MUTEX_DEFAULT m
    EXPAND MUTEX_IS_LOCKED l0, m
    EXPAND MUTEX_TRY_LOCK ok, m
    EXPAND MUTEX_IS_LOCKED l1, m
    EXPAND MUTEX_UNLOCK m
    a = eq l0, 0
    b = eq ok, 1
    c = eq l1, 1
    ok01 = and a, b
    ok_all = and ok01, c
    !l0
    !ok
    !l1
    !a
    !b
    !c
    !ok01
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(10968)
