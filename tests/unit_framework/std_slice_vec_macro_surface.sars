    store vec_split_first_mut_ptr+0, 12 as u64
    !vec_split_first_mut_ptr
    EXPAND VEC_TRY_GET_U64 vec_after_first_mut_ok, vec_after_first_mut, vec, 0
    EXPAND SLICE_GET_LEN vec_split_first_mut_rest_len, vec_split_first_mut_rest
    EXPAND SLICE_FIRST_U64 vec_split_first_mut_rest_first, vec_split_first_mut_rest
    EXPAND VEC_TRY_SPLIT_LAST_MUT_U64 vec_split_last_mut_ok, vec_split_last_mut_ptr, vec_split_last_mut_head, vec
    store vec_split_last_mut_ptr+0, 34 as u64
