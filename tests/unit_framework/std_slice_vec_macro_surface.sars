    !vec_get_value_ok
    !vec_get_miss_flag_ok
    !vec_get_miss_value_ok
    !vec_trim_prefix_len_ok
    !vec_trim_prefix_first_ok
    !vec_trim_suffix_len_ok
    !vec_trim_suffix_first_ok
    !vec_trim_prefix_miss_len_ok
    !vec_split_flag_ok
    !vec_split_left_len_ok
    !vec_split_left_first_ok
    !vec_split_right_len_ok
    !vec_split_right_first_ok
    !vec_split_miss_flag_ok
