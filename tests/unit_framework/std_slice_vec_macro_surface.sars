    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    EXPAND VEC_FREE vec_unstable
    EXPAND VEC_FREE vec_unstable_by
    EXPAND VEC_FREE vec_unstable_key
    br ok -> L_SLICE_VEC_SORT_UNSTABLE_OK, L_SLICE_VEC_SORT_UNSTABLE_FAIL

L_SLICE_VEC_SORT_UNSTABLE_FAIL:
    !ok
    panic(10235)

L_SLICE_VEC_SORT_UNSTABLE_OK:
    !ok
    return

@test "sa_std slice and vec select_nth_unstable macros"():
L_ENTRY:
    select_data = alloc 40
    select_by_data = alloc 32
