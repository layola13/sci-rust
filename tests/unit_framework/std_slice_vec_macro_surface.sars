    !vec_prefix
    !vec_suffix
    !vec_miss
    !vec_prefix_data
    !vec_suffix_data
    !vec_miss_data
    EXPAND VEC_FREE vec
    br ok -> L_PARITY_OK, L_PARITY_FAIL

L_PARITY_FAIL:
    !ok
    panic(10220)

L_PARITY_OK:
    !ok
    return

@test "sa_std slice and vec split first last macros"():
L_ENTRY:
    data = alloc 24
    store data+0, 10 as u64
    store data+8, 20 as u64
    store data+16, 30 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 3
    empty_slice = alloc Slice_SIZE
    empty_ptr = 0 as ptr
    EXPAND SLICE_NEW empty_slice, empty_ptr, 0

    EXPAND SLICE_TRY_SPLIT_FIRST_U64 slice_first_ok, slice_first, slice_rest, slice
    EXPAND SLICE_GET_LEN slice_rest_len, slice_rest
    EXPAND SLICE_FIRST_U64 slice_rest_first, slice_rest
    EXPAND SLICE_TRY_SPLIT_LAST_U64 slice_last_ok, slice_last, slice_head, slice
    EXPAND SLICE_GET_LEN slice_head_len, slice_head
    EXPAND SLICE_LAST_U64 slice_head_last, slice_head
    EXPAND SLICE_TRY_SPLIT_FIRST_U64 empty_first_ok, empty_first, empty_first_rest, empty_slice
    EXPAND SLICE_IS_EMPTY empty_first_rest_empty, empty_first_rest
    EXPAND SLICE_TRY_SPLIT_LAST_U64 empty_last_ok, empty_last, empty_last_rest, empty_slice
    EXPAND SLICE_IS_EMPTY empty_last_rest_empty, empty_last_rest
    EXPAND SLICE_TRY_SPLIT_FIRST_MUT_U64 slice_first_mut_ok, slice_first_mut_ptr, slice_first_mut_rest, slice
    store slice_first_mut_ptr+0, 11 as u64
    !slice_first_mut_ptr
    EXPAND SLICE_GET_U64 slice_first_mut_value, slice, 0
    EXPAND SLICE_GET_LEN slice_first_mut_rest_len, slice_first_mut_rest
    EXPAND SLICE_FIRST_U64 slice_first_mut_rest_first, slice_first_mut_rest
    EXPAND SLICE_TRY_SPLIT_LAST_MUT_U64 slice_last_mut_ok, slice_last_mut_ptr, slice_last_mut_head, slice
    store slice_last_mut_ptr+0, 33 as u64
    !slice_last_mut_ptr
    EXPAND SLICE_GET_U64 slice_last_mut_value, slice, 2
    EXPAND SLICE_GET_LEN slice_last_mut_head_len, slice_last_mut_head
    EXPAND SLICE_LAST_U64 slice_last_mut_head_last, slice_last_mut_head
    EXPAND SLICE_TRY_SPLIT_FIRST_MUT_U64 empty_first_mut_ok, empty_first_mut_ptr, empty_first_mut_rest, empty_slice
    empty_first_mut_ptr_ok = eq empty_first_mut_ptr, 0
    !empty_first_mut_ptr
    EXPAND SLICE_IS_EMPTY empty_first_mut_rest_empty, empty_first_mut_rest
    EXPAND SLICE_TRY_SPLIT_LAST_MUT_U64 empty_last_mut_ok, empty_last_mut_ptr, empty_last_mut_rest, empty_slice
    empty_last_mut_ptr_ok = eq empty_last_mut_ptr, 0
    !empty_last_mut_ptr
    EXPAND SLICE_IS_EMPTY empty_last_mut_rest_empty, empty_last_mut_rest

    EXPAND VEC_WITH_CAPACITY_U64 vec, 3
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_FIRST vec_first, vec
    EXPAND VEC_LAST vec_last, vec
    EXPAND VEC_TRY_FIRST_U64 vec_try_first_ok, vec_try_first, vec
    EXPAND VEC_TRY_LAST_U64 vec_try_last_ok, vec_try_last, vec
    EXPAND VEC_TRY_SPLIT_FIRST_U64 vec_split_first_ok, vec_split_first, vec_split_rest, vec
    EXPAND SLICE_GET_LEN vec_split_rest_len, vec_split_rest
    EXPAND SLICE_FIRST_U64 vec_split_rest_first, vec_split_rest
    EXPAND VEC_TRY_SPLIT_LAST_U64 vec_split_last_ok, vec_split_last, vec_split_head, vec
    EXPAND SLICE_GET_LEN vec_split_head_len, vec_split_head
