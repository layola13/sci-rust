    ok26 = and ok25, vec_chunk1_len_ok
    ok27 = and ok26, vec_chunk1_first_ok
    ok28 = and ok27, vec_chunk1_last_ok
    ok29 = and ok28, vec_window_count_ok
    ok30 = and ok29, vec_window1_flag_ok
    ok31 = and ok30, vec_window1_len_ok
    ok32 = and ok31, vec_window1_first_ok
    ok = and ok32, vec_window1_last_ok

    !data
    !slice
