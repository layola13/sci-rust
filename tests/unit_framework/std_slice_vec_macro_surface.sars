@test "sa_std slice and vec checked range aliases"():
L_ENTRY:
    data = alloc 32
    store data+0, 4 as u64
    store data+8, 5 as u64
    store data+16, 6 as u64
    store data+24, 7 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 4

    EXPAND SLICE_TRY_SPLIT_AT_CHECKED_U64 split_ok, split_left, split_right, slice, 2
    EXPAND SLICE_TRY_SPLIT_AT_CHECKED_U64 split_miss_ok, split_miss_left, split_miss_right, slice, 5
    EXPAND SLICE_TRY_SPLIT_AT_MUT_CHECKED_U64 split_mut_ok, split_mut_left, split_mut_right, slice, 1
    EXPAND SLICE_GET_MUT_PTR_U64 split_mut_ptr, split_mut_right, 0
    store split_mut_ptr+0, 50 as u64
    EXPAND SLICE_TRY_GET_RANGE_MUT_U64 range_mut_ok, range_mut_slice, slice, 2, 2
    EXPAND SLICE_GET_MUT_PTR_U64 range_mut_ptr, range_mut_slice, 1
    store range_mut_ptr+0, 70 as u64
    EXPAND SLICE_GET_LEN split_left_len, split_left
    EXPAND SLICE_FIRST_U64 split_right_first, split_right
    EXPAND SLICE_GET_LEN split_miss_left_len, split_miss_left
    EXPAND SLICE_GET_LEN split_miss_right_len, split_miss_right
    EXPAND SLICE_GET_LEN split_mut_left_len, split_mut_left
    EXPAND SLICE_FIRST_U64 after_split_mut, slice
    EXPAND SLICE_GET_LEN range_mut_len, range_mut_slice
    EXPAND SLICE_LAST_U64 after_range_mut, slice

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_PUSH_U64 vec, 40
    EXPAND VEC_SPLIT_AT_U64 vec_split_plain_ok, vec_split_plain_left, vec_split_plain_right, vec, 2
    EXPAND VEC_SPLIT_AT_CHECKED_U64 vec_split_ok, vec_split_left, vec_split_right, vec, 3
    EXPAND VEC_TRY_SPLIT_AT_MUT_U64 vec_try_split_mut_ok, vec_try_split_mut_left, vec_try_split_mut_right, vec, 1
    EXPAND SLICE_GET_MUT_PTR_U64 vec_try_split_mut_ptr, vec_try_split_mut_right, 0
    store vec_try_split_mut_ptr+0, 200 as u64
    EXPAND VEC_SPLIT_AT_MUT_U64 vec_split_mut_plain_ok, vec_split_mut_plain_left, vec_split_mut_plain_right, vec, 2
    EXPAND SLICE_GET_MUT_PTR_U64 vec_split_mut_plain_ptr, vec_split_mut_plain_left, 0
    store vec_split_mut_plain_ptr+0, 100 as u64
    EXPAND VEC_SPLIT_AT_MUT_CHECKED_U64 vec_split_mut_ok, vec_split_mut_left, vec_split_mut_right, vec, 2
    EXPAND SLICE_GET_MUT_PTR_U64 vec_split_mut_ptr, vec_split_mut_right, 0
    store vec_split_mut_ptr+0, 300 as u64
    EXPAND VEC_RANGE_U64 vec_range_ok, vec_range_slice, vec, 1, 2
    EXPAND VEC_GET_RANGE_U64 vec_get_range_ok, vec_get_range_slice, vec, 0, 2
    EXPAND VEC_GET_RANGE_MUT_U64 vec_range_mut_ok, vec_range_mut_slice, vec, 3, 1
    EXPAND SLICE_GET_MUT_PTR_U64 vec_range_mut_ptr, vec_range_mut_slice, 0
    store vec_range_mut_ptr+0, 400 as u64
    EXPAND VEC_RANGE_U64 vec_range_miss_ok, vec_range_miss_slice, vec, 3, 3
    EXPAND VEC_SPLIT_AT_U64 vec_split_plain_miss_ok, vec_split_plain_miss_left, vec_split_plain_miss_right, vec, 9
    EXPAND SLICE_GET_LEN vec_split_plain_left_len, vec_split_plain_left
    EXPAND SLICE_FIRST_U64 vec_split_plain_right_first, vec_split_plain_right
    EXPAND SLICE_GET_LEN vec_split_left_len, vec_split_left
    EXPAND SLICE_FIRST_U64 vec_split_right_first, vec_split_right
    EXPAND SLICE_GET_LEN vec_try_split_mut_left_len, vec_try_split_mut_left
    EXPAND SLICE_GET_LEN vec_try_split_mut_right_len, vec_try_split_mut_right
    EXPAND SLICE_GET_LEN vec_split_mut_plain_left_len, vec_split_mut_plain_left
    EXPAND SLICE_GET_LEN vec_split_mut_plain_right_len, vec_split_mut_plain_right
    EXPAND SLICE_GET_LEN vec_split_mut_left_len, vec_split_mut_left
    EXPAND SLICE_GET_LEN vec_split_mut_right_len, vec_split_mut_right
    EXPAND SLICE_GET_LEN vec_range_len, vec_range_slice
    EXPAND SLICE_FIRST_U64 vec_range_first, vec_range_slice
    EXPAND SLICE_GET_LEN vec_get_range_len, vec_get_range_slice
    EXPAND SLICE_LAST_U64 vec_get_range_last, vec_get_range_slice
    EXPAND SLICE_GET_LEN vec_range_mut_len, vec_range_mut_slice
    EXPAND VEC_TRY_GET_U64 vec_after_split_mut_ok, vec_after_split_mut, vec, 2
    EXPAND VEC_TRY_GET_U64 vec_after_range_mut_ok, vec_after_range_mut, vec, 3
    EXPAND VEC_TRY_GET_U64 vec_after_try_split_mut_ok, vec_after_try_split_mut, vec, 1
    EXPAND VEC_TRY_GET_U64 vec_after_split_mut_plain_ok, vec_after_split_mut_plain, vec, 0
    EXPAND SLICE_GET_LEN vec_range_miss_len, vec_range_miss_slice
    EXPAND SLICE_GET_LEN vec_split_plain_miss_left_len, vec_split_plain_miss_left
    EXPAND SLICE_GET_LEN vec_split_plain_miss_right_len, vec_split_plain_miss_right

    split_flag_ok = eq split_ok, 1
    split_left_len_ok = eq split_left_len, 2
    split_right_first_ok = eq split_right_first, 6
    split_miss_flag_ok = eq split_miss_ok, 0
    split_miss_left_len_ok = eq split_miss_left_len, 0
    split_miss_right_len_ok = eq split_miss_right_len, 0
    split_mut_flag_ok = eq split_mut_ok, 1
    split_mut_left_len_ok = eq split_mut_left_len, 1
    after_split_mut_ok = eq after_split_mut, 4
    range_mut_flag_ok = eq range_mut_ok, 1
    range_mut_len_ok = eq range_mut_len, 2
    after_range_mut_ok = eq after_range_mut, 70
    vec_split_plain_flag_ok = eq vec_split_plain_ok, 1
    vec_split_plain_left_len_ok = eq vec_split_plain_left_len, 2
    vec_split_plain_right_first_ok = eq vec_split_plain_right_first, 300
    vec_split_flag_ok = eq vec_split_ok, 1
    vec_split_left_len_ok = eq vec_split_left_len, 3
    vec_split_right_first_ok = eq vec_split_right_first, 400
