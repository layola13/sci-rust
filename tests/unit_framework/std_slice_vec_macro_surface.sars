@test "sa_std slice and vec split chunk macros"():
L_ENTRY:
    data = alloc 40
    store data+0, 10 as u64
    store data+8, 20 as u64
    store data+16, 30 as u64
    store data+24, 40 as u64
    store data+32, 50 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 5

    EXPAND SLICE_TRY_SPLIT_FIRST_CHUNK_U64 first_ok, first_chunk, first_rest, slice, 2
    EXPAND SLICE_TRY_SPLIT_LAST_CHUNK_U64 last_ok, last_rest, last_chunk, slice, 2
    EXPAND SLICE_TRY_SPLIT_FIRST_CHUNK_U64 miss_ok, miss_chunk, miss_rest, slice, 9
    EXPAND SLICE_TRY_SPLIT_FIRST_CHUNK_U64 zero_first_ok, zero_first_chunk, zero_first_rest, slice, 0
    EXPAND SLICE_TRY_SPLIT_LAST_CHUNK_U64 zero_last_ok, zero_last_rest, zero_last_chunk, slice, 0
    EXPAND SLICE_TRY_SPLIT_FIRST_CHUNK_MUT_U64 mut_first_ok, mut_first_chunk, mut_first_rest, slice, 2
    EXPAND SLICE_TRY_SPLIT_LAST_CHUNK_MUT_U64 mut_last_ok, mut_last_rest, mut_last_chunk, slice, 2

    EXPAND SLICE_GET_LEN first_chunk_len, first_chunk
    EXPAND SLICE_FIRST_U64 first_chunk_first, first_chunk
    EXPAND SLICE_LAST_U64 first_chunk_last, first_chunk
    EXPAND SLICE_GET_LEN first_rest_len, first_rest
    EXPAND SLICE_FIRST_U64 first_rest_first, first_rest
    EXPAND SLICE_GET_LEN last_rest_len, last_rest
    EXPAND SLICE_LAST_U64 last_rest_last, last_rest
    EXPAND SLICE_GET_LEN last_chunk_len, last_chunk
    EXPAND SLICE_FIRST_U64 last_chunk_first, last_chunk
    EXPAND SLICE_LAST_U64 last_chunk_last, last_chunk
    EXPAND SLICE_GET_LEN miss_chunk_len, miss_chunk
    EXPAND SLICE_GET_LEN miss_rest_len, miss_rest
