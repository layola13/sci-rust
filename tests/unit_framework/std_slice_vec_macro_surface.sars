    !back2_ok
    !back2
    !copy_within_forward_ok
    !copy_within_miss_ok
    !forward0_ok
    !forward0
    !forward1_ok
    !forward1
    !forward2_ok
    !forward2
    !copy_flag_ok
    !copy_miss_flag_ok
    !copy0_flag_ok
    !copy0_value_ok
    !copy2_flag_ok
    !copy2_value_ok
    !clone_flag_ok
    !clone0_flag_ok
    !clone0_value_ok
    !clone2_flag_ok
    !clone2_value_ok
    !copy_within_back_flag_ok
    !back0_flag_ok
    !back0_value_ok
    !back1_flag_ok
    !back1_value_ok
    !back2_flag_ok
    !back2_value_ok
    !copy_within_forward_flag_ok
    !copy_within_miss_flag_ok
    !forward0_flag_ok
    !forward0_value_ok
    !forward1_flag_ok
    !forward1_value_ok
    !forward2_flag_ok
    !forward2_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    EXPAND VEC_FREE vec
    br ok -> L_VEC_COPY_ALIASES_OK, L_VEC_COPY_ALIASES_FAIL

L_VEC_COPY_ALIASES_FAIL:
    !ok
    panic(10230)

L_VEC_COPY_ALIASES_OK:
    !ok
    return

@test "sa_std slice and vec rotate swap sorted macros"():
L_ENTRY:
    data = alloc 40
    store data+0, 1 as u64
    store data+8, 2 as u64
    store data+16, 3 as u64
    store data+24, 4 as u64
    store data+32, 5 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 5
    EXPAND SLICE_TRY_ROTATE_LEFT_U64 rotate_left_ok, slice, 2
    EXPAND SLICE_FIRST_U64 rotate_left_first, slice
    EXPAND SLICE_LAST_U64 rotate_left_last, slice
    EXPAND SLICE_TRY_ROTATE_RIGHT_U64 rotate_right_ok, slice, 1
    EXPAND SLICE_FIRST_U64 rotate_right_first, slice
    EXPAND SLICE_LAST_U64 rotate_right_last, slice
    EXPAND SLICE_TRY_ROTATE_LEFT_U64 rotate_miss_ok, slice, 6

    left_data = alloc 24
    right_data = alloc 24
    store left_data+0, 10 as u64
    store left_data+8, 20 as u64
    store left_data+16, 30 as u64
    store right_data+0, 70 as u64
    store right_data+8, 80 as u64
    store right_data+16, 90 as u64
    left = alloc Slice_SIZE
    right = alloc Slice_SIZE
    short_right = alloc Slice_SIZE
    EXPAND SLICE_NEW left, left_data, 3
    EXPAND SLICE_NEW right, right_data, 3
    EXPAND SLICE_NEW short_right, right_data, 2
    EXPAND SLICE_TRY_SWAP_WITH_SLICE_U64 swap_with_ok, left, right
    EXPAND SLICE_FIRST_U64 left_after_swap_first, left
    EXPAND SLICE_LAST_U64 left_after_swap_last, left
    EXPAND SLICE_FIRST_U64 right_after_swap_first, right
    EXPAND SLICE_LAST_U64 right_after_swap_last, right
    EXPAND SLICE_TRY_SWAP_WITH_SLICE_U64 swap_with_miss_ok, left, short_right

    sorted_data = alloc 24
    unsorted_data = alloc 24
    empty_data = alloc 8
    store sorted_data+0, 1 as u64
    store sorted_data+8, 2 as u64
    store sorted_data+16, 2 as u64
    store unsorted_data+0, 1 as u64
    store unsorted_data+8, 3 as u64
    store unsorted_data+16, 2 as u64
    sorted = alloc Slice_SIZE
    unsorted = alloc Slice_SIZE
    empty = alloc Slice_SIZE
    EXPAND SLICE_NEW sorted, sorted_data, 3
    EXPAND SLICE_NEW unsorted, unsorted_data, 3
    EXPAND SLICE_NEW empty, empty_data, 0
    EXPAND SLICE_IS_SORTED_U64 sorted_ok, sorted
    EXPAND SLICE_IS_SORTED_U64 unsorted_ok, unsorted
    EXPAND SLICE_IS_SORTED_U64 empty_sorted_ok, empty

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 1
    EXPAND VEC_PUSH_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 3
    EXPAND VEC_PUSH_U64 vec, 4
    EXPAND VEC_TRY_ROTATE_LEFT_U64 vec_rotate_left_ok, vec, 1
    EXPAND VEC_TRY_GET_U64 vec_left_first_ok, vec_left_first, vec, 0
    EXPAND VEC_TRY_GET_U64 vec_left_last_ok, vec_left_last, vec, 3
    EXPAND VEC_TRY_ROTATE_RIGHT_U64 vec_rotate_right_ok, vec, 2
    EXPAND VEC_TRY_GET_U64 vec_right_first_ok, vec_right_first, vec, 0
    EXPAND VEC_TRY_GET_U64 vec_right_last_ok, vec_right_last, vec, 3
    vec_other_data = alloc 32
    store vec_other_data+0, 10 as u64
    store vec_other_data+8, 20 as u64
    store vec_other_data+16, 30 as u64
    store vec_other_data+24, 40 as u64
    vec_other = alloc Slice_SIZE
    EXPAND SLICE_NEW vec_other, vec_other_data, 4
    EXPAND VEC_TRY_SWAP_WITH_SLICE_U64 vec_swap_ok, vec, vec_other
    EXPAND VEC_TRY_GET_U64 vec_swap_first_ok, vec_swap_first, vec, 0
    EXPAND VEC_TRY_GET_U64 vec_swap_last_ok, vec_swap_last, vec, 3
    EXPAND SLICE_FIRST_U64 vec_other_first_after_swap, vec_other
    EXPAND SLICE_LAST_U64 vec_other_last_after_swap, vec_other
    EXPAND VEC_IS_SORTED_U64 vec_sorted_ok, vec
    EXPAND VEC_PUSH_U64 vec, 0
    EXPAND VEC_IS_SORTED_U64 vec_unsorted_ok, vec

    rotate_left_flag_ok = eq rotate_left_ok, 1
    rotate_left_first_ok = eq rotate_left_first, 3
    rotate_left_last_ok = eq rotate_left_last, 2
    rotate_right_flag_ok = eq rotate_right_ok, 1
    rotate_right_first_ok = eq rotate_right_first, 2
    rotate_right_last_ok = eq rotate_right_last, 1
    rotate_miss_flag_ok = eq rotate_miss_ok, 0
    swap_with_flag_ok = eq swap_with_ok, 1
    left_after_swap_first_ok = eq left_after_swap_first, 70
    left_after_swap_last_ok = eq left_after_swap_last, 90
    right_after_swap_first_ok = eq right_after_swap_first, 10
    right_after_swap_last_ok = eq right_after_swap_last, 30
    swap_with_miss_flag_ok = eq swap_with_miss_ok, 0
    sorted_flag_ok = eq sorted_ok, 1
    unsorted_flag_ok = eq unsorted_ok, 0
    empty_sorted_flag_ok = eq empty_sorted_ok, 1
    vec_rotate_left_flag_ok = eq vec_rotate_left_ok, 1
    vec_left_first_flag_ok = eq vec_left_first_ok, 1
    vec_left_first_value_ok = eq vec_left_first, 2
    vec_left_last_flag_ok = eq vec_left_last_ok, 1
    vec_left_last_value_ok = eq vec_left_last, 1
    vec_rotate_right_flag_ok = eq vec_rotate_right_ok, 1
    vec_right_first_flag_ok = eq vec_right_first_ok, 1
    vec_right_first_value_ok = eq vec_right_first, 4
    vec_right_last_flag_ok = eq vec_right_last_ok, 1
    vec_right_last_value_ok = eq vec_right_last, 3
    vec_swap_flag_ok = eq vec_swap_ok, 1
    vec_swap_first_flag_ok = eq vec_swap_first_ok, 1
    vec_swap_first_value_ok = eq vec_swap_first, 10
    vec_swap_last_flag_ok = eq vec_swap_last_ok, 1
    vec_swap_last_value_ok = eq vec_swap_last, 40
    vec_other_first_after_swap_ok = eq vec_other_first_after_swap, 4
    vec_other_last_after_swap_ok = eq vec_other_last_after_swap, 3
    vec_sorted_flag_ok = eq vec_sorted_ok, 1
    vec_unsorted_flag_ok = eq vec_unsorted_ok, 0

    ok01 = and rotate_left_flag_ok, rotate_left_first_ok
    ok02 = and ok01, rotate_left_last_ok
    ok03 = and ok02, rotate_right_flag_ok
    ok04 = and ok03, rotate_right_first_ok
    ok05 = and ok04, rotate_right_last_ok
    ok06 = and ok05, rotate_miss_flag_ok
    ok07 = and ok06, swap_with_flag_ok
    ok08 = and ok07, left_after_swap_first_ok
    ok09 = and ok08, left_after_swap_last_ok
    ok10 = and ok09, right_after_swap_first_ok
    ok11 = and ok10, right_after_swap_last_ok
    ok12 = and ok11, swap_with_miss_flag_ok
    ok13 = and ok12, sorted_flag_ok
    ok14 = and ok13, unsorted_flag_ok
    ok15 = and ok14, empty_sorted_flag_ok
    ok16 = and ok15, vec_rotate_left_flag_ok
    ok17 = and ok16, vec_left_first_flag_ok
    ok18 = and ok17, vec_left_first_value_ok
    ok19 = and ok18, vec_left_last_flag_ok
    ok20 = and ok19, vec_left_last_value_ok
    ok21 = and ok20, vec_rotate_right_flag_ok
    ok22 = and ok21, vec_right_first_flag_ok
    ok23 = and ok22, vec_right_first_value_ok
    ok24 = and ok23, vec_right_last_flag_ok
    ok25 = and ok24, vec_right_last_value_ok
    ok26 = and ok25, vec_swap_flag_ok
    ok27 = and ok26, vec_swap_first_flag_ok
    ok28 = and ok27, vec_swap_first_value_ok
    ok29 = and ok28, vec_swap_last_flag_ok
    ok30 = and ok29, vec_swap_last_value_ok
    ok31 = and ok30, vec_other_first_after_swap_ok
    ok32 = and ok31, vec_other_last_after_swap_ok
    ok33 = and ok32, vec_sorted_flag_ok
    ok = and ok33, vec_unsorted_flag_ok

    !data
    !slice
    !rotate_left_ok
    !rotate_left_first
    !rotate_left_last
    !rotate_right_ok
    !rotate_right_first
    !rotate_right_last
    !rotate_miss_ok
    !left_data
    !right_data
    !left
    !right
    !short_right
    !swap_with_ok
    !left_after_swap_first
    !left_after_swap_last
    !right_after_swap_first
    !right_after_swap_last
    !swap_with_miss_ok
    !sorted_data
    !unsorted_data
    !empty_data
    !sorted
    !unsorted
    !empty
    !sorted_ok
    !unsorted_ok
    !empty_sorted_ok
    !vec_left_first_ok
    !vec_left_first
    !vec_left_last_ok
    !vec_left_last
    !vec_right_first_ok
    !vec_right_first
    !vec_right_last_ok
    !vec_right_last
    !vec_other_data
