@test "sa_std slice and vec fill_with macros"():
L_ENTRY:
    data = alloc 24
    empty_data = alloc 8
    store data+0, 1 as u64
    store data+8, 2 as u64
    store data+16, 3 as u64
    slice = alloc Slice_SIZE
    empty = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 3
    EXPAND SLICE_NEW empty, empty_data, 0
    EXPAND SLICE_FILL_WITH_U64 slice, @slice_fill_with_77
    EXPAND SLICE_FILL_WITH_U64 empty, @slice_fill_with_77
    EXPAND SLICE_FIRST_U64 slice_first, slice
    EXPAND SLICE_LAST_U64 slice_last, slice
    EXPAND SLICE_GET_LEN empty_len, empty

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_FILL_WITH_U64 vec, @slice_fill_with_77
    EXPAND VEC_TRY_GET_U64 vec_first_ok, vec_first, vec, 0
    EXPAND VEC_TRY_GET_U64 vec_last_ok, vec_last, vec, 2
    EXPAND VEC_NEW empty_vec
    EXPAND VEC_FILL_WITH_U64 empty_vec, @slice_fill_with_77
    EXPAND VEC_LEN empty_vec_len, empty_vec

    slice_first_ok = eq slice_first, 77
    slice_last_ok = eq slice_last, 77
    empty_len_ok = eq empty_len, 0
    vec_first_flag_ok = eq vec_first_ok, 1
    vec_first_value_ok = eq vec_first, 77
    vec_last_flag_ok = eq vec_last_ok, 1
    vec_last_value_ok = eq vec_last, 77
    empty_vec_len_ok = eq empty_vec_len, 0

    ok01 = and slice_first_ok, slice_last_ok
    ok02 = and ok01, empty_len_ok
    ok03 = and ok02, vec_first_flag_ok
    ok04 = and ok03, vec_first_value_ok
    ok05 = and ok04, vec_last_flag_ok
    ok06 = and ok05, vec_last_value_ok
    ok = and ok06, empty_vec_len_ok

    !data
    !empty_data
    !slice
    !empty
    !slice_first
    !slice_last
    !empty_len
    !vec_first_ok
    !vec_first
    !vec_last_ok
    !vec_last
    !empty_vec_len
    !slice_first_ok
    !slice_last_ok
    !empty_len_ok
    !vec_first_flag_ok
    !vec_first_value_ok
    !vec_last_flag_ok
    !vec_last_value_ok
    !empty_vec_len_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    EXPAND VEC_FREE vec
    EXPAND VEC_FREE empty_vec
    br ok -> L_SLICE_VEC_FILL_WITH_OK, L_SLICE_VEC_FILL_WITH_FAIL

L_SLICE_VEC_FILL_WITH_FAIL:
    !ok
    panic(10237)

L_SLICE_VEC_FILL_WITH_OK:
    !ok
    return

@test "sa_std slice and vec exact chunk macros"():
L_ENTRY:
    data = alloc 40
    store data+0, 10 as u64
    store data+8, 20 as u64
    store data+16, 30 as u64
    store data+24, 40 as u64
    store data+32, 50 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 5

    EXPAND SLICE_CHUNKS_EXACT_COUNT_U64 chunk_count, slice, 2
    EXPAND SLICE_CHUNKS_EXACT_REMAINDER_U64 chunk_rem, slice, 2
    EXPAND SLICE_TRY_CHUNK_EXACT_AT_U64 chunk0_ok, chunk0, slice, 2, 0
    EXPAND SLICE_TRY_CHUNK_EXACT_AT_U64 chunk1_ok, chunk1, slice, 2, 1
    EXPAND SLICE_TRY_CHUNK_EXACT_AT_U64 chunk2_ok, chunk2, slice, 2, 2
    EXPAND SLICE_TRY_CHUNK_EXACT_MUT_AT_U64 chunk_mut_ok, chunk_mut, slice, 2, 1
    EXPAND SLICE_GET_MUT_PTR_U64 chunk_mut_ptr, chunk_mut, 1
    store chunk_mut_ptr+0, 44 as u64
    EXPAND SLICE_CHUNKS_EXACT_COUNT_U64 zero_count, slice, 0
    EXPAND SLICE_CHUNKS_EXACT_REMAINDER_U64 zero_rem, slice, 0
    EXPAND SLICE_TRY_CHUNK_EXACT_AT_U64 zero_chunk_ok, zero_chunk, slice, 0, 0

    EXPAND SLICE_GET_LEN chunk_rem_len, chunk_rem
    EXPAND SLICE_FIRST_U64 chunk_rem_first, chunk_rem
    EXPAND SLICE_GET_LEN chunk0_len, chunk0
    EXPAND SLICE_FIRST_U64 chunk0_first, chunk0
    EXPAND SLICE_LAST_U64 chunk0_last, chunk0
    EXPAND SLICE_GET_LEN chunk1_len, chunk1
    EXPAND SLICE_FIRST_U64 chunk1_first, chunk1
    EXPAND SLICE_LAST_U64 chunk1_last, chunk1
    EXPAND SLICE_GET_LEN chunk2_len, chunk2
    EXPAND SLICE_GET_U64 mutated_value, slice, 3
    EXPAND SLICE_GET_LEN zero_rem_len, zero_rem
    EXPAND SLICE_GET_LEN zero_chunk_len, zero_chunk

    EXPAND SLICE_RCHUNKS_EXACT_COUNT_U64 rchunk_count, slice, 2
    EXPAND SLICE_RCHUNKS_EXACT_REMAINDER_U64 rchunk_rem, slice, 2
    EXPAND SLICE_TRY_RCHUNK_EXACT_AT_U64 rchunk0_ok, rchunk0, slice, 2, 0
    EXPAND SLICE_TRY_RCHUNK_EXACT_AT_U64 rchunk1_ok, rchunk1, slice, 2, 1
    EXPAND SLICE_TRY_RCHUNK_EXACT_AT_U64 rchunk2_ok, rchunk2, slice, 2, 2
    EXPAND SLICE_TRY_RCHUNK_EXACT_MUT_AT_U64 rchunk_mut_ok, rchunk_mut, slice, 2, 0
    EXPAND SLICE_GET_MUT_PTR_U64 rchunk_mut_ptr, rchunk_mut, 0
    store rchunk_mut_ptr+0, 444 as u64
    EXPAND SLICE_GET_LEN rchunk_rem_len, rchunk_rem
    EXPAND SLICE_FIRST_U64 rchunk_rem_first, rchunk_rem
    EXPAND SLICE_GET_LEN rchunk0_len, rchunk0
    EXPAND SLICE_FIRST_U64 rchunk0_first, rchunk0
    EXPAND SLICE_LAST_U64 rchunk0_last, rchunk0
    EXPAND SLICE_GET_LEN rchunk1_len, rchunk1
    EXPAND SLICE_FIRST_U64 rchunk1_first, rchunk1
    EXPAND SLICE_LAST_U64 rchunk1_last, rchunk1
    EXPAND SLICE_GET_LEN rchunk2_len, rchunk2
    EXPAND SLICE_GET_U64 rmutated_value, slice, 3

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_PUSH_U64 vec, 40
    EXPAND VEC_PUSH_U64 vec, 50
    EXPAND VEC_CHUNKS_EXACT_COUNT_U64 vec_chunk_count, vec, 2
    EXPAND VEC_CHUNKS_EXACT_REMAINDER_U64 vec_chunk_rem, vec, 2
    EXPAND VEC_CHUNK_EXACT_AT_U64 vec_chunk1_ok, vec_chunk1, vec, 2, 1
    EXPAND VEC_CHUNK_EXACT_MUT_AT_U64 vec_chunk_mut_ok, vec_chunk_mut, vec, 2, 0
    EXPAND SLICE_GET_MUT_PTR_U64 vec_chunk_mut_ptr, vec_chunk_mut, 0
    store vec_chunk_mut_ptr+0, 11 as u64
    EXPAND VEC_RCHUNKS_EXACT_COUNT_U64 vec_rchunk_count, vec, 2
    EXPAND VEC_RCHUNKS_EXACT_REMAINDER_U64 vec_rchunk_rem, vec, 2
    EXPAND VEC_RCHUNK_EXACT_AT_U64 vec_rchunk0_ok, vec_rchunk0, vec, 2, 0
    EXPAND VEC_RCHUNK_EXACT_MUT_AT_U64 vec_rchunk_mut_ok, vec_rchunk_mut, vec, 2, 0
    EXPAND SLICE_GET_MUT_PTR_U64 vec_rchunk_mut_ptr, vec_rchunk_mut, 1
    store vec_rchunk_mut_ptr+0, 55 as u64
    EXPAND SLICE_GET_LEN vec_chunk_rem_len, vec_chunk_rem
    EXPAND SLICE_FIRST_U64 vec_chunk_rem_first, vec_chunk_rem
    EXPAND SLICE_FIRST_U64 vec_chunk1_first, vec_chunk1
    EXPAND SLICE_LAST_U64 vec_chunk1_last, vec_chunk1
    EXPAND SLICE_GET_LEN vec_rchunk_rem_len, vec_rchunk_rem
    EXPAND SLICE_FIRST_U64 vec_rchunk_rem_first, vec_rchunk_rem
    EXPAND SLICE_FIRST_U64 vec_rchunk0_first, vec_rchunk0
    EXPAND SLICE_LAST_U64 vec_rchunk0_last, vec_rchunk0
    EXPAND VEC_TRY_GET_U64 vec_after_chunk_mut_ok, vec_after_chunk_mut, vec, 0
    EXPAND VEC_TRY_GET_U64 vec_after_rchunk_mut_ok, vec_after_rchunk_mut, vec, 4

    chunk_count_ok = eq chunk_count, 2
    chunk_rem_len_ok = eq chunk_rem_len, 1
    chunk_rem_first_ok = eq chunk_rem_first, 50
    chunk0_flag_ok = eq chunk0_ok, 1
    chunk0_len_ok = eq chunk0_len, 2
    chunk0_first_ok = eq chunk0_first, 10
    chunk0_last_ok = eq chunk0_last, 20
    chunk1_flag_ok = eq chunk1_ok, 1
    chunk1_len_ok = eq chunk1_len, 2
    chunk1_first_ok = eq chunk1_first, 30
    chunk1_last_ok = eq chunk1_last, 44
    chunk2_flag_ok = eq chunk2_ok, 0
    chunk2_len_ok = eq chunk2_len, 0
    chunk_mut_flag_ok = eq chunk_mut_ok, 1
    mutated_value_ok = eq mutated_value, 44
    zero_count_ok = eq zero_count, 0
    zero_rem_len_ok = eq zero_rem_len, 0
    zero_chunk_flag_ok = eq zero_chunk_ok, 0
    zero_chunk_len_ok = eq zero_chunk_len, 0
    rchunk_count_ok = eq rchunk_count, 2
    rchunk_rem_len_ok = eq rchunk_rem_len, 1
    rchunk_rem_first_ok = eq rchunk_rem_first, 10
    rchunk0_flag_ok = eq rchunk0_ok, 1
    rchunk0_len_ok = eq rchunk0_len, 2
    rchunk0_first_ok = eq rchunk0_first, 444
    rchunk0_last_ok = eq rchunk0_last, 50
    rchunk1_flag_ok = eq rchunk1_ok, 1
    rchunk1_len_ok = eq rchunk1_len, 2
    rchunk1_first_ok = eq rchunk1_first, 20
    rchunk1_last_ok = eq rchunk1_last, 30
    rchunk2_flag_ok = eq rchunk2_ok, 0
    rchunk2_len_ok = eq rchunk2_len, 0
    rchunk_mut_flag_ok = eq rchunk_mut_ok, 1
    rmutated_value_ok = eq rmutated_value, 444
    vec_chunk_count_ok = eq vec_chunk_count, 2
    vec_chunk_rem_len_ok = eq vec_chunk_rem_len, 1
    vec_chunk_rem_first_ok = eq vec_chunk_rem_first, 55
    vec_chunk1_flag_ok = eq vec_chunk1_ok, 1
    vec_chunk1_first_ok = eq vec_chunk1_first, 30
    vec_chunk1_last_ok = eq vec_chunk1_last, 40
    vec_chunk_mut_flag_ok = eq vec_chunk_mut_ok, 1
    vec_rchunk_count_ok = eq vec_rchunk_count, 2
