    EXPAND VEC_FIRST_CHUNK_MUT_U64 vec_mut_first_ok, vec_mut_first_chunk, vec, 1
    EXPAND SLICE_GET_MUT_PTR_U64 vec_mut_first_ptr, vec_mut_first_chunk, 0
    store vec_mut_first_ptr+0, 10 as u64
    EXPAND VEC_LAST_CHUNK_MUT_U64 vec_mut_last_ok, vec_mut_last_chunk, vec, 1
    EXPAND SLICE_GET_MUT_PTR_U64 vec_mut_last_ptr, vec_mut_last_chunk, 0
    store vec_mut_last_ptr+0, 40 as u64
    EXPAND SLICE_GET_LEN vec_first_len, vec_first_chunk
    EXPAND SLICE_LAST_U64 vec_first_last, vec_first_chunk
    EXPAND SLICE_GET_LEN vec_last_len, vec_last_chunk
    EXPAND SLICE_FIRST_U64 vec_last_first, vec_last_chunk
    EXPAND SLICE_GET_LEN vec_miss_len, vec_miss_chunk
    EXPAND SLICE_GET_LEN vec_zero_len, vec_zero_chunk
    EXPAND VEC_TRY_GET_U64 vec_after_first_ok, vec_after_first, vec, 0
    EXPAND VEC_TRY_GET_U64 vec_after_last_ok, vec_after_last, vec, 3

    slice_first_flag_ok = eq slice_first_ok, 1
    slice_first_len_ok = eq slice_first_len, 2
    slice_first_value_ok = eq slice_first_value, 70
    slice_first_last_ok = eq slice_first_last, 8
    slice_last_flag_ok = eq slice_last_ok, 1
    slice_last_len_ok = eq slice_last_len, 2
    slice_last_first_ok = eq slice_last_first, 8
    slice_last_value_ok = eq slice_last_value, 90
    slice_miss_flag_ok = eq slice_miss_ok, 0
    slice_miss_len_ok = eq slice_miss_len, 0
    slice_zero_flag_ok = eq slice_zero_ok, 1
    slice_zero_len_ok = eq slice_zero_len, 0
    slice_mut_first_flag_ok = eq slice_mut_first_ok, 1
    slice_mut_last_flag_ok = eq slice_mut_last_ok, 1
    slice_after_first_ok = eq slice_after_first, 70
    slice_after_last_ok = eq slice_after_last, 90
    vec_first_flag_ok = eq vec_first_ok, 1
    vec_first_len_ok = eq vec_first_len, 2
    vec_first_last_ok = eq vec_first_last, 2
    vec_last_flag_ok = eq vec_last_ok, 1
    vec_last_len_ok = eq vec_last_len, 2
    vec_last_first_ok = eq vec_last_first, 3
    vec_miss_flag_ok = eq vec_miss_ok, 0
    vec_miss_len_ok = eq vec_miss_len, 0
    vec_zero_flag_ok = eq vec_zero_ok, 1
    vec_zero_len_ok = eq vec_zero_len, 0
    vec_mut_first_flag_ok = eq vec_mut_first_ok, 1
    vec_mut_last_flag_ok = eq vec_mut_last_ok, 1
    vec_after_first_flag_ok = eq vec_after_first_ok, 1
    vec_after_first_value_ok = eq vec_after_first, 10
    vec_after_last_flag_ok = eq vec_after_last_ok, 1
