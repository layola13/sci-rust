@test "sa_std vec slice mutation aliases"():
L_ENTRY:
    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 1
    EXPAND VEC_PUSH_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 3
    EXPAND VEC_PUSH_U64 vec, 4
    EXPAND VEC_PUSH_U64 vec, 5

    EXPAND VEC_SWAP_U64 vec, 0, 4
    EXPAND VEC_TRY_GET_U64 swap_first_ok, swap_first, vec, 0
    EXPAND VEC_TRY_GET_U64 swap_last_ok, swap_last, vec, 4
    EXPAND VEC_TRY_SWAP_U64 try_swap_ok, vec, 1, 3
    EXPAND VEC_TRY_SWAP_U64 try_swap_miss_ok, vec, 0, 9
    EXPAND VEC_TRY_GET_U64 try_swap_left_ok, try_swap_left, vec, 1
    EXPAND VEC_TRY_GET_U64 try_swap_right_ok, try_swap_right, vec, 3

    EXPAND VEC_REVERSE_U64 vec
    EXPAND VEC_TRY_GET_U64 reverse_first_ok, reverse_first, vec, 0
    EXPAND VEC_TRY_GET_U64 reverse_last_ok, reverse_last, vec, 4
    EXPAND VEC_ROTATE_LEFT_U64 rotate_left_ok, vec, 2
    EXPAND VEC_TRY_GET_U64 rotate_left_first_ok, rotate_left_first, vec, 0
    EXPAND VEC_TRY_GET_U64 rotate_left_last_ok, rotate_left_last, vec, 4
    EXPAND VEC_ROTATE_RIGHT_U64 rotate_right_ok, vec, 1
    EXPAND VEC_TRY_GET_U64 rotate_right_first_ok, rotate_right_first, vec, 0
    EXPAND VEC_TRY_GET_U64 rotate_right_last_ok, rotate_right_last, vec, 4

    other_data = alloc 40
    short_data = alloc 24
    store other_data+0, 90 as u64
    store other_data+8, 80 as u64
    store other_data+16, 70 as u64
    store other_data+24, 60 as u64
    store other_data+32, 50 as u64
    store short_data+0, 7 as u64
    store short_data+8, 8 as u64
    store short_data+16, 9 as u64
    other = alloc Slice_SIZE
    short = alloc Slice_SIZE
    EXPAND SLICE_NEW other, other_data, 5
    EXPAND SLICE_NEW short, short_data, 3
    EXPAND VEC_SWAP_WITH_SLICE_U64 swap_with_ok, vec, other
    EXPAND VEC_SWAP_WITH_SLICE_U64 swap_with_miss_ok, vec, short
    EXPAND VEC_TRY_GET_U64 swap_with_first_ok, swap_with_first, vec, 0
    EXPAND VEC_TRY_GET_U64 swap_with_last_ok, swap_with_last, vec, 4
    EXPAND SLICE_FIRST_U64 other_after_first, other
    EXPAND SLICE_LAST_U64 other_after_last, other

    EXPAND VEC_FILL_U64 vec, 9
    EXPAND VEC_TRY_GET_U64 fill_first_ok, fill_first, vec, 0
    EXPAND VEC_TRY_GET_U64 fill_middle_ok, fill_middle, vec, 2
    EXPAND VEC_TRY_GET_U64 fill_last_ok, fill_last, vec, 4

    swap_first_flag_ok = eq swap_first_ok, 1
    swap_first_value_ok = eq swap_first, 5
    swap_last_flag_ok = eq swap_last_ok, 1
    swap_last_value_ok = eq swap_last, 1
    try_swap_flag_ok = eq try_swap_ok, 1
    try_swap_miss_flag_ok = eq try_swap_miss_ok, 0
    try_swap_left_flag_ok = eq try_swap_left_ok, 1
    try_swap_left_value_ok = eq try_swap_left, 4
    try_swap_right_flag_ok = eq try_swap_right_ok, 1
    try_swap_right_value_ok = eq try_swap_right, 2
    reverse_first_flag_ok = eq reverse_first_ok, 1
    reverse_first_value_ok = eq reverse_first, 1
    reverse_last_flag_ok = eq reverse_last_ok, 1
    reverse_last_value_ok = eq reverse_last, 5
    rotate_left_flag_ok = eq rotate_left_ok, 1
    rotate_left_first_flag_ok = eq rotate_left_first_ok, 1
    rotate_left_first_value_ok = eq rotate_left_first, 3
    rotate_left_last_flag_ok = eq rotate_left_last_ok, 1
    rotate_left_last_value_ok = eq rotate_left_last, 2
    rotate_right_flag_ok = eq rotate_right_ok, 1
    rotate_right_first_flag_ok = eq rotate_right_first_ok, 1
    rotate_right_first_value_ok = eq rotate_right_first, 2
    rotate_right_last_flag_ok = eq rotate_right_last_ok, 1
    rotate_right_last_value_ok = eq rotate_right_last, 1
    swap_with_flag_ok = eq swap_with_ok, 1
    swap_with_miss_flag_ok = eq swap_with_miss_ok, 0
    swap_with_first_flag_ok = eq swap_with_first_ok, 1
    swap_with_first_value_ok = eq swap_with_first, 90
    swap_with_last_flag_ok = eq swap_with_last_ok, 1
    swap_with_last_value_ok = eq swap_with_last, 50
    other_after_first_ok = eq other_after_first, 2
    other_after_last_ok = eq other_after_last, 1
    fill_first_flag_ok = eq fill_first_ok, 1
    fill_first_value_ok = eq fill_first, 9
    fill_middle_flag_ok = eq fill_middle_ok, 1
    fill_middle_value_ok = eq fill_middle, 9
    fill_last_flag_ok = eq fill_last_ok, 1
    fill_last_value_ok = eq fill_last, 9

