@test "sa_std slice and vec first last chunk macros"():
L_ENTRY:
    data = alloc 24
    store data+0, 7 as u64
    store data+8, 8 as u64
    store data+16, 9 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 3

    EXPAND SLICE_TRY_FIRST_CHUNK_U64 slice_first_ok, slice_first_chunk, slice, 2
    EXPAND SLICE_TRY_LAST_CHUNK_U64 slice_last_ok, slice_last_chunk, slice, 2
    EXPAND SLICE_TRY_FIRST_CHUNK_U64 slice_miss_ok, slice_miss_chunk, slice, 4
    EXPAND SLICE_TRY_LAST_CHUNK_U64 slice_zero_ok, slice_zero_chunk, slice, 0
    EXPAND SLICE_TRY_FIRST_CHUNK_MUT_U64 slice_mut_first_ok, slice_mut_first_chunk, slice, 1
    EXPAND SLICE_GET_MUT_PTR_U64 slice_mut_first_ptr, slice_mut_first_chunk, 0
    store slice_mut_first_ptr+0, 70 as u64
    EXPAND SLICE_TRY_LAST_CHUNK_MUT_U64 slice_mut_last_ok, slice_mut_last_chunk, slice, 1
    EXPAND SLICE_GET_MUT_PTR_U64 slice_mut_last_ptr, slice_mut_last_chunk, 0
    store slice_mut_last_ptr+0, 90 as u64
    EXPAND SLICE_GET_LEN slice_first_len, slice_first_chunk
    EXPAND SLICE_FIRST_U64 slice_first_value, slice_first_chunk
    EXPAND SLICE_LAST_U64 slice_first_last, slice_first_chunk
    EXPAND SLICE_GET_LEN slice_last_len, slice_last_chunk
    EXPAND SLICE_FIRST_U64 slice_last_first, slice_last_chunk
    EXPAND SLICE_LAST_U64 slice_last_value, slice_last_chunk
    EXPAND SLICE_GET_LEN slice_miss_len, slice_miss_chunk
    EXPAND SLICE_GET_LEN slice_zero_len, slice_zero_chunk
    EXPAND SLICE_FIRST_U64 slice_after_first, slice
    EXPAND SLICE_LAST_U64 slice_after_last, slice

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 1
    EXPAND VEC_PUSH_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 3
    EXPAND VEC_PUSH_U64 vec, 4
