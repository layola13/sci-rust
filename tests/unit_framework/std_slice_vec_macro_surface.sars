L_SLICE_MUT_FAIL:
    !ok
    panic(10222)

L_SLICE_MUT_OK:
    !ok
    return

@test "sa_std slice and vec chunk window macros"():
L_ENTRY:
    data = alloc 40
    store data+0, 10 as u64
    store data+8, 20 as u64
    store data+16, 30 as u64
    store data+24, 40 as u64
    store data+32, 50 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 5

    EXPAND SLICE_CHUNK_COUNT_U64 chunk_count, slice, 2
    EXPAND SLICE_TRY_CHUNK_AT_U64 chunk0_ok, chunk0, slice, 2, 0
    EXPAND SLICE_TRY_CHUNK_AT_U64 chunk2_ok, chunk2, slice, 2, 2
    EXPAND SLICE_TRY_CHUNK_AT_U64 chunk3_ok, chunk3, slice, 2, 3
    EXPAND SLICE_CHUNK_COUNT_U64 zero_chunk_count, slice, 0
    EXPAND SLICE_TRY_CHUNK_AT_U64 zero_chunk_ok, zero_chunk, slice, 0, 0
    EXPAND SLICE_GET_LEN chunk0_len, chunk0
    EXPAND SLICE_FIRST_U64 chunk0_first, chunk0
    EXPAND SLICE_LAST_U64 chunk0_last, chunk0
    EXPAND SLICE_GET_LEN chunk2_len, chunk2
    EXPAND SLICE_FIRST_U64 chunk2_first, chunk2
    EXPAND SLICE_GET_LEN chunk3_len, chunk3
    EXPAND SLICE_GET_LEN zero_chunk_len, zero_chunk

    EXPAND SLICE_WINDOW_COUNT_U64 window_count, slice, 3
    EXPAND SLICE_TRY_WINDOW_AT_U64 window1_ok, window1, slice, 3, 1
    EXPAND SLICE_TRY_WINDOW_AT_U64 window3_ok, window3, slice, 3, 3
    EXPAND SLICE_WINDOW_COUNT_U64 big_window_count, slice, 9
    EXPAND SLICE_WINDOW_COUNT_U64 zero_window_count, slice, 0
    EXPAND SLICE_TRY_WINDOW_AT_U64 zero_window_ok, zero_window, slice, 0, 0
    EXPAND SLICE_GET_LEN window1_len, window1
    EXPAND SLICE_FIRST_U64 window1_first, window1
    EXPAND SLICE_LAST_U64 window1_last, window1
    EXPAND SLICE_GET_LEN window3_len, window3
    EXPAND SLICE_GET_LEN zero_window_len, zero_window

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_PUSH_U64 vec, 40
    EXPAND VEC_PUSH_U64 vec, 50
    EXPAND VEC_CHUNK_COUNT_U64 vec_chunk_count, vec, 2
    EXPAND VEC_CHUNK_AT_U64 vec_chunk1_ok, vec_chunk1, vec, 2, 1
    EXPAND VEC_WINDOW_COUNT_U64 vec_window_count, vec, 4
    EXPAND VEC_WINDOW_AT_U64 vec_window1_ok, vec_window1, vec, 4, 1
    EXPAND SLICE_GET_LEN vec_chunk1_len, vec_chunk1
    EXPAND SLICE_FIRST_U64 vec_chunk1_first, vec_chunk1
    EXPAND SLICE_LAST_U64 vec_chunk1_last, vec_chunk1
    EXPAND SLICE_GET_LEN vec_window1_len, vec_window1
    EXPAND SLICE_FIRST_U64 vec_window1_first, vec_window1
    EXPAND SLICE_LAST_U64 vec_window1_last, vec_window1

    chunk_count_ok = eq chunk_count, 3
    chunk0_flag_ok = eq chunk0_ok, 1
    chunk0_len_ok = eq chunk0_len, 2
    chunk0_first_ok = eq chunk0_first, 10
    chunk0_last_ok = eq chunk0_last, 20
    chunk2_flag_ok = eq chunk2_ok, 1
    chunk2_len_ok = eq chunk2_len, 1
    chunk2_first_ok = eq chunk2_first, 50
    chunk3_flag_ok = eq chunk3_ok, 0
    chunk3_len_ok = eq chunk3_len, 0
    zero_chunk_count_ok = eq zero_chunk_count, 0
    zero_chunk_flag_ok = eq zero_chunk_ok, 0
    zero_chunk_len_ok = eq zero_chunk_len, 0
    window_count_ok = eq window_count, 3
    window1_flag_ok = eq window1_ok, 1
    window1_len_ok = eq window1_len, 3
    window1_first_ok = eq window1_first, 20
    window1_last_ok = eq window1_last, 40
    window3_flag_ok = eq window3_ok, 0
    window3_len_ok = eq window3_len, 0
    big_window_count_ok = eq big_window_count, 0
    zero_window_count_ok = eq zero_window_count, 0
    zero_window_flag_ok = eq zero_window_ok, 0
    zero_window_len_ok = eq zero_window_len, 0
    vec_chunk_count_ok = eq vec_chunk_count, 3
    vec_chunk1_flag_ok = eq vec_chunk1_ok, 1
    vec_chunk1_len_ok = eq vec_chunk1_len, 2
    vec_chunk1_first_ok = eq vec_chunk1_first, 30
    vec_chunk1_last_ok = eq vec_chunk1_last, 40
    vec_window_count_ok = eq vec_window_count, 2
    vec_window1_flag_ok = eq vec_window1_ok, 1
    vec_window1_len_ok = eq vec_window1_len, 4
    vec_window1_first_ok = eq vec_window1_first, 20
    vec_window1_last_ok = eq vec_window1_last, 50

    ok01 = and chunk_count_ok, chunk0_flag_ok
    ok02 = and ok01, chunk0_len_ok
    ok03 = and ok02, chunk0_first_ok
    ok04 = and ok03, chunk0_last_ok
