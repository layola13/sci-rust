    EXPAND SLICE_GET_LEN zero_last_rest_len, zero_last_rest
    EXPAND SLICE_GET_LEN zero_last_chunk_len, zero_last_chunk
    EXPAND SLICE_GET_LEN mut_first_chunk_len, mut_first_chunk
    EXPAND SLICE_GET_LEN mut_first_rest_len, mut_first_rest
    EXPAND SLICE_GET_MUT_PTR_U64 mut_first_ptr, mut_first_chunk, 0
    store mut_first_ptr+0, 11 as u64
    EXPAND SLICE_GET_LEN mut_last_rest_len, mut_last_rest
    EXPAND SLICE_GET_LEN mut_last_chunk_len, mut_last_chunk
    EXPAND SLICE_GET_MUT_PTR_U64 mut_last_ptr, mut_last_chunk, 1
    store mut_last_ptr+0, 55 as u64
    EXPAND SLICE_FIRST_U64 data_first_after_mut, slice
    EXPAND SLICE_LAST_U64 data_last_after_mut, slice

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_PUSH_U64 vec, 40
    EXPAND VEC_PUSH_U64 vec, 50
    EXPAND VEC_SPLIT_FIRST_CHUNK_U64 vec_first_ok, vec_first_chunk, vec_first_rest, vec, 3
    EXPAND VEC_SPLIT_LAST_CHUNK_U64 vec_last_ok, vec_last_rest, vec_last_chunk, vec, 3
    EXPAND VEC_SPLIT_FIRST_CHUNK_MUT_U64 vec_mut_first_ok, vec_mut_first_chunk, vec_mut_first_rest, vec, 2
    EXPAND VEC_SPLIT_LAST_CHUNK_MUT_U64 vec_mut_last_ok, vec_mut_last_rest, vec_mut_last_chunk, vec, 2
    EXPAND VEC_SPLIT_LAST_CHUNK_U64 vec_miss_ok, vec_miss_rest, vec_miss_chunk, vec, 9
    EXPAND VEC_SPLIT_FIRST_CHUNK_U64 vec_zero_first_ok, vec_zero_first_chunk, vec_zero_first_rest, vec, 0
    EXPAND VEC_SPLIT_LAST_CHUNK_U64 vec_zero_last_ok, vec_zero_last_rest, vec_zero_last_chunk, vec, 0
    EXPAND SLICE_GET_LEN vec_first_chunk_len, vec_first_chunk
    EXPAND SLICE_LAST_U64 vec_first_chunk_last, vec_first_chunk
    EXPAND SLICE_GET_LEN vec_first_rest_len, vec_first_rest
    EXPAND SLICE_FIRST_U64 vec_first_rest_first, vec_first_rest
    EXPAND SLICE_GET_LEN vec_last_rest_len, vec_last_rest
    EXPAND SLICE_LAST_U64 vec_last_rest_last, vec_last_rest
    EXPAND SLICE_GET_LEN vec_last_chunk_len, vec_last_chunk
    EXPAND SLICE_FIRST_U64 vec_last_chunk_first, vec_last_chunk
    EXPAND SLICE_GET_LEN vec_mut_first_chunk_len, vec_mut_first_chunk
    EXPAND SLICE_GET_LEN vec_mut_first_rest_len, vec_mut_first_rest
    EXPAND SLICE_GET_MUT_PTR_U64 vec_mut_first_ptr, vec_mut_first_chunk, 1
