    sort_by_data = alloc 32
    sort_key_data = alloc 40
    empty_data = alloc 8
    store sort_data+0, 9 as u64
    store sort_data+8, 3 as u64
    store sort_data+16, 7 as u64
    store sort_data+24, 3 as u64
