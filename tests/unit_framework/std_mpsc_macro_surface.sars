@import "sa_std/sync/mpsc.sars"

@test "sa_std sync mpsc capacity and state macros"():
L_ENTRY:
    EXPAND MPSC_NEW chan, 2
    EXPAND MPSC_CAPACITY cap0, chan
    EXPAND MPSC_LEN len0, chan
    EXPAND MPSC_AVAILABLE avail0, chan
    EXPAND MPSC_IS_EMPTY empty0, chan
    EXPAND MPSC_IS_FULL full0, chan

    EXPAND MPSC_TRY_SEND send0_ok, chan, 11
    EXPAND MPSC_LEN len1, chan
    EXPAND MPSC_AVAILABLE avail1, chan
    EXPAND MPSC_IS_EMPTY empty1, chan
    EXPAND MPSC_IS_FULL full1, chan

    EXPAND MPSC_TRY_SEND send1_ok, chan, 22
    EXPAND MPSC_LEN len2, chan
    EXPAND MPSC_AVAILABLE avail2, chan
    EXPAND MPSC_IS_FULL full2, chan
    EXPAND MPSC_TRY_SEND send2_ok, chan, 33

    EXPAND MPSC_TRY_RECV recv0_ok, recv0_value, chan
    EXPAND MPSC_LEN len3, chan
    EXPAND MPSC_AVAILABLE avail3, chan
    EXPAND MPSC_TRY_RECV recv1_ok, recv1_value, chan
    EXPAND MPSC_TRY_RECV recv2_ok, recv2_value, chan
    EXPAND MPSC_IS_EMPTY empty_final, chan

    EXPAND MPSC_NEW chan_zero, 0
    EXPAND MPSC_CAPACITY cap_zero, chan_zero
    EXPAND MPSC_FREE chan_zero

    EXPAND MPSC_NEW chan_corrupt, 2
    store chan_corrupt+Mpsc_head, 2 as u64
    store chan_corrupt+Mpsc_tail, 1 as u64
    EXPAND MPSC_TRY_RECV recv_corrupt_ok, recv_corrupt_value, chan_corrupt

    ok_cap0 = eq cap0, 2
    ok_len0 = eq len0, 0
    ok_avail0 = eq avail0, 2
    ok_full0 = eq full0, 0
    ok_send0 = eq send0_ok, 1
    ok_len1 = eq len1, 1
    ok_avail1 = eq avail1, 1
    ok_empty1 = eq empty1, 0
    ok_full1 = eq full1, 0
    ok_send1 = eq send1_ok, 1
    ok_len2 = eq len2, 2
    ok_avail2 = eq avail2, 0
    ok_send2 = eq send2_ok, 0
    ok_recv0 = eq recv0_ok, 1
    ok_recv0_value = eq recv0_value, 11
    ok_len3 = eq len3, 1
    ok_avail3 = eq avail3, 1
    ok_recv1 = eq recv1_ok, 1
    ok_recv1_value = eq recv1_value, 22
    ok_recv2 = eq recv2_ok, 0
    ok_recv2_value = eq recv2_value, 0
    ok_cap_zero = eq cap_zero, 1
    ok_corrupt_recv = eq recv_corrupt_ok, 0
    ok_corrupt_value = eq recv_corrupt_value, 0

    ok01 = and ok_cap0, ok_len0
    ok02 = and ok01, ok_avail0
    ok03 = and ok02, empty0
    ok04 = and ok03, ok_full0
    ok05 = and ok04, ok_send0
    ok06 = and ok05, ok_len1
    ok07 = and ok06, ok_avail1
    ok08 = and ok07, ok_empty1
    ok09 = and ok08, ok_full1
    ok10 = and ok09, ok_send1
    ok11 = and ok10, ok_len2
    ok12 = and ok11, ok_avail2
    ok13 = and ok12, full2
    ok14 = and ok13, ok_send2
    ok15 = and ok14, ok_recv0
    ok16 = and ok15, ok_recv0_value
    ok17 = and ok16, ok_len3
    ok18 = and ok17, ok_avail3
    ok19 = and ok18, ok_recv1
    ok20 = and ok19, ok_recv1_value
    ok21 = and ok20, ok_recv2
    ok22 = and ok21, ok_recv2_value
    ok23 = and ok22, empty_final
    ok24 = and ok23, ok_cap_zero
    ok25 = and ok24, ok_corrupt_recv
    ok = and ok25, ok_corrupt_value

    !chan
    !chan_corrupt
    !cap0
    !len0
    !avail0
    !empty0
    !full0
    !send0_ok
    !len1
    !avail1
    !empty1
    !full1
    !send1_ok
    !len2
    !avail2
    !full2
    !send2_ok
    !recv0_ok
    !recv0_value
    !len3
    !avail3
    !recv1_ok
    !recv1_value
    !recv2_ok
    !recv2_value
    !empty_final
    !cap_zero
    !recv_corrupt_ok
    !recv_corrupt_value
    !ok_cap0
    !ok_len0
    !ok_avail0
    !ok_full0
    !ok_send0
    !ok_len1
    !ok_avail1
    !ok_empty1
    !ok_full1
    !ok_send1
    !ok_len2
    !ok_avail2
    !ok_send2
    !ok_recv0
    !ok_recv0_value
    !ok_len3
    !ok_avail3
    !ok_recv1
    !ok_recv1_value
    !ok_recv2
    !ok_recv2_value
    !ok_cap_zero
    !ok_corrupt_recv
    !ok_corrupt_value
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(1000)

L_PASS:
    !ok
    return 0


@test "sa_std sync mpsc default constructor"():
L_ENTRY:
    EXPAND MPSC_DEFAULT chan
    EXPAND MPSC_CAPACITY cap, chan
    EXPAND MPSC_LEN len0, chan
    EXPAND MPSC_IS_EMPTY empty0, chan
    EXPAND MPSC_TRY_SEND send_ok, chan, 42
    EXPAND MPSC_TRY_RECV recv_ok, recv_value, chan
    EXPAND MPSC_FREE chan

    ok_cap = eq cap, 16
    ok_len0 = eq len0, 0
    ok_send = eq send_ok, 1
    ok_recv = eq recv_ok, 1
    ok_value = eq recv_value, 42
    ok01 = and ok_cap, ok_len0
    ok02 = and ok01, empty0
    ok03 = and ok02, ok_send
    ok04 = and ok03, ok_recv
    ok = and ok04, ok_value

    !cap
    !len0
    !empty0
    !send_ok
    !recv_ok
    !recv_value
    !ok_cap
    !ok_len0
    !ok_send
    !ok_recv
    !ok_value
    !ok01
    !ok02
    !ok03
    !ok04
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10454)
L_OK:
    !ok
    return
