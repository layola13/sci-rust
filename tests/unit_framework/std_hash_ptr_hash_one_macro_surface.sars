@import "sa_std/hash.sars"

@test "sa_std hash pointer hash_one macro surface"():
L_ENTRY:
    EXPAND BUILD_HASHER_DEFAULT_NEW builder

    ptr_slot = stack_alloc 8
    state = stack_alloc RandomState_SIZE
    manual_ptr_hasher = stack_alloc DefaultHasher_SIZE
    state_manual_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND HASH_PTR_VALUE direct_ptr_hash, ptr_slot
    EXPAND BUILD_HASHER_DEFAULT_HASH_ONE_PTR_VALUE build_ptr_hash, builder, ptr_slot

    EXPAND DEFAULT_HASHER_NEW manual_ptr_hasher
    EXPAND DEFAULT_HASHER_WRITE_PTR manual_ptr_hasher, ptr_slot
    EXPAND DEFAULT_HASHER_WRITE_UNIT manual_ptr_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH manual_ptr_hash, manual_ptr_hasher

    EXPAND RANDOM_STATE_WITH_SEEDS state, 11, 22
    EXPAND RANDOM_STATE_HASH_ONE_PTR_VALUE state_ptr_hash, state, ptr_slot

    EXPAND RANDOM_STATE_BUILD state_manual_hasher, state
    EXPAND DEFAULT_HASHER_WRITE_PTR state_manual_hasher, ptr_slot
    EXPAND DEFAULT_HASHER_WRITE_UNIT state_manual_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH state_manual_hash, state_manual_hasher

    direct_matches_manual = eq direct_ptr_hash, manual_ptr_hash
    build_matches_direct = eq build_ptr_hash, direct_ptr_hash
    state_matches_manual = eq state_ptr_hash, state_manual_hash
    seeded_differs_default = ne state_ptr_hash, direct_ptr_hash
    changed = ne direct_ptr_hash, HASHER_DEFAULT_SEED

    c01 = and direct_matches_manual, build_matches_direct
    c02 = and c01, state_matches_manual
    c03 = and c02, seeded_differs_default
    ok = and c03, changed

    !direct_ptr_hash
    !build_ptr_hash
    !manual_ptr_hash
    !state_ptr_hash
    !state_manual_hash
    !direct_matches_manual
    !build_matches_direct
    !state_matches_manual
    !seeded_differs_default
    !changed
    !c01
    !c02
    !c03
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10564)

L_PASS:
    !ok
    return 0
