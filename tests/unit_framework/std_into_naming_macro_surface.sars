@import "sa_std/convert.sars"
@import "sa_std/ptr.sars"

@test "sa_std Into TryInto SaturatingInto naming aliases"():
L_ENTRY:
    neg_three = sub 0, 3

    EXPAND INTO_BOOL_TO_U64 into_b_u64, 1
    EXPAND INTO_U64_TO_BOOL into_u64_b, 1
    EXPAND INTO_U8_TO_U64 into_u8_u64, 250
    EXPAND INTO_U8_TO_U16 into_u8_u16, 255
    EXPAND INTO_U16_TO_U32 into_u16_u32, 65535
    EXPAND INTO_U32_TO_U64 into_u32_u64, 4294967295
    EXPAND INTO_U64_TO_USIZE into_u64_us, 7777
    EXPAND INTO_USIZE_TO_U64 into_us_u64, 8888
    EXPAND INTO_I8_TO_I64 into_i8_i64, neg_three
    EXPAND INTO_I32_TO_I64 into_i32_i64, neg_three
    EXPAND INTO_I64_TO_ISIZE into_i64_is, neg_three
    EXPAND INTO_ISIZE_TO_I64 into_is_i64, neg_three

    EXPAND TRY_INTO_U64_TO_U8 ti_u8_ok, ti_u8_val, 200
    too_big_u8 = add 255, 1
    EXPAND TRY_INTO_U64_TO_U8 ti_u8_miss_ok, ti_u8_miss_val, too_big_u8
    EXPAND TRY_INTO_I64_TO_U8 ti_i64_u8_ok, ti_i64_u8_val, 200
    EXPAND TRY_INTO_I64_TO_I32 ti_i64_i32_ok, ti_i64_i32_val, neg_three

    EXPAND SAT_INTO_U64_TO_U8 si_u8_mid, 12
    EXPAND SAT_INTO_U64_TO_U8 si_u8_high, 999
    EXPAND SAT_INTO_I64_TO_U8 si_i64_low, neg_three
    EXPAND SAT_INTO_I64_TO_U8 si_i64_high, 200

    ok01 = eq into_b_u64, 1
    ok02 = eq into_u64_b, 1
    ok03 = eq into_u8_u64, 250
    ok04 = eq into_u8_u16, 255
    ok05 = eq into_u16_u32, 65535
    ok06 = eq into_u32_u64, 4294967295
    ok07 = eq into_u64_us, 7777
    ok08 = eq into_us_u64, 8888
    ok09 = eq into_i8_i64, neg_three
    ok10 = eq into_i32_i64, neg_three
    ok11 = eq into_i64_is, neg_three
    ok12 = eq into_is_i64, neg_three
    ok13 = eq ti_u8_ok, 1
    ok14 = eq ti_u8_val, 200
    ok15 = eq ti_u8_miss_ok, 0
    ok16 = eq ti_u8_miss_val, 0
    ok17 = eq ti_i64_u8_ok, 1
    ok18 = eq ti_i64_u8_val, 200
    ok19 = eq ti_i64_i32_ok, 1
    ok20 = eq ti_i64_i32_val, neg_three
    ok21 = eq si_u8_mid, 12
    ok22 = eq si_u8_high, 255
    ok23 = eq si_i64_low, 0
    ok24 = eq si_i64_high, 200

    !neg_three
    !too_big_u8
    !into_b_u64
    !into_u64_b
    !into_u8_u64
    !into_u8_u16
    !into_u16_u32
    !into_u32_u64
    !into_u64_us
    !into_us_u64
    !into_i8_i64
    !into_i32_i64
    !into_i64_is
    !into_is_i64
    !ti_u8_val
    !ti_u8_miss_val
    !ti_i64_u8_val
    !ti_i64_i32_val
    !si_u8_mid
    !si_u8_high
    !si_i64_low
    !si_i64_high

    c01 = and ok01, ok02
    c02 = and c01, ok03
    c03 = and c02, ok04
    c04 = and c03, ok05
    c05 = and c04, ok06
    c06 = and c05, ok07
    c07 = and c06, ok08
    c08 = and c07, ok09
    c09 = and c08, ok10
    c10 = and c09, ok11
    c11 = and c10, ok12
    c12 = and c11, ok13
    c13 = and c12, ok14
    c14 = and c13, ok15
    c15 = and c14, ok16
    c16 = and c15, ok17
    c17 = and c16, ok18
    c18 = and c17, ok19
    c19 = and c18, ok20
    c20 = and c19, ok21
    c21 = and c20, ok22
    c22 = and c21, ok23
    c23 = and c22, ok24
    ok = and c23, ok24

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10465)

L_PASS:
    return 0

@test "sa_std PTR_SWAP_NONOVERLAPPING_U64"():
L_ENTRY:
    a = add 0, 42
    b = add 0, 99

    a_slot = alloc 8
    b_slot = alloc 8
    store a_slot+0, a as u64
    store b_slot+0, b as u64

    EXPAND PTR_SWAP_NONOVERLAPPING_U64 a_slot, b_slot

    new_a = load a_slot+0 as u64
    new_b = load b_slot+0 as u64

    ok_a = eq new_a, 99
    ok_b = eq new_b, 42

    !a
    !b
    !new_a
    !new_b
    !a_slot
    !b_slot

    ok = and ok_a, ok_b

    br ok -> L_PASS2, L_FAIL2

L_FAIL2:
    !ok
    !ok_a
    !ok_b
    panic(10466)

L_PASS2:
    return 0
