@import "sa_std/process.sars"

@const TRUE_BIN = utf8:"/bin/true"

#def TRUE_BIN_LEN = 9
#def TRUE_ARGV1_SIZE = 16
#def PIDFD_CREATE = 1

@test "sa_std process Command builder pidfd macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV1_SIZE
    dummy = stack_alloc 1
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, TRUE_BIN, TRUE_BIN_LEN

    EXPAND PROCESS_COMMAND_BUILDER_NEW cwd_len0, has_cwd0, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0
    EXPAND PROCESS_COMMAND_BUILDER_SPAWN_PIDFD spawn_status, process, argv, 1, dummy, cwd_len0, has_cwd0, dummy, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0, PIDFD_CREATE

    spawn_status_ok = eq spawn_status, SA_PROCESS_OK
    process_ok = ne process, 0
    spawn_ok = and spawn_status_ok, process_ok
    br spawn_ok -> L_PIDFD, L_FAIL_SPAWN

L_FAIL_SPAWN:
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    panic(10684)

L_PIDFD:
    EXPAND PROCESS_PIDFD pidfd_status, pidfd, process
    EXPAND PIDFD_AS_RAW_FD raw_status, raw_fd, pidfd
    EXPAND PROCESS_WAIT wait_status, code, process
    EXPAND PROCESS_CLOSE pidfd_close_status, pidfd
    EXPAND PROCESS_CLOSE process_close_status, process

    pidfd_status_ok = eq pidfd_status, SA_PROCESS_OK
    pidfd_ok = ne pidfd, 0
    raw_status_ok = eq raw_status, SA_PROCESS_OK
    raw_fd_ok = ne raw_fd, -1
    wait_ok = eq wait_status, SA_PROCESS_OK
    code_ok = eq code, 0
    pidfd_close_ok = eq pidfd_close_status, SA_PROCESS_OK
    process_close_ok = eq process_close_status, SA_PROCESS_OK
    ok00 = and spawn_ok, pidfd_status_ok
    ok01 = and ok00, pidfd_ok
    ok02 = and ok01, raw_status_ok
    ok03 = and ok02, raw_fd_ok
    ok04 = and ok03, wait_ok
    ok05 = and ok04, code_ok
    ok06 = and ok05, pidfd_close_ok
    ok = and ok06, process_close_ok

    !pidfd_status
    !pidfd
    !raw_status
    !raw_fd
    !wait_status
    !code
    !pidfd_close_status
    !process_close_status
    !pidfd_status_ok
    !pidfd_ok
    !raw_status_ok
    !raw_fd_ok
    !wait_ok
    !code_ok
    !pidfd_close_ok
    !process_close_ok
    !ok00
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    !cwd_len0
    !has_cwd0
    !arg0_len0
    !has_arg00
    !pgroup0
    !has_pgroup0
    !setsid0
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10684)

L_PASS:
    !ok
    return 0
