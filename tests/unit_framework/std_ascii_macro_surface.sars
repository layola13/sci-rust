    return

@test "sa_std ascii Char primitive macros"():
L_ENTRY:
    char_a = stack_alloc AsciiChar_SIZE
    char_upper = stack_alloc AsciiChar_SIZE
    char_lower = stack_alloc AsciiChar_SIZE
    char_digit = stack_alloc AsciiChar_SIZE
    char_digit_bad = stack_alloc AsciiChar_SIZE
    char_percent = stack_alloc AsciiChar_SIZE
    char_space = stack_alloc AsciiChar_SIZE
    char_lf = stack_alloc AsciiChar_SIZE
    bytes = stack_alloc Slice_SIZE

    EXPAND ASCII_CHAR_FROM_U8 from_ok, char_a, 97
    EXPAND ASCII_CHAR_FROM_U8 from_bad_ok, char_digit_bad, 200
    EXPAND ASCII_CHAR_FROM_U8_UNCHECKED char_percent, 37
    EXPAND ASCII_CHAR_FROM_U8_UNCHECKED char_space, 32
    EXPAND ASCII_CHAR_FROM_U8_UNCHECKED char_lf, 10
    EXPAND ASCII_CHAR_DIGIT digit_ok, char_digit, 7
    EXPAND ASCII_CHAR_DIGIT digit_bad_ok, char_digit_bad, 12
    EXPAND ASCII_CHAR_TO_U8 a_byte, char_a
    EXPAND ASCII_CHAR_TO_CHAR a_scalar, char_a
    EXPAND ASCII_CHAR_AS_BYTES bytes, char_a
    bytes_ptr = load bytes+Slice_ptr as ptr
    bytes_len = load bytes+Slice_len as u64
    bytes0 = load bytes_ptr+0 as u8

    EXPAND ASCII_CHAR_TO_UPPERCASE char_upper, char_a
    EXPAND ASCII_CHAR_TO_LOWERCASE char_lower, char_upper
    EXPAND ASCII_CHAR_TO_U8 upper_byte, char_upper
    EXPAND ASCII_CHAR_TO_U8 lower_byte, char_lower
    EXPAND ASCII_CHAR_MAKE_UPPERCASE char_a
    EXPAND ASCII_CHAR_TO_U8 made_upper_byte, char_a
    EXPAND ASCII_CHAR_MAKE_LOWERCASE char_a
    EXPAND ASCII_CHAR_TO_U8 made_lower_byte, char_a
    EXPAND ASCII_CHAR_EQ_IGNORE_CASE eq_ignore, char_a, char_upper

    EXPAND ASCII_CHAR_IS_ALPHABETIC is_alpha, char_a
    EXPAND ASCII_CHAR_IS_UPPERCASE is_upper_after_lower, char_a
    EXPAND ASCII_CHAR_IS_LOWERCASE is_lower_after_lower, char_a
    EXPAND ASCII_CHAR_IS_ALPHANUMERIC is_alnum, char_digit
    EXPAND ASCII_CHAR_IS_DIGIT is_digit, char_digit
    EXPAND ASCII_CHAR_IS_OCTDIGIT is_octdigit, char_digit
    EXPAND ASCII_CHAR_IS_HEXDIGIT is_hexdigit, char_upper
    EXPAND ASCII_CHAR_IS_PUNCTUATION is_punctuation, char_percent
    EXPAND ASCII_CHAR_IS_GRAPHIC is_graphic, char_percent
    EXPAND ASCII_CHAR_IS_WHITESPACE is_whitespace, char_space
    EXPAND ASCII_CHAR_IS_CONTROL is_control, char_lf
    esc_buf = stack_alloc 4
    EXPAND ASCII_CHAR_ESCAPE_DEFAULT_WRITE char_escape_ok, char_escape_len, esc_buf, 4, char_lf
    char_escape0 = load esc_buf+0 as u8
    char_escape_p1 = ptr_add esc_buf, 1
    char_escape1 = load char_escape_p1+0 as u8

    ok_from = eq from_ok, 1
    ok_from_bad = eq from_bad_ok, 0
    ok_digit = eq digit_ok, 1
    ok_digit_bad = eq digit_bad_ok, 0
    ok_a_byte = eq a_byte, 97
    ok_a_scalar = eq a_scalar, 97
    ok_bytes_len = eq bytes_len, 1
    ok_bytes0 = eq bytes0, 97
    ok_upper = eq upper_byte, 65
    ok_lower = eq lower_byte, 97
    ok_made_upper = eq made_upper_byte, 65
    ok_made_lower = eq made_lower_byte, 97
    ok_eq_ignore = eq eq_ignore, 1
    ok_alpha = eq is_alpha, 1
    ok_not_upper = eq is_upper_after_lower, 0
    ok_lowercase = eq is_lower_after_lower, 1
    ok_alnum = eq is_alnum, 1
    ok_digit_class = eq is_digit, 1
    ok_octdigit = eq is_octdigit, 1
    ok_hexdigit = eq is_hexdigit, 1
    ok_punctuation = eq is_punctuation, 1
    ok_graphic = eq is_graphic, 1
    ok_whitespace = eq is_whitespace, 1
    ok_control = eq is_control, 1
    ok_char_escape_flag = eq char_escape_ok, 1
    ok_char_escape_len = eq char_escape_len, 2
    ok_char_escape0 = eq char_escape0, 92
    ok_char_escape1 = eq char_escape1, 110

    ok01 = and ok_from, ok_from_bad
    ok02 = and ok01, ok_digit
    ok03 = and ok02, ok_digit_bad
    ok04 = and ok03, ok_a_byte
    ok05 = and ok04, ok_a_scalar
    ok06 = and ok05, ok_bytes_len
    ok07 = and ok06, ok_bytes0
    ok08 = and ok07, ok_upper
    ok09 = and ok08, ok_lower
    ok10 = and ok09, ok_made_upper
    ok11 = and ok10, ok_made_lower
    ok12 = and ok11, ok_eq_ignore
    ok13 = and ok12, ok_alpha
    ok14 = and ok13, ok_not_upper
    ok15 = and ok14, ok_lowercase
    ok16 = and ok15, ok_alnum
    ok17 = and ok16, ok_digit_class
    ok18 = and ok17, ok_octdigit
    ok19 = and ok18, ok_hexdigit
    ok20 = and ok19, ok_punctuation
    ok21 = and ok20, ok_graphic
    ok22 = and ok21, ok_whitespace
    ok23 = and ok22, ok_control
    ok24 = and ok23, ok_char_escape_flag
    ok25 = and ok24, ok_char_escape_len
    ok26 = and ok25, ok_char_escape0
    ok = and ok26, ok_char_escape1

    !char_escape_p1
    !char_escape0
    !char_escape1
    !char_escape_ok
    !char_escape_len
    !bytes_ptr
    !bytes_len
    !bytes0
    !a_byte
    !a_scalar
