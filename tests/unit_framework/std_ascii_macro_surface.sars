@import "sa_std/ascii.sars"
@import "sa_std/core/slice.sars"

@const MIXED = utf8:"RuSt!9"
@const LOWER = utf8:"rust!9"
@const UPPER = utf8:"RUST!9"
@const SHORT = utf8:"rust"

@test "sa_std ascii byte classifier macros"():
L_ENTRY:
    EXPAND ASCII_IS_ASCII ascii_del, 127
    EXPAND ASCII_IS_ASCII ascii_high, 128
    EXPAND ASCII_IS_UPPERCASE upper_a, 65
    EXPAND ASCII_IS_UPPERCASE upper_lower_a, 97
    EXPAND ASCII_IS_LOWERCASE lower_a, 97
    EXPAND ASCII_IS_LOWERCASE lower_upper_a, 65
    EXPAND ASCII_IS_ALPHABETIC alpha_upper, 65
    EXPAND ASCII_IS_ALPHABETIC alpha_lower, 97
    EXPAND ASCII_IS_ALPHABETIC alpha_digit, 48
    EXPAND ASCII_IS_DIGIT digit_zero, 48
    EXPAND ASCII_IS_DIGIT digit_alpha, 65
    EXPAND ASCII_IS_OCTDIGIT oct_seven, 55
    EXPAND ASCII_IS_OCTDIGIT oct_nine, 57
    EXPAND ASCII_IS_HEXDIGIT hex_upper_f, 70
    EXPAND ASCII_IS_HEXDIGIT hex_upper_g, 71
    EXPAND ASCII_IS_HEXDIGIT hex_lower_f, 102
    EXPAND ASCII_IS_HEXDIGIT hex_lower_g, 103
    EXPAND ASCII_IS_HEXDIGIT hex_zero, 48
    EXPAND ASCII_IS_ALPHANUMERIC alnum_alpha, 65
    EXPAND ASCII_IS_ALPHANUMERIC alnum_digit, 48
    EXPAND ASCII_IS_ALPHANUMERIC alnum_percent, 37
    EXPAND ASCII_IS_PUNCTUATION punct_percent, 37
    EXPAND ASCII_IS_PUNCTUATION punct_alpha, 65
    EXPAND ASCII_IS_PUNCTUATION punct_space, 32
    EXPAND ASCII_IS_GRAPHIC graphic_percent, 37
    EXPAND ASCII_IS_GRAPHIC graphic_tilde, 126
    EXPAND ASCII_IS_GRAPHIC graphic_space, 32
    EXPAND ASCII_IS_GRAPHIC graphic_lf, 10
    EXPAND ASCII_IS_WHITESPACE ws_space, 32
    EXPAND ASCII_IS_WHITESPACE ws_tab, 9
    EXPAND ASCII_IS_WHITESPACE ws_lf, 10
    EXPAND ASCII_IS_WHITESPACE ws_ff, 12
    EXPAND ASCII_IS_WHITESPACE ws_cr, 13
    EXPAND ASCII_IS_WHITESPACE ws_vt, 11
    EXPAND ASCII_IS_WHITESPACE ws_alpha, 65
    EXPAND ASCII_IS_CONTROL ctrl_lf, 10
    EXPAND ASCII_IS_CONTROL ctrl_esc, 27
    EXPAND ASCII_IS_CONTROL ctrl_del, 127
    EXPAND ASCII_IS_CONTROL ctrl_space, 32

    ascii_del_ok = eq ascii_del, 1
    ascii_high_ok = eq ascii_high, 0
    upper_a_ok = eq upper_a, 1
    upper_lower_a_ok = eq upper_lower_a, 0
    lower_a_ok = eq lower_a, 1
    lower_upper_a_ok = eq lower_upper_a, 0
    alpha_upper_ok = eq alpha_upper, 1
    alpha_lower_ok = eq alpha_lower, 1
    alpha_digit_ok = eq alpha_digit, 0
    digit_zero_ok = eq digit_zero, 1
    digit_alpha_ok = eq digit_alpha, 0
    oct_seven_ok = eq oct_seven, 1
    oct_nine_ok = eq oct_nine, 0
    hex_upper_f_ok = eq hex_upper_f, 1
    hex_upper_g_ok = eq hex_upper_g, 0
    hex_lower_f_ok = eq hex_lower_f, 1
    hex_lower_g_ok = eq hex_lower_g, 0
    hex_zero_ok = eq hex_zero, 1
    alnum_alpha_ok = eq alnum_alpha, 1
    alnum_digit_ok = eq alnum_digit, 1
    alnum_percent_ok = eq alnum_percent, 0
    punct_percent_ok = eq punct_percent, 1
    punct_alpha_ok = eq punct_alpha, 0
    punct_space_ok = eq punct_space, 0
    graphic_percent_ok = eq graphic_percent, 1
    graphic_tilde_ok = eq graphic_tilde, 1
    graphic_space_ok = eq graphic_space, 0
    graphic_lf_ok = eq graphic_lf, 0
    ws_space_ok = eq ws_space, 1
    ws_tab_ok = eq ws_tab, 1
    ws_lf_ok = eq ws_lf, 1
    ws_ff_ok = eq ws_ff, 1
    ws_cr_ok = eq ws_cr, 1
    ws_vt_ok = eq ws_vt, 0
    ws_alpha_ok = eq ws_alpha, 0
    ctrl_lf_ok = eq ctrl_lf, 1
    ctrl_esc_ok = eq ctrl_esc, 1
    ctrl_del_ok = eq ctrl_del, 1
    ctrl_space_ok = eq ctrl_space, 0

    ok01 = and ascii_del_ok, ascii_high_ok
    ok02 = and ok01, upper_a_ok
    ok03 = and ok02, upper_lower_a_ok
    ok04 = and ok03, lower_a_ok
    ok05 = and ok04, lower_upper_a_ok
    ok06 = and ok05, alpha_upper_ok
    ok07 = and ok06, alpha_lower_ok
    ok08 = and ok07, alpha_digit_ok
    ok09 = and ok08, digit_zero_ok
    ok10 = and ok09, digit_alpha_ok
    ok11 = and ok10, oct_seven_ok
    ok12 = and ok11, oct_nine_ok
    ok13 = and ok12, hex_upper_f_ok
    ok14 = and ok13, hex_upper_g_ok
    ok15 = and ok14, hex_lower_f_ok
    ok16 = and ok15, hex_lower_g_ok
    ok17 = and ok16, hex_zero_ok
    ok18 = and ok17, alnum_alpha_ok
    ok19 = and ok18, alnum_digit_ok
    ok20 = and ok19, alnum_percent_ok
    ok21 = and ok20, punct_percent_ok
    ok22 = and ok21, punct_alpha_ok
    ok23 = and ok22, punct_space_ok
    ok24 = and ok23, graphic_percent_ok
    ok25 = and ok24, graphic_tilde_ok
    ok26 = and ok25, graphic_space_ok
    ok27 = and ok26, graphic_lf_ok
    ok28 = and ok27, ws_space_ok
    ok29 = and ok28, ws_tab_ok
    ok30 = and ok29, ws_lf_ok
    ok31 = and ok30, ws_ff_ok
    ok32 = and ok31, ws_cr_ok
    ok33 = and ok32, ws_vt_ok
    ok34 = and ok33, ws_alpha_ok
    ok35 = and ok34, ctrl_lf_ok
    ok36 = and ok35, ctrl_esc_ok
    ok37 = and ok36, ctrl_del_ok
    ok = and ok37, ctrl_space_ok

    !ascii_del
    !ascii_high
    !upper_a
    !upper_lower_a
    !lower_a
    !lower_upper_a
    !alpha_upper
    !alpha_lower
    !alpha_digit
    !digit_zero
    !digit_alpha
    !oct_seven
    !oct_nine
    !hex_upper_f
    !hex_upper_g
    !hex_lower_f
    !hex_lower_g
    !hex_zero
    !alnum_alpha
    !alnum_digit
    !alnum_percent
    !punct_percent
    !punct_alpha
    !punct_space
    !graphic_percent
    !graphic_tilde
    !graphic_space
    !graphic_lf
    !ws_space
    !ws_tab
    !ws_lf
    !ws_ff
    !ws_cr
    !ws_vt
    !ws_alpha
    !ctrl_lf
    !ctrl_esc
    !ctrl_del
    !ctrl_space
    !ascii_del_ok
    !ascii_high_ok
    !upper_a_ok
    !upper_lower_a_ok
    !lower_a_ok
    !lower_upper_a_ok
    !alpha_upper_ok
    !alpha_lower_ok
    !alpha_digit_ok
    !digit_zero_ok
    !digit_alpha_ok
    !oct_seven_ok
    !oct_nine_ok
    !hex_upper_f_ok
    !hex_upper_g_ok
    !hex_lower_f_ok
    !hex_lower_g_ok
    !hex_zero_ok
    !alnum_alpha_ok
    !alnum_digit_ok
    !alnum_percent_ok
    !punct_percent_ok
    !punct_alpha_ok
    !punct_space_ok
    !graphic_percent_ok
    !graphic_tilde_ok
    !graphic_space_ok
    !graphic_lf_ok
    !ws_space_ok
    !ws_tab_ok
    !ws_lf_ok
    !ws_ff_ok
    !ws_cr_ok
    !ws_vt_ok
    !ws_alpha_ok
    !ctrl_lf_ok
    !ctrl_esc_ok
    !ctrl_del_ok
    !ctrl_space_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    !ok33
    !ok34
    !ok35
    !ok36
    !ok37
    br ok -> L_CLASS_OK, L_CLASS_FAIL

L_CLASS_FAIL:
    !ok
    panic(930)

L_CLASS_OK:
    !ok
    return

@test "sa_std ascii case conversion macros"():
L_ENTRY:
    EXPAND ASCII_TO_UPPERCASE upper_from_lower, 97
    EXPAND ASCII_TO_UPPERCASE upper_keep, 65
    EXPAND ASCII_TO_UPPERCASE upper_punct, 37
    EXPAND ASCII_TO_LOWERCASE lower_from_upper, 65
    EXPAND ASCII_TO_LOWERCASE lower_keep, 97
    EXPAND ASCII_TO_LOWERCASE lower_punct, 37
    EXPAND ASCII_EQ_IGNORE_CASE eq_a, 97, 65
    EXPAND ASCII_EQ_IGNORE_CASE eq_g, 103, 71
    EXPAND ASCII_EQ_IGNORE_CASE eq_miss, 103, 102

    buf = alloc 2
    store buf+0, 97 as u8
    store buf+1, 65 as u8
    byte1 = ptr_add buf, 1
    EXPAND ASCII_BYTE_MAKE_UPPERCASE byte0_ok, buf
    EXPAND ASCII_BYTE_MAKE_LOWERCASE byte1_ok, byte1
    b0 = load buf+0 as u8
    b1 = load buf+1 as u8

    upper_from_lower_ok = eq upper_from_lower, 65
    upper_keep_ok = eq upper_keep, 65
    upper_punct_ok = eq upper_punct, 37
    lower_from_upper_ok = eq lower_from_upper, 97
    lower_keep_ok = eq lower_keep, 97
    lower_punct_ok = eq lower_punct, 37
    eq_a_ok = eq eq_a, 1
    eq_g_ok = eq eq_g, 1
    eq_miss_ok = eq eq_miss, 0
    byte0_ok_ok = eq byte0_ok, 1
    byte1_ok_ok = eq byte1_ok, 1
    b0_ok = eq b0, 65
    b1_ok = eq b1, 97

    ok01 = and upper_from_lower_ok, upper_keep_ok
    ok02 = and ok01, upper_punct_ok
    ok03 = and ok02, lower_from_upper_ok
    ok04 = and ok03, lower_keep_ok
    ok05 = and ok04, lower_punct_ok
    ok06 = and ok05, eq_a_ok
    ok07 = and ok06, eq_g_ok
    ok08 = and ok07, eq_miss_ok
    ok09 = and ok08, byte0_ok_ok
    ok10 = and ok09, byte1_ok_ok
    ok11 = and ok10, b0_ok
    ok = and ok11, b1_ok

    !upper_from_lower
    !upper_keep
    !upper_punct
    !lower_from_upper
    !lower_keep
    !lower_punct
    !eq_a
    !eq_g
    !eq_miss
    !byte0_ok
    !byte1_ok
    !b0
    !b1
    !upper_from_lower_ok
    !upper_keep_ok
    !upper_punct_ok
    !lower_from_upper_ok
    !lower_keep_ok
    !lower_punct_ok
    !eq_a_ok
    !eq_g_ok
    !eq_miss_ok
    !byte0_ok_ok
    !byte1_ok_ok
    !b0_ok
    !b1_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !byte1
    !buf
    br ok -> L_CASE_OK, L_CASE_FAIL

L_CASE_FAIL:
    !ok
    panic(931)

L_CASE_OK:
    !ok
    return

@test "sa_std ascii slice case macros"():
L_ENTRY:
    mixed = alloc Slice_SIZE
    lower = alloc Slice_SIZE
    upper = alloc Slice_SIZE
    short = alloc Slice_SIZE
    EXPAND SLICE_NEW mixed, &MIXED, 6
    EXPAND SLICE_NEW lower, &LOWER, 6
    EXPAND SLICE_NEW upper, &UPPER, 6
    EXPAND SLICE_NEW short, &SHORT, 4
    EXPAND ASCII_SLICE_EQ_IGNORE_CASE mixed_lower_eq, mixed, lower
    EXPAND ASCII_SLICE_EQ_IGNORE_CASE mixed_upper_eq, mixed, upper
    EXPAND ASCII_SLICE_EQ_IGNORE_CASE mixed_short_eq, mixed, short

    buf = alloc 6
    store buf+0, 82 as u8
    store buf+1, 117 as u8
    store buf+2, 83 as u8
    store buf+3, 116 as u8
    store buf+4, 33 as u8
    store buf+5, 57 as u8
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, buf, 6
    EXPAND ASCII_SLICE_MAKE_LOWERCASE lower_ok, slice
    l0 = load buf+0 as u8
    l1 = load buf+1 as u8
    l2 = load buf+2 as u8
    l3 = load buf+3 as u8
    l4 = load buf+4 as u8
    l5 = load buf+5 as u8
    EXPAND ASCII_SLICE_MAKE_UPPERCASE upper_ok, slice
    u0 = load buf+0 as u8
    u1 = load buf+1 as u8
    u2 = load buf+2 as u8
    u3 = load buf+3 as u8
    u4 = load buf+4 as u8
    u5 = load buf+5 as u8

    mixed_lower_eq_ok = eq mixed_lower_eq, 1
    mixed_upper_eq_ok = eq mixed_upper_eq, 1
    mixed_short_eq_ok = eq mixed_short_eq, 0
    lower_ok_ok = eq lower_ok, 1
    upper_ok_ok = eq upper_ok, 1
    l0_ok = eq l0, 114
    l1_ok = eq l1, 117
    l2_ok = eq l2, 115
    l3_ok = eq l3, 116
    l4_ok = eq l4, 33
    l5_ok = eq l5, 57
    u0_ok = eq u0, 82
    u1_ok = eq u1, 85
    u2_ok = eq u2, 83
    u3_ok = eq u3, 84
    u4_ok = eq u4, 33
    u5_ok = eq u5, 57

    ok01 = and mixed_lower_eq_ok, mixed_upper_eq_ok
    ok02 = and ok01, mixed_short_eq_ok
    ok03 = and ok02, lower_ok_ok
    ok04 = and ok03, upper_ok_ok
    ok05 = and ok04, l0_ok
    ok06 = and ok05, l1_ok
    ok07 = and ok06, l2_ok
    ok08 = and ok07, l3_ok
    ok09 = and ok08, l4_ok
    ok10 = and ok09, l5_ok
    ok11 = and ok10, u0_ok
    ok12 = and ok11, u1_ok
    ok13 = and ok12, u2_ok
    ok14 = and ok13, u3_ok
    ok15 = and ok14, u4_ok
    ok = and ok15, u5_ok

    !mixed_lower_eq
    !mixed_upper_eq
    !mixed_short_eq
    !lower_ok
    !upper_ok
    !l0
    !l1
    !l2
    !l3
    !l4
    !l5
    !u0
    !u1
    !u2
    !u3
    !u4
    !u5
    !mixed_lower_eq_ok
    !mixed_upper_eq_ok
    !mixed_short_eq_ok
    !lower_ok_ok
    !upper_ok_ok
    !l0_ok
    !l1_ok
    !l2_ok
    !l3_ok
    !l4_ok
    !l5_ok
    !u0_ok
    !u1_ok
    !u2_ok
    !u3_ok
    !u4_ok
    !u5_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !slice
    !buf
    !short
    !upper
    !lower
    !mixed
    br ok -> L_SLICE_OK, L_SLICE_FAIL

L_SLICE_FAIL:
    !ok
    panic(932)

L_SLICE_OK:
    !ok
    return

@test "sa_std ascii slice as_ascii view macros"():
L_ENTRY:
    good = alloc Slice_SIZE
    bad = alloc Slice_SIZE
    good_view = alloc Slice_SIZE
    bad_view = alloc Slice_SIZE
    unchecked_view = alloc Slice_SIZE
    mut_view = alloc Slice_SIZE

    bad_buf = alloc 3
    store bad_buf+0, 65 as u8
    store bad_buf+1, 128 as u8
    store bad_buf+2, 90 as u8

    EXPAND SLICE_NEW good, &MIXED, 6
    EXPAND SLICE_NEW bad, bad_buf, 3
    EXPAND ASCII_SLICE_IS_ASCII good_is_ascii, good
    EXPAND ASCII_SLICE_IS_ASCII bad_is_ascii, bad
    EXPAND ASCII_SLICE_AS_ASCII good_ok, good_view, good
    EXPAND ASCII_SLICE_AS_ASCII bad_ok, bad_view, bad
    EXPAND ASCII_SLICE_AS_ASCII_UNCHECKED unchecked_view, bad
    EXPAND ASCII_SLICE_AS_ASCII_MUT mut_ok, mut_view, good

    good_ptr = load good_view+Slice_ptr as ptr
    good_len = load good_view+Slice_len as u64
    bad_ptr = load bad_view+Slice_ptr as ptr
    bad_len = load bad_view+Slice_len as u64
    unchecked_ptr = load unchecked_view+Slice_ptr as ptr
    unchecked_len = load unchecked_view+Slice_len as u64
    mut_ptr = load mut_view+Slice_ptr as ptr
    mut_len = load mut_view+Slice_len as u64
    source_ptr = load good+Slice_ptr as ptr
    null_ptr = 0 as ptr

    good_is_ok = eq good_is_ascii, 1
    bad_is_ok = eq bad_is_ascii, 0
    good_ok_ok = eq good_ok, 1
    bad_ok_ok = eq bad_ok, 0
    mut_ok_ok = eq mut_ok, 1
    good_ptr_ok = eq good_ptr, source_ptr
    good_len_ok = eq good_len, 6
    bad_ptr_ok = eq bad_ptr, null_ptr
    bad_len_ok = eq bad_len, 0
    unchecked_ptr_ok = eq unchecked_ptr, bad_buf
    unchecked_len_ok = eq unchecked_len, 3
    mut_ptr_ok = eq mut_ptr, source_ptr
    mut_len_ok = eq mut_len, 6

    ok01 = and good_is_ok, bad_is_ok
    ok02 = and ok01, good_ok_ok
    ok03 = and ok02, bad_ok_ok
    ok04 = and ok03, mut_ok_ok
    ok05 = and ok04, good_ptr_ok
    ok06 = and ok05, good_len_ok
    ok07 = and ok06, bad_ptr_ok
    ok08 = and ok07, bad_len_ok
    ok09 = and ok08, unchecked_ptr_ok
    ok10 = and ok09, unchecked_len_ok
    ok11 = and ok10, mut_ptr_ok
    ok = and ok11, mut_len_ok

    !good_is_ascii
    !bad_is_ascii
    !good_ok
    !bad_ok
    !mut_ok
    !good_ptr
    !good_len
    !bad_ptr
    !bad_len
    !unchecked_ptr
    !unchecked_len
    !mut_ptr
    !mut_len
    !source_ptr
    !null_ptr
    !good_is_ok
    !bad_is_ok
    !good_ok_ok
    !bad_ok_ok
    !mut_ok_ok
    !good_ptr_ok
    !good_len_ok
    !bad_ptr_ok
    !bad_len_ok
    !unchecked_ptr_ok
    !unchecked_len_ok
    !mut_ptr_ok
    !mut_len_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !mut_view
    !unchecked_view
    !bad_view
    !good_view
    !bad
    !good
    !bad_buf
    br ok -> L_ASCII_VIEW_OK, L_ASCII_VIEW_FAIL

L_ASCII_VIEW_FAIL:
    !ok
    panic(936)

L_ASCII_VIEW_OK:
    !ok
    return

@test "sa_std ascii escape_default macro"():
L_ENTRY:
    out = stack_alloc 8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE raw_ok, raw_len, out, 8, 65
    raw0 = load out+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE space_ok, space_len, out, 8, 32
    space0 = load out+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE lf_ok, lf_len, out, 8, 10
    lf0 = load out+0 as u8
    lf_p1 = ptr_add out, 1
    lf1 = load lf_p1+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE tab_ok, tab_len, out, 8, 9
    tab0 = load out+0 as u8
    tab_p1 = ptr_add out, 1
    tab1 = load tab_p1+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE cr_ok, cr_len, out, 8, 13
    cr0 = load out+0 as u8
    cr_p1 = ptr_add out, 1
    cr1 = load cr_p1+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE backslash_ok, backslash_len, out, 8, 92
    backslash0 = load out+0 as u8
    backslash_p1 = ptr_add out, 1
    backslash1 = load backslash_p1+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE single_ok, single_len, out, 8, 39
    single0 = load out+0 as u8
    single_p1 = ptr_add out, 1
    single1 = load single_p1+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE double_ok, double_len, out, 8, 34
    double0 = load out+0 as u8
    double_p1 = ptr_add out, 1
    double1 = load double_p1+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE nul_ok, nul_len, out, 8, 0
    nul0 = load out+0 as u8
    nul_p1 = ptr_add out, 1
    nul_p2 = ptr_add out, 2
    nul_p3 = ptr_add out, 3
    nul1 = load nul_p1+0 as u8
    nul2 = load nul_p2+0 as u8
    nul3 = load nul_p3+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE esc_ok, esc_len, out, 8, 27
    esc0 = load out+0 as u8
    esc_p1 = ptr_add out, 1
    esc_p2 = ptr_add out, 2
    esc_p3 = ptr_add out, 3
    esc1 = load esc_p1+0 as u8
    esc2 = load esc_p2+0 as u8
    esc3 = load esc_p3+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE del_ok, del_len, out, 8, 127
    del0 = load out+0 as u8
    del_p1 = ptr_add out, 1
    del_p2 = ptr_add out, 2
    del_p3 = ptr_add out, 3
    del1 = load del_p1+0 as u8
    del2 = load del_p2+0 as u8
    del3 = load del_p3+0 as u8

    EXPAND ASCII_ESCAPE_DEFAULT_WRITE short_pair_ok, short_pair_len, out, 1, 10
    EXPAND ASCII_ESCAPE_DEFAULT_WRITE short_hex_ok, short_hex_len, out, 3, 0

    ok01 = eq raw_ok, 1
    ok02 = eq raw_len, 1
    ok03 = eq raw0, 65
    ok04 = eq space_ok, 1
    ok05 = eq space_len, 1
    ok06 = eq space0, 32
    ok07 = eq lf_ok, 1
    ok08 = eq lf_len, 2
    ok09 = eq lf0, 92
    ok10 = eq lf1, 110
    ok11 = eq tab_ok, 1
    ok12 = eq tab_len, 2
    ok13 = eq tab0, 92
    ok14 = eq tab1, 116
    ok15 = eq cr_ok, 1
    ok16 = eq cr_len, 2
    ok17 = eq cr0, 92
    ok18 = eq cr1, 114
    ok19 = eq backslash_ok, 1
    ok20 = eq backslash_len, 2
    ok21 = eq backslash0, 92
    ok22 = eq backslash1, 92
    ok23 = eq single_ok, 1
    ok24 = eq single_len, 2
    ok25 = eq single0, 92
    ok26 = eq single1, 39
    ok27 = eq double_ok, 1
    ok28 = eq double_len, 2
    ok29 = eq double0, 92
    ok30 = eq double1, 34
    ok31 = eq nul_ok, 1
    ok32 = eq nul_len, 4
    ok33 = eq nul0, 92
    ok34 = eq nul1, 120
    ok35 = eq nul2, 48
    ok36 = eq nul3, 48
    ok37 = eq esc_ok, 1
    ok38 = eq esc_len, 4
    ok39 = eq esc0, 92
