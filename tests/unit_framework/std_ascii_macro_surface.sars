    !ok_from
    !ok_from_bad
    !ok_digit
    !ok_digit_bad
    !ok_a_byte
    !ok_a_scalar
    !ok_bytes_len
    !ok_bytes0
    !ok_upper
    !ok_lower
    !ok_made_upper
    !ok_made_lower
    !ok_eq_ignore
    !ok_alpha
    !ok_not_upper
    !ok_lowercase
    !ok_alnum
    !ok_digit_class
    !ok_octdigit
    !ok_hexdigit
    !ok_punctuation
    !ok_graphic
    !ok_whitespace
    !ok_control
    !ok_char_escape_flag
    !ok_char_escape_len
    !ok_char_escape0
    !ok_char_escape1
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
