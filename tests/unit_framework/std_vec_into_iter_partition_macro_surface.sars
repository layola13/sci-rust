@import "sa_std/vec.sars"

@vec_into_iter_partition_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    !value
    return out

@vec_into_iter_partition_gt_zero(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 0
    !value
    return out

@test "sa_std vec into_iter partition macro surface"():
L_ENTRY:
    EXPAND VEC_NEW partition_src
    EXPAND VEC_PUSH_U64 partition_src, 1
    EXPAND VEC_PUSH_U64 partition_src, 2
    EXPAND VEC_PUSH_U64 partition_src, 3
    EXPAND VEC_PUSH_U64 partition_src, 4
    EXPAND VEC_PUSH_U64 partition_src, 5
    EXPAND VEC_INTO_ITER_U64 partition_iter, partition_backing, partition_src
    EXPAND VEC_INTO_ITER_NEXT_U64 partition_skip_has, partition_skip, partition_iter
    EXPAND VEC_INTO_ITER_PARTITION_U64 true_vec, false_vec, partition_iter, @vec_into_iter_partition_is_even
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 partition_empty, partition_iter
    EXPAND VEC_LEN true_len, true_vec
    EXPAND VEC_LEN false_len, false_vec
    EXPAND VEC_GET_U64 true_0, true_vec, 0
    EXPAND VEC_GET_U64 true_1, true_vec, 1
    EXPAND VEC_GET_U64 false_0, false_vec, 0
    EXPAND VEC_GET_U64 false_1, false_vec, 1

    EXPAND VEC_INTO_ITER_DEFAULT_U64 empty_partition_iter, empty_partition_backing
    EXPAND VEC_INTO_ITER_PARTITION_U64 empty_true_vec, empty_false_vec, empty_partition_iter, @vec_into_iter_partition_is_even
    EXPAND VEC_LEN empty_true_len, empty_true_vec
    EXPAND VEC_LEN empty_false_len, empty_false_vec
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_partition_empty, empty_partition_iter

    EXPAND VEC_NEW partitioned_src
    EXPAND VEC_PUSH_U64 partitioned_src, 3
    EXPAND VEC_PUSH_U64 partitioned_src, 2
    EXPAND VEC_PUSH_U64 partitioned_src, 1
    EXPAND VEC_PUSH_U64 partitioned_src, 0
    EXPAND VEC_PUSH_U64 partitioned_src, 0
    EXPAND VEC_INTO_ITER_U64 partitioned_iter, partitioned_backing, partitioned_src
    EXPAND VEC_INTO_ITER_IS_PARTITIONED_U64 partitioned_ok, partitioned_iter, @vec_into_iter_partition_gt_zero
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 partitioned_empty, partitioned_iter

    EXPAND VEC_NEW not_partitioned_src
    EXPAND VEC_PUSH_U64 not_partitioned_src, 3
    EXPAND VEC_PUSH_U64 not_partitioned_src, 0
    EXPAND VEC_PUSH_U64 not_partitioned_src, 2
    EXPAND VEC_PUSH_U64 not_partitioned_src, 0
    EXPAND VEC_PUSH_U64 not_partitioned_src, 0
    EXPAND VEC_INTO_ITER_U64 not_partitioned_iter, not_partitioned_backing, not_partitioned_src
    EXPAND VEC_INTO_ITER_IS_PARTITIONED_U64 not_partitioned_ok, not_partitioned_iter, @vec_into_iter_partition_gt_zero
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 not_partitioned_remaining, not_partitioned_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 not_partitioned_next_has, not_partitioned_next, not_partitioned_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 not_partitioned_next2_has, not_partitioned_next2, not_partitioned_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 not_partitioned_empty, not_partitioned_iter

    EXPAND VEC_NEW all_true_src
    EXPAND VEC_PUSH_U64 all_true_src, 7
    EXPAND VEC_PUSH_U64 all_true_src, 6
    EXPAND VEC_PUSH_U64 all_true_src, 5
    EXPAND VEC_INTO_ITER_U64 all_true_iter, all_true_backing, all_true_src
    EXPAND VEC_INTO_ITER_IS_PARTITIONED_U64 all_true_ok, all_true_iter, @vec_into_iter_partition_gt_zero
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 all_true_empty, all_true_iter

    EXPAND VEC_INTO_ITER_DEFAULT_U64 empty_is_partitioned_iter, empty_is_partitioned_backing
    EXPAND VEC_INTO_ITER_IS_PARTITIONED_U64 empty_is_partitioned_ok, empty_is_partitioned_iter, @vec_into_iter_partition_gt_zero
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_is_partitioned_empty, empty_is_partitioned_iter

    EXPAND VEC_FREE partition_backing
    EXPAND VEC_FREE true_vec
    EXPAND VEC_FREE false_vec
    EXPAND VEC_FREE empty_partition_backing
    EXPAND VEC_FREE empty_true_vec
    EXPAND VEC_FREE empty_false_vec
    EXPAND VEC_FREE partitioned_backing
    EXPAND VEC_FREE not_partitioned_backing
    EXPAND VEC_FREE all_true_backing
    EXPAND VEC_FREE empty_is_partitioned_backing

    ok_partition_skip_has = eq partition_skip_has, 1
    ok_partition_skip = eq partition_skip, 1
    ok_partition_empty = eq partition_empty, 1
    ok_true_len = eq true_len, 2
    ok_false_len = eq false_len, 2
    ok_true_0 = eq true_0, 2
    ok_true_1 = eq true_1, 4
    ok_false_0 = eq false_0, 3
    ok_false_1 = eq false_1, 5
    ok_empty_true_len = eq empty_true_len, 0
    ok_empty_false_len = eq empty_false_len, 0
    ok_empty_partition_empty = eq empty_partition_empty, 1
    ok_partitioned = eq partitioned_ok, 1
    ok_partitioned_empty = eq partitioned_empty, 1
    ok_not_partitioned = eq not_partitioned_ok, 0
    ok_not_partitioned_remaining = eq not_partitioned_remaining, 2
    ok_not_partitioned_next_has = eq not_partitioned_next_has, 1
    ok_not_partitioned_next = eq not_partitioned_next, 0
    ok_not_partitioned_next2_has = eq not_partitioned_next2_has, 1
    ok_not_partitioned_next2 = eq not_partitioned_next2, 0
    ok_not_partitioned_empty = eq not_partitioned_empty, 1
    ok_all_true = eq all_true_ok, 1
    ok_all_true_empty = eq all_true_empty, 1
    ok_empty_is_partitioned = eq empty_is_partitioned_ok, 1
    ok_empty_is_partitioned_empty = eq empty_is_partitioned_empty, 1

    ok = and ok_partition_skip_has, ok_partition_skip
    ok = and ok, ok_partition_empty
    ok = and ok, ok_true_len
    ok = and ok, ok_false_len
    ok = and ok, ok_true_0
    ok = and ok, ok_true_1
    ok = and ok, ok_false_0
    ok = and ok, ok_false_1
    ok = and ok, ok_empty_true_len
    ok = and ok, ok_empty_false_len
    ok = and ok, ok_empty_partition_empty
    ok = and ok, ok_partitioned
    ok = and ok, ok_partitioned_empty
    ok = and ok, ok_not_partitioned
    ok = and ok, ok_not_partitioned_remaining
    ok = and ok, ok_not_partitioned_next_has
    ok = and ok, ok_not_partitioned_next
    ok = and ok, ok_not_partitioned_next2_has
    ok = and ok, ok_not_partitioned_next2
    ok = and ok, ok_not_partitioned_empty
    ok = and ok, ok_all_true
    ok = and ok, ok_all_true_empty
    ok = and ok, ok_empty_is_partitioned
    ok = and ok, ok_empty_is_partitioned_empty

    !partition_skip_has
    !partition_skip
    !partition_empty
    !true_len
    !false_len
    !true_0
    !true_1
    !false_0
    !false_1
    !empty_true_len
    !empty_false_len
    !empty_partition_empty
    !partitioned_ok
    !partitioned_empty
    !not_partitioned_ok
    !not_partitioned_remaining
    !not_partitioned_next_has
    !not_partitioned_next
    !not_partitioned_next2_has
    !not_partitioned_next2
    !not_partitioned_empty
    !all_true_ok
    !all_true_empty
    !empty_is_partitioned_ok
    !empty_is_partitioned_empty
    !ok_partition_skip_has
    !ok_partition_skip
    !ok_partition_empty
    !ok_true_len
    !ok_false_len
    !ok_true_0
    !ok_true_1
    !ok_false_0
    !ok_false_1
    !ok_empty_true_len
    !ok_empty_false_len
    !ok_empty_partition_empty
    !ok_partitioned
    !ok_partitioned_empty
    !ok_not_partitioned
    !ok_not_partitioned_remaining
    !ok_not_partitioned_next_has
    !ok_not_partitioned_next
    !ok_not_partitioned_next2_has
    !ok_not_partitioned_next2
    !ok_not_partitioned_empty
    !ok_all_true
    !ok_all_true_empty
    !ok_empty_is_partitioned
    !ok_empty_is_partitioned_empty
    !partition_iter
    !empty_partition_iter
    !partitioned_iter
    !not_partitioned_iter
    !all_true_iter
    !empty_is_partitioned_iter
    br ok -> L_VEC_INTO_ITER_PARTITION_OK, L_VEC_INTO_ITER_PARTITION_FAIL

L_VEC_INTO_ITER_PARTITION_FAIL:
    !ok
    panic(10726)

L_VEC_INTO_ITER_PARTITION_OK:
    !ok
    return
