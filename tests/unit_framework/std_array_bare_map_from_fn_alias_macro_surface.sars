@import "sa_std/array.sars"

@array_from_fn_double(index: u64) -> u64:
L_ENTRY:
    out = mul index, 2
    return out

@array_map_plus_ten(value: u64) -> u64:
L_ENTRY:
    out = add value, 10
    return out

@test "sa_std array bare map/from_fn alias macro surface"():
L_ENTRY:
    src = stack_alloc 32
    store src+0, 10 as u64
    store src+8, 20 as u64
    store src+16, 30 as u64
    store src+24, 40 as u64

    generated = stack_alloc 32
    EXPAND ARRAY_FROM_FN generated, 4, @array_from_fn_double
    generated0 = load generated+0 as u64
    generated3 = load generated+24 as u64

    EXPAND ARRAY_REPEAT generated, 4, 99
    repeat0 = load generated+0 as u64
    repeat3 = load generated+24 as u64

    mapped = stack_alloc 32
    EXPAND ARRAY_MAP mapped, src, 4, @array_map_plus_ten
    mapped0 = load mapped+0 as u64
    mapped3 = load mapped+24 as u64

    ok_generated0 = eq generated0, 0
    ok_generated3 = eq generated3, 6
    ok_repeat0 = eq repeat0, 99
    ok_repeat3 = eq repeat3, 99
    ok_mapped0 = eq mapped0, 20
    ok_mapped3 = eq mapped3, 50

    ok01 = and ok_generated0, ok_generated3
    ok02 = and ok01, ok_repeat0
    ok03 = and ok02, ok_repeat3
    ok04 = and ok03, ok_mapped0
    ok = and ok04, ok_mapped3

    !generated0
    !generated3
    !repeat0
    !repeat3
    !mapped0
    !mapped3
    !ok_generated0
    !ok_generated3
    !ok_repeat0
    !ok_repeat3
    !ok_mapped0
    !ok_mapped3
    !ok01
    !ok02
    !ok03
    !ok04
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10853)

L_PASS:
    !ok
    return 0
