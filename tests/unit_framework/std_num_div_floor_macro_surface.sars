@import "sa_std/num.sars"

[MACRO] TEST_DIV_FLOOR_EQ %out_acc, %prev_acc, %value, %expected
    __test_div_floor_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_div_floor_eq_%out_acc
    !__test_div_floor_eq_%out_acc
[END_MACRO]

@test "sa_std primitive div_floor macro surface"():
L_ENTRY:
    EXPAND NUM_U8_DIV_FLOOR u8_value, 7, 4
    EXPAND NUM_U16_DIV_FLOOR u16_value, 8, 3
    EXPAND NUM_U32_DIV_FLOOR u32_value, 9, 4
    EXPAND NUM_U64_DIV_FLOOR u64_value, 10, 3
    EXPAND NUM_USIZE_DIV_FLOOR usize_value, 11, 5

    EXPAND NUM_I8_DIV_FLOOR i8_value, 8, 3
    EXPAND NUM_I16_DIV_FLOOR i16_value, 8, -3
    EXPAND NUM_I32_DIV_FLOOR i32_value, -8, 3
    EXPAND NUM_I64_DIV_FLOOR i64_value, -8, -3
    EXPAND NUM_ISIZE_DIV_FLOOR isize_value, -9, 3

    acc_00 = eq 0, 0
    EXPAND TEST_DIV_FLOOR_EQ acc_01, acc_00, u8_value, 1
    EXPAND TEST_DIV_FLOOR_EQ acc_02, acc_01, u16_value, 2
    EXPAND TEST_DIV_FLOOR_EQ acc_03, acc_02, u32_value, 2
    EXPAND TEST_DIV_FLOOR_EQ acc_04, acc_03, u64_value, 3
    EXPAND TEST_DIV_FLOOR_EQ acc_05, acc_04, usize_value, 2
    EXPAND TEST_DIV_FLOOR_EQ acc_06, acc_05, i8_value, 2
    EXPAND TEST_DIV_FLOOR_EQ acc_07, acc_06, i16_value, -3
    EXPAND TEST_DIV_FLOOR_EQ acc_08, acc_07, i32_value, -3
    EXPAND TEST_DIV_FLOOR_EQ acc_09, acc_08, i64_value, 2
    EXPAND TEST_DIV_FLOOR_EQ acc_10, acc_09, isize_value, -3
    br acc_10 -> L_PASS, L_FAIL

L_FAIL:
    !acc_10
    panic(10645)

L_PASS:
    !acc_10
    return 0

@test should_panic "sa_std unsigned primitive div_floor panics on zero divisor"():
L_ENTRY:
    EXPAND NUM_U8_DIV_FLOOR value, 7, 0
    !value
    return 0

@test should_panic "sa_std signed primitive div_floor panics on overflow"():
L_ENTRY:
    EXPAND NUM_I64_DIV_FLOOR value, NUM_I64_MIN, -1
    !value
    return 0
