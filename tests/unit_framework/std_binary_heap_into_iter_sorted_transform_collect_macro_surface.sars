@import "sa_std/collections/binary_heap.sars"

@sorted_transform_times_ten(value: u64) -> u64:
L_ENTRY:
    out = mul value, 10
    !value
    return out

@sorted_transform_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    !value
    return out

@sorted_transform_even_tens(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    rem = urem value, 2
    keep = eq rem, 0
    br keep -> L_SORTED_FILTER_MAP_KEEP, L_SORTED_FILTER_MAP_SKIP
L_SORTED_FILTER_MAP_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !keep
    !rem
    !out_mapped
    !value
    return 1
L_SORTED_FILTER_MAP_SKIP:
    !keep
    !rem
    !out_mapped
    !value
    return 0

@sorted_transform_map_while_lt_four(value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    keep = ugt value, 2
    br keep -> L_SORTED_MAP_WHILE_KEEP, L_SORTED_MAP_WHILE_STOP
L_SORTED_MAP_WHILE_KEEP:
    mapped = mul value, 10
    store out_mapped+0, mapped as u64
    !mapped
    !keep
    !out_mapped
    !value
    return 1
L_SORTED_MAP_WHILE_STOP:
    !keep
    !out_mapped
    !value
    return 0

@test "sa_std binary_heap into_iter_sorted transform collect macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW map_heap
    EXPAND BINARY_HEAP_PUSH_U64 map_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 map_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 map_heap, 3
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 map_iter, map_backing, map_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_MAP_COLLECT_U64 map_vec, map_iter, @sorted_transform_times_ten
    EXPAND VEC_GET_U64 map_0, map_vec, 0
    EXPAND VEC_GET_U64 map_2, map_vec, 2

    EXPAND BINARY_HEAP_NEW filter_heap
    EXPAND BINARY_HEAP_PUSH_U64 filter_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 filter_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 filter_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 filter_heap, 4
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 filter_iter, filter_backing, filter_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_FILTER_COLLECT_U64 filter_vec, filter_iter, @sorted_transform_is_even
    EXPAND VEC_GET_U64 filter_0, filter_vec, 0
    EXPAND VEC_GET_U64 filter_1, filter_vec, 1

    EXPAND BINARY_HEAP_NEW filter_map_heap
    EXPAND BINARY_HEAP_PUSH_U64 filter_map_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 filter_map_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 filter_map_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 filter_map_heap, 4
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 filter_map_iter, filter_map_backing, filter_map_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_FILTER_MAP_COLLECT_U64 filter_map_vec, filter_map_iter, @sorted_transform_even_tens
    EXPAND VEC_GET_U64 filter_map_0, filter_map_vec, 0
    EXPAND VEC_GET_U64 filter_map_1, filter_map_vec, 1

    EXPAND BINARY_HEAP_NEW while_heap
    EXPAND BINARY_HEAP_PUSH_U64 while_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 while_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 while_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 while_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 while_heap, 5
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 while_iter, while_backing, while_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_MAP_WHILE_COLLECT_U64 while_vec, while_iter, @sorted_transform_map_while_lt_four
    EXPAND VEC_GET_U64 while_0, while_vec, 0
    EXPAND VEC_GET_U64 while_2, while_vec, 2
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 while_remaining, while_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 while_tail_has, while_tail, while_iter

    EXPAND VEC_FREE map_backing
    EXPAND VEC_FREE map_vec
    EXPAND VEC_FREE filter_backing
    EXPAND VEC_FREE filter_vec
    EXPAND VEC_FREE filter_map_backing
    EXPAND VEC_FREE filter_map_vec
    EXPAND VEC_FREE while_backing
    EXPAND VEC_FREE while_vec

    ok = eq map_0, 30
    check = eq map_2, 10
    ok = and ok, check
    check = eq filter_0, 4
    ok = and ok, check
    check = eq filter_1, 2
    ok = and ok, check
    check = eq filter_map_0, 40
    ok = and ok, check
    check = eq filter_map_1, 20
    ok = and ok, check
    check = eq while_0, 50
    ok = and ok, check
    check = eq while_2, 30
    ok = and ok, check
    check = eq while_remaining, 1
    ok = and ok, check
    check = eq while_tail_has, 1
    ok = and ok, check
    check = eq while_tail, 1
    ok = and ok, check

    !map_0
    !map_2
    !filter_0
    !filter_1
    !filter_map_0
    !filter_map_1
    !while_0
    !while_2
    !while_remaining
    !while_tail_has
    !while_tail
    !check
    !map_iter
    !filter_iter
    !filter_map_iter
    !while_iter
    br ok -> L_SORTED_TRANSFORM_OK, L_SORTED_TRANSFORM_FAIL
L_SORTED_TRANSFORM_FAIL:
    !ok
    panic(10781)
L_SORTED_TRANSFORM_OK:
    !ok
    return
