@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"

@iter_rfold_digits(acc: u64, value: u64) -> u64:
L_ENTRY:
    scaled = mul acc, 10
    out = add scaled, value
    !scaled
    !value
    !acc
    return out

@iter_try_rfold_digits_gt_two(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ugt value, 2
    br keep -> L_TRY_RFOLD_KEEP, L_TRY_RFOLD_STOP
L_TRY_RFOLD_KEEP:
    scaled = mul acc, 10
    next = add scaled, value
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep
L_TRY_RFOLD_STOP:
    !out_next
    !value
    !acc
    return keep

@iter_try_rfold_digits_all(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    scaled = mul acc, 10
    next = add scaled, value
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return 1

@test "sa_std iter reverse fold macro surface"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW empty_slice, values, 0

    EXPAND ITER_FROM_SLICE rfold_iter, slice
    EXPAND ITER_RFOLD_U64 rfold_value, rfold_iter, 0, @iter_rfold_digits
    EXPAND ITER_IS_EMPTY rfold_empty, rfold_iter

    EXPAND ITER_FROM_SLICE try_rfold_stop_iter, slice
    EXPAND ITER_TRY_RFOLD_U64 try_rfold_stop_ok, try_rfold_stop_value, try_rfold_stop_iter, 0, @iter_try_rfold_digits_gt_two
    EXPAND ITER_LEN try_rfold_stop_remaining, try_rfold_stop_iter
    EXPAND ITER_NEXT_BACK_U64 try_rfold_stop_back_ok, try_rfold_stop_back_value, try_rfold_stop_iter
    EXPAND ITER_IS_EMPTY try_rfold_stop_empty, try_rfold_stop_iter

    EXPAND ITER_FROM_SLICE try_rfold_all_iter, slice
    EXPAND ITER_TRY_RFOLD_U64 try_rfold_all_ok, try_rfold_all_value, try_rfold_all_iter, 0, @iter_try_rfold_digits_all
    EXPAND ITER_IS_EMPTY try_rfold_all_empty, try_rfold_all_iter

    EXPAND ITER_FROM_SLICE empty_rfold_iter, empty_slice
    EXPAND ITER_RFOLD_U64 empty_rfold_value, empty_rfold_iter, 7, @iter_rfold_digits
    EXPAND ITER_IS_EMPTY empty_rfold_empty, empty_rfold_iter

    EXPAND ITER_FROM_SLICE empty_try_rfold_iter, empty_slice
    EXPAND ITER_TRY_RFOLD_U64 empty_try_rfold_ok, empty_try_rfold_value, empty_try_rfold_iter, 9, @iter_try_rfold_digits_gt_two
    EXPAND ITER_IS_EMPTY empty_try_rfold_empty, empty_try_rfold_iter

    ok_rfold_value = eq rfold_value, 54321
    ok_rfold_empty = eq rfold_empty, 1
    ok_try_stop_flag = eq try_rfold_stop_ok, 0
    ok_try_stop_value = eq try_rfold_stop_value, 543
    ok_try_stop_remaining = eq try_rfold_stop_remaining, 1
    ok_try_stop_back_flag = eq try_rfold_stop_back_ok, 1
    ok_try_stop_back_value = eq try_rfold_stop_back_value, 1
    ok_try_stop_empty = eq try_rfold_stop_empty, 1
    ok_try_all_flag = eq try_rfold_all_ok, 1
    ok_try_all_value = eq try_rfold_all_value, 54321
    ok_try_all_empty = eq try_rfold_all_empty, 1
    ok_empty_rfold_value = eq empty_rfold_value, 7
    ok_empty_rfold_empty = eq empty_rfold_empty, 1
    ok_empty_try_flag = eq empty_try_rfold_ok, 1
    ok_empty_try_value = eq empty_try_rfold_value, 9
    ok_empty_try_empty = eq empty_try_rfold_empty, 1

    c01 = and ok_rfold_value, ok_rfold_empty
    c02 = and c01, ok_try_stop_flag
    c03 = and c02, ok_try_stop_value
    c04 = and c03, ok_try_stop_remaining
    c05 = and c04, ok_try_stop_back_flag
    c06 = and c05, ok_try_stop_back_value
    c07 = and c06, ok_try_stop_empty
    c08 = and c07, ok_try_all_flag
    c09 = and c08, ok_try_all_value
    c10 = and c09, ok_try_all_empty
    c11 = and c10, ok_empty_rfold_value
    c12 = and c11, ok_empty_rfold_empty
    c13 = and c12, ok_empty_try_flag
    c14 = and c13, ok_empty_try_value
    ok = and c14, ok_empty_try_empty

    !rfold_value
    !rfold_empty
    !try_rfold_stop_ok
    !try_rfold_stop_value
    !try_rfold_stop_remaining
    !try_rfold_stop_back_ok
    !try_rfold_stop_back_value
    !try_rfold_stop_empty
    !try_rfold_all_ok
    !try_rfold_all_value
    !try_rfold_all_empty
    !empty_rfold_value
    !empty_rfold_empty
    !empty_try_rfold_ok
    !empty_try_rfold_value
    !empty_try_rfold_empty
    !ok_rfold_value
    !ok_rfold_empty
    !ok_try_stop_flag
    !ok_try_stop_value
    !ok_try_stop_remaining
    !ok_try_stop_back_flag
    !ok_try_stop_back_value
    !ok_try_stop_empty
    !ok_try_all_flag
    !ok_try_all_value
    !ok_try_all_empty
    !ok_empty_rfold_value
    !ok_empty_rfold_empty
    !ok_empty_try_flag
    !ok_empty_try_value
    !ok_empty_try_empty
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !empty_try_rfold_iter
    !empty_rfold_iter
    !try_rfold_all_iter
    !try_rfold_stop_iter
    !rfold_iter
    !empty_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10534)

L_PASS:
    !ok
    return 0
