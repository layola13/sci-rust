@import "sa_std/array.sars"

@test "sa_std array comparison macro surface"():
L_ENTRY:
    low = stack_alloc 24
    same = stack_alloc 24
    high = stack_alloc 24
    store low+0, 1 as u64
    store low+8, 2 as u64
    store low+16, 9 as u64
    store same+0, 1 as u64
    store same+8, 2 as u64
    store same+16, 9 as u64
    store high+0, 1 as u64
    store high+8, 3 as u64
    store high+16, 0 as u64

    EXPAND ARRAY_CMP_U64 cmp_less, low, high, 3
    EXPAND ARRAY_CMP_U64 cmp_greater, high, low, 3
    EXPAND ARRAY_CMP_U64 cmp_equal, low, same, 3
    EXPAND ARRAY_PARTIAL_CMP_U64 partial_cmp_less, low, high, 3
    EXPAND ARRAY_LT_U64 lt_less, low, high, 3
    EXPAND ARRAY_LE_U64 le_less, low, high, 3
    EXPAND ARRAY_GT_U64 gt_less, low, high, 3
    EXPAND ARRAY_GE_U64 ge_equal, low, same, 3

    neg_one = sub 0, 1
    ok_cmp_less = eq cmp_less, neg_one
    ok_cmp_greater = eq cmp_greater, 1
    ok_cmp_equal = eq cmp_equal, 0
    ok_partial_less = eq partial_cmp_less, neg_one
    ok_lt_less = eq lt_less, 1
    ok_le_less = eq le_less, 1
    ok_gt_less = eq gt_less, 0
    ok_ge_equal = eq ge_equal, 1

    c01 = and ok_cmp_less, ok_cmp_greater
    c02 = and c01, ok_cmp_equal
    c03 = and c02, ok_partial_less
    c04 = and c03, ok_lt_less
    c05 = and c04, ok_le_less
    c06 = and c05, ok_gt_less
    ok = and c06, ok_ge_equal

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10525)

L_PASS:
    return 0
