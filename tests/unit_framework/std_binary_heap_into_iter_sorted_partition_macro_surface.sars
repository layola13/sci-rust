@import "sa_std/collections/binary_heap.sars"

@binary_heap_into_iter_sorted_partition_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    !value
    return out

@binary_heap_into_iter_sorted_partition_gt_zero(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 0
    !value
    return out

@test "sa_std binary_heap into_iter_sorted partition macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW partition_heap
    EXPAND BINARY_HEAP_PUSH_U64 partition_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 partition_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 partition_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 partition_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 partition_heap, 5
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 partition_iter, partition_backing, partition_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 partition_skip_has, partition_skip, partition_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_PARTITION_U64 true_vec, false_vec, partition_iter, @binary_heap_into_iter_sorted_partition_is_even
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 partition_empty, partition_iter
    EXPAND VEC_LEN true_len, true_vec
    EXPAND VEC_LEN false_len, false_vec
    EXPAND VEC_GET_U64 true_0, true_vec, 0
    EXPAND VEC_GET_U64 true_1, true_vec, 1
    EXPAND VEC_GET_U64 false_0, false_vec, 0
    EXPAND VEC_GET_U64 false_1, false_vec, 1

    EXPAND BINARY_HEAP_INTO_ITER_DEFAULT_U64 empty_partition_iter, empty_partition_backing
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_PARTITION_U64 empty_true_vec, empty_false_vec, empty_partition_iter, @binary_heap_into_iter_sorted_partition_is_even
    EXPAND VEC_LEN empty_true_len, empty_true_vec
    EXPAND VEC_LEN empty_false_len, empty_false_vec
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 empty_partition_empty, empty_partition_iter

    EXPAND BINARY_HEAP_NEW partitioned_heap
    EXPAND BINARY_HEAP_PUSH_U64 partitioned_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 partitioned_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 partitioned_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 partitioned_heap, 0
    EXPAND BINARY_HEAP_PUSH_U64 partitioned_heap, 0
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 partitioned_iter, partitioned_backing, partitioned_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_PARTITIONED_U64 partitioned_ok, partitioned_iter, @binary_heap_into_iter_sorted_partition_gt_zero
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 partitioned_empty, partitioned_iter

    EXPAND BINARY_HEAP_NEW not_partitioned_heap
    EXPAND BINARY_HEAP_PUSH_U64 not_partitioned_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 not_partitioned_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 not_partitioned_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 not_partitioned_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 not_partitioned_heap, 0
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 not_partitioned_iter, not_partitioned_backing, not_partitioned_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_IS_PARTITIONED_U64 not_partitioned_ok, not_partitioned_iter, @binary_heap_into_iter_sorted_partition_is_even
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 not_partitioned_remaining, not_partitioned_iter

    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 not_partitioned_next_has, not_partitioned_next, not_partitioned_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 not_partitioned_next2_has, not_partitioned_next2, not_partitioned_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_IS_EMPTY_U64 not_partitioned_empty, not_partitioned_iter

    EXPAND VEC_FREE partition_backing
    EXPAND VEC_FREE true_vec
    EXPAND VEC_FREE false_vec
    EXPAND VEC_FREE empty_partition_backing
    EXPAND VEC_FREE empty_true_vec
    EXPAND VEC_FREE empty_false_vec
    EXPAND VEC_FREE partitioned_backing
    EXPAND VEC_FREE not_partitioned_backing

    ok_partition_skip_has = eq partition_skip_has, 1
    ok_partition_skip = eq partition_skip, 5
    ok_partition_empty = eq partition_empty, 1
    ok_true_len = eq true_len, 2
    ok_false_len = eq false_len, 2
    ok_true_0 = eq true_0, 4
    ok_true_1 = eq true_1, 2
    ok_false_0 = eq false_0, 3
    ok_false_1 = eq false_1, 1
    ok_empty_true_len = eq empty_true_len, 0
    ok_empty_false_len = eq empty_false_len, 0
    ok_empty_partition_empty = eq empty_partition_empty, 1
    ok_partitioned = eq partitioned_ok, 1
    ok_partitioned_empty = eq partitioned_empty, 1
    ok_not_partitioned = eq not_partitioned_ok, 0
    ok_not_partitioned_remaining = eq not_partitioned_remaining, 2
    ok_not_partitioned_next_has = eq not_partitioned_next_has, 1
    ok_not_partitioned_next = eq not_partitioned_next, 1
    ok_not_partitioned_next2_has = eq not_partitioned_next2_has, 1
    ok_not_partitioned_next2 = eq not_partitioned_next2, 0
    ok_not_partitioned_empty = eq not_partitioned_empty, 1

    ok = and ok_partition_skip_has, ok_partition_skip
    ok = and ok, ok_partition_empty
    ok = and ok, ok_true_len
    ok = and ok, ok_false_len
    ok = and ok, ok_true_0
    ok = and ok, ok_true_1
    ok = and ok, ok_false_0
    ok = and ok, ok_false_1
    ok = and ok, ok_empty_true_len
    ok = and ok, ok_empty_false_len
    ok = and ok, ok_empty_partition_empty
    ok = and ok, ok_partitioned
    ok = and ok, ok_partitioned_empty
    ok = and ok, ok_not_partitioned
    ok = and ok, ok_not_partitioned_remaining
    ok = and ok, ok_not_partitioned_next_has
    ok = and ok, ok_not_partitioned_next
    ok = and ok, ok_not_partitioned_next2_has
    ok = and ok, ok_not_partitioned_next2
    ok = and ok, ok_not_partitioned_empty

    !partition_skip_has
    !partition_skip
    !partition_empty
    !true_len
    !false_len
    !true_0
    !true_1
    !false_0
    !false_1
    !empty_true_len
    !empty_false_len
    !empty_partition_empty
    !partitioned_ok
    !partitioned_empty
    !not_partitioned_ok
    !not_partitioned_remaining
    !not_partitioned_next_has
    !not_partitioned_next
    !not_partitioned_next2_has
    !not_partitioned_next2
    !not_partitioned_empty
    !ok_partition_skip_has
    !ok_partition_skip
    !ok_partition_empty
    !ok_true_len
    !ok_false_len
    !ok_true_0
    !ok_true_1
    !ok_false_0
    !ok_false_1
    !ok_empty_true_len
    !ok_empty_false_len
    !ok_empty_partition_empty
    !ok_partitioned
    !ok_partitioned_empty
    !ok_not_partitioned
    !ok_not_partitioned_remaining
    !ok_not_partitioned_next_has
    !ok_not_partitioned_next
    !ok_not_partitioned_next2_has
    !ok_not_partitioned_next2
    !ok_not_partitioned_empty
    !partition_iter
    !empty_partition_iter
    !partitioned_iter
    !not_partitioned_iter
    br ok -> L_BINARY_HEAP_INTO_ITER_SORTED_PARTITION_OK, L_BINARY_HEAP_INTO_ITER_SORTED_PARTITION_FAIL

L_BINARY_HEAP_INTO_ITER_SORTED_PARTITION_FAIL:
    !ok
    panic(10779)

L_BINARY_HEAP_INTO_ITER_SORTED_PARTITION_OK:
    !ok
    return
