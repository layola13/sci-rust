@import "sa_std/env.sars"
@import "sa_std/core/slice.sars"

@const PATH_KEY = utf8:"PATH"
@const MISSING_KEY = utf8:"__SA_STD_ENV_SHOULD_NOT_EXIST__"
#def PATH_KEY_LEN = 4
#def MISSING_KEY_LEN = 31

@test "sa_std env exists aliases"():
L_ENTRY:
    key = stack_alloc Slice_SIZE
    miss = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW key, &PATH_KEY, PATH_KEY_LEN
    EXPAND SLICE_NEW miss, &MISSING_KEY, MISSING_KEY_LEN
    EXPAND ENV_EXISTS has_path, key
    EXPAND ENV_EXISTS has_miss, miss
    a = eq has_path, 1
    b = eq has_miss, 0
    ok = and a, b
    !has_path
    !has_miss
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10913)
