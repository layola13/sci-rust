@import "sa_std/collections/binary_heap.sars"

@test "sa_std binary_heap into_iter_sorted state collect macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW enumerate_heap
    EXPAND BINARY_HEAP_PUSH_U64 enumerate_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 enumerate_heap, 6
    EXPAND BINARY_HEAP_PUSH_U64 enumerate_heap, 7
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 enumerate_iter, enumerate_backing, enumerate_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 enumerate_skip_has, enumerate_skip, enumerate_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_ENUMERATE_COLLECT_U64 enumerate_vec, enumerate_iter
    EXPAND VEC_GET_U64 enumerate_0, enumerate_vec, 0
    EXPAND VEC_GET_U64 enumerate_1, enumerate_vec, 1
    EXPAND VEC_GET_U64 enumerate_2, enumerate_vec, 2
    EXPAND VEC_GET_U64 enumerate_3, enumerate_vec, 3

    EXPAND BINARY_HEAP_NEW by_ref_heap
    EXPAND BINARY_HEAP_PUSH_U64 by_ref_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 by_ref_heap, 8
    EXPAND BINARY_HEAP_PUSH_U64 by_ref_heap, 13
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 by_ref_iter, by_ref_backing, by_ref_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 by_ref_first_has, by_ref_first, by_ref_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_BY_REF_COLLECT_U64 by_ref_vec, by_ref_iter
    EXPAND VEC_GET_U64 by_ref_0, by_ref_vec, 0
    EXPAND VEC_GET_U64 by_ref_1, by_ref_vec, 1

    EXPAND BINARY_HEAP_NEW fuse_heap
    EXPAND BINARY_HEAP_PUSH_U64 fuse_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 fuse_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 fuse_heap, 6
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 fuse_iter, fuse_backing, fuse_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 fuse_first_has, fuse_first, fuse_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_FUSE_COLLECT_U64 fuse_vec, fuse_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 fuse_after_has, fuse_after, fuse_iter

    EXPAND BINARY_HEAP_NEW peek_heap
    EXPAND BINARY_HEAP_PUSH_U64 peek_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 peek_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 peek_heap, 8
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 peek_iter, peek_backing, peek_heap
    EXPAND ITER_TRY_PEEK_U64 peek_before_has, peek_before, peek_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_PEEKABLE_COLLECT_U64 peek_vec, peek_iter
    EXPAND ITER_TRY_PEEK_U64 peek_after_has, peek_after, peek_iter
    EXPAND VEC_GET_U64 peek_0, peek_vec, 0
    EXPAND VEC_GET_U64 peek_1, peek_vec, 1

    EXPAND VEC_FREE enumerate_backing
    EXPAND VEC_FREE enumerate_vec
    EXPAND VEC_FREE by_ref_backing
    EXPAND VEC_FREE by_ref_vec
    EXPAND VEC_FREE fuse_backing
    EXPAND VEC_FREE fuse_vec
    EXPAND VEC_FREE peek_backing
    EXPAND VEC_FREE peek_vec

    ok = eq enumerate_skip_has, 1
    check = eq enumerate_skip, 7
    ok = and ok, check
    check = eq enumerate_0, 0
    ok = and ok, check
    check = eq enumerate_1, 6
    ok = and ok, check
    check = eq enumerate_2, 1
    ok = and ok, check
    check = eq enumerate_3, 5
    ok = and ok, check
    check = eq by_ref_first_has, 1
    ok = and ok, check
    check = eq by_ref_first, 13
    ok = and ok, check
    check = eq by_ref_0, 8
    ok = and ok, check
    check = eq by_ref_1, 5
    ok = and ok, check
    check = eq fuse_first_has, 1
    ok = and ok, check
    check = eq fuse_first, 6
    ok = and ok, check
    check = eq fuse_after_has, 0
    ok = and ok, check
    check = eq peek_before_has, 1
    ok = and ok, check
    check = eq peek_before, 8
    ok = and ok, check
    check = eq peek_after_has, 0
    ok = and ok, check
    check = eq peek_after, 0
    ok = and ok, check
    check = eq peek_0, 8
    ok = and ok, check
    check = eq peek_1, 5
    ok = and ok, check

    !enumerate_skip_has
    !enumerate_skip
    !enumerate_0
    !enumerate_1
    !enumerate_2
    !enumerate_3
    !by_ref_first_has
    !by_ref_first
    !by_ref_0
    !by_ref_1
    !fuse_first_has
    !fuse_first
    !fuse_after_has
    !fuse_after
    !peek_before_has
    !peek_before
    !peek_after_has
    !peek_after
    !peek_0
    !peek_1
    !check
    !enumerate_iter
    !by_ref_iter
    !fuse_iter
    !peek_iter
    br ok -> L_SORTED_STATE_OK, L_SORTED_STATE_FAIL
L_SORTED_STATE_FAIL:
    !ok
    panic(10782)
L_SORTED_STATE_OK:
    !ok
    return
