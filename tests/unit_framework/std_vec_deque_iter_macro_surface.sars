@import "sa_std/vec_deque.sars"

@test "sa_std vec_deque borrowed and consuming iterator macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT popped_ok, popped, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50

    EXPAND VEC_DEQUE_ITER_U64 iter, iter_backing, deque
    EXPAND VEC_DEQUE_ITER_SIZE_HINT_U64 iter_lower, iter_upper, iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 iter_front_has, iter_front, iter
    EXPAND VEC_DEQUE_ITER_NEXT_BACK_U64 iter_back_has, iter_back, iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 iter_remaining, iter
    EXPAND VEC_DEQUE_ITER_COLLECT_U64 iter_tail, iter
    EXPAND VEC_GET_U64 iter_tail_0, iter_tail, 0
    EXPAND VEC_GET_U64 iter_tail_1, iter_tail, 1
    EXPAND VEC_DEQUE_LEN len_after_borrow, deque

    EXPAND VEC_DEQUE_REF_INTO_ITER_U64 ref_iter, ref_backing, deque
    EXPAND VEC_DEQUE_ITER_NEXT_U64 ref_front_has, ref_front, ref_iter

    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, deque
    EXPAND VEC_DEQUE_INTO_ITER_SIZE_HINT_U64 into_lower, into_upper, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_front_has, into_front, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_BACK_U64 into_back_has, into_back, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_LEN_U64 into_remaining, into_iter
    EXPAND VEC_DEQUE_INTO_ITER_COLLECT_U64 into_tail, into_iter
    EXPAND VEC_GET_U64 into_tail_0, into_tail, 0
    EXPAND VEC_GET_U64 into_tail_1, into_tail, 1
    EXPAND VEC_DEQUE_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 into_empty, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY deque_empty, deque

    EXPAND VEC_FREE iter_backing
    EXPAND VEC_FREE iter_tail
    EXPAND VEC_FREE ref_backing
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_tail
    EXPAND VEC_DEQUE_FREE deque

    ok = eq popped_ok, 1
    check = eq popped, 10
    ok = and ok, check
    check = eq iter_lower, 4
    ok = and ok, check
    check = eq iter_upper, 4
    ok = and ok, check
    check = eq iter_front_has, 1
    ok = and ok, check
    check = eq iter_front, 20
    ok = and ok, check
    check = eq iter_back_has, 1
    ok = and ok, check
    check = eq iter_back, 50
    ok = and ok, check
    check = eq iter_remaining, 2
    ok = and ok, check
    check = eq iter_tail_0, 30
    ok = and ok, check
    check = eq iter_tail_1, 40
    ok = and ok, check
    check = eq len_after_borrow, 4
    ok = and ok, check
    check = eq ref_front_has, 1
    ok = and ok, check
    check = eq ref_front, 20
    ok = and ok, check
    check = eq into_lower, 4
    ok = and ok, check
    check = eq into_upper, 4
    ok = and ok, check
    check = eq into_front_has, 1
    ok = and ok, check
    check = eq into_front, 20
    ok = and ok, check
    check = eq into_back_has, 1
    ok = and ok, check
    check = eq into_back, 50
    ok = and ok, check
    check = eq into_remaining, 2
    ok = and ok, check
    check = eq into_tail_0, 30
    ok = and ok, check
    check = eq into_tail_1, 40
    ok = and ok, check
    check = eq into_empty, 1
    ok = and ok, check
    check = eq deque_empty, 1
    ok = and ok, check

    !popped_ok
    !popped
    !iter_lower
    !iter_upper
    !iter_front_has
    !iter_front
    !iter_back_has
    !iter_back
    !iter_remaining
    !iter_tail_0
    !iter_tail_1
    !len_after_borrow
    !ref_front_has
    !ref_front
    !into_lower
    !into_upper
    !into_front_has
    !into_front
    !into_back_has
    !into_back
    !into_remaining
    !into_tail_0
    !into_tail_1
    !into_empty
    !deque_empty
    !check
    !iter
    !ref_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_OK, L_VEC_DEQUE_ITER_FAIL
L_VEC_DEQUE_ITER_FAIL:
    !ok
    panic(10787)
L_VEC_DEQUE_ITER_OK:
    !ok
    return
