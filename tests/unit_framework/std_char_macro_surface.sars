    ok09 = and ok08, ok_ascii_b0
    ok10 = and ok09, ok_ascii_b1
    ok11 = and ok10, ok_ascii_b2
    ok12 = and ok11, ok_ascii_b3
    ok13 = and ok12, ok_ascii_b4
