    ok17 = and ok16, ok_three_b3
    ok18 = and ok17, ok_three_b4
    ok19 = and ok18, ok_three_b5
    ok20 = and ok19, ok_three_b6
    ok21 = and ok20, ok_bmp_flag
    ok22 = and ok21, ok_bmp_len
    ok23 = and ok22, ok_bmp_b3
    ok24 = and ok23, ok_bmp_b4
    ok25 = and ok24, ok_bmp_b5
    ok26 = and ok25, ok_bmp_b6
    ok27 = and ok26, ok_bmp_b7
    ok28 = and ok27, ok_supp_flag
    ok29 = and ok28, ok_supp_len
    ok30 = and ok29, ok_supp_b3
    ok31 = and ok30, ok_supp_b4
    ok32 = and ok31, ok_supp_b5
    ok33 = and ok32, ok_supp_b6
    ok34 = and ok33, ok_supp_b7
    ok35 = and ok34, ok_supp_b8
    ok36 = and ok35, ok_max_flag
    ok37 = and ok36, ok_max_len
    ok38 = and ok37, ok_max_b3
    ok39 = and ok38, ok_max_b4
    ok40 = and ok39, ok_max_b5
    ok41 = and ok40, ok_max_b6
    ok42 = and ok41, ok_max_b7
    ok43 = and ok42, ok_max_b8
