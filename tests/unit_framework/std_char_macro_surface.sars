@test "sa_std char escape_default write macro"():
L_ENTRY:
    out = stack_alloc 16

    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_raw_ok, def_raw_len, out, 16, 65
    raw_b0 = load out+0 as u8

    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_lf_ok, def_lf_len, out, 16, 10
    lf_b0 = load out+0 as u8
    lf_b1 = load out+1 as u8

    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_quote_ok, def_quote_len, out, 16, 34
    quote_b0 = load out+0 as u8
    quote_b1 = load out+1 as u8

    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_backslash_ok, def_backslash_len, out, 16, 92
    backslash_b0 = load out+0 as u8
    backslash_b1 = load out+1 as u8

    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_zero_ok, def_zero_len, out, 16, 0
    zero_b0 = load out+0 as u8
    zero_b1 = load out+1 as u8
    zero_b2 = load out+2 as u8
    zero_b3 = load out+3 as u8
    zero_b4 = load out+4 as u8

    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_unicode_ok, def_unicode_len, out, 16, 10084
    unicode_b0 = load out+0 as u8
    unicode_b1 = load out+1 as u8
    unicode_b2 = load out+2 as u8
    unicode_b3 = load out+3 as u8
    unicode_b4 = load out+4 as u8
    unicode_b5 = load out+5 as u8
    unicode_b6 = load out+6 as u8
    unicode_b7 = load out+7 as u8

    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_short_ok, def_short_len, out, 1, 10
    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_short_unicode_ok, def_short_unicode_len, out, 7, 10084
    EXPAND CHAR_ESCAPE_DEFAULT_WRITE def_bad_ok, def_bad_len, out, 16, CHAR_SURROGATE_MIN

    ok_raw_flag = eq def_raw_ok, 1
    ok_raw_len = eq def_raw_len, 1
    ok_raw_b0 = eq raw_b0, 65
    ok_lf_flag = eq def_lf_ok, 1
    ok_lf_len = eq def_lf_len, 2
    ok_lf_b0 = eq lf_b0, 92
    ok_lf_b1 = eq lf_b1, 110
    ok_quote_flag = eq def_quote_ok, 1
    ok_quote_len = eq def_quote_len, 2
    ok_quote_b0 = eq quote_b0, 92
    ok_quote_b1 = eq quote_b1, 34
    ok_backslash_flag = eq def_backslash_ok, 1
    ok_backslash_len = eq def_backslash_len, 2
    ok_backslash_b0 = eq backslash_b0, 92
    ok_backslash_b1 = eq backslash_b1, 92
    ok_zero_flag = eq def_zero_ok, 1
    ok_zero_len = eq def_zero_len, 5
    ok_zero_b0 = eq zero_b0, 92
    ok_zero_b1 = eq zero_b1, 117
    ok_zero_b2 = eq zero_b2, 123
    ok_zero_b3 = eq zero_b3, 48
    ok_zero_b4 = eq zero_b4, 125
    ok_unicode_flag = eq def_unicode_ok, 1
    ok_unicode_len = eq def_unicode_len, 8
    ok_unicode_b0 = eq unicode_b0, 92
    ok_unicode_b1 = eq unicode_b1, 117
    ok_unicode_b2 = eq unicode_b2, 123
    ok_unicode_b3 = eq unicode_b3, 50
    ok_unicode_b4 = eq unicode_b4, 55
    ok_unicode_b5 = eq unicode_b5, 54
    ok_unicode_b6 = eq unicode_b6, 52
    ok_unicode_b7 = eq unicode_b7, 125
    ok_short_flag = eq def_short_ok, 0
    ok_short_len = eq def_short_len, 0
    ok_short_unicode_flag = eq def_short_unicode_ok, 0
    ok_short_unicode_len = eq def_short_unicode_len, 0
    ok_bad_flag = eq def_bad_ok, 0
    ok_bad_len = eq def_bad_len, 0

    ok01 = and ok_raw_flag, ok_raw_len
    ok02 = and ok01, ok_raw_b0
    ok03 = and ok02, ok_lf_flag
    ok04 = and ok03, ok_lf_len
    ok05 = and ok04, ok_lf_b0
    ok06 = and ok05, ok_lf_b1
    ok07 = and ok06, ok_quote_flag
    ok08 = and ok07, ok_quote_len
    ok09 = and ok08, ok_quote_b0
    ok10 = and ok09, ok_quote_b1
    ok11 = and ok10, ok_backslash_flag
    ok12 = and ok11, ok_backslash_len
    ok13 = and ok12, ok_backslash_b0
    ok14 = and ok13, ok_backslash_b1
    ok15 = and ok14, ok_zero_flag
    ok16 = and ok15, ok_zero_len
    ok17 = and ok16, ok_zero_b0
    ok18 = and ok17, ok_zero_b1
    ok19 = and ok18, ok_zero_b2
    ok20 = and ok19, ok_zero_b3
    ok21 = and ok20, ok_zero_b4
    ok22 = and ok21, ok_unicode_flag
    ok23 = and ok22, ok_unicode_len
    ok24 = and ok23, ok_unicode_b0
    ok25 = and ok24, ok_unicode_b1
    ok26 = and ok25, ok_unicode_b2
    ok27 = and ok26, ok_unicode_b3
    ok28 = and ok27, ok_unicode_b4
    ok29 = and ok28, ok_unicode_b5
    ok30 = and ok29, ok_unicode_b6
    ok31 = and ok30, ok_unicode_b7
    ok32 = and ok31, ok_short_flag
    ok33 = and ok32, ok_short_len
    ok34 = and ok33, ok_short_unicode_flag
    ok35 = and ok34, ok_short_unicode_len
    ok36 = and ok35, ok_bad_flag
    ok = and ok36, ok_bad_len

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(973)

L_PASS:
    return 0

@test "sa_std char escape_debug write macro"():
L_ENTRY:
    out = stack_alloc 16

    EXPAND CHAR_ESCAPE_DEBUG_WRITE dbg_raw_ok, dbg_raw_len, out, 16, 65
    raw_b0 = load out+0 as u8

    EXPAND CHAR_ESCAPE_DEBUG_WRITE dbg_lf_ok, dbg_lf_len, out, 16, 10
    lf_b0 = load out+0 as u8
    lf_b1 = load out+1 as u8

    EXPAND CHAR_ESCAPE_DEBUG_WRITE dbg_quote_ok, dbg_quote_len, out, 16, 34
    quote_b0 = load out+0 as u8
    quote_b1 = load out+1 as u8

    EXPAND CHAR_ESCAPE_DEBUG_WRITE dbg_zero_ok, dbg_zero_len, out, 16, 0
    zero_b0 = load out+0 as u8
    zero_b1 = load out+1 as u8
    zero_b2 = load out+2 as u8
    zero_b3 = load out+3 as u8
    zero_b4 = load out+4 as u8

    EXPAND CHAR_ESCAPE_DEBUG_WRITE dbg_heart_ok, dbg_heart_len, out, 16, 10084
    heart_b0 = load out+0 as u8
    heart_b1 = load out+1 as u8
    heart_b2 = load out+2 as u8

    EXPAND CHAR_ESCAPE_DEBUG_WRITE dbg_short_ok, dbg_short_len, out, 1, 10
    EXPAND CHAR_ESCAPE_DEBUG_WRITE dbg_bad_ok, dbg_bad_len, out, 16, CHAR_SURROGATE_MIN

    ok_raw_flag = eq dbg_raw_ok, 1
    ok_raw_len = eq dbg_raw_len, 1
    ok_raw_b0 = eq raw_b0, 65
    ok_lf_flag = eq dbg_lf_ok, 1
    ok_lf_len = eq dbg_lf_len, 2
    ok_lf_b0 = eq lf_b0, 92
    ok_lf_b1 = eq lf_b1, 110
    ok_quote_flag = eq dbg_quote_ok, 1
    ok_quote_len = eq dbg_quote_len, 2
    ok_quote_b0 = eq quote_b0, 92
    ok_quote_b1 = eq quote_b1, 34
    ok_zero_flag = eq dbg_zero_ok, 1
    ok_zero_len = eq dbg_zero_len, 5
    ok_zero_b0 = eq zero_b0, 92
    ok_zero_b1 = eq zero_b1, 117
    ok_zero_b2 = eq zero_b2, 123
    ok_zero_b3 = eq zero_b3, 48
    ok_zero_b4 = eq zero_b4, 125
    ok_heart_flag = eq dbg_heart_ok, 1
    ok_heart_len = eq dbg_heart_len, 3
    ok_heart_b0 = eq heart_b0, 226
    ok_heart_b1 = eq heart_b1, 157
    ok_heart_b2 = eq heart_b2, 164
    ok_short_flag = eq dbg_short_ok, 0
    ok_short_len = eq dbg_short_len, 0
    ok_bad_flag = eq dbg_bad_ok, 0
    ok_bad_len = eq dbg_bad_len, 0

    ok01 = and ok_raw_flag, ok_raw_len
    ok02 = and ok01, ok_raw_b0
    ok03 = and ok02, ok_lf_flag
    ok04 = and ok03, ok_lf_len
    ok05 = and ok04, ok_lf_b0
    ok06 = and ok05, ok_lf_b1
    ok07 = and ok06, ok_quote_flag
    ok08 = and ok07, ok_quote_len
    ok09 = and ok08, ok_quote_b0
    ok10 = and ok09, ok_quote_b1
    ok11 = and ok10, ok_zero_flag
    ok12 = and ok11, ok_zero_len
    ok13 = and ok12, ok_zero_b0
    ok14 = and ok13, ok_zero_b1
    ok15 = and ok14, ok_zero_b2
    ok16 = and ok15, ok_zero_b3
    ok17 = and ok16, ok_zero_b4
    ok18 = and ok17, ok_heart_flag
    ok19 = and ok18, ok_heart_len
    ok20 = and ok19, ok_heart_b0
    ok21 = and ok20, ok_heart_b1
    ok22 = and ok21, ok_heart_b2
    ok23 = and ok22, ok_short_flag
    ok24 = and ok23, ok_short_len
    ok25 = and ok24, ok_bad_flag
    ok = and ok25, ok_bad_len

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(974)

L_PASS:
    return 0

@test "sa_std char ascii and radix macros"():
L_ENTRY:
    EXPAND CHAR_IS_ASCII ascii_a, 65
    EXPAND CHAR_IS_ASCII ascii_high, 128
    EXPAND CHAR_IS_ASCII_ALPHABETIC alpha_a, 65
    EXPAND CHAR_IS_ASCII_ALPHANUMERIC alnum_9, 57
    EXPAND CHAR_IS_ASCII_DIGIT digit_9, 57
    EXPAND CHAR_IS_ASCII_HEXDIGIT hex_f, 102
    EXPAND CHAR_IS_ASCII_WHITESPACE ws_space, 32
    EXPAND CHAR_TO_ASCII_UPPERCASE upper_a, 97
    EXPAND CHAR_TO_ASCII_LOWERCASE lower_z, 90
    EXPAND CHAR_EQ_IGNORE_ASCII_CASE eq_ascii, 82, 114

    EXPAND CHAR_TO_DIGIT digit_ok, digit_value, 49, 10
    EXPAND CHAR_TO_DIGIT hex_ok, hex_value, 102, 16
    EXPAND CHAR_TO_DIGIT hex_upper_ok, hex_upper_value, 70, 16
    EXPAND CHAR_TO_DIGIT z_hex_ok, z_hex_value, 122, 16
    EXPAND CHAR_TO_DIGIT nine_oct_ok, nine_oct_value, 57, 8
    EXPAND CHAR_TO_DIGIT invalid_radix_ok, invalid_radix_value, 49, 1
    EXPAND CHAR_IS_DIGIT is_digit_hex, 102, 16
    EXPAND CHAR_IS_DIGIT is_digit_dec, 102, 10
    EXPAND CHAR_FROM_DIGIT from_digit_ok, from_digit_char, 15, 16
    EXPAND CHAR_FROM_DIGIT from_digit_dec_ok, from_digit_dec_char, 9, 10
    EXPAND CHAR_FROM_DIGIT from_digit_bad_ok, from_digit_bad_char, 10, 10

    ok_ascii_a = eq ascii_a, 1
    ok_ascii_high = eq ascii_high, 0
    ok_alpha_a = eq alpha_a, 1
    ok_alnum_9 = eq alnum_9, 1
    ok_digit_9 = eq digit_9, 1
    ok_hex_f = eq hex_f, 1
    ok_ws_space = eq ws_space, 1
    ok_upper_a = eq upper_a, 65
    ok_lower_z = eq lower_z, 122
    ok_eq_ascii = eq eq_ascii, 1
    ok_digit_flag = eq digit_ok, 1
    ok_digit_value = eq digit_value, 1
    ok_hex_flag = eq hex_ok, 1
    ok_hex_value = eq hex_value, 15
    ok_hex_upper_flag = eq hex_upper_ok, 1
    ok_hex_upper_value = eq hex_upper_value, 15
    ok_z_hex_flag = eq z_hex_ok, 0
    ok_z_hex_value = eq z_hex_value, 0
    ok_nine_oct_flag = eq nine_oct_ok, 0
    ok_nine_oct_value = eq nine_oct_value, 0
    ok_invalid_radix_flag = eq invalid_radix_ok, 0
    ok_invalid_radix_value = eq invalid_radix_value, 0
    ok_is_digit_hex = eq is_digit_hex, 1
    ok_is_digit_dec = eq is_digit_dec, 0
    ok_from_digit_flag = eq from_digit_ok, 1
    ok_from_digit_char = eq from_digit_char, 102
    ok_from_digit_dec_flag = eq from_digit_dec_ok, 1
    ok_from_digit_dec_char = eq from_digit_dec_char, 57
    ok_from_digit_bad_flag = eq from_digit_bad_ok, 0
    ok_from_digit_bad_char = eq from_digit_bad_char, 0

    ok01 = and ok_ascii_a, ok_ascii_high
    ok02 = and ok01, ok_alpha_a
    ok03 = and ok02, ok_alnum_9
    ok04 = and ok03, ok_digit_9
    ok05 = and ok04, ok_hex_f
    ok06 = and ok05, ok_ws_space
    ok07 = and ok06, ok_upper_a
    ok08 = and ok07, ok_lower_z
    ok09 = and ok08, ok_eq_ascii
    ok10 = and ok09, ok_digit_flag
    ok11 = and ok10, ok_digit_value
    ok12 = and ok11, ok_hex_flag
    ok13 = and ok12, ok_hex_value
    ok14 = and ok13, ok_hex_upper_flag
    ok15 = and ok14, ok_hex_upper_value
    ok16 = and ok15, ok_z_hex_flag
    ok17 = and ok16, ok_z_hex_value
    ok18 = and ok17, ok_nine_oct_flag
    ok19 = and ok18, ok_nine_oct_value
    ok20 = and ok19, ok_invalid_radix_flag
    ok21 = and ok20, ok_invalid_radix_value
    ok22 = and ok21, ok_is_digit_hex
    ok23 = and ok22, ok_is_digit_dec
    ok24 = and ok23, ok_from_digit_flag
    ok25 = and ok24, ok_from_digit_char
    ok26 = and ok25, ok_from_digit_dec_flag
    ok27 = and ok26, ok_from_digit_dec_char
    ok28 = and ok27, ok_from_digit_bad_flag
    ok = and ok28, ok_from_digit_bad_char

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(971)

L_PASS:
    return 0
