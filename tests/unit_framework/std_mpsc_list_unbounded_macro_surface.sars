@import "sa_std/sync/mpsc_list.sars"

@test "sa_std mpsc_list unbounded send recv"():
L_ENTRY:
    EXPAND MPSC_LIST_NEW chan
    EXPAND MPSC_LIST_SEND chan, 11
    EXPAND MPSC_LIST_SEND chan, 22
    EXPAND MPSC_LIST_TRY_RECV r0_ok, r0, chan
    EXPAND MPSC_LIST_TRY_RECV r1_ok, r1, chan
    EXPAND MPSC_LIST_TRY_RECV r2_ok, r2, chan
    EXPAND MPSC_LIST_FREE chan
    a = eq r0_ok, 1
    b = eq r0, 11
    c = eq r1_ok, 1
    d = eq r1, 22
    e = eq r2_ok, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok = and ok03, e
    !r0_ok
    !r0
    !r1_ok
    !r1
    !r2_ok
    !r2
    !a
    !b
    !c
    !d
    !e
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10903)

@test "sa_std mpsc_list timeout aliases"():
L_ENTRY:
    EXPAND MPSC_LIST_NEW chan
    EXPAND MPSC_LIST_TRY_RECV_TIMEOUT_MS empty_ok, empty_value, chan, 0
    EXPAND MPSC_LIST_SEND chan, 33
    EXPAND MPSC_LIST_TRY_RECV_TIMEOUT_NS recv_ok, recv_value, chan, 1000000
    EXPAND MPSC_LIST_FREE chan
    ok0 = eq empty_ok, 0
    ok1 = eq empty_value, 0
    ok2 = eq recv_ok, 1
    ok3 = eq recv_value, 33
    all0 = and ok0, ok1
    all1 = and all0, ok2
    ok = and all1, ok3
    !empty_ok
    !empty_value
    !recv_ok
    !recv_value
    !ok0
    !ok1
    !ok2
    !ok3
    !all0
    !all1
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10997)

@test "sa_std mpsc_list drop closes channel"():
L_ENTRY:
    EXPAND MPSC_LIST_NEW chan
    EXPAND MPSC_LIST_SEND chan, 44
    EXPAND MPSC_LIST_DROP chan
    EXPAND MPSC_LIST_IS_DISCONNECTED disconnected, chan
    EXPAND MPSC_LIST_SEND chan, 55
    EXPAND MPSC_LIST_TRY_RECV recv_ok, recv_value, chan
    EXPAND MPSC_LIST_TRY_RECV_TIMEOUT_NS timeout_ok, timeout_value, chan, 0
    EXPAND MPSC_LIST_LEN len, chan
    EXPAND MPSC_LIST_IS_EMPTY empty, chan
    disconnected_ok = eq disconnected, 1
    send_ok = eq recv_ok, 0
    recv_zero = eq recv_value, 0
    timeout_zero = eq timeout_value, 0
    len_zero = eq len, 0
    empty_ok = eq empty, 1
    ok0 = and disconnected_ok, send_ok
    ok1 = and ok0, recv_zero
    ok2 = and ok1, timeout_zero
    ok3 = and ok2, len_zero
    ok = and ok3, empty_ok
    !disconnected
    !recv_ok
    !recv_value
    !timeout_ok
    !timeout_value
    !len
    !empty
    !disconnected_ok
    !send_ok
    !recv_zero
    !timeout_zero
    !len_zero
    !empty_ok
    !ok0
    !ok1
    !ok2
    !ok3
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10998)
@test "sa_std mpsc_list repeated drop"():
L_ENTRY:
    EXPAND MPSC_LIST_NEW chan
    EXPAND MPSC_LIST_DROP chan
    EXPAND MPSC_LIST_DROP chan
    EXPAND MPSC_LIST_IS_DISCONNECTED closed, chan
    EXPAND MPSC_LIST_SEND chan, 9
    EXPAND MPSC_LIST_TRY_RECV recv_ok, recv_value, chan
    closed_ok = eq closed, 1
    recv_zero_ok = eq recv_ok, 0
    value_zero_ok = eq recv_value, 0
    ok0 = and closed_ok, recv_zero_ok
    ok = and ok0, value_zero_ok
    !closed
    !recv_ok
    !recv_value
    !closed_ok
    !recv_zero_ok
    !value_zero_ok
    !ok0
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(11000)
