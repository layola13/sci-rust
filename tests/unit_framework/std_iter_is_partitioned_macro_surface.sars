@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"

@iter_partition_gt_zero(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 0
    !value
    return out

@test "sa_std iter is_partitioned macro surface"():
L_ENTRY:
    partitioned_data = stack_alloc 40
    not_partitioned_data = stack_alloc 40
    all_true_data = stack_alloc 24
    empty_data = stack_alloc 8

    store partitioned_data+0, 3 as u64
    store partitioned_data+8, 2 as u64
    store partitioned_data+16, 1 as u64
    store partitioned_data+24, 0 as u64
    store partitioned_data+32, 0 as u64
    store not_partitioned_data+0, 3 as u64
    store not_partitioned_data+8, 0 as u64
    store not_partitioned_data+16, 2 as u64
    store not_partitioned_data+24, 0 as u64
    store not_partitioned_data+32, 0 as u64
    store all_true_data+0, 7 as u64
    store all_true_data+8, 6 as u64
    store all_true_data+16, 5 as u64

    partitioned_slice = alloc Slice_SIZE
    not_partitioned_slice = alloc Slice_SIZE
    all_true_slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW partitioned_slice, partitioned_data, 5
    EXPAND SLICE_NEW not_partitioned_slice, not_partitioned_data, 5
    EXPAND SLICE_NEW all_true_slice, all_true_data, 3
    EXPAND SLICE_NEW empty_slice, empty_data, 0

    EXPAND ITER_FROM_SLICE partitioned_iter, partitioned_slice
    EXPAND ITER_IS_PARTITIONED_U64 partitioned_ok, partitioned_iter, @iter_partition_gt_zero
    EXPAND ITER_IS_EMPTY partitioned_empty, partitioned_iter

    EXPAND ITER_FROM_SLICE not_partitioned_iter, not_partitioned_slice
    EXPAND ITER_IS_PARTITIONED_U64 not_partitioned_ok, not_partitioned_iter, @iter_partition_gt_zero
    EXPAND ITER_LEN not_partitioned_remaining, not_partitioned_iter
    EXPAND ITER_NEXT_U64 not_partitioned_next_ok, not_partitioned_next_value, not_partitioned_iter
    EXPAND ITER_NEXT_U64 not_partitioned_next2_ok, not_partitioned_next2_value, not_partitioned_iter
    EXPAND ITER_IS_EMPTY not_partitioned_empty, not_partitioned_iter

    EXPAND ITER_FROM_SLICE all_true_iter, all_true_slice
    EXPAND ITER_IS_PARTITIONED_U64 all_true_ok, all_true_iter, @iter_partition_gt_zero
    EXPAND ITER_IS_EMPTY all_true_empty, all_true_iter

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_IS_PARTITIONED_U64 empty_ok, empty_iter, @iter_partition_gt_zero
    EXPAND ITER_IS_EMPTY empty_empty, empty_iter

    ok_partitioned = eq partitioned_ok, 1
    ok_partitioned_empty = eq partitioned_empty, 1
    ok_not_partitioned = eq not_partitioned_ok, 0
    ok_not_partitioned_remaining = eq not_partitioned_remaining, 2
    ok_not_partitioned_next_flag = eq not_partitioned_next_ok, 1
    ok_not_partitioned_next_value = eq not_partitioned_next_value, 0
    ok_not_partitioned_next2_flag = eq not_partitioned_next2_ok, 1
    ok_not_partitioned_next2_value = eq not_partitioned_next2_value, 0
    ok_not_partitioned_empty = eq not_partitioned_empty, 1
    ok_all_true = eq all_true_ok, 1
    ok_all_true_empty = eq all_true_empty, 1
    ok_empty = eq empty_ok, 1
    ok_empty_empty = eq empty_empty, 1

    c01 = and ok_partitioned, ok_partitioned_empty
    c02 = and c01, ok_not_partitioned
    c03 = and c02, ok_not_partitioned_remaining
    c04 = and c03, ok_not_partitioned_next_flag
    c05 = and c04, ok_not_partitioned_next_value
    c06 = and c05, ok_not_partitioned_next2_flag
    c07 = and c06, ok_not_partitioned_next2_value
    c08 = and c07, ok_not_partitioned_empty
    c09 = and c08, ok_all_true
    c10 = and c09, ok_all_true_empty
    c11 = and c10, ok_empty
    ok = and c11, ok_empty_empty

    !partitioned_ok
    !partitioned_empty
    !not_partitioned_ok
    !not_partitioned_remaining
    !not_partitioned_next_ok
    !not_partitioned_next_value
    !not_partitioned_next2_ok
    !not_partitioned_next2_value
    !not_partitioned_empty
    !all_true_ok
    !all_true_empty
    !empty_ok
    !empty_empty
    !ok_partitioned
    !ok_partitioned_empty
    !ok_not_partitioned
    !ok_not_partitioned_remaining
    !ok_not_partitioned_next_flag
    !ok_not_partitioned_next_value
    !ok_not_partitioned_next2_flag
    !ok_not_partitioned_next2_value
    !ok_not_partitioned_empty
    !ok_all_true
    !ok_all_true_empty
    !ok_empty
    !ok_empty_empty
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !empty_iter
    !all_true_iter
    !not_partitioned_iter
    !partitioned_iter
    !empty_slice
    !all_true_slice
    !not_partitioned_slice
    !partitioned_slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10535)

L_PASS:
    !ok
    return 0
