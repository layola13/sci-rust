@import "sa_std/vec_deque.sars"

@test "sa_std vec_deque iter_mut macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop_ok, popped, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50

    EXPAND VEC_DEQUE_ITER_MUT_U64 iter_mut, iter_mut_backing_slice, deque
    EXPAND VEC_DEQUE_ITER_MUT_SIZE_HINT_U64 hint_lower_initial, hint_upper_initial, iter_mut
    EXPAND VEC_DEQUE_ITER_MUT_EXACT_SIZE_LEN_U64 exact_len_initial, iter_mut
    EXPAND VEC_DEQUE_ITER_MUT_EXACT_SIZE_IS_EMPTY_U64 empty_initial, iter_mut
    ref_slice = stack_alloc Slice_SIZE
    EXPAND VEC_DEQUE_ITER_MUT_AS_REF_SLICE_U64 ref_slice, iter_mut
    EXPAND SLICE_GET_LEN ref_slice_len, ref_slice
    EXPAND SLICE_GET_U64 ref_slice_first, ref_slice, 0
    EXPAND VEC_DEQUE_ITER_MUT_NEXT_U64 first_has, first, iter_mut
    mut_slice = stack_alloc Slice_SIZE
    EXPAND VEC_DEQUE_ITER_MUT_AS_MUT_SLICE_U64 mut_slice, iter_mut
    EXPAND SLICE_GET_LEN mut_slice_len, mut_slice
    EXPAND SLICE_GET_MUT_PTR_U64 mut_second_ptr, mut_slice, 0
    store mut_second_ptr+0, 35 as u64
    EXPAND VEC_DEQUE_ITER_MUT_SIZE_HINT_U64 hint_lower_after_first, hint_upper_after_first, iter_mut
    EXPAND VEC_DEQUE_ITER_MUT_NEXT_U64 second_has, second, iter_mut
    EXPAND VEC_DEQUE_ITER_MUT_NEXT_BACK_U64 back_has, back, iter_mut
    EXPAND VEC_DEQUE_ITER_MUT_NEXT_U64 middle_has, middle, iter_mut
    EXPAND VEC_DEQUE_ITER_MUT_EXACT_SIZE_IS_EMPTY_U64 empty_done, iter_mut
    EXPAND VEC_DEQUE_ITER_MUT_NEXT_U64 done_has, done, iter_mut

    EXPAND VEC_DEQUE_MUT_REF_INTO_ITER_U64 mut_ref_iter, mut_ref_backing_slice, deque
    EXPAND VEC_DEQUE_ITER_MUT_NEXT_BACK_U64 mut_ref_back_has, mut_ref_back, mut_ref_iter
    EXPAND VEC_DEQUE_ITER_MUT_EXACT_SIZE_LEN_U64 mut_ref_len_after_back, mut_ref_iter

    EXPAND VEC_DEQUE_LEN deque_len_after_iters, deque
    EXPAND VEC_DEQUE_GET_U64 deque_second_after_mut_slice, deque, 1

    ok = eq pop_ok, 1
    check = eq popped, 10
    ok = and ok, check
    check = eq hint_lower_initial, 4
    ok = and ok, check
    check = eq hint_upper_initial, 4
    ok = and ok, check
    check = eq exact_len_initial, 4
    ok = and ok, check
    check = eq empty_initial, 0
    ok = and ok, check
    check = eq ref_slice_len, 4
    ok = and ok, check
    check = eq ref_slice_first, 20
    ok = and ok, check
    check = eq first_has, 1
    ok = and ok, check
    check = eq first, 20
    ok = and ok, check
    check = eq mut_slice_len, 3
    ok = and ok, check
    check = eq hint_lower_after_first, 3
    ok = and ok, check
    check = eq hint_upper_after_first, 3
    ok = and ok, check
    check = eq second_has, 1
    ok = and ok, check
    check = eq second, 35
    ok = and ok, check
    check = eq back_has, 1
    ok = and ok, check
    check = eq back, 50
    ok = and ok, check
    check = eq middle_has, 1
    ok = and ok, check
    check = eq middle, 40
    ok = and ok, check
    check = eq empty_done, 1
    ok = and ok, check
    check = eq done_has, 0
    ok = and ok, check
    check = eq done, 0
    ok = and ok, check
    check = eq mut_ref_back_has, 1
    ok = and ok, check
    check = eq mut_ref_back, 50
    ok = and ok, check
    check = eq mut_ref_len_after_back, 3
    ok = and ok, check
    check = eq deque_len_after_iters, 4
    ok = and ok, check
    check = eq deque_second_after_mut_slice, 35
    ok = and ok, check

    !pop_ok
    !popped
    !hint_lower_initial
    !hint_upper_initial
    !exact_len_initial
    !empty_initial
    !ref_slice_len
    !ref_slice_first
    !first_has
    !first
    !mut_slice_len
    !mut_second_ptr
    !hint_lower_after_first
    !hint_upper_after_first
    !second_has
    !second
    !back_has
    !back
    !middle_has
    !middle
    !empty_done
    !done_has
    !done
    !mut_ref_back_has
    !mut_ref_back
    !mut_ref_len_after_back
    !deque_len_after_iters
    !deque_second_after_mut_slice
    !check
    !iter_mut
    !mut_ref_iter
    !iter_mut_backing_slice
    !mut_ref_backing_slice
    EXPAND VEC_DEQUE_FREE deque
    br ok -> L_VEC_DEQUE_ITER_MUT_OK, L_VEC_DEQUE_ITER_MUT_FAIL

L_VEC_DEQUE_ITER_MUT_FAIL:
    !ok
    panic(10802)

L_VEC_DEQUE_ITER_MUT_OK:
    !ok
    return
