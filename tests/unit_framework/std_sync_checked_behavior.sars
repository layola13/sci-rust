@import "sa_std/sync/mutex.sars"
@import "sa_std/sync/rwlock.sars"
@import "sa_std/sync/barrier.sars"
@import "sa_std/sync/condvar.sars"

@test "sa_std sync checked release and zero edge cases"():
L_ENTRY:
    EXPAND MUTEX_NEW mutex
    EXPAND MUTEX_TRY_UNLOCK mutex_unlock0, mutex
    EXPAND MUTEX_TRY_LOCK mutex_lock, mutex
    EXPAND MUTEX_TRY_UNLOCK mutex_unlock1, mutex
    EXPAND MUTEX_TRY_UNLOCK mutex_unlock2, mutex

    EXPAND RWLOCK_NEW rw
    EXPAND RWLOCK_TRY_RELEASE_READ rw_read_unlock0, rw
    EXPAND RWLOCK_TRY_READ_NOERR rw_read_ok, rw_read_guard, rw
    EXPAND RWLOCK_TRY_RELEASE_READ rw_read_unlock1, rw
    EXPAND RWLOCK_TRY_RELEASE_READ rw_read_unlock2, rw
    EXPAND RWLOCK_TRY_RELEASE_WRITE rw_unlock0, rw
    EXPAND RWLOCK_TRY_WRITE_NOERR rw_write, rw_guard, rw
    EXPAND RWLOCK_TRY_RELEASE_WRITE rw_unlock1, rw
    EXPAND RWLOCK_TRY_RELEASE_WRITE rw_unlock2, rw

    EXPAND BARRIER_NEW barrier_zero, 0
    EXPAND BARRIER_N barrier_n, barrier_zero
    EXPAND BARRIER_WAIT barrier_leader, barrier_zero

    EXPAND CONDVAR_NEW cond
    EXPAND CONDVAR_WAITERS waiters0, cond

    ok0 = eq mutex_unlock0, 0
    ok1 = eq mutex_lock, 1
    ok2 = eq mutex_unlock1, 1
    ok3 = eq mutex_unlock2, 0
    ok4 = eq rw_read_unlock0, 0
    ok5 = eq rw_read_ok, 1
    ok6 = eq rw_read_unlock1, 1
    ok7 = eq rw_read_unlock2, 0
    ok8 = eq rw_unlock0, 0
    ok9 = eq rw_write, 1
    ok10 = eq rw_unlock1, 1
    ok11 = eq rw_unlock2, 0
    ok12 = eq barrier_n, 1
    ok13 = eq barrier_leader, 1
    ok14 = eq waiters0, 0
    all0 = and ok0, ok1
    all1 = and all0, ok2
    all2 = and all1, ok3
    all3 = and all2, ok4
    all4 = and all3, ok5
    all5 = and all4, ok6
    all6 = and all5, ok7
    all7 = and all6, ok8
    all8 = and all7, ok9
    all9 = and all8, ok10
    all10 = and all9, ok11
    all11 = and all10, ok12
    all12 = and all11, ok13
    ok = and all12, ok14

    !mutex
    !mutex_unlock0
    !mutex_lock
    !mutex_unlock1
    !mutex_unlock2
    !rw
    !rw_guard
    !rw_read_unlock0
    !rw_read_ok
    !rw_read_guard
    !rw_read_unlock1
    !rw_read_unlock2
    !rw_unlock0
    !rw_write
    !rw_unlock1
    !rw_unlock2
    !barrier_zero
    !barrier_n
    !barrier_leader
    !cond
    !waiters0
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !ok5
    !ok6
    !ok7
    !ok8
    !ok9
    !ok10
    !all0
    !all1
    !all2
    !all3
    !all4
    !all5
    !all6
    !all7
    !all8
    br ok -> L_PASS, L_FAIL
L_FAIL:
    !ok
    panic(10990)
L_PASS:
    !ok
    return 0
