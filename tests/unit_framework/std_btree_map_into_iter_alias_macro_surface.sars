@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/vec.sars"
@import "sa_std/collections/btree_map.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"

@test "sa_std btree_map into-iterator aliases"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_MAP_NEW borrowed_map
    EXPAND BTREE_MAP_INSERT borrowed_map, charlie, 30
    EXPAND BTREE_MAP_INSERT borrowed_map, alpha, 10
    EXPAND BTREE_MAP_INSERT borrowed_map, bravo, 20

    EXPAND BTREE_MAP_REF_INTO_ITER ref_iter_vec, borrowed_map
    EXPAND BTREE_MAP_MUT_REF_INTO_ITER mut_ref_iter_vec, borrowed_map
    EXPAND VEC_LEN ref_iter_len, ref_iter_vec
    EXPAND VEC_LEN mut_ref_iter_len, mut_ref_iter_vec

    EXPAND VEC_GET_U64 ref_alpha_ptr_bits, ref_iter_vec, 0
    EXPAND VEC_GET_U64 ref_alpha_len, ref_iter_vec, 1
    EXPAND VEC_GET_U64 ref_alpha_value, ref_iter_vec, 2
    EXPAND VEC_GET_U64 ref_bravo_ptr_bits, ref_iter_vec, 3
    EXPAND VEC_GET_U64 ref_bravo_len, ref_iter_vec, 4
    EXPAND VEC_GET_U64 ref_bravo_value, ref_iter_vec, 5
    EXPAND VEC_GET_U64 ref_charlie_ptr_bits, ref_iter_vec, 6
    EXPAND VEC_GET_U64 ref_charlie_len, ref_iter_vec, 7
    EXPAND VEC_GET_U64 ref_charlie_value, ref_iter_vec, 8

    alpha_ptr = load alpha+Slice_ptr as ptr
    bravo_ptr = load bravo+Slice_ptr as ptr
    charlie_ptr = load charlie+Slice_ptr as ptr
    alpha_ptr_bits = bitcast alpha_ptr as u64
    bravo_ptr_bits = bitcast bravo_ptr as u64
    charlie_ptr_bits = bitcast charlie_ptr as u64

    EXPAND VEC_GET_U64 mut_bravo_ptr_bits, mut_ref_iter_vec, 3
    EXPAND VEC_GET_U64 mut_bravo_len, mut_ref_iter_vec, 4
    EXPAND VEC_GET_U64 mut_bravo_value_ptr_bits, mut_ref_iter_vec, 5
    mut_bravo_value_ptr = bitcast mut_bravo_value_ptr_bits as ptr
    store mut_bravo_value_ptr+0, 25 as u64
    EXPAND BTREE_MAP_GET bravo_after_mut, borrowed_map, bravo
    EXPAND BTREE_MAP_LEN borrowed_len_after, borrowed_map

    EXPAND BTREE_MAP_NEW owned_map
    EXPAND BTREE_MAP_INSERT owned_map, charlie, 300
    EXPAND BTREE_MAP_INSERT owned_map, alpha, 100
    EXPAND BTREE_MAP_INSERT owned_map, bravo, 200
    EXPAND BTREE_MAP_INTO_ITER into_iter_vec, owned_map
    EXPAND VEC_LEN into_iter_len, into_iter_vec
    EXPAND VEC_GET_U64 into_alpha_ptr_bits, into_iter_vec, 0
    EXPAND VEC_GET_U64 into_alpha_len, into_iter_vec, 1
    EXPAND VEC_GET_U64 into_alpha_value, into_iter_vec, 2
    EXPAND VEC_GET_U64 into_bravo_ptr_bits, into_iter_vec, 3
    EXPAND VEC_GET_U64 into_bravo_len, into_iter_vec, 4
    EXPAND VEC_GET_U64 into_bravo_value, into_iter_vec, 5
    EXPAND VEC_GET_U64 into_charlie_ptr_bits, into_iter_vec, 6
    EXPAND VEC_GET_U64 into_charlie_len, into_iter_vec, 7
    EXPAND VEC_GET_U64 into_charlie_value, into_iter_vec, 8
    EXPAND BTREE_MAP_LEN owned_len_after, owned_map

    EXPAND BTREE_MAP_NEW empty_map
    EXPAND BTREE_MAP_REF_INTO_ITER empty_ref_iter, empty_map
    EXPAND BTREE_MAP_MUT_REF_INTO_ITER empty_mut_ref_iter, empty_map
    EXPAND BTREE_MAP_INTO_ITER empty_into_iter, empty_map
    EXPAND VEC_LEN empty_ref_iter_len, empty_ref_iter
    EXPAND VEC_LEN empty_mut_ref_iter_len, empty_mut_ref_iter
    EXPAND VEC_LEN empty_into_iter_len, empty_into_iter
    EXPAND BTREE_MAP_LEN empty_len_after, empty_map

    ok_ref_iter_len = eq ref_iter_len, 9
    ok_mut_ref_iter_len = eq mut_ref_iter_len, 9
    ok_ref_alpha_ptr = eq ref_alpha_ptr_bits, alpha_ptr_bits
    ok_ref_alpha_len = eq ref_alpha_len, 5
    ok_ref_alpha_value = eq ref_alpha_value, 10
    ok_ref_bravo_ptr = eq ref_bravo_ptr_bits, bravo_ptr_bits
    ok_ref_bravo_len = eq ref_bravo_len, 5
    ok_ref_bravo_value = eq ref_bravo_value, 20
    ok_ref_charlie_ptr = eq ref_charlie_ptr_bits, charlie_ptr_bits
    ok_ref_charlie_len = eq ref_charlie_len, 7
    ok_ref_charlie_value = eq ref_charlie_value, 30
    ok_mut_bravo_ptr = eq mut_bravo_ptr_bits, bravo_ptr_bits
    ok_mut_bravo_len = eq mut_bravo_len, 5
    ok_mut_bravo_value_ptr = ne mut_bravo_value_ptr_bits, 0
    ok_bravo_after_mut = eq bravo_after_mut, 25
    ok_borrowed_len_after = eq borrowed_len_after, 3
    ok_into_iter_len = eq into_iter_len, 9
    ok_into_alpha_ptr = eq into_alpha_ptr_bits, alpha_ptr_bits
    ok_into_alpha_len = eq into_alpha_len, 5
    ok_into_alpha_value = eq into_alpha_value, 100
    ok_into_bravo_ptr = eq into_bravo_ptr_bits, bravo_ptr_bits
    ok_into_bravo_len = eq into_bravo_len, 5
    ok_into_bravo_value = eq into_bravo_value, 200
    ok_into_charlie_ptr = eq into_charlie_ptr_bits, charlie_ptr_bits
    ok_into_charlie_len = eq into_charlie_len, 7
    ok_into_charlie_value = eq into_charlie_value, 300
    ok_owned_len_after = eq owned_len_after, 0
    ok_empty_ref_iter = eq empty_ref_iter_len, 0
    ok_empty_mut_ref_iter = eq empty_mut_ref_iter_len, 0
    ok_empty_into_iter = eq empty_into_iter_len, 0
    ok_empty_len_after = eq empty_len_after, 0

    ok01 = and ok_ref_iter_len, ok_mut_ref_iter_len
    ok02 = and ok01, ok_ref_alpha_ptr
    ok03 = and ok02, ok_ref_alpha_len
    ok04 = and ok03, ok_ref_alpha_value
    ok05 = and ok04, ok_ref_bravo_ptr
    ok06 = and ok05, ok_ref_bravo_len
    ok07 = and ok06, ok_ref_bravo_value
    ok08 = and ok07, ok_ref_charlie_ptr
    ok09 = and ok08, ok_ref_charlie_len
    ok10 = and ok09, ok_ref_charlie_value
    ok11 = and ok10, ok_mut_bravo_ptr
    ok12 = and ok11, ok_mut_bravo_len
    ok13 = and ok12, ok_mut_bravo_value_ptr
    ok14 = and ok13, ok_bravo_after_mut
    ok15 = and ok14, ok_borrowed_len_after
    ok16 = and ok15, ok_into_iter_len
    ok17 = and ok16, ok_into_alpha_ptr
    ok18 = and ok17, ok_into_alpha_len
    ok19 = and ok18, ok_into_alpha_value
    ok20 = and ok19, ok_into_bravo_ptr
    ok21 = and ok20, ok_into_bravo_len
    ok22 = and ok21, ok_into_bravo_value
    ok23 = and ok22, ok_into_charlie_ptr
    ok24 = and ok23, ok_into_charlie_len
    ok25 = and ok24, ok_into_charlie_value
    ok26 = and ok25, ok_owned_len_after
    ok27 = and ok26, ok_empty_ref_iter
    ok28 = and ok27, ok_empty_mut_ref_iter
    ok29 = and ok28, ok_empty_into_iter
    ok = and ok29, ok_empty_len_after

    !ref_iter_vec
    !mut_ref_iter_vec
    !ref_iter_len
    !mut_ref_iter_len
    !ref_alpha_ptr_bits
    !ref_alpha_len
    !ref_alpha_value
    !ref_bravo_ptr_bits
    !ref_bravo_len
    !ref_bravo_value
    !ref_charlie_ptr_bits
    !ref_charlie_len
    !ref_charlie_value
    !alpha_ptr
    !bravo_ptr
    !charlie_ptr
    !alpha_ptr_bits
    !bravo_ptr_bits
    !charlie_ptr_bits
    !mut_bravo_ptr_bits
    !mut_bravo_len
    !mut_bravo_value_ptr_bits
    !mut_bravo_value_ptr
    !bravo_after_mut
    !borrowed_len_after
    !into_iter_vec
    !into_iter_len
    !into_alpha_ptr_bits
    !into_alpha_len
    !into_alpha_value
    !into_bravo_ptr_bits
    !into_bravo_len
    !into_bravo_value
    !into_charlie_ptr_bits
    !into_charlie_len
    !into_charlie_value
    !owned_len_after
    !empty_ref_iter
    !empty_mut_ref_iter
    !empty_into_iter
    !empty_ref_iter_len
    !empty_mut_ref_iter_len
    !empty_into_iter_len
    !empty_len_after
    !ok_ref_iter_len
    !ok_mut_ref_iter_len
    !ok_ref_alpha_ptr
    !ok_ref_alpha_len
    !ok_ref_alpha_value
    !ok_ref_bravo_ptr
    !ok_ref_bravo_len
    !ok_ref_bravo_value
    !ok_ref_charlie_ptr
    !ok_ref_charlie_len
    !ok_ref_charlie_value
    !ok_mut_bravo_ptr
    !ok_mut_bravo_len
    !ok_mut_bravo_value_ptr
    !ok_bravo_after_mut
    !ok_borrowed_len_after
    !ok_into_iter_len
    !ok_into_alpha_ptr
    !ok_into_alpha_len
    !ok_into_alpha_value
    !ok_into_bravo_ptr
    !ok_into_bravo_len
    !ok_into_bravo_value
    !ok_into_charlie_ptr
    !ok_into_charlie_len
    !ok_into_charlie_value
    !ok_owned_len_after
    !ok_empty_ref_iter
    !ok_empty_mut_ref_iter
    !ok_empty_into_iter
    !ok_empty_len_after
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_MAP_FREE empty_map
    EXPAND BTREE_MAP_FREE owned_map
    EXPAND BTREE_MAP_FREE borrowed_map
    return 0

L_FAIL:
    panic(10813)
