@import "sa_std/collections/binary_heap.sars"

@binary_heap_into_iter_any_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@binary_heap_into_iter_all_lt_five(value: u64) -> u64:
L_ENTRY:
    is_lt = ult value, 5
    !value
    return is_lt

@test "sa_std binary_heap into_iter any all macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW any_heap
    EXPAND BINARY_HEAP_PUSH_U64 any_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 any_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 any_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 any_iter, any_backing, any_heap
    EXPAND BINARY_HEAP_INTO_ITER_ANY_U64 any_bool, any_iter, @binary_heap_into_iter_any_is_even
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 any_remaining, any_iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 any_next_has, any_next, any_iter

    EXPAND BINARY_HEAP_NEW all_heap
    EXPAND BINARY_HEAP_PUSH_U64 all_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 all_heap, 9
    EXPAND BINARY_HEAP_PUSH_U64 all_heap, 1
    EXPAND BINARY_HEAP_INTO_ITER_U64 all_iter, all_backing, all_heap
    EXPAND BINARY_HEAP_INTO_ITER_ALL_U64 all_bool, all_iter, @binary_heap_into_iter_all_lt_five
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_LEN_U64 all_remaining, all_iter
    EXPAND BINARY_HEAP_INTO_ITER_NEXT_U64 all_next_has, all_next, all_iter

    EXPAND BINARY_HEAP_NEW empty_heap
    EXPAND BINARY_HEAP_INTO_ITER_U64 empty_iter, empty_backing, empty_heap
    EXPAND BINARY_HEAP_INTO_ITER_ANY_U64 empty_any, empty_iter, @binary_heap_into_iter_any_is_even
    EXPAND BINARY_HEAP_INTO_ITER_ALL_U64 empty_all, empty_iter, @binary_heap_into_iter_all_lt_five
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_any_empty, empty_iter
    EXPAND BINARY_HEAP_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_all_empty, empty_iter

    EXPAND VEC_FREE any_backing
    EXPAND VEC_FREE all_backing
    EXPAND VEC_FREE empty_backing

    ok_any_bool = eq any_bool, 1
    ok_any_remaining = eq any_remaining, 1
    ok_any_next_has = eq any_next_has, 1
    ok_any_next = eq any_next, 1
    ok_all_bool = eq all_bool, 0
    ok_all_remaining = eq all_remaining, 2
    ok_all_next_has = eq all_next_has, 1
    ok_all_next = eq all_next, 4
    ok_empty_any = eq empty_any, 0
    ok_empty_all = eq empty_all, 1
    ok_empty_any_empty = eq empty_any_empty, 1
    ok_empty_all_empty = eq empty_all_empty, 1

    ok = and ok_any_bool, ok_any_remaining
    ok = and ok, ok_any_next_has
    ok = and ok, ok_any_next
    ok = and ok, ok_all_bool
    ok = and ok, ok_all_remaining
    ok = and ok, ok_all_next_has
    ok = and ok, ok_all_next
    ok = and ok, ok_empty_any
    ok = and ok, ok_empty_all
    ok = and ok, ok_empty_any_empty
    ok = and ok, ok_empty_all_empty

    !any_bool
    !any_remaining
    !any_next_has
    !any_next
    !all_bool
    !all_remaining
    !all_next_has
    !all_next
    !empty_any
    !empty_all
    !empty_any_empty
    !empty_all_empty
    !any_iter
    !all_iter
    !empty_iter
    !ok_any_bool
    !ok_any_remaining
    !ok_any_next_has
    !ok_any_next
    !ok_all_bool
    !ok_all_remaining
    !ok_all_next_has
    !ok_all_next
    !ok_empty_any
    !ok_empty_all
    !ok_empty_any_empty
    !ok_empty_all_empty
    br ok -> L_BINARY_HEAP_INTO_ITER_ANY_ALL_OK, L_BINARY_HEAP_INTO_ITER_ANY_ALL_FAIL

L_BINARY_HEAP_INTO_ITER_ANY_ALL_FAIL:
    !ok
    panic(10770)

L_BINARY_HEAP_INTO_ITER_ANY_ALL_OK:
    !ok
    return
