@import "sa_std/vec_deque.sars"

@vec_deque_iter_array_window_sum(window: ptr, len: u64) -> u64:
L_ENTRY:
    acc = add 0, 0
    index = add 0, 0
    jmp L_VEC_DEQUE_WINDOW_SUM_HEAD
L_VEC_DEQUE_WINDOW_SUM_HEAD:
    more = ult index, len
    br more -> L_VEC_DEQUE_WINDOW_SUM_ADD, L_VEC_DEQUE_WINDOW_SUM_DONE
L_VEC_DEQUE_WINDOW_SUM_ADD:
    off = mul index, 8
    item = ptr_add window, off
    value = load item+0 as u64
    next_acc = add acc, value
    !acc
    acc = add next_acc, 0
    next_index = add index, 1
    !index
    index = add next_index, 0
    !next_index
    !next_acc
    !value
    !item
    !off
    !more
    jmp L_VEC_DEQUE_WINDOW_SUM_HEAD
L_VEC_DEQUE_WINDOW_SUM_DONE:
    !more
    !index
    !len
    !window
    return acc

@test "sa_std vec_deque iterator array window collect macro surface"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY chunks_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK chunks_deque, 99
    EXPAND VEC_DEQUE_PUSH_BACK chunks_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK chunks_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK chunks_deque, 3
    EXPAND VEC_DEQUE_TRY_POP_FRONT chunks_pop_ok, chunks_pop, chunks_deque
    EXPAND VEC_DEQUE_PUSH_BACK chunks_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK chunks_deque, 5
    EXPAND VEC_DEQUE_ITER_U64 chunks_iter, chunks_backing, chunks_deque
    EXPAND VEC_DEQUE_ITER_ARRAY_CHUNKS_COLLECT_U64 chunks_ok, chunks_vec, chunks_iter, 2
    EXPAND VEC_LEN chunks_len, chunks_vec
    EXPAND VEC_GET_U64 chunks_0, chunks_vec, 0
    EXPAND VEC_GET_U64 chunks_1, chunks_vec, 1
    EXPAND VEC_GET_U64 chunks_2, chunks_vec, 2
    EXPAND VEC_GET_U64 chunks_3, chunks_vec, 3
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 chunks_remaining, chunks_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 chunks_tail_has, chunks_tail, chunks_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 chunks_empty_after_tail, chunks_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY partial_chunks_deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK partial_chunks_deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK partial_chunks_deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK partial_chunks_deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK partial_chunks_deque, 40
    EXPAND VEC_DEQUE_PUSH_BACK partial_chunks_deque, 50
    EXPAND VEC_DEQUE_PUSH_BACK partial_chunks_deque, 60
    EXPAND VEC_DEQUE_ITER_U64 partial_chunks_iter, partial_chunks_backing, partial_chunks_deque
    EXPAND VEC_DEQUE_ITER_NEXT_U64 partial_chunks_first_has, partial_chunks_first, partial_chunks_iter
    EXPAND VEC_DEQUE_ITER_ARRAY_CHUNKS_COLLECT_U64 partial_chunks_ok, partial_chunks_vec, partial_chunks_iter, 2
    EXPAND VEC_LEN partial_chunks_len, partial_chunks_vec
    EXPAND VEC_GET_U64 partial_chunks_0, partial_chunks_vec, 0
    EXPAND VEC_GET_U64 partial_chunks_1, partial_chunks_vec, 1
    EXPAND VEC_GET_U64 partial_chunks_2, partial_chunks_vec, 2
    EXPAND VEC_GET_U64 partial_chunks_3, partial_chunks_vec, 3
    EXPAND VEC_DEQUE_ITER_NEXT_U64 partial_chunks_tail_has, partial_chunks_tail, partial_chunks_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 partial_chunks_empty_after_tail, partial_chunks_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY zero_chunks_deque, 2
    EXPAND VEC_DEQUE_PUSH_BACK zero_chunks_deque, 7
    EXPAND VEC_DEQUE_PUSH_BACK zero_chunks_deque, 8
    EXPAND VEC_DEQUE_ITER_U64 zero_chunks_iter, zero_chunks_backing, zero_chunks_deque
    EXPAND VEC_DEQUE_ITER_ARRAY_CHUNKS_COLLECT_U64 zero_chunks_ok, zero_chunks_vec, zero_chunks_iter, 0
    EXPAND VEC_LEN zero_chunks_len, zero_chunks_vec
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 zero_chunks_remaining_before, zero_chunks_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 zero_chunks_next_has, zero_chunks_next, zero_chunks_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 zero_chunks_remaining_after, zero_chunks_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY windows_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK windows_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK windows_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK windows_deque, 8
    EXPAND VEC_DEQUE_PUSH_BACK windows_deque, 1
    EXPAND VEC_DEQUE_ITER_U64 windows_iter, windows_backing, windows_deque
    EXPAND VEC_DEQUE_ITER_MAP_WINDOWS_COLLECT_U64 windows_ok, windows_vec, windows_iter, 2, @vec_deque_iter_array_window_sum
    EXPAND VEC_LEN windows_len, windows_vec
    EXPAND VEC_GET_U64 windows_0, windows_vec, 0
    EXPAND VEC_GET_U64 windows_1, windows_vec, 1
    EXPAND VEC_GET_U64 windows_2, windows_vec, 2
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 windows_empty, windows_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY large_windows_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK large_windows_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK large_windows_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK large_windows_deque, 8
    EXPAND VEC_DEQUE_PUSH_BACK large_windows_deque, 1
    EXPAND VEC_DEQUE_ITER_U64 large_windows_iter, large_windows_backing, large_windows_deque
    EXPAND VEC_DEQUE_ITER_MAP_WINDOWS_COLLECT_U64 large_windows_ok, large_windows_vec, large_windows_iter, 8, @vec_deque_iter_array_window_sum
    EXPAND VEC_LEN large_windows_len, large_windows_vec
    EXPAND VEC_DEQUE_ITER_NEXT_U64 large_windows_next_has, large_windows_next, large_windows_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY zero_windows_deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK zero_windows_deque, 1
    EXPAND VEC_DEQUE_PUSH_BACK zero_windows_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK zero_windows_deque, 8
    EXPAND VEC_DEQUE_PUSH_BACK zero_windows_deque, 1
    EXPAND VEC_DEQUE_ITER_U64 zero_windows_iter, zero_windows_backing, zero_windows_deque
    EXPAND VEC_DEQUE_ITER_MAP_WINDOWS_COLLECT_U64 zero_windows_ok, zero_windows_vec, zero_windows_iter, 0, @vec_deque_iter_array_window_sum
    EXPAND VEC_LEN zero_windows_len, zero_windows_vec
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 zero_windows_remaining_before, zero_windows_iter
    EXPAND VEC_DEQUE_ITER_NEXT_U64 zero_windows_next_has, zero_windows_next, zero_windows_iter
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_LEN_U64 zero_windows_remaining_after, zero_windows_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY empty_windows_deque, 0
    EXPAND VEC_DEQUE_ITER_U64 empty_windows_iter, empty_windows_backing, empty_windows_deque
    EXPAND VEC_DEQUE_ITER_MAP_WINDOWS_COLLECT_U64 empty_windows_ok, empty_windows_vec, empty_windows_iter, 2, @vec_deque_iter_array_window_sum
    EXPAND VEC_LEN empty_windows_len, empty_windows_vec
    EXPAND VEC_DEQUE_ITER_EXACT_SIZE_IS_EMPTY_U64 empty_windows_empty, empty_windows_iter

    EXPAND VEC_DEQUE_WITH_CAPACITY into_deque, 3
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 6
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 7
    EXPAND VEC_DEQUE_PUSH_BACK into_deque, 8
    EXPAND VEC_DEQUE_INTO_ITER_U64 into_iter, into_backing, into_deque
    EXPAND VEC_DEQUE_INTO_ITER_ARRAY_CHUNKS_COLLECT_U64 into_ok, into_vec, into_iter, 2
    EXPAND VEC_LEN into_len, into_vec
    EXPAND VEC_GET_U64 into_0, into_vec, 0
    EXPAND VEC_GET_U64 into_1, into_vec, 1
    EXPAND VEC_DEQUE_INTO_ITER_NEXT_U64 into_tail_has, into_tail, into_iter
    EXPAND VEC_DEQUE_IS_EMPTY into_deque_empty, into_deque

    EXPAND VEC_FREE chunks_backing
    EXPAND VEC_FREE chunks_vec
    EXPAND VEC_FREE partial_chunks_backing
    EXPAND VEC_FREE partial_chunks_vec
    EXPAND VEC_FREE zero_chunks_backing
    EXPAND VEC_FREE zero_chunks_vec
    EXPAND VEC_FREE windows_backing
    EXPAND VEC_FREE windows_vec
    EXPAND VEC_FREE large_windows_backing
    EXPAND VEC_FREE large_windows_vec
    EXPAND VEC_FREE zero_windows_backing
    EXPAND VEC_FREE zero_windows_vec
    EXPAND VEC_FREE empty_windows_backing
    EXPAND VEC_FREE empty_windows_vec
    EXPAND VEC_FREE into_backing
    EXPAND VEC_FREE into_vec
    EXPAND VEC_DEQUE_FREE chunks_deque
    EXPAND VEC_DEQUE_FREE partial_chunks_deque
    EXPAND VEC_DEQUE_FREE zero_chunks_deque
    EXPAND VEC_DEQUE_FREE windows_deque
    EXPAND VEC_DEQUE_FREE large_windows_deque
    EXPAND VEC_DEQUE_FREE zero_windows_deque
    EXPAND VEC_DEQUE_FREE empty_windows_deque
    EXPAND VEC_DEQUE_FREE into_deque

    ok = eq chunks_pop_ok, 1
    check = eq chunks_pop, 99
    ok = and ok, check
    check = eq chunks_ok, 1
    ok = and ok, check
    check = eq chunks_len, 4
    ok = and ok, check
    check = eq chunks_0, 1
    ok = and ok, check
    check = eq chunks_1, 2
    ok = and ok, check
    check = eq chunks_2, 3
    ok = and ok, check
    check = eq chunks_3, 4
    ok = and ok, check
    check = eq chunks_remaining, 1
    ok = and ok, check
    check = eq chunks_tail_has, 1
    ok = and ok, check
    check = eq chunks_tail, 5
    ok = and ok, check
    check = eq chunks_empty_after_tail, 1
    ok = and ok, check
    check = eq partial_chunks_first_has, 1
    ok = and ok, check
    check = eq partial_chunks_first, 10
    ok = and ok, check
    check = eq partial_chunks_ok, 1
    ok = and ok, check
    check = eq partial_chunks_len, 4
    ok = and ok, check
    check = eq partial_chunks_0, 20
    ok = and ok, check
    check = eq partial_chunks_1, 30
    ok = and ok, check
    check = eq partial_chunks_2, 40
    ok = and ok, check
    check = eq partial_chunks_3, 50
    ok = and ok, check
    check = eq partial_chunks_tail_has, 1
    ok = and ok, check
    check = eq partial_chunks_tail, 60
    ok = and ok, check
    check = eq partial_chunks_empty_after_tail, 1
    ok = and ok, check
    check = eq zero_chunks_ok, 0
    ok = and ok, check
    check = eq zero_chunks_len, 0
    ok = and ok, check
    check = eq zero_chunks_remaining_before, 2
    ok = and ok, check
    check = eq zero_chunks_next_has, 1
    ok = and ok, check
    check = eq zero_chunks_next, 7
    ok = and ok, check
    check = eq zero_chunks_remaining_after, 1
    ok = and ok, check
    check = eq windows_ok, 1
    ok = and ok, check
    check = eq windows_len, 3
    ok = and ok, check
    check = eq windows_0, 4
    ok = and ok, check
    check = eq windows_1, 11
    ok = and ok, check
    check = eq windows_2, 9
    ok = and ok, check
    check = eq windows_empty, 1
    ok = and ok, check
    check = eq large_windows_ok, 1
    ok = and ok, check
    check = eq large_windows_len, 0
    ok = and ok, check
    check = eq large_windows_next_has, 0
    ok = and ok, check
    check = eq large_windows_next, 0
    ok = and ok, check
    check = eq zero_windows_ok, 0
    ok = and ok, check
    check = eq zero_windows_len, 0
    ok = and ok, check
    check = eq zero_windows_remaining_before, 4
    ok = and ok, check
    check = eq zero_windows_next_has, 1
    ok = and ok, check
    check = eq zero_windows_next, 1
    ok = and ok, check
    check = eq zero_windows_remaining_after, 3
    ok = and ok, check
    check = eq empty_windows_ok, 1
    ok = and ok, check
    check = eq empty_windows_len, 0
    ok = and ok, check
    check = eq empty_windows_empty, 1
    ok = and ok, check
    check = eq into_ok, 1
    ok = and ok, check
    check = eq into_len, 2
    ok = and ok, check
    check = eq into_0, 6
    ok = and ok, check
    check = eq into_1, 7
    ok = and ok, check
    check = eq into_tail_has, 1
    ok = and ok, check
    check = eq into_tail, 8
    ok = and ok, check
    check = eq into_deque_empty, 1
    ok = and ok, check

    !chunks_pop_ok
    !chunks_pop
    !chunks_ok
    !chunks_len
    !chunks_0
    !chunks_1
    !chunks_2
    !chunks_3
    !chunks_remaining
    !chunks_tail_has
    !chunks_tail
    !chunks_empty_after_tail
    !partial_chunks_first_has
    !partial_chunks_first
    !partial_chunks_ok
    !partial_chunks_len
    !partial_chunks_0
    !partial_chunks_1
    !partial_chunks_2
    !partial_chunks_3
    !partial_chunks_tail_has
    !partial_chunks_tail
    !partial_chunks_empty_after_tail
    !zero_chunks_ok
    !zero_chunks_len
    !zero_chunks_remaining_before
    !zero_chunks_next_has
    !zero_chunks_next
    !zero_chunks_remaining_after
    !windows_ok
    !windows_len
    !windows_0
    !windows_1
    !windows_2
    !windows_empty
    !large_windows_ok
    !large_windows_len
    !large_windows_next_has
    !large_windows_next
    !zero_windows_ok
    !zero_windows_len
    !zero_windows_remaining_before
    !zero_windows_next_has
    !zero_windows_next
    !zero_windows_remaining_after
    !empty_windows_ok
    !empty_windows_len
    !empty_windows_empty
    !into_ok
    !into_len
    !into_0
    !into_1
    !into_tail_has
    !into_tail
    !into_deque_empty
    !check
    !chunks_iter
    !partial_chunks_iter
    !zero_chunks_iter
    !windows_iter
    !large_windows_iter
    !zero_windows_iter
    !empty_windows_iter
    !into_iter
    br ok -> L_VEC_DEQUE_ITER_ARRAY_WINDOW_COLLECT_OK, L_VEC_DEQUE_ITER_ARRAY_WINDOW_COLLECT_FAIL

L_VEC_DEQUE_ITER_ARRAY_WINDOW_COLLECT_FAIL:
    !ok
    panic(10798)

L_VEC_DEQUE_ITER_ARRAY_WINDOW_COLLECT_OK:
    !ok
    return
