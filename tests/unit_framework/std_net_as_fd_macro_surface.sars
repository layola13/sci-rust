@import "sa_std/net.sars"
@import "sa_std/os/fd.sars"

@const NET_AS_FD_LOOPBACK = utf8:"127.0.0.1"

#def NET_AS_FD_LOOPBACK_LEN = 9

@test "sa_std net tcp and udp AsFd aliases"():
L_ENTRY:
    EXPAND NET_TCP_LISTENER_BIND_PORT bind_status, listener, bound_port, NET_AS_FD_LOOPBACK, NET_AS_FD_LOOPBACK_LEN, 0
    bind_status_ok = eq bind_status, SA_NET_OK
    listener_ok = ne listener, 0
    bound_port_ok = ne bound_port, 0
    bind01 = and bind_status_ok, listener_ok
    bind_ok = and bind01, bound_port_ok
    br bind_ok -> L_CONNECT, L_FAIL_BIND

L_FAIL_BIND:
    !bind_ok
    !bind01
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    panic(10697)

L_CONNECT:
    EXPAND NET_TCP_CONNECT connect_status, client, NET_AS_FD_LOOPBACK, NET_AS_FD_LOOPBACK_LEN, bound_port
    connect_status_ok = eq connect_status, SA_NET_OK
    client_ok = ne client, 0
    connect_ok = and connect_status_ok, client_ok
    br connect_ok -> L_ACCEPT, L_FAIL_CONNECT

L_FAIL_CONNECT:
    EXPAND NET_TCP_LISTENER_CLOSE fail_listener_close_status, listener
    !fail_listener_close_status
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !bind_ok
    !bound_port
    !listener
    panic(10697)

L_ACCEPT:
    EXPAND NET_TCP_LISTENER_ACCEPT accept_status, server, listener
    accept_status_ok = eq accept_status, SA_NET_OK
    server_ok = ne server, 0
    accept_ok = and accept_status_ok, server_ok
    br accept_ok -> L_CHECK_TCP, L_FAIL_ACCEPT

L_FAIL_ACCEPT:
    EXPAND NET_TCP_STREAM_CLOSE fail_client_close_status, client
    EXPAND NET_TCP_LISTENER_CLOSE fail_listener_close_status2, listener
    !fail_client_close_status
    !fail_listener_close_status2
    !accept_ok
    !server_ok
    !accept_status_ok
    !server
    !accept_status
    !connect_ok
    !client
    !bind_ok
    !bound_port
    !listener
    panic(10697)

L_CHECK_TCP:
    EXPAND NET_TCP_LISTENER_AS_FD listener_as_fd_status, listener_fd, listener
    EXPAND NET_TCP_LISTENER_AS_RAW_FD listener_raw_status, listener_raw_fd, listener
    EXPAND FD_BORROWED_AS_RAW_FD listener_borrowed_status, listener_borrowed_fd, listener_fd
    EXPAND NET_TCP_STREAM_AS_FD client_as_fd_status, client_fd, client
    EXPAND NET_TCP_STREAM_AS_RAW_FD client_raw_status, client_raw_fd, client
    EXPAND FD_BORROWED_AS_RAW_FD client_borrowed_status, client_borrowed_fd, client_fd
    EXPAND NET_TCP_STREAM_AS_FD server_as_fd_status, server_fd, server
    EXPAND NET_TCP_STREAM_AS_RAW_FD server_raw_status, server_raw_fd, server
    EXPAND FD_BORROWED_AS_RAW_FD server_borrowed_status, server_borrowed_fd, server_fd
    EXPAND NET_TCP_STREAM_CLOSE client_close_status, client
    EXPAND NET_TCP_STREAM_CLOSE server_close_status, server
    EXPAND NET_TCP_LISTENER_CLOSE listener_close_status, listener

    EXPAND NET_UDP_BIND udp_bind_status, udp_socket, NET_AS_FD_LOOPBACK, NET_AS_FD_LOOPBACK_LEN, 0
    EXPAND NET_UDP_AS_FD udp_as_fd_status, udp_fd, udp_socket
    EXPAND NET_UDP_AS_RAW_FD udp_raw_status, udp_raw_fd, udp_socket
    EXPAND FD_BORROWED_AS_RAW_FD udp_borrowed_status, udp_borrowed_fd, udp_fd
    EXPAND NET_UDP_CLOSE udp_close_status, udp_socket

    listener_as_fd_ok = eq listener_as_fd_status, SA_FD_OK
    listener_fd_ok = ne listener_fd, -1
    listener_raw_ok = eq listener_raw_status, SA_FD_OK
    listener_raw_same_ok = eq listener_raw_fd, listener_fd
    listener_borrowed_ok = eq listener_borrowed_status, SA_FD_OK
    listener_borrowed_same_ok = eq listener_borrowed_fd, listener_fd
    client_as_fd_ok = eq client_as_fd_status, SA_FD_OK
    client_fd_ok = ne client_fd, -1
    client_raw_ok = eq client_raw_status, SA_FD_OK
    client_raw_same_ok = eq client_raw_fd, client_fd
    client_borrowed_ok = eq client_borrowed_status, SA_FD_OK
    client_borrowed_same_ok = eq client_borrowed_fd, client_fd
    server_as_fd_ok = eq server_as_fd_status, SA_FD_OK
    server_fd_ok = ne server_fd, -1
    server_raw_ok = eq server_raw_status, SA_FD_OK
    server_raw_same_ok = eq server_raw_fd, server_fd
    server_borrowed_ok = eq server_borrowed_status, SA_FD_OK
    server_borrowed_same_ok = eq server_borrowed_fd, server_fd
    client_close_ok = eq client_close_status, SA_NET_OK
    server_close_ok = eq server_close_status, SA_NET_OK
    listener_close_ok = eq listener_close_status, SA_NET_OK
    udp_bind_ok = eq udp_bind_status, SA_NET_OK
    udp_socket_ok = ne udp_socket, 0
    udp_as_fd_ok = eq udp_as_fd_status, SA_FD_OK
    udp_fd_ok = ne udp_fd, -1
    udp_raw_ok = eq udp_raw_status, SA_FD_OK
    udp_raw_same_ok = eq udp_raw_fd, udp_fd
    udp_borrowed_ok = eq udp_borrowed_status, SA_FD_OK
    udp_borrowed_same_ok = eq udp_borrowed_fd, udp_fd
    udp_close_ok = eq udp_close_status, SA_NET_OK

    ok01 = and listener_as_fd_ok, listener_fd_ok
    ok02 = and ok01, listener_raw_ok
    ok03 = and ok02, listener_raw_same_ok
    ok04 = and ok03, listener_borrowed_ok
    ok05 = and ok04, listener_borrowed_same_ok
    ok06 = and ok05, client_as_fd_ok
    ok07 = and ok06, client_fd_ok
    ok08 = and ok07, client_raw_ok
    ok09 = and ok08, client_raw_same_ok
    ok10 = and ok09, client_borrowed_ok
    ok11 = and ok10, client_borrowed_same_ok
    ok12 = and ok11, server_as_fd_ok
    ok13 = and ok12, server_fd_ok
    ok14 = and ok13, server_raw_ok
    ok15 = and ok14, server_raw_same_ok
    ok16 = and ok15, server_borrowed_ok
    ok17 = and ok16, server_borrowed_same_ok
    ok18 = and ok17, client_close_ok
    ok19 = and ok18, server_close_ok
    ok20 = and ok19, listener_close_ok
    ok21 = and ok20, udp_bind_ok
    ok22 = and ok21, udp_socket_ok
    ok23 = and ok22, udp_as_fd_ok
    ok24 = and ok23, udp_fd_ok
    ok25 = and ok24, udp_raw_ok
    ok26 = and ok25, udp_raw_same_ok
    ok27 = and ok26, udp_borrowed_ok
    ok28 = and ok27, udp_borrowed_same_ok
    ok = and ok28, udp_close_ok

    !listener_as_fd_status
    !listener_fd
    !listener_raw_status
    !listener_raw_fd
    !listener_borrowed_status
    !listener_borrowed_fd
    !client_as_fd_status
    !client_fd
    !client_raw_status
    !client_raw_fd
    !client_borrowed_status
    !client_borrowed_fd
    !server_as_fd_status
    !server_fd
    !server_raw_status
    !server_raw_fd
    !server_borrowed_status
    !server_borrowed_fd
    !client_close_status
    !server_close_status
    !listener_close_status
    !udp_bind_status
    !udp_socket
    !udp_as_fd_status
    !udp_fd
    !udp_raw_status
    !udp_raw_fd
    !udp_borrowed_status
    !udp_borrowed_fd
    !udp_close_status
    !listener_as_fd_ok
    !listener_fd_ok
    !listener_raw_ok
    !listener_raw_same_ok
    !listener_borrowed_ok
    !listener_borrowed_same_ok
    !client_as_fd_ok
    !client_fd_ok
    !client_raw_ok
    !client_raw_same_ok
    !client_borrowed_ok
    !client_borrowed_same_ok
    !server_as_fd_ok
    !server_fd_ok
    !server_raw_ok
    !server_raw_same_ok
    !server_borrowed_ok
    !server_borrowed_same_ok
    !client_close_ok
    !server_close_ok
    !listener_close_ok
    !udp_bind_ok
    !udp_socket_ok
    !udp_as_fd_ok
    !udp_fd_ok
    !udp_raw_ok
    !udp_raw_same_ok
    !udp_borrowed_ok
    !udp_borrowed_same_ok
    !udp_close_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !accept_ok
    !server_ok
    !accept_status_ok
    !server
    !accept_status
    !connect_ok
    !client_ok
    !connect_status_ok
    !client
    !connect_status
    !bind_ok
    !bind01
    !bound_port_ok
    !listener_ok
    !bind_status_ok
    !bound_port
    !listener
    !bind_status
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10697)

L_PASS:
    !ok
    return 0
