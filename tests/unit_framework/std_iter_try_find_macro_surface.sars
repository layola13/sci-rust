@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"

@iter_try_find_even_fail_on_five(value: u64, &out_match: ptr) -> u64:
L_ENTRY:
    is_five = eq value, 5
    br is_five -> L_FAIL, L_CHECK
L_CHECK:
    rem = urem value, 2
    is_even = eq rem, 0
    store out_match+0, is_even as u64
    !is_even
    !rem
    !is_five
    !out_match
    !value
    return 1
L_FAIL:
    !is_five
    !out_match
    !value
    return 0

@iter_try_find_even_all_ok(value: u64, &out_match: ptr) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    store out_match+0, is_even as u64
    !is_even
    !rem
    !out_match
    !value
    return 1

@test "sa_std iter try_find macro surface"():
L_ENTRY:
    success_values = stack_alloc 32
    fail_values = stack_alloc 32
    miss_values = stack_alloc 24
    empty_values = stack_alloc 8

    store success_values+0, 1 as u64
    store success_values+8, 3 as u64
    store success_values+16, 4 as u64
    store success_values+24, 6 as u64
    store fail_values+0, 1 as u64
    store fail_values+8, 3 as u64
    store fail_values+16, 5 as u64
    store fail_values+24, 6 as u64
    store miss_values+0, 1 as u64
    store miss_values+8, 3 as u64
    store miss_values+16, 7 as u64

    success_slice = alloc Slice_SIZE
    fail_slice = alloc Slice_SIZE
    miss_slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW success_slice, success_values, 4
    EXPAND SLICE_NEW fail_slice, fail_values, 4
    EXPAND SLICE_NEW miss_slice, miss_values, 3
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE success_iter, success_slice
    EXPAND ITER_TRY_FIND_U64 success_ok, success_has, success_value, success_iter, @iter_try_find_even_fail_on_five
    EXPAND ITER_LEN success_remaining, success_iter
    EXPAND ITER_NEXT_U64 success_tail_ok, success_tail_value, success_iter
    EXPAND ITER_IS_EMPTY success_empty_after_tail, success_iter

    EXPAND ITER_FROM_SLICE fail_iter, fail_slice
    EXPAND ITER_TRY_FIND_U64 fail_ok, fail_has, fail_value, fail_iter, @iter_try_find_even_fail_on_five
    EXPAND ITER_LEN fail_remaining, fail_iter
    EXPAND ITER_NEXT_U64 fail_tail_ok, fail_tail_value, fail_iter
    EXPAND ITER_IS_EMPTY fail_empty_after_tail, fail_iter

    EXPAND ITER_FROM_SLICE miss_iter, miss_slice
    EXPAND ITER_TRY_FIND_U64 miss_ok, miss_has, miss_value, miss_iter, @iter_try_find_even_all_ok
    EXPAND ITER_IS_EMPTY miss_empty, miss_iter

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_TRY_FIND_U64 empty_ok, empty_has, empty_value, empty_iter, @iter_try_find_even_fail_on_five
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter

    ok_success_ok = eq success_ok, 1
    ok_success_has = eq success_has, 1
    ok_success_value = eq success_value, 4
    ok_success_remaining = eq success_remaining, 1
    ok_success_tail_ok = eq success_tail_ok, 1
    ok_success_tail_value = eq success_tail_value, 6
    ok_success_empty_after_tail = eq success_empty_after_tail, 1
    ok_fail_ok = eq fail_ok, 0
    ok_fail_has = eq fail_has, 0
    ok_fail_value = eq fail_value, 0
    ok_fail_remaining = eq fail_remaining, 1
    ok_fail_tail_ok = eq fail_tail_ok, 1
    ok_fail_tail_value = eq fail_tail_value, 6
    ok_fail_empty_after_tail = eq fail_empty_after_tail, 1
    ok_miss_ok = eq miss_ok, 1
    ok_miss_has = eq miss_has, 0
    ok_miss_value = eq miss_value, 0
    ok_miss_empty = eq miss_empty, 1
    ok_empty_ok = eq empty_ok, 1
    ok_empty_has = eq empty_has, 0
    ok_empty_value = eq empty_value, 0
    ok_empty_iter_empty = eq empty_iter_empty, 1

    c01 = and ok_success_ok, ok_success_has
    c02 = and c01, ok_success_value
    c03 = and c02, ok_success_remaining
    c04 = and c03, ok_success_tail_ok
    c05 = and c04, ok_success_tail_value
    c06 = and c05, ok_success_empty_after_tail
    c07 = and c06, ok_fail_ok
    c08 = and c07, ok_fail_has
    c09 = and c08, ok_fail_value
    c10 = and c09, ok_fail_remaining
    c11 = and c10, ok_fail_tail_ok
    c12 = and c11, ok_fail_tail_value
    c13 = and c12, ok_fail_empty_after_tail
    c14 = and c13, ok_miss_ok
    c15 = and c14, ok_miss_has
    c16 = and c15, ok_miss_value
    c17 = and c16, ok_miss_empty
    c18 = and c17, ok_empty_ok
    c19 = and c18, ok_empty_has
    c20 = and c19, ok_empty_value
    ok = and c20, ok_empty_iter_empty

    !success_ok
    !success_has
    !success_value
    !success_remaining
    !success_tail_ok
    !success_tail_value
    !success_empty_after_tail
    !fail_ok
    !fail_has
    !fail_value
    !fail_remaining
    !fail_tail_ok
    !fail_tail_value
    !fail_empty_after_tail
    !miss_ok
    !miss_has
    !miss_value
    !miss_empty
    !empty_ok
    !empty_has
    !empty_value
    !empty_iter_empty
    !ok_success_ok
    !ok_success_has
    !ok_success_value
    !ok_success_remaining
    !ok_success_tail_ok
    !ok_success_tail_value
    !ok_success_empty_after_tail
    !ok_fail_ok
    !ok_fail_has
    !ok_fail_value
    !ok_fail_remaining
    !ok_fail_tail_ok
    !ok_fail_tail_value
    !ok_fail_empty_after_tail
    !ok_miss_ok
    !ok_miss_has
    !ok_miss_value
    !ok_miss_empty
    !ok_empty_ok
    !ok_empty_has
    !ok_empty_value
    !ok_empty_iter_empty
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !c09
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !c17
    !c18
    !c19
    !c20
    !empty_iter
    !miss_iter
    !fail_iter
    !success_iter
    !empty_slice
    !miss_slice
    !fail_slice
    !success_slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10546)

L_PASS:
    !ok
    return 0
