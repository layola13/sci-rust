@import "sa_std/collections/binary_heap.sars"

@sorted_sequence_separator() -> u64:
L_ENTRY:
    return 90

@sorted_sequence_lt_four(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 2
    !value
    return out

@test "sa_std binary_heap into_iter_sorted sequence collect macro surface"():
L_ENTRY:
    EXPAND BINARY_HEAP_NEW intersperse_heap
    EXPAND BINARY_HEAP_PUSH_U64 intersperse_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 intersperse_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 intersperse_heap, 6
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 intersperse_iter, intersperse_backing, intersperse_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_INTERSPERSE_COLLECT_U64 intersperse_vec, intersperse_iter, 99
    EXPAND VEC_GET_U64 intersperse_0, intersperse_vec, 0
    EXPAND VEC_GET_U64 intersperse_1, intersperse_vec, 1
    EXPAND VEC_GET_U64 intersperse_4, intersperse_vec, 4

    EXPAND BINARY_HEAP_NEW intersperse_with_heap
    EXPAND BINARY_HEAP_PUSH_U64 intersperse_with_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 intersperse_with_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 intersperse_with_heap, 7
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 intersperse_with_iter, intersperse_with_backing, intersperse_with_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_INTERSPERSE_WITH_COLLECT_U64 intersperse_with_vec, intersperse_with_iter, @sorted_sequence_separator
    EXPAND VEC_GET_U64 intersperse_with_0, intersperse_with_vec, 0
    EXPAND VEC_GET_U64 intersperse_with_1, intersperse_with_vec, 1
    EXPAND VEC_GET_U64 intersperse_with_4, intersperse_with_vec, 4

    EXPAND BINARY_HEAP_NEW cycle_heap
    EXPAND BINARY_HEAP_PUSH_U64 cycle_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 cycle_heap, 5
    EXPAND BINARY_HEAP_PUSH_U64 cycle_heap, 7
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 cycle_iter, cycle_backing, cycle_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_CYCLE_TAKE_COLLECT_U64 cycle_vec, cycle_iter, 8
    EXPAND VEC_GET_U64 cycle_0, cycle_vec, 0
    EXPAND VEC_GET_U64 cycle_3, cycle_vec, 3
    EXPAND VEC_GET_U64 cycle_7, cycle_vec, 7

    EXPAND BINARY_HEAP_NEW take_while_heap
    EXPAND BINARY_HEAP_PUSH_U64 take_while_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 take_while_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 take_while_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 take_while_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 take_while_heap, 5
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 take_while_iter, take_while_backing, take_while_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_TAKE_WHILE_COLLECT_U64 take_while_vec, take_while_iter, @sorted_sequence_lt_four
    EXPAND VEC_GET_U64 take_while_0, take_while_vec, 0
    EXPAND VEC_GET_U64 take_while_2, take_while_vec, 2
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_EXACT_SIZE_LEN_U64 take_while_remaining, take_while_iter
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_NEXT_U64 take_while_tail_has, take_while_tail, take_while_iter

    EXPAND BINARY_HEAP_NEW skip_while_heap
    EXPAND BINARY_HEAP_PUSH_U64 skip_while_heap, 1
    EXPAND BINARY_HEAP_PUSH_U64 skip_while_heap, 2
    EXPAND BINARY_HEAP_PUSH_U64 skip_while_heap, 3
    EXPAND BINARY_HEAP_PUSH_U64 skip_while_heap, 4
    EXPAND BINARY_HEAP_PUSH_U64 skip_while_heap, 5
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_U64 skip_while_iter, skip_while_backing, skip_while_heap
    EXPAND BINARY_HEAP_INTO_ITER_SORTED_SKIP_WHILE_COLLECT_U64 skip_while_vec, skip_while_iter, @sorted_sequence_lt_four
    EXPAND VEC_GET_U64 skip_while_0, skip_while_vec, 0
    EXPAND VEC_GET_U64 skip_while_1, skip_while_vec, 1

    EXPAND VEC_FREE intersperse_backing
    EXPAND VEC_FREE intersperse_vec
    EXPAND VEC_FREE intersperse_with_backing
    EXPAND VEC_FREE intersperse_with_vec
    EXPAND VEC_FREE cycle_backing
    EXPAND VEC_FREE cycle_vec
    EXPAND VEC_FREE take_while_backing
    EXPAND VEC_FREE take_while_vec
    EXPAND VEC_FREE skip_while_backing
    EXPAND VEC_FREE skip_while_vec

    ok = eq intersperse_0, 6
    check = eq intersperse_1, 99
    ok = and ok, check
    check = eq intersperse_4, 2
    ok = and ok, check
    check = eq intersperse_with_0, 7
    ok = and ok, check
    check = eq intersperse_with_1, 90
    ok = and ok, check
    check = eq intersperse_with_4, 3
    ok = and ok, check
    check = eq cycle_0, 7
    ok = and ok, check
    check = eq cycle_3, 7
    ok = and ok, check
    check = eq cycle_7, 5
    ok = and ok, check
    check = eq take_while_0, 5
    ok = and ok, check
    check = eq take_while_2, 3
    ok = and ok, check
    check = eq take_while_remaining, 1
    ok = and ok, check
    check = eq take_while_tail, 1
    ok = and ok, check
    check = eq skip_while_0, 2
    ok = and ok, check
    check = eq skip_while_1, 1
    ok = and ok, check

    !intersperse_0
    !intersperse_1
    !intersperse_4
    !intersperse_with_0
    !intersperse_with_1
    !intersperse_with_4
    !cycle_0
    !cycle_3
    !cycle_7
    !take_while_0
    !take_while_2
    !take_while_remaining
    !take_while_tail_has
    !take_while_tail
    !skip_while_0
    !skip_while_1
    !check
    !intersperse_iter
    !intersperse_with_iter
    !cycle_iter
    !take_while_iter
    !skip_while_iter
    br ok -> L_SORTED_SEQUENCE_OK, L_SORTED_SEQUENCE_FAIL
L_SORTED_SEQUENCE_FAIL:
    !ok
    panic(10784)
L_SORTED_SEQUENCE_OK:
    !ok
    return
