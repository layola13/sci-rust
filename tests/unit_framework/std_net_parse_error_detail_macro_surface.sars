@import "sa_std/net.sars"

@const IPV4_TEXT = utf8:"192.0.2.9"
#def IPV4_TEXT_LEN = 10
@const IPV6_TEXT = utf8:"2001:db8::1"
#def IPV6_TEXT_LEN = 11
@const SOCKET4_TEXT = utf8:"192.0.2.9:8080"
#def SOCKET4_TEXT_LEN = 14
@const SOCKET6_TEXT = utf8:"[2001:db8::1]:443"
#def SOCKET6_TEXT_LEN = 17
@const BAD_TEXT = utf8:"not-an-address"
#def BAD_TEXT_LEN = 14

@test "sa_std net parse error detail kinds"():
L_ENTRY:
    ipv4 = stack_alloc NetIpv4Addr_SIZE
    ipv6 = stack_alloc NetIpv6Addr_SIZE
    ip = stack_alloc NetIpAddr_SIZE
    sock4 = stack_alloc NetSocketAddrV4_SIZE
    sock6 = stack_alloc NetSocketAddrV6_SIZE
    socket = stack_alloc NetSocketAddr_SIZE

    EXPAND NET_IPV4_TRY_PARSE_ASCII_DETAIL ipv4_ok, ipv4_kind, ipv4, IPV4_TEXT, IPV4_TEXT_LEN
    EXPAND NET_IPV6_TRY_PARSE_ASCII_DETAIL ipv6_ok, ipv6_kind, ipv6, IPV6_TEXT, IPV6_TEXT_LEN
    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII_DETAIL ip_ok, ip_kind, ip, IPV4_TEXT, IPV4_TEXT_LEN
    EXPAND NET_SOCKET_ADDR_V4_TRY_PARSE_ASCII_DETAIL sock4_ok, sock4_kind, sock4, SOCKET4_TEXT, SOCKET4_TEXT_LEN
    EXPAND NET_SOCKET_ADDR_V6_TRY_PARSE_ASCII_DETAIL sock6_ok, sock6_kind, sock6, SOCKET6_TEXT, SOCKET6_TEXT_LEN
    EXPAND NET_SOCKET_ADDR_TRY_PARSE_ASCII_DETAIL socket_ok, socket_kind, socket, BAD_TEXT, BAD_TEXT_LEN

    ipv4_bad = stack_alloc NetIpv4Addr_SIZE
    ipv6_bad = stack_alloc NetIpv6Addr_SIZE
    EXPAND NET_IPV4_PARSE_ASCII_DETAIL ipv4_bad_ok, ipv4_bad_kind, ipv4_bad, BAD_TEXT, BAD_TEXT_LEN
    EXPAND NET_IPV6_PARSE_ASCII_DETAIL ipv6_bad_ok, ipv6_bad_kind, ipv6_bad, BAD_TEXT, BAD_TEXT_LEN

    ipv4_kind_ok = eq ipv4_kind, ADDR_PARSE_ERROR_IPV4
    ok01 = and ipv4_ok, ipv4_kind_ok
    ok02 = and ok01, ipv6_ok
    ipv6_kind_ok = eq ipv6_kind, ADDR_PARSE_ERROR_IPV6
    ok03 = and ok02, ipv6_kind_ok
    ok04 = and ok03, ip_ok
    ip_kind_ok = eq ip_kind, ADDR_PARSE_ERROR_IP
    ok05 = and ok04, ip_kind_ok
    ok06 = and ok05, sock4_ok
    sock4_kind_ok = eq sock4_kind, ADDR_PARSE_ERROR_SOCKET_V4
    ok07 = and ok06, sock4_kind_ok
    ok08 = and ok07, sock6_ok
    sock6_kind_ok = eq sock6_kind, ADDR_PARSE_ERROR_SOCKET_V6
    ok09 = and ok08, sock6_kind_ok
    socket_ok_zero = eq socket_ok, 0
    ok10 = and ok09, socket_ok_zero
    socket_kind_ok = eq socket_kind, ADDR_PARSE_ERROR_SOCKET
    ok11 = and ok10, socket_kind_ok
    ipv4_bad_ok_zero = eq ipv4_bad_ok, 0
    ok12 = and ok11, ipv4_bad_ok_zero
    ipv4_bad_kind_ok = eq ipv4_bad_kind, ADDR_PARSE_ERROR_IPV4
    ok13 = and ok12, ipv4_bad_kind_ok
    ipv6_bad_ok_zero = eq ipv6_bad_ok, 0
    ok14 = and ok13, ipv6_bad_ok_zero
    ipv6_bad_kind_ok = eq ipv6_bad_kind, ADDR_PARSE_ERROR_IPV6
    ok = and ok14, ipv6_bad_kind_ok

    !ipv6_bad_kind_ok
    !ok14
    !ipv6_bad_ok_zero
    !ok13
    !ipv4_bad_kind_ok
    !ok12
    !ipv4_bad_ok_zero
    !ok11
    !socket_kind_ok
    !ok10
    !socket_ok_zero
    !ok09
    !sock6_kind_ok
    !ok08
    !ok07
    !sock4_kind_ok
    !ok06
    !ok05
    !ip_kind_ok
    !ok04
    !ok03
    !ipv6_kind_ok
    !ok02
    !ok01
    !ipv4_kind_ok
    !ipv4_ok
    !ipv4_kind
    !ipv6_ok
    !ipv6_kind
    !ip_ok
    !ip_kind
    !sock4_ok
    !sock4_kind
    !sock6_ok
    !sock6_kind
    !socket_ok
    !socket_kind
    !ipv4_bad_ok
    !ipv4_bad_kind
    !ipv6_bad_ok
    !ipv6_bad_kind
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10595)

L_PASS:
    !ok
    return 0
