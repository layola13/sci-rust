@import "sa_std/collections/hashset.sars"
@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_set.sars"
@import "sa_std/vec.sars"
@import "sa_std/path.sars"

@const K = utf8:"k"

@test "sa_std container is_empty helpers"():
L_ENTRY:
    EXPAND SET_NEW set
    EXPAND SET_IS_EMPTY se0, set
    key = &K
    EXPAND SET_INSERT ins, set, key
    EXPAND SET_IS_EMPTY se1, set
    EXPAND SET_FREE set

    ka = alloc Slice_SIZE
    EXPAND SLICE_NEW ka, &K, 1
    EXPAND BTREE_SET_NEW bset
    EXPAND BTREE_SET_IS_EMPTY be0, bset
    EXPAND BTREE_SET_INSERT bins, bset, ka
    EXPAND BTREE_SET_IS_EMPTY be1, bset
    EXPAND BTREE_SET_FREE bset

    EXPAND VEC_NEW v
    EXPAND VEC_IS_EMPTY ve0, v
    EXPAND VEC_PUSH_U64 v, 1
    EXPAND VEC_IS_EMPTY ve1, v
    EXPAND VEC_FREE v

    EXPAND PATH_BUF_NEW pb
    EXPAND PATH_BUF_IS_EMPTY pe0, pb
    child = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW child, &K, 1
    EXPAND PATH_BUF_PUSH pb, child
    EXPAND PATH_BUF_IS_EMPTY pe1, pb
    EXPAND PATH_BUF_FREE pb

    a = eq se0, 1
    b = eq se1, 0
    c = eq be0, 1
    d = eq be1, 0
    e = eq ve0, 1
    f = eq ve1, 0
    g = eq pe0, 1
    h = eq pe1, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok04 = and ok03, e
    ok05 = and ok04, f
    ok06 = and ok05, g
    ok = and ok06, h
    !ins
    !bins
    !se0
    !se1
    !be0
    !be1
    !ve0
    !ve1
    !pe0
    !pe1
    !a
    !b
    !c
    !d
    !e
    !f
    !g
    !h
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10974)
