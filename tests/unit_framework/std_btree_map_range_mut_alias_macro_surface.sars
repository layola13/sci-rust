@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/vec.sars"
@import "sa_std/collections/btree_map.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"
@const KEY_DELTA = utf8:"delta"

@test "sa_std btree_map range_mut alias"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    delta = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7
    EXPAND SLICE_NEW delta, &KEY_DELTA, 5

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, delta, 40
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, charlie, 30
    EXPAND BTREE_MAP_INSERT map, bravo, 20

    EXPAND BTREE_MAP_RANGE_MUT range_mut_vec, map, bravo, delta
    EXPAND VEC_LEN range_mut_len, range_mut_vec
    EXPAND VEC_GET_U64 bravo_ptr_bits, range_mut_vec, 0
    EXPAND VEC_GET_U64 bravo_len, range_mut_vec, 1
    EXPAND VEC_GET_U64 bravo_value_ptr_bits, range_mut_vec, 2
    EXPAND VEC_GET_U64 charlie_ptr_bits, range_mut_vec, 3
    EXPAND VEC_GET_U64 charlie_len, range_mut_vec, 4
    EXPAND VEC_GET_U64 charlie_value_ptr_bits, range_mut_vec, 5

    expected_bravo_ptr = load bravo+Slice_ptr as ptr
    expected_charlie_ptr = load charlie+Slice_ptr as ptr
    expected_bravo_bits = bitcast expected_bravo_ptr as u64
    expected_charlie_bits = bitcast expected_charlie_ptr as u64
    bravo_value_ptr = bitcast bravo_value_ptr_bits as ptr
    charlie_value_ptr = bitcast charlie_value_ptr_bits as ptr
    store bravo_value_ptr+0, 22 as u64
    store charlie_value_ptr+0, 33 as u64

    EXPAND BTREE_MAP_GET alpha_value, map, alpha
    EXPAND BTREE_MAP_GET bravo_value, map, bravo
    EXPAND BTREE_MAP_GET charlie_value, map, charlie
    EXPAND BTREE_MAP_GET delta_value, map, delta
    EXPAND BTREE_MAP_LEN map_len_after, map

    EXPAND BTREE_MAP_RANGE_MUT empty_range_vec, map, delta, delta
    EXPAND VEC_LEN empty_range_len, empty_range_vec

    ok_range_len = eq range_mut_len, 6
    ok_bravo_ptr = eq bravo_ptr_bits, expected_bravo_bits
    ok_bravo_len = eq bravo_len, 5
    ok_bravo_value_ptr = ne bravo_value_ptr_bits, 0
    ok_charlie_ptr = eq charlie_ptr_bits, expected_charlie_bits
    ok_charlie_len = eq charlie_len, 7
    ok_charlie_value_ptr = ne charlie_value_ptr_bits, 0
    ok_alpha_value = eq alpha_value, 10
    ok_bravo_value = eq bravo_value, 22
    ok_charlie_value = eq charlie_value, 33
    ok_delta_value = eq delta_value, 40
    ok_map_len = eq map_len_after, 4
    ok_empty_range = eq empty_range_len, 0

    ok01 = and ok_range_len, ok_bravo_ptr
    ok02 = and ok01, ok_bravo_len
    ok03 = and ok02, ok_bravo_value_ptr
    ok04 = and ok03, ok_charlie_ptr
    ok05 = and ok04, ok_charlie_len
    ok06 = and ok05, ok_charlie_value_ptr
    ok07 = and ok06, ok_alpha_value
    ok08 = and ok07, ok_bravo_value
    ok09 = and ok08, ok_charlie_value
    ok10 = and ok09, ok_delta_value
    ok11 = and ok10, ok_map_len
    ok = and ok11, ok_empty_range

    !range_mut_vec
    !range_mut_len
    !bravo_ptr_bits
    !bravo_len
    !bravo_value_ptr_bits
    !charlie_ptr_bits
    !charlie_len
    !charlie_value_ptr_bits
    !expected_bravo_ptr
    !expected_charlie_ptr
    !expected_bravo_bits
    !expected_charlie_bits
    !bravo_value_ptr
    !charlie_value_ptr
    !alpha_value
    !bravo_value
    !charlie_value
    !delta_value
    !map_len_after
    !empty_range_vec
    !empty_range_len
    !ok_range_len
    !ok_bravo_ptr
    !ok_bravo_len
    !ok_bravo_value_ptr
    !ok_charlie_ptr
    !ok_charlie_len
    !ok_charlie_value_ptr
    !ok_alpha_value
    !ok_bravo_value
    !ok_charlie_value
    !ok_delta_value
    !ok_map_len
    !ok_empty_range
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !delta
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_MAP_FREE map
    return 0

L_FAIL:
    panic(10834)
