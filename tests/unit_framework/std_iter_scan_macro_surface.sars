@import "sa_std/core/slice.sars"
@import "sa_std/iter.sars"
@import "sa_std/vec.sars"

@iter_scan_product_until_six(&state_ptr: ptr, value: u64, &out_mapped: ptr) -> u64:
L_ENTRY:
    state = load state_ptr+0 as u64
    next = mul state, value
    store state_ptr+0, next as u64
    keep = ule next, 6
    br keep -> L_SCAN_KEEP, L_SCAN_STOP
L_SCAN_KEEP:
    mapped = add next, 100
    store out_mapped+0, mapped as u64
    !mapped
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 1
L_SCAN_STOP:
    !keep
    !next
    !state
    !out_mapped
    !value
    !state_ptr
    return 0

@test "sa_std iter scan collect macro surface"():
L_ENTRY:
    values = stack_alloc 40
    empty_values = stack_alloc 8

    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW empty_slice, empty_values, 0

    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_SCAN_COLLECT_U64 vec, iter, 1, @iter_scan_product_until_six
    EXPAND ITER_LEN iter_remaining, iter
    EXPAND ITER_NEXT_U64 tail_ok, tail_value, iter
    EXPAND ITER_IS_EMPTY iter_empty_after_tail, iter

    EXPAND VEC_LEN vec_len, vec
    EXPAND VEC_GET_U64 vec_0, vec, 0
    EXPAND VEC_GET_U64 vec_1, vec, 1
    EXPAND VEC_GET_U64 vec_2, vec, 2

    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_SCAN_COLLECT_U64 empty_vec, empty_iter, 9, @iter_scan_product_until_six
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter
    EXPAND VEC_LEN empty_len, empty_vec

    ok_len = eq vec_len, 3
    ok_0 = eq vec_0, 101
    ok_1 = eq vec_1, 102
    ok_2 = eq vec_2, 106
    ok_remaining = eq iter_remaining, 1
    ok_tail_flag = eq tail_ok, 1
    ok_tail_value = eq tail_value, 5
    ok_empty_after_tail = eq iter_empty_after_tail, 1
    ok_empty_iter = eq empty_iter_empty, 1
    ok_empty_len = eq empty_len, 0

    c01 = and ok_len, ok_0
    c02 = and c01, ok_1
    c03 = and c02, ok_2
    c04 = and c03, ok_remaining
    c05 = and c04, ok_tail_flag
    c06 = and c05, ok_tail_value
    c07 = and c06, ok_empty_after_tail
    c08 = and c07, ok_empty_iter
    ok = and c08, ok_empty_len

    !iter_remaining
    !tail_ok
    !tail_value
    !iter_empty_after_tail
    !vec_len
    !vec_0
    !vec_1
    !vec_2
    !empty_iter_empty
    !empty_len
    !ok_len
    !ok_0
    !ok_1
    !ok_2
    !ok_remaining
    !ok_tail_flag
    !ok_tail_value
    !ok_empty_after_tail
    !ok_empty_iter
    !ok_empty_len
    !c01
    !c02
    !c03
    !c04
    !c05
    !c06
    !c07
    !c08
    !empty_iter
    !iter
    !empty_slice
    !slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE vec
    panic(10540)

L_PASS:
    !ok
    EXPAND VEC_FREE empty_vec
    EXPAND VEC_FREE vec
    return 0
