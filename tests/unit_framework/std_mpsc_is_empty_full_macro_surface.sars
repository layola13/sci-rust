@import "sa_std/sync/mpsc.sars"

@test "sa_std mpsc is_empty is_full"():
L_ENTRY:
    EXPAND MPSC_NEW chan, 1
    EXPAND MPSC_IS_EMPTY e0, chan
    EXPAND MPSC_IS_FULL f0, chan
    EXPAND MPSC_TRY_SEND s, chan, 1
    EXPAND MPSC_IS_EMPTY e1, chan
    EXPAND MPSC_IS_FULL f1, chan
    EXPAND MPSC_FREE chan
    a = eq e0, 1
    b = eq f0, 0
    c = eq s, 1
    d = eq e1, 0
    e = eq f1, 1
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok = and ok03, e
    !e0
    !f0
    !s
    !e1
    !f1
    !a
    !b
    !c
    !d
    !e
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10979)
