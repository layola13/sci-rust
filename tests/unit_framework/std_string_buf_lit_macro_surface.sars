@import "sa_std/string.sars"
@import "sa_std/core/slice.sars"

@const SB_LIT_A = utf8:"ab"
@const SB_LIT_B = utf8:"cd"
@const SB_LIT_C = utf8:"ef"

@test "sa_std string_buf lit constructors"():
L_ENTRY:
    a = alloc Slice_SIZE
    b = alloc Slice_SIZE
    c = alloc Slice_SIZE
    EXPAND SLICE_NEW a, &SB_LIT_A, 2
    EXPAND SLICE_NEW b, &SB_LIT_B, 2
    EXPAND SLICE_NEW c, &SB_LIT_C, 2
    EXPAND STRING_BUF_LIT3 s, a, b, c
    EXPAND STRING_BUF_LEN len0, s
    len0_ok = eq len0, 6
    EXPAND STRING_BUF_LIT1 s1, a
    EXPAND STRING_BUF_LEN len1, s1
    len1_ok = eq len1, 2
    EXPAND STRING_BUF_LIT2 s2, a, b
    EXPAND STRING_BUF_LEN len2, s2
    len2_ok = eq len2, 4
    EXPAND STRING_BUF_FREE s
    EXPAND STRING_BUF_FREE s1
    EXPAND STRING_BUF_FREE s2
    !a
    !b
    !c
    ok = and len0_ok, len1_ok
    ok = and ok, len2_ok
    !len0
    !len1
    !len2
    !len0_ok
    !len1_ok
    !len2_ok
    br ok -> L_SB_LIT_OK, L_SB_LIT_FAIL
L_SB_LIT_FAIL:
    !ok
    panic(1115)
L_SB_LIT_OK:
    !ok
    return
