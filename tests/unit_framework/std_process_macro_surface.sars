@test "sa_std process group signal macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    dummy = stack_alloc 1
    exit_status = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, SLEEP_BIN, SLEEP_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, SLEEP_ARG, SLEEP_ARG_LEN

    EXPAND PROCESS_SPAWN_COMMAND_EXT spawn_status, process, argv, 2, dummy, 0, 0, dummy, 0, 0, 0, 1, 0
    spawn_status_ok = eq spawn_status, SA_PROCESS_OK
    process_ok = ne process, 0
    spawn_ok = and spawn_status_ok, process_ok
    br spawn_ok -> L_GROUP_KILL, L_FAIL_GROUP_SPAWN

L_FAIL_GROUP_SPAWN:
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(10206)

L_GROUP_KILL:
    EXPAND PROCESS_SEND_PROCESS_GROUP_SIGNAL group_kill_status, process, SIG_KILL_PROCESS
    group_kill_ok = eq group_kill_status, SA_PROCESS_OK
    br group_kill_ok -> L_GROUP_WAIT, L_FAIL_GROUP_KILL

L_FAIL_GROUP_KILL:
    !group_kill_ok
    !group_kill_status
    EXPAND PROCESS_KILL cleanup_kill_group, process
    EXPAND PROCESS_CLOSE cleanup_close_group, process
    !cleanup_kill_group
    !cleanup_close_group
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1025)

L_GROUP_WAIT:
    EXPAND PROCESS_WAIT_EXIT_STATUS wait_status, exit_status, process
    wait_ok = eq wait_status, SA_PROCESS_OK
    EXPAND PROCESS_EXIT_STATUS_RAW raw, exit_status
    EXPAND PROCESS_EXIT_STATUS_SIGNAL signal, exit_status
    raw_ok = ne raw, 0
    signal_ok = eq signal, SIG_KILL_PROCESS
    group_wait01 = and wait_ok, raw_ok
    group_wait_ok = and group_wait01, signal_ok
    EXPAND PROCESS_CLOSE close_status, process
    close_ok = eq close_status, SA_PROCESS_OK
    group_all = and group_wait_ok, close_ok
    br group_all -> L_PASS_GROUP_SIGNAL, L_FAIL_GROUP_WAIT

L_FAIL_GROUP_WAIT:
    !group_all
    !close_ok
    !close_status
    !group_wait_ok
    !group_wait01
    !signal_ok
    !raw_ok
    !signal
    !raw
    !wait_ok
    !wait_status
    !group_kill_ok
    !group_kill_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1026)

L_PASS_GROUP_SIGNAL:
    !group_all
    !close_ok
    !close_status
    !group_wait_ok
    !group_wait01
    !signal_ok
    !raw_ok
    !signal
    !raw
    !wait_ok
    !wait_status
    !group_kill_ok
    !group_kill_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    return 0

@test "sa_std process kill process group macro"():
L_KPG_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    dummy = stack_alloc 1
    exit_status = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, SLEEP_BIN, SLEEP_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, SLEEP_ARG, SLEEP_ARG_LEN

    EXPAND PROCESS_SPAWN_COMMAND_EXT spawn_status, process, argv, 2, dummy, 0, 0, dummy, 0, 0, 0, 1, 0
    spawn_status_ok = eq spawn_status, SA_PROCESS_OK
    process_ok = ne process, 0
    spawn_ok = and spawn_status_ok, process_ok
    br spawn_ok -> L_KPG_KILL, L_KPG_FAIL_SPAWN

L_KPG_FAIL_SPAWN:
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1063)

L_KPG_KILL:
    EXPAND PROCESS_KILL_PROCESS_GROUP kill_group_status, process
    kill_group_ok = eq kill_group_status, SA_PROCESS_OK
    br kill_group_ok -> L_KPG_WAIT, L_KPG_FAIL_KILL

L_KPG_FAIL_KILL:
    !kill_group_ok
    !kill_group_status
    EXPAND PROCESS_KILL cleanup_kill_group, process
    EXPAND PROCESS_CLOSE cleanup_close_group, process
    !cleanup_kill_group
    !cleanup_close_group
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1064)

L_KPG_WAIT:
    EXPAND PROCESS_WAIT_EXIT_STATUS wait_status, exit_status, process
    wait_ok = eq wait_status, SA_PROCESS_OK
    EXPAND PROCESS_EXIT_STATUS_RAW raw, exit_status
    EXPAND PROCESS_EXIT_STATUS_SIGNAL signal, exit_status
    raw_ok = ne raw, 0
    signal_ok = eq signal, SIG_KILL_PROCESS
    wait01 = and wait_ok, raw_ok
    wait_all = and wait01, signal_ok
    EXPAND PROCESS_CLOSE close_status, process
    close_ok = eq close_status, SA_PROCESS_OK
    all_ok = and wait_all, close_ok
    br all_ok -> L_KPG_PASS, L_KPG_FAIL_WAIT

L_KPG_FAIL_WAIT:
    !all_ok
    !close_ok
    !close_status
    !wait_all
    !wait01
    !signal_ok
    !raw_ok
    !signal
    !raw
    !wait_ok
    !wait_status
    !kill_group_ok
    !kill_group_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1065)

L_KPG_PASS:
    !all_ok
    !close_ok
    !close_status
    !wait_all
    !wait01
    !signal_ok
    !raw_ok
    !signal
    !raw
    !wait_ok
    !wait_status
    !kill_group_ok
    !kill_group_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    return 0

@test "sa_std pidfd macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    dummy = stack_alloc 1
    exit_status = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, SLEEP_BIN, SLEEP_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, SLEEP_ARG, SLEEP_ARG_LEN

    EXPAND PROCESS_SPAWN_COMMAND_EXT_PIDFD spawn_status, process, argv, 2, dummy, 0, 0, dummy, 0, 0, 0, 0, 0, PIDFD_CREATE
    spawn_ok = eq spawn_status, SA_PROCESS_OK
    process_ok = ne process, 0
    spawn_all = and spawn_ok, process_ok
    br spawn_all -> L_PIDFD_BORROW, L_FAIL_PIDFD_SPAWN

L_FAIL_PIDFD_SPAWN:
    !spawn_all
    !process_ok
    !spawn_status
    !process
    panic(1030)

L_PIDFD_BORROW:
    EXPAND PROCESS_PIDFD pidfd_status, pidfd, process
    pidfd_ok = eq pidfd_status, SA_PROCESS_OK
    br pidfd_ok -> L_HAVE_PIDFD, L_PIDFD_FALLBACK

L_HAVE_PIDFD:
    EXPAND PIDFD_AS_RAW_FD pidfd_as_raw_status, pidfd_raw_fd, pidfd
    pidfd_as_raw_ok = eq pidfd_as_raw_status, SA_PROCESS_OK
    pidfd_raw_fd_ok = ne pidfd_raw_fd, -1
    pidfd_raw_all = and pidfd_as_raw_ok, pidfd_raw_fd_ok
    br pidfd_raw_all -> L_PIDFD_TRY, L_FAIL_PIDFD_RAW

L_FAIL_PIDFD_RAW:
    !pidfd_raw_all
    !pidfd_raw_fd_ok
    !pidfd_as_raw_ok
    !pidfd_raw_fd
    !pidfd_as_raw_status
    panic(1066)

L_PIDFD_TRY:
    EXPAND PIDFD_TRY_WAIT pidfd_try_status, pidfd_ready, pidfd_code, pidfd
    pidfd_try_status_ok = eq pidfd_try_status, SA_PROCESS_OK
    pidfd_try_ready = eq pidfd_ready, 0
    pidfd_try_code = eq pidfd_code, 0
    pidfd_try_all = and pidfd_try_status_ok, pidfd_try_ready
    pidfd_try_all = and pidfd_try_all, pidfd_try_code
    br pidfd_try_all -> L_PIDFD_KILL, L_FAIL_PIDFD_TRY

L_FAIL_PIDFD_TRY:
    !pidfd_try_all
    !pidfd_try_code
    !pidfd_try_ready
    !pidfd_try_status_ok
    !pidfd_try_status
    !pidfd_code
    !pidfd_ready
    panic(1031)

L_PIDFD_KILL:
    EXPAND PIDFD_KILL pidfd_kill_status, pidfd
    pidfd_kill_ok = eq pidfd_kill_status, SA_PROCESS_OK
    br pidfd_kill_ok -> L_PIDFD_WAIT, L_FAIL_PIDFD_KILL

L_FAIL_PIDFD_KILL:
    !pidfd_kill_ok
    !pidfd_kill_status
    panic(1032)

L_PIDFD_WAIT:
    EXPAND PIDFD_WAIT_RAW pidfd_wait_status, pidfd_raw, pidfd
    pidfd_wait_ok = eq pidfd_wait_status, SA_PROCESS_OK
    EXPAND PROCESS_EXIT_STATUS_FROM_RAW exit_status, pidfd_raw
    EXPAND PROCESS_EXIT_STATUS_SIGNAL pidfd_signal, exit_status
    pidfd_signal_ok = eq pidfd_signal, SIG_KILL_PROCESS
    EXPAND PROCESS_CLOSE pidfd_handle_close_status, pidfd
    pidfd_handle_close_ok = eq pidfd_handle_close_status, SA_PROCESS_OK
    EXPAND PROCESS_CLOSE pidfd_close_status, process
    pidfd_close_ok = eq pidfd_close_status, SA_PROCESS_OK
    pidfd_all = and pidfd_wait_ok, pidfd_signal_ok
    pidfd_all = and pidfd_all, pidfd_handle_close_ok
    pidfd_all = and pidfd_all, pidfd_close_ok
    br pidfd_all -> L_PIDFD_INTOD, L_FAIL_PIDFD_WAIT

L_FAIL_PIDFD_WAIT:
    !pidfd_all
    !pidfd_close_ok
    !pidfd_close_status
    !pidfd_handle_close_ok
    !pidfd_handle_close_status
    !pidfd_signal_ok
    !pidfd_signal
    !pidfd_wait_ok
    !pidfd_wait_status
    !pidfd_raw
    !pidfd_kill_ok
    !pidfd_kill_status
    !pidfd_try_all
    !pidfd_try_code
    !pidfd_try_ready
    !pidfd_try_status_ok
    !pidfd_try_status
    !pidfd_code
    !pidfd_ready
    !pidfd_raw_all
    !pidfd_raw_fd_ok
    !pidfd_as_raw_ok
    !pidfd_raw_fd
    !pidfd_as_raw_status
    panic(1033)

L_PIDFD_INTOD:
    argv2 = stack_alloc TRUE_ARGV2_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv2, 0, SLEEP_BIN, SLEEP_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv2, 1, SLEEP_ARG, SLEEP_ARG_LEN
    EXPAND PROCESS_SPAWN_COMMAND_EXT_PIDFD spawn2_status, process2, argv2, 2, dummy, 0, 0, dummy, 0, 0, 0, 0, 0, PIDFD_CREATE
    spawn2_ok = eq spawn2_status, SA_PROCESS_OK
    process2_ok = ne process2, 0
    spawn2_all = and spawn2_ok, process2_ok
    br spawn2_all -> L_PIDFD_INTO, L_FAIL_PIDFD_SPAWN2

L_FAIL_PIDFD_SPAWN2:
    !spawn2_all
    !process2_ok
    !spawn2_status
    !process2
    panic(1034)

L_PIDFD_INTO:
    EXPAND PROCESS_INTO_PIDFD into_status, pidfd2, process2
    into_ok = eq into_status, SA_PROCESS_OK
    br into_ok -> L_PIDFD_INTO_RAW, L_FAIL_PIDFD_INTO

L_FAIL_PIDFD_INTO:
    !into_ok
    !into_status
    panic(1035)

L_PIDFD_INTO_RAW:
    EXPAND PIDFD_AS_RAW_FD pidfd2_as_raw_status, pidfd2_raw_fd, pidfd2
    pidfd2_as_raw_ok = eq pidfd2_as_raw_status, SA_PROCESS_OK
    pidfd2_raw_fd_ok = ne pidfd2_raw_fd, -1
    pidfd2_raw_all = and pidfd2_as_raw_ok, pidfd2_raw_fd_ok
    br pidfd2_raw_all -> L_PIDFD_INTO_OWNED, L_FAIL_PIDFD_INTO_RAW

L_FAIL_PIDFD_INTO_RAW:
    !pidfd2_raw_all
    !pidfd2_raw_fd_ok
    !pidfd2_as_raw_ok
    !pidfd2_raw_fd
    !pidfd2_as_raw_status
    panic(1067)

L_PIDFD_INTO_OWNED:
    EXPAND PIDFD_INTO_OWNED_FD pidfd2_into_owned_status, pidfd2_owned_fd, pidfd2
    pidfd2_into_owned_status_ok = eq pidfd2_into_owned_status, SA_PROCESS_OK
    pidfd2_owned_fd_ok = ne pidfd2_owned_fd, 0
    pidfd2_into_owned_all = and pidfd2_into_owned_status_ok, pidfd2_owned_fd_ok
    br pidfd2_into_owned_all -> L_PIDFD_FROM_OWNED, L_FAIL_PIDFD_INTO_OWNED

L_FAIL_PIDFD_INTO_OWNED:
    !pidfd2_into_owned_all
    !pidfd2_owned_fd_ok
    !pidfd2_into_owned_status_ok
    !pidfd2_owned_fd
    !pidfd2_into_owned_status
    !pidfd2_raw_all
    !pidfd2_raw_fd_ok
    !pidfd2_as_raw_ok
    !pidfd2_raw_fd
    !pidfd2_as_raw_status
    panic(1068)

L_PIDFD_FROM_OWNED:
    EXPAND PIDFD_FROM_OWNED_FD pidfd2_from_owned_status, pidfd2_owned_rebound, pidfd2_owned_fd
    pidfd2_from_owned_status_ok = eq pidfd2_from_owned_status, SA_PROCESS_OK
    pidfd2_from_owned_handle_ok = ne pidfd2_owned_rebound, 0
    pidfd2_from_owned_all = and pidfd2_from_owned_status_ok, pidfd2_from_owned_handle_ok
    br pidfd2_from_owned_all -> L_PIDFD_INTO_RAW_TAKE, L_FAIL_PIDFD_FROM_OWNED

L_FAIL_PIDFD_FROM_OWNED:
    !pidfd2_from_owned_all
    !pidfd2_from_owned_handle_ok
    !pidfd2_from_owned_status_ok
    !pidfd2_owned_rebound
    !pidfd2_from_owned_status
    !pidfd2_into_owned_all
    !pidfd2_raw_all
    !pidfd2_raw_fd_ok
    !pidfd2_as_raw_ok
    !pidfd2_raw_fd
    !pidfd2_as_raw_status
    panic(1069)

L_PIDFD_INTO_RAW_TAKE:
    EXPAND PIDFD_INTO_RAW_FD pidfd2_into_raw_status, pidfd2_raw_taken, pidfd2_owned_rebound
    pidfd2_into_raw_ok = eq pidfd2_into_raw_status, SA_PROCESS_OK
    pidfd2_raw_match = eq pidfd2_raw_taken, pidfd2_raw_fd
    pidfd2_take_all = and pidfd2_into_raw_ok, pidfd2_raw_match
    br pidfd2_take_all -> L_PIDFD_INTO_RAW_REBIND, L_FAIL_PIDFD_INTO_RAW_TAKE

L_FAIL_PIDFD_INTO_RAW_TAKE:
    !pidfd2_take_all
    !pidfd2_raw_match
    !pidfd2_into_raw_ok
    !pidfd2_raw_taken
    !pidfd2_into_raw_status
    !pidfd2_raw_all
    !pidfd2_raw_fd_ok
    !pidfd2_as_raw_ok
    !pidfd2_raw_fd
    !pidfd2_as_raw_status
    !pidfd2_from_owned_all
    !pidfd2_from_owned_handle_ok
    !pidfd2_from_owned_status_ok
    !pidfd2_from_owned_status
    !pidfd2_into_owned_all
    panic(1070)

L_PIDFD_INTO_RAW_REBIND:
    EXPAND PIDFD_FROM_RAW_FD pidfd2_from_raw_status, pidfd2, pidfd2_raw_taken
    pidfd2_from_raw_ok = eq pidfd2_from_raw_status, SA_PROCESS_OK
    pidfd2_rebound_ok = ne pidfd2, 0
    pidfd2_from_all = and pidfd2_from_raw_ok, pidfd2_rebound_ok
    br pidfd2_from_all -> L_PIDFD_INTO_KILL, L_FAIL_PIDFD_INTO_RAW_REBIND

L_FAIL_PIDFD_INTO_RAW_REBIND:
    !pidfd2_from_all
    !pidfd2_rebound_ok
    !pidfd2_from_raw_ok
    !pidfd2
    !pidfd2_from_raw_status
    !pidfd2_take_all
    !pidfd2_raw_match
    !pidfd2_into_raw_ok
    !pidfd2_raw_taken
    !pidfd2_into_raw_status
    !pidfd2_raw_all
    !pidfd2_raw_fd_ok
    !pidfd2_as_raw_ok
    !pidfd2_raw_fd
    !pidfd2_as_raw_status
    !pidfd2_from_owned_all
    !pidfd2_from_owned_handle_ok
    !pidfd2_from_owned_status_ok
    !pidfd2_from_owned_status
    !pidfd2_into_owned_all
    panic(1071)

L_PIDFD_INTO_KILL:
    EXPAND PIDFD_KILL pidfd2_kill_status, pidfd2
    pidfd2_kill_ok = eq pidfd2_kill_status, SA_PROCESS_OK
    br pidfd2_kill_ok -> L_PIDFD_INTO_WAIT, L_FAIL_PIDFD_INTO_KILL

L_FAIL_PIDFD_INTO_KILL:
    !pidfd2_kill_ok
    !pidfd2_kill_status
    panic(1036)

L_PIDFD_INTO_WAIT:
    EXPAND PIDFD_TRY_WAIT_RAW pidfd2_try_status, pidfd2_ready, pidfd2_raw_try, pidfd2
    pidfd2_try_status_ok = eq pidfd2_try_status, SA_PROCESS_OK
    pidfd2_try_ready = eq pidfd2_ready, 0
    pidfd2_try_all = and pidfd2_try_status_ok, pidfd2_try_ready
    br pidfd2_try_all -> L_PIDFD_INTO_WAIT_DONE, L_FAIL_PIDFD_INTO_TRY

L_FAIL_PIDFD_INTO_TRY:
    !pidfd2_try_all
    !pidfd2_try_status_ok
    !pidfd2_try_status
    !pidfd2_ready
    !pidfd2_raw_try
    panic(1037)

L_PIDFD_INTO_WAIT_DONE:
    EXPAND PIDFD_WAIT pidfd2_wait_status, pidfd2_code, pidfd2
    pidfd2_wait_ok = eq pidfd2_wait_status, SA_PROCESS_OK
    pidfd2_code_ok = ne pidfd2_code, 0
    EXPAND PROCESS_CLOSE pidfd2_handle_close_status, pidfd2
    pidfd2_handle_close_ok = eq pidfd2_handle_close_status, SA_PROCESS_OK
    EXPAND PROCESS_CLOSE pidfd2_close_status, process2
    pidfd2_close_ok = eq pidfd2_close_status, SA_PROCESS_OK
    pidfd2_all = and pidfd2_wait_ok, pidfd2_code_ok
    pidfd2_all = and pidfd2_all, pidfd2_handle_close_ok
    pidfd2_all = and pidfd2_all, pidfd2_close_ok
    br pidfd2_all -> L_PASS_PIDFD, L_FAIL_PIDFD_INTO_WAIT_FINAL

L_FAIL_PIDFD_INTO_WAIT_FINAL:
    !pidfd2_all
    !pidfd2_close_ok
    !pidfd2_close_status
    !pidfd2_handle_close_ok
    !pidfd2_handle_close_status
    !pidfd2_code_ok
    !pidfd2_code
    !pidfd2_wait_ok
    !pidfd2_wait_status
    !pidfd2_try_all
    !pidfd2_try_status_ok
    !pidfd2_try_status
    !pidfd2_ready
    !pidfd2_raw_try
    !pidfd2_from_all
    !pidfd2_rebound_ok
    !pidfd2_from_raw_ok
    !pidfd2_from_raw_status
    !pidfd2_take_all
    !pidfd2_raw_match
    !pidfd2_into_raw_ok
    !pidfd2_raw_taken
    !pidfd2_into_raw_status
    !pidfd2_raw_all
    !pidfd2_raw_fd_ok
    !pidfd2_as_raw_ok
    !pidfd2_raw_fd
    !pidfd2_as_raw_status
    !pidfd2_from_owned_all
    !pidfd2_from_owned_handle_ok
    !pidfd2_from_owned_status_ok
    !pidfd2_from_owned_status
    !pidfd2_into_owned_all
    panic(1038)

L_PIDFD_FALLBACK:
    EXPAND PROCESS_KILL fallback_kill_status, process
    fallback_kill_ok = eq fallback_kill_status, SA_PROCESS_OK
    br fallback_kill_ok -> L_PIDFD_FALLBACK_WAIT, L_FAIL_PIDFD_FALLBACK_KILL

L_PIDFD_FALLBACK_WAIT:
    EXPAND PROCESS_WAIT_EXIT_STATUS fallback_wait_status, exit_status, process
    fallback_wait_ok = eq fallback_wait_status, SA_PROCESS_OK
    EXPAND PROCESS_EXIT_STATUS_SIGNAL fallback_signal, exit_status
    fallback_signal_ok = eq fallback_signal, SIG_KILL_PROCESS
    fallback_all = and fallback_wait_ok, fallback_signal_ok
    EXPAND PROCESS_CLOSE fallback_close_status, process
    fallback_close_ok = eq fallback_close_status, SA_PROCESS_OK
    fallback_all = and fallback_all, fallback_close_ok
    br fallback_all -> L_PASS_PIDFD, L_FAIL_PIDFD_FALLBACK

L_FAIL_PIDFD_FALLBACK_KILL:
    !fallback_kill_ok
    !fallback_kill_status
    panic(1039)

L_FAIL_PIDFD_FALLBACK:
    !fallback_all
    !fallback_close_ok
    !fallback_close_status
    !fallback_signal_ok
    !fallback_signal
    !fallback_wait_ok
    !fallback_wait_status
    !fallback_kill_ok
    !fallback_kill_status
    panic(1072)

L_PASS_PIDFD:
    return 0

@test "sa_std process try_wait and kill macros"():
L_ENTRY:
    argv = stack_alloc SH_ARGV3_SIZE
    exit_status = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, SH_BIN, SH_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, SH_FLAG, SH_FLAG_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 2, SLEEP_CMD, SLEEP_CMD_LEN

    EXPAND PROCESS_SPAWN spawn_status, process, argv, 3
    EXPAND PROCESS_STATUS_IS_OK spawn_ok, spawn_status
    process_ok = ne process, 0
    spawn_all_ok = and spawn_ok, process_ok
    br spawn_all_ok -> L_CHILD_ID, L_FAIL_SPAWN

L_FAIL_SPAWN:
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(10207)

L_CHILD_ID:
    EXPAND PROCESS_CHILD_ID child_id_status, child_pid, process
    EXPAND PROCESS_STATUS_IS_OK child_id_ok, child_id_status
    child_pid_ok = ne child_pid, 0
    child_id_all_ok = and child_id_ok, child_pid_ok
    br child_id_all_ok -> L_TRY_WAIT_PENDING, L_FAIL_CHILD_ID

L_FAIL_CHILD_ID:
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    EXPAND PROCESS_KILL cleanup_kill_status_child_id, process
    EXPAND PROCESS_CLOSE cleanup_close_status_child_id, process
    !cleanup_kill_status_child_id
    !cleanup_close_status_child_id
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(10208)

L_TRY_WAIT_PENDING:
    EXPAND PROCESS_TRY_WAIT try_status0, ready0, code0, process
    EXPAND PROCESS_STATUS_IS_OK try_ok0, try_status0
    ready0_ok = eq ready0, 0
    code0_ok = eq code0, 0
    pending_ok0 = and try_ok0, ready0_ok
    pending_ok = and pending_ok0, code0_ok
    br pending_ok -> L_SIGNAL_CHECK, L_FAIL_PENDING

L_FAIL_PENDING:
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    EXPAND PROCESS_KILL cleanup_kill_status_a, process
    EXPAND PROCESS_CLOSE cleanup_close_status_a, process
    !cleanup_kill_status_a
    !cleanup_close_status_a
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(10209)

L_SIGNAL_CHECK:
    EXPAND PROCESS_SEND_SIGNAL signal_check_status, process, SIG_CHECK_PROCESS
    EXPAND PROCESS_STATUS_IS_OK signal_check_ok, signal_check_status
    br signal_check_ok -> L_KILL, L_FAIL_SIGNAL_CHECK

L_FAIL_SIGNAL_CHECK:
    !signal_check_ok
    !signal_check_status
    EXPAND PROCESS_KILL cleanup_kill_status_signal, process
    EXPAND PROCESS_CLOSE cleanup_close_status_signal, process
    !cleanup_kill_status_signal
    !cleanup_close_status_signal
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(10210)

L_KILL:
    EXPAND PROCESS_KILL kill_status, process
    EXPAND PROCESS_STATUS_IS_OK kill_ok, kill_status
    br kill_ok -> L_TRY_WAIT_READY, L_FAIL_KILL

L_FAIL_KILL:
    !kill_ok
    !kill_status
    EXPAND PROCESS_CLOSE cleanup_close_status_b, process
    !cleanup_close_status_b
    !signal_check_ok
    !signal_check_status
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(10211)

L_TRY_WAIT_READY:
    EXPAND PROCESS_TRY_WAIT_EXIT_STATUS try_status1, ready1, exit_status, process
    EXPAND PROCESS_STATUS_IS_OK try_ok1, try_status1
    EXPAND PROCESS_EXIT_STATUS_CODE code1, exit_status
    EXPAND PROCESS_EXIT_STATUS_RAW raw1, exit_status
    EXPAND PROCESS_EXIT_STATUS_SUCCESS exit_success1, exit_status
    EXPAND PROCESS_EXIT_STATUS_SIGNAL signal1, exit_status
    EXPAND PROCESS_EXIT_STATUS_COREDUMPED core1, exit_status
    EXPAND PROCESS_EXIT_STATUS_STOPPED_SIGNAL stopped1, exit_status
    EXPAND PROCESS_EXIT_STATUS_CONTINUED continued1, exit_status
    ready1_ok = eq ready1, 1
    code1_nonzero = ne code1, 0
    raw1_nonzero = ne raw1, 0
    exit_success_false = eq exit_success1, 0
    signal1_ok = eq signal1, 9
    core1_ok = eq core1, 0
    stopped1_ok = eq stopped1, -1
    continued1_ok = eq continued1, 0
    ready_ok0 = and try_ok1, ready1_ok
    ready_ok1 = and ready_ok0, code1_nonzero
    ready_ok2 = and ready_ok1, raw1_nonzero
    ready_ok3 = and ready_ok2, exit_success_false
    ready_ok4 = and ready_ok3, signal1_ok
    ready_ok5 = and ready_ok4, core1_ok
    ready_ok6 = and ready_ok5, stopped1_ok
    ready_ok = and ready_ok6, continued1_ok
    EXPAND PROCESS_CLOSE close_status, process
    EXPAND PROCESS_STATUS_IS_OK close_ok, close_status
    ok0 = and spawn_all_ok, pending_ok
    ok1 = and ok0, child_id_all_ok
    ok1b = and ok1, signal_check_ok
    ok2 = and ok1b, kill_ok
    ok3 = and ok2, ready_ok
    ok = and ok3, close_ok
    !try_status1
    !try_ok1
    !ready1
    !code1
    !raw1
    !exit_success1
    !signal1
    !core1
    !stopped1
    !continued1
    !ready1_ok
    !code1_nonzero
    !raw1_nonzero
    !exit_success_false
    !signal1_ok
    !core1_ok
    !stopped1_ok
    !continued1_ok
    !ready_ok0
    !ready_ok1
    !ready_ok2
    !ready_ok3
    !ready_ok4
    !ready_ok5
    !ready_ok6
    !ready_ok
    !close_status
    !close_ok
    !ok0
    !ok1
    !ok1b
    !ok2
    !ok3
    !kill_ok
    !kill_status
    !signal_check_ok
    !signal_check_status
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    br ok -> L_PASS3, L_FAIL_DONE

L_FAIL_DONE:
    !ok
    panic(10212)

L_PASS3:
    !ok
    return 0

@test "sa_std process abort macro surface"():
L_ENTRY:
    // PROCESS_ABORT is intentionally not invoked here because it terminates
    // the current process; runtime behavior is covered by the C fork smoke.
    abort_macro_available = add 1, 0
    br abort_macro_available -> L_PASS4, L_FAIL4

L_FAIL4:
    !abort_macro_available
    panic(10213)

L_PASS4:
    !abort_macro_available
    return 0

@test "sa_std process command builder macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, TRUE_BIN, TRUE_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, TRUE_ARG, TRUE_ARG_LEN
    dummy_cwd = stack_alloc 1
    dummy_arg0 = stack_alloc 1

    EXPAND PROCESS_COMMAND_BUILDER_NEW cwd_len0, has_cwd0, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0
    zero_has_cwd = eq has_cwd0, 0
    zero_has_arg0 = eq has_arg00, 0
    zero_has_pgroup = eq has_pgroup0, 0
    zero_setsid = eq setsid0, 0
    zero_cfg = and zero_has_cwd, zero_has_arg0
    zero_cfg = and zero_cfg, zero_has_pgroup
    zero_cfg = and zero_cfg, zero_setsid
    br zero_cfg -> L_STATUS, L_FAIL_ZERO

L_FAIL_ZERO:
    !zero_cfg
    !zero_setsid
    !zero_has_pgroup
    !zero_has_arg0
    !zero_has_cwd
    !setsid0
    !has_pgroup0
    !pgroup0
    !has_arg00
    !arg0_len0
    !has_cwd0
    !cwd_len0
    panic(1073)

L_STATUS:
    EXPAND PROCESS_COMMAND_BUILDER_STATUS status, process, argv, 2, dummy_cwd, cwd_len0, has_cwd0, dummy_arg0, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0
    status_ok = eq status, SA_PROCESS_OK
    process_ok = ne process, 0
    spawn_ok = and status_ok, process_ok
    br spawn_ok -> L_WAIT, L_FAIL_STATUS

L_FAIL_STATUS:
    !spawn_ok
    !process_ok
    !status_ok
    !process
    !status
    !zero_cfg
    !zero_setsid
    !zero_has_pgroup
    !zero_has_arg0
    !zero_has_cwd
    !setsid0
    !has_pgroup0
    !pgroup0
    !has_arg00
    !arg0_len0
    !has_cwd0
    !cwd_len0
    panic(1074)

L_WAIT:
    EXPAND PROCESS_WAIT wait_status, code, process
    wait_ok = eq wait_status, SA_PROCESS_OK
    code_ok = eq code, 0
    wait_all = and wait_ok, code_ok
    EXPAND PROCESS_CLOSE close_status, process
    close_ok = eq close_status, SA_PROCESS_OK
    wait_close = and wait_all, close_ok
    br wait_close -> L_ARG0_BUILD, L_FAIL_WAIT

L_FAIL_WAIT:
    !wait_close
    !close_ok
    !close_status
    !wait_all
    !code_ok
    !wait_ok
    !code
    !wait_status
    !spawn_ok
    !process_ok
    !status_ok
    !process
    !status
    !zero_cfg
    !zero_setsid
    !zero_has_pgroup
    !zero_has_arg0
    !zero_has_cwd
    !setsid0
    !has_pgroup0
    !pgroup0
    !has_arg00
    !arg0_len0
    !has_cwd0
    !cwd_len0
    panic(1075)

L_ARG0_BUILD:
    !wait_close
    !close_ok
    !close_status
    !wait_all
    !code_ok
    !wait_ok
    !code
    !wait_status
    !spawn_ok
    !process_ok
    !status_ok
    !process
    !status
    !zero_cfg
    !zero_setsid
    !zero_has_pgroup
    !zero_has_arg0
    !zero_has_cwd
    !setsid0
    !has_pgroup0
    !pgroup0
    !has_arg00
    !arg0_len0
    !has_cwd0
    !cwd_len0

    argv3 = stack_alloc SH_ARGV3_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv3, 0, SH_BIN, SH_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv3, 1, SH_FLAG, SH_FLAG_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv3, 2, ARG0_CMD, ARG0_CMD_LEN
    EXPAND PROCESS_COMMAND_BUILDER_NEW cwd_len1, has_cwd1, arg0_len1, has_arg01, pgroup1, has_pgroup1, setsid1
    EXPAND PROCESS_COMMAND_BUILDER_WITH_ARG0 cwd_len2, has_cwd2, arg0_len2, has_arg02, pgroup2, has_pgroup2, setsid2, cwd_len1, has_cwd1, arg0_len1, has_arg01, pgroup1, has_pgroup1, setsid1, CUSTOM_ARG0_LEN
    has_arg0_ok = eq has_arg02, 1
    arg0_len_ok = eq arg0_len2, CUSTOM_ARG0_LEN
    arg0_cfg = and has_arg0_ok, arg0_len_ok
    br arg0_cfg -> L_ARG0_STATUS, L_FAIL_ARG0_CFG

L_FAIL_ARG0_CFG:
    !arg0_cfg
    !arg0_len_ok
    !has_arg0_ok
    !setsid2
    !has_pgroup2
    !pgroup2
    !has_arg02
    !arg0_len2
    !has_cwd2
    !cwd_len2
    panic(1076)

L_ARG0_STATUS:
    EXPAND PROCESS_COMMAND_BUILDER_STATUS arg0_status, arg0_process, argv3, 3, dummy_cwd, cwd_len2, has_cwd2, CUSTOM_ARG0, arg0_len2, has_arg02, pgroup2, has_pgroup2, setsid2
    arg0_status_ok = eq arg0_status, SA_PROCESS_OK
    arg0_process_ok = ne arg0_process, 0
    arg0_spawn_ok = and arg0_status_ok, arg0_process_ok
    br arg0_spawn_ok -> L_ARG0_WAIT, L_FAIL_ARG0_STATUS

L_FAIL_ARG0_STATUS:
    !arg0_spawn_ok
    !arg0_process_ok
    !arg0_status_ok
    !arg0_process
    !arg0_status
    !arg0_cfg
    !arg0_len_ok
    !has_arg0_ok
    !setsid2
    !has_pgroup2
    !pgroup2
    !has_arg02
    !arg0_len2
    !has_cwd2
    !cwd_len2
    panic(1077)

L_ARG0_WAIT:
    EXPAND PROCESS_WAIT arg0_wait_status, arg0_code, arg0_process
    arg0_wait_ok = eq arg0_wait_status, SA_PROCESS_OK
    arg0_code_ok = eq arg0_code, 0
    arg0_wait_all = and arg0_wait_ok, arg0_code_ok
    EXPAND PROCESS_CLOSE arg0_close_status, arg0_process
    arg0_close_ok = eq arg0_close_status, SA_PROCESS_OK
    arg0_done = and arg0_wait_all, arg0_close_ok
    br arg0_done -> L_PASS, L_FAIL_ARG0_WAIT

L_FAIL_ARG0_WAIT:
    !arg0_done
    !arg0_close_ok
    !arg0_close_status
    !arg0_wait_all
    !arg0_code_ok
    !arg0_wait_ok
    !arg0_code
    !arg0_wait_status
    !arg0_spawn_ok
    !arg0_process_ok
    !arg0_status_ok
    !arg0_process
    !arg0_status
    !arg0_cfg
    !arg0_len_ok
    !has_arg0_ok
    !setsid2
    !has_pgroup2
    !pgroup2
    !has_arg02
    !arg0_len2
    !has_cwd2
    !cwd_len2
    panic(1078)

L_PASS:
    !arg0_done
    !arg0_close_ok
    !arg0_close_status
    !arg0_wait_all
    !arg0_code_ok
    !arg0_wait_ok
    !arg0_code
    !arg0_wait_status
    !arg0_spawn_ok
    !arg0_process_ok
    !arg0_status_ok
    !arg0_process
    !arg0_status
    !arg0_cfg
    !arg0_len_ok
    !has_arg0_ok
    !setsid2
    !has_pgroup2
    !pgroup2
    !has_arg02
    !arg0_len2
    !has_cwd2
    !cwd_len2
    return

@test "sa_std process command builder output macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, TRUE_BIN, TRUE_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, TRUE_ARG, TRUE_ARG_LEN
    dummy_cwd = stack_alloc 1
    dummy_arg0 = stack_alloc 1
    output = stack_alloc ProcessOutput_SIZE

    EXPAND PROCESS_COMMAND_BUILDER_NEW cwd_len0, has_cwd0, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0
    EXPAND PROCESS_COMMAND_BUILDER_OUTPUT capture_status, output, argv, 2, dummy_cwd, cwd_len0, has_cwd0, dummy_arg0, arg0_len0, has_arg00, pgroup0, has_pgroup0, setsid0
    EXPAND PROCESS_STATUS_IS_OK capture_ok, capture_status
    br capture_ok -> L_CAPTURE_OK, L_FAIL_CAPTURE

L_FAIL_CAPTURE:
    !capture_ok
    !capture_status
    !setsid0
    !has_pgroup0
    !pgroup0
    !has_arg00
    !arg0_len0
    !has_cwd0
    !cwd_len0
    panic(1079)

L_CAPTURE_OK:
    EXPAND PROCESS_OUTPUT_STATUS_PTR output_status_ptr, output
    EXPAND PROCESS_EXIT_STATUS_CODE output_code, output_status_ptr
    EXPAND PROCESS_EXIT_STATUS_SUCCESS output_exit_ok, output_status_ptr
    EXPAND PROCESS_OUTPUT_STDOUT_LEN stdout_len, output
    EXPAND PROCESS_OUTPUT_STDERR_LEN stderr_len, output
    EXPAND PROCESS_OUTPUT_FREE free_status, output
    EXPAND PROCESS_STATUS_IS_OK free_ok, free_status

    code_ok = eq output_code, 0
    stdout_ok = eq stdout_len, 0
    stderr_ok = eq stderr_len, 0
    ok = and capture_ok, output_exit_ok
    ok = and ok, code_ok
    ok = and ok, stdout_ok
    ok = and ok, stderr_ok
    ok = and ok, free_ok

    !capture_status
    !capture_ok
    !output_status_ptr
    !output_code
    !output_exit_ok
    !stdout_len
    !stderr_len
    !free_status
    !free_ok
    !code_ok
    !stdout_ok
    !stderr_ok
    !setsid0
    !has_pgroup0
    !pgroup0
    !has_arg00
    !arg0_len0
    !has_cwd0
    !cwd_len0
    br ok -> L_PASS, L_FAIL_CHECK

L_FAIL_CHECK:
    !ok
    panic(1080)

L_PASS:
    !ok
    return



