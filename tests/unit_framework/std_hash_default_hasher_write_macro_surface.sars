@import "sa_std/hash.sars"
@import "sa_std/core/slice.sars"

@test "sa_std hash DefaultHasher write macro"():
L_ENTRY:
    bytes = stack_alloc 5
    empty_bytes = stack_alloc 1
    store bytes+0, 67 as u8
    store bytes+1, 111 as u8
    store bytes+2, 111 as u8
    store bytes+3, 108 as u8
    store bytes+4, 33 as u8

    bytes_slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW bytes_slice, bytes, 5
    EXPAND SLICE_NEW empty_slice, empty_bytes, 0

    write_hasher = stack_alloc DefaultHasher_SIZE
    bytes_hasher = stack_alloc DefaultHasher_SIZE
    str_hasher = stack_alloc DefaultHasher_SIZE
    empty_write_hasher = stack_alloc DefaultHasher_SIZE
    empty_bytes_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW write_hasher
    EXPAND DEFAULT_HASHER_WRITE write_hasher, bytes_slice
    EXPAND DEFAULT_HASHER_FINISH write_hash, write_hasher

    EXPAND DEFAULT_HASHER_NEW bytes_hasher
    EXPAND DEFAULT_HASHER_WRITE_BYTES bytes_hasher, bytes_slice
    EXPAND DEFAULT_HASHER_FINISH bytes_hash, bytes_hasher

    EXPAND DEFAULT_HASHER_NEW str_hasher
    EXPAND DEFAULT_HASHER_WRITE_STR str_hasher, bytes_slice
    EXPAND DEFAULT_HASHER_FINISH str_hash, str_hasher

    EXPAND DEFAULT_HASHER_NEW empty_write_hasher
    EXPAND DEFAULT_HASHER_WRITE empty_write_hasher, empty_slice
    EXPAND DEFAULT_HASHER_FINISH empty_write_hash, empty_write_hasher

    EXPAND DEFAULT_HASHER_NEW empty_bytes_hasher
    EXPAND DEFAULT_HASHER_WRITE_BYTES empty_bytes_hasher, empty_slice
    EXPAND DEFAULT_HASHER_FINISH empty_bytes_hash, empty_bytes_hasher

    write_matches_bytes = eq write_hash, bytes_hash
    write_not_str = ne write_hash, str_hash
    empty_matches = eq empty_write_hash, empty_bytes_hash
    empty_noop = eq empty_write_hash, HASHER_DEFAULT_SEED
    changed = ne write_hash, HASHER_DEFAULT_SEED

    c01 = and write_matches_bytes, write_not_str
    c02 = and c01, empty_matches
    c03 = and c02, empty_noop
    ok = and c03, changed

    !write_hash
    !bytes_hash
    !str_hash
    !empty_write_hash
    !empty_bytes_hash
    !write_matches_bytes
    !write_not_str
    !empty_matches
    !empty_noop
    !changed
    !c01
    !c02
    !c03
    !empty_slice
    !bytes_slice
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10556)

L_PASS:
    !ok
    return 0
