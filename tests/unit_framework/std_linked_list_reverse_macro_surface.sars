@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list reverse"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 1
    EXPAND LINKED_LIST_PUSH_BACK list, 2
    EXPAND LINKED_LIST_PUSH_BACK list, 3
    EXPAND LINKED_LIST_REVERSE list
    EXPAND LINKED_LIST_TRY_FRONT f_ok, f, list
    EXPAND LINKED_LIST_TRY_BACK b_ok, b, list
    EXPAND LINKED_LIST_TRY_GET m_ok, m, list, 1
    EXPAND LINKED_LIST_FREE list

    a = eq f_ok, 1
    b1 = eq f, 3
    c = eq b_ok, 1
    d = eq b, 1
    e = eq m_ok, 1
    f1 = eq m, 2
    ok01 = and a, b1
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok04 = and ok03, e
    ok = and ok04, f1
    !f_ok
    !f
    !b_ok
    !b
    !m_ok
    !m
    !a
    !b1
    !c
    !d
    !e
    !f1
    !ok01
    !ok02
    !ok03
    !ok04
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10881)
