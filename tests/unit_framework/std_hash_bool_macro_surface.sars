@import "sa_std/hash.sars"

@test "sa_std hash bool macro surface"():
L_ENTRY:
    true_hasher = stack_alloc DefaultHasher_SIZE
    false_hasher = stack_alloc DefaultHasher_SIZE
    nonzero_hasher = stack_alloc DefaultHasher_SIZE

    EXPAND DEFAULT_HASHER_NEW true_hasher
    EXPAND DEFAULT_HASHER_WRITE_BOOL true_hasher, 1
    EXPAND DEFAULT_HASHER_FINISH true_manual, true_hasher

    EXPAND DEFAULT_HASHER_NEW false_hasher
    EXPAND DEFAULT_HASHER_WRITE_BOOL false_hasher, 0
    EXPAND DEFAULT_HASHER_FINISH false_manual, false_hasher

    EXPAND DEFAULT_HASHER_NEW nonzero_hasher
    EXPAND DEFAULT_HASHER_WRITE_BOOL nonzero_hasher, 99
    EXPAND DEFAULT_HASHER_FINISH nonzero_manual, nonzero_hasher

    EXPAND HASH_BOOL true_hash, 1
    EXPAND HASH_BOOL false_hash, 0
    EXPAND HASH_BOOL nonzero_hash, 99

    true_matches = eq true_hash, true_manual
    false_matches = eq false_hash, false_manual
    nonzero_matches_true = eq nonzero_hash, true_hash
    nonzero_manual_matches = eq nonzero_manual, true_manual
    true_false_differ = ne true_hash, false_hash
    false_changed = ne false_hash, HASHER_DEFAULT_SEED

    c01 = and true_matches, false_matches
    c02 = and c01, nonzero_matches_true
    c03 = and c02, nonzero_manual_matches
    c04 = and c03, true_false_differ
    ok = and c04, false_changed

    !true_manual
    !false_manual
    !nonzero_manual
    !true_hash
    !false_hash
    !nonzero_hash
    !true_matches
    !false_matches
    !nonzero_matches_true
    !nonzero_manual_matches
    !true_false_differ
    !false_changed
    !c01
    !c02
    !c03
    !c04
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10558)

L_PASS:
    !ok
    return 0
