@import "sa_std/sync/mpsc.sars"

@test "sa_std mpsc endpoint drop short-circuits safely"():
L_ENTRY:
    EXPAND MPSC_CHANNEL tx, rx, 2
    EXPAND MPSC_CHANNEL_IS_DISCONNECTED channel_initial, tx, rx
    EXPAND MPSC_TX_TRY_SEND send_ok, tx, 77
    EXPAND MPSC_TX_DROP tx
    EXPAND MPSC_TX_IS_DISCONNECTED tx_disconnected, tx
    EXPAND MPSC_CHANNEL_IS_DISCONNECTED channel_tx_drop, tx, rx
    EXPAND MPSC_TX_TRY_SEND send_after_drop, tx, 88
    EXPAND MPSC_TX_TRY_SEND_TIMEOUT_NS send_timeout_drop, tx, 99, 0
    EXPAND MPSC_TX_TRY_SEND_TIMEOUT_MS send_timeout_ms_drop, tx, 99, 0
    EXPAND MPSC_RX_TRY_RECV recv_ok, recv_value, rx
    EXPAND MPSC_RX_DROP rx
    EXPAND MPSC_RX_IS_DISCONNECTED rx_disconnected, rx
    EXPAND MPSC_CHANNEL_IS_DISCONNECTED channel_both_drop, tx, rx
    EXPAND MPSC_RX_TRY_RECV recv_after_drop, recv_after_value, rx
    EXPAND MPSC_RX_TRY_RECV_TIMEOUT_NS recv_timeout_drop, recv_timeout_value, rx, 0
    EXPAND MPSC_RX_TRY_RECV_TIMEOUT_MS recv_timeout_ms_drop, recv_timeout_ms_value, rx, 0

    c0 = eq channel_initial, 0
    c1 = eq send_ok, 1
    c2 = eq tx_disconnected, 1
    c3 = eq channel_tx_drop, 0
    c4 = eq send_after_drop, 0
    c5 = eq send_timeout_drop, 0
    c6 = eq send_timeout_ms_drop, 0
    c7 = eq recv_ok, 1
    c8 = eq recv_value, 77
    c9 = eq rx_disconnected, 1
    c10 = eq channel_both_drop, 1
    c11 = eq recv_after_drop, 0
    c12 = eq recv_after_value, 0
    c13 = eq recv_timeout_drop, 0
    c14 = eq recv_timeout_value, 0
    c15 = eq recv_timeout_ms_drop, 0
    c16 = eq recv_timeout_ms_value, 0
    a0 = and c0, c1
    a1 = and a0, c2
    a2 = and a1, c3
    a3 = and a2, c4
    a4 = and a3, c5
    a5 = and a4, c6
    a6 = and a5, c7
    a7 = and a6, c8
    a8 = and a7, c9
    a9 = and a8, c10
    a10 = and a9, c11
    a11 = and a10, c12
    a12 = and a11, c13
    a13 = and a12, c14
    a14 = and a13, c15
    ok = and a14, c16
    !channel_initial
    !send_ok
    !tx_disconnected
    !channel_tx_drop
    !send_after_drop
    !send_timeout_drop
    !send_timeout_ms_drop
    !recv_ok
    !recv_value
    !rx_disconnected
    !channel_both_drop
    !recv_after_drop
    !recv_after_value
    !recv_timeout_drop
    !recv_timeout_value
    !recv_timeout_ms_drop
    !recv_timeout_ms_value
    !c0
    !c1
    !c2
    !c3
    !c4
    !c5
    !c6
    !c7
    !c8
    !c9
    !c10
    !c11
    !c12
    !c13
    !c14
    !c15
    !c16
    !a0
    !a1
    !a2
    !a3
    !a4
    !a5
    !a6
    !a7
    !a8
    !a9
    !a10
    !a11
    !a12
    !a13
    !a14
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(11002)