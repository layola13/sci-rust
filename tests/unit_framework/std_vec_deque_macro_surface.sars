    ok52 = and ok51, ok_contiguous1
    ok53 = and ok52, ok_shrink_to
    ok54 = and ok53, ok_cap_after_try_shrink_to
    ok55 = and ok54, ok_shrink_fit
    ok56 = and ok55, ok_cap_after_try_shrink_fit
    ok57 = and ok56, ok_final_front_len
    ok58 = and ok57, ok_final_back_len
    ok59 = and ok58, ok_push_back_mut
    ok60 = and ok59, ok_push_front_mut
    ok61 = and ok60, ok_insert_mut
    ok62 = and ok61, ok_insert_mut_miss
    ok63 = and ok62, ok_insert_mut_miss_ptr
    ok64 = and ok63, ok_len_after_mut_inserts
    ok65 = and ok64, ok_mut_insert0_flag
    ok66 = and ok65, ok_mut_insert0
    ok67 = and ok66, ok_mut_insert1_flag
