    ok72 = and ok71, ok_mut_insert3
    ok73 = and ok72, ok_mut_insert4_flag
    ok = and ok73, ok_mut_insert4

    !pop0_ok
    !pop0
    !front_slice_len
    !back_slice_len
    !front_slice_first
    !back_slice_first
    !mut_front_len
