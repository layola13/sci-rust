    ok42 = and ok41, ok_after_swap_front2
    ok43 = and ok42, ok_swap_back
    ok44 = and ok43, ok_swap_back_value
    ok45 = and ok44, ok_len_after_swap_back
    ok46 = and ok45, ok_after_swap_back0_flag
    ok47 = and ok46, ok_after_swap_back0
