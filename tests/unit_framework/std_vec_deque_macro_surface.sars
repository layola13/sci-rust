    EXPAND VEC_DEQUE_TRY_INSERT_FROM_SLICE_N_WITHIN_CAPACITY_U64 ok2, deque, 0, src_slice, 0
    EXPAND VEC_DEQUE_LEN len_zero, deque

    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW empty_slice, src_data, 0
    EXPAND VEC_DEQUE_TRY_INSERT_FROM_SLICE_N_WITHIN_CAPACITY_U64 ok3, deque, 0, empty_slice, 3
    EXPAND VEC_DEQUE_LEN len_empty, deque

    EXPAND VEC_DEQUE_TRY_INSERT_FROM_SLICE_N_WITHIN_CAPACITY_U64 ok4, deque, 0, src_slice, 3
    EXPAND VEC_DEQUE_LEN len_after_full, deque

    EXPAND VEC_DEQUE_TRY_INSERT_FROM_SLICE_N_WITHIN_CAPACITY_U64 ok5, deque, 9, src_slice, 1
    EXPAND VEC_DEQUE_LEN len_after_oob, deque

    ok_flag1 = eq ok1, 1
    ok_len1 = eq len1, 8
    ok_g0 = eq g0, 1
    ok_g1 = eq g1, 10
    ok_g2 = eq g2, 20
    ok_g3 = eq g3, 10
    ok_g4 = eq g4, 20
    ok_g5 = eq g5, 2
    ok_g6 = eq g6, 3
    ok_g7 = eq g7, 4
    ok_flag2 = eq ok2, 1
    ok_len_zero = eq len_zero, 8
    ok_flag3 = eq ok3, 1
    ok_len_empty = eq len_empty, 8
    ok_flag4 = eq ok4, 0
    ok_len_after_full = eq len_after_full, 8
    ok_flag5 = eq ok5, 0
    ok_len_after_oob = eq len_after_oob, 8

    ok = and ok_flag1, ok_len1
    ok = and ok, ok_g0
    ok = and ok, ok_g1
    ok = and ok, ok_g2
    ok = and ok, ok_g3
    ok = and ok, ok_g4
    ok = and ok, ok_g5
    ok = and ok, ok_g6
    ok = and ok, ok_g7
    ok = and ok, ok_flag2
    ok = and ok, ok_len_zero
    ok = and ok, ok_flag3
    ok = and ok, ok_len_empty
    ok = and ok, ok_flag4
    ok = and ok, ok_len_after_full
    ok = and ok, ok_flag5
    ok = and ok, ok_len_after_oob

    EXPAND VEC_DEQUE_FREE deque
    !src_data
    !src_slice
    !empty_slice
    !len1
    !len_zero
    !len_empty
    !len_after_full
    !len_after_oob
    !g0
    !g1
    !g2
    !g3
    !g4
    !g5
    !g6
    !g7
    !ok1
    !ok2
    !ok3
    !ok4
    !ok5
    !ok_flag1
    !ok_len1
    !ok_g0
    !ok_g1
    !ok_g2
    !ok_g3
    !ok_g4
    !ok_g5
    !ok_g6
    !ok_g7
    !ok_flag2
    !ok_len_zero
    !ok_flag3
    !ok_len_empty
    !ok_flag4
    !ok_len_after_full
    !ok_flag5
    !ok_len_after_oob
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10354)
L_OK:
    !ok
    return

@test "sa_std vec_deque extend_chars u64 helpers"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 6

    src_data = alloc 24
    store src_data+0, 65 as u64
    store src_data+8, 66 as u64
    store src_data+16, 67 as u64
    src_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW src_slice, src_data, 3

    EXPAND VEC_DEQUE_TRY_EXTEND_CHARS_U64 ok1, deque, src_slice
    EXPAND VEC_DEQUE_LEN len1, deque
    EXPAND VEC_DEQUE_GET g0, deque, 0
    EXPAND VEC_DEQUE_GET g1, deque, 1
    EXPAND VEC_DEQUE_GET g2, deque, 2

    src_data2 = alloc 16
    store src_data2+0, 68 as u64
    store src_data2+8, 69 as u64
    src_slice2 = alloc Slice_SIZE
    EXPAND SLICE_NEW src_slice2, src_data2, 2

    EXPAND VEC_DEQUE_EXTEND_CHARS_U64 ok2, deque, src_slice2
    EXPAND VEC_DEQUE_LEN len2, deque
    EXPAND VEC_DEQUE_GET g3, deque, 3
    EXPAND VEC_DEQUE_GET g4, deque, 4

    EXPAND VEC_DEQUE_TRY_EXTEND_CHARS_U64 ok3, deque, src_slice2
    EXPAND VEC_DEQUE_LEN len3, deque

    ok_flag1 = eq ok1, 1
    ok_len1 = eq len1, 3
    ok_g0 = eq g0, 65
    ok_g1 = eq g1, 66
    ok_g2 = eq g2, 67
    ok_len2 = eq len2, 5
    ok_g3 = eq g3, 68
    ok_g4 = eq g4, 69
    ok_flag3 = eq ok3, 0
    ok_len3 = eq len3, 5

    ok = and ok_flag1, ok_len1
    ok = and ok, ok_g0
    ok = and ok, ok_g1
    ok = and ok, ok_g2
    ok = and ok, ok_len2
    ok = and ok, ok_g3
    ok = and ok, ok_g4
    ok = and ok, ok_flag3
    ok = and ok, ok_len3

    EXPAND VEC_DEQUE_FREE deque
    !src_data
    !src_data2
    !src_slice
    !src_slice2
    !len1
    !len2
    !len3
    !g0
    !g1
    !g2
    !g3
    !g4
    !ok1
    !ok2
    !ok3
    !ok_flag1
    !ok_len1
    !ok_g0
    !ok_g1
    !ok_g2
    !ok_len2
    !ok_g3
    !ok_g4
    !ok_flag3
    !ok_len3
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10355)
L_OK:
    !ok
    return

@test "sa_std vec_deque from/lit constructors"():
L_ENTRY:
    EXPAND VEC_DEQUE_LIT3 dq, 1, 2, 3
    EXPAND VEC_DEQUE_LEN len0, dq
    len0_ok = eq len0, 3
    EXPAND VEC_DEQUE_FRONT front0, dq
    front0_ok = eq front0, 1
    EXPAND VEC_DEQUE_BACK back0, dq
    back0_ok = eq back0, 3

    EXPAND VEC_NEW src
    EXPAND VEC_PUSH_U64 src, 7
    EXPAND VEC_PUSH_U64 src, 8
    EXPAND VEC_DEQUE_FROM_VEC_U64 dq2, src
    EXPAND VEC_DEQUE_LEN len1, dq2
    len1_ok = eq len1, 2
    EXPAND VEC_DEQUE_FRONT front1, dq2
    front1_ok = eq front1, 7
    EXPAND VEC_DEQUE_BACK back1, dq2
    back1_ok = eq back1, 8

    EXPAND VEC_DEQUE_FREE dq
    EXPAND VEC_DEQUE_FREE dq2
    EXPAND VEC_FREE src

    ok = and len0_ok, front0_ok
    ok = and ok, back0_ok
    ok = and ok, len1_ok
    ok = and ok, front1_ok
    ok = and ok, back1_ok

    !len0
    !front0
    !back0
    !len1
    !front1
    !back1
    !len0_ok
    !front0_ok
    !back0_ok
    !len1_ok
    !front1_ok
    !back1_ok
    br ok -> L_VEC_DEQUE_FROM_OK, L_VEC_DEQUE_FROM_FAIL

L_VEC_DEQUE_FROM_FAIL:
    !ok
    panic(10356)

L_VEC_DEQUE_FROM_OK:
    !ok
    return


@test "sa_std vec_deque default alias"():
L_ENTRY:
    EXPAND VEC_DEQUE_DEFAULT deque
    EXPAND VEC_DEQUE_LEN len0, deque
    EXPAND VEC_DEQUE_IS_EMPTY empty0, deque
    EXPAND VEC_DEQUE_FREE deque

    ok_len = eq len0, 0
    ok_empty = eq empty0, 1
    ok = and ok_len, ok_empty

    !len0
    !empty0
    !ok_len
    !ok_empty
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10434)
L_OK:
    !ok
    return
