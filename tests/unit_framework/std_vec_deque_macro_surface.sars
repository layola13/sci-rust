@import "sa_std/collections/vec_deque.sars"
@import "sa_std/vec.sars"

@deque_is_20(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 20
    !value
    return is_match

@deque_is_50(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 50
    !value
    return is_match

@deque_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@test "sa_std vec_deque capacity access macros"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 3
    EXPAND VEC_DEQUE_CAPACITY cap0, deque
    EXPAND VEC_DEQUE_IS_EMPTY empty0, deque
    EXPAND VEC_DEQUE_TRY_WITH_CAPACITY try_new_ok, try_deque, 0
    EXPAND VEC_DEQUE_CAPACITY try_cap, try_deque
    EXPAND VEC_DEQUE_FREE try_deque

    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_TRY_RESERVE reserve_ok, deque, 2
    EXPAND VEC_DEQUE_CAPACITY cap_after_reserve, deque
    EXPAND VEC_DEQUE_TRY_RESERVE_EXACT reserve_exact_ok, deque, 1
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop_ok, popped, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40

    EXPAND VEC_DEQUE_LEN len_after_wrap, deque
    EXPAND VEC_DEQUE_TRY_GET get0_ok, get0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET_U64 get2_ok, get2, deque, 2
    EXPAND VEC_DEQUE_TRY_GET miss_ok, miss_value, deque, 9
    EXPAND VEC_DEQUE_CONTAINS_U64 has_30, deque, 30
    EXPAND VEC_DEQUE_CONTAINS_U64 has_99, deque, 99
    EXPAND VEC_DEQUE_TRY_GET_MUT_PTR get_mut_ok, mut_ptr, deque, 1
    store mut_ptr+0, 33 as u64
    EXPAND VEC_DEQUE_TRY_GET get1_after_mut_ok, get1_after_mut, deque, 1
    EXPAND VEC_DEQUE_SET set_ok, deque, 2, 44
    EXPAND VEC_DEQUE_SET set_miss_ok, deque, 9, 55
    EXPAND VEC_DEQUE_SWAP swap_ok, deque, 0, 2
    EXPAND VEC_DEQUE_SWAP swap_miss_ok, deque, 0, 9
    EXPAND VEC_DEQUE_TRY_FRONT front_ok, front, deque
    EXPAND VEC_DEQUE_TRY_BACK back_ok, back, deque
    EXPAND VEC_DEQUE_TRUNCATE deque, 2
    EXPAND VEC_DEQUE_LEN len_after_truncate, deque
    EXPAND VEC_DEQUE_SHRINK_TO deque, 1
    EXPAND VEC_DEQUE_CAPACITY cap_after_shrink_to, deque
    EXPAND VEC_DEQUE_SHRINK_TO_FIT deque
    EXPAND VEC_DEQUE_CAPACITY cap_after_shrink_fit, deque
    EXPAND VEC_DEQUE_TRY_BACK back_after_truncate_ok, back_after_truncate, deque

    ok_cap0 = eq cap0, 3
    ok_empty0 = eq empty0, 1
    ok_try_new = eq try_new_ok, 1
    ok_try_cap = eq try_cap, 0
    ok_reserve = eq reserve_ok, 1
    ok_cap_after_reserve = eq cap_after_reserve, 8
    ok_reserve_exact = eq reserve_exact_ok, 1
    ok_pop = eq pop_ok, 1
    ok_popped = eq popped, 10
    ok_len_after_wrap = eq len_after_wrap, 3
    ok_get0_flag = eq get0_ok, 1
    ok_get0 = eq get0, 20
    ok_get2_flag = eq get2_ok, 1
    ok_get2 = eq get2, 40
    ok_miss_flag = eq miss_ok, 0
    ok_miss_value = eq miss_value, 0
    ok_has_30 = eq has_30, 1
    ok_has_99 = eq has_99, 0
    ok_get_mut = eq get_mut_ok, 1
    ok_get1_after_mut_flag = eq get1_after_mut_ok, 1
    ok_get1_after_mut = eq get1_after_mut, 33
    ok_set = eq set_ok, 1
    ok_set_miss = eq set_miss_ok, 0
    ok_swap = eq swap_ok, 1
    ok_swap_miss = eq swap_miss_ok, 0
    ok_front_flag = eq front_ok, 1
    ok_front = eq front, 44
    ok_back_flag = eq back_ok, 1
    ok_back = eq back, 20
    ok_len_after_truncate = eq len_after_truncate, 2
    ok_cap_after_shrink_to = eq cap_after_shrink_to, 2
    ok_cap_after_shrink_fit = eq cap_after_shrink_fit, 2
    ok_back_after_truncate_flag = eq back_after_truncate_ok, 1
    ok_back_after_truncate = eq back_after_truncate, 33

    ok01 = and ok_cap0, ok_empty0
    ok02 = and ok01, ok_try_new
    ok03 = and ok02, ok_try_cap
    ok04 = and ok03, ok_reserve
    ok05 = and ok04, ok_cap_after_reserve
    ok06 = and ok05, ok_reserve_exact
    ok07 = and ok06, ok_pop
    ok08 = and ok07, ok_popped
    ok09 = and ok08, ok_len_after_wrap
    ok10 = and ok09, ok_get0_flag
    ok11 = and ok10, ok_get0
    ok12 = and ok11, ok_get2_flag
    ok13 = and ok12, ok_get2
    ok14 = and ok13, ok_miss_flag
    ok15 = and ok14, ok_miss_value
    ok16 = and ok15, ok_has_30
    ok17 = and ok16, ok_has_99
    ok18 = and ok17, ok_get_mut
    ok19 = and ok18, ok_get1_after_mut_flag
    ok20 = and ok19, ok_get1_after_mut
    ok21 = and ok20, ok_set
    ok22 = and ok21, ok_set_miss
    ok23 = and ok22, ok_swap
    ok24 = and ok23, ok_swap_miss
    ok25 = and ok24, ok_front_flag
    ok26 = and ok25, ok_front
    ok27 = and ok26, ok_back_flag
    ok28 = and ok27, ok_back
    ok29 = and ok28, ok_len_after_truncate
    ok30 = and ok29, ok_cap_after_shrink_to
    ok31 = and ok30, ok_cap_after_shrink_fit
    ok32 = and ok31, ok_back_after_truncate_flag
    ok = and ok32, ok_back_after_truncate

    !cap0
    !empty0
    !try_new_ok
    !try_cap
    !reserve_ok
    !cap_after_reserve
    !reserve_exact_ok
    !pop_ok
    !popped
    !len_after_wrap
    !get0_ok
    !get0
    !get2_ok
    !get2
    !miss_ok
    !miss_value
    !has_30
    !has_99
    !get_mut_ok
    !mut_ptr
    !get1_after_mut_ok
    !get1_after_mut
    !set_ok
    !set_miss_ok
    !swap_ok
    !swap_miss_ok
    !front_ok
    !front
    !back_ok
    !back
    !len_after_truncate
    !cap_after_shrink_to
    !cap_after_shrink_fit
    !back_after_truncate_ok
    !back_after_truncate
    !ok_cap0
    !ok_empty0
    !ok_try_new
    !ok_try_cap
    !ok_reserve
    !ok_cap_after_reserve
    !ok_reserve_exact
    !ok_pop
    !ok_popped
    !ok_len_after_wrap
    !ok_get0_flag
    !ok_get0
    !ok_get2_flag
    !ok_get2
    !ok_miss_flag
    !ok_miss_value
    !ok_has_30
    !ok_has_99
    !ok_get_mut
    !ok_get1_after_mut_flag
    !ok_get1_after_mut
    !ok_set
    !ok_set_miss
    !ok_swap
    !ok_swap_miss
    !ok_front_flag
    !ok_front
    !ok_back_flag
    !ok_back
    !ok_len_after_truncate
    !ok_cap_after_shrink_to
    !ok_cap_after_shrink_fit
    !ok_back_after_truncate_flag
    !ok_back_after_truncate
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    EXPAND VEC_DEQUE_FREE deque
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(10341)

L_OK:
    !ok
    return

@test "sa_std vec_deque rust parity macros"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop0_ok, pop0, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50
    EXPAND VEC_DEQUE_AS_SLICES front_slice, back_slice, deque
    EXPAND SLICE_GET_LEN front_slice_len, front_slice
    EXPAND SLICE_GET_LEN back_slice_len, back_slice
    EXPAND SLICE_FIRST_U64 front_slice_first, front_slice
    EXPAND SLICE_FIRST_U64 back_slice_first, back_slice
    EXPAND VEC_DEQUE_AS_MUT_SLICES mut_front_slice, mut_back_slice, deque
    EXPAND SLICE_GET_LEN mut_front_len, mut_front_slice
    EXPAND SLICE_GET_LEN mut_back_len, mut_back_slice
    EXPAND VEC_DEQUE_TRY_FRONT_MUT_PTR front_mut_ok, front_mut_ptr, deque
    store front_mut_ptr+0, 21 as u64
    EXPAND VEC_DEQUE_TRY_BACK_MUT_PTR back_mut_ok, back_mut_ptr, deque
    store back_mut_ptr+0, 55 as u64
    EXPAND VEC_DEQUE_TRY_GET after_front_mut_ok, after_front_mut, deque, 0
    EXPAND VEC_DEQUE_TRY_GET after_back_mut_ok, after_back_mut, deque, 3
    EXPAND VEC_DEQUE_FRONT_MUT_PTR front_alias_ok, front_alias_ptr, deque
    store front_alias_ptr+0, 22 as u64
    EXPAND VEC_DEQUE_BACK_MUT_PTR back_alias_ok, back_alias_ptr, deque
    store back_alias_ptr+0, 56 as u64
    EXPAND VEC_DEQUE_TRY_GET after_front_alias_ok, after_front_alias, deque, 0
    EXPAND VEC_DEQUE_TRY_GET after_back_alias_ok, after_back_alias, deque, 3

    EXPAND VEC_DEQUE_TRY_INSERT insert_ok, deque, 2, 33
    EXPAND VEC_DEQUE_TRY_INSERT insert_miss_ok, deque, 9, 99
    EXPAND VEC_DEQUE_LEN len_after_insert, deque
    EXPAND VEC_DEQUE_TRY_GET inserted_ok, inserted_value, deque, 2
    EXPAND VEC_DEQUE_TRY_GET shifted_ok, shifted_value, deque, 3
    EXPAND VEC_DEQUE_TRY_REMOVE remove_ok, removed_value, deque, 3
    EXPAND VEC_DEQUE_TRY_REMOVE remove_miss_ok, remove_miss_value, deque, 9
    EXPAND VEC_DEQUE_LEN len_after_remove, deque
    EXPAND VEC_DEQUE_TRY_GET after_remove_tail_ok, after_remove_tail, deque, 3

    EXPAND VEC_DEQUE_TRY_SWAP_REMOVE_FRONT swap_front_ok, swap_front_value, deque, 2
    EXPAND VEC_DEQUE_LEN len_after_swap_front, deque
    EXPAND VEC_DEQUE_TRY_GET after_swap_front0_ok, after_swap_front0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET after_swap_front1_ok, after_swap_front1, deque, 1
    EXPAND VEC_DEQUE_TRY_GET after_swap_front2_ok, after_swap_front2, deque, 2
    EXPAND VEC_DEQUE_TRY_SWAP_REMOVE_BACK swap_back_ok, swap_back_value, deque, 0
    EXPAND VEC_DEQUE_LEN len_after_swap_back, deque
    EXPAND VEC_DEQUE_TRY_GET after_swap_back0_ok, after_swap_back0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET after_swap_back1_ok, after_swap_back1, deque, 1

    EXPAND VEC_DEQUE_MAKE_CONTIGUOUS contiguous_slice, deque
    EXPAND SLICE_GET_LEN contiguous_len, contiguous_slice
    EXPAND SLICE_GET_U64 contiguous0, contiguous_slice, 0
    EXPAND SLICE_GET_U64 contiguous1, contiguous_slice, 1
    EXPAND VEC_DEQUE_TRY_SHRINK_TO shrink_to_ok, deque, 1
    EXPAND VEC_DEQUE_CAPACITY cap_after_try_shrink_to, deque
    EXPAND VEC_DEQUE_TRY_SHRINK_TO_FIT shrink_fit_ok, deque
    EXPAND VEC_DEQUE_CAPACITY cap_after_try_shrink_fit, deque
    EXPAND VEC_DEQUE_AS_SLICES final_front_slice, final_back_slice, deque
    EXPAND SLICE_GET_LEN final_front_len, final_front_slice
    EXPAND SLICE_GET_LEN final_back_len, final_back_slice

    EXPAND VEC_DEQUE_PUSH_BACK_MUT_PTR push_back_mut_ptr, deque, 70
    store push_back_mut_ptr+0, 71 as u64
    EXPAND VEC_DEQUE_PUSH_FRONT_MUT_PTR push_front_mut_ptr, deque, 40
    store push_front_mut_ptr+0, 41 as u64
    EXPAND VEC_DEQUE_TRY_INSERT_MUT_PTR insert_mut_ok, insert_mut_ptr, deque, 2, 60
    store insert_mut_ptr+0, 61 as u64
    EXPAND VEC_DEQUE_TRY_INSERT_MUT_PTR insert_mut_miss_ok, insert_mut_miss_ptr, deque, 99, 99
    insert_mut_miss_null = 0 as ptr
    EXPAND VEC_DEQUE_LEN len_after_mut_inserts, deque
    EXPAND VEC_DEQUE_TRY_GET mut_insert0_ok, mut_insert0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET mut_insert1_ok, mut_insert1, deque, 1
    EXPAND VEC_DEQUE_TRY_GET mut_insert2_ok, mut_insert2, deque, 2
    EXPAND VEC_DEQUE_TRY_GET mut_insert3_ok, mut_insert3, deque, 3
    EXPAND VEC_DEQUE_TRY_GET mut_insert4_ok, mut_insert4, deque, 4

    ok_pop0 = eq pop0_ok, 1
    ok_pop0_value = eq pop0, 10
    ok_front_slice_len = eq front_slice_len, 3
    ok_back_slice_len = eq back_slice_len, 1
    ok_front_slice_first = eq front_slice_first, 20
    ok_back_slice_first = eq back_slice_first, 50
    ok_mut_front_len = eq mut_front_len, 3
    ok_mut_back_len = eq mut_back_len, 1
    ok_front_mut = eq front_mut_ok, 1
    ok_back_mut = eq back_mut_ok, 1
    ok_after_front_mut_flag = eq after_front_mut_ok, 1
    ok_after_front_mut = eq after_front_mut, 21
    ok_after_back_mut_flag = eq after_back_mut_ok, 1
    ok_after_back_mut = eq after_back_mut, 55
    ok_front_alias = eq front_alias_ok, 1
    ok_back_alias = eq back_alias_ok, 1
    ok_after_front_alias_flag = eq after_front_alias_ok, 1
    ok_after_front_alias = eq after_front_alias, 22
    ok_after_back_alias_flag = eq after_back_alias_ok, 1
    ok_after_back_alias = eq after_back_alias, 56
    ok_insert = eq insert_ok, 1
    ok_insert_miss = eq insert_miss_ok, 0
    ok_len_after_insert = eq len_after_insert, 5
    ok_inserted_flag = eq inserted_ok, 1
    ok_inserted = eq inserted_value, 33
    ok_shifted_flag = eq shifted_ok, 1
    ok_shifted = eq shifted_value, 40
    ok_remove = eq remove_ok, 1
    ok_removed = eq removed_value, 40
    ok_remove_miss_flag = eq remove_miss_ok, 0
    ok_remove_miss_value = eq remove_miss_value, 0
    ok_len_after_remove = eq len_after_remove, 4
    ok_after_remove_tail_flag = eq after_remove_tail_ok, 1
    ok_after_remove_tail = eq after_remove_tail, 56
    ok_swap_front = eq swap_front_ok, 1
    ok_swap_front_value = eq swap_front_value, 33
    ok_len_after_swap_front = eq len_after_swap_front, 3
    ok_after_swap_front0_flag = eq after_swap_front0_ok, 1
    ok_after_swap_front0 = eq after_swap_front0, 30
    ok_after_swap_front1_flag = eq after_swap_front1_ok, 1
    ok_after_swap_front1 = eq after_swap_front1, 22
    ok_after_swap_front2_flag = eq after_swap_front2_ok, 1
    ok_after_swap_front2 = eq after_swap_front2, 56
    ok_swap_back = eq swap_back_ok, 1
    ok_swap_back_value = eq swap_back_value, 30
    ok_len_after_swap_back = eq len_after_swap_back, 2
    ok_after_swap_back0_flag = eq after_swap_back0_ok, 1
    ok_after_swap_back0 = eq after_swap_back0, 56
    ok_after_swap_back1_flag = eq after_swap_back1_ok, 1
    ok_after_swap_back1 = eq after_swap_back1, 22
    ok_contiguous_len = eq contiguous_len, 2
    ok_contiguous0 = eq contiguous0, 56
    ok_contiguous1 = eq contiguous1, 22
    ok_shrink_to = eq shrink_to_ok, 1
    ok_cap_after_try_shrink_to = eq cap_after_try_shrink_to, 2
    ok_shrink_fit = eq shrink_fit_ok, 1
    ok_cap_after_try_shrink_fit = eq cap_after_try_shrink_fit, 2
    ok_final_front_len = eq final_front_len, 2
    ok_final_back_len = eq final_back_len, 0
    ok_push_back_mut = ne push_back_mut_ptr, insert_mut_miss_null
    ok_push_front_mut = ne push_front_mut_ptr, insert_mut_miss_null
    ok_insert_mut = eq insert_mut_ok, 1
    ok_insert_mut_miss = eq insert_mut_miss_ok, 0
    ok_insert_mut_miss_ptr = eq insert_mut_miss_ptr, insert_mut_miss_null
    ok_len_after_mut_inserts = eq len_after_mut_inserts, 5
    ok_mut_insert0_flag = eq mut_insert0_ok, 1
    ok_mut_insert0 = eq mut_insert0, 41
    ok_mut_insert1_flag = eq mut_insert1_ok, 1
    ok_mut_insert1 = eq mut_insert1, 56
    ok_mut_insert2_flag = eq mut_insert2_ok, 1
    ok_mut_insert2 = eq mut_insert2, 61
    ok_mut_insert3_flag = eq mut_insert3_ok, 1
    ok_mut_insert3 = eq mut_insert3, 22
    ok_mut_insert4_flag = eq mut_insert4_ok, 1
    ok_mut_insert4 = eq mut_insert4, 71

    ok01 = and ok_pop0, ok_pop0_value
    ok02 = and ok01, ok_front_slice_len
    ok03 = and ok02, ok_back_slice_len
    ok04 = and ok03, ok_front_slice_first
    ok05 = and ok04, ok_back_slice_first
    ok06 = and ok05, ok_mut_front_len
    ok07 = and ok06, ok_mut_back_len
    ok08 = and ok07, ok_front_mut
    ok09 = and ok08, ok_back_mut
    ok10 = and ok09, ok_after_front_mut_flag
    ok11 = and ok10, ok_after_front_mut
    ok12 = and ok11, ok_after_back_mut_flag
    ok13 = and ok12, ok_after_back_mut
    ok14 = and ok13, ok_front_alias
    ok15 = and ok14, ok_back_alias
    ok16 = and ok15, ok_after_front_alias_flag
    ok17 = and ok16, ok_after_front_alias
    ok18 = and ok17, ok_after_back_alias_flag
    ok19 = and ok18, ok_after_back_alias
    ok20 = and ok19, ok_insert
    ok21 = and ok20, ok_insert_miss
    ok22 = and ok21, ok_len_after_insert
    ok23 = and ok22, ok_inserted_flag
    ok24 = and ok23, ok_inserted
    ok25 = and ok24, ok_shifted_flag
    ok26 = and ok25, ok_shifted
    ok27 = and ok26, ok_remove
    ok28 = and ok27, ok_removed
    ok29 = and ok28, ok_remove_miss_flag
    ok30 = and ok29, ok_remove_miss_value
    ok31 = and ok30, ok_len_after_remove
    ok32 = and ok31, ok_after_remove_tail_flag
    ok33 = and ok32, ok_after_remove_tail
    ok34 = and ok33, ok_swap_front
    ok35 = and ok34, ok_swap_front_value
    ok36 = and ok35, ok_len_after_swap_front
    ok37 = and ok36, ok_after_swap_front0_flag
    ok38 = and ok37, ok_after_swap_front0
    ok39 = and ok38, ok_after_swap_front1_flag
    ok40 = and ok39, ok_after_swap_front1
