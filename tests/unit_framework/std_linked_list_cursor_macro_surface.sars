@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list cursor walk"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW list
    EXPAND LINKED_LIST_PUSH_BACK list, 10
    EXPAND LINKED_LIST_PUSH_BACK list, 20
    EXPAND LINKED_LIST_PUSH_BACK list, 30
    EXPAND LINKED_LIST_CURSOR_FRONT c_ok, node, list
    EXPAND LINKED_LIST_CURSOR_VALUE v0, node
    EXPAND LINKED_LIST_CURSOR_NEXT n1_ok, node1, node
    EXPAND LINKED_LIST_CURSOR_VALUE v1, node1
    EXPAND LINKED_LIST_CURSOR_SET_VALUE node1, 21
    EXPAND LINKED_LIST_CURSOR_VALUE v1b, node1
    EXPAND LINKED_LIST_CURSOR_BACK b_ok, back, list
    EXPAND LINKED_LIST_CURSOR_VALUE vb, back
    EXPAND LINKED_LIST_CURSOR_PREV p_ok, prev, back
    EXPAND LINKED_LIST_CURSOR_VALUE vp, prev
    EXPAND LINKED_LIST_FREE list

    a = eq c_ok, 1
    b = eq v0, 10
    c = eq n1_ok, 1
    d = eq v1, 20
    e = eq v1b, 21
    f = eq b_ok, 1
    g = eq vb, 30
    h = eq p_ok, 1
    i = eq vp, 21
    ok01 = and a, b
    ok02 = and ok01, c
    ok03 = and ok02, d
    ok04 = and ok03, e
    ok05 = and ok04, f
    ok06 = and ok05, g
    ok07 = and ok06, h
    ok = and ok07, i
    !c_ok
    !v0
    !n1_ok
    !v1
    !v1b
    !b_ok
    !vb
    !p_ok
    !vp
    !a
    !b
    !c
    !d
    !e
    !f
    !g
    !h
    !i
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10887)
