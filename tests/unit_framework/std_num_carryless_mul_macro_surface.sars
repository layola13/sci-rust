@import "sa_std/num.sars"

[MACRO] TEST_CARRYLESS_MUL_EQ %out_acc, %prev_acc, %value, %expected
    __test_carryless_mul_eq_%out_acc = eq %value, %expected
    %out_acc = and %prev_acc, __test_carryless_mul_eq_%out_acc
    !__test_carryless_mul_eq_%out_acc
[END_MACRO]

@test "sa_std unsigned primitive carryless_mul macro surface"():
L_ENTRY:
    EXPAND NUM_U8_CARRYLESS_MUL u8_value, 11, 13
    EXPAND NUM_U16_CARRYLESS_MUL u16_value, 11, 13
    EXPAND NUM_U32_CARRYLESS_MUL u32_value, 11, 13
    EXPAND NUM_U64_CARRYLESS_MUL u64_value, 11, 13
    EXPAND NUM_USIZE_CARRYLESS_MUL usize_value, 11, 13

    EXPAND NUM_U8_CARRYLESS_MUL u8_truncated, 128, 2
    EXPAND NUM_U16_CARRYLESS_MUL u16_truncated, 32768, 2
    EXPAND NUM_U32_CARRYLESS_MUL u32_truncated, 2147483648, 2
    EXPAND NUM_U64_CARRYLESS_MUL u64_truncated, NUM_I64_MIN, 2
    EXPAND NUM_USIZE_CARRYLESS_MUL usize_truncated, NUM_I64_MIN, 2

    EXPAND NUM_U64_CARRYLESS_MUL zero_value, 12345, 0
    EXPAND NUM_U64_CARRYLESS_MUL identity_value, 12345, 1

    acc_00 = eq 0, 0
    EXPAND TEST_CARRYLESS_MUL_EQ acc_01, acc_00, u8_value, 127
    EXPAND TEST_CARRYLESS_MUL_EQ acc_02, acc_01, u16_value, 127
    EXPAND TEST_CARRYLESS_MUL_EQ acc_03, acc_02, u32_value, 127
    EXPAND TEST_CARRYLESS_MUL_EQ acc_04, acc_03, u64_value, 127
    EXPAND TEST_CARRYLESS_MUL_EQ acc_05, acc_04, usize_value, 127
    EXPAND TEST_CARRYLESS_MUL_EQ acc_06, acc_05, u8_truncated, 0
    EXPAND TEST_CARRYLESS_MUL_EQ acc_07, acc_06, u16_truncated, 0
    EXPAND TEST_CARRYLESS_MUL_EQ acc_08, acc_07, u32_truncated, 0
    EXPAND TEST_CARRYLESS_MUL_EQ acc_09, acc_08, u64_truncated, 0
    EXPAND TEST_CARRYLESS_MUL_EQ acc_10, acc_09, usize_truncated, 0
    EXPAND TEST_CARRYLESS_MUL_EQ acc_11, acc_10, zero_value, 0
    EXPAND TEST_CARRYLESS_MUL_EQ acc_12, acc_11, identity_value, 12345
    br acc_12 -> L_PASS, L_FAIL

L_FAIL:
    !acc_12
    panic(10647)

L_PASS:
    !acc_12
    return 0
