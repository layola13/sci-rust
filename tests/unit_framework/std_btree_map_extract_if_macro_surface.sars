@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/collections/btree_map.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"
@const KEY_DELTA = utf8:"delta"

@mutate_and_extract_len_five(&key: ptr, value_ptr: ptr) -> u64:
L_ENTRY:
    value = load value_ptr+0 as u64
    next_value = add value, 1
    store value_ptr+0, next_value as u64
    key_len = load key+Slice_len as u64
    take = eq key_len, 5
    !key_len
    !next_value
    !value
    !value_ptr
    !key
    return take

@extract_map_never(&key: ptr, value_ptr: ptr) -> u64:
L_ENTRY:
    !value_ptr
    !key
    return 0

@test "sa_std btree_map eager extract_if"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    delta = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7
    EXPAND SLICE_NEW delta, &KEY_DELTA, 5

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, delta, 40
    EXPAND BTREE_MAP_INSERT map, charlie, 30
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, bravo, 20
    EXPAND BTREE_MAP_EXTRACT_IF remain_len, extracted, map, @mutate_and_extract_len_five

    EXPAND BTREE_MAP_LEN source_len, map
    EXPAND BTREE_MAP_LEN extracted_len, extracted
    EXPAND BTREE_MAP_CONTAINS_KEY source_alpha, map, alpha
    EXPAND BTREE_MAP_CONTAINS_KEY source_charlie, map, charlie
    EXPAND BTREE_MAP_GET source_charlie_value, map, charlie
    EXPAND BTREE_MAP_GET extracted_alpha_value, extracted, alpha
    EXPAND BTREE_MAP_GET extracted_bravo_value, extracted, bravo
    EXPAND BTREE_MAP_GET extracted_delta_value, extracted, delta
    EXPAND BTREE_MAP_FIRST_KEY_VALUE first_ok, first_key, first_value, extracted
    EXPAND BTREE_MAP_LAST_KEY_VALUE last_ok, last_key, last_value, extracted
    first_key_ptr = load first_key+Slice_ptr as ptr
    last_key_ptr = load last_key+Slice_ptr as ptr
    alpha_ptr = load alpha+Slice_ptr as ptr
    delta_ptr = load delta+Slice_ptr as ptr

    EXPAND BTREE_MAP_EXTRACT_IF never_remain_len, never_extracted, map, @extract_map_never
    EXPAND BTREE_MAP_LEN never_extracted_len, never_extracted
    EXPAND BTREE_MAP_GET source_charlie_after_never, map, charlie

    EXPAND BTREE_MAP_NEW empty_map
    EXPAND BTREE_MAP_EXTRACT_IF empty_remain_len, empty_extracted, empty_map, @mutate_and_extract_len_five
    EXPAND BTREE_MAP_LEN empty_extracted_len, empty_extracted

    ok_remain_len = eq remain_len, 1
    ok_source_len = eq source_len, 1
    ok_extracted_len = eq extracted_len, 3
    ok_source_alpha = eq source_alpha, 0
    ok_source_charlie = eq source_charlie, 1
    ok_source_charlie_value = eq source_charlie_value, 31
    ok_extracted_alpha_value = eq extracted_alpha_value, 11
    ok_extracted_bravo_value = eq extracted_bravo_value, 21
    ok_extracted_delta_value = eq extracted_delta_value, 41
    ok_first = eq first_ok, 1
    ok_first_key = eq first_key_ptr, alpha_ptr
    ok_first_value = eq first_value, 11
    ok_last = eq last_ok, 1
    ok_last_key = eq last_key_ptr, delta_ptr
    ok_last_value = eq last_value, 41
    ok_never_remain = eq never_remain_len, 1
    ok_never_extracted = eq never_extracted_len, 0
    ok_never_source = eq source_charlie_after_never, 31
    ok_empty_remain = eq empty_remain_len, 0
    ok_empty_extracted = eq empty_extracted_len, 0

    ok01 = and ok_remain_len, ok_source_len
    ok02 = and ok01, ok_extracted_len
    ok03 = and ok02, ok_source_alpha
    ok04 = and ok03, ok_source_charlie
    ok05 = and ok04, ok_source_charlie_value
    ok06 = and ok05, ok_extracted_alpha_value
    ok07 = and ok06, ok_extracted_bravo_value
    ok08 = and ok07, ok_extracted_delta_value
    ok09 = and ok08, ok_first
    ok10 = and ok09, ok_first_key
    ok11 = and ok10, ok_first_value
    ok12 = and ok11, ok_last
    ok13 = and ok12, ok_last_key
    ok14 = and ok13, ok_last_value
    ok15 = and ok14, ok_never_remain
    ok16 = and ok15, ok_never_extracted
    ok17 = and ok16, ok_never_source
    ok18 = and ok17, ok_empty_remain
    ok = and ok18, ok_empty_extracted

    !remain_len
    !source_len
    !extracted_len
    !source_alpha
    !source_charlie
    !source_charlie_value
    !extracted_alpha_value
    !extracted_bravo_value
    !extracted_delta_value
    !first_ok
    !first_value
    !last_ok
    !last_value
    !first_key_ptr
    !last_key_ptr
    !alpha_ptr
    !delta_ptr
    !never_remain_len
    !never_extracted_len
    !source_charlie_after_never
    !empty_remain_len
    !empty_extracted_len
    !ok_remain_len
    !ok_source_len
    !ok_extracted_len
    !ok_source_alpha
    !ok_source_charlie
    !ok_source_charlie_value
    !ok_extracted_alpha_value
    !ok_extracted_bravo_value
    !ok_extracted_delta_value
    !ok_first
    !ok_first_key
    !ok_first_value
    !ok_last
    !ok_last_key
    !ok_last_value
    !ok_never_remain
    !ok_never_extracted
    !ok_never_source
    !ok_empty_remain
    !ok_empty_extracted
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !delta
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_MAP_FREE empty_extracted
    EXPAND BTREE_MAP_FREE empty_map
    EXPAND BTREE_MAP_FREE never_extracted
    EXPAND BTREE_MAP_FREE extracted
    EXPAND BTREE_MAP_FREE map
    return 0

L_FAIL:
    panic(10818)
