@import "sa_std/vec.sars"

@vec_into_iter_reduce_tens(acc: u64, value: u64) -> u64:
L_ENTRY:
    scaled = mul value, 10
    out = add acc, scaled
    !scaled
    return out

@vec_into_iter_try_reduce_lt_four(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 4
    br keep -> L_VEC_TRY_REDUCE_KEEP, L_VEC_TRY_REDUCE_STOP
L_VEC_TRY_REDUCE_KEEP:
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep
L_VEC_TRY_REDUCE_STOP:
    !out_next
    !value
    !acc
    return keep

@vec_into_iter_try_reduce_lt_ten(acc: u64, value: u64, &out_next: ptr) -> u64:
L_ENTRY:
    keep = ult value, 10
    scaled = mul value, 10
    next = add acc, scaled
    store out_next+0, next as u64
    !next
    !scaled
    !out_next
    !value
    !acc
    return keep

@test "sa_std vec into_iter aggregate macro surface"():
L_ENTRY:
    EXPAND VEC_NEW sum_vec
    EXPAND VEC_PUSH_U64 sum_vec, 2
    EXPAND VEC_PUSH_U64 sum_vec, 3
    EXPAND VEC_PUSH_U64 sum_vec, 4
    EXPAND VEC_INTO_ITER_U64 sum_iter, sum_backing, sum_vec
    EXPAND VEC_INTO_ITER_SUM_U64 sum_value, sum_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 sum_empty, sum_iter

    EXPAND VEC_NEW product_vec
    EXPAND VEC_PUSH_U64 product_vec, 2
    EXPAND VEC_PUSH_U64 product_vec, 3
    EXPAND VEC_PUSH_U64 product_vec, 4
    EXPAND VEC_INTO_ITER_U64 product_iter, product_backing, product_vec
    EXPAND VEC_INTO_ITER_PRODUCT_U64 product_value, product_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 product_empty, product_iter

    EXPAND VEC_NEW min_vec
    EXPAND VEC_PUSH_U64 min_vec, 8
    EXPAND VEC_PUSH_U64 min_vec, 3
    EXPAND VEC_PUSH_U64 min_vec, 5
    EXPAND VEC_INTO_ITER_U64 min_iter, min_backing, min_vec
    EXPAND VEC_INTO_ITER_MIN_U64 min_ok, min_value, min_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 min_empty, min_iter

    EXPAND VEC_NEW max_vec
    EXPAND VEC_PUSH_U64 max_vec, 8
    EXPAND VEC_PUSH_U64 max_vec, 3
    EXPAND VEC_PUSH_U64 max_vec, 5
    EXPAND VEC_INTO_ITER_U64 max_iter, max_backing, max_vec
    EXPAND VEC_INTO_ITER_MAX_U64 max_ok, max_value, max_iter
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 max_empty, max_iter

    EXPAND VEC_NEW reduce_vec
    EXPAND VEC_PUSH_U64 reduce_vec, 1
    EXPAND VEC_PUSH_U64 reduce_vec, 2
    EXPAND VEC_PUSH_U64 reduce_vec, 3
    EXPAND VEC_INTO_ITER_U64 reduce_iter, reduce_backing, reduce_vec
    EXPAND VEC_INTO_ITER_REDUCE_U64 reduce_ok, reduce_value, reduce_iter, @vec_into_iter_reduce_tens
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 reduce_empty, reduce_iter

    EXPAND VEC_INTO_ITER_DEFAULT_U64 empty_iter, empty_backing
    EXPAND VEC_INTO_ITER_MIN_U64 empty_min_ok, empty_min_value, empty_iter
    EXPAND VEC_INTO_ITER_REDUCE_U64 empty_reduce_ok, empty_reduce_value, empty_iter, @vec_into_iter_reduce_tens
    EXPAND VEC_INTO_ITER_SUM_U64 empty_sum, empty_iter
    EXPAND VEC_INTO_ITER_PRODUCT_U64 empty_product, empty_iter

    EXPAND VEC_NEW try_stop_vec
    EXPAND VEC_PUSH_U64 try_stop_vec, 1
    EXPAND VEC_PUSH_U64 try_stop_vec, 2
    EXPAND VEC_PUSH_U64 try_stop_vec, 4
    EXPAND VEC_PUSH_U64 try_stop_vec, 5
    EXPAND VEC_INTO_ITER_U64 try_stop_iter, try_stop_backing, try_stop_vec
    EXPAND VEC_INTO_ITER_TRY_REDUCE_U64 try_stop_ok, try_stop_has, try_stop_value, try_stop_iter, @vec_into_iter_try_reduce_lt_four
    EXPAND VEC_INTO_ITER_EXACT_SIZE_LEN_U64 try_stop_remaining, try_stop_iter
    EXPAND VEC_INTO_ITER_NEXT_U64 try_stop_next_ok, try_stop_next, try_stop_iter

    EXPAND VEC_NEW try_all_vec
    EXPAND VEC_PUSH_U64 try_all_vec, 1
    EXPAND VEC_PUSH_U64 try_all_vec, 2
    EXPAND VEC_PUSH_U64 try_all_vec, 3
    EXPAND VEC_INTO_ITER_U64 try_all_iter, try_all_backing, try_all_vec
    EXPAND VEC_INTO_ITER_TRY_REDUCE_U64 try_all_ok, try_all_has, try_all_value, try_all_iter, @vec_into_iter_try_reduce_lt_ten
    EXPAND VEC_INTO_ITER_EXACT_SIZE_IS_EMPTY_U64 try_all_empty, try_all_iter

    EXPAND VEC_FREE sum_backing
    EXPAND VEC_FREE product_backing
    EXPAND VEC_FREE min_backing
    EXPAND VEC_FREE max_backing
    EXPAND VEC_FREE reduce_backing
    EXPAND VEC_FREE empty_backing
    EXPAND VEC_FREE try_stop_backing
    EXPAND VEC_FREE try_all_backing

    ok_sum_value = eq sum_value, 9
    ok_sum_empty = eq sum_empty, 1
    ok_product_value = eq product_value, 24
    ok_product_empty = eq product_empty, 1
    ok_min_flag = eq min_ok, 1
    ok_min_value = eq min_value, 3
    ok_min_empty = eq min_empty, 1
    ok_max_flag = eq max_ok, 1
    ok_max_value = eq max_value, 8
    ok_max_empty = eq max_empty, 1
    ok_reduce_flag = eq reduce_ok, 1
    ok_reduce_value = eq reduce_value, 51
    ok_reduce_empty = eq reduce_empty, 1
    ok_empty_min_flag = eq empty_min_ok, 0
    ok_empty_min_value = eq empty_min_value, 0
    ok_empty_reduce_flag = eq empty_reduce_ok, 0
    ok_empty_reduce_value = eq empty_reduce_value, 0
    ok_empty_sum = eq empty_sum, 0
    ok_empty_product = eq empty_product, 1
    ok_try_stop_flag = eq try_stop_ok, 0
    ok_try_stop_has = eq try_stop_has, 0
    ok_try_stop_value = eq try_stop_value, 21
    ok_try_stop_remaining = eq try_stop_remaining, 1
    ok_try_stop_next_flag = eq try_stop_next_ok, 1
    ok_try_stop_next = eq try_stop_next, 5
    ok_try_all_flag = eq try_all_ok, 1
    ok_try_all_has = eq try_all_has, 1
    ok_try_all_value = eq try_all_value, 51
    ok_try_all_empty = eq try_all_empty, 1

    ok = and ok_sum_value, ok_sum_empty
    ok = and ok, ok_product_value
    ok = and ok, ok_product_empty
    ok = and ok, ok_min_flag
    ok = and ok, ok_min_value
    ok = and ok, ok_min_empty
    ok = and ok, ok_max_flag
    ok = and ok, ok_max_value
    ok = and ok, ok_max_empty
    ok = and ok, ok_reduce_flag
    ok = and ok, ok_reduce_value
    ok = and ok, ok_reduce_empty
    ok = and ok, ok_empty_min_flag
    ok = and ok, ok_empty_min_value
    ok = and ok, ok_empty_reduce_flag
    ok = and ok, ok_empty_reduce_value
    ok = and ok, ok_empty_sum
    ok = and ok, ok_empty_product
    ok = and ok, ok_try_stop_flag
    ok = and ok, ok_try_stop_has
    ok = and ok, ok_try_stop_value
    ok = and ok, ok_try_stop_remaining
    ok = and ok, ok_try_stop_next_flag
    ok = and ok, ok_try_stop_next
    ok = and ok, ok_try_all_flag
    ok = and ok, ok_try_all_has
    ok = and ok, ok_try_all_value
    ok = and ok, ok_try_all_empty

    !sum_value
    !sum_empty
    !product_value
    !product_empty
    !min_ok
    !min_value
    !min_empty
    !max_ok
    !max_value
    !max_empty
    !reduce_ok
    !reduce_value
    !reduce_empty
    !empty_min_ok
    !empty_min_value
    !empty_reduce_ok
    !empty_reduce_value
    !empty_sum
    !empty_product
    !try_stop_ok
    !try_stop_has
    !try_stop_value
    !try_stop_remaining
    !try_stop_next_ok
    !try_stop_next
    !try_all_ok
    !try_all_has
    !try_all_value
    !try_all_empty
    !ok_sum_value
    !ok_sum_empty
    !ok_product_value
    !ok_product_empty
    !ok_min_flag
    !ok_min_value
    !ok_min_empty
    !ok_max_flag
    !ok_max_value
    !ok_max_empty
    !ok_reduce_flag
    !ok_reduce_value
    !ok_reduce_empty
    !ok_empty_min_flag
    !ok_empty_min_value
    !ok_empty_reduce_flag
    !ok_empty_reduce_value
    !ok_empty_sum
    !ok_empty_product
    !ok_try_stop_flag
    !ok_try_stop_has
    !ok_try_stop_value
    !ok_try_stop_remaining
    !ok_try_stop_next_flag
    !ok_try_stop_next
    !ok_try_all_flag
    !ok_try_all_has
    !ok_try_all_value
    !ok_try_all_empty
    !sum_iter
    !product_iter
    !min_iter
    !max_iter
    !reduce_iter
    !empty_iter
    !try_stop_iter
    !try_all_iter
    br ok -> L_VEC_INTO_ITER_AGGREGATE_OK, L_VEC_INTO_ITER_AGGREGATE_FAIL

L_VEC_INTO_ITER_AGGREGATE_FAIL:
    !ok
    panic(10714)

L_VEC_INTO_ITER_AGGREGATE_OK:
    !ok
    return
