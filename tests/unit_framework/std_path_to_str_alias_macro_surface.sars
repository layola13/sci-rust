@import "sa_std/path.sars"
@import "sa_std/core/slice.sars"

@const P = utf8:"/tmp/x"

@test "sa_std path to_str alias"():
L_ENTRY:
    EXPAND STR_FROM_PARTS path, &P, 6
    EXPAND PATH_TO_STR ok, out, path
    EXPAND SLICE_GET_LEN ln, out
    a = eq ok, 1
    b = eq ln, 6
    ok_all = and a, b
    !ok
    !ln
    !a
    !b
    br ok_all -> L_OK, L_FAIL
L_OK:
    !ok_all
    return 0
L_FAIL:
    !ok_all
    panic(10901)
