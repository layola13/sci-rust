@import "sa_std/collections/vec_deque.sars"

@test "sa_std vec_deque with_capacity"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY d, 8
    EXPAND VEC_DEQUE_LEN ln, d
    EXPAND VEC_DEQUE_CAPACITY cap, d
    EXPAND VEC_DEQUE_FREE d
    a = eq ln, 0
    b = uge cap, 8
    ok = and a, b
    !ln
    !cap
    !a
    !b
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10959)
