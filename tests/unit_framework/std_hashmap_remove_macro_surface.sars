@import "sa_std/collections/hashmap.sars"

@const K = utf8:"k"
@const V = utf8:"v"

@test "sa_std hashmap remove"():
L_ENTRY:
    EXPAND MAP_NEW map
    key = &K
    val = &V
    EXPAND MAP_PUT map, key, val
    EXPAND MAP_GET g0, map, key
    EXPAND MAP_DEL rem_val, map, key
    EXPAND MAP_GET g1, map, key
    null_ptr = 0 as ptr
    a = eq g0, val
    b = eq rem_val, val
    c = eq g1, null_ptr
    ok01 = and a, b
    ok = and ok01, c
    !g0
    !rem_val
    !g1
    !a
    !b
    !c
    !ok01
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10985)
