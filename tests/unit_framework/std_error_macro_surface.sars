@import "sa_std/error.sars"

@const TEST_ERROR_MSG = utf8:"not found"
@const TEST_SOURCE_MSG = utf8:"invalid input"

@test "sa_std error primitive reference macros"():
L_ENTRY:
    io_type = stack_alloc TypeId_SIZE
    parse_type = stack_alloc TypeId_SIZE
    err_type = stack_alloc TypeId_SIZE
    EXPAND ERROR_TYPE_ID_IO io_type
    EXPAND ERROR_TYPE_ID_PARSE parse_type

    source = stack_alloc ErrorRef_SIZE
    err = stack_alloc ErrorRef_SIZE
    EXPAND ERROR_REF_STATIC source, ERROR_TYPE_PARSE_LO, ERROR_CODE_INVALID_INPUT, *TEST_SOURCE_MSG, 13
    source_ptr = &source
    EXPAND ERROR_REF_NEW err, io_type, ERROR_CODE_NOT_FOUND, *TEST_ERROR_MSG, 9, source_ptr
    unsupported = stack_alloc ErrorRef_SIZE
    unexpected_eof = stack_alloc ErrorRef_SIZE
    other = stack_alloc ErrorRef_SIZE
    EXPAND ERROR_REF_STATIC unsupported, ERROR_TYPE_IO_LO, ERROR_CODE_UNSUPPORTED, *TEST_ERROR_MSG, 9
    EXPAND ERROR_REF_STATIC unexpected_eof, ERROR_TYPE_IO_LO, ERROR_CODE_UNEXPECTED_EOF, *TEST_ERROR_MSG, 9
    EXPAND ERROR_REF_STATIC other, ERROR_TYPE_IO_LO, ERROR_CODE_OTHER, *TEST_ERROR_MSG, 9

    EXPAND ERROR_REF_TYPE_ID err_type, err
    EXPAND ERROR_REF_IS is_io, err, io_type
    EXPAND ERROR_REF_IS is_parse, err, parse_type
    EXPAND ERROR_REF_DOWNCAST_PTR down_ok, down_ptr, err, io_type
    EXPAND ERROR_REF_DOWNCAST_PTR miss_ok, miss_ptr, err, parse_type
    EXPAND ERROR_REF_CODE code, err
    EXPAND ERROR_REF_CODE_EQ code_is_not_found, err, ERROR_CODE_NOT_FOUND
    EXPAND ERROR_REF_IS_NOT_FOUND is_not_found, err
    EXPAND ERROR_REF_IS_NONE err_is_none, err
    EXPAND ERROR_REF_IS_OTHER is_other, other
    EXPAND ERROR_REF_IS_UNSUPPORTED is_unsupported, unsupported
    EXPAND ERROR_REF_IS_UNEXPECTED_EOF is_unexpected_eof, unexpected_eof
    EXPAND ERROR_REF_IS_INVALID_INPUT err_is_invalid_input, err
    EXPAND ERROR_REF_SOURCE has_source, got_source, err
    EXPAND ERROR_REF_HAS_SOURCE source_has_source, source
    msg_slice = stack_alloc Slice_SIZE
    EXPAND ERROR_REF_MESSAGE msg_slice, err
    EXPAND ERROR_REF_MESSAGE_PTR msg_ptr, err
    EXPAND ERROR_REF_MESSAGE_LEN msg_len, err
    slice_ptr = load msg_slice+Slice_ptr as ptr
    slice_len = load msg_slice+Slice_len as u64
    first_byte = load slice_ptr+0 as u8
    source_code = load got_source+ErrorRef_code as u64
    source_msg_len = load got_source+ErrorRef_msg_len as u64
    err_type_lo = load err_type+TypeId_lo as u64
    err_type_hi = load err_type+TypeId_hi as u64
    parse_is_false = eq is_parse, 0
    miss_is_false = eq miss_ok, 0
    miss_is_null = eq miss_ptr, 0
    err_invalid_false = eq err_is_invalid_input, 0
    err_none_false = eq err_is_none, 0
    source_has_false = eq source_has_source, 0

    ok01 = eq code, ERROR_CODE_NOT_FOUND
    ok02 = eq code_is_not_found, 1
    ok03 = eq is_not_found, 1
    ok04 = eq msg_ptr, slice_ptr
    ok05 = eq msg_len, 9
    ok06 = eq slice_ptr, msg_ptr
    ok07 = eq slice_len, 9
    ok08 = eq first_byte, 110
    ok09 = eq has_source, 1
    ok10 = eq got_source, source_ptr
    ok11 = eq source_code, ERROR_CODE_INVALID_INPUT
    ok12 = eq source_msg_len, 13
    ok13 = eq err_type_lo, ERROR_TYPE_IO_LO
    ok14 = eq err_type_hi, ERROR_TYPE_ID_HI
    ok15 = eq is_io, 1
    ok16 = eq down_ok, 1
    ok17 = eq down_ptr, err
    ok18 = eq miss_is_false, 1
    ok19 = eq miss_is_null, 1
    ok20 = eq parse_is_false, 1
    ok21 = eq err_invalid_false, 1
    ok22 = eq source_has_false, 1
    ok23 = eq is_other, 1
    ok24 = eq is_unsupported, 1
    ok25 = eq is_unexpected_eof, 1
    ok26 = eq err_none_false, 1

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok09
    all09 = and all08, ok10
    all10 = and all09, ok11
    all11 = and all10, ok12
    all12 = and all11, ok13
    all13 = and all12, ok14
    all14 = and all13, ok15
    all15 = and all14, ok16
    all16 = and all15, ok17
    all17 = and all16, ok18
    all18 = and all17, ok19
    all19 = and all18, ok20
    all20 = and all19, ok21
    all21 = and all20, ok22
    all22 = and all21, ok23
    all23 = and all22, ok24
    all24 = and all23, ok25
    all = and all24, ok26

    !source_ptr
    !is_io
    !is_parse
    !down_ok
    !down_ptr
    !miss_ok
    !miss_ptr
    !code
    !code_is_not_found
    !is_not_found
    !err_is_invalid_input
    !err_is_none
    !is_other
    !is_unsupported
    !is_unexpected_eof
    !has_source
    !got_source
    !source_has_source
    !msg_ptr
    !msg_len
    !slice_ptr
    !slice_len
    !first_byte
    !source_code
    !source_msg_len
    !err_type_lo
    !err_type_hi
    !parse_is_false
    !miss_is_false
    !miss_is_null
    !err_invalid_false
    !err_none_false
    !source_has_false
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !all11
    !all12
    !all13
    !all14
    !all15
    !all16
    !all17
    !all18
    !all19
    !all20
    !all21
    !all22
    !all23
    !all24

    br all -> L_PASS, L_FAIL

L_FAIL:
    !all
    panic(942)

L_PASS:
    !all
    return 0
