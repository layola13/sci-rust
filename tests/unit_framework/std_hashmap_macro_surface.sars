@import "sa_std/collections/hashmap.sars"
@import "sa_std/vec.sars"

@const KEY = utf8:"alpha"
@const KEY_B = utf8:"bravo"
@const KEY_C = utf8:"charlie"
@const KEY_D = utf8:"delta"
@const VALUE = utf8:"A\n"
@const VALUE_B = utf8:"B\n"
@const VALUE_C = utf8:"C\n"

@map_retain_not_bravo(key: ptr, value: ptr) -> u64:
L_ENTRY:
    bravo = &KEY_B
    is_bravo = eq key, bravo
    keep = eq is_bravo, 0
    !is_bravo
    !bravo
    !value
    !key
    return keep

@map_extract_bravo(key: ptr, value: ptr) -> u64:
L_ENTRY:
    bravo = &KEY_B
    take = eq key, bravo
    !bravo
    !value
    !key
    return take

@test "sa_std hashmap convenience macros"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 9
    EXPAND MAP_LEN len0, map
    EXPAND MAP_CAPACITY cap0, map
    EXPAND MAP_IS_EMPTY empty0, map
    key = &KEY
    value = &VALUE
    EXPAND MAP_CONTAINS_KEY has0, map, key
    EXPAND MAP_PUT map, key, value
    EXPAND MAP_LEN len1, map
    EXPAND MAP_CAPACITY cap1, map
    EXPAND MAP_RESERVE map, 20
    EXPAND MAP_CAPACITY cap_after_reserve, map
    EXPAND MAP_SHRINK_TO_FIT map
    EXPAND MAP_CAPACITY cap_after_shrink, map
    EXPAND MAP_IS_EMPTY empty1, map
    EXPAND MAP_CONTAINS_KEY has1, map, key
    EXPAND MAP_GET got1, map, key
    EXPAND MAP_CLEAR map
    EXPAND MAP_SHRINK_TO_FIT map
    EXPAND MAP_CAPACITY cap_after_clear_shrink, map
    EXPAND MAP_LEN len2, map
    EXPAND MAP_IS_EMPTY empty2, map
    EXPAND MAP_CONTAINS_KEY has2, map, key
    EXPAND MAP_GET got2, map, key
    EXPAND MAP_PUT map, key, value
    EXPAND MAP_LEN len3, map
    EXPAND MAP_CAPACITY cap_after_reinsert, map
    EXPAND MAP_CONTAINS_KEY has3, map, key
    EXPAND MAP_GET got3, map, key

    ok_len0 = eq len0, 0
    ok_cap0 = eq cap0, 16
    ok_empty0 = eq empty0, 1
    ok_has0 = eq has0, 0
    ok_len1 = eq len1, 1
    ok_cap1 = eq cap1, 16
    ok_cap_after_reserve = eq cap_after_reserve, 32
    ok_cap_after_shrink = eq cap_after_shrink, 8
    ok_empty1 = eq empty1, 0
    ok_has1 = eq has1, 1
    ok_got1 = eq got1, value
    ok_cap_after_clear_shrink = eq cap_after_clear_shrink, 0
    ok_len2 = eq len2, 0
    ok_empty2 = eq empty2, 1
    ok_has2 = eq has2, 0
    ok_got2 = eq got2, 0
    ok_len3 = eq len3, 1
    ok_cap_after_reinsert = eq cap_after_reinsert, 8
    ok_has3 = eq has3, 1
    ok_got3 = eq got3, value
    ok01 = and ok_len0, ok_cap0
    ok02 = and ok01, ok_empty0
    ok03 = and ok02, ok_has0
    ok04 = and ok03, ok_len1
    ok05 = and ok04, ok_cap1
    ok06 = and ok05, ok_cap_after_reserve
    ok07 = and ok06, ok_cap_after_shrink
    ok08 = and ok07, ok_empty1
    ok09 = and ok08, ok_has1
    ok10 = and ok09, ok_got1
    ok11 = and ok10, ok_cap_after_clear_shrink
    ok12 = and ok11, ok_len2
    ok13 = and ok12, ok_empty2
    ok14 = and ok13, ok_has2
    ok15 = and ok14, ok_got2
    ok16 = and ok15, ok_len3
    ok17 = and ok16, ok_cap_after_reinsert
    ok18 = and ok17, ok_has3
    ok = and ok18, ok_got3
    !got3
    !has3
    !cap_after_reinsert
    !len3
    !got2
    !has2
    !empty2
    !len2
    !cap_after_clear_shrink
    !got1
    !has1
    !empty1
    !cap_after_shrink
    !cap_after_reserve
    !len1
    !has0
    !empty0
    !cap1
    !cap0
    !len0
    !value
    !key
    !ok_len0
    !ok_cap0
    !ok_empty0
    !ok_has0
    !ok_len1
    !ok_cap1
    !ok_cap_after_reserve
    !ok_cap_after_shrink
    !ok_empty1
    !ok_has1
    !ok_got1
    !ok_cap_after_clear_shrink
    !ok_len2
    !ok_empty2
    !ok_has2
    !ok_got2
    !ok_len3
    !ok_cap_after_reinsert
    !ok_has3
    !ok_got3
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    EXPAND MAP_FREE map
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(905)

L_OK:
    !ok
    return

@test "sa_std hashmap rust parity macros"():
L_ENTRY:
    EXPAND MAP_TRY_WITH_CAPACITY try_new_ok, map, 4
    EXPAND MAP_LEN len0, map
    key_a = &KEY
    key_b = &KEY_B
    value_a = &VALUE
    value_b = &VALUE_B
    value_c = &VALUE_C

    EXPAND MAP_TRY_GET miss_get_ok, miss_get_value, map, key_a
    EXPAND MAP_TRY_RESERVE reserve_ok, map, 4
    EXPAND MAP_INSERT insert_a_old_ok, insert_a_old_value, map, key_a, value_a
    EXPAND MAP_INSERT insert_a_replace_ok, insert_a_replace_value, map, key_a, value_b
    EXPAND MAP_TRY_GET get_a_ok, get_a_value, map, key_a
    EXPAND MAP_GET_KEY_VALUE kv_ok, kv_key, kv_value, map, key_a
    EXPAND MAP_GET_MUT_PTR mut_ok, mut_ptr, map, key_a
    store mut_ptr+0, value_c as ptr
    EXPAND MAP_GET after_mut_value, map, key_a
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_LEN len_after_insert, map
    EXPAND MAP_CAPACITY cap_after_insert, map
    EXPAND MAP_SHRINK_TO map, 1
    EXPAND MAP_CAPACITY cap_after_shrink_to, map
    EXPAND MAP_REMOVE_ENTRY rem_ok, rem_key, rem_value, map, key_a
    EXPAND MAP_REMOVE_ENTRY rem_miss_ok, rem_miss_key, rem_miss_value, map, key_a
    EXPAND MAP_LEN len_after_remove, map
    EXPAND MAP_TRY_GET get_after_remove_ok, get_after_remove_value, map, key_a

    ok_try_new = eq try_new_ok, 1
    ok_len0 = eq len0, 0
    ok_miss_get_flag = eq miss_get_ok, 0
    ok_miss_get_value = eq miss_get_value, 0
    ok_reserve = eq reserve_ok, 1
    ok_insert_new_flag = eq insert_a_old_ok, 0
    ok_insert_new_old = eq insert_a_old_value, 0
    ok_insert_replace_flag = eq insert_a_replace_ok, 1
    ok_insert_replace_old = eq insert_a_replace_value, value_a
    ok_get_a_flag = eq get_a_ok, 1
    ok_get_a_value = eq get_a_value, value_b
    ok_kv_flag = eq kv_ok, 1
    ok_kv_key = eq kv_key, key_a
    ok_kv_value = eq kv_value, value_b
    ok_mut = eq mut_ok, 1
    ok_after_mut_value = eq after_mut_value, value_c
    ok_len_after_insert = eq len_after_insert, 2
    ok_cap_after_insert = uge cap_after_insert, 4
    ok_cap_after_shrink_to = eq cap_after_shrink_to, 8
    ok_rem_flag = eq rem_ok, 1
    ok_rem_key = eq rem_key, key_a
    ok_rem_value = eq rem_value, value_c
    ok_rem_miss_flag = eq rem_miss_ok, 0
    ok_rem_miss_key = eq rem_miss_key, 0
    ok_rem_miss_value = eq rem_miss_value, 0
    ok_len_after_remove = eq len_after_remove, 1
    ok_get_after_remove_flag = eq get_after_remove_ok, 0
    ok_get_after_remove_value = eq get_after_remove_value, 0

    ok01 = and ok_try_new, ok_len0
    ok02 = and ok01, ok_miss_get_flag
    ok03 = and ok02, ok_miss_get_value
    ok04 = and ok03, ok_reserve
    ok05 = and ok04, ok_insert_new_flag
    ok06 = and ok05, ok_insert_new_old
    ok07 = and ok06, ok_insert_replace_flag
    ok08 = and ok07, ok_insert_replace_old
    ok09 = and ok08, ok_get_a_flag
    ok10 = and ok09, ok_get_a_value
    ok11 = and ok10, ok_kv_flag
    ok12 = and ok11, ok_kv_key
    ok13 = and ok12, ok_kv_value
    ok14 = and ok13, ok_mut
    ok15 = and ok14, ok_after_mut_value
    ok16 = and ok15, ok_len_after_insert
    ok17 = and ok16, ok_cap_after_insert
    ok18 = and ok17, ok_cap_after_shrink_to
    ok19 = and ok18, ok_rem_flag
    ok20 = and ok19, ok_rem_key
    ok21 = and ok20, ok_rem_value
    ok22 = and ok21, ok_rem_miss_flag
    ok23 = and ok22, ok_rem_miss_key
    ok24 = and ok23, ok_rem_miss_value
    ok25 = and ok24, ok_len_after_remove
    ok26 = and ok25, ok_get_after_remove_flag
    ok = and ok26, ok_get_after_remove_value

    !try_new_ok
    !len0
    !miss_get_ok
    !miss_get_value
    !reserve_ok
    !insert_a_old_ok
    !insert_a_old_value
    !insert_a_replace_ok
    !insert_a_replace_value
    !get_a_ok
    !get_a_value
    !kv_ok
    !kv_key
    !kv_value
    !mut_ok
    !mut_ptr
    !after_mut_value
    !len_after_insert
    !cap_after_insert
    !cap_after_shrink_to
    !rem_ok
    !rem_key
    !rem_value
    !rem_miss_ok
    !rem_miss_key
    !rem_miss_value
    !len_after_remove
    !get_after_remove_ok
    !get_after_remove_value
    !value_c
    !value_b
    !value_a
    !key_b
    !key_a
    !ok_try_new
    !ok_len0
    !ok_miss_get_flag
    !ok_miss_get_value
    !ok_reserve
    !ok_insert_new_flag
    !ok_insert_new_old
    !ok_insert_replace_flag
    !ok_insert_replace_old
    !ok_get_a_flag
    !ok_get_a_value
    !ok_kv_flag
    !ok_kv_key
    !ok_kv_value
    !ok_mut
    !ok_after_mut_value
    !ok_len_after_insert
    !ok_cap_after_insert
    !ok_cap_after_shrink_to
    !ok_rem_flag
    !ok_rem_key
    !ok_rem_value
    !ok_rem_miss_flag
    !ok_rem_miss_key
    !ok_rem_miss_value
    !ok_len_after_remove
    !ok_get_after_remove_flag
    !ok_get_after_remove_value
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    EXPAND MAP_FREE map
    br ok -> L_PARITY_OK, L_PARITY_FAIL

L_PARITY_FAIL:
    !ok
    panic(10042)

L_PARITY_OK:
    !ok
    return

@test "sa_std hashmap collection view macros"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 4
    key_a = &KEY
    key_b = &KEY_B
    key_c = &KEY_C
    key_d = &KEY_D
    value_a = &VALUE
    value_b = &VALUE_B
    value_c = &VALUE_C

    EXPAND MAP_PUT map, key_a, value_a
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_TRY_INSERT try_insert_new_ok, try_insert_new_ptr, map, key_c, value_c
    try_insert_new_value = load try_insert_new_ptr+0 as ptr
    EXPAND MAP_TRY_INSERT try_insert_existing_ok, try_insert_existing_ptr, map, key_a, value_c
    try_insert_existing_value = load try_insert_existing_ptr+0 as ptr
    EXPAND MAP_ENTRY_OR_INSERT entry_new_inserted, entry_new_ptr, map, key_d, value_b
    entry_new_value = load entry_new_ptr+0 as ptr
    EXPAND MAP_ENTRY_OR_INSERT entry_existing_inserted, entry_existing_ptr, map, key_a, value_c
    entry_existing_value = load entry_existing_ptr+0 as ptr

    EXPAND MAP_TRY_GET_DISJOINT_MUT_PTRS disjoint_ok, disjoint_a_ptr, disjoint_b_ptr, map, key_a, key_b
    store disjoint_a_ptr+0, value_c as ptr
    store disjoint_b_ptr+0, value_a as ptr
    EXPAND MAP_GET after_disjoint_a, map, key_a
    EXPAND MAP_GET after_disjoint_b, map, key_b
    EXPAND MAP_TRY_GET_DISJOINT_MUT_PTRS same_key_ok, same_key_a_ptr, same_key_b_ptr, map, key_a, key_a

    EXPAND MAP_KEYS key_vec, map
    EXPAND MAP_VALUES value_vec, map
    EXPAND MAP_VALUES_MUT_PTRS value_ptr_vec, map
    EXPAND VEC_LEN key_vec_len, key_vec
    EXPAND VEC_LEN value_vec_len, value_vec
    EXPAND VEC_LEN value_ptr_vec_len, value_ptr_vec
    key_a_bits = bitcast key_a as u64
    key_b_bits = bitcast key_b as u64
    key_c_bits = bitcast key_c as u64
    key_d_bits = bitcast key_d as u64
    value_a_bits = bitcast value_a as u64
    value_c_bits = bitcast value_c as u64
    disjoint_a_ptr_bits = bitcast disjoint_a_ptr as u64
    disjoint_b_ptr_bits = bitcast disjoint_b_ptr as u64
    try_insert_new_ptr_bits = bitcast try_insert_new_ptr as u64
    EXPAND VEC_CONTAINS_U64 has_key_a, key_vec, key_a_bits
    EXPAND VEC_CONTAINS_U64 has_key_b, key_vec, key_b_bits
    EXPAND VEC_CONTAINS_U64 has_key_c, key_vec, key_c_bits
    EXPAND VEC_CONTAINS_U64 has_key_d, key_vec, key_d_bits
    EXPAND VEC_CONTAINS_U64 has_value_a, value_vec, value_a_bits
    EXPAND VEC_CONTAINS_U64 has_value_c, value_vec, value_c_bits
    EXPAND VEC_CONTAINS_U64 has_mut_ptr_a, value_ptr_vec, disjoint_a_ptr_bits
    EXPAND VEC_CONTAINS_U64 has_mut_ptr_b, value_ptr_vec, disjoint_b_ptr_bits
    EXPAND VEC_CONTAINS_U64 has_mut_ptr_c, value_ptr_vec, try_insert_new_ptr_bits

    ok_try_insert_new = eq try_insert_new_ok, 1
    ok_try_insert_new_value = eq try_insert_new_value, value_c
    ok_try_insert_existing_flag = eq try_insert_existing_ok, 0
    ok_try_insert_existing_value = eq try_insert_existing_value, value_a
    ok_entry_new_inserted = eq entry_new_inserted, 1
    ok_entry_new_value = eq entry_new_value, value_b
    ok_entry_existing_inserted = eq entry_existing_inserted, 0
    ok_entry_existing_value = eq entry_existing_value, value_a
    ok_disjoint = eq disjoint_ok, 1
    ok_after_disjoint_a = eq after_disjoint_a, value_c
    ok_after_disjoint_b = eq after_disjoint_b, value_a
    ok_same_key = eq same_key_ok, 0
    ok_same_key_a_ptr = eq same_key_a_ptr, 0
    ok_same_key_b_ptr = eq same_key_b_ptr, 0
    ok_key_vec_len = eq key_vec_len, 4
    ok_value_vec_len = eq value_vec_len, 4
    ok_value_ptr_vec_len = eq value_ptr_vec_len, 4
    ok_has_key_a = eq has_key_a, 1
    ok_has_key_b = eq has_key_b, 1
    ok_has_key_c = eq has_key_c, 1
    ok_has_key_d = eq has_key_d, 1
    ok_has_value_a = eq has_value_a, 1
    ok_has_value_c = eq has_value_c, 1
    ok_has_mut_ptr_a = eq has_mut_ptr_a, 1
    ok_has_mut_ptr_b = eq has_mut_ptr_b, 1
    ok_has_mut_ptr_c = eq has_mut_ptr_c, 1

    ok01 = and ok_try_insert_new, ok_try_insert_new_value
    ok02 = and ok01, ok_try_insert_existing_flag
    ok03 = and ok02, ok_try_insert_existing_value
    ok04 = and ok03, ok_entry_new_inserted
    ok05 = and ok04, ok_entry_new_value
    ok06 = and ok05, ok_entry_existing_inserted
    ok07 = and ok06, ok_entry_existing_value
    ok08 = and ok07, ok_disjoint
    ok09 = and ok08, ok_after_disjoint_a
    ok10 = and ok09, ok_after_disjoint_b
    ok11 = and ok10, ok_same_key
    ok12 = and ok11, ok_same_key_a_ptr
    ok13 = and ok12, ok_same_key_b_ptr
    ok14 = and ok13, ok_key_vec_len
    ok15 = and ok14, ok_value_vec_len
    ok16 = and ok15, ok_value_ptr_vec_len
    ok17 = and ok16, ok_has_key_a
    ok18 = and ok17, ok_has_key_b
    ok19 = and ok18, ok_has_key_c
    ok20 = and ok19, ok_has_key_d
    ok21 = and ok20, ok_has_value_a
    ok22 = and ok21, ok_has_value_c
    ok23 = and ok22, ok_has_mut_ptr_a
    ok24 = and ok23, ok_has_mut_ptr_b
    ok = and ok24, ok_has_mut_ptr_c

    !try_insert_new_ok
    !try_insert_new_ptr
    !try_insert_new_value
    !try_insert_existing_ok
    !try_insert_existing_ptr
    !try_insert_existing_value
    !entry_new_inserted
    !entry_new_ptr
    !entry_new_value
    !entry_existing_inserted
    !entry_existing_ptr
    !entry_existing_value
    !disjoint_ok
    !disjoint_a_ptr
    !disjoint_b_ptr
    !after_disjoint_a
    !after_disjoint_b
    !same_key_ok
    !same_key_a_ptr
    !same_key_b_ptr
    !key_vec_len
    !value_vec_len
    !value_ptr_vec_len
    !key_a_bits
    !key_b_bits
    !key_c_bits
    !key_d_bits
    !value_a_bits
    !value_c_bits
    !disjoint_a_ptr_bits
    !disjoint_b_ptr_bits
    !try_insert_new_ptr_bits
    !has_key_a
    !has_key_b
    !has_key_c
    !has_key_d
    !has_value_a
    !has_value_c
    !has_mut_ptr_a
    !has_mut_ptr_b
    !has_mut_ptr_c
    !value_c
    !value_b
    !value_a
    !key_d
    !key_c
    !key_b
    !key_a
    !ok_try_insert_new
    !ok_try_insert_new_value
    !ok_try_insert_existing_flag
    !ok_try_insert_existing_value
    !ok_entry_new_inserted
    !ok_entry_new_value
    !ok_entry_existing_inserted
    !ok_entry_existing_value
    !ok_disjoint
    !ok_after_disjoint_a
    !ok_after_disjoint_b
    !ok_same_key
    !ok_same_key_a_ptr
    !ok_same_key_b_ptr
    !ok_key_vec_len
    !ok_value_vec_len
    !ok_value_ptr_vec_len
    !ok_has_key_a
    !ok_has_key_b
    !ok_has_key_c
    !ok_has_key_d
    !ok_has_value_a
    !ok_has_value_c
    !ok_has_mut_ptr_a
    !ok_has_mut_ptr_b
    !ok_has_mut_ptr_c
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    EXPAND VEC_FREE value_ptr_vec
    EXPAND VEC_FREE value_vec
    EXPAND VEC_FREE key_vec
    EXPAND MAP_FREE map
    br ok -> L_VIEW_OK, L_VIEW_FAIL

L_VIEW_FAIL:
    !ok
    panic(10043)

L_VIEW_OK:
    !ok
    return

@test "sa_std hashmap into key value view macros"():
L_ENTRY:
    key_a = &KEY
    key_b = &KEY_B
    value_a = &VALUE
    value_b = &VALUE_B
    key_a_bits = bitcast key_a as u64
    key_b_bits = bitcast key_b as u64
    value_a_bits = bitcast value_a as u64
    value_b_bits = bitcast value_b as u64

    EXPAND MAP_WITH_CAPACITY keys_map, 4
    EXPAND MAP_PUT keys_map, key_a, value_a
    EXPAND MAP_PUT keys_map, key_b, value_b
    EXPAND MAP_INTO_KEYS into_keys_vec, keys_map
    EXPAND VEC_LEN into_keys_len, into_keys_vec
    EXPAND VEC_CONTAINS_U64 into_keys_has_a, into_keys_vec, key_a_bits
    EXPAND VEC_CONTAINS_U64 into_keys_has_b, into_keys_vec, key_b_bits
    EXPAND MAP_LEN keys_map_len_after, keys_map
    EXPAND MAP_IS_EMPTY keys_map_empty_after, keys_map

    EXPAND MAP_WITH_CAPACITY values_map, 4
    EXPAND MAP_PUT values_map, key_a, value_a
    EXPAND MAP_PUT values_map, key_b, value_b
    EXPAND MAP_INTO_VALUES into_values_vec, values_map
    EXPAND VEC_LEN into_values_len, into_values_vec
    EXPAND VEC_CONTAINS_U64 into_values_has_a, into_values_vec, value_a_bits
    EXPAND VEC_CONTAINS_U64 into_values_has_b, into_values_vec, value_b_bits
    EXPAND MAP_LEN values_map_len_after, values_map
    EXPAND MAP_IS_EMPTY values_map_empty_after, values_map

    ok_keys_len = eq into_keys_len, 2
    ok_keys_has_a = eq into_keys_has_a, 1
    ok_keys_has_b = eq into_keys_has_b, 1
    ok_keys_map_len = eq keys_map_len_after, 0
    ok_keys_map_empty = eq keys_map_empty_after, 1
    ok_values_len = eq into_values_len, 2
    ok_values_has_a = eq into_values_has_a, 1
    ok_values_has_b = eq into_values_has_b, 1
    ok_values_map_len = eq values_map_len_after, 0
    ok_values_map_empty = eq values_map_empty_after, 1

    ok01 = and ok_keys_len, ok_keys_has_a
    ok02 = and ok01, ok_keys_has_b
    ok03 = and ok02, ok_keys_map_len
    ok04 = and ok03, ok_keys_map_empty
    ok05 = and ok04, ok_values_len
    ok06 = and ok05, ok_values_has_a
    ok07 = and ok06, ok_values_has_b
    ok08 = and ok07, ok_values_map_len
    ok = and ok08, ok_values_map_empty

    !key_a
    !key_b
    !value_a
    !value_b
    !key_a_bits
    !key_b_bits
    !value_a_bits
    !value_b_bits
    !into_keys_len
    !into_keys_has_a
    !into_keys_has_b
    !keys_map_len_after
    !keys_map_empty_after
    !into_values_len
    !into_values_has_a
    !into_values_has_b
    !values_map_len_after
    !values_map_empty_after
    !ok_keys_len
    !ok_keys_has_a
    !ok_keys_has_b
    !ok_keys_map_len
    !ok_keys_map_empty
    !ok_values_len
    !ok_values_has_a
    !ok_values_has_b
    !ok_values_map_len
    !ok_values_map_empty
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    EXPAND VEC_FREE into_values_vec
    EXPAND VEC_FREE into_keys_vec
    EXPAND MAP_FREE values_map
    EXPAND MAP_FREE keys_map
    br ok -> L_INTO_VIEW_OK, L_INTO_VIEW_FAIL

L_INTO_VIEW_FAIL:
    !ok
    panic(10044)

L_INTO_VIEW_OK:
    !ok
    return

@test "sa_std hashmap retain macro"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 4
    key_a = &KEY
    key_b = &KEY_B
    key_c = &KEY_C
    value_a = &VALUE
    value_b = &VALUE_B
    value_c = &VALUE_C

    EXPAND MAP_PUT map, key_a, value_a
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_PUT map, key_c, value_c
    EXPAND MAP_RETAIN retain_len, map, @map_retain_not_bravo
    EXPAND MAP_LEN len_after_retain, map
    EXPAND MAP_CONTAINS_KEY has_a, map, key_a
    EXPAND MAP_CONTAINS_KEY has_b, map, key_b
    EXPAND MAP_CONTAINS_KEY has_c, map, key_c
    EXPAND MAP_GET get_a, map, key_a
    EXPAND MAP_GET get_b, map, key_b
    EXPAND MAP_GET get_c, map, key_c
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_LEN len_after_reinsert, map
    EXPAND MAP_GET get_b_after_reinsert, map, key_b

    retain_len_ok = eq retain_len, 2
    len_after_retain_ok = eq len_after_retain, 2
    has_a_ok = eq has_a, 1
    has_b_ok = eq has_b, 0
    has_c_ok = eq has_c, 1
    get_a_ok = eq get_a, value_a
    get_b_ok = eq get_b, 0
    get_c_ok = eq get_c, value_c
    len_after_reinsert_ok = eq len_after_reinsert, 3
    get_b_after_reinsert_ok = eq get_b_after_reinsert, value_b
    ok01 = and retain_len_ok, len_after_retain_ok
    ok02 = and ok01, has_a_ok
    ok03 = and ok02, has_b_ok
    ok04 = and ok03, has_c_ok
    ok05 = and ok04, get_a_ok
    ok06 = and ok05, get_b_ok
    ok07 = and ok06, get_c_ok
    ok08 = and ok07, len_after_reinsert_ok
    ok = and ok08, get_b_after_reinsert_ok

    !retain_len
    !len_after_retain
    !has_a
    !has_b
    !has_c
    !get_a
    !get_b
    !get_c
    !len_after_reinsert
    !get_b_after_reinsert
    !value_c
    !value_b
    !value_a
    !key_c
    !key_b
    !key_a
    !retain_len_ok
    !len_after_retain_ok
    !has_a_ok
    !has_b_ok
    !has_c_ok
    !get_a_ok
    !get_b_ok
    !get_c_ok
    !len_after_reinsert_ok
    !get_b_after_reinsert_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    EXPAND MAP_FREE map
    br ok -> L_RETAIN_OK, L_RETAIN_FAIL

L_RETAIN_FAIL:
    !ok
    panic(10045)

L_RETAIN_OK:
    !ok
    return

@test "sa_std hashmap drain and extract macros"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 4
    key_a = &KEY
    key_b = &KEY_B
    key_c = &KEY_C
    value_a = &VALUE
    value_b = &VALUE_B
    value_c = &VALUE_C

    EXPAND MAP_PUT map, key_a, value_a
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_PUT map, key_c, value_c
    EXPAND MAP_EXTRACT_IF extract_len, extract_vec, map, @map_extract_bravo
    EXPAND VEC_LEN extract_vec_len, extract_vec
    key_a_bits = bitcast key_a as u64
    key_b_bits = bitcast key_b as u64
    key_c_bits = bitcast key_c as u64
    value_a_bits = bitcast value_a as u64
    value_b_bits = bitcast value_b as u64
    value_c_bits = bitcast value_c as u64
    EXPAND VEC_CONTAINS_U64 extract_has_key_b, extract_vec, key_b_bits
    EXPAND VEC_CONTAINS_U64 extract_has_value_b, extract_vec, value_b_bits
    EXPAND MAP_LEN len_after_extract, map
    EXPAND MAP_CONTAINS_KEY has_a_after_extract, map, key_a
    EXPAND MAP_CONTAINS_KEY has_b_after_extract, map, key_b
    EXPAND MAP_CONTAINS_KEY has_c_after_extract, map, key_c

    EXPAND MAP_DRAIN drain_vec, map
    EXPAND VEC_LEN drain_vec_len, drain_vec
    EXPAND VEC_CONTAINS_U64 drain_has_key_a, drain_vec, key_a_bits
    EXPAND VEC_CONTAINS_U64 drain_has_value_a, drain_vec, value_a_bits
    EXPAND VEC_CONTAINS_U64 drain_has_key_c, drain_vec, key_c_bits
    EXPAND VEC_CONTAINS_U64 drain_has_value_c, drain_vec, value_c_bits
    EXPAND MAP_LEN len_after_drain, map
    EXPAND MAP_CONTAINS_KEY has_a_after_drain, map, key_a
    EXPAND MAP_PUT map, key_b, value_b
    EXPAND MAP_LEN len_after_reinsert, map
    EXPAND MAP_GET get_b_after_reinsert, map, key_b

    extract_len_ok = eq extract_len, 2
    extract_vec_len_ok = eq extract_vec_len, 2
    extract_has_key_b_ok = eq extract_has_key_b, 1
    extract_has_value_b_ok = eq extract_has_value_b, 1
    len_after_extract_ok = eq len_after_extract, 2
    has_a_after_extract_ok = eq has_a_after_extract, 1
    has_b_after_extract_ok = eq has_b_after_extract, 0
    has_c_after_extract_ok = eq has_c_after_extract, 1
    drain_vec_len_ok = eq drain_vec_len, 4
    drain_has_key_a_ok = eq drain_has_key_a, 1
    drain_has_value_a_ok = eq drain_has_value_a, 1
    drain_has_key_c_ok = eq drain_has_key_c, 1
    drain_has_value_c_ok = eq drain_has_value_c, 1
    len_after_drain_ok = eq len_after_drain, 0
    has_a_after_drain_ok = eq has_a_after_drain, 0
    len_after_reinsert_ok = eq len_after_reinsert, 1
    get_b_after_reinsert_ok = eq get_b_after_reinsert, value_b
    ok01 = and extract_len_ok, extract_vec_len_ok
    ok02 = and ok01, extract_has_key_b_ok
    ok03 = and ok02, extract_has_value_b_ok
    ok04 = and ok03, len_after_extract_ok
    ok05 = and ok04, has_a_after_extract_ok
    ok06 = and ok05, has_b_after_extract_ok
    ok07 = and ok06, has_c_after_extract_ok
    ok08 = and ok07, drain_vec_len_ok
    ok09 = and ok08, drain_has_key_a_ok
    ok10 = and ok09, drain_has_value_a_ok
    ok11 = and ok10, drain_has_key_c_ok
    ok12 = and ok11, drain_has_value_c_ok
    ok13 = and ok12, len_after_drain_ok
    ok14 = and ok13, has_a_after_drain_ok
    ok15 = and ok14, len_after_reinsert_ok
    ok = and ok15, get_b_after_reinsert_ok

    !extract_len
    !extract_vec_len
    !key_a_bits
    !key_b_bits
    !key_c_bits
    !value_a_bits
    !value_b_bits
    !value_c_bits
    !extract_has_key_b
    !extract_has_value_b
    !len_after_extract
    !has_a_after_extract
    !has_b_after_extract
    !has_c_after_extract
    !drain_vec_len
    !drain_has_key_a
    !drain_has_value_a
    !drain_has_key_c
    !drain_has_value_c
    !len_after_drain
    !has_a_after_drain
    !len_after_reinsert
    !get_b_after_reinsert
    !value_c
    !value_b
    !value_a
    !key_c
    !key_b
    !key_a
    !extract_len_ok
    !extract_vec_len_ok
    !extract_has_key_b_ok
    !extract_has_value_b_ok
    !len_after_extract_ok
    !has_a_after_extract_ok
    !has_b_after_extract_ok
    !has_c_after_extract_ok
    !drain_vec_len_ok
    !drain_has_key_a_ok
    !drain_has_value_a_ok
    !drain_has_key_c_ok
    !drain_has_value_c_ok
    !len_after_drain_ok
    !has_a_after_drain_ok
    !len_after_reinsert_ok
    !get_b_after_reinsert_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    EXPAND VEC_FREE drain_vec
    EXPAND VEC_FREE extract_vec
    EXPAND MAP_FREE map
    br ok -> L_DRAIN_EXTRACT_OK, L_DRAIN_EXTRACT_FAIL

L_DRAIN_EXTRACT_FAIL:
    !ok
    panic(919)

L_DRAIN_EXTRACT_OK:
    !ok
    return

@test "sa_std hashmap seeded constructors"():
L_ENTRY:
    seed = 12345 as u64
    cap = 4 as u64
    key = &KEY_D
    value = &VALUE_C
    EXPAND MAP_WITH_SEED seeded_map, seed
    EXPAND MAP_PUT seeded_map, key, value
    EXPAND MAP_GET seeded_get, seeded_map, key
    EXPAND MAP_DEL seeded_removed, seeded_map, key
    EXPAND MAP_LEN seeded_len_after_del, seeded_map

    EXPAND MAP_WITH_CAPACITY_SEED seeded_cap_map, cap, seed
    EXPAND MAP_CAPACITY seeded_cap, seeded_cap_map
    EXPAND MAP_PUT seeded_cap_map, key, value
    EXPAND MAP_CONTAINS_KEY seeded_cap_has, seeded_cap_map, key
    EXPAND MAP_GET seeded_cap_get, seeded_cap_map, key

    seeded_get_ok = eq seeded_get, value
    seeded_removed_ok = eq seeded_removed, value
    seeded_len_ok = eq seeded_len_after_del, 0
    seeded_cap_ok = eq seeded_cap, 8
    seeded_cap_has_ok = eq seeded_cap_has, 1
    seeded_cap_get_ok = eq seeded_cap_get, value
    ok01 = and seeded_get_ok, seeded_removed_ok
    ok02 = and ok01, seeded_len_ok
    ok03 = and ok02, seeded_cap_ok
    ok04 = and ok03, seeded_cap_has_ok
    ok = and ok04, seeded_cap_get_ok

    !seeded_get
    !seeded_removed
    !seeded_len_after_del
    !seeded_cap
    !seeded_cap_has
    !seeded_cap_get
    !value
    !key
    !cap
    !seed
    !seeded_get_ok
    !seeded_removed_ok
    !seeded_len_ok
    !seeded_cap_ok
    !seeded_cap_has_ok
    !seeded_cap_get_ok
    !ok01
    !ok02
    !ok03
    !ok04
    EXPAND MAP_FREE seeded_cap_map
    EXPAND MAP_FREE seeded_map
    br ok -> L_SEEDED_OK, L_SEEDED_FAIL

L_SEEDED_FAIL:
    !ok
    panic(10046)

L_SEEDED_OK:
    !ok
    return

@test "sa_std hashmap entry and_modify/or_default aliases"():
L_ENTRY:
    EXPAND MAP_NEW map
    key_a = &KEY
    key_b = &KEY_B
    value_a = &VALUE
    value_b = &VALUE_B

    EXPAND MAP_ENTRY_AND_MODIFY miss_ok, map, key_a, value_a
    miss_ok_ok = eq miss_ok, 0
    EXPAND MAP_CONTAINS_KEY has_after_miss, map, key_a
    has_after_miss_ok = eq has_after_miss, 0

    EXPAND MAP_ENTRY_OR_DEFAULT def_ins, def_ptr, map, key_a
    def_ins_ok = eq def_ins, 1
    def_val = load def_ptr+0 as ptr
    def_val_ok = eq def_val, 0

    EXPAND MAP_ENTRY_OR_DEFAULT def_again_ins, def_again_ptr, map, key_a
    def_again_ins_ok = eq def_again_ins, 0
    def_again_val = load def_again_ptr+0 as ptr
    def_again_val_ok = eq def_again_val, 0

    EXPAND MAP_OR_INSERT or_ins, or_ptr, map, key_b, value_a
    or_ins_ok = eq or_ins, 1
    or_val = load or_ptr+0 as ptr
    or_val_ok = eq or_val, value_a

    EXPAND MAP_ENTRY_AND_MODIFY mod_ok, map, key_b, value_b
    mod_ok_ok = eq mod_ok, 1
    EXPAND MAP_GET after_mod, map, key_b
    after_mod_ok = eq after_mod, value_b

    EXPAND MAP_FREE map

    !key_a
    !key_b
    !value_a
    !value_b

    ok = and miss_ok_ok, has_after_miss_ok
    ok = and ok, def_ins_ok
    ok = and ok, def_val_ok
    ok = and ok, def_again_ins_ok
    ok = and ok, def_again_val_ok
    ok = and ok, or_ins_ok
    ok = and ok, or_val_ok
    ok = and ok, mod_ok_ok
    ok = and ok, after_mod_ok

    !miss_ok
    !has_after_miss
    !def_ins
    !def_ptr
    !def_val
    !def_again_ins
    !def_again_ptr
    !def_again_val
    !or_ins
    !or_ptr
    !or_val
    !mod_ok
    !after_mod
    !miss_ok_ok
    !has_after_miss_ok
    !def_ins_ok
    !def_val_ok
    !def_again_ins_ok
    !def_again_val_ok
    !or_ins_ok
    !or_val_ok
    !mod_ok_ok
    !after_mod_ok
    br ok -> L_MAP_ENTRY_ALIAS_OK, L_MAP_ENTRY_ALIAS_FAIL

L_MAP_ENTRY_ALIAS_FAIL:
    !ok
    panic(10047)

L_MAP_ENTRY_ALIAS_OK:
    !ok
    return

@test "sa_std hashmap extra_capacity alias"():
L_ENTRY:
    EXPAND MAP_WITH_CAPACITY map, 4
    EXPAND MAP_LEN len0, map
    EXPAND MAP_CAPACITY cap0, map
    EXPAND MAP_EXTRA_CAPACITY ec0, map
    expected0 = sub cap0, len0
    ec0_ok = eq ec0, expected0

    key = &KEY
    value = &VALUE
    EXPAND MAP_PUT map, key, value
    EXPAND MAP_LEN len1, map
    EXPAND MAP_CAPACITY cap1, map
    EXPAND MAP_EXTRA_CAPACITY ec1, map
    expected1 = sub cap1, len1
    ec1_ok = eq ec1, expected1
    len1_ok = eq len1, 1

    EXPAND MAP_FREE map
    !key
    !value

    ok = and ec0_ok, ec1_ok
    ok = and ok, len1_ok

    !len0
    !cap0
    !ec0
    !expected0
    !len1
    !cap1
    !ec1
    !expected1
    !ec0_ok
    !ec1_ok
    !len1_ok
    br ok -> L_MAP_EC_OK, L_MAP_EC_FAIL

L_MAP_EC_FAIL:
    !ok
    panic(10048)

L_MAP_EC_OK:
    !ok
    return

@test "sa_std hashmap literal arity macros"():
L_ENTRY:
    key1 = &KEY
    key2 = &KEY_B
    key3 = &KEY_C
    value1 = &VALUE
    value2 = &VALUE_B
    value3 = &VALUE_C

    EXPAND MAP_LIT1 map1, key1, value1
    EXPAND MAP_LEN len1, map1
    EXPAND MAP_GET got1, map1, key1
    len1_ok = eq len1, 1
    got1_ok = eq got1, value1

    EXPAND MAP_LIT2 map2, key1, value1, key2, value2
    EXPAND MAP_LEN len2, map2
    EXPAND MAP_GET got2a, map2, key1
    EXPAND MAP_GET got2b, map2, key2
    len2_ok = eq len2, 2
    got2a_ok = eq got2a, value1
    got2b_ok = eq got2b, value2

    EXPAND MAP_LIT3 map3, key1, value1, key2, value2, key3, value3
    EXPAND MAP_LEN len3, map3
    EXPAND MAP_GET got3a, map3, key1
    EXPAND MAP_GET got3b, map3, key2
    EXPAND MAP_GET got3c, map3, key3
    len3_ok = eq len3, 3
    got3a_ok = eq got3a, value1
    got3b_ok = eq got3b, value2
    got3c_ok = eq got3c, value3

    EXPAND MAP_FREE map1
    EXPAND MAP_FREE map2
    EXPAND MAP_FREE map3

    ok = and len1_ok, got1_ok
    ok = and ok, len2_ok
    ok = and ok, got2a_ok
    ok = and ok, got2b_ok
    ok = and ok, len3_ok
    ok = and ok, got3a_ok
    ok = and ok, got3b_ok
    ok = and ok, got3c_ok

    !key1
    !key2
    !key3
    !value1
    !value2
    !value3
    !len1
    !got1
    !len2
    !got2a
    !got2b
    !len3
    !got3a
    !got3b
    !got3c
    !len1_ok
    !got1_ok
    !len2_ok
    !got2a_ok
    !got2b_ok
    !len3_ok
    !got3a_ok
    !got3b_ok
    !got3c_ok
    br ok -> L_MAP_LIT_OK, L_MAP_LIT_FAIL

L_MAP_LIT_FAIL:
    !ok
    panic(10049)

L_MAP_LIT_OK:
    !ok
    return


@test "sa_std hashmap default alias"():
L_ENTRY:
    EXPAND MAP_DEFAULT map
    EXPAND MAP_LEN len0, map
    EXPAND MAP_IS_EMPTY empty0, map
    EXPAND MAP_FREE map

    ok_len = eq len0, 0
    ok_empty = eq empty0, 1
    ok = and ok_len, ok_empty

    !len0
    !empty0
    !ok_len
    !ok_empty
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(10431)
L_OK:
    !ok
    return
