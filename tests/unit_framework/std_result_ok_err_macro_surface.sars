@import "sa_std/core/result.sars"

@test "sa_std result ok err"():
L_ENTRY:
    EXPAND RESULT_OK ok_res, 7
    EXPAND RESULT_ERR err_res, 9
    EXPAND RESULT_IS_OK is_ok, ok_res
    EXPAND RESULT_IS_ERR is_err, err_res
    EXPAND RESULT_UNWRAP_OR u1, ok_res, 0
    EXPAND RESULT_UNWRAP_OR u2, err_res, 0
    a = eq is_ok, 1
    b = eq is_err, 1
    c = eq u1, 7
    d = eq u2, 0
    ok01 = and a, b
    ok02 = and ok01, c
    ok = and ok02, d
    !is_ok
    !is_err
    !u1
    !u2
    !a
    !b
    !c
    !d
    !ok01
    !ok02
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10969)
