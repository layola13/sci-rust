@import "sa_std/vec.sars"

@test "sa_std vec into_iter macro surface"():
L_ENTRY:
    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 7
    EXPAND VEC_PUSH_U64 vec, 8
    EXPAND VEC_PUSH_U64 vec, 9

    EXPAND VEC_INTO_ITER_U64 iter, backing_vec, vec
    EXPAND VEC_LEN backing_len, backing_vec
    EXPAND ITER_NEXT_U64 first_ok, first, iter
    EXPAND ITER_NEXT_BACK_U64 last_ok, last, iter
    EXPAND ITER_NEXT_U64 second_ok, second, iter
    EXPAND ITER_NEXT_U64 done_ok, done_value, iter
    EXPAND ITER_LEN len_after, iter
    EXPAND VEC_FREE backing_vec

    EXPAND VEC_NEW empty_vec
    EXPAND VEC_INTO_ITER_U64 empty_iter, empty_backing_vec, empty_vec
    EXPAND VEC_LEN empty_backing_len, empty_backing_vec
    EXPAND ITER_NEXT_U64 empty_next_ok, empty_next, empty_iter
    EXPAND ITER_IS_EMPTY empty_iter_empty, empty_iter
    EXPAND VEC_FREE empty_backing_vec

    ok_backing_len = eq backing_len, 3
    ok_first_flag = eq first_ok, 1
    ok_first = eq first, 7
    ok_last_flag = eq last_ok, 1
    ok_last = eq last, 9
    ok_second_flag = eq second_ok, 1
    ok_second = eq second, 8
    ok_done_flag = eq done_ok, 0
    ok_done_value = eq done_value, 0
    ok_len_after = eq len_after, 0
    ok_empty_backing_len = eq empty_backing_len, 0
    ok_empty_next_flag = eq empty_next_ok, 0
    ok_empty_next = eq empty_next, 0
    ok_empty_iter_empty = eq empty_iter_empty, 1

    ok = and ok_backing_len, ok_first_flag
    ok = and ok, ok_first
    ok = and ok, ok_last_flag
    ok = and ok, ok_last
    ok = and ok, ok_second_flag
    ok = and ok, ok_second
    ok = and ok, ok_done_flag
    ok = and ok, ok_done_value
    ok = and ok, ok_len_after
    ok = and ok, ok_empty_backing_len
    ok = and ok, ok_empty_next_flag
    ok = and ok, ok_empty_next
    ok = and ok, ok_empty_iter_empty

    !backing_len
    !first_ok
    !first
    !last_ok
    !last
    !second_ok
    !second
    !done_ok
    !done_value
    !len_after
    !empty_backing_len
    !empty_next_ok
    !empty_next
    !empty_iter_empty
    !ok_backing_len
    !ok_first_flag
    !ok_first
    !ok_last_flag
    !ok_last
    !ok_second_flag
    !ok_second
    !ok_done_flag
    !ok_done_value
    !ok_len_after
    !ok_empty_backing_len
    !ok_empty_next_flag
    !ok_empty_next
    !ok_empty_iter_empty
    !iter
    !empty_iter
    br ok -> L_VEC_INTO_ITER_OK, L_VEC_INTO_ITER_FAIL

L_VEC_INTO_ITER_FAIL:
    !ok
    panic(10707)

L_VEC_INTO_ITER_OK:
    !ok
    return
