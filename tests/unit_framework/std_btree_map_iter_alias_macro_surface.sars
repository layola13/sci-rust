@import "sa_std/core/slice.sal"
@import "sa_std/core/slice.sars"
@import "sa_std/vec.sars"
@import "sa_std/collections/btree_map.sars"

@const KEY_ALPHA = utf8:"alpha"
@const KEY_BRAVO = utf8:"bravo"
@const KEY_CHARLIE = utf8:"charlie"

@test "sa_std btree_map eager iter aliases"():
L_ENTRY:
    alpha = alloc Slice_SIZE
    bravo = alloc Slice_SIZE
    charlie = alloc Slice_SIZE
    EXPAND SLICE_NEW alpha, &KEY_ALPHA, 5
    EXPAND SLICE_NEW bravo, &KEY_BRAVO, 5
    EXPAND SLICE_NEW charlie, &KEY_CHARLIE, 7

    EXPAND BTREE_MAP_NEW map
    EXPAND BTREE_MAP_INSERT map, charlie, 30
    EXPAND BTREE_MAP_INSERT map, alpha, 10
    EXPAND BTREE_MAP_INSERT map, bravo, 20

    EXPAND BTREE_MAP_ITER iter_vec, map
    EXPAND BTREE_MAP_ITER_MUT_PTRS iter_mut_vec, map
    EXPAND VEC_LEN iter_len, iter_vec
    EXPAND VEC_LEN iter_mut_len, iter_mut_vec

    EXPAND VEC_GET_U64 iter_alpha_ptr_bits, iter_vec, 0
    EXPAND VEC_GET_U64 iter_alpha_len, iter_vec, 1
    EXPAND VEC_GET_U64 iter_alpha_value, iter_vec, 2
    EXPAND VEC_GET_U64 iter_bravo_ptr_bits, iter_vec, 3
    EXPAND VEC_GET_U64 iter_bravo_len, iter_vec, 4
    EXPAND VEC_GET_U64 iter_bravo_value, iter_vec, 5
    EXPAND VEC_GET_U64 iter_charlie_ptr_bits, iter_vec, 6
    EXPAND VEC_GET_U64 iter_charlie_len, iter_vec, 7
    EXPAND VEC_GET_U64 iter_charlie_value, iter_vec, 8

    alpha_ptr = load alpha+Slice_ptr as ptr
    bravo_ptr = load bravo+Slice_ptr as ptr
    charlie_ptr = load charlie+Slice_ptr as ptr
    alpha_ptr_bits = bitcast alpha_ptr as u64
    bravo_ptr_bits = bitcast bravo_ptr as u64
    charlie_ptr_bits = bitcast charlie_ptr as u64

    EXPAND VEC_GET_U64 iter_mut_alpha_ptr_bits, iter_mut_vec, 0
    EXPAND VEC_GET_U64 iter_mut_alpha_len, iter_mut_vec, 1
    EXPAND VEC_GET_U64 iter_mut_alpha_value_ptr_bits, iter_mut_vec, 2
    EXPAND VEC_GET_U64 iter_mut_bravo_ptr_bits, iter_mut_vec, 3
    EXPAND VEC_GET_U64 iter_mut_bravo_len, iter_mut_vec, 4
    EXPAND VEC_GET_U64 iter_mut_bravo_value_ptr_bits, iter_mut_vec, 5
    iter_mut_bravo_value_ptr = bitcast iter_mut_bravo_value_ptr_bits as ptr
    store iter_mut_bravo_value_ptr+0, 25 as u64
    EXPAND BTREE_MAP_GET bravo_after_mut, map, bravo

    EXPAND BTREE_MAP_NEW empty_map
    EXPAND BTREE_MAP_ITER empty_iter, empty_map
    EXPAND BTREE_MAP_ITER_MUT_PTRS empty_iter_mut, empty_map
    EXPAND VEC_LEN empty_iter_len, empty_iter
    EXPAND VEC_LEN empty_iter_mut_len, empty_iter_mut

    ok_iter_len = eq iter_len, 9
    ok_iter_mut_len = eq iter_mut_len, 9
    ok_iter_alpha_ptr = eq iter_alpha_ptr_bits, alpha_ptr_bits
    ok_iter_alpha_len = eq iter_alpha_len, 5
    ok_iter_alpha_value = eq iter_alpha_value, 10
    ok_iter_bravo_ptr = eq iter_bravo_ptr_bits, bravo_ptr_bits
    ok_iter_bravo_len = eq iter_bravo_len, 5
    ok_iter_bravo_value = eq iter_bravo_value, 20
    ok_iter_charlie_ptr = eq iter_charlie_ptr_bits, charlie_ptr_bits
    ok_iter_charlie_len = eq iter_charlie_len, 7
    ok_iter_charlie_value = eq iter_charlie_value, 30
    ok_iter_mut_alpha_ptr = eq iter_mut_alpha_ptr_bits, alpha_ptr_bits
    ok_iter_mut_alpha_len = eq iter_mut_alpha_len, 5
    ok_iter_mut_alpha_value_ptr = ne iter_mut_alpha_value_ptr_bits, 0
    ok_iter_mut_bravo_ptr = eq iter_mut_bravo_ptr_bits, bravo_ptr_bits
    ok_iter_mut_bravo_len = eq iter_mut_bravo_len, 5
    ok_iter_mut_bravo_value_ptr = ne iter_mut_bravo_value_ptr_bits, 0
    ok_bravo_after_mut = eq bravo_after_mut, 25
    ok_empty_iter = eq empty_iter_len, 0
    ok_empty_iter_mut = eq empty_iter_mut_len, 0

    ok01 = and ok_iter_len, ok_iter_mut_len
    ok02 = and ok01, ok_iter_alpha_ptr
    ok03 = and ok02, ok_iter_alpha_len
    ok04 = and ok03, ok_iter_alpha_value
    ok05 = and ok04, ok_iter_bravo_ptr
    ok06 = and ok05, ok_iter_bravo_len
    ok07 = and ok06, ok_iter_bravo_value
    ok08 = and ok07, ok_iter_charlie_ptr
    ok09 = and ok08, ok_iter_charlie_len
    ok10 = and ok09, ok_iter_charlie_value
    ok11 = and ok10, ok_iter_mut_alpha_ptr
    ok12 = and ok11, ok_iter_mut_alpha_len
    ok13 = and ok12, ok_iter_mut_alpha_value_ptr
    ok14 = and ok13, ok_iter_mut_bravo_ptr
    ok15 = and ok14, ok_iter_mut_bravo_len
    ok16 = and ok15, ok_iter_mut_bravo_value_ptr
    ok17 = and ok16, ok_bravo_after_mut
    ok18 = and ok17, ok_empty_iter
    ok = and ok18, ok_empty_iter_mut

    !iter_vec
    !iter_mut_vec
    !iter_len
    !iter_mut_len
    !iter_alpha_ptr_bits
    !iter_alpha_len
    !iter_alpha_value
    !iter_bravo_ptr_bits
    !iter_bravo_len
    !iter_bravo_value
    !iter_charlie_ptr_bits
    !iter_charlie_len
    !iter_charlie_value
    !alpha_ptr
    !bravo_ptr
    !charlie_ptr
    !alpha_ptr_bits
    !bravo_ptr_bits
    !charlie_ptr_bits
    !iter_mut_alpha_ptr_bits
    !iter_mut_alpha_len
    !iter_mut_alpha_value_ptr_bits
    !iter_mut_bravo_ptr_bits
    !iter_mut_bravo_len
    !iter_mut_bravo_value_ptr_bits
    !iter_mut_bravo_value_ptr
    !bravo_after_mut
    !empty_iter
    !empty_iter_mut
    !empty_iter_len
    !empty_iter_mut_len
    !ok_iter_len
    !ok_iter_mut_len
    !ok_iter_alpha_ptr
    !ok_iter_alpha_len
    !ok_iter_alpha_value
    !ok_iter_bravo_ptr
    !ok_iter_bravo_len
    !ok_iter_bravo_value
    !ok_iter_charlie_ptr
    !ok_iter_charlie_len
    !ok_iter_charlie_value
    !ok_iter_mut_alpha_ptr
    !ok_iter_mut_alpha_len
    !ok_iter_mut_alpha_value_ptr
    !ok_iter_mut_bravo_ptr
    !ok_iter_mut_bravo_len
    !ok_iter_mut_bravo_value_ptr
    !ok_bravo_after_mut
    !ok_empty_iter
    !ok_empty_iter_mut
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !charlie
    !bravo
    !alpha
    br ok -> L_OK, L_FAIL

L_OK:
    EXPAND BTREE_MAP_FREE empty_map
    EXPAND BTREE_MAP_FREE map
    return 0

L_FAIL:
    panic(10808)
