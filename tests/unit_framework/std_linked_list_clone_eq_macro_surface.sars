@import "sa_std/collections/linked_list.sars"

@test "sa_std linked_list clone eq"():
L_ENTRY:
    EXPAND LINKED_LIST_NEW a
    EXPAND LINKED_LIST_PUSH_BACK a, 1
    EXPAND LINKED_LIST_PUSH_BACK a, 2
    EXPAND LINKED_LIST_CLONE b, a
    EXPAND LINKED_LIST_EQ eq1, a, b
    EXPAND LINKED_LIST_PUSH_BACK b, 3
    EXPAND LINKED_LIST_EQ eq2, a, b
    EXPAND LINKED_LIST_NE ne1, a, b
    EXPAND LINKED_LIST_LEN alen, a
    EXPAND LINKED_LIST_LEN blen, b
    EXPAND LINKED_LIST_FREE a
    EXPAND LINKED_LIST_FREE b

    x = eq eq1, 1
    y = eq eq2, 0
    z = eq ne1, 1
    u = eq alen, 2
    v = eq blen, 3
    ok01 = and x, y
    ok02 = and ok01, z
    ok03 = and ok02, u
    ok = and ok03, v
    !eq1
    !eq2
    !ne1
    !alen
    !blen
    !x
    !y
    !z
    !u
    !v
    !ok01
    !ok02
    !ok03
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10916)
