@import "sa_std/num.sars"

@test "sa_std WrappingU32 arithmetic macro surface"():
L_ENTRY:
    lhs = stack_alloc WrappingU32_SIZE
    rhs = stack_alloc WrappingU32_SIZE
    out = stack_alloc WrappingU32_SIZE

    EXPAND WRAPPING_U32_NEW lhs, 4294967294
    EXPAND WRAPPING_U32_NEW rhs, 5
    EXPAND WRAPPING_U32_ADD out, lhs, rhs
    EXPAND WRAPPING_U32_GET add_value, out

    EXPAND WRAPPING_U32_NEW lhs, 2
    EXPAND WRAPPING_U32_NEW rhs, 5
    EXPAND WRAPPING_U32_SUB out, lhs, rhs
    EXPAND WRAPPING_U32_GET sub_value, out

    EXPAND WRAPPING_U32_NEW lhs, 4294967295
    EXPAND WRAPPING_U32_NEW rhs, 3
    EXPAND WRAPPING_U32_MUL out, lhs, rhs
    EXPAND WRAPPING_U32_GET mul_value, out

    EXPAND WRAPPING_U32_SET out, 4294967299
    EXPAND WRAPPING_U32_GET set_value, out

    ok01 = eq add_value, 3
    ok02 = eq sub_value, 4294967293
    ok03 = eq mul_value, 4294967293
    ok04 = eq set_value, 3
    chain01 = and ok01, ok02
    chain02 = and chain01, ok03
    ok = and chain02, ok04

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(10680)

L_PASS:
    return 0
