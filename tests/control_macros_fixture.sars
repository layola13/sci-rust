@import "sa_std/control.sal"
@import "sa_std/core/result.sars"

@main() -> i32:
L_ENTRY:
    // ── IF_ELSE（then 路径）──
    c1 = eq 1, 1
    EXPAND IF_ELSE c1, L_IF_T1, L_IF_E1
L_IF_T1:
    !c1
    r1 = add 0, 10
    jmp L_IF_M1
L_IF_E1:
    !c1
    r1 = add 0, 20
    jmp L_IF_M1
L_IF_M1:
    ok_if1 = eq r1, 10
    !r1
    // ── IF_ELSE（else 路径）──
    c2 = eq 1, 2
    EXPAND IF_ELSE c2, L_IF_T2, L_IF_E2
L_IF_T2:
    !c2
    r2 = add 0, 10
    jmp L_IF_M2
L_IF_E2:
    !c2
    r2 = add 0, 20
    jmp L_IF_M2
L_IF_M2:
    ok_if2 = eq r2, 20
    !r2
    // ── SELECT（三元）──
    cs = eq 1, 1
    EXPAND SELECT s1, cs, 100, 200
    !cs
    ok_sel = eq s1, 100
    !s1
    // ── FOR 三件套：sum 0..10 = 45 ──
    EXPAND FOR_INIT i, 0
    sum = add 0, 0
L_FHD:
    EXPAND FOR_CHECK i, 10, L_FBD, L_FEX
L_FBD:
    sum = add sum, i
    EXPAND FOR_NEXT i, 1, L_FHD
L_FEX:
    ok_for = eq sum, 45
    !sum
    !i
    // ── FOR_RANGE 一体版：sum 0..5 = 10 ──
    sum2 = add 0, 0
    EXPAND FOR_RANGE j, 0, 5, L_GHD, L_GBD, L_GEX
L_GBD:
    sum2 = add sum2, j
    EXPAND FOR_NEXT j, 1, L_GHD
L_GEX:
    ok_for2 = eq sum2, 10
    !sum2
    !j
    // ── SWITCH_2：v=2 走第二臂 ──
    v = add 0, 2
    EXPAND SWITCH_2 v, 1, L_S1, 2, L_S2, L_SD
L_S1:
    sw = add 0, 1
    jmp L_SM
L_S2:
    sw = add 0, 2
    jmp L_SM
L_SD:
    sw = add 0, 0
    jmp L_SM
L_SM:
    !v
    ok_sw = eq sw, 2
    !sw
    // ── SWITCH_3：v=30 走第三臂 ──
    w = add 0, 30
    EXPAND SWITCH_3 w, 10, L_W1, 20, L_W2, 30, L_W3, L_WD
L_W1:
    sw3 = add 0, 1
    jmp L_WM
L_W2:
    sw3 = add 0, 2
    jmp L_WM
L_W3:
    sw3 = add 0, 3
    jmp L_WM
L_WD:
    sw3 = add 0, 0
    jmp L_WM
L_WM:
    !w
    ok_sw3 = eq sw3, 3
    !sw3
    // ── TRY_QMARK（ok 路径）──
    EXPAND RESULT_NEW_OK res1, 42
    EXPAND TRY_QMARK val1, res1, err1, L_TQ_OK1, L_TQ_ERR1
L_TQ_OK1:
    t1 = eq val1, 42
    !val1
    !res1
    jmp L_TQ_NEXT1
L_TQ_ERR1:
    !err1
    !res1
    t1 = eq 0, 1
    jmp L_TQ_NEXT1
L_TQ_NEXT1:
    // ── TRY_QMARK（err 路径）──
    EXPAND RESULT_NEW_ERR res2, 7
    EXPAND TRY_QMARK val2, res2, err2, L_TQ_OK2, L_TQ_ERR2
L_TQ_OK2:
    !val2
    !res2
    t2 = eq 0, 1
    jmp L_TQ_NEXT2
L_TQ_ERR2:
    t2 = eq err2, 7
    !err2
    !res2
    jmp L_TQ_NEXT2
L_TQ_NEXT2:
    // ── CATCH_CODE：7 走第二臂 ──
    ec = add 0, 7
    EXPAND CATCH_CODE ec, 5, L_C1, 7, L_C2, L_CD
L_C1:
    cc = add 0, 1
    jmp L_CM
L_C2:
    cc = add 0, 2
    jmp L_CM
L_CD:
    cc = add 0, 0
    jmp L_CM
L_CM:
    !ec
    ok_cc = eq cc, 2
    !cc
    // ── 收敛 ──
    a01 = and ok_if1, ok_if2
    a02 = and a01, ok_sel
    a03 = and a02, ok_for
    a04 = and a03, ok_for2
    a05 = and a04, ok_sw
    a06 = and a05, ok_sw3
    a07 = and a06, t1
    a08 = and a07, t2
    ok = and a08, ok_cc
    !ok_if1
    !ok_if2
    !ok_sel
    !ok_for
    !ok_for2
    !ok_sw
    !ok_sw3
    !t1
    !t2
    !ok_cc
    !a01
    !a02
    !a03
    !a04
    !a05
    !a06
    !a07
    !a08
    br ok -> L_OK, L_ERR

L_OK:
    !ok
    return 0

L_ERR:
    !ok
    return 1
