    EXPAND PATH_BUF_AS_PATH __pb_is_dir_view_%path_buf, %path_buf
    EXPAND PATH_IS_DIR %out_flag, __pb_is_dir_view_%path_buf
    !__pb_is_dir_view_%path_buf
[END_MACRO]

[MACRO] PATH_BUF_CAPACITY_REMAINING %out_remaining, %path_buf
    EXPAND STRING_BUF_CAPACITY_REMAINING %out_remaining, %path_buf
