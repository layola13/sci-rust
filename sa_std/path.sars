    __path_open_write_len_%out_status = load %path_slice+Slice_len as u64
    EXPAND FS_OPEN_WRITE %out_status, %out_file, __path_open_write_ptr_%out_status, __path_open_write_len_%out_status, %truncate
    !__path_open_write_len_%out_status
    !__path_open_write_ptr_%out_status
[END_MACRO]

