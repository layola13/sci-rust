    jmp L_PATH_ANCESTOR_END_%out_ok

L_PATH_ANCESTOR_SCAN_EOF_MISS_%out_ok:
    !__path_ancestor_target_hit_%out_ok
    !__path_ancestor_current_%out_ok
    !__path_ancestor_in_%out_ok
    jmp L_PATH_ANCESTOR_SCAN_MISS_AFTER_EOF_%out_ok

L_PATH_ANCESTOR_SCAN_MISS_%out_ok:
    !__path_ancestor_in_%out_ok
    jmp L_PATH_ANCESTOR_SCAN_MISS_AFTER_EOF_%out_ok

L_PATH_ANCESTOR_SCAN_MISS_AFTER_EOF_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0
    !__path_ancestor_done_%out_ok
    !__path_ancestor_scan_%out_ok
    !__path_ancestor_ptr_%out_ok
    !__path_ancestor_target_%out_ok
    !__path_ancestor_terminal_%out_ok
    !__path_ancestor_fits_%out_ok
    !__path_ancestor_is_self_%out_ok
    !__path_ancestor_len_%out_ok
    !__path_ancestor_components_%out_ok
    jmp L_PATH_ANCESTOR_END_%out_ok

L_PATH_ANCESTOR_TERMINAL_%out_ok:
    EXPAND PATH_IS_ABSOLUTE __path_ancestor_abs_%out_ok, %path_slice
    br __path_ancestor_abs_%out_ok -> L_PATH_ANCESTOR_ROOT_%out_ok, L_PATH_ANCESTOR_EMPTY_%out_ok

L_PATH_ANCESTOR_ROOT_%out_ok:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, 1
    %out_ok = add 0, 1
    !__path_ancestor_abs_%out_ok
    !__path_ancestor_terminal_%out_ok
    !__path_ancestor_fits_%out_ok
    !__path_ancestor_is_self_%out_ok
    !__path_ancestor_len_%out_ok
    !__path_ancestor_components_%out_ok
    jmp L_PATH_ANCESTOR_END_%out_ok

L_PATH_ANCESTOR_EMPTY_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 1
    !__path_ancestor_abs_%out_ok
    !__path_ancestor_terminal_%out_ok
    !__path_ancestor_fits_%out_ok
    !__path_ancestor_is_self_%out_ok
    !__path_ancestor_len_%out_ok
    !__path_ancestor_components_%out_ok
    jmp L_PATH_ANCESTOR_END_%out_ok

L_PATH_ANCESTOR_SELF_%out_ok:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_ancestor_len_%out_ok
    %out_ok = add 0, 1
    !__path_ancestor_len_%out_ok
    !__path_ancestor_is_self_%out_ok
    !__path_ancestor_components_%out_ok
    jmp L_PATH_ANCESTOR_END_%out_ok

L_PATH_ANCESTOR_MISS_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0
    !__path_ancestor_fits_%out_ok
    !__path_ancestor_is_self_%out_ok
    !__path_ancestor_len_%out_ok
    !__path_ancestor_components_%out_ok

L_PATH_ANCESTOR_END_%out_ok:
[END_MACRO]

// Rust method-name alias over PATH_TRY_ANCESTOR_AT.
[MACRO] PATH_ANCESTOR_AT %out_ok, %out_slice, %path_slice, %ancestor_index
    EXPAND PATH_TRY_ANCESTOR_AT %out_ok, %out_slice, %path_slice, %ancestor_index
[END_MACRO]


// Concrete owned PathBuf facade over StringBuf / Vec-u8 storage.
// Path queries reuse the existing PATH_* Slice helpers via PATH_BUF_AS_PATH.

[MACRO] PATH_BUF_NEW %out_path_buf
    EXPAND STRING_BUF_NEW %out_path_buf
[END_MACRO]

[MACRO] PATH_BUF_DEFAULT %out_path_buf
    EXPAND PATH_BUF_NEW %out_path_buf
[END_MACRO]

[MACRO] PATH_BUF_WITH_CAPACITY %out_path_buf, %capacity
    EXPAND STRING_BUF_WITH_CAPACITY %out_path_buf, %capacity
[END_MACRO]

[MACRO] PATH_BUF_TRY_WITH_CAPACITY %out_ok, %out_path_buf, %capacity
    EXPAND STRING_BUF_TRY_WITH_CAPACITY %out_ok, %out_path_buf, %capacity
[END_MACRO]

[MACRO] PATH_BUF_FROM_PATH %out_path_buf, %path_slice
    EXPAND STRING_BUF_FROM_STR %out_path_buf, %path_slice
[END_MACRO]

[MACRO] PATH_BUF_FROM_STR %out_path_buf, %path_slice
    EXPAND PATH_BUF_FROM_PATH %out_path_buf, %path_slice
[END_MACRO]

[MACRO] PATH_BUF_FREE %path_buf
    EXPAND STRING_BUF_FREE %path_buf
[END_MACRO]

[MACRO] PATH_BUF_CLEAR %path_buf
    EXPAND STRING_BUF_CLEAR %path_buf
[END_MACRO]

[MACRO] PATH_BUF_LEN %out_len, %path_buf
    EXPAND STRING_BUF_LEN %out_len, %path_buf
[END_MACRO]

[MACRO] PATH_BUF_CAPACITY %out_cap, %path_buf
    EXPAND STRING_BUF_CAPACITY %out_cap, %path_buf
[END_MACRO]

[MACRO] PATH_BUF_IS_EMPTY %out_bool, %path_buf
    EXPAND STRING_BUF_IS_EMPTY %out_bool, %path_buf
[END_MACRO]

[MACRO] PATH_BUF_RESERVE %path_buf, %additional
    EXPAND STRING_BUF_RESERVE %path_buf, %additional
[END_MACRO]

[MACRO] PATH_BUF_CLONE %out_path_buf, %path_buf
    EXPAND STRING_BUF_CLONE %out_path_buf, %path_buf
[END_MACRO]

[MACRO] PATH_BUF_AS_PATH %out_slice, %path_buf
    EXPAND STRING_BUF_AS_STR %out_slice, %path_buf
[END_MACRO]

[MACRO] PATH_BUF_AS_STR %out_slice, %path_buf
    EXPAND PATH_BUF_AS_PATH %out_slice, %path_buf
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_PATH_BUF %hasher, %path_buf
    EXPAND PATH_BUF_AS_PATH __path_buf_hash_view_%hasher, %path_buf
    EXPAND DEFAULT_HASHER_WRITE_PATH %hasher, __path_buf_hash_view_%hasher
    !__path_buf_hash_view_%hasher
[END_MACRO]

[MACRO] PATH_BUF_HASH %out_hash, %path_buf
    EXPAND PATH_BUF_AS_PATH __path_buf_hash_view_%out_hash, %path_buf
    EXPAND PATH_HASH %out_hash, __path_buf_hash_view_%out_hash
    !__path_buf_hash_view_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_PATH_BUF %out_hash, %builder, %path_buf
    __build_hash_one_path_buf_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_path_buf_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_PATH_BUF __build_hash_one_path_buf_hasher_%out_hash, %path_buf
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_path_buf_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_PATH_BUF %out_hash, %state, %path_buf
    __random_state_hash_one_path_buf_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_path_buf_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_PATH_BUF __random_state_hash_one_path_buf_hasher_%out_hash, %path_buf
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_path_buf_hasher_%out_hash
[END_MACRO]

[MACRO] PATH_BUF_PUSH %path_buf, %child_slice
    EXPAND PATH_BUF_AS_PATH __pb_push_view_%path_buf, %path_buf
    EXPAND PATH_JOIN __pb_push_joined_%path_buf, __pb_push_view_%path_buf, %child_slice
    EXPAND STRING_BUF_FROM_STR __pb_push_tmp_%path_buf, __pb_push_joined_%path_buf
    EXPAND STRING_BUF_CLONE_FROM %path_buf, __pb_push_tmp_%path_buf
    EXPAND STRING_BUF_FREE __pb_push_tmp_%path_buf
    !__pb_push_joined_%path_buf
    !__pb_push_view_%path_buf
[END_MACRO]

[MACRO] PATH_BUF_POP %out_ok, %path_buf
    EXPAND PATH_BUF_AS_PATH __pb_pop_view_%out_ok, %path_buf
    EXPAND PATH_TRY_PARENT __pb_pop_has_%out_ok, __pb_pop_parent_%out_ok, __pb_pop_view_%out_ok
    br __pb_pop_has_%out_ok -> L_PB_POP_APPLY_%out_ok, L_PB_POP_FAIL_%out_ok

L_PB_POP_APPLY_%out_ok:
    EXPAND STRING_BUF_CLEAR %path_buf
    EXPAND STRING_BUF_PUSH_STR %path_buf, __pb_pop_parent_%out_ok
    %out_ok = add 0, 1
    !__pb_pop_parent_%out_ok
    !__pb_pop_has_%out_ok
    !__pb_pop_view_%out_ok
    jmp L_PB_POP_END_%out_ok

L_PB_POP_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__pb_pop_parent_%out_ok
    !__pb_pop_has_%out_ok
    !__pb_pop_view_%out_ok
    jmp L_PB_POP_END_%out_ok

L_PB_POP_END_%out_ok:
[END_MACRO]

[MACRO] PATH_BUF_SET_FILE_NAME %path_buf, %file_name_slice
    EXPAND STRING_BUF_AS_STR __pb_set_name_view_%path_buf, %path_buf
    EXPAND PATH_WITH_FILE_NAME __pb_set_name_new_%path_buf, __pb_set_name_view_%path_buf, %file_name_slice
    EXPAND STRING_BUF_CLEAR %path_buf
    EXPAND STRING_BUF_PUSH_STR %path_buf, __pb_set_name_new_%path_buf
    !__pb_set_name_new_%path_buf
    !__pb_set_name_view_%path_buf
[END_MACRO]

[MACRO] PATH_BUF_SET_EXTENSION %path_buf, %extension_slice
    EXPAND STRING_BUF_AS_STR __pb_set_ext_view_%path_buf, %path_buf
    EXPAND PATH_WITH_EXTENSION __pb_set_ext_new_%path_buf, __pb_set_ext_view_%path_buf, %extension_slice
    EXPAND STRING_BUF_CLEAR %path_buf
    EXPAND STRING_BUF_PUSH_STR %path_buf, __pb_set_ext_new_%path_buf
    !__pb_set_ext_new_%path_buf
    !__pb_set_ext_view_%path_buf
[END_MACRO]

[MACRO] PATH_BUF_PUSH_TRAILING_SEPARATOR %path_buf
    EXPAND STRING_BUF_AS_STR __pb_trail_view_%path_buf, %path_buf
    EXPAND PATH_WITH_TRAILING_SEPARATOR __pb_trail_new_%path_buf, __pb_trail_view_%path_buf
    EXPAND STRING_BUF_CLEAR %path_buf
    EXPAND STRING_BUF_PUSH_STR %path_buf, __pb_trail_new_%path_buf
    !__pb_trail_new_%path_buf
    !__pb_trail_view_%path_buf
[END_MACRO]

[MACRO] PATH_BUF_EXISTS %out_flag, %path_buf
