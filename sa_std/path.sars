[MACRO] PATH_BUF_REMAINING_CAPACITY %out_remaining, %path_buf
    EXPAND PATH_BUF_CAPACITY_REMAINING %out_remaining, %path_buf
[END_MACRO]

[MACRO] PATH_BUF_EXTRA_CAPACITY %out_remaining, %path_buf
    EXPAND PATH_BUF_CAPACITY_REMAINING %out_remaining, %path_buf
[END_MACRO]

[MACRO] PATH_BUF_LIT1 %out_path_buf, %s0
    EXPAND PATH_BUF_FROM_PATH %out_path_buf, %s0
[END_MACRO]

[MACRO] PATH_BUF_LIT2 %out_path_buf, %s0, %s1
    EXPAND PATH_BUF_FROM_PATH %out_path_buf, %s0
    EXPAND PATH_BUF_PUSH %out_path_buf, %s1
[END_MACRO]

[MACRO] PATH_BUF_LIT3 %out_path_buf, %s0, %s1, %s2
