    __path_read_file_len_%out_status = load %path_slice+Slice_len as u64
    EXPAND FS_READ_FILE %out_status, %out_buffer, __path_read_file_ptr_%out_status, __path_read_file_len_%out_status, %max_bytes
    !__path_read_file_len_%out_status
    !__path_read_file_ptr_%out_status
[END_MACRO]

[MACRO] PATH_WRITE_FILE %out_status, %path_slice, %buf, %len
    __path_write_file_ptr_%out_status = load %path_slice+Slice_ptr as ptr
    __path_write_file_len_%out_status = load %path_slice+Slice_len as u64
