// Slice-path filesystem operation aliases over FS_* ptr/len helpers.

[MACRO] PATH_OPEN_READ %out_status, %out_file, %path_slice
    __path_open_read_ptr_%out_status = load %path_slice+Slice_ptr as ptr
    __path_open_read_len_%out_status = load %path_slice+Slice_len as u64
    EXPAND FS_OPEN_READ %out_status, %out_file, __path_open_read_ptr_%out_status, __path_open_read_len_%out_status
    !__path_open_read_len_%out_status
    !__path_open_read_ptr_%out_status
[END_MACRO]

