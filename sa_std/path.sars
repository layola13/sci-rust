// POSIX-like path helpers over Slice values.
// Trailing separators are ignored; callers own the returned Slice and must ! it.
@import "core/slice.sal"
@import "core/slice.sars"
@import "fs.sars"
@import "string.sars"
@import "os/unix_ffi.sars"
@import "num.sars"

@const PATH_SEPARATOR = utf8:"/"

[MACRO] PATH_MAKE_EMPTY %out_slice
    %out_slice = alloc Slice_SIZE
    __path_empty_ptr = 0 as ptr
    __path_empty_len = 0 as u64
    EXPAND SLICE_NEW %out_slice, __path_empty_ptr, __path_empty_len
    !__path_empty_ptr
    !__path_empty_len
[END_MACRO]

[MACRO] PATH_BASENAME %out_slice, %path_slice
    __path_ptr = load %path_slice+Slice_ptr as ptr
    __path_len = load %path_slice+Slice_len as u64
    __path_end_slot = stack_alloc 8
    __path_cursor_slot = stack_alloc 8
    store __path_end_slot+0, __path_len as u64
    __path_is_empty = eq __path_len, 0
    br __path_is_empty -> L_PATH_BASENAME_EMPTY_%out_slice, L_PATH_BASENAME_TRIM_%out_slice

L_PATH_BASENAME_TRIM_%out_slice:
    __path_end = load __path_end_slot+0 as u64
    __path_end_is_zero = eq __path_end, 0
    br __path_end_is_zero -> L_PATH_BASENAME_ROOT_%out_slice, L_PATH_BASENAME_CHECK_%out_slice

L_PATH_BASENAME_CHECK_%out_slice:
    __path_prev_end = sub __path_end, 1
    __path_ch_ip = ptr_add __path_ptr, __path_prev_end
    __path_ch = load __path_ch_ip+0 as u8
    __path_is_slash = eq __path_ch, 47
    br __path_is_slash -> L_PATH_BASENAME_TRIM_NEXT_%out_slice, L_PATH_BASENAME_SCAN_%out_slice

L_PATH_BASENAME_TRIM_NEXT_%out_slice:
    store __path_end_slot+0, __path_prev_end as u64
    !__path_prev_end
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_end
    !__path_end_is_zero
    jmp L_PATH_BASENAME_TRIM_%out_slice

L_PATH_BASENAME_SCAN_%out_slice:
    store __path_cursor_slot+0, __path_end as u64
    !__path_prev_end
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_end_is_zero
    jmp L_PATH_BASENAME_SCAN_LOOP_%out_slice

L_PATH_BASENAME_SCAN_LOOP_%out_slice:
    __path_cursor = load __path_cursor_slot+0 as u64
    __path_cursor_is_zero = eq __path_cursor, 0
    br __path_cursor_is_zero -> L_PATH_BASENAME_NO_SLASH_%out_slice, L_PATH_BASENAME_SCAN_CHECK_%out_slice

L_PATH_BASENAME_SCAN_CHECK_%out_slice:
    __path_prev = sub __path_cursor, 1
    __path_ch_ip = ptr_add __path_ptr, __path_prev
    __path_ch = load __path_ch_ip+0 as u8
    __path_is_slash = eq __path_ch, 47
    br __path_is_slash -> L_PATH_BASENAME_FOUND_%out_slice, L_PATH_BASENAME_SCAN_NEXT_%out_slice

L_PATH_BASENAME_SCAN_NEXT_%out_slice:
    __path_next_cursor = sub __path_cursor, 1
    store __path_cursor_slot+0, __path_next_cursor as u64
    !__path_cursor
    !__path_cursor_is_zero
    !__path_prev
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_next_cursor
    jmp L_PATH_BASENAME_SCAN_LOOP_%out_slice

L_PATH_BASENAME_FOUND_%out_slice:
    __path_start = add __path_cursor, 0
    __path_basename_len = sub __path_end, __path_start
    EXPAND STR_SLICE %out_slice, %path_slice, __path_start, __path_basename_len
    !__path_basename_len
    !__path_cursor
    !__path_cursor_is_zero
    !__path_prev
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_end
    jmp L_PATH_BASENAME_END_%out_slice

L_PATH_BASENAME_NO_SLASH_%out_slice:
    __path_start = 0 as u64
    __path_basename_len = add __path_end, 0
    EXPAND STR_SLICE %out_slice, %path_slice, __path_start, __path_basename_len
    !__path_basename_len
    !__path_cursor
    !__path_cursor_is_zero
    !__path_end
    jmp L_PATH_BASENAME_END_%out_slice

L_PATH_BASENAME_ROOT_%out_slice:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, 1
    !__path_end
    !__path_end_is_zero
    jmp L_PATH_BASENAME_END_%out_slice

L_PATH_BASENAME_EMPTY_%out_slice:
    EXPAND PATH_MAKE_EMPTY %out_slice
    jmp L_PATH_BASENAME_END_%out_slice

L_PATH_BASENAME_END_%out_slice:
    !__path_ptr
    !__path_len
    !__path_is_empty
[END_MACRO]

[MACRO] PATH_DIRNAME %out_slice, %path_slice
    __path_ptr = load %path_slice+Slice_ptr as ptr
    __path_len = load %path_slice+Slice_len as u64
    __path_end_slot = stack_alloc 8
    __path_cursor_slot = stack_alloc 8
    store __path_end_slot+0, __path_len as u64
    __path_is_empty = eq __path_len, 0
    br __path_is_empty -> L_PATH_DIRNAME_EMPTY, L_PATH_DIRNAME_TRIM

L_PATH_DIRNAME_TRIM:
    __path_end = load __path_end_slot+0 as u64
    __path_end_is_zero = eq __path_end, 0
    br __path_end_is_zero -> L_PATH_DIRNAME_ROOT_FROM_TRIM, L_PATH_DIRNAME_CHECK

L_PATH_DIRNAME_CHECK:
    __path_prev_end = sub __path_end, 1
    __path_ch_ip = ptr_add __path_ptr, __path_prev_end
    __path_ch = load __path_ch_ip+0 as u8
    __path_is_slash = eq __path_ch, 47
    br __path_is_slash -> L_PATH_DIRNAME_TRIM_NEXT, L_PATH_DIRNAME_SCAN

L_PATH_DIRNAME_TRIM_NEXT:
    store __path_end_slot+0, __path_prev_end as u64
    !__path_prev_end
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_end
    !__path_end_is_zero
    jmp L_PATH_DIRNAME_TRIM

L_PATH_DIRNAME_SCAN:
    store __path_cursor_slot+0, __path_end as u64
    !__path_prev_end
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_end_is_zero
    jmp L_PATH_DIRNAME_SCAN_LOOP

L_PATH_DIRNAME_SCAN_LOOP:
    __path_cursor = load __path_cursor_slot+0 as u64
    __path_cursor_is_zero = eq __path_cursor, 0
    br __path_cursor_is_zero -> L_PATH_DIRNAME_NO_SLASH, L_PATH_DIRNAME_SCAN_CHECK

L_PATH_DIRNAME_SCAN_CHECK:
    __path_prev = sub __path_cursor, 1
    __path_ch_ip = ptr_add __path_ptr, __path_prev
    __path_ch = load __path_ch_ip+0 as u8
    __path_is_slash = eq __path_ch, 47
    br __path_is_slash -> L_PATH_DIRNAME_FOUND, L_PATH_DIRNAME_SCAN_NEXT

L_PATH_DIRNAME_SCAN_NEXT:
    __path_next_cursor = sub __path_cursor, 1
    store __path_cursor_slot+0, __path_next_cursor as u64
    !__path_cursor
    !__path_cursor_is_zero
    !__path_prev
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_next_cursor
    jmp L_PATH_DIRNAME_SCAN_LOOP

L_PATH_DIRNAME_FOUND:
    __path_slash_is_root = eq __path_prev, 0
    br __path_slash_is_root -> L_PATH_DIRNAME_ROOT_FROM_SCAN, L_PATH_DIRNAME_PREFIX

L_PATH_DIRNAME_PREFIX:
    __path_dirname_len = add __path_prev, 0
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_dirname_len
    !__path_dirname_len
    !__path_slash_is_root
    !__path_cursor
    !__path_cursor_is_zero
    !__path_prev
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_end
    jmp L_PATH_DIRNAME_END

L_PATH_DIRNAME_ROOT_FROM_SCAN:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, 1
    !__path_slash_is_root
    !__path_cursor
    !__path_cursor_is_zero
    !__path_prev
    !__path_ch_ip
    !__path_ch
    !__path_is_slash
    !__path_end
    jmp L_PATH_DIRNAME_END

L_PATH_DIRNAME_NO_SLASH:
    EXPAND PATH_MAKE_EMPTY %out_slice
    !__path_cursor
    !__path_cursor_is_zero
    !__path_end
    jmp L_PATH_DIRNAME_END

L_PATH_DIRNAME_ROOT_FROM_TRIM:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, 1
    !__path_end
    !__path_end_is_zero
    jmp L_PATH_DIRNAME_END

L_PATH_DIRNAME_EMPTY:
    EXPAND PATH_MAKE_EMPTY %out_slice
    jmp L_PATH_DIRNAME_END

L_PATH_DIRNAME_END:
    !__path_ptr
    !__path_len
    !__path_is_empty
[END_MACRO]

[MACRO] PATH_STEM %out_slice, %path_slice
    EXPAND PATH_BASENAME __path_base_%out_slice, %path_slice
    __path_base_ptr = load __path_base_%out_slice+Slice_ptr as ptr
    __path_base_len = load __path_base_%out_slice+Slice_len as u64
    __path_dot_cursor_slot = stack_alloc 8
    store __path_dot_cursor_slot+0, __path_base_len as u64
    jmp L_PATH_STEM_SCAN_%out_slice

L_PATH_STEM_SCAN_%out_slice:
    __path_dot_cursor = load __path_dot_cursor_slot+0 as u64
    __path_dot_cursor_is_zero = eq __path_dot_cursor, 0
    br __path_dot_cursor_is_zero -> L_PATH_STEM_NO_DOT_EMPTY_%out_slice, L_PATH_STEM_SCAN_CHECK_%out_slice

L_PATH_STEM_SCAN_CHECK_%out_slice:
    __path_dot_prev = sub __path_dot_cursor, 1
    __path_dot_ch_ip = ptr_add __path_base_ptr, __path_dot_prev
    __path_dot_ch = load __path_dot_ch_ip+0 as u8
    __path_is_dot = eq __path_dot_ch, 46
    br __path_is_dot -> L_PATH_STEM_DOT_%out_slice, L_PATH_STEM_SCAN_NEXT_%out_slice

L_PATH_STEM_SCAN_NEXT_%out_slice:
    __path_next_dot_cursor = sub __path_dot_cursor, 1
    store __path_dot_cursor_slot+0, __path_next_dot_cursor as u64
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_dot_prev
    !__path_dot_ch_ip
    !__path_dot_ch
    !__path_is_dot
    !__path_next_dot_cursor
    jmp L_PATH_STEM_SCAN_%out_slice

L_PATH_STEM_DOT_%out_slice:
    __path_leading_dot = eq __path_dot_prev, 0
    br __path_leading_dot -> L_PATH_STEM_NO_DOT_LEADING_%out_slice, L_PATH_STEM_VALID_%out_slice

L_PATH_STEM_VALID_%out_slice:
    __path_stem_len = add __path_dot_prev, 0
    EXPAND STR_SLICE %out_slice, __path_base_%out_slice, 0, __path_stem_len
    !__path_stem_len
    !__path_leading_dot
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_dot_prev
    !__path_dot_ch_ip
    !__path_dot_ch
    !__path_is_dot
    !__path_base_ptr
    !__path_base_len
    !__path_base_%out_slice
    jmp L_PATH_STEM_END_%out_slice

L_PATH_STEM_NO_DOT_EMPTY_%out_slice:
    EXPAND STR_SLICE %out_slice, __path_base_%out_slice, 0, __path_base_len
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_base_ptr
    !__path_base_len
    !__path_base_%out_slice
    jmp L_PATH_STEM_END_%out_slice

L_PATH_STEM_NO_DOT_LEADING_%out_slice:
    EXPAND STR_SLICE %out_slice, __path_base_%out_slice, 0, __path_base_len
    !__path_leading_dot
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_dot_prev
    !__path_dot_ch_ip
    !__path_dot_ch
    !__path_is_dot
    !__path_base_ptr
    !__path_base_len
    !__path_base_%out_slice
    jmp L_PATH_STEM_END_%out_slice

L_PATH_STEM_END_%out_slice:
[END_MACRO]

[MACRO] PATH_EXT %out_slice, %path_slice
    EXPAND PATH_BASENAME __path_base_%out_slice, %path_slice
    __path_base_ptr = load __path_base_%out_slice+Slice_ptr as ptr
    __path_base_len = load __path_base_%out_slice+Slice_len as u64
    __path_dot_cursor_slot = stack_alloc 8
    store __path_dot_cursor_slot+0, __path_base_len as u64
    jmp L_PATH_EXT_SCAN_%out_slice

L_PATH_EXT_SCAN_%out_slice:
    __path_dot_cursor = load __path_dot_cursor_slot+0 as u64
    __path_dot_cursor_is_zero = eq __path_dot_cursor, 0
    br __path_dot_cursor_is_zero -> L_PATH_EXT_NO_DOT_EMPTY_%out_slice, L_PATH_EXT_SCAN_CHECK_%out_slice

L_PATH_EXT_SCAN_CHECK_%out_slice:
    __path_dot_prev = sub __path_dot_cursor, 1
    __path_dot_ch_ip = ptr_add __path_base_ptr, __path_dot_prev
    __path_dot_ch = load __path_dot_ch_ip+0 as u8
    __path_is_dot = eq __path_dot_ch, 46
    br __path_is_dot -> L_PATH_EXT_DOT_%out_slice, L_PATH_EXT_SCAN_NEXT_%out_slice

L_PATH_EXT_SCAN_NEXT_%out_slice:
    __path_next_dot_cursor = sub __path_dot_cursor, 1
    store __path_dot_cursor_slot+0, __path_next_dot_cursor as u64
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_dot_prev
    !__path_dot_ch_ip
    !__path_dot_ch
    !__path_is_dot
    !__path_next_dot_cursor
    jmp L_PATH_EXT_SCAN_%out_slice

L_PATH_EXT_DOT_%out_slice:
    __path_leading_dot = eq __path_dot_prev, 0
    br __path_leading_dot -> L_PATH_EXT_NO_DOT_LEADING_%out_slice, L_PATH_EXT_TRAILING_%out_slice

L_PATH_EXT_TRAILING_%out_slice:
    __path_trailing_dot = eq __path_dot_cursor, __path_base_len
    br __path_trailing_dot -> L_PATH_EXT_NO_DOT_TRAILING_%out_slice, L_PATH_EXT_VALID_%out_slice

L_PATH_EXT_VALID_%out_slice:
    __path_ext_start = add __path_dot_prev, 1
    __path_ext_len = sub __path_base_len, __path_ext_start
    EXPAND STR_SLICE %out_slice, __path_base_%out_slice, __path_ext_start, __path_ext_len
    !__path_ext_start
    !__path_ext_len
    !__path_trailing_dot
    !__path_leading_dot
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_dot_prev
    !__path_dot_ch_ip
    !__path_dot_ch
    !__path_is_dot
    !__path_base_ptr
    !__path_base_len
    !__path_base_%out_slice
    jmp L_PATH_EXT_END_%out_slice

L_PATH_EXT_NO_DOT_EMPTY_%out_slice:
    EXPAND PATH_MAKE_EMPTY %out_slice
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_base_ptr
    !__path_base_len
    !__path_base_%out_slice
    jmp L_PATH_EXT_END_%out_slice

L_PATH_EXT_NO_DOT_LEADING_%out_slice:
    EXPAND PATH_MAKE_EMPTY %out_slice
    !__path_leading_dot
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_dot_prev
    !__path_dot_ch_ip
    !__path_dot_ch
    !__path_is_dot
    !__path_base_ptr
    !__path_base_len
    !__path_base_%out_slice
    jmp L_PATH_EXT_END_%out_slice

L_PATH_EXT_NO_DOT_TRAILING_%out_slice:
    EXPAND PATH_MAKE_EMPTY %out_slice
    !__path_trailing_dot
    !__path_leading_dot
    !__path_dot_cursor
    !__path_dot_cursor_is_zero
    !__path_dot_prev
    !__path_dot_ch_ip
    !__path_dot_ch
    !__path_is_dot
    !__path_base_ptr
    !__path_base_len
    !__path_base_%out_slice
    jmp L_PATH_EXT_END_%out_slice

L_PATH_EXT_END_%out_slice:
[END_MACRO]

[MACRO] PATH_IS_ABSOLUTE %out_bool, %path_slice
    __path_len_%out_bool = load %path_slice+Slice_len as u64
    __path_empty_%out_bool = eq __path_len_%out_bool, 0
    br __path_empty_%out_bool -> L_PATH_IS_ABSOLUTE_FALSE, L_PATH_IS_ABSOLUTE_CHECK

L_PATH_IS_ABSOLUTE_CHECK:
    __path_ptr_%out_bool = load %path_slice+Slice_ptr as ptr
    __path_first_%out_bool = load __path_ptr_%out_bool+0 as u8
    %out_bool = eq __path_first_%out_bool, 47
    !__path_first_%out_bool
    !__path_ptr_%out_bool
    !__path_empty_%out_bool
    !__path_len_%out_bool
    jmp L_PATH_IS_ABSOLUTE_END

L_PATH_IS_ABSOLUTE_FALSE:
    %out_bool = add 0, 0
    !__path_empty_%out_bool
    !__path_len_%out_bool
    jmp L_PATH_IS_ABSOLUTE_END

L_PATH_IS_ABSOLUTE_END:
[END_MACRO]

[MACRO] PATH_HAS_ROOT %out_bool, %path_slice
    EXPAND PATH_IS_ABSOLUTE %out_bool, %path_slice
[END_MACRO]

[MACRO] PATH_IS_RELATIVE %out_bool, %path_slice
    EXPAND PATH_IS_ABSOLUTE __path_abs_%out_bool, %path_slice
    %out_bool = eq __path_abs_%out_bool, 0
    !__path_abs_%out_bool
[END_MACRO]

[MACRO] PATH_IS_EMPTY %out_bool, %path_slice
    __path_len_%out_bool = load %path_slice+Slice_len as u64
    %out_bool = eq __path_len_%out_bool, 0
    !__path_len_%out_bool
[END_MACRO]

[MACRO] PATH_ENDS_WITH_SEPARATOR %out_bool, %path_slice
    __path_len_%out_bool = load %path_slice+Slice_len as u64
    __path_empty_%out_bool = eq __path_len_%out_bool, 0
    br __path_empty_%out_bool -> L_PATH_ENDS_WITH_SEPARATOR_FALSE, L_PATH_ENDS_WITH_SEPARATOR_CHECK

L_PATH_ENDS_WITH_SEPARATOR_CHECK:
    __path_ptr_%out_bool = load %path_slice+Slice_ptr as ptr
    __path_last_idx_%out_bool = sub __path_len_%out_bool, 1
    __path_last_ptr_%out_bool = ptr_add __path_ptr_%out_bool, __path_last_idx_%out_bool
    __path_last_%out_bool = load __path_last_ptr_%out_bool+0 as u8
    %out_bool = eq __path_last_%out_bool, 47
    !__path_last_%out_bool
    !__path_last_ptr_%out_bool
    !__path_last_idx_%out_bool
    !__path_ptr_%out_bool
    !__path_empty_%out_bool
    !__path_len_%out_bool
    jmp L_PATH_ENDS_WITH_SEPARATOR_END

L_PATH_ENDS_WITH_SEPARATOR_FALSE:
    %out_bool = add 0, 0
    !__path_empty_%out_bool
    !__path_len_%out_bool
    jmp L_PATH_ENDS_WITH_SEPARATOR_END

L_PATH_ENDS_WITH_SEPARATOR_END:
[END_MACRO]

[MACRO] PATH_STARTS_WITH %out_bool, %path_slice, %prefix_slice
    __path_prefix_len_%out_bool = load %prefix_slice+Slice_len as u64
    __path_len_%out_bool = load %path_slice+Slice_len as u64
    __path_idx_slot_%out_bool = stack_alloc 8
    store __path_idx_slot_%out_bool+0, 0 as u64
    __path_prefix_empty_%out_bool = eq __path_prefix_len_%out_bool, 0
    br __path_prefix_empty_%out_bool -> L_PATH_STARTS_WITH_TRUE_EMPTY, L_PATH_STARTS_WITH_CHECK_PREFIX

L_PATH_STARTS_WITH_CHECK_PREFIX:
    __path_prefix_fits_%out_bool = ule __path_prefix_len_%out_bool, __path_len_%out_bool
    br __path_prefix_fits_%out_bool -> L_PATH_STARTS_WITH_COMPARE_INIT, L_PATH_STARTS_WITH_FALSE_SHORT

L_PATH_STARTS_WITH_COMPARE_INIT:
    __path_ptr_%out_bool = load %path_slice+Slice_ptr as ptr
    __path_prefix_ptr_%out_bool = load %prefix_slice+Slice_ptr as ptr
    jmp L_PATH_STARTS_WITH_COMPARE_HEAD

L_PATH_STARTS_WITH_COMPARE_HEAD:
    __path_idx_%out_bool = load __path_idx_slot_%out_bool+0 as u64
    __path_compare_done_%out_bool = eq __path_idx_%out_bool, __path_prefix_len_%out_bool
    br __path_compare_done_%out_bool -> L_PATH_STARTS_WITH_CHECK_BOUNDARY, L_PATH_STARTS_WITH_COMPARE_BODY

L_PATH_STARTS_WITH_COMPARE_BODY:
    __path_byte_ptr_%out_bool = ptr_add __path_ptr_%out_bool, __path_idx_%out_bool
    __path_prefix_byte_ptr_%out_bool = ptr_add __path_prefix_ptr_%out_bool, __path_idx_%out_bool
    __path_byte_%out_bool = load __path_byte_ptr_%out_bool+0 as u8
    __path_prefix_byte_%out_bool = load __path_prefix_byte_ptr_%out_bool+0 as u8
    __path_bytes_eq_%out_bool = eq __path_byte_%out_bool, __path_prefix_byte_%out_bool
    br __path_bytes_eq_%out_bool -> L_PATH_STARTS_WITH_COMPARE_NEXT, L_PATH_STARTS_WITH_FALSE_COMPARE

L_PATH_STARTS_WITH_COMPARE_NEXT:
    __path_next_idx_%out_bool = add __path_idx_%out_bool, 1
    store __path_idx_slot_%out_bool+0, __path_next_idx_%out_bool as u64
    !__path_next_idx_%out_bool
    !__path_bytes_eq_%out_bool
    !__path_prefix_byte_%out_bool
    !__path_byte_%out_bool
    !__path_prefix_byte_ptr_%out_bool
    !__path_byte_ptr_%out_bool
    !__path_compare_done_%out_bool
    !__path_idx_%out_bool
    jmp L_PATH_STARTS_WITH_COMPARE_HEAD

L_PATH_STARTS_WITH_CHECK_BOUNDARY:
    __path_same_len_%out_bool = eq __path_len_%out_bool, __path_prefix_len_%out_bool
    br __path_same_len_%out_bool -> L_PATH_STARTS_WITH_TRUE_SAME, L_PATH_STARTS_WITH_CHECK_PREFIX_SEPARATOR

L_PATH_STARTS_WITH_CHECK_PREFIX_SEPARATOR:
    __path_prefix_last_idx_%out_bool = sub __path_prefix_len_%out_bool, 1
    __path_prefix_last_ptr_%out_bool = ptr_add __path_prefix_ptr_%out_bool, __path_prefix_last_idx_%out_bool
    __path_prefix_last_%out_bool = load __path_prefix_last_ptr_%out_bool+0 as u8
    __path_prefix_ends_sep_%out_bool = eq __path_prefix_last_%out_bool, 47
    br __path_prefix_ends_sep_%out_bool -> L_PATH_STARTS_WITH_TRUE_PREFIX_SEP, L_PATH_STARTS_WITH_CHECK_PATH_SEPARATOR

L_PATH_STARTS_WITH_CHECK_PATH_SEPARATOR:
    __path_boundary_ptr_%out_bool = ptr_add __path_ptr_%out_bool, __path_prefix_len_%out_bool
    __path_boundary_%out_bool = load __path_boundary_ptr_%out_bool+0 as u8
    %out_bool = eq __path_boundary_%out_bool, 47
    !__path_boundary_%out_bool
    !__path_boundary_ptr_%out_bool
    !__path_ptr_%out_bool
    !__path_prefix_ends_sep_%out_bool
    !__path_prefix_last_%out_bool
    !__path_prefix_last_ptr_%out_bool
    !__path_prefix_last_idx_%out_bool
    !__path_prefix_ptr_%out_bool
    !__path_compare_done_%out_bool
    !__path_idx_%out_bool
    !__path_same_len_%out_bool
    !__path_prefix_fits_%out_bool
    !__path_prefix_empty_%out_bool
    !__path_len_%out_bool
    !__path_prefix_len_%out_bool
    jmp L_PATH_STARTS_WITH_END

L_PATH_STARTS_WITH_TRUE_PREFIX_SEP:
    %out_bool = add 0, 1
    !__path_prefix_ends_sep_%out_bool
    !__path_prefix_last_%out_bool
    !__path_prefix_last_ptr_%out_bool
    !__path_prefix_last_idx_%out_bool
    !__path_prefix_ptr_%out_bool
    !__path_ptr_%out_bool
    !__path_compare_done_%out_bool
    !__path_idx_%out_bool
    !__path_same_len_%out_bool
    !__path_prefix_fits_%out_bool
    !__path_prefix_empty_%out_bool
    !__path_len_%out_bool
    !__path_prefix_len_%out_bool
    jmp L_PATH_STARTS_WITH_END

L_PATH_STARTS_WITH_TRUE_SAME:
    %out_bool = add 0, 1
    !__path_same_len_%out_bool
    !__path_prefix_ptr_%out_bool
    !__path_ptr_%out_bool
    !__path_compare_done_%out_bool
    !__path_idx_%out_bool
    !__path_prefix_fits_%out_bool
    !__path_prefix_empty_%out_bool
    !__path_len_%out_bool
    !__path_prefix_len_%out_bool
    jmp L_PATH_STARTS_WITH_END

L_PATH_STARTS_WITH_FALSE_COMPARE:
    %out_bool = add 0, 0
    !__path_bytes_eq_%out_bool
    !__path_prefix_byte_%out_bool
    !__path_byte_%out_bool
    !__path_prefix_byte_ptr_%out_bool
    !__path_byte_ptr_%out_bool
    !__path_compare_done_%out_bool
    !__path_idx_%out_bool
    !__path_prefix_ptr_%out_bool
    !__path_ptr_%out_bool
    !__path_prefix_fits_%out_bool
    !__path_prefix_empty_%out_bool
    !__path_len_%out_bool
    !__path_prefix_len_%out_bool
    jmp L_PATH_STARTS_WITH_END

L_PATH_STARTS_WITH_FALSE_SHORT:
    %out_bool = add 0, 0
    !__path_prefix_fits_%out_bool
    !__path_prefix_empty_%out_bool
    !__path_len_%out_bool
    !__path_prefix_len_%out_bool
    jmp L_PATH_STARTS_WITH_END

L_PATH_STARTS_WITH_TRUE_EMPTY:
    %out_bool = add 0, 1
    !__path_prefix_empty_%out_bool
    !__path_len_%out_bool
    !__path_prefix_len_%out_bool
    jmp L_PATH_STARTS_WITH_END

L_PATH_STARTS_WITH_END:
[END_MACRO]

[MACRO] PATH_TRY_STRIP_PREFIX %out_ok, %out_slice, %path_slice, %prefix_slice
    EXPAND PATH_STARTS_WITH __path_strip_match_%out_ok, %path_slice, %prefix_slice
    br __path_strip_match_%out_ok -> L_PATH_STRIP_HIT, L_PATH_STRIP_MISS

L_PATH_STRIP_HIT:
    __path_prefix_len_%out_ok = load %prefix_slice+Slice_len as u64
    __path_len_%out_ok = load %path_slice+Slice_len as u64
    __path_exact_%out_ok = eq __path_prefix_len_%out_ok, __path_len_%out_ok
    br __path_exact_%out_ok -> L_PATH_STRIP_EXACT, L_PATH_STRIP_CHECK_EMPTY

L_PATH_STRIP_CHECK_EMPTY:
    __path_prefix_empty_%out_ok = eq __path_prefix_len_%out_ok, 0
    br __path_prefix_empty_%out_ok -> L_PATH_STRIP_FROM_ZERO, L_PATH_STRIP_CHECK_PREFIX_SEPARATOR

L_PATH_STRIP_CHECK_PREFIX_SEPARATOR:
    __path_prefix_ptr_%out_ok = load %prefix_slice+Slice_ptr as ptr
    __path_prefix_last_idx_%out_ok = sub __path_prefix_len_%out_ok, 1
    __path_prefix_last_ptr_%out_ok = ptr_add __path_prefix_ptr_%out_ok, __path_prefix_last_idx_%out_ok
    __path_prefix_last_%out_ok = load __path_prefix_last_ptr_%out_ok+0 as u8
    __path_prefix_ends_sep_%out_ok = eq __path_prefix_last_%out_ok, 47
    br __path_prefix_ends_sep_%out_ok -> L_PATH_STRIP_FROM_PREFIX, L_PATH_STRIP_AFTER_SEPARATOR

L_PATH_STRIP_AFTER_SEPARATOR:
    __path_start_%out_ok = add __path_prefix_len_%out_ok, 1
    __path_rest_len_%out_ok = sub __path_len_%out_ok, __path_start_%out_ok
    EXPAND STR_SLICE %out_slice, %path_slice, __path_start_%out_ok, __path_rest_len_%out_ok
    %out_ok = add 0, 1
    !__path_rest_len_%out_ok
    !__path_start_%out_ok
    !__path_prefix_ends_sep_%out_ok
    !__path_prefix_last_%out_ok
    !__path_prefix_last_ptr_%out_ok
    !__path_prefix_last_idx_%out_ok
    !__path_prefix_ptr_%out_ok
    !__path_prefix_empty_%out_ok
    !__path_exact_%out_ok
    !__path_len_%out_ok
    !__path_prefix_len_%out_ok
    !__path_strip_match_%out_ok
    jmp L_PATH_STRIP_END

L_PATH_STRIP_FROM_PREFIX:
    __path_start_%out_ok = add __path_prefix_len_%out_ok, 0
    __path_rest_len_%out_ok = sub __path_len_%out_ok, __path_start_%out_ok
    EXPAND STR_SLICE %out_slice, %path_slice, __path_start_%out_ok, __path_rest_len_%out_ok
    %out_ok = add 0, 1
    !__path_rest_len_%out_ok
    !__path_start_%out_ok
    !__path_prefix_ends_sep_%out_ok
    !__path_prefix_last_%out_ok
    !__path_prefix_last_ptr_%out_ok
    !__path_prefix_last_idx_%out_ok
    !__path_prefix_ptr_%out_ok
    !__path_prefix_empty_%out_ok
    !__path_exact_%out_ok
    !__path_len_%out_ok
    !__path_prefix_len_%out_ok
    !__path_strip_match_%out_ok
    jmp L_PATH_STRIP_END

L_PATH_STRIP_FROM_ZERO:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_len_%out_ok
    %out_ok = add 0, 1
    !__path_prefix_empty_%out_ok
    !__path_exact_%out_ok
    !__path_len_%out_ok
    !__path_prefix_len_%out_ok
    !__path_strip_match_%out_ok
    jmp L_PATH_STRIP_END

L_PATH_STRIP_EXACT:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 1
    !__path_exact_%out_ok
    !__path_len_%out_ok
    !__path_prefix_len_%out_ok
    !__path_strip_match_%out_ok
    jmp L_PATH_STRIP_END

L_PATH_STRIP_MISS:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0
    !__path_strip_match_%out_ok
    jmp L_PATH_STRIP_END

L_PATH_STRIP_END:
[END_MACRO]

// Rust method-name alias over PATH_TRY_STRIP_PREFIX.
[MACRO] PATH_STRIP_PREFIX %out_ok, %out_slice, %path_slice, %prefix_slice
    EXPAND PATH_TRY_STRIP_PREFIX %out_ok, %out_slice, %path_slice, %prefix_slice
[END_MACRO]

[MACRO] PATH_TRIM_PREFIX %out_slice, %path_slice, %prefix_slice
    EXPAND PATH_TRY_STRIP_PREFIX __path_trim_ok_%out_slice, __path_trim_value_%out_slice, %path_slice, %prefix_slice
    br __path_trim_ok_%out_slice -> L_PATH_TRIM_PREFIX_HIT_%out_slice, L_PATH_TRIM_PREFIX_MISS_%out_slice

L_PATH_TRIM_PREFIX_HIT_%out_slice:
    __path_trim_value_len_%out_slice = load __path_trim_value_%out_slice+Slice_len as u64
    EXPAND STR_SLICE %out_slice, __path_trim_value_%out_slice, 0, __path_trim_value_len_%out_slice
    !__path_trim_value_len_%out_slice
    !__path_trim_value_%out_slice
    !__path_trim_ok_%out_slice
    jmp L_PATH_TRIM_PREFIX_END_%out_slice

L_PATH_TRIM_PREFIX_MISS_%out_slice:
    __path_trim_len_%out_slice = load %path_slice+Slice_len as u64
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_trim_len_%out_slice
    !__path_trim_len_%out_slice
    !__path_trim_value_%out_slice
    !__path_trim_ok_%out_slice

L_PATH_TRIM_PREFIX_END_%out_slice:
[END_MACRO]

[MACRO] PATH_ENDS_WITH %out_bool, %path_slice, %child_slice
    __path_end_path_len_%out_bool = load %path_slice+Slice_len as u64
    __path_end_child_len_%out_bool = load %child_slice+Slice_len as u64
    __path_end_idx_slot_%out_bool = stack_alloc 8
    __path_end_child_empty_%out_bool = eq __path_end_child_len_%out_bool, 0
    br __path_end_child_empty_%out_bool -> L_PATH_ENDS_WITH_TRUE_EMPTY_%out_bool, L_PATH_ENDS_WITH_CHECK_ABS_%out_bool

L_PATH_ENDS_WITH_CHECK_ABS_%out_bool:
    EXPAND PATH_IS_ABSOLUTE __path_end_child_abs_%out_bool, %child_slice
    br __path_end_child_abs_%out_bool -> L_PATH_ENDS_WITH_ABS_CHILD_%out_bool, L_PATH_ENDS_WITH_REL_CHILD_%out_bool

L_PATH_ENDS_WITH_ABS_CHILD_%out_bool:
    __path_end_abs_same_len_%out_bool = eq __path_end_path_len_%out_bool, __path_end_child_len_%out_bool
    br __path_end_abs_same_len_%out_bool -> L_PATH_ENDS_WITH_COMPARE_ZERO_%out_bool, L_PATH_ENDS_WITH_FALSE_ABS_%out_bool

L_PATH_ENDS_WITH_REL_CHILD_%out_bool:
    __path_end_child_fits_%out_bool = ule __path_end_child_len_%out_bool, __path_end_path_len_%out_bool
    br __path_end_child_fits_%out_bool -> L_PATH_ENDS_WITH_REL_START_%out_bool, L_PATH_ENDS_WITH_FALSE_SHORT_%out_bool

L_PATH_ENDS_WITH_REL_START_%out_bool:
    __path_end_start_%out_bool = sub __path_end_path_len_%out_bool, __path_end_child_len_%out_bool
    __path_end_at_start_%out_bool = eq __path_end_start_%out_bool, 0
    br __path_end_at_start_%out_bool -> L_PATH_ENDS_WITH_COMPARE_INIT_AFTER_REL_START_%out_bool, L_PATH_ENDS_WITH_CHECK_BOUNDARY_%out_bool

L_PATH_ENDS_WITH_COMPARE_INIT_AFTER_REL_START_%out_bool:
    !__path_end_at_start_%out_bool
    !__path_end_child_fits_%out_bool
    jmp L_PATH_ENDS_WITH_COMPARE_INIT_%out_bool

L_PATH_ENDS_WITH_CHECK_BOUNDARY_%out_bool:
    __path_end_path_ptr_%out_bool = load %path_slice+Slice_ptr as ptr
    __path_end_prev_idx_%out_bool = sub __path_end_start_%out_bool, 1
    __path_end_prev_ptr_%out_bool = ptr_add __path_end_path_ptr_%out_bool, __path_end_prev_idx_%out_bool
    __path_end_prev_%out_bool = load __path_end_prev_ptr_%out_bool+0 as u8
    __path_end_boundary_%out_bool = eq __path_end_prev_%out_bool, 47
    br __path_end_boundary_%out_bool -> L_PATH_ENDS_WITH_COMPARE_INIT_AFTER_BOUNDARY_%out_bool, L_PATH_ENDS_WITH_FALSE_BOUNDARY_%out_bool

L_PATH_ENDS_WITH_COMPARE_INIT_AFTER_BOUNDARY_%out_bool:
    !__path_end_boundary_%out_bool
    !__path_end_prev_%out_bool
    !__path_end_prev_ptr_%out_bool
    !__path_end_prev_idx_%out_bool
    !__path_end_path_ptr_%out_bool
    !__path_end_at_start_%out_bool
    !__path_end_child_fits_%out_bool
    jmp L_PATH_ENDS_WITH_COMPARE_INIT_%out_bool

L_PATH_ENDS_WITH_COMPARE_ZERO_%out_bool:
    __path_end_start_%out_bool = add 0, 0
    !__path_end_abs_same_len_%out_bool
    jmp L_PATH_ENDS_WITH_COMPARE_INIT_%out_bool

L_PATH_ENDS_WITH_COMPARE_INIT_%out_bool:
    store __path_end_idx_slot_%out_bool+0, 0 as u64
    __path_end_path_ptr_%out_bool = load %path_slice+Slice_ptr as ptr
    __path_end_child_ptr_%out_bool = load %child_slice+Slice_ptr as ptr
    jmp L_PATH_ENDS_WITH_COMPARE_HEAD_%out_bool

L_PATH_ENDS_WITH_COMPARE_HEAD_%out_bool:
    __path_end_idx_%out_bool = load __path_end_idx_slot_%out_bool+0 as u64
    __path_end_done_%out_bool = eq __path_end_idx_%out_bool, __path_end_child_len_%out_bool
    br __path_end_done_%out_bool -> L_PATH_ENDS_WITH_TRUE_DONE_%out_bool, L_PATH_ENDS_WITH_COMPARE_BODY_%out_bool

L_PATH_ENDS_WITH_COMPARE_BODY_%out_bool:
    __path_end_path_idx_%out_bool = add __path_end_start_%out_bool, __path_end_idx_%out_bool
    __path_end_path_byte_ptr_%out_bool = ptr_add __path_end_path_ptr_%out_bool, __path_end_path_idx_%out_bool
    __path_end_child_byte_ptr_%out_bool = ptr_add __path_end_child_ptr_%out_bool, __path_end_idx_%out_bool
    __path_end_path_byte_%out_bool = load __path_end_path_byte_ptr_%out_bool+0 as u8
    __path_end_child_byte_%out_bool = load __path_end_child_byte_ptr_%out_bool+0 as u8
    __path_end_bytes_eq_%out_bool = eq __path_end_path_byte_%out_bool, __path_end_child_byte_%out_bool
    br __path_end_bytes_eq_%out_bool -> L_PATH_ENDS_WITH_COMPARE_NEXT_%out_bool, L_PATH_ENDS_WITH_FALSE_COMPARE_%out_bool

L_PATH_ENDS_WITH_COMPARE_NEXT_%out_bool:
    __path_end_next_idx_%out_bool = add __path_end_idx_%out_bool, 1
    store __path_end_idx_slot_%out_bool+0, __path_end_next_idx_%out_bool as u64
    !__path_end_next_idx_%out_bool
    !__path_end_bytes_eq_%out_bool
    !__path_end_child_byte_%out_bool
    !__path_end_path_byte_%out_bool
    !__path_end_child_byte_ptr_%out_bool
    !__path_end_path_byte_ptr_%out_bool
    !__path_end_path_idx_%out_bool
    !__path_end_done_%out_bool
    !__path_end_idx_%out_bool
    jmp L_PATH_ENDS_WITH_COMPARE_HEAD_%out_bool

L_PATH_ENDS_WITH_TRUE_DONE_%out_bool:
    %out_bool = add 0, 1
    !__path_end_done_%out_bool
    !__path_end_idx_%out_bool
    !__path_end_child_ptr_%out_bool
    !__path_end_path_ptr_%out_bool
    !__path_end_start_%out_bool
    !__path_end_child_abs_%out_bool
    !__path_end_child_empty_%out_bool
    !__path_end_child_len_%out_bool
    !__path_end_path_len_%out_bool
    jmp L_PATH_ENDS_WITH_END_%out_bool

L_PATH_ENDS_WITH_FALSE_COMPARE_%out_bool:
    %out_bool = add 0, 0
    !__path_end_bytes_eq_%out_bool
    !__path_end_child_byte_%out_bool
    !__path_end_path_byte_%out_bool
    !__path_end_child_byte_ptr_%out_bool
    !__path_end_path_byte_ptr_%out_bool
    !__path_end_path_idx_%out_bool
    !__path_end_done_%out_bool
    !__path_end_idx_%out_bool
    !__path_end_child_ptr_%out_bool
    !__path_end_path_ptr_%out_bool
    !__path_end_start_%out_bool
    !__path_end_child_abs_%out_bool
    !__path_end_child_empty_%out_bool
    !__path_end_child_len_%out_bool
    !__path_end_path_len_%out_bool
    jmp L_PATH_ENDS_WITH_END_%out_bool

L_PATH_ENDS_WITH_FALSE_BOUNDARY_%out_bool:
    %out_bool = add 0, 0
    !__path_end_boundary_%out_bool
    !__path_end_prev_%out_bool
    !__path_end_prev_ptr_%out_bool
    !__path_end_prev_idx_%out_bool
    !__path_end_path_ptr_%out_bool
    !__path_end_at_start_%out_bool
    !__path_end_start_%out_bool
    !__path_end_child_fits_%out_bool
    !__path_end_child_abs_%out_bool
    !__path_end_child_empty_%out_bool
    !__path_end_child_len_%out_bool
    !__path_end_path_len_%out_bool
    jmp L_PATH_ENDS_WITH_END_%out_bool

L_PATH_ENDS_WITH_FALSE_ABS_%out_bool:
    %out_bool = add 0, 0
    !__path_end_abs_same_len_%out_bool
    !__path_end_child_abs_%out_bool
    !__path_end_child_empty_%out_bool
    !__path_end_child_len_%out_bool
    !__path_end_path_len_%out_bool
    jmp L_PATH_ENDS_WITH_END_%out_bool

L_PATH_ENDS_WITH_FALSE_SHORT_%out_bool:
    %out_bool = add 0, 0
    !__path_end_child_fits_%out_bool
    !__path_end_child_abs_%out_bool
    !__path_end_child_empty_%out_bool
    !__path_end_child_len_%out_bool
    !__path_end_path_len_%out_bool
    jmp L_PATH_ENDS_WITH_END_%out_bool

L_PATH_ENDS_WITH_TRUE_EMPTY_%out_bool:
    %out_bool = add 0, 1
    !__path_end_child_empty_%out_bool
    !__path_end_child_len_%out_bool
    !__path_end_path_len_%out_bool
    jmp L_PATH_ENDS_WITH_END_%out_bool

L_PATH_ENDS_WITH_END_%out_bool:
[END_MACRO]

[MACRO] PATH_JOIN %out_slice, %base_slice, %child_slice
    EXPAND PATH_IS_ABSOLUTE __path_join_child_abs_%out_slice, %child_slice
    br __path_join_child_abs_%out_slice -> L_PATH_JOIN_CHILD_VIEW, L_PATH_JOIN_CHECK_BASE

L_PATH_JOIN_CHECK_BASE:
    __path_join_base_len_%out_slice = load %base_slice+Slice_len as u64
    __path_join_base_empty_%out_slice = eq __path_join_base_len_%out_slice, 0
    br __path_join_base_empty_%out_slice -> L_PATH_JOIN_CHILD_VIEW_FROM_EMPTY_BASE, L_PATH_JOIN_CHECK_CHILD

L_PATH_JOIN_CHECK_CHILD:
    __path_join_child_len_%out_slice = load %child_slice+Slice_len as u64
    __path_join_child_empty_%out_slice = eq __path_join_child_len_%out_slice, 0
    br __path_join_child_empty_%out_slice -> L_PATH_JOIN_BASE_VIEW, L_PATH_JOIN_CHECK_SEPARATOR

L_PATH_JOIN_CHECK_SEPARATOR:
    EXPAND PATH_ENDS_WITH_SEPARATOR __path_join_base_has_sep_%out_slice, %base_slice
    br __path_join_base_has_sep_%out_slice -> L_PATH_JOIN_CONCAT_DIRECT, L_PATH_JOIN_CONCAT_WITH_SEPARATOR

L_PATH_JOIN_CONCAT_DIRECT:
    EXPAND STR_CONCAT %out_slice, %base_slice, %child_slice
    !__path_join_base_has_sep_%out_slice
    !__path_join_child_empty_%out_slice
    !__path_join_child_len_%out_slice
    !__path_join_base_empty_%out_slice
    !__path_join_base_len_%out_slice
    !__path_join_child_abs_%out_slice
    jmp L_PATH_JOIN_END

L_PATH_JOIN_CONCAT_WITH_SEPARATOR:
    EXPAND STR_FROM_PARTS __path_join_sep_%out_slice, &PATH_SEPARATOR, 1
    EXPAND STR_CONCAT __path_join_base_sep_%out_slice, %base_slice, __path_join_sep_%out_slice
    EXPAND STR_CONCAT %out_slice, __path_join_base_sep_%out_slice, %child_slice
    !__path_join_base_sep_%out_slice
    !__path_join_sep_%out_slice
    !__path_join_base_has_sep_%out_slice
    !__path_join_child_empty_%out_slice
    !__path_join_child_len_%out_slice
    !__path_join_base_empty_%out_slice
    !__path_join_base_len_%out_slice
    !__path_join_child_abs_%out_slice
    jmp L_PATH_JOIN_END

L_PATH_JOIN_BASE_VIEW:
    EXPAND STR_SLICE %out_slice, %base_slice, 0, __path_join_base_len_%out_slice
    !__path_join_child_empty_%out_slice
    !__path_join_child_len_%out_slice
    !__path_join_base_empty_%out_slice
    !__path_join_base_len_%out_slice
    !__path_join_child_abs_%out_slice
    jmp L_PATH_JOIN_END

L_PATH_JOIN_CHILD_VIEW_FROM_EMPTY_BASE:
    __path_join_child_len_%out_slice = load %child_slice+Slice_len as u64
    EXPAND STR_SLICE %out_slice, %child_slice, 0, __path_join_child_len_%out_slice
    !__path_join_child_len_%out_slice
    !__path_join_base_empty_%out_slice
    !__path_join_base_len_%out_slice
    !__path_join_child_abs_%out_slice
    jmp L_PATH_JOIN_END

L_PATH_JOIN_CHILD_VIEW:
    __path_join_child_len_%out_slice = load %child_slice+Slice_len as u64
    EXPAND STR_SLICE %out_slice, %child_slice, 0, __path_join_child_len_%out_slice
    !__path_join_child_len_%out_slice
    !__path_join_child_abs_%out_slice
    jmp L_PATH_JOIN_END

L_PATH_JOIN_END:
[END_MACRO]

[MACRO] PATH_PARENT %out_slice, %path_slice
    EXPAND PATH_DIRNAME %out_slice, %path_slice
[END_MACRO]

[MACRO] PATH_FILE_STEM %out_slice, %path_slice
    EXPAND PATH_STEM %out_slice, %path_slice
[END_MACRO]

[MACRO] PATH_FILE_PREFIX %out_slice, %path_slice
    EXPAND PATH_BASENAME __path_prefix_base_%out_slice, %path_slice
    __path_prefix_base_ptr_%out_slice = load __path_prefix_base_%out_slice+Slice_ptr as ptr
    __path_prefix_base_len_%out_slice = load __path_prefix_base_%out_slice+Slice_len as u64
    __path_prefix_scan_slot_%out_slice = stack_alloc 8
    __path_prefix_empty_%out_slice = eq __path_prefix_base_len_%out_slice, 0
    br __path_prefix_empty_%out_slice -> L_PATH_FILE_PREFIX_EMPTY_%out_slice, L_PATH_FILE_PREFIX_INIT_%out_slice

L_PATH_FILE_PREFIX_INIT_%out_slice:
    __path_prefix_first_%out_slice = load __path_prefix_base_ptr_%out_slice+0 as u8
    __path_prefix_starts_dot_%out_slice = eq __path_prefix_first_%out_slice, 46
    br __path_prefix_starts_dot_%out_slice -> L_PATH_FILE_PREFIX_INIT_HIDDEN_%out_slice, L_PATH_FILE_PREFIX_INIT_NORMAL_%out_slice

L_PATH_FILE_PREFIX_INIT_HIDDEN_%out_slice:
    store __path_prefix_scan_slot_%out_slice+0, 1 as u64
    !__path_prefix_starts_dot_%out_slice
    !__path_prefix_first_%out_slice
    jmp L_PATH_FILE_PREFIX_SCAN_%out_slice

L_PATH_FILE_PREFIX_INIT_NORMAL_%out_slice:
    store __path_prefix_scan_slot_%out_slice+0, 0 as u64
    !__path_prefix_starts_dot_%out_slice
    !__path_prefix_first_%out_slice
    jmp L_PATH_FILE_PREFIX_SCAN_%out_slice

L_PATH_FILE_PREFIX_SCAN_%out_slice:
    __path_prefix_idx_%out_slice = load __path_prefix_scan_slot_%out_slice+0 as u64
    __path_prefix_done_%out_slice = eq __path_prefix_idx_%out_slice, __path_prefix_base_len_%out_slice
    br __path_prefix_done_%out_slice -> L_PATH_FILE_PREFIX_NO_DOT_%out_slice, L_PATH_FILE_PREFIX_CHECK_%out_slice

L_PATH_FILE_PREFIX_CHECK_%out_slice:
    __path_prefix_ch_ptr_%out_slice = ptr_add __path_prefix_base_ptr_%out_slice, __path_prefix_idx_%out_slice
    __path_prefix_ch_%out_slice = load __path_prefix_ch_ptr_%out_slice+0 as u8
    __path_prefix_is_dot_%out_slice = eq __path_prefix_ch_%out_slice, 46
    br __path_prefix_is_dot_%out_slice -> L_PATH_FILE_PREFIX_FOUND_%out_slice, L_PATH_FILE_PREFIX_NEXT_%out_slice

L_PATH_FILE_PREFIX_NEXT_%out_slice:
    __path_prefix_next_%out_slice = add __path_prefix_idx_%out_slice, 1
    store __path_prefix_scan_slot_%out_slice+0, __path_prefix_next_%out_slice as u64
    !__path_prefix_next_%out_slice
    !__path_prefix_is_dot_%out_slice
    !__path_prefix_ch_%out_slice
    !__path_prefix_ch_ptr_%out_slice
    !__path_prefix_done_%out_slice
    !__path_prefix_idx_%out_slice
    jmp L_PATH_FILE_PREFIX_SCAN_%out_slice

L_PATH_FILE_PREFIX_FOUND_%out_slice:
    EXPAND STR_SLICE %out_slice, __path_prefix_base_%out_slice, 0, __path_prefix_idx_%out_slice
    !__path_prefix_is_dot_%out_slice
    !__path_prefix_ch_%out_slice
    !__path_prefix_ch_ptr_%out_slice
    !__path_prefix_done_%out_slice
    !__path_prefix_idx_%out_slice
    !__path_prefix_empty_%out_slice
    !__path_prefix_base_len_%out_slice
    !__path_prefix_base_ptr_%out_slice
    !__path_prefix_base_%out_slice
    jmp L_PATH_FILE_PREFIX_END_%out_slice

L_PATH_FILE_PREFIX_NO_DOT_%out_slice:
    EXPAND STR_SLICE %out_slice, __path_prefix_base_%out_slice, 0, __path_prefix_base_len_%out_slice
    !__path_prefix_done_%out_slice
    !__path_prefix_idx_%out_slice
    !__path_prefix_empty_%out_slice
    !__path_prefix_base_len_%out_slice
    !__path_prefix_base_ptr_%out_slice
    !__path_prefix_base_%out_slice
    jmp L_PATH_FILE_PREFIX_END_%out_slice

L_PATH_FILE_PREFIX_EMPTY_%out_slice:
    EXPAND PATH_MAKE_EMPTY %out_slice
    !__path_prefix_empty_%out_slice
    !__path_prefix_base_len_%out_slice
    !__path_prefix_base_ptr_%out_slice
    !__path_prefix_base_%out_slice
    jmp L_PATH_FILE_PREFIX_END_%out_slice

L_PATH_FILE_PREFIX_END_%out_slice:
[END_MACRO]

[MACRO] PATH_TRY_FILE_PREFIX %out_ok, %out_slice, %path_slice
    EXPAND PATH_TRY_FILE_NAME __path_try_prefix_name_ok_%out_ok, __path_try_prefix_name_%out_ok, %path_slice
    br __path_try_prefix_name_ok_%out_ok -> L_PATH_TRY_FILE_PREFIX_SOME_%out_ok, L_PATH_TRY_FILE_PREFIX_NONE_%out_ok

L_PATH_TRY_FILE_PREFIX_SOME_%out_ok:
    EXPAND PATH_FILE_PREFIX %out_slice, %path_slice
    %out_ok = add 0, 1
    !__path_try_prefix_name_%out_ok
    !__path_try_prefix_name_ok_%out_ok
    jmp L_PATH_TRY_FILE_PREFIX_END_%out_ok

L_PATH_TRY_FILE_PREFIX_NONE_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0
    !__path_try_prefix_name_%out_ok
    !__path_try_prefix_name_ok_%out_ok

L_PATH_TRY_FILE_PREFIX_END_%out_ok:
[END_MACRO]

[MACRO] PATH_FILE_NAME %out_slice, %path_slice
    EXPAND PATH_BASENAME %out_slice, %path_slice
[END_MACRO]

[MACRO] PATH_TRY_FILE_NAME %out_ok, %out_slice, %path_slice
    EXPAND PATH_BASENAME __path_try_file_name_base_%out_ok, %path_slice
    __path_try_file_name_len_%out_ok = load __path_try_file_name_base_%out_ok+Slice_len as u64
    __path_try_file_name_empty_%out_ok = eq __path_try_file_name_len_%out_ok, 0
    br __path_try_file_name_empty_%out_ok -> L_PATH_TRY_FILE_NAME_NONE_%out_ok, L_PATH_TRY_FILE_NAME_CHECK_ROOT_%out_ok

L_PATH_TRY_FILE_NAME_CHECK_ROOT_%out_ok:
    __path_try_file_name_ptr_%out_ok = load __path_try_file_name_base_%out_ok+Slice_ptr as ptr
    __path_try_file_name_one_%out_ok = eq __path_try_file_name_len_%out_ok, 1
    __path_try_file_name_first_%out_ok = load __path_try_file_name_ptr_%out_ok+0 as u8
    __path_try_file_name_slash_%out_ok = eq __path_try_file_name_first_%out_ok, 47
    __path_try_file_name_root_%out_ok = and __path_try_file_name_one_%out_ok, __path_try_file_name_slash_%out_ok
    br __path_try_file_name_root_%out_ok -> L_PATH_TRY_FILE_NAME_NONE_AFTER_ROOT_%out_ok, L_PATH_TRY_FILE_NAME_SOME_%out_ok

L_PATH_TRY_FILE_NAME_SOME_%out_ok:
    EXPAND STR_SLICE %out_slice, __path_try_file_name_base_%out_ok, 0, __path_try_file_name_len_%out_ok
    %out_ok = add 0, 1
    !__path_try_file_name_root_%out_ok
    !__path_try_file_name_slash_%out_ok
    !__path_try_file_name_first_%out_ok
    !__path_try_file_name_one_%out_ok
    !__path_try_file_name_ptr_%out_ok
    !__path_try_file_name_empty_%out_ok
    !__path_try_file_name_len_%out_ok
    !__path_try_file_name_base_%out_ok
    jmp L_PATH_TRY_FILE_NAME_END_%out_ok

L_PATH_TRY_FILE_NAME_NONE_AFTER_ROOT_%out_ok:
    !__path_try_file_name_root_%out_ok
    !__path_try_file_name_slash_%out_ok
    !__path_try_file_name_first_%out_ok
    !__path_try_file_name_one_%out_ok
    !__path_try_file_name_ptr_%out_ok
    !__path_try_file_name_empty_%out_ok
    jmp L_PATH_TRY_FILE_NAME_NONE_AFTER_CHECK_%out_ok

L_PATH_TRY_FILE_NAME_NONE_%out_ok:
    !__path_try_file_name_empty_%out_ok
    jmp L_PATH_TRY_FILE_NAME_NONE_AFTER_CHECK_%out_ok

L_PATH_TRY_FILE_NAME_NONE_AFTER_CHECK_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0
    !__path_try_file_name_len_%out_ok
    !__path_try_file_name_base_%out_ok

L_PATH_TRY_FILE_NAME_END_%out_ok:
[END_MACRO]

[MACRO] PATH_EXTENSION %out_slice, %path_slice
    EXPAND PATH_EXT %out_slice, %path_slice
[END_MACRO]

[MACRO] PATH_TRY_EXTENSION %out_ok, %out_slice, %path_slice
    EXPAND PATH_EXTENSION %out_slice, %path_slice
    __path_try_ext_len_%out_ok = load %out_slice+Slice_len as u64
    %out_ok = ne __path_try_ext_len_%out_ok, 0
    !__path_try_ext_len_%out_ok
[END_MACRO]

[MACRO] PATH_TRY_FILE_STEM %out_ok, %out_slice, %path_slice
    EXPAND PATH_TRY_FILE_NAME __path_try_stem_name_ok_%out_ok, __path_try_stem_name_%out_ok, %path_slice
    br __path_try_stem_name_ok_%out_ok -> L_PATH_TRY_FILE_STEM_SOME_%out_ok, L_PATH_TRY_FILE_STEM_NONE_%out_ok

L_PATH_TRY_FILE_STEM_SOME_%out_ok:
    EXPAND PATH_FILE_STEM %out_slice, %path_slice
    %out_ok = add 0, 1
    !__path_try_stem_name_%out_ok
    !__path_try_stem_name_ok_%out_ok
    jmp L_PATH_TRY_FILE_STEM_END_%out_ok

L_PATH_TRY_FILE_STEM_NONE_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0
    !__path_try_stem_name_%out_ok
    !__path_try_stem_name_ok_%out_ok

L_PATH_TRY_FILE_STEM_END_%out_ok:
[END_MACRO]

[MACRO] PATH_TRY_PARENT %out_ok, %out_slice, %path_slice
    EXPAND PATH_TRIM_TRAILING_SEPARATOR __path_try_parent_trim_%out_ok, %path_slice
    __path_try_parent_len_%out_ok = load __path_try_parent_trim_%out_ok+Slice_len as u64
    __path_try_parent_empty_%out_ok = eq __path_try_parent_len_%out_ok, 0
    br __path_try_parent_empty_%out_ok -> L_PATH_TRY_PARENT_NONE_%out_ok, L_PATH_TRY_PARENT_CHECK_ROOT_%out_ok

L_PATH_TRY_PARENT_CHECK_ROOT_%out_ok:
    __path_try_parent_ptr_%out_ok = load __path_try_parent_trim_%out_ok+Slice_ptr as ptr
    __path_try_parent_one_%out_ok = eq __path_try_parent_len_%out_ok, 1
    __path_try_parent_first_%out_ok = load __path_try_parent_ptr_%out_ok+0 as u8
    __path_try_parent_slash_%out_ok = eq __path_try_parent_first_%out_ok, 47
    __path_try_parent_root_%out_ok = and __path_try_parent_one_%out_ok, __path_try_parent_slash_%out_ok
    br __path_try_parent_root_%out_ok -> L_PATH_TRY_PARENT_NONE_AFTER_ROOT_%out_ok, L_PATH_TRY_PARENT_SOME_%out_ok

L_PATH_TRY_PARENT_SOME_%out_ok:
    EXPAND PATH_PARENT %out_slice, __path_try_parent_trim_%out_ok
    %out_ok = add 0, 1
    !__path_try_parent_root_%out_ok
    !__path_try_parent_slash_%out_ok
    !__path_try_parent_first_%out_ok
    !__path_try_parent_one_%out_ok
    !__path_try_parent_ptr_%out_ok
    !__path_try_parent_empty_%out_ok
    !__path_try_parent_len_%out_ok
    !__path_try_parent_trim_%out_ok
    jmp L_PATH_TRY_PARENT_END_%out_ok

L_PATH_TRY_PARENT_NONE_AFTER_ROOT_%out_ok:
    !__path_try_parent_root_%out_ok
    !__path_try_parent_slash_%out_ok
    !__path_try_parent_first_%out_ok
    !__path_try_parent_one_%out_ok
    !__path_try_parent_ptr_%out_ok
    !__path_try_parent_empty_%out_ok
    jmp L_PATH_TRY_PARENT_NONE_AFTER_CHECK_%out_ok

L_PATH_TRY_PARENT_NONE_%out_ok:
    !__path_try_parent_empty_%out_ok
    jmp L_PATH_TRY_PARENT_NONE_AFTER_CHECK_%out_ok

L_PATH_TRY_PARENT_NONE_AFTER_CHECK_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0
    !__path_try_parent_len_%out_ok
    !__path_try_parent_trim_%out_ok

L_PATH_TRY_PARENT_END_%out_ok:
[END_MACRO]

[MACRO] PATH_TRY_TO_STR %out_ok, %out_slice, %path_slice
    __path_to_str_ptr_%out_ok = load %path_slice+Slice_ptr as ptr
    __path_to_str_len_%out_ok = load %path_slice+Slice_len as u64
    __path_to_str_status_%out_ok = call @sa_str_utf8_validate(__path_to_str_ptr_%out_ok, __path_to_str_len_%out_ok)
    __path_to_str_valid_%out_ok = eq __path_to_str_status_%out_ok, 0
    br __path_to_str_valid_%out_ok -> L_PATH_TO_STR_VALID_%out_ok, L_PATH_TO_STR_INVALID_%out_ok

L_PATH_TO_STR_VALID_%out_ok:
    EXPAND STR_FROM_PARTS %out_slice, __path_to_str_ptr_%out_ok, __path_to_str_len_%out_ok
    %out_ok = add 0, 1
    jmp L_PATH_TO_STR_END_%out_ok

L_PATH_TO_STR_INVALID_%out_ok:
    EXPAND PATH_MAKE_EMPTY %out_slice
    %out_ok = add 0, 0

L_PATH_TO_STR_END_%out_ok:
    !__path_to_str_valid_%out_ok
    !__path_to_str_status_%out_ok
    !__path_to_str_len_%out_ok
    !__path_to_str_ptr_%out_ok
[END_MACRO]

// Rust method-name alias over PATH_TRY_TO_STR.
[MACRO] PATH_TO_STR %out_ok, %out_slice, %path_slice
    EXPAND PATH_TRY_TO_STR %out_ok, %out_slice, %path_slice
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_PATH %hasher, %path_slice
    __path_hash_ptr_%hasher = load %path_slice+Slice_ptr as ptr
    __path_hash_len_%hasher = load %path_slice+Slice_len as u64
    __path_hash_idx_slot_%hasher = stack_alloc 8
    __path_hash_start_slot_%hasher = stack_alloc 8
    __path_hash_chunk_slot_%hasher = stack_alloc 8
    __path_hash_write_ptr_slot_%hasher = stack_alloc 8
    __path_hash_write_len_slot_%hasher = stack_alloc 8
    __path_hash_write_idx_slot_%hasher = stack_alloc 8
    __path_hash_return_slot_%hasher = stack_alloc 8
    store __path_hash_idx_slot_%hasher+0, 0 as u64
    store __path_hash_start_slot_%hasher+0, 0 as u64
    store __path_hash_chunk_slot_%hasher+0, 0 as u64
    jmp L_PATH_HASH_HEAD_%hasher

L_PATH_HASH_HEAD_%hasher:
    __path_hash_idx_%hasher = load __path_hash_idx_slot_%hasher+0 as u64
    __path_hash_done_%hasher = eq __path_hash_idx_%hasher, __path_hash_len_%hasher
    br __path_hash_done_%hasher -> L_PATH_HASH_EOF_%hasher, L_PATH_HASH_BODY_%hasher

L_PATH_HASH_BODY_%hasher:
    __path_hash_ch_ptr_%hasher = ptr_add __path_hash_ptr_%hasher, __path_hash_idx_%hasher
    __path_hash_ch_%hasher = load __path_hash_ch_ptr_%hasher+0 as u8
    __path_hash_is_sep_%hasher = eq __path_hash_ch_%hasher, 47
    br __path_hash_is_sep_%hasher -> L_PATH_HASH_SEPARATOR_%hasher, L_PATH_HASH_NEXT_%hasher

L_PATH_HASH_SEPARATOR_%hasher:
    __path_hash_start_%hasher = load __path_hash_start_slot_%hasher+0 as u64
    __path_hash_has_component_%hasher = ult __path_hash_start_%hasher, __path_hash_idx_%hasher
    br __path_hash_has_component_%hasher -> L_PATH_HASH_WRITE_COMPONENT_%hasher, L_PATH_HASH_AFTER_COMPONENT_%hasher

L_PATH_HASH_WRITE_COMPONENT_%hasher:
    __path_hash_component_len_%hasher = sub __path_hash_idx_%hasher, __path_hash_start_%hasher
    __path_hash_component_ptr_%hasher = ptr_add __path_hash_ptr_%hasher, __path_hash_start_%hasher
    __path_hash_chunk_%hasher = load __path_hash_chunk_slot_%hasher+0 as u64
    __path_hash_chunk_sum_%hasher = add __path_hash_chunk_%hasher, __path_hash_component_len_%hasher
    EXPAND NUM_U64_ROTATE_RIGHT __path_hash_chunk_next_%hasher, __path_hash_chunk_sum_%hasher, 2
    store __path_hash_chunk_slot_%hasher+0, __path_hash_chunk_next_%hasher as u64
    store __path_hash_write_ptr_slot_%hasher+0, __path_hash_component_ptr_%hasher as ptr
    store __path_hash_write_len_slot_%hasher+0, __path_hash_component_len_%hasher as u64
    store __path_hash_return_slot_%hasher+0, 1 as u64
    !__path_hash_chunk_next_%hasher
    !__path_hash_chunk_sum_%hasher
    !__path_hash_chunk_%hasher
    !__path_hash_component_ptr_%hasher
    !__path_hash_component_len_%hasher
    jmp L_PATH_HASH_WRITE_BYTES_INIT_%hasher

L_PATH_HASH_AFTER_COMPONENT_%hasher:
    __path_hash_next_start_%hasher = add __path_hash_idx_%hasher, 1
    store __path_hash_start_slot_%hasher+0, __path_hash_next_start_%hasher as u64
    __path_hash_tail_empty_%hasher = eq __path_hash_next_start_%hasher, __path_hash_len_%hasher
    br __path_hash_tail_empty_%hasher -> L_PATH_HASH_AFTER_DOT_CHECK_%hasher, L_PATH_HASH_CHECK_DOT_%hasher

L_PATH_HASH_CHECK_DOT_%hasher:
    __path_hash_tail_ptr_%hasher = ptr_add __path_hash_ptr_%hasher, __path_hash_next_start_%hasher
    __path_hash_tail_first_%hasher = load __path_hash_tail_ptr_%hasher+0 as u8
    __path_hash_tail_is_dot_%hasher = eq __path_hash_tail_first_%hasher, 46
    br __path_hash_tail_is_dot_%hasher -> L_PATH_HASH_CHECK_DOT_END_%hasher, L_PATH_HASH_NO_DOT_SKIP_%hasher

L_PATH_HASH_CHECK_DOT_END_%hasher:
    __path_hash_after_dot_%hasher = add __path_hash_next_start_%hasher, 1
    __path_hash_dot_at_end_%hasher = eq __path_hash_after_dot_%hasher, __path_hash_len_%hasher
    br __path_hash_dot_at_end_%hasher -> L_PATH_HASH_SKIP_DOT_%hasher, L_PATH_HASH_CHECK_DOT_SEP_%hasher

L_PATH_HASH_CHECK_DOT_SEP_%hasher:
    __path_hash_after_dot_ptr_%hasher = ptr_add __path_hash_ptr_%hasher, __path_hash_after_dot_%hasher
    __path_hash_after_dot_ch_%hasher = load __path_hash_after_dot_ptr_%hasher+0 as u8
    __path_hash_dot_then_sep_%hasher = eq __path_hash_after_dot_ch_%hasher, 47
    br __path_hash_dot_then_sep_%hasher -> L_PATH_HASH_SKIP_DOT_%hasher, L_PATH_HASH_NO_DOT_SKIP_AFTER_DOT_%hasher

L_PATH_HASH_SKIP_DOT_%hasher:
    store __path_hash_start_slot_%hasher+0, __path_hash_after_dot_%hasher as u64
    !__path_hash_after_dot_%hasher
    jmp L_PATH_HASH_AFTER_DOT_CHECK_%hasher

L_PATH_HASH_NO_DOT_SKIP_AFTER_DOT_%hasher:
    !__path_hash_dot_then_sep_%hasher
    !__path_hash_after_dot_ch_%hasher
    !__path_hash_after_dot_ptr_%hasher
    !__path_hash_dot_at_end_%hasher
    !__path_hash_after_dot_%hasher
    jmp L_PATH_HASH_AFTER_DOT_CHECK_%hasher

L_PATH_HASH_NO_DOT_SKIP_%hasher:
    !__path_hash_tail_is_dot_%hasher
    !__path_hash_tail_first_%hasher
    !__path_hash_tail_ptr_%hasher
    jmp L_PATH_HASH_AFTER_DOT_CHECK_%hasher

L_PATH_HASH_AFTER_DOT_CHECK_%hasher:
    !__path_hash_tail_empty_%hasher
    !__path_hash_next_start_%hasher
    !__path_hash_has_component_%hasher
    !__path_hash_start_%hasher
    jmp L_PATH_HASH_NEXT_%hasher

L_PATH_HASH_NEXT_%hasher:
    __path_hash_next_idx_%hasher = add __path_hash_idx_%hasher, 1
    store __path_hash_idx_slot_%hasher+0, __path_hash_next_idx_%hasher as u64
    !__path_hash_next_idx_%hasher
    !__path_hash_is_sep_%hasher
    !__path_hash_ch_%hasher
    !__path_hash_ch_ptr_%hasher
    !__path_hash_done_%hasher
    !__path_hash_idx_%hasher
    jmp L_PATH_HASH_HEAD_%hasher

L_PATH_HASH_EOF_%hasher:
    __path_hash_final_start_%hasher = load __path_hash_start_slot_%hasher+0 as u64
    __path_hash_has_tail_%hasher = ult __path_hash_final_start_%hasher, __path_hash_len_%hasher
    br __path_hash_has_tail_%hasher -> L_PATH_HASH_WRITE_TAIL_%hasher, L_PATH_HASH_FINISH_%hasher

L_PATH_HASH_WRITE_TAIL_%hasher:
    __path_hash_tail_len_%hasher = sub __path_hash_len_%hasher, __path_hash_final_start_%hasher
    __path_hash_tail_ptr_%hasher = ptr_add __path_hash_ptr_%hasher, __path_hash_final_start_%hasher
    __path_hash_tail_chunk_%hasher = load __path_hash_chunk_slot_%hasher+0 as u64
    __path_hash_tail_sum_%hasher = add __path_hash_tail_chunk_%hasher, __path_hash_tail_len_%hasher
    EXPAND NUM_U64_ROTATE_RIGHT __path_hash_tail_chunk_next_%hasher, __path_hash_tail_sum_%hasher, 2
    store __path_hash_chunk_slot_%hasher+0, __path_hash_tail_chunk_next_%hasher as u64
    store __path_hash_write_ptr_slot_%hasher+0, __path_hash_tail_ptr_%hasher as ptr
    store __path_hash_write_len_slot_%hasher+0, __path_hash_tail_len_%hasher as u64
    store __path_hash_return_slot_%hasher+0, 2 as u64
    !__path_hash_tail_chunk_next_%hasher
    !__path_hash_tail_sum_%hasher
    !__path_hash_tail_chunk_%hasher
    !__path_hash_tail_ptr_%hasher
    !__path_hash_tail_len_%hasher
    jmp L_PATH_HASH_WRITE_BYTES_INIT_%hasher

L_PATH_HASH_WRITE_BYTES_INIT_%hasher:
    store __path_hash_write_idx_slot_%hasher+0, 0 as u64
    jmp L_PATH_HASH_WRITE_BYTES_HEAD_%hasher

L_PATH_HASH_WRITE_BYTES_HEAD_%hasher:
    __path_hash_write_idx_%hasher = load __path_hash_write_idx_slot_%hasher+0 as u64
    __path_hash_write_len_%hasher = load __path_hash_write_len_slot_%hasher+0 as u64
    __path_hash_write_done_%hasher = eq __path_hash_write_idx_%hasher, __path_hash_write_len_%hasher
    br __path_hash_write_done_%hasher -> L_PATH_HASH_WRITE_BYTES_DONE_%hasher, L_PATH_HASH_WRITE_BYTES_BODY_%hasher

L_PATH_HASH_WRITE_BYTES_BODY_%hasher:
    __path_hash_write_ptr_%hasher = load __path_hash_write_ptr_slot_%hasher+0 as ptr
    __path_hash_write_item_%hasher = ptr_add __path_hash_write_ptr_%hasher, __path_hash_write_idx_%hasher
    __path_hash_write_value_%hasher = load __path_hash_write_item_%hasher+0 as u8
    EXPAND DEFAULT_HASHER_WRITE_U8 %hasher, __path_hash_write_value_%hasher
    __path_hash_write_next_%hasher = add __path_hash_write_idx_%hasher, 1
    store __path_hash_write_idx_slot_%hasher+0, __path_hash_write_next_%hasher as u64
    !__path_hash_write_next_%hasher
    !__path_hash_write_value_%hasher
    !__path_hash_write_item_%hasher
    !__path_hash_write_ptr_%hasher
    !__path_hash_write_done_%hasher
    !__path_hash_write_len_%hasher
    !__path_hash_write_idx_%hasher
    jmp L_PATH_HASH_WRITE_BYTES_HEAD_%hasher

L_PATH_HASH_WRITE_BYTES_DONE_%hasher:
    __path_hash_return_%hasher = load __path_hash_return_slot_%hasher+0 as u64
    __path_hash_return_component_%hasher = eq __path_hash_return_%hasher, 1
    br __path_hash_return_component_%hasher -> L_PATH_HASH_AFTER_COMPONENT_%hasher, L_PATH_HASH_FINISH_%hasher

L_PATH_HASH_FINISH_%hasher:
    __path_hash_chunk_final_%hasher = load __path_hash_chunk_slot_%hasher+0 as u64
    EXPAND DEFAULT_HASHER_WRITE_USIZE %hasher, __path_hash_chunk_final_%hasher
    !__path_hash_chunk_final_%hasher
    !__path_hash_has_tail_%hasher
    !__path_hash_final_start_%hasher
    !__path_hash_done_%hasher
    !__path_hash_idx_%hasher
    !__path_hash_len_%hasher
    !__path_hash_ptr_%hasher
[END_MACRO]

[MACRO] PATH_HASH %out_hash, %path_slice
    __path_hash_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __path_hash_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_PATH __path_hash_hasher_%out_hash, %path_slice
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __path_hash_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_PATH %out_hash, %builder, %path_slice
    __build_hash_one_path_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_path_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_PATH __build_hash_one_path_hasher_%out_hash, %path_slice
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_path_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_PATH %out_hash, %state, %path_slice
    __random_state_hash_one_path_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_path_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_PATH __random_state_hash_one_path_hasher_%out_hash, %path_slice
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_path_hasher_%out_hash
[END_MACRO]

[MACRO] PATH_EXISTS %out_flag, %path_slice
    __path_exists_ptr_%out_flag = load %path_slice+Slice_ptr as ptr
    __path_exists_len_%out_flag = load %path_slice+Slice_len as u64
    EXPAND FS_EXISTS %out_flag, __path_exists_ptr_%out_flag, __path_exists_len_%out_flag
    !__path_exists_len_%out_flag
    !__path_exists_ptr_%out_flag
[END_MACRO]

[MACRO] PATH_TRY_EXISTS %out_status, %out_flag, %path_slice
    __path_try_exists_ptr_%out_status = load %path_slice+Slice_ptr as ptr
    __path_try_exists_len_%out_status = load %path_slice+Slice_len as u64
    EXPAND FS_TRY_EXISTS %out_status, %out_flag, __path_try_exists_ptr_%out_status, __path_try_exists_len_%out_status
    !__path_try_exists_len_%out_status
    !__path_try_exists_ptr_%out_status
[END_MACRO]

[MACRO] PATH_METADATA %out_status, %out_metadata, %path_slice
    __path_metadata_ptr_%out_status = load %path_slice+Slice_ptr as ptr
    __path_metadata_len_%out_status = load %path_slice+Slice_len as u64
    EXPAND FS_METADATA %out_status, %out_metadata, __path_metadata_ptr_%out_status, __path_metadata_len_%out_status
    !__path_metadata_len_%out_status
    !__path_metadata_ptr_%out_status
[END_MACRO]

[MACRO] PATH_CANONICALIZE %out_status, %out_buffer, %path_slice
    __path_canonical_ptr_%out_status = load %path_slice+Slice_ptr as ptr
    __path_canonical_len_%out_status = load %path_slice+Slice_len as u64
    EXPAND FS_CANONICALIZE %out_status, %out_buffer, __path_canonical_ptr_%out_status, __path_canonical_len_%out_status
    !__path_canonical_len_%out_status
    !__path_canonical_ptr_%out_status
[END_MACRO]

[MACRO] PATH_READ_LINK %out_status, %out_buffer, %path_slice
    __path_read_link_ptr_%out_status = load %path_slice+Slice_ptr as ptr
    __path_read_link_len_%out_status = load %path_slice+Slice_len as u64
    EXPAND FS_READ_LINK %out_status, %out_buffer, __path_read_link_ptr_%out_status, __path_read_link_len_%out_status
    !__path_read_link_len_%out_status
    !__path_read_link_ptr_%out_status
[END_MACRO]

[MACRO] PATH_IS_FILE %out_flag, %path_slice
    __path_is_file_ptr_%out_flag = load %path_slice+Slice_ptr as ptr
    __path_is_file_len_%out_flag = load %path_slice+Slice_len as u64
    EXPAND FS_METADATA __path_is_file_status_%out_flag, __path_is_file_metadata_%out_flag, __path_is_file_ptr_%out_flag, __path_is_file_len_%out_flag
    __path_is_file_ok_%out_flag = eq __path_is_file_status_%out_flag, SA_FS_OK
    br __path_is_file_ok_%out_flag -> L_PATH_IS_FILE_OK_%out_flag, L_PATH_IS_FILE_MISS_%out_flag

L_PATH_IS_FILE_OK_%out_flag:
    EXPAND FS_METADATA_IS_FILE %out_flag, __path_is_file_metadata_%out_flag
    EXPAND FS_METADATA_FREE __path_is_file_free_status_%out_flag, __path_is_file_metadata_%out_flag
    !__path_is_file_free_status_%out_flag
    !__path_is_file_ok_%out_flag
    !__path_is_file_status_%out_flag
    !__path_is_file_metadata_%out_flag
    !__path_is_file_len_%out_flag
    !__path_is_file_ptr_%out_flag
    jmp L_PATH_IS_FILE_END_%out_flag

L_PATH_IS_FILE_MISS_%out_flag:
    %out_flag = add 0, 0
    !__path_is_file_ok_%out_flag
    !__path_is_file_status_%out_flag
    !__path_is_file_metadata_%out_flag
    !__path_is_file_len_%out_flag
    !__path_is_file_ptr_%out_flag

L_PATH_IS_FILE_END_%out_flag:
[END_MACRO]

[MACRO] PATH_IS_DIR %out_flag, %path_slice
    __path_is_dir_ptr_%out_flag = load %path_slice+Slice_ptr as ptr
    __path_is_dir_len_%out_flag = load %path_slice+Slice_len as u64
    EXPAND FS_METADATA __path_is_dir_status_%out_flag, __path_is_dir_metadata_%out_flag, __path_is_dir_ptr_%out_flag, __path_is_dir_len_%out_flag
    __path_is_dir_ok_%out_flag = eq __path_is_dir_status_%out_flag, SA_FS_OK
    br __path_is_dir_ok_%out_flag -> L_PATH_IS_DIR_OK_%out_flag, L_PATH_IS_DIR_MISS_%out_flag

L_PATH_IS_DIR_OK_%out_flag:
    EXPAND FS_METADATA_IS_DIR %out_flag, __path_is_dir_metadata_%out_flag
    EXPAND FS_METADATA_FREE __path_is_dir_free_status_%out_flag, __path_is_dir_metadata_%out_flag
    !__path_is_dir_free_status_%out_flag
    !__path_is_dir_ok_%out_flag
    !__path_is_dir_status_%out_flag
    !__path_is_dir_metadata_%out_flag
    !__path_is_dir_len_%out_flag
    !__path_is_dir_ptr_%out_flag
    jmp L_PATH_IS_DIR_END_%out_flag

L_PATH_IS_DIR_MISS_%out_flag:
    %out_flag = add 0, 0
    !__path_is_dir_ok_%out_flag
    !__path_is_dir_status_%out_flag
    !__path_is_dir_metadata_%out_flag
    !__path_is_dir_len_%out_flag
    !__path_is_dir_ptr_%out_flag

L_PATH_IS_DIR_END_%out_flag:
[END_MACRO]

[MACRO] PATH_IS_SYMLINK %out_flag, %path_slice
    __path_is_symlink_ptr_%out_flag = load %path_slice+Slice_ptr as ptr
    __path_is_symlink_len_%out_flag = load %path_slice+Slice_len as u64
    EXPAND FS_METADATA __path_is_symlink_status_%out_flag, __path_is_symlink_metadata_%out_flag, __path_is_symlink_ptr_%out_flag, __path_is_symlink_len_%out_flag
    __path_is_symlink_ok_%out_flag = eq __path_is_symlink_status_%out_flag, SA_FS_OK
    br __path_is_symlink_ok_%out_flag -> L_PATH_IS_SYMLINK_OK_%out_flag, L_PATH_IS_SYMLINK_MISS_%out_flag

L_PATH_IS_SYMLINK_OK_%out_flag:
    EXPAND FS_METADATA_IS_SYMLINK %out_flag, __path_is_symlink_metadata_%out_flag
    EXPAND FS_METADATA_FREE __path_is_symlink_free_status_%out_flag, __path_is_symlink_metadata_%out_flag
    !__path_is_symlink_free_status_%out_flag
    !__path_is_symlink_ok_%out_flag
    !__path_is_symlink_status_%out_flag
    !__path_is_symlink_metadata_%out_flag
    !__path_is_symlink_len_%out_flag
    !__path_is_symlink_ptr_%out_flag
    jmp L_PATH_IS_SYMLINK_END_%out_flag

L_PATH_IS_SYMLINK_MISS_%out_flag:
    %out_flag = add 0, 0
    !__path_is_symlink_ok_%out_flag
    !__path_is_symlink_status_%out_flag
    !__path_is_symlink_metadata_%out_flag
    !__path_is_symlink_len_%out_flag
    !__path_is_symlink_ptr_%out_flag

L_PATH_IS_SYMLINK_END_%out_flag:
[END_MACRO]

[MACRO] PATH_STRIP_EXTENSION %out_slice, %path_slice
    EXPAND PATH_PARENT __path_strip_ext_parent_%out_slice, %path_slice
    EXPAND PATH_FILE_STEM __path_strip_ext_stem_%out_slice, %path_slice
    EXPAND PATH_JOIN %out_slice, __path_strip_ext_parent_%out_slice, __path_strip_ext_stem_%out_slice
    !__path_strip_ext_stem_%out_slice
    !__path_strip_ext_parent_%out_slice
[END_MACRO]

[MACRO] PATH_WITH_FILE_NAME %out_slice, %path_slice, %file_name_slice
    EXPAND PATH_PARENT __path_parent_%out_slice, %path_slice
    EXPAND PATH_JOIN %out_slice, __path_parent_%out_slice, %file_name_slice
    !__path_parent_%out_slice
[END_MACRO]

[MACRO] PATH_WITH_EXTENSION %out_slice, %path_slice, %extension_slice
    EXPAND PATH_STRIP_EXTENSION __path_no_ext_%out_slice, %path_slice
    __path_ext_len_%out_slice = load %extension_slice+Slice_len as u64
    __path_ext_empty_%out_slice = eq __path_ext_len_%out_slice, 0
    br __path_ext_empty_%out_slice -> L_PATH_WITH_EXTENSION_NO_EXT_%out_slice, L_PATH_WITH_EXTENSION_JOIN_%out_slice

L_PATH_WITH_EXTENSION_JOIN_%out_slice:
    __path_dot_ptr_%out_slice = stack_alloc 1
    store __path_dot_ptr_%out_slice+0, 46 as u8
    __path_dot_slice_%out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW __path_dot_slice_%out_slice, __path_dot_ptr_%out_slice, 1
    EXPAND STR_CONCAT __path_dot_ext_%out_slice, __path_dot_slice_%out_slice, %extension_slice
    EXPAND STR_CONCAT %out_slice, __path_no_ext_%out_slice, __path_dot_ext_%out_slice
    !__path_dot_ext_%out_slice
    !__path_dot_slice_%out_slice
    !__path_ext_empty_%out_slice
    !__path_ext_len_%out_slice
    !__path_no_ext_%out_slice
    jmp L_PATH_WITH_EXTENSION_END_%out_slice

L_PATH_WITH_EXTENSION_NO_EXT_%out_slice:
    __path_no_ext_len_%out_slice = load __path_no_ext_%out_slice+Slice_len as u64
    EXPAND STR_SLICE %out_slice, __path_no_ext_%out_slice, 0, __path_no_ext_len_%out_slice
    !__path_no_ext_len_%out_slice
    !__path_ext_empty_%out_slice
    !__path_ext_len_%out_slice
    !__path_no_ext_%out_slice

L_PATH_WITH_EXTENSION_END_%out_slice:
[END_MACRO]

[MACRO] PATH_WITH_ADDED_EXTENSION %out_slice, %path_slice, %extension_slice
    __path_add_ext_len_%out_slice = load %extension_slice+Slice_len as u64
    __path_add_ext_empty_%out_slice = eq __path_add_ext_len_%out_slice, 0
    br __path_add_ext_empty_%out_slice -> L_PATH_ADD_EXTENSION_COPY_%out_slice, L_PATH_ADD_EXTENSION_JOIN_%out_slice

L_PATH_ADD_EXTENSION_JOIN_%out_slice:
    __path_add_dot_ptr_%out_slice = stack_alloc 1
    store __path_add_dot_ptr_%out_slice+0, 46 as u8
    __path_add_dot_slice_%out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW __path_add_dot_slice_%out_slice, __path_add_dot_ptr_%out_slice, 1
    EXPAND STR_CONCAT __path_add_dot_ext_%out_slice, __path_add_dot_slice_%out_slice, %extension_slice
    EXPAND STR_CONCAT %out_slice, %path_slice, __path_add_dot_ext_%out_slice
    !__path_add_dot_ext_%out_slice
    !__path_add_dot_slice_%out_slice
    !__path_add_ext_empty_%out_slice
    !__path_add_ext_len_%out_slice
    jmp L_PATH_ADD_EXTENSION_END_%out_slice

L_PATH_ADD_EXTENSION_COPY_%out_slice:
    __path_add_copy_len_%out_slice = load %path_slice+Slice_len as u64
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_add_copy_len_%out_slice
    !__path_add_copy_len_%out_slice
    !__path_add_ext_empty_%out_slice
    !__path_add_ext_len_%out_slice

L_PATH_ADD_EXTENSION_END_%out_slice:
[END_MACRO]

[MACRO] PATH_TRIM_TRAILING_SEPARATOR %out_slice, %path_slice
    __path_trim_sep_len_%out_slice = load %path_slice+Slice_len as u64
    __path_trim_sep_empty_%out_slice = eq __path_trim_sep_len_%out_slice, 0
    br __path_trim_sep_empty_%out_slice -> L_PATH_TRIM_SEP_EMPTY_%out_slice, L_PATH_TRIM_SEP_INIT_%out_slice

L_PATH_TRIM_SEP_INIT_%out_slice:
    __path_trim_sep_end_slot_%out_slice = stack_alloc 8
    store __path_trim_sep_end_slot_%out_slice+0, __path_trim_sep_len_%out_slice as u64
    jmp L_PATH_TRIM_SEP_HEAD_%out_slice

L_PATH_TRIM_SEP_HEAD_%out_slice:
    __path_trim_sep_end_%out_slice = load __path_trim_sep_end_slot_%out_slice+0 as u64
    __path_trim_sep_keep_root_%out_slice = ule __path_trim_sep_end_%out_slice, 1
    br __path_trim_sep_keep_root_%out_slice -> L_PATH_TRIM_SEP_COPY_CURRENT_%out_slice, L_PATH_TRIM_SEP_CHECK_LAST_%out_slice

L_PATH_TRIM_SEP_CHECK_LAST_%out_slice:
    __path_trim_sep_ptr_%out_slice = load %path_slice+Slice_ptr as ptr
    __path_trim_sep_prev_%out_slice = sub __path_trim_sep_end_%out_slice, 1
    __path_trim_sep_last_ptr_%out_slice = ptr_add __path_trim_sep_ptr_%out_slice, __path_trim_sep_prev_%out_slice
    __path_trim_sep_last_%out_slice = load __path_trim_sep_last_ptr_%out_slice+0 as u8
    __path_trim_sep_is_sep_%out_slice = eq __path_trim_sep_last_%out_slice, 47
    br __path_trim_sep_is_sep_%out_slice -> L_PATH_TRIM_SEP_DROP_%out_slice, L_PATH_TRIM_SEP_COPY_AFTER_CHECK_%out_slice

L_PATH_TRIM_SEP_DROP_%out_slice:
    store __path_trim_sep_end_slot_%out_slice+0, __path_trim_sep_prev_%out_slice as u64
    !__path_trim_sep_is_sep_%out_slice
    !__path_trim_sep_last_%out_slice
    !__path_trim_sep_last_ptr_%out_slice
    !__path_trim_sep_prev_%out_slice
    !__path_trim_sep_ptr_%out_slice
    !__path_trim_sep_keep_root_%out_slice
    !__path_trim_sep_end_%out_slice
    jmp L_PATH_TRIM_SEP_HEAD_%out_slice

L_PATH_TRIM_SEP_COPY_AFTER_CHECK_%out_slice:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_trim_sep_end_%out_slice
    !__path_trim_sep_is_sep_%out_slice
    !__path_trim_sep_last_%out_slice
    !__path_trim_sep_last_ptr_%out_slice
    !__path_trim_sep_prev_%out_slice
    !__path_trim_sep_ptr_%out_slice
    !__path_trim_sep_keep_root_%out_slice
    !__path_trim_sep_end_%out_slice
    !__path_trim_sep_empty_%out_slice
    !__path_trim_sep_len_%out_slice
    jmp L_PATH_TRIM_SEP_END_%out_slice

L_PATH_TRIM_SEP_COPY_CURRENT_%out_slice:
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_trim_sep_end_%out_slice
    !__path_trim_sep_keep_root_%out_slice
    !__path_trim_sep_end_%out_slice
    !__path_trim_sep_empty_%out_slice
    !__path_trim_sep_len_%out_slice
    jmp L_PATH_TRIM_SEP_END_%out_slice

L_PATH_TRIM_SEP_EMPTY_%out_slice:
    EXPAND PATH_MAKE_EMPTY %out_slice
    !__path_trim_sep_empty_%out_slice
    !__path_trim_sep_len_%out_slice

L_PATH_TRIM_SEP_END_%out_slice:
[END_MACRO]

[MACRO] PATH_WITH_TRAILING_SEPARATOR %out_slice, %path_slice
    EXPAND PATH_ENDS_WITH_SEPARATOR __path_with_sep_has_%out_slice, %path_slice
    br __path_with_sep_has_%out_slice -> L_PATH_WITH_SEP_COPY_%out_slice, L_PATH_WITH_SEP_APPEND_%out_slice

L_PATH_WITH_SEP_APPEND_%out_slice:
    EXPAND STR_FROM_PARTS __path_with_sep_sep_slice_%out_slice, &PATH_SEPARATOR, 1
    EXPAND STR_CONCAT %out_slice, %path_slice, __path_with_sep_sep_slice_%out_slice
    !__path_with_sep_sep_slice_%out_slice
    !__path_with_sep_has_%out_slice
    jmp L_PATH_WITH_SEP_END_%out_slice

L_PATH_WITH_SEP_COPY_%out_slice:
    __path_with_sep_len_%out_slice = load %path_slice+Slice_len as u64
    EXPAND STR_SLICE %out_slice, %path_slice, 0, __path_with_sep_len_%out_slice
    !__path_with_sep_len_%out_slice
    !__path_with_sep_has_%out_slice

L_PATH_WITH_SEP_END_%out_slice:
[END_MACRO]

[MACRO] PATH_COMPONENT_COUNT %out_count, %path_slice
    __path_comp_ptr_%out_count = load %path_slice+Slice_ptr as ptr
    __path_comp_len_%out_count = load %path_slice+Slice_len as u64
    __path_comp_idx_slot_%out_count = stack_alloc 8
    __path_comp_in_slot_%out_count = stack_alloc 8
    store __path_comp_idx_slot_%out_count+0, 0 as u64
    store __path_comp_in_slot_%out_count+0, 0 as u64
    %out_count = add 0, 0
    jmp L_PATH_COMPONENT_COUNT_HEAD_%out_count

L_PATH_COMPONENT_COUNT_HEAD_%out_count:
    __path_comp_idx_%out_count = load __path_comp_idx_slot_%out_count+0 as u64
    __path_comp_done_%out_count = eq __path_comp_idx_%out_count, __path_comp_len_%out_count
    br __path_comp_done_%out_count -> L_PATH_COMPONENT_COUNT_DONE_%out_count, L_PATH_COMPONENT_COUNT_BODY_%out_count

L_PATH_COMPONENT_COUNT_BODY_%out_count:
    __path_comp_ch_ptr_%out_count = ptr_add __path_comp_ptr_%out_count, __path_comp_idx_%out_count
    __path_comp_ch_%out_count = load __path_comp_ch_ptr_%out_count+0 as u8
    __path_comp_is_sep_%out_count = eq __path_comp_ch_%out_count, 47
    br __path_comp_is_sep_%out_count -> L_PATH_COMPONENT_COUNT_SEP_%out_count, L_PATH_COMPONENT_COUNT_NON_SEP_%out_count

L_PATH_COMPONENT_COUNT_NON_SEP_%out_count:
    __path_comp_in_%out_count = load __path_comp_in_slot_%out_count+0 as u64
    __path_comp_was_out_%out_count = eq __path_comp_in_%out_count, 0
    br __path_comp_was_out_%out_count -> L_PATH_COMPONENT_COUNT_START_%out_count, L_PATH_COMPONENT_COUNT_NEXT_NON_SEP_%out_count

L_PATH_COMPONENT_COUNT_START_%out_count:
    %out_count = add %out_count, 1
    store __path_comp_in_slot_%out_count+0, 1 as u64
    !__path_comp_was_out_%out_count
    !__path_comp_in_%out_count
    jmp L_PATH_COMPONENT_COUNT_NEXT_%out_count

L_PATH_COMPONENT_COUNT_NEXT_NON_SEP_%out_count:
    !__path_comp_was_out_%out_count
    !__path_comp_in_%out_count
    jmp L_PATH_COMPONENT_COUNT_NEXT_%out_count

L_PATH_COMPONENT_COUNT_SEP_%out_count:
    store __path_comp_in_slot_%out_count+0, 0 as u64
    jmp L_PATH_COMPONENT_COUNT_NEXT_%out_count

L_PATH_COMPONENT_COUNT_NEXT_%out_count:
    __path_comp_next_%out_count = add __path_comp_idx_%out_count, 1
    store __path_comp_idx_slot_%out_count+0, __path_comp_next_%out_count as u64
    !__path_comp_next_%out_count
    !__path_comp_is_sep_%out_count
