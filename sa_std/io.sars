@import "io.sal"
@import "fmt.sai"
@import "io.sai"
@import "core/mem.sars"
@import "string.sai"
@import "os/fd.sars"

@const IO_NEWLINE = utf8:"\n"

[MACRO] PRINT %msg, %len
    call @sa_print_bytes(&%msg, %len)
[END_MACRO]

[MACRO] PRINTLN %msg, %len
    call @sa_print_bytes(&%msg, %len)
    call @sa_print_bytes(&IO_NEWLINE, 1)
[END_MACRO]

[MACRO] WRITE %handle, %msg, %len
    call @sa_io_write_all(%handle, &%msg, %len)
[END_MACRO]

[MACRO] WRITELN %handle, %msg, %len
    call @sa_io_write_all(%handle, &%msg, %len)
    call @sa_io_write_all(%handle, &IO_NEWLINE, 1)
[END_MACRO]

[MACRO] IO_STDIN %out_handle
    %out_handle = call @sa_io_stdin()
[END_MACRO]

[MACRO] IO_STDOUT %out_handle
    %out_handle = call @sa_io_stdout()
[END_MACRO]

[MACRO] IO_STDERR %out_handle
    %out_handle = call @sa_io_stderr()
[END_MACRO]

[MACRO] IO_STDIN_AS_RAW_FD %out_status, %out_fd
    __io_stdin_handle_%out_status = call @sa_io_stdin()
    EXPAND FD_AS_RAW %out_status, %out_fd, __io_stdin_handle_%out_status
    !__io_stdin_handle_%out_status
[END_MACRO]

[MACRO] IO_STDIN_AS_FD %out_status, %out_fd
    __io_stdin_handle_%out_status = call @sa_io_stdin()
    EXPAND FD_AS_RAW %out_status, %out_fd, __io_stdin_handle_%out_status
    !__io_stdin_handle_%out_status
[END_MACRO]

[MACRO] IO_STDOUT_AS_RAW_FD %out_status, %out_fd
    __io_stdout_handle_%out_status = call @sa_io_stdout()
    EXPAND FD_AS_RAW %out_status, %out_fd, __io_stdout_handle_%out_status
    !__io_stdout_handle_%out_status
[END_MACRO]

[MACRO] IO_STDOUT_AS_FD %out_status, %out_fd
    __io_stdout_handle_%out_status = call @sa_io_stdout()
    EXPAND FD_AS_RAW %out_status, %out_fd, __io_stdout_handle_%out_status
    !__io_stdout_handle_%out_status
[END_MACRO]

[MACRO] IO_STDERR_AS_RAW_FD %out_status, %out_fd
    __io_stderr_handle_%out_status = call @sa_io_stderr()
    EXPAND FD_AS_RAW %out_status, %out_fd, __io_stderr_handle_%out_status
    !__io_stderr_handle_%out_status
[END_MACRO]

[MACRO] IO_STDERR_AS_FD %out_status, %out_fd
    __io_stderr_handle_%out_status = call @sa_io_stderr()
    EXPAND FD_AS_RAW %out_status, %out_fd, __io_stderr_handle_%out_status
    !__io_stderr_handle_%out_status
[END_MACRO]

[MACRO] EPRINT %msg, %len
    __eprint_handle = call @sa_io_stderr()
    EXPAND WRITE __eprint_handle, %msg, %len
    !__eprint_handle
[END_MACRO]

[MACRO] EPRINTLN %msg, %len
    __eprintln_handle = call @sa_io_stderr()
    EXPAND WRITELN __eprintln_handle, %msg, %len
    !__eprintln_handle
[END_MACRO]

[MACRO] READ_LINE %out_buf, %handle, %max_bytes
    __read_line = call @sa_io_read_line(%handle, %max_bytes)
    %out_buf = ? __read_line
    !__read_line
[END_MACRO]

[MACRO] IO_READ_LINE %out_buf, %handle, %max_bytes
    EXPAND READ_LINE %out_buf, %handle, %max_bytes
[END_MACRO]

[MACRO] READ %out_len, %handle, %buf, %cap
    __read_len_slot = stack_alloc 8
    __read_status = call @sa_io_read(%handle, &%buf, %cap, &__read_len_slot)
    %out_len = load __read_len_slot+0 as u64
    !__read_status
[END_MACRO]

[MACRO] IO_READ_SOME %out_len, %handle, %buf, %cap
    EXPAND READ %out_len, %handle, %buf, %cap
[END_MACRO]

[MACRO] WRITE_SOME %out_len, %handle, %buf, %len
    __write_len_slot = stack_alloc 8
    __write_status = call @sa_io_write(%handle, &%buf, %len, &__write_len_slot)
    %out_len = load __write_len_slot+0 as u64
    !__write_status
[END_MACRO]

[MACRO] IO_WRITE_SOME %out_len, %handle, %buf, %len
    EXPAND WRITE_SOME %out_len, %handle, %buf, %len
[END_MACRO]

[MACRO] FORMAT_INT %out_buf, %value, %base
    %out_buf = call @sa_fmt_i64(%value, %base)
[END_MACRO]

[MACRO] IO_ERROR_KIND_FROM_STATUS %out_kind, %status
    __io_kind_eof_%out_kind = eq %status, SA_IO_ERR_EOF
    br __io_kind_eof_%out_kind -> L_IO_KIND_EOF_%out_kind, L_IO_KIND_WOULD_BLOCK_CHECK_%out_kind

L_IO_KIND_EOF_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_UNEXPECTED_EOF
    !__io_kind_eof_%out_kind
    jmp L_IO_KIND_END_%out_kind

L_IO_KIND_WOULD_BLOCK_CHECK_%out_kind:
    __io_kind_would_block_%out_kind = eq %status, SA_IO_ERR_WOULD_BLOCK
    br __io_kind_would_block_%out_kind -> L_IO_KIND_WOULD_BLOCK_%out_kind, L_IO_KIND_INTERRUPTED_CHECK_%out_kind

L_IO_KIND_WOULD_BLOCK_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_WOULD_BLOCK
    !__io_kind_would_block_%out_kind
    !__io_kind_eof_%out_kind
    jmp L_IO_KIND_END_%out_kind

L_IO_KIND_INTERRUPTED_CHECK_%out_kind:
    __io_kind_interrupted_%out_kind = eq %status, SA_IO_ERR_INTERRUPTED
    br __io_kind_interrupted_%out_kind -> L_IO_KIND_INTERRUPTED_%out_kind, L_IO_KIND_INVALID_CHECK_%out_kind

L_IO_KIND_INTERRUPTED_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_INTERRUPTED
    !__io_kind_interrupted_%out_kind
    !__io_kind_would_block_%out_kind
    !__io_kind_eof_%out_kind
    jmp L_IO_KIND_END_%out_kind

L_IO_KIND_INVALID_CHECK_%out_kind:
    __io_kind_invalid_%out_kind = eq %status, SA_IO_ERR_INVALID_HANDLE
    br __io_kind_invalid_%out_kind -> L_IO_KIND_INVALID_%out_kind, L_IO_KIND_INVALID_DATA_CHECK_%out_kind

L_IO_KIND_INVALID_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_INVALID_INPUT
    !__io_kind_invalid_%out_kind
    !__io_kind_interrupted_%out_kind
    !__io_kind_would_block_%out_kind
    !__io_kind_eof_%out_kind
    jmp L_IO_KIND_END_%out_kind

L_IO_KIND_INVALID_DATA_CHECK_%out_kind:
    __io_kind_invalid_data_%out_kind = eq %status, SA_IO_ERR_INVALID_DATA
    br __io_kind_invalid_data_%out_kind -> L_IO_KIND_INVALID_DATA_%out_kind, L_IO_KIND_OTHER_%out_kind

L_IO_KIND_INVALID_DATA_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_INVALID_DATA
    !__io_kind_invalid_data_%out_kind
    !__io_kind_invalid_%out_kind
    !__io_kind_interrupted_%out_kind
    !__io_kind_would_block_%out_kind
    !__io_kind_eof_%out_kind
    jmp L_IO_KIND_END_%out_kind

L_IO_KIND_OTHER_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_OTHER
    !__io_kind_invalid_data_%out_kind
    !__io_kind_invalid_%out_kind
    !__io_kind_interrupted_%out_kind
    !__io_kind_would_block_%out_kind
    !__io_kind_eof_%out_kind

L_IO_KIND_END_%out_kind:
[END_MACRO]

[MACRO] IO_ERROR_KIND_IS_RETRYABLE %out_bool, %kind
    __io_retry_would_block_%out_bool = eq %kind, IO_ERROR_KIND_WOULD_BLOCK
    __io_retry_interrupted_%out_bool = eq %kind, IO_ERROR_KIND_INTERRUPTED
    %out_bool = or __io_retry_would_block_%out_bool, __io_retry_interrupted_%out_bool
    !__io_retry_interrupted_%out_bool
    !__io_retry_would_block_%out_bool
[END_MACRO]

[MACRO] IO_SLICE_NEW %io_slice, %ptr, %len
    store %io_slice+IoSlice_ptr, %ptr as ptr
    store %io_slice+IoSlice_len, %len as u64
[END_MACRO]

[MACRO] IO_SLICE_AS_PTR %out_ptr, %io_slice
    %out_ptr = load %io_slice+IoSlice_ptr as ptr
[END_MACRO]

[MACRO] IO_SLICE_LEN %out_len, %io_slice
    %out_len = load %io_slice+IoSlice_len as u64
[END_MACRO]

[MACRO] IO_SLICE_IS_EMPTY %out_bool, %io_slice
    __io_slice_len_%out_bool = load %io_slice+IoSlice_len as u64
    %out_bool = eq __io_slice_len_%out_bool, 0
    !__io_slice_len_%out_bool
[END_MACRO]

[MACRO] IO_SLICE_MUT_NEW %io_slice, %ptr, %len
    store %io_slice+IoSliceMut_ptr, %ptr as ptr
    store %io_slice+IoSliceMut_len, %len as u64
[END_MACRO]

[MACRO] IO_SLICE_MUT_AS_PTR %out_ptr, %io_slice
    %out_ptr = load %io_slice+IoSliceMut_ptr as ptr
[END_MACRO]

[MACRO] IO_SLICE_MUT_LEN %out_len, %io_slice
    %out_len = load %io_slice+IoSliceMut_len as u64
[END_MACRO]

[MACRO] IO_SLICE_MUT_IS_EMPTY %out_bool, %io_slice
    __io_slice_mut_len_%out_bool = load %io_slice+IoSliceMut_len as u64
    %out_bool = eq __io_slice_mut_len_%out_bool, 0
    !__io_slice_mut_len_%out_bool
[END_MACRO]

[MACRO] IO_CURSOR_NEW %cursor, %ptr, %len
    store %cursor+IoCursor_ptr, %ptr as ptr
    store %cursor+IoCursor_len, %len as u64
    store %cursor+IoCursor_pos, 0 as u64
[END_MACRO]

[MACRO] IO_CURSOR_AS_PTR %out_ptr, %cursor
    %out_ptr = load %cursor+IoCursor_ptr as ptr
[END_MACRO]

[MACRO] IO_CURSOR_LEN %out_len, %cursor
    %out_len = load %cursor+IoCursor_len as u64
[END_MACRO]

[MACRO] IO_CURSOR_IS_EMPTY %out_bool, %cursor
    __io_cursor_len_%out_bool = load %cursor+IoCursor_len as u64
    %out_bool = eq __io_cursor_len_%out_bool, 0
    !__io_cursor_len_%out_bool
[END_MACRO]

[MACRO] IO_CURSOR_AS_SLICE %out_slice, %cursor
    __io_cursor_ptr_%out_slice = load %cursor+IoCursor_ptr as ptr
    __io_cursor_len_%out_slice = load %cursor+IoCursor_len as u64
    store %out_slice+IoSlice_ptr, __io_cursor_ptr_%out_slice as ptr
    store %out_slice+IoSlice_len, __io_cursor_len_%out_slice as u64
    !__io_cursor_len_%out_slice
    !__io_cursor_ptr_%out_slice
[END_MACRO]

[MACRO] IO_CURSOR_AS_MUT_SLICE %out_slice, %cursor
    __io_cursor_ptr_%out_slice = load %cursor+IoCursor_ptr as ptr
    __io_cursor_len_%out_slice = load %cursor+IoCursor_len as u64
    store %out_slice+IoSliceMut_ptr, __io_cursor_ptr_%out_slice as ptr
    store %out_slice+IoSliceMut_len, __io_cursor_len_%out_slice as u64
    !__io_cursor_len_%out_slice
    !__io_cursor_ptr_%out_slice
[END_MACRO]

[MACRO] IO_CURSOR_INTO_INNER %out_ptr, %out_len, %cursor
    %out_ptr = load %cursor+IoCursor_ptr as ptr
    %out_len = load %cursor+IoCursor_len as u64
[END_MACRO]

[MACRO] IO_CURSOR_POSITION %out_pos, %cursor
    %out_pos = load %cursor+IoCursor_pos as u64
[END_MACRO]

[MACRO] IO_CURSOR_SET_POSITION %cursor, %pos
    store %cursor+IoCursor_pos, %pos as u64
[END_MACRO]

[MACRO] IO_CURSOR_REMAINING %out_len, %cursor
    __io_cursor_len_%out_len = load %cursor+IoCursor_len as u64
    __io_cursor_pos_%out_len = load %cursor+IoCursor_pos as u64
    __io_cursor_past_end_%out_len = uge __io_cursor_pos_%out_len, __io_cursor_len_%out_len
    br __io_cursor_past_end_%out_len -> L_IO_CURSOR_REMAINING_ZERO_%out_len, L_IO_CURSOR_REMAINING_SUB_%out_len

L_IO_CURSOR_REMAINING_ZERO_%out_len:
    %out_len = add 0, 0
    !__io_cursor_past_end_%out_len
    !__io_cursor_pos_%out_len
    !__io_cursor_len_%out_len
    jmp L_IO_CURSOR_REMAINING_END_%out_len

L_IO_CURSOR_REMAINING_SUB_%out_len:
    %out_len = sub __io_cursor_len_%out_len, __io_cursor_pos_%out_len
    !__io_cursor_past_end_%out_len
    !__io_cursor_pos_%out_len
    !__io_cursor_len_%out_len

L_IO_CURSOR_REMAINING_END_%out_len:
[END_MACRO]

[MACRO] IO_CURSOR_REMAINING_SLICE %out_slice, %cursor
    EXPAND IO_CURSOR_REMAINING __io_cursor_remaining_slice_len_%out_slice, %cursor
    __io_cursor_remaining_slice_base_%out_slice = load %cursor+IoCursor_ptr as ptr
    __io_cursor_remaining_slice_pos_%out_slice = load %cursor+IoCursor_pos as u64
    __io_cursor_remaining_slice_ptr_%out_slice = ptr_add __io_cursor_remaining_slice_base_%out_slice, __io_cursor_remaining_slice_pos_%out_slice
    store %out_slice+IoSlice_ptr, __io_cursor_remaining_slice_ptr_%out_slice as ptr
    store %out_slice+IoSlice_len, __io_cursor_remaining_slice_len_%out_slice as u64
    !__io_cursor_remaining_slice_ptr_%out_slice
    !__io_cursor_remaining_slice_pos_%out_slice
    !__io_cursor_remaining_slice_base_%out_slice
    !__io_cursor_remaining_slice_len_%out_slice
[END_MACRO]

[MACRO] IO_CURSOR_READ %out_len, %cursor, %dst_ptr, %cap
    EXPAND IO_CURSOR_REMAINING __io_cursor_rem_%out_len, %cursor
    __io_cursor_take_cap_%out_len = ule %cap, __io_cursor_rem_%out_len
    br __io_cursor_take_cap_%out_len -> L_IO_CURSOR_READ_CAP_%out_len, L_IO_CURSOR_READ_REM_%out_len

L_IO_CURSOR_READ_CAP_%out_len:
    %out_len = add %cap, 0
    jmp L_IO_CURSOR_READ_COPY_%out_len

L_IO_CURSOR_READ_REM_%out_len:
    %out_len = add __io_cursor_rem_%out_len, 0

L_IO_CURSOR_READ_COPY_%out_len:
    __io_cursor_base_%out_len = load %cursor+IoCursor_ptr as ptr
    __io_cursor_pos_%out_len = load %cursor+IoCursor_pos as u64
    __io_cursor_src_%out_len = ptr_add __io_cursor_base_%out_len, __io_cursor_pos_%out_len
    call @sa_mem_copy(&%dst_ptr, &__io_cursor_src_%out_len, %out_len)
    __io_cursor_next_%out_len = add __io_cursor_pos_%out_len, %out_len
    store %cursor+IoCursor_pos, __io_cursor_next_%out_len as u64
    !__io_cursor_next_%out_len
    !__io_cursor_src_%out_len
    !__io_cursor_pos_%out_len
    !__io_cursor_base_%out_len
    !__io_cursor_take_cap_%out_len
    !__io_cursor_rem_%out_len
[END_MACRO]

[MACRO] IO_CURSOR_READ_EXACT %out_status, %cursor, %dst_ptr, %len
    EXPAND IO_CURSOR_REMAINING __io_cursor_exact_rem_%out_status, %cursor
    __io_cursor_exact_fits_%out_status = ule %len, __io_cursor_exact_rem_%out_status
    br __io_cursor_exact_fits_%out_status -> L_IO_CURSOR_READ_EXACT_OK_%out_status, L_IO_CURSOR_READ_EXACT_EOF_%out_status

L_IO_CURSOR_READ_EXACT_OK_%out_status:
    EXPAND IO_CURSOR_READ __io_cursor_exact_read_%out_status, %cursor, %dst_ptr, %len
    %out_status = add 0, SA_IO_OK
    !__io_cursor_exact_read_%out_status
    !__io_cursor_exact_fits_%out_status
    !__io_cursor_exact_rem_%out_status
    jmp L_IO_CURSOR_READ_EXACT_END_%out_status

L_IO_CURSOR_READ_EXACT_EOF_%out_status:
    __io_cursor_exact_len_%out_status = load %cursor+IoCursor_len as u64
    store %cursor+IoCursor_pos, __io_cursor_exact_len_%out_status as u64
    %out_status = add 0, SA_IO_ERR_EOF
    !__io_cursor_exact_len_%out_status
    !__io_cursor_exact_fits_%out_status
    !__io_cursor_exact_rem_%out_status

L_IO_CURSOR_READ_EXACT_END_%out_status:
[END_MACRO]

[MACRO] IO_CURSOR_FILL_BUF %out_status, %out_slice, %cursor
    EXPAND IO_CURSOR_REMAINING_SLICE %out_slice, %cursor
    %out_status = add 0, SA_IO_OK
[END_MACRO]

[MACRO] IO_CURSOR_CONSUME %cursor, %amt
    __io_cursor_consume_pos_%cursor = load %cursor+IoCursor_pos as u64
    __io_cursor_consume_next_%cursor = add __io_cursor_consume_pos_%cursor, %amt
    store %cursor+IoCursor_pos, __io_cursor_consume_next_%cursor as u64
    !__io_cursor_consume_next_%cursor
    !__io_cursor_consume_pos_%cursor
[END_MACRO]

[MACRO] IO_CURSOR_READ_TO_END %out_len, %cursor, %dst_ptr, %cap
    EXPAND IO_CURSOR_REMAINING __io_cursor_read_to_end_rem_%out_len, %cursor
    __io_cursor_read_to_end_cap_%out_len = ule %cap, __io_cursor_read_to_end_rem_%out_len
    br __io_cursor_read_to_end_cap_%out_len -> L_IO_CURSOR_READ_TO_END_CAP_%out_len, L_IO_CURSOR_READ_TO_END_REM_%out_len

L_IO_CURSOR_READ_TO_END_CAP_%out_len:
    %out_len = add %cap, 0
    jmp L_IO_CURSOR_READ_TO_END_COPY_%out_len

L_IO_CURSOR_READ_TO_END_REM_%out_len:
    %out_len = add __io_cursor_read_to_end_rem_%out_len, 0

L_IO_CURSOR_READ_TO_END_COPY_%out_len:
    __io_cursor_read_to_end_base_%out_len = load %cursor+IoCursor_ptr as ptr
    __io_cursor_read_to_end_pos_%out_len = load %cursor+IoCursor_pos as u64
    __io_cursor_read_to_end_src_%out_len = ptr_add __io_cursor_read_to_end_base_%out_len, __io_cursor_read_to_end_pos_%out_len
    call @sa_mem_copy(&%dst_ptr, &__io_cursor_read_to_end_src_%out_len, %out_len)
    __io_cursor_read_to_end_next_%out_len = add __io_cursor_read_to_end_pos_%out_len, %out_len
    store %cursor+IoCursor_pos, __io_cursor_read_to_end_next_%out_len as u64
    !__io_cursor_read_to_end_next_%out_len
    !__io_cursor_read_to_end_src_%out_len
    !__io_cursor_read_to_end_pos_%out_len
    !__io_cursor_read_to_end_base_%out_len

L_IO_CURSOR_READ_TO_END_DONE_%out_len:
    !__io_cursor_read_to_end_cap_%out_len
    !__io_cursor_read_to_end_rem_%out_len
[END_MACRO]

[MACRO] IO_CURSOR_READ_TO_STRING %out_status, %out_slice, %cursor, %dst_ptr, %cap
    EXPAND IO_CURSOR_READ_TO_END __io_cursor_read_to_string_len_%out_status, %cursor, %dst_ptr, %cap
    EXPAND IO_SLICE_NEW %out_slice, %dst_ptr, __io_cursor_read_to_string_len_%out_status
    __io_cursor_read_to_string_status_%out_status = call @sa_str_utf8_validate(&%dst_ptr, __io_cursor_read_to_string_len_%out_status)
    __io_cursor_read_to_string_ok_%out_status = eq __io_cursor_read_to_string_status_%out_status, 0
    br __io_cursor_read_to_string_ok_%out_status -> L_IO_CURSOR_READ_TO_STRING_OK_%out_status, L_IO_CURSOR_READ_TO_STRING_BAD_%out_status

L_IO_CURSOR_READ_TO_STRING_OK_%out_status:
    %out_status = add 0, SA_IO_OK
    !__io_cursor_read_to_string_ok_%out_status
    !__io_cursor_read_to_string_status_%out_status
    !__io_cursor_read_to_string_len_%out_status
    jmp L_IO_CURSOR_READ_TO_STRING_END_%out_status

L_IO_CURSOR_READ_TO_STRING_BAD_%out_status:
    %out_status = add 0, SA_IO_ERR_INVALID_DATA
    __io_cursor_read_to_string_null_%out_status = 0 as ptr
    EXPAND IO_SLICE_NEW %out_slice, __io_cursor_read_to_string_null_%out_status, 0
    !__io_cursor_read_to_string_null_%out_status
    !__io_cursor_read_to_string_ok_%out_status
    !__io_cursor_read_to_string_status_%out_status
    !__io_cursor_read_to_string_len_%out_status

L_IO_CURSOR_READ_TO_STRING_END_%out_status:
[END_MACRO]

[MACRO] IO_CURSOR_WRITE %out_len, %cursor, %src_ptr, %len
    EXPAND IO_CURSOR_REMAINING __io_cursor_rem_%out_len, %cursor
    __io_cursor_take_len_%out_len = ule %len, __io_cursor_rem_%out_len
    br __io_cursor_take_len_%out_len -> L_IO_CURSOR_WRITE_LEN_%out_len, L_IO_CURSOR_WRITE_REM_%out_len

L_IO_CURSOR_WRITE_LEN_%out_len:
    %out_len = add %len, 0
    jmp L_IO_CURSOR_WRITE_COPY_%out_len

L_IO_CURSOR_WRITE_REM_%out_len:
    %out_len = add __io_cursor_rem_%out_len, 0

L_IO_CURSOR_WRITE_COPY_%out_len:
    __io_cursor_base_%out_len = load %cursor+IoCursor_ptr as ptr
    __io_cursor_pos_%out_len = load %cursor+IoCursor_pos as u64
    __io_cursor_dst_%out_len = ptr_add __io_cursor_base_%out_len, __io_cursor_pos_%out_len
    call @sa_mem_copy(&__io_cursor_dst_%out_len, &%src_ptr, %out_len)
    __io_cursor_next_%out_len = add __io_cursor_pos_%out_len, %out_len
    store %cursor+IoCursor_pos, __io_cursor_next_%out_len as u64
    !__io_cursor_next_%out_len
    !__io_cursor_dst_%out_len
    !__io_cursor_pos_%out_len
    !__io_cursor_base_%out_len
    !__io_cursor_take_len_%out_len
    !__io_cursor_rem_%out_len
[END_MACRO]

[MACRO] IO_CURSOR_WRITE_ALL %out_status, %cursor, %src_ptr, %len
    EXPAND IO_CURSOR_WRITE __io_cursor_write_all_len_%out_status, %cursor, %src_ptr, %len
    __io_cursor_write_all_ok_%out_status = eq __io_cursor_write_all_len_%out_status, %len
    br __io_cursor_write_all_ok_%out_status -> L_IO_CURSOR_WRITE_ALL_OK_%out_status, L_IO_CURSOR_WRITE_ALL_EOF_%out_status

L_IO_CURSOR_WRITE_ALL_OK_%out_status:
    %out_status = add 0, SA_IO_OK
    !__io_cursor_write_all_ok_%out_status
    !__io_cursor_write_all_len_%out_status
    jmp L_IO_CURSOR_WRITE_ALL_END_%out_status

L_IO_CURSOR_WRITE_ALL_EOF_%out_status:
    %out_status = add 0, SA_IO_ERR_EOF
    !__io_cursor_write_all_ok_%out_status
    !__io_cursor_write_all_len_%out_status

L_IO_CURSOR_WRITE_ALL_END_%out_status:
[END_MACRO]

[MACRO] IO_CURSOR_SEEK_START %out_pos, %cursor, %pos
    store %cursor+IoCursor_pos, %pos as u64
    %out_pos = add %pos, 0
[END_MACRO]

[MACRO] IO_CURSOR_SEEK_CURRENT %out_pos, %cursor, %offset
    __io_cursor_seek_pos_%out_pos = load %cursor+IoCursor_pos as u64
    __io_cursor_seek_forward_%out_pos = sge %offset, 0
    br __io_cursor_seek_forward_%out_pos -> L_IO_CURSOR_SEEK_CURRENT_FORWARD_%out_pos, L_IO_CURSOR_SEEK_CURRENT_BACK_%out_pos

L_IO_CURSOR_SEEK_CURRENT_FORWARD_%out_pos:
    %out_pos = add __io_cursor_seek_pos_%out_pos, %offset
    store %cursor+IoCursor_pos, %out_pos as u64
    jmp L_IO_CURSOR_SEEK_CURRENT_DONE_%out_pos

L_IO_CURSOR_SEEK_CURRENT_BACK_%out_pos:
    __io_cursor_seek_back_%out_pos = sub 0, %offset
    __io_cursor_seek_can_sub_%out_pos = uge __io_cursor_seek_pos_%out_pos, __io_cursor_seek_back_%out_pos
    br __io_cursor_seek_can_sub_%out_pos -> L_IO_CURSOR_SEEK_CURRENT_SUB_%out_pos, L_IO_CURSOR_SEEK_CURRENT_ZERO_%out_pos

L_IO_CURSOR_SEEK_CURRENT_SUB_%out_pos:
    %out_pos = sub __io_cursor_seek_pos_%out_pos, __io_cursor_seek_back_%out_pos
    store %cursor+IoCursor_pos, %out_pos as u64
    !__io_cursor_seek_can_sub_%out_pos
    !__io_cursor_seek_back_%out_pos
    jmp L_IO_CURSOR_SEEK_CURRENT_DONE_%out_pos

L_IO_CURSOR_SEEK_CURRENT_ZERO_%out_pos:
    %out_pos = add 0, 0
    store %cursor+IoCursor_pos, %out_pos as u64
    !__io_cursor_seek_can_sub_%out_pos
    !__io_cursor_seek_back_%out_pos
    jmp L_IO_CURSOR_SEEK_CURRENT_DONE_%out_pos

L_IO_CURSOR_SEEK_CURRENT_DONE_%out_pos:
    !__io_cursor_seek_forward_%out_pos
    !__io_cursor_seek_pos_%out_pos
[END_MACRO]

[MACRO] IO_CURSOR_SEEK_END %out_pos, %cursor, %offset
    __io_cursor_seek_len_%out_pos = load %cursor+IoCursor_len as u64
    __io_cursor_seek_forward_%out_pos = sge %offset, 0
    br __io_cursor_seek_forward_%out_pos -> L_IO_CURSOR_SEEK_END_FORWARD_%out_pos, L_IO_CURSOR_SEEK_END_BACK_%out_pos

L_IO_CURSOR_SEEK_END_FORWARD_%out_pos:
    %out_pos = add __io_cursor_seek_len_%out_pos, %offset
    store %cursor+IoCursor_pos, %out_pos as u64
    jmp L_IO_CURSOR_SEEK_END_DONE_%out_pos

L_IO_CURSOR_SEEK_END_BACK_%out_pos:
    __io_cursor_seek_back_%out_pos = sub 0, %offset
    __io_cursor_seek_can_sub_%out_pos = uge __io_cursor_seek_len_%out_pos, __io_cursor_seek_back_%out_pos
    br __io_cursor_seek_can_sub_%out_pos -> L_IO_CURSOR_SEEK_END_SUB_%out_pos, L_IO_CURSOR_SEEK_END_ZERO_%out_pos

L_IO_CURSOR_SEEK_END_SUB_%out_pos:
    %out_pos = sub __io_cursor_seek_len_%out_pos, __io_cursor_seek_back_%out_pos
    store %cursor+IoCursor_pos, %out_pos as u64
    !__io_cursor_seek_can_sub_%out_pos
    !__io_cursor_seek_back_%out_pos
    jmp L_IO_CURSOR_SEEK_END_DONE_%out_pos

L_IO_CURSOR_SEEK_END_ZERO_%out_pos:
    %out_pos = add 0, 0
    store %cursor+IoCursor_pos, %out_pos as u64
    !__io_cursor_seek_can_sub_%out_pos
    !__io_cursor_seek_back_%out_pos
    jmp L_IO_CURSOR_SEEK_END_DONE_%out_pos

L_IO_CURSOR_SEEK_END_DONE_%out_pos:
    !__io_cursor_seek_forward_%out_pos
    !__io_cursor_seek_len_%out_pos
[END_MACRO]

[MACRO] IO_EMPTY_READ %out_len, %dst_ptr, %cap
    %out_len = add 0, 0
[END_MACRO]

[MACRO] IO_EMPTY_READ_EXACT %out_status, %dst_ptr, %len
    __io_empty_exact_zero_%out_status = eq %len, 0
    br __io_empty_exact_zero_%out_status -> L_IO_EMPTY_READ_EXACT_OK_%out_status, L_IO_EMPTY_READ_EXACT_EOF_%out_status

L_IO_EMPTY_READ_EXACT_OK_%out_status:
    %out_status = add 0, SA_IO_OK
    !__io_empty_exact_zero_%out_status
    jmp L_IO_EMPTY_READ_EXACT_END_%out_status

L_IO_EMPTY_READ_EXACT_EOF_%out_status:
    %out_status = add 0, SA_IO_ERR_EOF
    !__io_empty_exact_zero_%out_status

L_IO_EMPTY_READ_EXACT_END_%out_status:
[END_MACRO]

[MACRO] IO_EMPTY_SEEK %out_pos
    %out_pos = add 0, 0
[END_MACRO]

[MACRO] IO_TAKE_NEW %take, %cursor, %limit
    store %take+IoTake_cursor, %cursor as ptr
    store %take+IoTake_limit, %limit as u64
[END_MACRO]

[MACRO] IO_TAKE_LIMIT %out_limit, %take
    %out_limit = load %take+IoTake_limit as u64
[END_MACRO]

[MACRO] IO_TAKE_INTO_INNER %out_cursor, %take
    %out_cursor = load %take+IoTake_cursor as ptr
[END_MACRO]

[MACRO] IO_TAKE_READ %out_len, %take, %dst_ptr, %cap
    __io_take_limit_%out_len = load %take+IoTake_limit as u64
    __io_take_cursor_%out_len = load %take+IoTake_cursor as ptr
    __io_take_limit_zero_%out_len = eq __io_take_limit_%out_len, 0
    br __io_take_limit_zero_%out_len -> L_IO_TAKE_READ_ZERO_%out_len, L_IO_TAKE_READ_HAS_LIMIT_%out_len

L_IO_TAKE_READ_ZERO_%out_len:
    %out_len = add 0, 0
    !__io_take_limit_zero_%out_len
    !__io_take_cursor_%out_len
    !__io_take_limit_%out_len
    jmp L_IO_TAKE_READ_DONE_%out_len

L_IO_TAKE_READ_HAS_LIMIT_%out_len:
    __io_take_cap_within_%out_len = ule %cap, __io_take_limit_%out_len
    br __io_take_cap_within_%out_len -> L_IO_TAKE_READ_CAP_%out_len, L_IO_TAKE_READ_LIMIT_%out_len

L_IO_TAKE_READ_CAP_%out_len:
    __io_take_request_%out_len = add %cap, 0
    jmp L_IO_TAKE_READ_DO_%out_len

L_IO_TAKE_READ_LIMIT_%out_len:
    __io_take_request_%out_len = add __io_take_limit_%out_len, 0
    jmp L_IO_TAKE_READ_DO_%out_len

L_IO_TAKE_READ_DO_%out_len:
    EXPAND IO_CURSOR_READ %out_len, __io_take_cursor_%out_len, %dst_ptr, __io_take_request_%out_len
    __io_take_next_limit_%out_len = sub __io_take_limit_%out_len, %out_len
    store %take+IoTake_limit, __io_take_next_limit_%out_len as u64
    !__io_take_next_limit_%out_len
    !__io_take_request_%out_len
    !__io_take_cap_within_%out_len
    !__io_take_limit_zero_%out_len
    !__io_take_cursor_%out_len
    !__io_take_limit_%out_len

L_IO_TAKE_READ_DONE_%out_len:
[END_MACRO]

[MACRO] IO_TAKE_READ_TO_END %out_len, %take, %dst_ptr, %cap
    EXPAND IO_TAKE_READ %out_len, %take, %dst_ptr, %cap
[END_MACRO]

[MACRO] IO_TAKE_READ_TO_STRING %out_status, %out_slice, %take, %dst_ptr, %cap
    EXPAND IO_TAKE_READ_TO_END __io_take_read_to_string_len_%out_status, %take, %dst_ptr, %cap
    EXPAND IO_SLICE_NEW %out_slice, %dst_ptr, __io_take_read_to_string_len_%out_status
    __io_take_read_to_string_status_%out_status = call @sa_str_utf8_validate(&%dst_ptr, __io_take_read_to_string_len_%out_status)
    __io_take_read_to_string_ok_%out_status = eq __io_take_read_to_string_status_%out_status, 0
    br __io_take_read_to_string_ok_%out_status -> L_IO_TAKE_READ_TO_STRING_OK_%out_status, L_IO_TAKE_READ_TO_STRING_BAD_%out_status

L_IO_TAKE_READ_TO_STRING_OK_%out_status:
    %out_status = add 0, SA_IO_OK
    !__io_take_read_to_string_ok_%out_status
    !__io_take_read_to_string_status_%out_status
    !__io_take_read_to_string_len_%out_status
    jmp L_IO_TAKE_READ_TO_STRING_END_%out_status

L_IO_TAKE_READ_TO_STRING_BAD_%out_status:
    %out_status = add 0, SA_IO_ERR_INVALID_DATA
    __io_take_read_to_string_null_%out_status = 0 as ptr
    EXPAND IO_SLICE_NEW %out_slice, __io_take_read_to_string_null_%out_status, 0
    !__io_take_read_to_string_null_%out_status
    !__io_take_read_to_string_ok_%out_status
    !__io_take_read_to_string_status_%out_status
    !__io_take_read_to_string_len_%out_status

L_IO_TAKE_READ_TO_STRING_END_%out_status:
[END_MACRO]

[MACRO] IO_REPEAT_NEW %repeat, %byte
    store %repeat+IoRepeat_byte, %byte as u8
[END_MACRO]

[MACRO] IO_REPEAT_READ %out_len, %repeat, %dst_ptr, %cap
    __io_repeat_byte_%out_len = load %repeat+IoRepeat_byte as u8
    call @sa_mem_set(&%dst_ptr, __io_repeat_byte_%out_len, %cap)
    %out_len = add %cap, 0
    !__io_repeat_byte_%out_len
[END_MACRO]

[MACRO] IO_REPEAT_READ_EXACT %out_status, %repeat, %dst_ptr, %len
    EXPAND IO_REPEAT_READ __io_repeat_exact_len_%out_status, %repeat, %dst_ptr, %len
    %out_status = add 0, SA_IO_OK
    !__io_repeat_exact_len_%out_status
[END_MACRO]

[MACRO] IO_SINK_WRITE %out_len, %src_ptr, %len
    %out_len = add %len, 0
[END_MACRO]

[MACRO] IO_SINK_WRITE_ALL %out_status, %src_ptr, %len
    EXPAND IO_SINK_WRITE __io_sink_write_all_len_%out_status, %src_ptr, %len
    %out_status = add 0, SA_IO_OK
    !__io_sink_write_all_len_%out_status
[END_MACRO]

[MACRO] IO_COPY_SLICE %out_len, %dst_ptr, %src_slice
    __io_copy_src_ptr_%out_len = load %src_slice+IoSlice_ptr as ptr
    __io_copy_src_len_%out_len = load %src_slice+IoSlice_len as u64
    call @sa_mem_copy(&%dst_ptr, &__io_copy_src_ptr_%out_len, __io_copy_src_len_%out_len)
    %out_len = add __io_copy_src_len_%out_len, 0
    !__io_copy_src_len_%out_len
    !__io_copy_src_ptr_%out_len
[END_MACRO]

// Handle-to-handle byte copy over sa_io_read/sa_io_write_all.
// Uses a fixed 4096-byte stack chunk; not trait-object io::copy.

[MACRO] IO_COPY %out_status, %out_total, %reader, %writer
    %out_total = add 0, 0
    __io_copy_buf_%out_status = stack_alloc 4096
    __io_copy_read_slot_%out_status = stack_alloc 8
    jmp L_IO_COPY_HEAD_%out_status

L_IO_COPY_HEAD_%out_status:
    __io_copy_read_status_%out_status = call @sa_io_read(%reader, &__io_copy_buf_%out_status, 4096, &__io_copy_read_slot_%out_status)
    __io_copy_read_ok_%out_status = eq __io_copy_read_status_%out_status, SA_IO_OK
    br __io_copy_read_ok_%out_status -> L_IO_COPY_READ_OK_%out_status, L_IO_COPY_READ_ERR_%out_status

L_IO_COPY_READ_ERR_%out_status:
    %out_status = add __io_copy_read_status_%out_status, 0
    !__io_copy_read_ok_%out_status
    !__io_copy_read_status_%out_status
    jmp L_IO_COPY_END_%out_status

L_IO_COPY_READ_OK_%out_status:
    __io_copy_n_%out_status = load __io_copy_read_slot_%out_status+0 as u64
    __io_copy_is_eof_%out_status = eq __io_copy_n_%out_status, 0
    br __io_copy_is_eof_%out_status -> L_IO_COPY_DONE_%out_status, L_IO_COPY_WRITE_%out_status

L_IO_COPY_WRITE_%out_status:
    __io_copy_write_status_%out_status = call @sa_io_write_all(%writer, &__io_copy_buf_%out_status, __io_copy_n_%out_status)
    __io_copy_write_ok_%out_status = eq __io_copy_write_status_%out_status, SA_IO_OK
    br __io_copy_write_ok_%out_status -> L_IO_COPY_WRITE_OK_%out_status, L_IO_COPY_WRITE_ERR_%out_status

L_IO_COPY_WRITE_ERR_%out_status:
    %out_status = add __io_copy_write_status_%out_status, 0
    !__io_copy_write_ok_%out_status
    !__io_copy_write_status_%out_status
    !__io_copy_is_eof_%out_status
    !__io_copy_n_%out_status
    !__io_copy_read_ok_%out_status
    !__io_copy_read_status_%out_status
    jmp L_IO_COPY_END_%out_status

L_IO_COPY_WRITE_OK_%out_status:
    %out_total = add %out_total, __io_copy_n_%out_status
    !__io_copy_write_ok_%out_status
    !__io_copy_write_status_%out_status
    !__io_copy_is_eof_%out_status
    !__io_copy_n_%out_status
    !__io_copy_read_ok_%out_status
    !__io_copy_read_status_%out_status
    jmp L_IO_COPY_HEAD_%out_status

L_IO_COPY_DONE_%out_status:
    %out_status = add 0, SA_IO_OK
    !__io_copy_is_eof_%out_status
    !__io_copy_n_%out_status
    !__io_copy_read_ok_%out_status
    !__io_copy_read_status_%out_status
    jmp L_IO_COPY_END_%out_status

L_IO_COPY_END_%out_status:
[END_MACRO]

// Handle-to-handle byte copy with an upper bound (%max_bytes).
// Uses a fixed 4096-byte stack chunk; stops at EOF or when max is reached.

[MACRO] IO_COPY_N %out_status, %out_total, %reader, %writer, %max_bytes
    %out_total = add 0, 0
    __io_copy_n_remaining_slot_%out_status = stack_alloc 8
    store __io_copy_n_remaining_slot_%out_status+0, %max_bytes as u64
    __io_copy_n_buf_%out_status = stack_alloc 4096
    __io_copy_n_read_slot_%out_status = stack_alloc 8
    jmp L_IO_COPY_N_HEAD_%out_status

L_IO_COPY_N_HEAD_%out_status:
    __io_copy_n_remaining_%out_status = load __io_copy_n_remaining_slot_%out_status+0 as u64
    __io_copy_n_done_max_%out_status = eq __io_copy_n_remaining_%out_status, 0
    br __io_copy_n_done_max_%out_status -> L_IO_COPY_N_DONE_MAX_%out_status, L_IO_COPY_N_READ_%out_status

L_IO_COPY_N_DONE_MAX_%out_status:
    %out_status = add 0, SA_IO_OK
    !__io_copy_n_done_max_%out_status
    !__io_copy_n_remaining_%out_status
    jmp L_IO_COPY_N_END_%out_status

L_IO_COPY_N_READ_%out_status:
    __io_copy_n_chunk_cap_%out_status = add 0, 4096
    __io_copy_n_use_rem_%out_status = ult __io_copy_n_remaining_%out_status, __io_copy_n_chunk_cap_%out_status
    br __io_copy_n_use_rem_%out_status -> L_IO_COPY_N_CAP_REM_%out_status, L_IO_COPY_N_CAP_FULL_%out_status

L_IO_COPY_N_CAP_REM_%out_status:
    __io_copy_n_cap_%out_status = add __io_copy_n_remaining_%out_status, 0
    !__io_copy_n_use_rem_%out_status
    !__io_copy_n_chunk_cap_%out_status
    jmp L_IO_COPY_N_DO_READ_%out_status

L_IO_COPY_N_CAP_FULL_%out_status:
    __io_copy_n_cap_%out_status = add 0, 4096
    !__io_copy_n_use_rem_%out_status
    !__io_copy_n_chunk_cap_%out_status
    jmp L_IO_COPY_N_DO_READ_%out_status

L_IO_COPY_N_DO_READ_%out_status:
    __io_copy_n_read_status_%out_status = call @sa_io_read(%reader, &__io_copy_n_buf_%out_status, __io_copy_n_cap_%out_status, &__io_copy_n_read_slot_%out_status)
    __io_copy_n_read_ok_%out_status = eq __io_copy_n_read_status_%out_status, SA_IO_OK
    br __io_copy_n_read_ok_%out_status -> L_IO_COPY_N_READ_OK_%out_status, L_IO_COPY_N_READ_ERR_%out_status

L_IO_COPY_N_READ_ERR_%out_status:
    %out_status = add __io_copy_n_read_status_%out_status, 0
    !__io_copy_n_read_ok_%out_status
    !__io_copy_n_read_status_%out_status
    !__io_copy_n_cap_%out_status
    !__io_copy_n_done_max_%out_status
    !__io_copy_n_remaining_%out_status
    jmp L_IO_COPY_N_END_%out_status

L_IO_COPY_N_READ_OK_%out_status:
    __io_copy_n_n_%out_status = load __io_copy_n_read_slot_%out_status+0 as u64
    __io_copy_n_is_eof_%out_status = eq __io_copy_n_n_%out_status, 0
    br __io_copy_n_is_eof_%out_status -> L_IO_COPY_N_EOF_%out_status, L_IO_COPY_N_WRITE_%out_status

L_IO_COPY_N_EOF_%out_status:
    %out_status = add 0, SA_IO_OK
    !__io_copy_n_is_eof_%out_status
    !__io_copy_n_n_%out_status
    !__io_copy_n_read_ok_%out_status
    !__io_copy_n_read_status_%out_status
    !__io_copy_n_cap_%out_status
    !__io_copy_n_done_max_%out_status
    !__io_copy_n_remaining_%out_status
    jmp L_IO_COPY_N_END_%out_status

L_IO_COPY_N_WRITE_%out_status:
    __io_copy_n_write_status_%out_status = call @sa_io_write_all(%writer, &__io_copy_n_buf_%out_status, __io_copy_n_n_%out_status)
    __io_copy_n_write_ok_%out_status = eq __io_copy_n_write_status_%out_status, SA_IO_OK
    br __io_copy_n_write_ok_%out_status -> L_IO_COPY_N_WRITE_OK_%out_status, L_IO_COPY_N_WRITE_ERR_%out_status

L_IO_COPY_N_WRITE_ERR_%out_status:
    %out_status = add __io_copy_n_write_status_%out_status, 0
    !__io_copy_n_write_ok_%out_status
    !__io_copy_n_write_status_%out_status
    !__io_copy_n_is_eof_%out_status
    !__io_copy_n_n_%out_status
    !__io_copy_n_read_ok_%out_status
    !__io_copy_n_read_status_%out_status
    !__io_copy_n_cap_%out_status
    !__io_copy_n_done_max_%out_status
    !__io_copy_n_remaining_%out_status
    jmp L_IO_COPY_N_END_%out_status

L_IO_COPY_N_WRITE_OK_%out_status:
    %out_total = add %out_total, __io_copy_n_n_%out_status
    __io_copy_n_next_rem_%out_status = sub __io_copy_n_remaining_%out_status, __io_copy_n_n_%out_status
    store __io_copy_n_remaining_slot_%out_status+0, __io_copy_n_next_rem_%out_status as u64
    !__io_copy_n_next_rem_%out_status
    !__io_copy_n_write_ok_%out_status
    !__io_copy_n_write_status_%out_status
    !__io_copy_n_is_eof_%out_status
    !__io_copy_n_n_%out_status
    !__io_copy_n_read_ok_%out_status
    !__io_copy_n_read_status_%out_status
    !__io_copy_n_cap_%out_status
    !__io_copy_n_done_max_%out_status
    !__io_copy_n_remaining_%out_status
    jmp L_IO_COPY_N_HEAD_%out_status

L_IO_COPY_N_END_%out_status:
[END_MACRO]

// Handle-level Read/Write/Flush/Close naming aliases over sa_io_* runtime.

[MACRO] IO_READ %out_status, %out_len, %handle, %buf, %cap
    __io_read_len_slot_%out_status = stack_alloc 8
    %out_status = call @sa_io_read(%handle, &%buf, %cap, &__io_read_len_slot_%out_status)
    %out_len = load __io_read_len_slot_%out_status+0 as u64
[END_MACRO]

[MACRO] IO_READ_BYTES %out_status, %out_len, %handle, %buf, %cap
    EXPAND IO_READ %out_status, %out_len, %handle, %buf, %cap
[END_MACRO]

[MACRO] IO_READ_EXACT %out_status, %handle, %buf, %len
    %out_status = call @sa_io_read_exact(%handle, &%buf, %len)
[END_MACRO]

[MACRO] IO_READ_EXACT_BYTES %out_status, %handle, %buf, %len
    EXPAND IO_READ_EXACT %out_status, %handle, %buf, %len
[END_MACRO]

[MACRO] IO_WRITE %out_status, %out_len, %handle, %buf, %len
    __io_write_len_slot_%out_status = stack_alloc 8
    %out_status = call @sa_io_write(%handle, &%buf, %len, &__io_write_len_slot_%out_status)
    %out_len = load __io_write_len_slot_%out_status+0 as u64
[END_MACRO]

[MACRO] IO_WRITE_BYTES %out_status, %out_len, %handle, %buf, %len
    EXPAND IO_WRITE %out_status, %out_len, %handle, %buf, %len
[END_MACRO]

[MACRO] IO_WRITE_ALL %out_status, %handle, %buf, %len
    %out_status = call @sa_io_write_all(%handle, &%buf, %len)
[END_MACRO]

[MACRO] IO_WRITE_ALL_BYTES %out_status, %handle, %buf, %len
    EXPAND IO_WRITE_ALL %out_status, %handle, %buf, %len
[END_MACRO]

[MACRO] IO_FLUSH %out_status, %handle
    %out_status = call @sa_io_flush(%handle)
[END_MACRO]

[MACRO] IO_FLUSH_STDOUT %out_status
    EXPAND IO_STDOUT __io_flush_stdout_handle_%out_status
    EXPAND IO_FLUSH %out_status, __io_flush_stdout_handle_%out_status
    !__io_flush_stdout_handle_%out_status
[END_MACRO]

[MACRO] IO_FLUSH_STDERR %out_status
    EXPAND IO_STDERR __io_flush_stderr_handle_%out_status
    EXPAND IO_FLUSH %out_status, __io_flush_stderr_handle_%out_status
    !__io_flush_stderr_handle_%out_status
[END_MACRO]

[MACRO] IO_CLOSE %out_status, %handle
    %out_status = call @sa_io_close(%handle)
[END_MACRO]
