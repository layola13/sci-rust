[MACRO] MEM_SWAP_U64 %lhs_ptr, %rhs_ptr
    __mem_swap_lhs_%lhs_ptr = load %lhs_ptr+0 as u64
    __mem_swap_rhs_%lhs_ptr = load %rhs_ptr+0 as u64
    store %lhs_ptr+0, __mem_swap_rhs_%lhs_ptr as u64
    store %rhs_ptr+0, __mem_swap_lhs_%lhs_ptr as u64
    !__mem_swap_rhs_%lhs_ptr
    !__mem_swap_lhs_%lhs_ptr
[END_MACRO]

