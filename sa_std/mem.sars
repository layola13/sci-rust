[MACRO] MANUALLY_DROP_U64_CMP %out_ordering, %left_slot, %right_slot
    __manually_drop_u64_cmp_left_%out_ordering = load %left_slot+ManuallyDropU64_value as u64
    __manually_drop_u64_cmp_right_%out_ordering = load %right_slot+ManuallyDropU64_value as u64
    __manually_drop_u64_cmp_lt_%out_ordering = ult __manually_drop_u64_cmp_left_%out_ordering, __manually_drop_u64_cmp_right_%out_ordering
    br __manually_drop_u64_cmp_lt_%out_ordering -> L_MANUALLY_DROP_U64_CMP_LESS_%out_ordering, L_MANUALLY_DROP_U64_CMP_CHECK_GT_%out_ordering
L_MANUALLY_DROP_U64_CMP_LESS_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_LESS
    jmp L_MANUALLY_DROP_U64_CMP_DONE_%out_ordering
L_MANUALLY_DROP_U64_CMP_CHECK_GT_%out_ordering:
    __manually_drop_u64_cmp_gt_%out_ordering = ugt __manually_drop_u64_cmp_left_%out_ordering, __manually_drop_u64_cmp_right_%out_ordering
    br __manually_drop_u64_cmp_gt_%out_ordering -> L_MANUALLY_DROP_U64_CMP_GREATER_%out_ordering, L_MANUALLY_DROP_U64_CMP_EQUAL_%out_ordering
L_MANUALLY_DROP_U64_CMP_GREATER_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_GREATER
    !__manually_drop_u64_cmp_gt_%out_ordering
    jmp L_MANUALLY_DROP_U64_CMP_DONE_%out_ordering
L_MANUALLY_DROP_U64_CMP_EQUAL_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_EQUAL
    !__manually_drop_u64_cmp_gt_%out_ordering
L_MANUALLY_DROP_U64_CMP_DONE_%out_ordering:
    !__manually_drop_u64_cmp_lt_%out_ordering
    !__manually_drop_u64_cmp_right_%out_ordering
    !__manually_drop_u64_cmp_left_%out_ordering
[END_MACRO]

