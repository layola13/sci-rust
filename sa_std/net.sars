[END_MACRO]

[MACRO] NET_TCP_CONNECT %out_status, %out_stream, %host, %host_len, %port
    __net_tcp_connect_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_net_tcp_connect(&%host, %host_len, %port, &__net_tcp_connect_handle_%out_status)
    %out_stream = load __net_tcp_connect_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] NET_TCP_LISTENER_BIND %out_status, %out_listener, %host, %host_len, %port
    __net_tcp_bind_handle_%out_status = stack_alloc 8
    __net_tcp_bind_port_%out_status = stack_alloc 4
    %out_status = call @sa_std_net_tcp_listen(&%host, %host_len, %port, &__net_tcp_bind_handle_%out_status, &__net_tcp_bind_port_%out_status)
    %out_listener = load __net_tcp_bind_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] NET_TCP_LISTENER_BIND_PORT %out_status, %out_listener, %out_port, %host, %host_len, %port
    __net_tcp_bind_handle_%out_status = stack_alloc 8
