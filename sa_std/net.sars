    %out_status = call @sa_std_net_addr_list_next(%list, &__net_addr_list_next_ok_%out_status, &__net_addr_list_next_addr_%out_status)
    %out_ok = load __net_addr_list_next_ok_%out_status+0 as i32
    %out_addr = load __net_addr_list_next_addr_%out_status+0 as u64
