[MACRO] DEFAULT_HASHER_WRITE_NET_IP_ADDR %hasher, %ipaddr
    __net_ip_hash_tag_%hasher = load %ipaddr+NetIpAddr_tag as u64
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __net_ip_hash_tag_%hasher
    __net_ip_hash_payload_%hasher = ptr_add %ipaddr, 8
    __net_ip_hash_is_v4_%hasher = eq __net_ip_hash_tag_%hasher, NET_IP_ADDR_V4
    br __net_ip_hash_is_v4_%hasher -> L_NET_IP_HASH_V4_%hasher, L_NET_IP_HASH_V6_%hasher
L_NET_IP_HASH_V4_%hasher:
    EXPAND DEFAULT_HASHER_WRITE_NET_IPV4 %hasher, __net_ip_hash_payload_%hasher
    jmp L_NET_IP_HASH_DONE_%hasher
L_NET_IP_HASH_V6_%hasher:
    EXPAND DEFAULT_HASHER_WRITE_NET_IPV6 %hasher, __net_ip_hash_payload_%hasher
L_NET_IP_HASH_DONE_%hasher:
    !__net_ip_hash_is_v4_%hasher
    !__net_ip_hash_payload_%hasher
    !__net_ip_hash_tag_%hasher
[END_MACRO]

[MACRO] NET_IP_ADDR_HASH %out_hash, %ipaddr
    __net_ip_hash_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __net_ip_hash_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_NET_IP_ADDR __net_ip_hash_hasher_%out_hash, %ipaddr
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __net_ip_hash_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_NET_IP_ADDR %out_hash, %builder, %ipaddr
    __build_hash_one_ip_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_ip_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_NET_IP_ADDR __build_hash_one_ip_hasher_%out_hash, %ipaddr
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_ip_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_NET_IP_ADDR %out_hash, %state, %ipaddr
    __random_state_hash_one_ip_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_ip_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_NET_IP_ADDR __random_state_hash_one_ip_hasher_%out_hash, %ipaddr
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_ip_hasher_%out_hash
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_NET_SOCKET_ADDR %hasher, %socket_addr
    __net_socket_hash_tag_%hasher = load %socket_addr+NetSocketAddr_tag as u64
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __net_socket_hash_tag_%hasher
    __net_socket_hash_payload_%hasher = ptr_add %socket_addr, 8
    __net_socket_hash_is_v4_%hasher = eq __net_socket_hash_tag_%hasher, NET_IP_ADDR_V4
    br __net_socket_hash_is_v4_%hasher -> L_NET_SOCKET_HASH_V4_%hasher, L_NET_SOCKET_HASH_V6_%hasher
L_NET_SOCKET_HASH_V4_%hasher:
    EXPAND DEFAULT_HASHER_WRITE_NET_SOCKET_ADDR_V4 %hasher, __net_socket_hash_payload_%hasher
    jmp L_NET_SOCKET_HASH_DONE_%hasher
L_NET_SOCKET_HASH_V6_%hasher:
    EXPAND DEFAULT_HASHER_WRITE_NET_SOCKET_ADDR_V6 %hasher, __net_socket_hash_payload_%hasher
L_NET_SOCKET_HASH_DONE_%hasher:
    !__net_socket_hash_is_v4_%hasher
    !__net_socket_hash_payload_%hasher
    !__net_socket_hash_tag_%hasher
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_HASH %out_hash, %socket_addr
    __net_socket_hash_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
