[MACRO] NET_IPV4_NEW %addr, %a, %b, %c, %d
    store %addr+NetIpv4Addr_a, %a as u8
    store %addr+NetIpv4Addr_b, %b as u8
    store %addr+NetIpv4Addr_c, %c as u8
    store %addr+NetIpv4Addr_d, %d as u8
[END_MACRO]

[MACRO] NET_IPV4_UNSPECIFIED %addr
    EXPAND NET_IPV4_NEW %addr, 0, 0, 0, 0
[END_MACRO]

// Rust-style Default for Ipv4Addr: UNSPECIFIED.
[MACRO] NET_IPV4_DEFAULT %addr
    EXPAND NET_IPV4_UNSPECIFIED %addr
[END_MACRO]

[MACRO] NET_IPV4_LOCALHOST %addr
    EXPAND NET_IPV4_NEW %addr, 127, 0, 0, 1
[END_MACRO]

[MACRO] NET_IPV4_BROADCAST %addr
    EXPAND NET_IPV4_NEW %addr, 255, 255, 255, 255
[END_MACRO]

[MACRO] NET_IPV4_BITS %out_bits
