    !__net_sock_fmt_payload_%out_ok
    !__net_sock_fmt_tag_%out_ok
[END_MACRO]


[MACRO] NET_IPV4_EQ %out_bool, %left, %right
    __net_ipv4_la_%out_bool = load %left+NetIpv4Addr_a as u8
    __net_ipv4_lb_%out_bool = load %left+NetIpv4Addr_b as u8
    __net_ipv4_lc_%out_bool = load %left+NetIpv4Addr_c as u8
    __net_ipv4_ld_%out_bool = load %left+NetIpv4Addr_d as u8
    __net_ipv4_ra_%out_bool = load %right+NetIpv4Addr_a as u8
    __net_ipv4_rb_%out_bool = load %right+NetIpv4Addr_b as u8
    __net_ipv4_rc_%out_bool = load %right+NetIpv4Addr_c as u8
    __net_ipv4_rd_%out_bool = load %right+NetIpv4Addr_d as u8
    __net_ipv4_ea_%out_bool = eq __net_ipv4_la_%out_bool, __net_ipv4_ra_%out_bool
    __net_ipv4_eb_%out_bool = eq __net_ipv4_lb_%out_bool, __net_ipv4_rb_%out_bool
    __net_ipv4_ec_%out_bool = eq __net_ipv4_lc_%out_bool, __net_ipv4_rc_%out_bool
    __net_ipv4_ed_%out_bool = eq __net_ipv4_ld_%out_bool, __net_ipv4_rd_%out_bool
    __net_ipv4_eab_%out_bool = and __net_ipv4_ea_%out_bool, __net_ipv4_eb_%out_bool
    __net_ipv4_ecd_%out_bool = and __net_ipv4_ec_%out_bool, __net_ipv4_ed_%out_bool
    %out_bool = and __net_ipv4_eab_%out_bool, __net_ipv4_ecd_%out_bool
    !__net_ipv4_ecd_%out_bool
    !__net_ipv4_eab_%out_bool
    !__net_ipv4_ed_%out_bool
    !__net_ipv4_ec_%out_bool
    !__net_ipv4_eb_%out_bool
    !__net_ipv4_ea_%out_bool
    !__net_ipv4_rd_%out_bool
    !__net_ipv4_rc_%out_bool
    !__net_ipv4_rb_%out_bool
    !__net_ipv4_ra_%out_bool
    !__net_ipv4_ld_%out_bool
    !__net_ipv4_lc_%out_bool
    !__net_ipv4_lb_%out_bool
    !__net_ipv4_la_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_UNSPECIFIED %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_c_%out_bool = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_d_%out_bool = load %addr+NetIpv4Addr_d as u8
    __net_ipv4_ab_%out_bool = or __net_ipv4_a_%out_bool, __net_ipv4_b_%out_bool
    __net_ipv4_cd_%out_bool = or __net_ipv4_c_%out_bool, __net_ipv4_d_%out_bool
    __net_ipv4_any_%out_bool = or __net_ipv4_ab_%out_bool, __net_ipv4_cd_%out_bool
    %out_bool = eq __net_ipv4_any_%out_bool, 0
    !__net_ipv4_any_%out_bool
    !__net_ipv4_cd_%out_bool
    !__net_ipv4_ab_%out_bool
    !__net_ipv4_d_%out_bool
    !__net_ipv4_c_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_LOOPBACK %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    %out_bool = eq __net_ipv4_a_%out_bool, 127
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_PRIVATE %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_is_10_%out_bool = eq __net_ipv4_a_%out_bool, 10
    __net_ipv4_is_172_%out_bool = eq __net_ipv4_a_%out_bool, 172
    __net_ipv4_172_lo_%out_bool = uge __net_ipv4_b_%out_bool, 16
    __net_ipv4_172_hi_%out_bool = ule __net_ipv4_b_%out_bool, 31
    __net_ipv4_172_range_%out_bool = and __net_ipv4_172_lo_%out_bool, __net_ipv4_172_hi_%out_bool
    __net_ipv4_172_private_%out_bool = and __net_ipv4_is_172_%out_bool, __net_ipv4_172_range_%out_bool
    __net_ipv4_is_192_%out_bool = eq __net_ipv4_a_%out_bool, 192
    __net_ipv4_is_168_%out_bool = eq __net_ipv4_b_%out_bool, 168
    __net_ipv4_192_private_%out_bool = and __net_ipv4_is_192_%out_bool, __net_ipv4_is_168_%out_bool
    __net_ipv4_left_%out_bool = or __net_ipv4_is_10_%out_bool, __net_ipv4_172_private_%out_bool
    %out_bool = or __net_ipv4_left_%out_bool, __net_ipv4_192_private_%out_bool
    !__net_ipv4_left_%out_bool
    !__net_ipv4_192_private_%out_bool
    !__net_ipv4_is_168_%out_bool
    !__net_ipv4_is_192_%out_bool
    !__net_ipv4_172_private_%out_bool
    !__net_ipv4_172_range_%out_bool
    !__net_ipv4_172_hi_%out_bool
    !__net_ipv4_172_lo_%out_bool
    !__net_ipv4_is_172_%out_bool
    !__net_ipv4_is_10_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_LINK_LOCAL %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_a_ok_%out_bool = eq __net_ipv4_a_%out_bool, 169
    __net_ipv4_b_ok_%out_bool = eq __net_ipv4_b_%out_bool, 254
    %out_bool = and __net_ipv4_a_ok_%out_bool, __net_ipv4_b_ok_%out_bool
    !__net_ipv4_b_ok_%out_bool
    !__net_ipv4_a_ok_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_SHARED %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_is_100_%out_bool = eq __net_ipv4_a_%out_bool, 100
    __net_ipv4_b_mask_%out_bool = and __net_ipv4_b_%out_bool, 192
    __net_ipv4_b_range_%out_bool = eq __net_ipv4_b_mask_%out_bool, 64
    %out_bool = and __net_ipv4_is_100_%out_bool, __net_ipv4_b_range_%out_bool
    !__net_ipv4_b_range_%out_bool
    !__net_ipv4_b_mask_%out_bool
    !__net_ipv4_is_100_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_BENCHMARKING %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_is_198_%out_bool = eq __net_ipv4_a_%out_bool, 198
    __net_ipv4_b_mask_%out_bool = and __net_ipv4_b_%out_bool, 254
    __net_ipv4_b_range_%out_bool = eq __net_ipv4_b_mask_%out_bool, 18
    %out_bool = and __net_ipv4_is_198_%out_bool, __net_ipv4_b_range_%out_bool
    !__net_ipv4_b_range_%out_bool
    !__net_ipv4_b_mask_%out_bool
    !__net_ipv4_is_198_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_RESERVED %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_mask_%out_bool = and __net_ipv4_a_%out_bool, 240
    __net_ipv4_reserved_range_%out_bool = eq __net_ipv4_mask_%out_bool, 240
    EXPAND NET_IPV4_IS_BROADCAST __net_ipv4_broadcast_%out_bool, %addr
    __net_ipv4_not_broadcast_%out_bool = eq __net_ipv4_broadcast_%out_bool, 0
    %out_bool = and __net_ipv4_reserved_range_%out_bool, __net_ipv4_not_broadcast_%out_bool
    !__net_ipv4_not_broadcast_%out_bool
    !__net_ipv4_broadcast_%out_bool
    !__net_ipv4_reserved_range_%out_bool
    !__net_ipv4_mask_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_MULTICAST %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_lo_%out_bool = uge __net_ipv4_a_%out_bool, 224
    __net_ipv4_hi_%out_bool = ule __net_ipv4_a_%out_bool, 239
    %out_bool = and __net_ipv4_lo_%out_bool, __net_ipv4_hi_%out_bool
    !__net_ipv4_hi_%out_bool
    !__net_ipv4_lo_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_BROADCAST %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_c_%out_bool = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_d_%out_bool = load %addr+NetIpv4Addr_d as u8
    __net_ipv4_ea_%out_bool = eq __net_ipv4_a_%out_bool, 255
    __net_ipv4_eb_%out_bool = eq __net_ipv4_b_%out_bool, 255
    __net_ipv4_ec_%out_bool = eq __net_ipv4_c_%out_bool, 255
    __net_ipv4_ed_%out_bool = eq __net_ipv4_d_%out_bool, 255
    __net_ipv4_eab_%out_bool = and __net_ipv4_ea_%out_bool, __net_ipv4_eb_%out_bool
    __net_ipv4_ecd_%out_bool = and __net_ipv4_ec_%out_bool, __net_ipv4_ed_%out_bool
    %out_bool = and __net_ipv4_eab_%out_bool, __net_ipv4_ecd_%out_bool
