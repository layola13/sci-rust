    __net_ipv6_to4_e01_%ipv4 = and __net_ipv6_to4_e0_%ipv4, __net_ipv6_to4_e1_%ipv4
    __net_ipv6_to4_e23_%ipv4 = and __net_ipv6_to4_e2_%ipv4, __net_ipv6_to4_e3_%ipv4
    __net_ipv6_to4_e04_%ipv4 = and __net_ipv6_to4_e01_%ipv4, __net_ipv6_to4_e23_%ipv4
    __net_ipv6_to4_e05_%ipv4 = and __net_ipv6_to4_e04_%ipv4, __net_ipv6_to4_e4_%ipv4
    %out_ok = and __net_ipv6_to4_e05_%ipv4, __net_ipv6_to4_s5_ok_%ipv4
    __net_ipv6_to4_a_%ipv4 = lshr __net_ipv6_to4_s6_%ipv4, 8
    __net_ipv6_to4_b_%ipv4 = and __net_ipv6_to4_s6_%ipv4, 255
    __net_ipv6_to4_c_%ipv4 = lshr __net_ipv6_to4_s7_%ipv4, 8
    __net_ipv6_to4_d_%ipv4 = and __net_ipv6_to4_s7_%ipv4, 255
    EXPAND NET_IPV4_NEW %ipv4, __net_ipv6_to4_a_%ipv4, __net_ipv6_to4_b_%ipv4, __net_ipv6_to4_c_%ipv4, __net_ipv6_to4_d_%ipv4
    !__net_ipv6_to4_d_%ipv4
    !__net_ipv6_to4_c_%ipv4
    !__net_ipv6_to4_b_%ipv4
    !__net_ipv6_to4_a_%ipv4
    !__net_ipv6_to4_e05_%ipv4
    !__net_ipv6_to4_e04_%ipv4
    !__net_ipv6_to4_e23_%ipv4
    !__net_ipv6_to4_e01_%ipv4
    !__net_ipv6_to4_s5_ok_%ipv4
    !__net_ipv6_to4_s5_ffff_%ipv4
    !__net_ipv6_to4_s5_zero_%ipv4
    !__net_ipv6_to4_e4_%ipv4
    !__net_ipv6_to4_e3_%ipv4
    !__net_ipv6_to4_e2_%ipv4
    !__net_ipv6_to4_e1_%ipv4
    !__net_ipv6_to4_e0_%ipv4
    !__net_ipv6_to4_s7_%ipv4
    !__net_ipv6_to4_s6_%ipv4
    !__net_ipv6_to4_s5_%ipv4
    !__net_ipv6_to4_s4_%ipv4
    !__net_ipv6_to4_s3_%ipv4
    !__net_ipv6_to4_s2_%ipv4
    !__net_ipv6_to4_s1_%ipv4
    !__net_ipv6_to4_s0_%ipv4
[END_MACRO]

[MACRO] NET_IPV6_IS_UNICAST_GLOBAL %out_bool, %addr
    EXPAND NET_IPV6_IS_UNICAST __net_ipv6_unicast_%out_bool, %addr
    EXPAND NET_IPV6_IS_LOOPBACK __net_ipv6_loopback_%out_bool, %addr
    EXPAND NET_IPV6_IS_UNICAST_LINK_LOCAL __net_ipv6_link_%out_bool, %addr
    EXPAND NET_IPV6_IS_UNIQUE_LOCAL __net_ipv6_unique_%out_bool, %addr
    EXPAND NET_IPV6_IS_UNSPECIFIED __net_ipv6_unspec_%out_bool, %addr
    EXPAND NET_IPV6_IS_DOCUMENTATION __net_ipv6_doc_%out_bool, %addr
    EXPAND NET_IPV6_IS_BENCHMARKING __net_ipv6_bench_%out_bool, %addr
    __net_ipv6_ng01_%out_bool = or __net_ipv6_loopback_%out_bool, __net_ipv6_link_%out_bool
    __net_ipv6_ng02_%out_bool = or __net_ipv6_ng01_%out_bool, __net_ipv6_unique_%out_bool
    __net_ipv6_ng03_%out_bool = or __net_ipv6_ng02_%out_bool, __net_ipv6_unspec_%out_bool
    __net_ipv6_ng04_%out_bool = or __net_ipv6_ng03_%out_bool, __net_ipv6_doc_%out_bool
    __net_ipv6_not_global_%out_bool = or __net_ipv6_ng04_%out_bool, __net_ipv6_bench_%out_bool
    __net_ipv6_no_exclusion_%out_bool = eq __net_ipv6_not_global_%out_bool, 0
    %out_bool = and __net_ipv6_unicast_%out_bool, __net_ipv6_no_exclusion_%out_bool
    !__net_ipv6_no_exclusion_%out_bool
    !__net_ipv6_not_global_%out_bool
    !__net_ipv6_ng04_%out_bool
    !__net_ipv6_ng03_%out_bool
    !__net_ipv6_ng02_%out_bool
    !__net_ipv6_ng01_%out_bool
    !__net_ipv6_bench_%out_bool
    !__net_ipv6_doc_%out_bool
    !__net_ipv6_unspec_%out_bool
    !__net_ipv6_unique_%out_bool
    !__net_ipv6_link_%out_bool
    !__net_ipv6_loopback_%out_bool
    !__net_ipv6_unicast_%out_bool
[END_MACRO]

[MACRO] NET_IPV6_TO_CANONICAL %out_ipaddr, %addr
    __net_ipv6_canon_v4_%out_ipaddr = stack_alloc NetIpv4Addr_SIZE
    EXPAND NET_IPV6_TO_IPV4_MAPPED __net_ipv6_canon_mapped_%out_ipaddr, __net_ipv6_canon_v4_%out_ipaddr, %addr
    br __net_ipv6_canon_mapped_%out_ipaddr -> L_NET_IPV6_CANON_V4_%out_ipaddr, L_NET_IPV6_CANON_V6_%out_ipaddr

L_NET_IPV6_CANON_V4_%out_ipaddr:
    EXPAND NET_IP_ADDR_V4_NEW %out_ipaddr, __net_ipv6_canon_v4_%out_ipaddr
    !__net_ipv6_canon_mapped_%out_ipaddr
    jmp L_NET_IPV6_CANON_DONE_%out_ipaddr

L_NET_IPV6_CANON_V6_%out_ipaddr:
    EXPAND NET_IP_ADDR_V6_NEW %out_ipaddr, %addr
    !__net_ipv6_canon_mapped_%out_ipaddr

L_NET_IPV6_CANON_DONE_%out_ipaddr:
[END_MACRO]

[MACRO] NET_IP_ADDR_V4_NEW %ipaddr, %ipv4
    store %ipaddr+NetIpAddr_tag, NET_IP_ADDR_V4 as u64
    __net_ip_v4_payload_%ipaddr = ptr_add %ipaddr, 8
    __net_ip_v4_a_%ipaddr = load %ipv4+NetIpv4Addr_a as u8
    __net_ip_v4_b_%ipaddr = load %ipv4+NetIpv4Addr_b as u8
    __net_ip_v4_c_%ipaddr = load %ipv4+NetIpv4Addr_c as u8
    __net_ip_v4_d_%ipaddr = load %ipv4+NetIpv4Addr_d as u8
    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_a, __net_ip_v4_a_%ipaddr as u8
    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_b, __net_ip_v4_b_%ipaddr as u8
    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_c, __net_ip_v4_c_%ipaddr as u8
    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_d, __net_ip_v4_d_%ipaddr as u8
    !__net_ip_v4_d_%ipaddr
    !__net_ip_v4_c_%ipaddr
    !__net_ip_v4_b_%ipaddr
    !__net_ip_v4_a_%ipaddr
    !__net_ip_v4_payload_%ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_V6_NEW %ipaddr, %ipv6
    store %ipaddr+NetIpAddr_tag, NET_IP_ADDR_V6 as u64
    __net_ip_v6_payload_%ipaddr = ptr_add %ipaddr, 8
    __net_ip_v6_s0_%ipaddr = load %ipv6+NetIpv6Addr_s0 as u16
    __net_ip_v6_s1_%ipaddr = load %ipv6+NetIpv6Addr_s1 as u16
    __net_ip_v6_s2_%ipaddr = load %ipv6+NetIpv6Addr_s2 as u16
    __net_ip_v6_s3_%ipaddr = load %ipv6+NetIpv6Addr_s3 as u16
    __net_ip_v6_s4_%ipaddr = load %ipv6+NetIpv6Addr_s4 as u16
    __net_ip_v6_s5_%ipaddr = load %ipv6+NetIpv6Addr_s5 as u16
    __net_ip_v6_s6_%ipaddr = load %ipv6+NetIpv6Addr_s6 as u16
    __net_ip_v6_s7_%ipaddr = load %ipv6+NetIpv6Addr_s7 as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s0, __net_ip_v6_s0_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s1, __net_ip_v6_s1_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s2, __net_ip_v6_s2_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s3, __net_ip_v6_s3_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s4, __net_ip_v6_s4_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s5, __net_ip_v6_s5_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s6, __net_ip_v6_s6_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s7, __net_ip_v6_s7_%ipaddr as u16
    !__net_ip_v6_s7_%ipaddr
    !__net_ip_v6_s6_%ipaddr
    !__net_ip_v6_s5_%ipaddr
    !__net_ip_v6_s4_%ipaddr
    !__net_ip_v6_s3_%ipaddr
    !__net_ip_v6_s2_%ipaddr
    !__net_ip_v6_s1_%ipaddr
    !__net_ip_v6_s0_%ipaddr
    !__net_ip_v6_payload_%ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_V4_UNSPECIFIED %ipaddr
    __net_ip_v4_unspec_%ipaddr = stack_alloc NetIpv4Addr_SIZE
    EXPAND NET_IPV4_UNSPECIFIED __net_ip_v4_unspec_%ipaddr
    EXPAND NET_IP_ADDR_V4_NEW %ipaddr, __net_ip_v4_unspec_%ipaddr
[END_MACRO]

// Rust-style Default for IpAddr: Ipv4Addr::UNSPECIFIED.
[MACRO] NET_IP_ADDR_DEFAULT %ipaddr
    EXPAND NET_IP_ADDR_V4_UNSPECIFIED %ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_V4_LOCALHOST %ipaddr
    __net_ip_v4_local_%ipaddr = stack_alloc NetIpv4Addr_SIZE
    EXPAND NET_IPV4_LOCALHOST __net_ip_v4_local_%ipaddr
    EXPAND NET_IP_ADDR_V4_NEW %ipaddr, __net_ip_v4_local_%ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_V4_BROADCAST %ipaddr
    __net_ip_v4_bcast_%ipaddr = stack_alloc NetIpv4Addr_SIZE
    EXPAND NET_IPV4_BROADCAST __net_ip_v4_bcast_%ipaddr
    EXPAND NET_IP_ADDR_V4_NEW %ipaddr, __net_ip_v4_bcast_%ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_V6_UNSPECIFIED %ipaddr
    __net_ip_v6_unspec_%ipaddr = stack_alloc NetIpv6Addr_SIZE
    EXPAND NET_IPV6_UNSPECIFIED __net_ip_v6_unspec_%ipaddr
    EXPAND NET_IP_ADDR_V6_NEW %ipaddr, __net_ip_v6_unspec_%ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_V6_LOCALHOST %ipaddr
    __net_ip_v6_local_%ipaddr = stack_alloc NetIpv6Addr_SIZE
    EXPAND NET_IPV6_LOCALHOST __net_ip_v6_local_%ipaddr
    EXPAND NET_IP_ADDR_V6_NEW %ipaddr, __net_ip_v6_local_%ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_TRY_PARSE_ASCII %out_ok, %ipaddr, %ptr, %len
    __net_ip_parse_v4_%out_ok = stack_alloc NetIpv4Addr_SIZE
    __net_ip_parse_v6_%out_ok = stack_alloc NetIpv6Addr_SIZE
    __net_ip_parse_v4_ok_%out_ok = call @sa_net_ipv4_parse_ascii(&%ptr, %len, &__net_ip_parse_v4_%out_ok)
    br __net_ip_parse_v4_ok_%out_ok -> L_NET_IP_PARSE_V4_OK_%out_ok, L_NET_IP_PARSE_TRY_V6_%out_ok

L_NET_IP_PARSE_V4_OK_%out_ok:
    %out_ok = add 0, 1
    EXPAND NET_IP_ADDR_V4_NEW %ipaddr, __net_ip_parse_v4_%out_ok
    !__net_ip_parse_v4_ok_%out_ok
    jmp L_NET_IP_PARSE_DONE_%out_ok

L_NET_IP_PARSE_TRY_V6_%out_ok:
    !__net_ip_parse_v4_ok_%out_ok
    __net_ip_parse_v6_ok_%out_ok = call @sa_net_ipv6_parse_ascii(&%ptr, %len, &__net_ip_parse_v6_%out_ok)
    br __net_ip_parse_v6_ok_%out_ok -> L_NET_IP_PARSE_V6_OK_%out_ok, L_NET_IP_PARSE_FAIL_%out_ok

L_NET_IP_PARSE_V6_OK_%out_ok:
    %out_ok = add 0, 1
    EXPAND NET_IP_ADDR_V6_NEW %ipaddr, __net_ip_parse_v6_%out_ok
    !__net_ip_parse_v6_ok_%out_ok
    jmp L_NET_IP_PARSE_DONE_%out_ok

L_NET_IP_PARSE_FAIL_%out_ok:
    %out_ok = add 0, 0
    EXPAND NET_IP_ADDR_V4_UNSPECIFIED %ipaddr
    !__net_ip_parse_v6_ok_%out_ok

L_NET_IP_PARSE_DONE_%out_ok:
[END_MACRO]

[MACRO] NET_IP_ADDR_TRY_PARSE_ASCII_DETAIL %out_ok, %out_kind, %ipaddr, %ptr, %len
    %out_kind = add 0, ADDR_PARSE_ERROR_IP
    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII %out_ok, %ipaddr, %ptr, %len
[END_MACRO]

[MACRO] NET_IP_ADDR_PARSE_ASCII %out_ok, %ipaddr, %ptr, %len
    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII %out_ok, %ipaddr, %ptr, %len
[END_MACRO]

[MACRO] NET_IP_ADDR_PARSE_ASCII_DETAIL %out_ok, %out_kind, %ipaddr, %ptr, %len
    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII_DETAIL %out_ok, %out_kind, %ipaddr, %ptr, %len
[END_MACRO]

[MACRO] NET_IP_ADDR_COPY %dst_ipaddr, %src_ipaddr
    __net_ip_copy_tag_%dst_ipaddr = load %src_ipaddr+NetIpAddr_tag as u64
    __net_ip_copy_src_%dst_ipaddr = ptr_add %src_ipaddr, 8
    __net_ip_copy_dst_%dst_ipaddr = ptr_add %dst_ipaddr, 8
    store %dst_ipaddr+NetIpAddr_tag, __net_ip_copy_tag_%dst_ipaddr as u64
    __net_ip_copy_is_v4_%dst_ipaddr = eq __net_ip_copy_tag_%dst_ipaddr, NET_IP_ADDR_V4
    br __net_ip_copy_is_v4_%dst_ipaddr -> L_NET_IP_COPY_V4_%dst_ipaddr, L_NET_IP_COPY_V6_%dst_ipaddr
L_NET_IP_COPY_V4_%dst_ipaddr:
    EXPAND NET_IPV4_COPY __net_ip_copy_dst_%dst_ipaddr, __net_ip_copy_src_%dst_ipaddr
    jmp L_NET_IP_COPY_DONE_%dst_ipaddr
L_NET_IP_COPY_V6_%dst_ipaddr:
    EXPAND NET_IPV6_COPY __net_ip_copy_dst_%dst_ipaddr, __net_ip_copy_src_%dst_ipaddr
    jmp L_NET_IP_COPY_DONE_%dst_ipaddr
L_NET_IP_COPY_DONE_%dst_ipaddr:
    !__net_ip_copy_is_v4_%dst_ipaddr
    !__net_ip_copy_dst_%dst_ipaddr
    !__net_ip_copy_src_%dst_ipaddr
    !__net_ip_copy_tag_%dst_ipaddr
[END_MACRO]

[MACRO] NET_IP_ADDR_IS_IPV4 %out_bool, %ipaddr
    __net_ip_tag_%out_bool = load %ipaddr+NetIpAddr_tag as u64
    %out_bool = eq __net_ip_tag_%out_bool, NET_IP_ADDR_V4
    !__net_ip_tag_%out_bool
[END_MACRO]

[MACRO] NET_IP_ADDR_IS_IPV6 %out_bool, %ipaddr
    __net_ip_tag_%out_bool = load %ipaddr+NetIpAddr_tag as u64
    %out_bool = eq __net_ip_tag_%out_bool, NET_IP_ADDR_V6
    !__net_ip_tag_%out_bool
[END_MACRO]

[MACRO] NET_IP_ADDR_PAYLOAD_PTR %out_ptr, %ipaddr
    %out_ptr = ptr_add %ipaddr, 8
[END_MACRO]

[MACRO] NET_IP_ADDR_FAMILY %out_family, %ipaddr
    __net_ip_family_tag_%out_family = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_family_is_v4_%out_family = eq __net_ip_family_tag_%out_family, NET_IP_ADDR_V4
    br __net_ip_family_is_v4_%out_family -> L_NET_IP_FAMILY_V4_%out_family, L_NET_IP_FAMILY_V6_%out_family
L_NET_IP_FAMILY_V4_%out_family:
    %out_family = add 0, SA_NET_AF_INET
    jmp L_NET_IP_FAMILY_DONE_%out_family
L_NET_IP_FAMILY_V6_%out_family:
    %out_family = add 0, SA_NET_AF_INET6
    jmp L_NET_IP_FAMILY_DONE_%out_family
L_NET_IP_FAMILY_DONE_%out_family:
    !__net_ip_family_is_v4_%out_family
    !__net_ip_family_tag_%out_family
[END_MACRO]

[MACRO] NET_IP_ADDR_OCTET_LEN %out_len, %ipaddr
    __net_ip_octet_len_tag_%out_len = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_octet_len_v4_%out_len = eq __net_ip_octet_len_tag_%out_len, NET_IP_ADDR_V4
    br __net_ip_octet_len_v4_%out_len -> L_NET_IP_OCTET_LEN_V4_%out_len, L_NET_IP_OCTET_LEN_V6_%out_len
L_NET_IP_OCTET_LEN_V4_%out_len:
    %out_len = add 0, 4
    jmp L_NET_IP_OCTET_LEN_DONE_%out_len
L_NET_IP_OCTET_LEN_V6_%out_len:
    %out_len = add 0, 16
    jmp L_NET_IP_OCTET_LEN_DONE_%out_len
L_NET_IP_OCTET_LEN_DONE_%out_len:
    !__net_ip_octet_len_v4_%out_len
    !__net_ip_octet_len_tag_%out_len
[END_MACRO]

[MACRO] NET_IP_ADDR_AS_OCTETS_PTR %out_ptr, %ipaddr
    __net_ip_octets_view_%out_ptr = stack_alloc 16
    __net_ip_octets_tag_%out_ptr = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_octets_payload_%out_ptr = ptr_add %ipaddr, 8
    __net_ip_octets_is_v4_%out_ptr = eq __net_ip_octets_tag_%out_ptr, NET_IP_ADDR_V4
    br __net_ip_octets_is_v4_%out_ptr -> L_NET_IP_OCTETS_PTR_V4_%out_ptr, L_NET_IP_OCTETS_PTR_V6_%out_ptr
L_NET_IP_OCTETS_PTR_V4_%out_ptr:
    EXPAND NET_IPV4_WRITE_OCTETS __net_ip_octets_v4_ok_%out_ptr, __net_ip_octets_view_%out_ptr, 16, __net_ip_octets_payload_%out_ptr
    jmp L_NET_IP_OCTETS_PTR_DONE_%out_ptr
L_NET_IP_OCTETS_PTR_V6_%out_ptr:
    EXPAND NET_IPV6_WRITE_OCTETS __net_ip_octets_v6_ok_%out_ptr, __net_ip_octets_view_%out_ptr, 16, __net_ip_octets_payload_%out_ptr
L_NET_IP_OCTETS_PTR_DONE_%out_ptr:
    %out_ptr = ptr_add __net_ip_octets_view_%out_ptr, 0
    !__net_ip_octets_is_v4_%out_ptr
    !__net_ip_octets_payload_%out_ptr
    !__net_ip_octets_tag_%out_ptr
[END_MACRO]

[MACRO] NET_IP_ADDR_WRITE_OCTETS %out_ok, %dst_ptr, %dst_len, %ipaddr
    __net_ip_write_tag_%out_ok = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_write_payload_%out_ok = ptr_add %ipaddr, 8
    __net_ip_write_v4_%out_ok = eq __net_ip_write_tag_%out_ok, NET_IP_ADDR_V4
    br __net_ip_write_v4_%out_ok -> L_NET_IP_WRITE_OCTETS_V4_%out_ok, L_NET_IP_WRITE_OCTETS_V6_%out_ok

L_NET_IP_WRITE_OCTETS_V4_%out_ok:
    EXPAND NET_IPV4_WRITE_OCTETS %out_ok, %dst_ptr, %dst_len, __net_ip_write_payload_%out_ok
    jmp L_NET_IP_WRITE_OCTETS_DONE_%out_ok

L_NET_IP_WRITE_OCTETS_V6_%out_ok:
    EXPAND NET_IPV6_WRITE_OCTETS %out_ok, %dst_ptr, %dst_len, __net_ip_write_payload_%out_ok
    jmp L_NET_IP_WRITE_OCTETS_DONE_%out_ok

L_NET_IP_WRITE_OCTETS_DONE_%out_ok:
    !__net_ip_write_v4_%out_ok
    !__net_ip_write_payload_%out_ok
    !__net_ip_write_tag_%out_ok
[END_MACRO]

[MACRO] NET_IP_ADDR_EQ %out_bool, %left, %right
    __net_ip_eq_ltag_%out_bool = load %left+NetIpAddr_tag as u64
    __net_ip_eq_rtag_%out_bool = load %right+NetIpAddr_tag as u64
    __net_ip_eq_same_tag_%out_bool = eq __net_ip_eq_ltag_%out_bool, __net_ip_eq_rtag_%out_bool
    br __net_ip_eq_same_tag_%out_bool -> L_NET_IP_EQ_SAME_%out_bool, L_NET_IP_EQ_DIFF_%out_bool
L_NET_IP_EQ_DIFF_%out_bool:
    %out_bool = add 0, 0
    jmp L_NET_IP_EQ_DONE_%out_bool
L_NET_IP_EQ_SAME_%out_bool:
    __net_ip_eq_lpayload_%out_bool = ptr_add %left, 8
    __net_ip_eq_rpayload_%out_bool = ptr_add %right, 8
    __net_ip_eq_is_v4_%out_bool = eq __net_ip_eq_ltag_%out_bool, NET_IP_ADDR_V4
    br __net_ip_eq_is_v4_%out_bool -> L_NET_IP_EQ_V4_%out_bool, L_NET_IP_EQ_V6_%out_bool
L_NET_IP_EQ_V4_%out_bool:
    EXPAND NET_IPV4_EQ %out_bool, __net_ip_eq_lpayload_%out_bool, __net_ip_eq_rpayload_%out_bool
