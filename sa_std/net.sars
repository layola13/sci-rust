    __net_ipv4_113_%out_bool = eq __net_ipv4_c_%out_bool, 113
    __net_ipv4_doc3a_%out_bool = and __net_ipv4_203_%out_bool, __net_ipv4_0_%out_bool
    __net_ipv4_doc3_%out_bool = and __net_ipv4_doc3a_%out_bool, __net_ipv4_113_%out_bool
