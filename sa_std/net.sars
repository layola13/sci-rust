    !__net_tcp_listener_close_%out_status
[END_MACRO]

[MACRO] NET_TCP_INCOMING_NEW %incoming_ptr, %listener
    store %incoming_ptr+NetTcpIncoming_listener, %listener as u64
[END_MACRO]

[MACRO] NET_TCP_INCOMING_LISTENER %out_listener, %incoming_ptr
    %out_listener = load %incoming_ptr+NetTcpIncoming_listener as u64
[END_MACRO]

[MACRO] NET_TCP_INCOMING_NEXT %out_status, %out_ok, %out_stream, %incoming_ptr
    __net_tcp_incoming_listener_%out_status = load %incoming_ptr+NetTcpIncoming_listener as u64
    EXPAND NET_TCP_LISTENER_ACCEPT %out_status, %out_stream, __net_tcp_incoming_listener_%out_status
    %out_ok = eq %out_status, SA_NET_OK
    !__net_tcp_incoming_listener_%out_status
[END_MACRO]

[MACRO] NET_TCP_LISTENER_INCOMING %incoming_ptr, %listener
    EXPAND NET_TCP_INCOMING_NEW %incoming_ptr, %listener
[END_MACRO]

