    EXPAND NET_IPV6_WRITE_OCTETS __net_ipv6_octets_view_ok_%out_ptr, __net_ipv6_octets_view_%out_ptr, 16, %addr
    %out_ptr = ptr_add __net_ipv6_octets_view_%out_ptr, 0
