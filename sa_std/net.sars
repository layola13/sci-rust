@import "net.sal"
@import "net.sai"
@import "hash.sars"
@import "io.sal"
@import "os/fd.sars"

[MACRO] NET_LAST_ERROR %out_error
    %out_error = call @sa_std_last_error()
[END_MACRO]

[MACRO] NET_HOSTNAME %out_status, %out_ptr, %out_cap, %out_len
