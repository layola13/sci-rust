L_NET_SOCKET_SCOPE_V4_%out_ok:
    %out_ok = add 0, 0
    %out_scope_id = add 0, 0
    jmp L_NET_SOCKET_SCOPE_DONE_%out_ok
L_NET_SOCKET_SCOPE_DONE_%out_ok:
    !__net_sock_scope_is_v6_%out_ok
    !__net_sock_scope_payload_%out_ok
    !__net_sock_scope_tag_%out_ok
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_SET_SCOPE_ID %out_ok, %socket_addr, %scope_id
    __net_sock_set_scope_tag_%out_ok = load %socket_addr+NetSocketAddr_tag as u64
    __net_sock_set_scope_payload_%out_ok = ptr_add %socket_addr, 8
    __net_sock_set_scope_is_v6_%out_ok = eq __net_sock_set_scope_tag_%out_ok, NET_IP_ADDR_V6
    br __net_sock_set_scope_is_v6_%out_ok -> L_NET_SOCKET_SET_SCOPE_V6_%out_ok, L_NET_SOCKET_SET_SCOPE_V4_%out_ok
L_NET_SOCKET_SET_SCOPE_V6_%out_ok:
    EXPAND NET_SOCKET_ADDR_V6_SET_SCOPE_ID __net_sock_set_scope_payload_%out_ok, %scope_id
    %out_ok = add 0, 1
