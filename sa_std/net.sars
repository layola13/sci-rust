[MACRO] NET_IP_ADDR_FORMAT_ASCII %out_ok, %out_len, %ipaddr, %dst_ptr, %dst_cap
    __net_ip_fmt_tag_%out_ok = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_fmt_payload_%out_ok = ptr_add %ipaddr, 8
    __net_ip_fmt_is_v4_%out_ok = eq __net_ip_fmt_tag_%out_ok, NET_IP_ADDR_V4
    br __net_ip_fmt_is_v4_%out_ok -> L_NET_IP_FMT_V4_%out_ok, L_NET_IP_FMT_V6_%out_ok
L_NET_IP_FMT_V4_%out_ok:
    EXPAND NET_IPV4_FORMAT_ASCII %out_ok, %out_len, __net_ip_fmt_payload_%out_ok, %dst_ptr, %dst_cap
    jmp L_NET_IP_FMT_DONE_%out_ok
L_NET_IP_FMT_V6_%out_ok:
    EXPAND NET_IPV6_FORMAT_ASCII %out_ok, %out_len, __net_ip_fmt_payload_%out_ok, %dst_ptr, %dst_cap
    jmp L_NET_IP_FMT_DONE_%out_ok
L_NET_IP_FMT_DONE_%out_ok:
    !__net_ip_fmt_is_v4_%out_ok
    !__net_ip_fmt_payload_%out_ok
    !__net_ip_fmt_tag_%out_ok
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_FORMAT_ASCII %out_ok, %out_len, %socket_addr, %dst_ptr, %dst_cap
    __net_sock_fmt_tag_%out_ok = load %socket_addr+NetSocketAddr_tag as u64
    __net_sock_fmt_payload_%out_ok = ptr_add %socket_addr, 8
    __net_sock_fmt_is_v4_%out_ok = eq __net_sock_fmt_tag_%out_ok, NET_IP_ADDR_V4
    br __net_sock_fmt_is_v4_%out_ok -> L_NET_SOCK_FMT_V4_%out_ok, L_NET_SOCK_FMT_V6_%out_ok
L_NET_SOCK_FMT_V4_%out_ok:
    EXPAND NET_SOCKET_ADDR_V4_FORMAT_ASCII %out_ok, %out_len, __net_sock_fmt_payload_%out_ok, %dst_ptr, %dst_cap
    jmp L_NET_SOCK_FMT_DONE_%out_ok
L_NET_SOCK_FMT_V6_%out_ok:
