L_NET_SOCKET_SET_SCOPE_DONE_%out_ok:
    !__net_sock_set_scope_is_v6_%out_ok
    !__net_sock_set_scope_payload_%out_ok
    !__net_sock_set_scope_tag_%out_ok
[END_MACRO]

// Explicit byte-oriented aliases over the existing stream/datagram ABI.
[MACRO] NET_TCP_STREAM_READ_BYTES %out_status, %out_len, %stream, %buf, %cap
    EXPAND NET_TCP_STREAM_READ %out_status, %out_len, %stream, %buf, %cap
[END_MACRO]

[MACRO] NET_TCP_STREAM_PEEK_BYTES %out_status, %out_len, %stream, %buf, %cap
    EXPAND NET_TCP_STREAM_PEEK %out_status, %out_len, %stream, %buf, %cap
[END_MACRO]

[MACRO] NET_TCP_STREAM_WRITE_BYTES %out_status, %out_len, %stream, %buf, %len
    EXPAND NET_TCP_STREAM_WRITE %out_status, %out_len, %stream, %buf, %len
[END_MACRO]

[MACRO] NET_TCP_STREAM_WRITE_ALL_BYTES %out_status, %stream, %buf, %len
