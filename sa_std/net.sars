[END_MACRO]

[MACRO] NET_IPV4_COPY %dst_addr, %src_addr
    __net_ipv4_copy_a_%dst_addr = load %src_addr+NetIpv4Addr_a as u8
    __net_ipv4_copy_b_%dst_addr = load %src_addr+NetIpv4Addr_b as u8
    __net_ipv4_copy_c_%dst_addr = load %src_addr+NetIpv4Addr_c as u8
    __net_ipv4_copy_d_%dst_addr = load %src_addr+NetIpv4Addr_d as u8
    EXPAND NET_IPV4_NEW %dst_addr, __net_ipv4_copy_a_%dst_addr, __net_ipv4_copy_b_%dst_addr, __net_ipv4_copy_c_%dst_addr, __net_ipv4_copy_d_%dst_addr
    !__net_ipv4_copy_d_%dst_addr
    !__net_ipv4_copy_c_%dst_addr
    !__net_ipv4_copy_b_%dst_addr
    !__net_ipv4_copy_a_%dst_addr
[END_MACRO]

[MACRO] NET_IPV4_TO_BITS %out_bits, %addr
    __net_ipv4_bits_a_%out_bits = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_bits_b_%out_bits = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_bits_c_%out_bits = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_bits_d_%out_bits = load %addr+NetIpv4Addr_d as u8
    __net_ipv4_bits_a_shift_%out_bits = shl __net_ipv4_bits_a_%out_bits, 24
    __net_ipv4_bits_b_shift_%out_bits = shl __net_ipv4_bits_b_%out_bits, 16
    __net_ipv4_bits_c_shift_%out_bits = shl __net_ipv4_bits_c_%out_bits, 8
    __net_ipv4_bits_ab_%out_bits = or __net_ipv4_bits_a_shift_%out_bits, __net_ipv4_bits_b_shift_%out_bits
    __net_ipv4_bits_cd_%out_bits = or __net_ipv4_bits_c_shift_%out_bits, __net_ipv4_bits_d_%out_bits
    %out_bits = or __net_ipv4_bits_ab_%out_bits, __net_ipv4_bits_cd_%out_bits
    !__net_ipv4_bits_cd_%out_bits
    !__net_ipv4_bits_ab_%out_bits
    !__net_ipv4_bits_c_shift_%out_bits
    !__net_ipv4_bits_b_shift_%out_bits
    !__net_ipv4_bits_a_shift_%out_bits
    !__net_ipv4_bits_d_%out_bits
    !__net_ipv4_bits_c_%out_bits
    !__net_ipv4_bits_b_%out_bits
    !__net_ipv4_bits_a_%out_bits
[END_MACRO]

