[MACRO] NET_IPV4_FORMAT_ASCII %out_ok, %out_len, %addr, %dst_ptr, %dst_cap
    __net_ipv4_fmt_len_slot_%out_ok = stack_alloc 8
    store __net_ipv4_fmt_len_slot_%out_ok+0, 0 as u64
    %out_ok = call @sa_net_ipv4_format_ascii(&%addr, &%dst_ptr, %dst_cap, &__net_ipv4_fmt_len_slot_%out_ok)
    %out_len = load __net_ipv4_fmt_len_slot_%out_ok+0 as u64
[END_MACRO]

[MACRO] NET_IPV6_FORMAT_ASCII %out_ok, %out_len, %addr, %dst_ptr, %dst_cap
