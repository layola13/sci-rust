[END_MACRO]

[MACRO] NET_TCP_LISTENER_INTO_OWNED_FD %out_status, %out_fd_handle, %listener
    EXPAND NET_TCP_LISTENER_INTO_RAW_FD %out_status, __net_tcp_listener_owned_raw_%out_status, %listener
    !%out_status
    EXPAND FD_FROM_RAW %out_status, %out_fd_handle, __net_tcp_listener_owned_raw_%out_status
    !__net_tcp_listener_owned_raw_%out_status
[END_MACRO]

[MACRO] NET_TCP_LISTENER_FROM_OWNED_FD %out_status, %out_listener, %fd_handle
