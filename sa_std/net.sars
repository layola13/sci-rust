[END_MACRO]

[MACRO] NET_IPV4_OCTETS %out_a, %out_b, %out_c, %out_d, %addr
    %out_a = load %addr+NetIpv4Addr_a as u8
    %out_b = load %addr+NetIpv4Addr_b as u8
    %out_c = load %addr+NetIpv4Addr_c as u8
    %out_d = load %addr+NetIpv4Addr_d as u8
[END_MACRO]

[MACRO] NET_IPV4_AS_OCTETS_PTR %out_ptr, %addr
    %out_ptr = ptr_add %addr, 0
[END_MACRO]

[MACRO] NET_IPV4_WRITE_OCTETS %out_ok, %dst_ptr, %dst_len, %addr
    __net_ipv4_write_fits_%out_ok = uge %dst_len, 4
    br __net_ipv4_write_fits_%out_ok -> L_NET_IPV4_WRITE_OCTETS_OK_%out_ok, L_NET_IPV4_WRITE_OCTETS_FAIL_%out_ok

L_NET_IPV4_WRITE_OCTETS_OK_%out_ok:
    __net_ipv4_write_a_%out_ok = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_write_b_%out_ok = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_write_c_%out_ok = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_write_d_%out_ok = load %addr+NetIpv4Addr_d as u8
    store %dst_ptr+0, __net_ipv4_write_a_%out_ok as u8
    __net_ipv4_write_p1_%out_ok = ptr_add %dst_ptr, 1
    __net_ipv4_write_p2_%out_ok = ptr_add %dst_ptr, 2
    __net_ipv4_write_p3_%out_ok = ptr_add %dst_ptr, 3
    store __net_ipv4_write_p1_%out_ok+0, __net_ipv4_write_b_%out_ok as u8
    store __net_ipv4_write_p2_%out_ok+0, __net_ipv4_write_c_%out_ok as u8
    store __net_ipv4_write_p3_%out_ok+0, __net_ipv4_write_d_%out_ok as u8
    %out_ok = add 0, 1
    !__net_ipv4_write_p3_%out_ok
    !__net_ipv4_write_p2_%out_ok
    !__net_ipv4_write_p1_%out_ok
    !__net_ipv4_write_d_%out_ok
    !__net_ipv4_write_c_%out_ok
    !__net_ipv4_write_b_%out_ok
    !__net_ipv4_write_a_%out_ok
    !__net_ipv4_write_fits_%out_ok
    jmp L_NET_IPV4_WRITE_OCTETS_END_%out_ok

L_NET_IPV4_WRITE_OCTETS_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__net_ipv4_write_fits_%out_ok

L_NET_IPV4_WRITE_OCTETS_END_%out_ok:
[END_MACRO]

[MACRO] NET_IPV4_FROM_OCTETS %addr, %a, %b, %c, %d
