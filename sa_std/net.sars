[MACRO] NET_TCP_STREAM_SET_KEEP_ALIVE_PARAMS %out_status, %stream, %idle_secs, %intvl_secs, %cnt
    EXPAND NET_TCP_STREAM_SET_KEEPALIVE_PARAMS %out_status, %stream, %idle_secs, %intvl_secs, %cnt
[END_MACRO]
// Convert the public SA status code into the stable Rust-style ErrorKind
// discriminator. Network APIs expose SA status codes; take_error values are
// raw errno/WSA values and intentionally are not accepted here.

// Rust-style stable network error code facade over public SA status values.
[MACRO] NET_ERROR_CODE_FROM_STATUS %out_code, %status
    %out_code = call @sa_std_net_error_code_from_status(%status)
[END_MACRO]

[MACRO] NET_TCP_CONNECT_TIMEOUT_ALL %out_status, %out_stream, %host, %host_len, %port, %timeout_ns
    __net_tcp_connect_timeout_all_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_net_tcp_connect_timeout_all(&%host, %host_len, %port, %timeout_ns, &__net_tcp_connect_timeout_all_handle_%out_status)
    %out_stream = load __net_tcp_connect_timeout_all_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] NET_TCP_CONNECT_TIMEOUT %out_status, %out_stream, %host, %host_len, %port, %timeout_ns
    __net_tcp_connect_timeout_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_net_tcp_connect_timeout(&%host, %host_len, %port, %timeout_ns, &__net_tcp_connect_timeout_handle_%out_status)
    %out_stream = load __net_tcp_connect_timeout_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] NET_TCP_CONNECT_TIMEOUT_ADDR %out_status, %out_stream, %addr, %timeout_ns
    __net_tcp_connect_timeout_addr_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_net_tcp_connect_timeout_addr(%addr, %timeout_ns, &__net_tcp_connect_timeout_addr_handle_%out_status)
    %out_stream = load __net_tcp_connect_timeout_addr_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] NET_ERROR_CODE_FROM_POSIX_ERRNO %out_code, %errno
    %out_code = call @sa_std_net_error_code_from_posix_errno(%errno)
[END_MACRO]

[MACRO] NET_ERROR_CODE_FROM_WSA_ERROR %out_code, %error
    %out_code = call @sa_std_net_error_code_from_wsa_error(%error)
[END_MACRO]

[MACRO] NET_ERROR_CODE_NAME %out_status, %code, %out_ptr, %out_cap, %out_len
    %out_status = call @sa_std_net_error_code_name(%code, %out_ptr, %out_cap, %out_len)
[END_MACRO]

[MACRO] NET_ERROR_PLATFORM %out_platform
    %out_platform = call @sa_std_net_error_platform()
[END_MACRO]

[MACRO] NET_ERROR_CODE_FROM_NATIVE_ERROR %out_code, %error
    %out_code = call @sa_std_net_error_code_from_native_error(%error)
[END_MACRO]

[MACRO] NET_ERROR_NEW %error_ptr, %code, %platform, %raw, %status
    store %error_ptr+SaNetError_code, %code as i32
    store %error_ptr+SaNetError_platform, %platform as i32
    store %error_ptr+SaNetError_raw, %raw as i32
    store %error_ptr+SaNetError_status, %status as i32
[END_MACRO]

[MACRO] NET_ERROR_FROM_STATUS %error_ptr, %status
    EXPAND NET_ERROR_CODE_FROM_STATUS __net_error_status_code_%error_ptr, %status
    EXPAND NET_ERROR_NEW %error_ptr, __net_error_status_code_%error_ptr, SA_NET_ERROR_PLATFORM_NONE, 0, %status
    !__net_error_status_code_%error_ptr
[END_MACRO]

[MACRO] NET_ERROR_FROM_NATIVE %error_ptr, %raw
    EXPAND NET_ERROR_PLATFORM __net_error_native_platform_%error_ptr
    EXPAND NET_ERROR_CODE_FROM_NATIVE_ERROR __net_error_native_code_%error_ptr, %raw
    EXPAND NET_ERROR_NEW %error_ptr, __net_error_native_code_%error_ptr, __net_error_native_platform_%error_ptr, %raw, SA_NET_STATUS_NET
    !__net_error_native_code_%error_ptr
    !__net_error_native_platform_%error_ptr
[END_MACRO]

[MACRO] NET_ERROR_KIND %out_code, %error_ptr
    %out_code = load %error_ptr+SaNetError_code as i32
[END_MACRO]

[MACRO] NET_ERROR_PLATFORM_OF %out_platform, %error_ptr
    %out_platform = load %error_ptr+SaNetError_platform as i32
[END_MACRO]

[MACRO] NET_ERROR_RAW_OS_ERROR %out_has, %out_raw, %error_ptr
    __net_error_raw_platform_%out_has = load %error_ptr+SaNetError_platform as i32
    %out_raw = load %error_ptr+SaNetError_raw as i32
    %out_has = ne __net_error_raw_platform_%out_has, SA_NET_ERROR_PLATFORM_NONE
    !__net_error_raw_platform_%out_has
[END_MACRO]

[MACRO] NET_ERROR_STATUS %out_status, %error_ptr
    %out_status = load %error_ptr+SaNetError_status as i32
[END_MACRO]

[MACRO] NET_ERROR_IS_OK %out_bool, %error_ptr
    __net_error_ok_code_%out_bool = load %error_ptr+SaNetError_code as i32
    %out_bool = eq __net_error_ok_code_%out_bool, SA_NET_ERROR_CODE_OK
    !__net_error_ok_code_%out_bool
[END_MACRO]
[MACRO] NET_ERROR_KIND_FROM_STATUS %out_kind, %status
    __net_kind_invalid_arg_%out_kind = eq %status, SA_NET_STATUS_INVALID_ARGUMENT
    br __net_kind_invalid_arg_%out_kind -> L_NET_KIND_INVALID_ARG_%out_kind, L_NET_KIND_INVALID_HANDLE_%out_kind
L_NET_KIND_INVALID_ARG_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_INVALID_INPUT
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_INVALID_HANDLE_%out_kind:
    __net_kind_invalid_handle_%out_kind = eq %status, SA_NET_STATUS_INVALID_HANDLE
    br __net_kind_invalid_handle_%out_kind -> L_NET_KIND_INVALID_HANDLE_VALUE_%out_kind, L_NET_KIND_NOT_FOUND_%out_kind
L_NET_KIND_INVALID_HANDLE_VALUE_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_NOT_CONNECTED
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_NOT_FOUND_%out_kind:
    __net_kind_not_found_%out_kind = eq %status, SA_NET_STATUS_NOT_FOUND
    br __net_kind_not_found_%out_kind -> L_NET_KIND_NOT_FOUND_VALUE_%out_kind, L_NET_KIND_ACCESS_%out_kind
L_NET_KIND_NOT_FOUND_VALUE_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_NOT_FOUND
    !__net_kind_not_found_%out_kind
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_ACCESS_%out_kind:
    __net_kind_access_%out_kind = eq %status, SA_NET_STATUS_ACCESS
    br __net_kind_access_%out_kind -> L_NET_KIND_ACCESS_VALUE_%out_kind, L_NET_KIND_NO_MEMORY_%out_kind
L_NET_KIND_ACCESS_VALUE_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_PERMISSION_DENIED
    !__net_kind_access_%out_kind
    !__net_kind_not_found_%out_kind
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_NO_MEMORY_%out_kind:
    __net_kind_no_memory_%out_kind = eq %status, SA_NET_STATUS_NO_MEMORY
    br __net_kind_no_memory_%out_kind -> L_NET_KIND_NO_MEMORY_VALUE_%out_kind, L_NET_KIND_IO_%out_kind
L_NET_KIND_NO_MEMORY_VALUE_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_OUT_OF_MEMORY
    !__net_kind_no_memory_%out_kind
    !__net_kind_access_%out_kind
    !__net_kind_not_found_%out_kind
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_IO_%out_kind:
    __net_kind_io_%out_kind = eq %status, SA_NET_STATUS_IO
    br __net_kind_io_%out_kind -> L_NET_KIND_IO_VALUE_%out_kind, L_NET_KIND_NET_%out_kind
L_NET_KIND_IO_VALUE_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_OTHER
    !__net_kind_io_%out_kind
    !__net_kind_no_memory_%out_kind
    !__net_kind_access_%out_kind
    !__net_kind_not_found_%out_kind
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_NET_%out_kind:
    __net_kind_net_%out_kind = eq %status, SA_NET_STATUS_NET
    br __net_kind_net_%out_kind -> L_NET_KIND_NET_VALUE_%out_kind, L_NET_KIND_UNSUPPORTED_%out_kind
L_NET_KIND_NET_VALUE_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_NETWORK_UNREACHABLE
    !__net_kind_net_%out_kind
    !__net_kind_io_%out_kind
    !__net_kind_no_memory_%out_kind
    !__net_kind_access_%out_kind
    !__net_kind_not_found_%out_kind
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_UNSUPPORTED_%out_kind:
    __net_kind_unsupported_%out_kind = eq %status, SA_NET_STATUS_UNSUPPORTED
    br __net_kind_unsupported_%out_kind -> L_NET_KIND_UNSUPPORTED_VALUE_%out_kind, L_NET_KIND_OTHER_%out_kind
L_NET_KIND_UNSUPPORTED_VALUE_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_UNSUPPORTED
    !__net_kind_unsupported_%out_kind
    !__net_kind_net_%out_kind
    !__net_kind_io_%out_kind
    !__net_kind_no_memory_%out_kind
    !__net_kind_access_%out_kind
    !__net_kind_not_found_%out_kind
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
    jmp L_NET_KIND_END_%out_kind
L_NET_KIND_OTHER_%out_kind:
    %out_kind = add 0, IO_ERROR_KIND_OTHER
    !__net_kind_unsupported_%out_kind
    !__net_kind_net_%out_kind
    !__net_kind_io_%out_kind
    !__net_kind_no_memory_%out_kind
    !__net_kind_access_%out_kind
    !__net_kind_not_found_%out_kind
    !__net_kind_invalid_handle_%out_kind
    !__net_kind_invalid_arg_%out_kind
L_NET_KIND_END_%out_kind:
[END_MACRO]
// Rust-style spelling aliases. SA exposes the 128-bit value as two u64
// registers because the language has no native u128 scalar.
[MACRO] NET_IPV6_TO_BITS %out_hi, %out_lo, %addr
    EXPAND NET_IPV6_TO_BITS64 %out_hi, %out_lo, %addr
[END_MACRO]

[MACRO] NET_IPV6_FROM_BITS %addr, %hi, %lo
    EXPAND NET_IPV6_FROM_BITS64 %addr, %hi, %lo
[END_MACRO]
