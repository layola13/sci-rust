[MACRO] RANDOM_STATE_HASH_ONE_NET_SOCKET_ADDR %out_hash, %state, %socket_addr
    __random_state_hash_one_socket_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_socket_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_NET_SOCKET_ADDR __random_state_hash_one_socket_hasher_%out_hash, %socket_addr
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_socket_hasher_%out_hash
[END_MACRO]

[MACRO] NET_IPV4_FROM_BITS %addr, %bits
    __net_ipv4_from_a_%addr = lshr %bits, 24
    __net_ipv4_from_b_raw_%addr = lshr %bits, 16
    __net_ipv4_from_b_%addr = and __net_ipv4_from_b_raw_%addr, 255
    __net_ipv4_from_c_raw_%addr = lshr %bits, 8
    __net_ipv4_from_c_%addr = and __net_ipv4_from_c_raw_%addr, 255
    __net_ipv4_from_d_%addr = and %bits, 255
    EXPAND NET_IPV4_NEW %addr, __net_ipv4_from_a_%addr, __net_ipv4_from_b_%addr, __net_ipv4_from_c_%addr, __net_ipv4_from_d_%addr
    !__net_ipv4_from_d_%addr
    !__net_ipv4_from_c_%addr
    !__net_ipv4_from_c_raw_%addr
    !__net_ipv4_from_b_%addr
    !__net_ipv4_from_b_raw_%addr
    !__net_ipv4_from_a_%addr
[END_MACRO]

