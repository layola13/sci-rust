// HTTP client v2 -> PollResult adapter.
// Import the installed `sa_http_client.sai` before using these macros.
@import "plugin_async.sars"

[MACRO] SA_HTTP_ASYNC_POLL_V2 %out_poll, %op, %timeout_ms
    __sa_http_async_ready_slot_%out_poll = stack_alloc 8
    store __sa_http_async_ready_slot_%out_poll+0, 0 as u64
    __sa_http_async_status_%out_poll = call @sa_http_client_async_poll_v2(%op, %timeout_ms, &__sa_http_async_ready_slot_%out_poll)
    __sa_http_async_ready_%out_poll = load __sa_http_async_ready_slot_%out_poll+0 as u64
    __sa_http_async_resp_slot_%out_poll = stack_alloc 8
    store __sa_http_async_resp_slot_%out_poll+0, 0 as u64
    __sa_http_async_is_ready_%out_poll = ne __sa_http_async_ready_%out_poll, 0
    __sa_http_async_is_ok_%out_poll = eq __sa_http_async_status_%out_poll, PluginAsync_STATUS_OK
    __sa_http_async_can_take_%out_poll = and __sa_http_async_is_ready_%out_poll, __sa_http_async_is_ok_%out_poll
    br __sa_http_async_can_take_%out_poll -> L_SA_HTTP_ASYNC_TAKE_%out_poll, L_SA_HTTP_ASYNC_MAP_%out_poll
L_SA_HTTP_ASYNC_TAKE_%out_poll:
    __sa_http_async_take_status_%out_poll = call @sa_http_client_async_take_response_v2(%op, &__sa_http_async_resp_slot_%out_poll)
    __sa_http_async_resp_%out_poll = load __sa_http_async_resp_slot_%out_poll+0 as ptr
    __sa_http_async_take_ok_%out_poll = eq __sa_http_async_take_status_%out_poll, PluginAsync_STATUS_OK
    br __sa_http_async_take_ok_%out_poll -> L_SA_HTTP_ASYNC_READY_%out_poll, L_SA_HTTP_ASYNC_TAKE_ERR_%out_poll
L_SA_HTTP_ASYNC_READY_%out_poll:
    EXPAND POLL_RESULT_READY_OK %out_poll, __sa_http_async_resp_%out_poll
    jmp L_SA_HTTP_ASYNC_DONE_%out_poll
L_SA_HTTP_ASYNC_TAKE_ERR_%out_poll:
    EXPAND POLL_RESULT_READY_ERR %out_poll, __sa_http_async_take_status_%out_poll
    jmp L_SA_HTTP_ASYNC_DONE_%out_poll
L_SA_HTTP_ASYNC_MAP_%out_poll:
    EXPAND PLUGIN_ASYNC_POLL_RESULT %out_poll, __sa_http_async_status_%out_poll, __sa_http_async_ready_%out_poll, 0
L_SA_HTTP_ASYNC_DONE_%out_poll:
    !__sa_http_async_take_ok_%out_poll
    !__sa_http_async_take_status_%out_poll
    !__sa_http_async_can_take_%out_poll
    !__sa_http_async_is_ok_%out_poll
    !__sa_http_async_is_ready_%out_poll
    !__sa_http_async_resp_%out_poll
    !__sa_http_async_ready_%out_poll
    !__sa_http_async_status_%out_poll
[END_MACRO]

[MACRO] SA_HTTP_ASYNC_CANCEL_V2 %op
    call @sa_http_client_async_cancel_v2(%op)
[END_MACRO]

[MACRO] SA_HTTP_ASYNC_FREE_V2 %op
    call @sa_http_client_async_free_v2(%op)
[END_MACRO]
