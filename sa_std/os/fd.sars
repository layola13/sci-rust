@import "fd.sal"
@import "fd.sai"

[MACRO] FD_AS_RAW %out_status, %out_fd, %handle
    __fd_as_raw_slot_%out_fd = stack_alloc 4
    %out_status = call @sa_std_fd_as_raw(%handle, &__fd_as_raw_slot_%out_fd)
    %out_fd = load __fd_as_raw_slot_%out_fd+0 as i32
[END_MACRO]

[MACRO] FD_DUP %out_status, %out_handle, %handle
    __fd_dup_slot_%out_handle = stack_alloc 8
    %out_status = call @sa_std_fd_dup(%handle, &__fd_dup_slot_%out_handle)
    %out_handle = load __fd_dup_slot_%out_handle+0 as u64
[END_MACRO]

[MACRO] FD_DUP_RAW %out_status, %out_handle, %fd
    __fd_dup_raw_slot_%out_handle = stack_alloc 8
    %out_status = call @sa_std_fd_dup_raw(%fd, &__fd_dup_raw_slot_%out_handle)
    %out_handle = load __fd_dup_raw_slot_%out_handle+0 as u64
[END_MACRO]

[MACRO] FD_RAW_AS_RAW_FD %out_status, %out_fd, %fd
    %out_status = add 0, SA_FD_OK
    %out_fd = add 0, %fd
[END_MACRO]

[MACRO] FD_RAW_INTO_RAW_FD %out_status, %out_fd, %fd
    %out_status = add 0, SA_FD_OK
    %out_fd = add 0, %fd
[END_MACRO]

[MACRO] FD_RAW_FROM_RAW_FD %out_status, %out_fd, %fd
    %out_status = add 0, SA_FD_OK
    %out_fd = add 0, %fd
[END_MACRO]

[MACRO] FD_BORROWED_BORROW_RAW %out_status, %out_fd, %fd
    %out_status = add 0, SA_FD_OK
    %out_fd = add 0, %fd
[END_MACRO]

[MACRO] FD_BORROWED_AS_RAW_FD %out_status, %out_fd, %fd
    %out_status = add 0, SA_FD_OK
    %out_fd = add 0, %fd
[END_MACRO]

[MACRO] FD_BORROWED_AS_FD %out_status, %out_fd, %fd
    %out_status = add 0, SA_FD_OK
    %out_fd = add 0, %fd
[END_MACRO]

[MACRO] FD_BORROWED_TRY_CLONE_TO_OWNED %out_status, %out_handle, %fd
    EXPAND FD_DUP_RAW %out_status, %out_handle, %fd
[END_MACRO]

[MACRO] FD_OWNED_TRY_CLONE %out_status, %out_handle, %fd_handle
    EXPAND FD_DUP %out_status, %out_handle, %fd_handle
[END_MACRO]

[MACRO] FD_FROM_RAW %out_status, %out_handle, %fd
    __fd_from_raw_slot_%out_handle = stack_alloc 8
    %out_status = call @sa_std_fd_from_raw(%fd, &__fd_from_raw_slot_%out_handle)
    %out_handle = load __fd_from_raw_slot_%out_handle+0 as u64
[END_MACRO]

[MACRO] FD_OWNED_FROM_RAW_FD %out_status, %out_handle, %fd
    EXPAND FD_FROM_RAW %out_status, %out_handle, %fd
[END_MACRO]

[MACRO] FD_INTO_RAW %out_status, %out_fd, %handle
    __fd_into_raw_slot_%out_fd = stack_alloc 4
    %out_status = call @sa_std_fd_into_raw(%handle, &__fd_into_raw_slot_%out_fd)
    %out_fd = load __fd_into_raw_slot_%out_fd+0 as i32
[END_MACRO]

[MACRO] FD_OWNED_AS_RAW_FD %out_status, %out_fd, %fd_handle
    EXPAND FD_AS_RAW %out_status, %out_fd, %fd_handle
[END_MACRO]

[MACRO] FD_OWNED_AS_FD %out_status, %out_fd, %fd_handle
    EXPAND FD_AS_RAW %out_status, %out_fd, %fd_handle
[END_MACRO]

[MACRO] FD_OWNED_INTO_RAW_FD %out_status, %out_fd, %fd_handle
    EXPAND FD_INTO_RAW %out_status, %out_fd, %fd_handle
[END_MACRO]

[MACRO] FD_CLOSE_RAW %out_status, %fd
    %out_status = call @sa_std_fd_close_raw(%fd)
[END_MACRO]

[MACRO] FD_IS_TERMINAL %out_status, %out_flag, %handle
    __fd_is_terminal_slot_%out_flag = stack_alloc 1
    %out_status = call @sa_std_fd_is_terminal(%handle, &__fd_is_terminal_slot_%out_flag)
    %out_flag = load __fd_is_terminal_slot_%out_flag+0 as u8
[END_MACRO]
