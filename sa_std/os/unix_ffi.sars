@import "../core/slice.sal"
@import "../core/slice.sars"
@import "../vec.sars"
@import "../string.sars"
@import "../hash.sars"

[MACRO] OS_STR_FROM_BYTES %out_os_str, %bytes_slice
    __os_str_from_bytes_ptr_%out_os_str = load %bytes_slice+Slice_ptr as ptr
    __os_str_from_bytes_len_%out_os_str = load %bytes_slice+Slice_len as u64
    %out_os_str = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_os_str, __os_str_from_bytes_ptr_%out_os_str, __os_str_from_bytes_len_%out_os_str
    !__os_str_from_bytes_ptr_%out_os_str
    !__os_str_from_bytes_len_%out_os_str
[END_MACRO]

[MACRO] OS_STR_FROM_BYTES_SLICE %out_os_str, %bytes_slice
    EXPAND OS_STR_FROM_BYTES %out_os_str, %bytes_slice
[END_MACRO]

[MACRO] OS_STR_AS_BYTES %out_slice, %os_str
    __os_str_as_bytes_ptr_%out_slice = load %os_str+Slice_ptr as ptr
    __os_str_as_bytes_len_%out_slice = load %os_str+Slice_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __os_str_as_bytes_ptr_%out_slice, __os_str_as_bytes_len_%out_slice
    !__os_str_as_bytes_ptr_%out_slice
    !__os_str_as_bytes_len_%out_slice
[END_MACRO]

[MACRO] OS_STR_AS_BYTES_SLICE %out_slice, %os_str
    EXPAND OS_STR_AS_BYTES %out_slice, %os_str
[END_MACRO]

[MACRO] OS_STRING_FROM_VEC %out_os_string, %vec_reg
    %out_os_string = %vec_reg
[END_MACRO]

[MACRO] OS_STRING_FROM_VEC_U8 %out_os_string, %vec_reg
    EXPAND OS_STRING_FROM_VEC %out_os_string, %vec_reg
[END_MACRO]

[MACRO] OS_STRING_INTO_VEC %out_vec, %os_string
    %out_vec = %os_string
[END_MACRO]

[MACRO] OS_STRING_INTO_VEC_U8 %out_vec, %os_string
    EXPAND OS_STRING_INTO_VEC %out_vec, %os_string
[END_MACRO]

// Concrete OsString/OsStr helpers over Vec<u8>/Slice byte storage.
// These are thin ownership/view aliases, not platform WTF-8/Windows OsString.

[MACRO] OS_STRING_NEW %out_os_string
    EXPAND VEC_NEW %out_os_string
[END_MACRO]

[MACRO] OS_STRING_DEFAULT %out_os_string
    EXPAND OS_STRING_NEW %out_os_string
[END_MACRO]

[MACRO] OS_STRING_WITH_CAPACITY %out_os_string, %capacity
    EXPAND VEC_WITH_CAPACITY %out_os_string, %capacity, 1
[END_MACRO]

[MACRO] OS_STRING_FROM_STR %out_os_string, %str_slice
    EXPAND VEC_FROM_STR_BYTES %out_os_string, %str_slice
[END_MACRO]

[MACRO] OS_STRING_FROM_OS_STR %out_os_string, %os_str
    EXPAND OS_STR_AS_BYTES __os_string_from_os_str_bytes_%out_os_string, %os_str
    EXPAND VEC_FROM_SLICE %out_os_string, __os_string_from_os_str_bytes_%out_os_string, 1
    !__os_string_from_os_str_bytes_%out_os_string
[END_MACRO]

[MACRO] OS_STRING_FREE %os_string
    EXPAND VEC_FREE %os_string
[END_MACRO]

[MACRO] OS_STRING_CLEAR %os_string
    EXPAND VEC_CLEAR %os_string
[END_MACRO]

[MACRO] OS_STRING_LEN %out_len, %os_string
    EXPAND VEC_LEN %out_len, %os_string
[END_MACRO]

[MACRO] OS_STRING_CAPACITY %out_cap, %os_string
    EXPAND VEC_CAPACITY %out_cap, %os_string
[END_MACRO]

[MACRO] OS_STRING_IS_EMPTY %out_flag, %os_string
    EXPAND VEC_IS_EMPTY %out_flag, %os_string
[END_MACRO]

[MACRO] OS_STRING_RESERVE %os_string, %additional
    EXPAND VEC_RESERVE %os_string, %additional, 1
[END_MACRO]

[MACRO] OS_STRING_PUSH_STR %os_string, %str_slice
    EXPAND VEC_EXTEND_FROM_SLICE %os_string, %str_slice, 1
[END_MACRO]

[MACRO] OS_STRING_PUSH_OS_STR %os_string, %os_str
    EXPAND OS_STR_AS_BYTES __os_string_push_os_str_bytes_%os_string, %os_str
    EXPAND VEC_EXTEND_FROM_SLICE %os_string, __os_string_push_os_str_bytes_%os_string, 1
    !__os_string_push_os_str_bytes_%os_string
[END_MACRO]

[MACRO] OS_STRING_PUSH_SLICE %os_string, %bytes_slice
    EXPAND VEC_EXTEND_FROM_SLICE %os_string, %bytes_slice, 1
[END_MACRO]

[MACRO] OS_STRING_AS_OS_STR %out_os_str, %os_string
    EXPAND VEC_AS_SLICE %out_os_str, %os_string
[END_MACRO]

[MACRO] OS_STRING_AS_SLICE %out_slice, %os_string
    EXPAND VEC_AS_SLICE %out_slice, %os_string
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_OS_STR %hasher, %os_str
    EXPAND OS_STR_AS_BYTES __os_str_hash_bytes_%hasher, %os_str
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 %hasher, __os_str_hash_bytes_%hasher
    !__os_str_hash_bytes_%hasher
[END_MACRO]

[MACRO] OS_STR_HASH %out_hash, %os_str
    EXPAND OS_STR_AS_BYTES __os_str_hash_bytes_%out_hash, %os_str
    EXPAND HASH_SLICE_U8 %out_hash, __os_str_hash_bytes_%out_hash
    !__os_str_hash_bytes_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_OS_STR %out_hash, %builder, %os_str
    __build_hash_one_os_str_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_os_str_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_OS_STR __build_hash_one_os_str_hasher_%out_hash, %os_str
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_os_str_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_OS_STR %out_hash, %state, %os_str
    __random_state_hash_one_os_str_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_os_str_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_OS_STR __random_state_hash_one_os_str_hasher_%out_hash, %os_str
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_os_str_hasher_%out_hash
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_OS_STRING %hasher, %os_string
    EXPAND OS_STRING_AS_OS_STR __os_string_hash_view_%hasher, %os_string
    EXPAND DEFAULT_HASHER_WRITE_OS_STR %hasher, __os_string_hash_view_%hasher
    !__os_string_hash_view_%hasher
[END_MACRO]

[MACRO] OS_STRING_HASH %out_hash, %os_string
    EXPAND OS_STRING_AS_OS_STR __os_string_hash_view_%out_hash, %os_string
    EXPAND OS_STR_HASH %out_hash, __os_string_hash_view_%out_hash
    !__os_string_hash_view_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_OS_STRING %out_hash, %builder, %os_string
    __build_hash_one_os_string_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_os_string_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_OS_STRING __build_hash_one_os_string_hasher_%out_hash, %os_string
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_os_string_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_OS_STRING %out_hash, %state, %os_string
    __random_state_hash_one_os_string_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_os_string_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_OS_STRING __random_state_hash_one_os_string_hasher_%out_hash, %os_string
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_os_string_hasher_%out_hash
[END_MACRO]

[MACRO] OS_STRING_CLONE %out_os_string, %os_string
    EXPAND VEC_CLONE %out_os_string, %os_string, 1
[END_MACRO]

[MACRO] OS_STRING_TO_STRING_CHECKED %out_ok, %out_string, %os_string
    EXPAND VEC_AS_SLICE __os_string_to_str_view_%out_ok, %os_string
    EXPAND STRING_BUF_TRY_FROM_UTF8 %out_ok, %out_string, __os_string_to_str_view_%out_ok
    !__os_string_to_str_view_%out_ok
[END_MACRO]

[MACRO] OS_STRING_INTO_STRING_CHECKED %out_ok, %out_string, %os_string
    EXPAND OS_STRING_TO_STRING_CHECKED %out_ok, %out_string, %os_string
    br %out_ok -> L_OS_STRING_INTO_STRING_OK_%out_ok, L_OS_STRING_INTO_STRING_BAD_%out_ok
L_OS_STRING_INTO_STRING_OK_%out_ok:
    EXPAND OS_STRING_FREE %os_string
    jmp L_OS_STRING_INTO_STRING_DONE_%out_ok
L_OS_STRING_INTO_STRING_BAD_%out_ok:
    jmp L_OS_STRING_INTO_STRING_DONE_%out_ok
L_OS_STRING_INTO_STRING_DONE_%out_ok:
[END_MACRO]

[MACRO] OS_STR_LEN %out_len, %os_str
    EXPAND SLICE_GET_LEN %out_len, %os_str
[END_MACRO]

[MACRO] OS_STR_IS_EMPTY %out_flag, %os_str
    EXPAND SLICE_GET_LEN __os_str_is_empty_len_%out_flag, %os_str
    %out_flag = eq __os_str_is_empty_len_%out_flag, 0
    !__os_str_is_empty_len_%out_flag
[END_MACRO]

[MACRO] OS_STR_TO_OS_STRING %out_os_string, %os_str
    EXPAND OS_STRING_FROM_OS_STR %out_os_string, %os_str
[END_MACRO]

[MACRO] OS_STR_TO_STR_CHECKED %out_ok, %out_slice, %os_str
    EXPAND OS_STR_AS_BYTES __os_str_to_str_bytes_%out_ok, %os_str
    EXPAND STR_IS_UTF8 %out_ok, __os_str_to_str_bytes_%out_ok
    br %out_ok -> L_OS_STR_TO_STR_OK_%out_ok, L_OS_STR_TO_STR_BAD_%out_ok
L_OS_STR_TO_STR_OK_%out_ok:
    %out_slice = __os_str_to_str_bytes_%out_ok
    jmp L_OS_STR_TO_STR_DONE_%out_ok
L_OS_STR_TO_STR_BAD_%out_ok:
    !__os_str_to_str_bytes_%out_ok
    __os_str_to_str_empty_ptr_%out_ok = 0 as ptr
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __os_str_to_str_empty_ptr_%out_ok, 0
    !__os_str_to_str_empty_ptr_%out_ok
    jmp L_OS_STR_TO_STR_DONE_%out_ok
L_OS_STR_TO_STR_DONE_%out_ok:
[END_MACRO]

[MACRO] OS_STRING_CAPACITY_REMAINING %out_remaining, %os_string
    EXPAND VEC_CAPACITY_REMAINING %out_remaining, %os_string
[END_MACRO]

[MACRO] OS_STRING_REMAINING_CAPACITY %out_remaining, %os_string
    EXPAND OS_STRING_CAPACITY_REMAINING %out_remaining, %os_string
[END_MACRO]

[MACRO] OS_STRING_EXTRA_CAPACITY %out_remaining, %os_string
    EXPAND OS_STRING_CAPACITY_REMAINING %out_remaining, %os_string
[END_MACRO]

[MACRO] OS_STRING_LIT1 %out_os_string, %s0
    EXPAND OS_STRING_FROM_STR %out_os_string, %s0
[END_MACRO]

[MACRO] OS_STRING_LIT2 %out_os_string, %s0, %s1
    EXPAND OS_STRING_FROM_STR %out_os_string, %s0
    EXPAND OS_STRING_PUSH_STR %out_os_string, %s1
[END_MACRO]

[MACRO] OS_STRING_LIT3 %out_os_string, %s0, %s1, %s2
    EXPAND OS_STRING_FROM_STR %out_os_string, %s0
    EXPAND OS_STRING_PUSH_STR %out_os_string, %s1
    EXPAND OS_STRING_PUSH_STR %out_os_string, %s2
[END_MACRO]

// Lossy UTF-8 display/string materialization over existing StringBuf helpers.

[MACRO] OS_STRING_TO_STRING_LOSSY %out_string, %os_string
    EXPAND OS_STRING_AS_SLICE __os_string_lossy_bytes_%out_string, %os_string
    EXPAND STRING_BUF_FROM_UTF8_LOSSY %out_string, __os_string_lossy_bytes_%out_string
    !__os_string_lossy_bytes_%out_string
[END_MACRO]

[MACRO] OS_STR_TO_STRING_LOSSY %out_string, %os_str
    EXPAND OS_STR_AS_BYTES __os_str_lossy_bytes_%out_string, %os_str
    EXPAND STRING_BUF_FROM_UTF8_LOSSY %out_string, __os_str_lossy_bytes_%out_string
    !__os_str_lossy_bytes_%out_string
[END_MACRO]

[MACRO] OS_STRING_FROM_PATH %out_os_string, %path_slice
    EXPAND OS_STRING_FROM_STR %out_os_string, %path_slice
[END_MACRO]

[MACRO] OS_STRING_INTO_STRING %out_ok, %out_string, %os_string
    EXPAND OS_STRING_INTO_STRING_CHECKED %out_ok, %out_string, %os_string
[END_MACRO]
