    return out_vec

@export sa_map_iter_vec(&map: ptr) -> ^ptr:
L_ENTRY:
    len = load map+HashMap_len as u64
    EXPAND NUM_U64_CHECKED_ADD map_iter_cap_hint_ok, map_iter_cap_hint, len, len
    br map_iter_cap_hint_ok -> L_MAP_ITER_CAP_OK, L_MAP_ITER_CAP_OVERFLOW

L_MAP_ITER_CAP_OVERFLOW:
    panic(1309)

L_MAP_ITER_CAP_OK:
    out_vec = call @sa_vec_with_capacity(map_iter_cap_hint, 8)
    slots = load map+HashMap_slots as ptr
    cap = load map+HashMap_cap as u64
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as u64
    jmp L_MAP_ITER_HEAD

L_MAP_ITER_HEAD:
    idx = load idx_slot+0 as u64
    done = eq idx, cap
    br done -> L_MAP_ITER_DONE, L_MAP_ITER_BODY

L_MAP_ITER_BODY:
    slot_off = mul idx, HashMapSlot_SIZE
    slot = ptr_add slots, slot_off
    state = load slot+HashMapSlot_state as u8
    filled = eq state, HashMap_STATE_FILLED
    br filled -> L_MAP_ITER_PUSH, L_MAP_ITER_NEXT

L_MAP_ITER_PUSH:
    key = load slot+HashMapSlot_key as ptr
    value = load slot+HashMapSlot_value as ptr
    key_bits = bitcast key as u64
    value_bits = bitcast value as u64
    out_vec = call @sa_vec_push(^out_vec, key_bits, 8)
    out_vec = call @sa_vec_push(^out_vec, value_bits, 8)
    !value_bits
    !key_bits
    !value
    !key
    jmp L_MAP_ITER_NEXT

L_MAP_ITER_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as u64
    !next_idx
    !filled
    !state
    !slot
    !slot_off
    !done
    !idx
    jmp L_MAP_ITER_HEAD

L_MAP_ITER_DONE:
    !done
    !idx
    !cap
    !slots
    !map_iter_cap_hint_ok
    !map_iter_cap_hint
    !len
    !map
    return out_vec

@export sa_map_iter_mut_ptrs_vec(&map: ptr) -> ^ptr:
L_ENTRY:
    len = load map+HashMap_len as u64
    EXPAND NUM_U64_CHECKED_ADD map_iter_mut_cap_hint_ok, map_iter_mut_cap_hint, len, len
    br map_iter_mut_cap_hint_ok -> L_MAP_ITER_MUT_CAP_OK, L_MAP_ITER_MUT_CAP_OVERFLOW

L_MAP_ITER_MUT_CAP_OVERFLOW:
    panic(1310)

L_MAP_ITER_MUT_CAP_OK:
    out_vec = call @sa_vec_with_capacity(map_iter_mut_cap_hint, 8)
    slots = load map+HashMap_slots as ptr
    cap = load map+HashMap_cap as u64
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as u64
    jmp L_MAP_ITER_MUT_HEAD

L_MAP_ITER_MUT_HEAD:
    idx = load idx_slot+0 as u64
    done = eq idx, cap
    br done -> L_MAP_ITER_MUT_DONE, L_MAP_ITER_MUT_BODY

L_MAP_ITER_MUT_BODY:
    slot_off = mul idx, HashMapSlot_SIZE
    slot = ptr_add slots, slot_off
    state = load slot+HashMapSlot_state as u8
    filled = eq state, HashMap_STATE_FILLED
    br filled -> L_MAP_ITER_MUT_PUSH, L_MAP_ITER_MUT_NEXT

L_MAP_ITER_MUT_PUSH:
    key = load slot+HashMapSlot_key as ptr
    value_ptr = ptr_add slot, HashMapSlot_value
    key_bits = bitcast key as u64
    value_ptr_bits = bitcast value_ptr as u64
    out_vec = call @sa_vec_push(^out_vec, key_bits, 8)
    out_vec = call @sa_vec_push(^out_vec, value_ptr_bits, 8)
    !value_ptr_bits
    !key_bits
    !value_ptr
    !key
    jmp L_MAP_ITER_MUT_NEXT

L_MAP_ITER_MUT_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as u64
    !next_idx
    !filled
    !state
    !slot
    !slot_off
    !done
    !idx
    jmp L_MAP_ITER_MUT_HEAD

L_MAP_ITER_MUT_DONE:
    !done
    !idx
    !cap
    !slots
    !map_iter_mut_cap_hint_ok
    !map_iter_mut_cap_hint
    !len
    !map
    return out_vec

@export sa_map_remove_entry(&map: ptr, &key: ptr, &out_key_slot: ptr, &out_value_slot: ptr) -> i32:
L_ENTRY:
    found = call @sa_map_try_get_key_value(&map, &key, &out_key_slot, &out_value_slot)
    found_nonzero = ne found, 0
    br found_nonzero -> L_REMOVE_ENTRY_HIT, L_REMOVE_ENTRY_MISS

L_REMOVE_ENTRY_HIT:
    removed = call @sa_map_del(&map, &key)
    !removed
    !found_nonzero
    !found
    !out_value_slot
    !out_key_slot
    !key
    !map
    return 1

L_REMOVE_ENTRY_MISS:
    !found_nonzero
    !found
    !out_value_slot
    !out_key_slot
    !key
    !map
    return 0

@export sa_map_del(&map: ptr, &key: ptr) -> &ptr:
L_ENTRY:
    slots = load map+HashMap_slots as ptr
    cap = load map+HashMap_cap as u64
    len = load map+HashMap_len as u64
    tombs = load map+HashMap_tombs as u64
    cap_is_zero = eq cap, 0
    br cap_is_zero -> L_DEL_MISS_ZERO, L_DEL_PROBE

L_DEL_PROBE:
    seed = load map+HashMap_seed as u64
    hash = call @map_hash_ptr_seed(&key, seed)
    probe_index_slot = stack_alloc 8
    probe_found_slot = stack_alloc 8
    call @map_table_probe(&slots, cap, hash, &key, &probe_index_slot, &probe_found_slot)
    probe_found = load probe_found_slot+0 as u64
    found = ne probe_found, 0
    br found -> L_DEL_HIT, L_DEL_MISS_PROBE

L_DEL_HIT:
    probe_index = load probe_index_slot+0 as u64
    slot_off = mul probe_index, HashMapSlot_SIZE
    slot = ptr_add slots, slot_off
    value = load slot+HashMapSlot_value as ptr
    next_len = sub len, 1
    next_tombs = add tombs, 1
    store map+HashMap_len, next_len as u64
    store map+HashMap_tombs, next_tombs as u64
    store slot+HashMapSlot_hash, 0 as u64
    store slot+HashMapSlot_key, 0 as ptr
    store slot+HashMapSlot_value, 0 as ptr
    store slot+HashMapSlot_state, HashMap_STATE_TOMB as u8
    !slot
    !slot_off
    !probe_index
    !probe_found
    !hash
    !seed
    !cap
    !len
    !tombs
    !next_len
    !next_tombs
    !cap_is_zero
    !key
    !slots
    !map
    return value

L_DEL_MISS_PROBE:
    !probe_found
    !hash
    !seed
    !key
    !cap
    !len
    !tombs
    !cap_is_zero
    !slots
    !map
    return 0

L_DEL_MISS_ZERO:
    !cap
    !len
    !tombs
    !cap_is_zero
    !key
    !slots
    !map
    return 0

[MACRO] MAP_NEW %out_map
    %out_map = call @sa_map_new()
[END_MACRO]

[MACRO] MAP_WITH_SEED %out_map, %seed
    %out_map = call @sa_map_with_seed(%seed)
[END_MACRO]

[MACRO] MAP_WITH_CAPACITY %out_map, %cap
    %out_map = call @sa_map_with_capacity(%cap)
[END_MACRO]

[MACRO] MAP_WITH_CAPACITY_SEED %out_map, %cap, %seed
    %out_map = call @sa_map_with_capacity_seed(%cap, %seed)
[END_MACRO]

[MACRO] MAP_TRY_WITH_CAPACITY %out_ok, %out_map, %cap
    __map_try_new_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_map_try_with_capacity(%cap, &__map_try_new_slot_%out_ok)
    %out_map = load __map_try_new_slot_%out_ok+0 as ptr
[END_MACRO]

[MACRO] MAP_LEN %out_len, %map_reg
    %out_len = call @sa_map_len(&%map_reg)
[END_MACRO]

[MACRO] MAP_CAPACITY %out_cap, %map_reg
    %out_cap = call @sa_map_capacity(&%map_reg)
[END_MACRO]

[MACRO] MAP_EXTRA_CAPACITY %out_extra, %map_reg
    __map_ec_cap_%out_extra = call @sa_map_capacity(&%map_reg)
    __map_ec_len_%out_extra = call @sa_map_len(&%map_reg)
    %out_extra = sub __map_ec_cap_%out_extra, __map_ec_len_%out_extra
    !__map_ec_len_%out_extra
    !__map_ec_cap_%out_extra
[END_MACRO]

[MACRO] MAP_RESERVE %map_reg, %additional
    call @sa_map_reserve(&%map_reg, %additional)
[END_MACRO]

[MACRO] MAP_TRY_RESERVE %out_ok, %map_reg, %additional
    %out_ok = call @sa_map_try_reserve(&%map_reg, %additional)
[END_MACRO]

[MACRO] MAP_SHRINK_TO %map_reg, %min_capacity
    call @sa_map_shrink_to(&%map_reg, %min_capacity)
[END_MACRO]

[MACRO] MAP_SHRINK_TO_FIT %map_reg
    call @sa_map_shrink_to_fit(&%map_reg)
[END_MACRO]

[MACRO] MAP_IS_EMPTY %out_flag, %map_reg
    %out_flag = call @sa_map_is_empty(&%map_reg)
[END_MACRO]

[MACRO] MAP_CONTAINS_KEY %out_flag, %map_reg, %key_reg
    %out_flag = call @sa_map_contains_key(&%map_reg, &%key_reg)
[END_MACRO]

[MACRO] MAP_CLEAR %map_reg
    call @sa_map_clear(&%map_reg)
[END_MACRO]

[MACRO] MAP_RETAIN %out_len, %map_reg, %pred_fn
    __map_retain_slots_%out_len = load %map_reg+HashMap_slots as ptr
    __map_retain_cap_%out_len = load %map_reg+HashMap_cap as u64
    __map_retain_len_%out_len = load %map_reg+HashMap_len as u64
    __map_retain_tombs_start_%out_len = load %map_reg+HashMap_tombs as u64
    __map_retain_len_slot_%out_len = stack_alloc 8
    __map_retain_tombs_slot_%out_len = stack_alloc 8
    store __map_retain_len_slot_%out_len+0, __map_retain_len_%out_len as u64
    store __map_retain_tombs_slot_%out_len+0, __map_retain_tombs_start_%out_len as u64
    __map_retain_idx_slot_%out_len = stack_alloc 8
    store __map_retain_idx_slot_%out_len+0, 0 as u64
    jmp L_MAP_RETAIN_HEAD_%out_len

L_MAP_RETAIN_HEAD_%out_len:
    __map_retain_idx_%out_len = load __map_retain_idx_slot_%out_len+0 as u64
    __map_retain_done_%out_len = eq __map_retain_idx_%out_len, __map_retain_cap_%out_len
    br __map_retain_done_%out_len -> L_MAP_RETAIN_DONE_%out_len, L_MAP_RETAIN_BODY_%out_len

L_MAP_RETAIN_BODY_%out_len:
    __map_retain_slot_off_%out_len = mul __map_retain_idx_%out_len, HashMapSlot_SIZE
    __map_retain_slot_%out_len = ptr_add __map_retain_slots_%out_len, __map_retain_slot_off_%out_len
    __map_retain_state_%out_len = load __map_retain_slot_%out_len+HashMapSlot_state as u8
    __map_retain_filled_%out_len = eq __map_retain_state_%out_len, HashMap_STATE_FILLED
    br __map_retain_filled_%out_len -> L_MAP_RETAIN_CHECK_%out_len, L_MAP_RETAIN_NEXT_%out_len

L_MAP_RETAIN_CHECK_%out_len:
    __map_retain_key_%out_len = load __map_retain_slot_%out_len+HashMapSlot_key as ptr
    __map_retain_value_ptr_%out_len = ptr_add __map_retain_slot_%out_len, HashMapSlot_value
    __map_retain_pred_%out_len = call %pred_fn(__map_retain_key_%out_len, __map_retain_value_ptr_%out_len)
    __map_retain_keep_%out_len = ne __map_retain_pred_%out_len, 0
    br __map_retain_keep_%out_len -> L_MAP_RETAIN_KEEP_%out_len, L_MAP_RETAIN_DROP_%out_len

L_MAP_RETAIN_KEEP_%out_len:
    !__map_retain_keep_%out_len
    !__map_retain_pred_%out_len
    !__map_retain_value_ptr_%out_len
    !__map_retain_key_%out_len
    jmp L_MAP_RETAIN_NEXT_%out_len

L_MAP_RETAIN_DROP_%out_len:
    __map_retain_cur_len_%out_len = load __map_retain_len_slot_%out_len+0 as u64
    __map_retain_cur_tombs_%out_len = load __map_retain_tombs_slot_%out_len+0 as u64
    __map_retain_next_len_%out_len = sub __map_retain_cur_len_%out_len, 1
    __map_retain_next_tombs_%out_len = add __map_retain_cur_tombs_%out_len, 1
    store __map_retain_len_slot_%out_len+0, __map_retain_next_len_%out_len as u64
    store __map_retain_tombs_slot_%out_len+0, __map_retain_next_tombs_%out_len as u64
    store __map_retain_slot_%out_len+HashMapSlot_hash, 0 as u64
    store __map_retain_slot_%out_len+HashMapSlot_key, 0 as ptr
    store __map_retain_slot_%out_len+HashMapSlot_value, 0 as ptr
    store __map_retain_slot_%out_len+HashMapSlot_state, HashMap_STATE_TOMB as u8
    !__map_retain_next_tombs_%out_len
    !__map_retain_next_len_%out_len
    !__map_retain_cur_tombs_%out_len
    !__map_retain_cur_len_%out_len
    !__map_retain_keep_%out_len
    !__map_retain_pred_%out_len
    !__map_retain_value_ptr_%out_len
    !__map_retain_key_%out_len
    jmp L_MAP_RETAIN_NEXT_%out_len

L_MAP_RETAIN_NEXT_%out_len:
    __map_retain_next_idx_%out_len = add __map_retain_idx_%out_len, 1
    store __map_retain_idx_slot_%out_len+0, __map_retain_next_idx_%out_len as u64
    !__map_retain_next_idx_%out_len
    !__map_retain_filled_%out_len
    !__map_retain_state_%out_len
    !__map_retain_slot_%out_len
    !__map_retain_slot_off_%out_len
    !__map_retain_done_%out_len
    !__map_retain_idx_%out_len
    jmp L_MAP_RETAIN_HEAD_%out_len

L_MAP_RETAIN_DONE_%out_len:
    %out_len = load __map_retain_len_slot_%out_len+0 as u64
    __map_retain_tombs_%out_len = load __map_retain_tombs_slot_%out_len+0 as u64
    store %map_reg+HashMap_len, %out_len as u64
    store %map_reg+HashMap_tombs, __map_retain_tombs_%out_len as u64
    !__map_retain_done_%out_len
    !__map_retain_idx_%out_len
    !__map_retain_tombs_%out_len
    !__map_retain_tombs_start_%out_len
    !__map_retain_len_%out_len
    !__map_retain_cap_%out_len
    !__map_retain_slots_%out_len
[END_MACRO]

[MACRO] MAP_DRAIN %out_vec, %map_reg
    __map_drain_len_%out_vec = load %map_reg+HashMap_len as u64
    EXPAND NUM_U64_CHECKED_ADD __map_drain_cap_hint_ok_%out_vec, __map_drain_cap_hint_%out_vec, __map_drain_len_%out_vec, __map_drain_len_%out_vec
    br __map_drain_cap_hint_ok_%out_vec -> L_MAP_DRAIN_CAP_HINT_OK_%out_vec, L_MAP_DRAIN_CAP_HINT_OVERFLOW_%out_vec
L_MAP_DRAIN_CAP_HINT_OVERFLOW_%out_vec:
    panic(1306)
L_MAP_DRAIN_CAP_HINT_OK_%out_vec:
    EXPAND VEC_WITH_CAPACITY_U64 %out_vec, __map_drain_cap_hint_%out_vec
    __map_drain_slots_%out_vec = load %map_reg+HashMap_slots as ptr
    __map_drain_cap_%out_vec = load %map_reg+HashMap_cap as u64
    __map_drain_idx_slot_%out_vec = stack_alloc 8
    store __map_drain_idx_slot_%out_vec+0, 0 as u64
    jmp L_MAP_DRAIN_HEAD_%out_vec

L_MAP_DRAIN_HEAD_%out_vec:
    __map_drain_idx_%out_vec = load __map_drain_idx_slot_%out_vec+0 as u64
    __map_drain_done_%out_vec = eq __map_drain_idx_%out_vec, __map_drain_cap_%out_vec
    br __map_drain_done_%out_vec -> L_MAP_DRAIN_DONE_%out_vec, L_MAP_DRAIN_BODY_%out_vec

L_MAP_DRAIN_BODY_%out_vec:
    __map_drain_slot_off_%out_vec = mul __map_drain_idx_%out_vec, HashMapSlot_SIZE
    __map_drain_slot_%out_vec = ptr_add __map_drain_slots_%out_vec, __map_drain_slot_off_%out_vec
    __map_drain_state_%out_vec = load __map_drain_slot_%out_vec+HashMapSlot_state as u8
    __map_drain_filled_%out_vec = eq __map_drain_state_%out_vec, HashMap_STATE_FILLED
    br __map_drain_filled_%out_vec -> L_MAP_DRAIN_PUSH_%out_vec, L_MAP_DRAIN_NEXT_%out_vec

L_MAP_DRAIN_PUSH_%out_vec:
    __map_drain_key_%out_vec = load __map_drain_slot_%out_vec+HashMapSlot_key as ptr
    __map_drain_value_%out_vec = load __map_drain_slot_%out_vec+HashMapSlot_value as ptr
    __map_drain_key_bits_%out_vec = bitcast __map_drain_key_%out_vec as u64
    __map_drain_value_bits_%out_vec = bitcast __map_drain_value_%out_vec as u64
    EXPAND VEC_PUSH_U64 %out_vec, __map_drain_key_bits_%out_vec
    EXPAND VEC_PUSH_U64 %out_vec, __map_drain_value_bits_%out_vec
    store __map_drain_slot_%out_vec+HashMapSlot_hash, 0 as u64
    store __map_drain_slot_%out_vec+HashMapSlot_key, 0 as ptr
    store __map_drain_slot_%out_vec+HashMapSlot_value, 0 as ptr
    store __map_drain_slot_%out_vec+HashMapSlot_state, HashMap_STATE_EMPTY as u8
    !__map_drain_value_bits_%out_vec
    !__map_drain_key_bits_%out_vec
    !__map_drain_value_%out_vec
    !__map_drain_key_%out_vec
    jmp L_MAP_DRAIN_NEXT_%out_vec

L_MAP_DRAIN_NEXT_%out_vec:
    __map_drain_next_idx_%out_vec = add __map_drain_idx_%out_vec, 1
    store __map_drain_idx_slot_%out_vec+0, __map_drain_next_idx_%out_vec as u64
    !__map_drain_next_idx_%out_vec
    !__map_drain_filled_%out_vec
    !__map_drain_state_%out_vec
    !__map_drain_slot_%out_vec
    !__map_drain_slot_off_%out_vec
    !__map_drain_done_%out_vec
    !__map_drain_idx_%out_vec
    jmp L_MAP_DRAIN_HEAD_%out_vec

L_MAP_DRAIN_DONE_%out_vec:
    EXPAND NUM_U64_CHECKED_MUL __map_drain_bytes_ok_%out_vec, __map_drain_bytes_%out_vec, __map_drain_cap_%out_vec, HashMapSlot_SIZE
    br __map_drain_bytes_ok_%out_vec -> L_MAP_DRAIN_BYTES_OK_%out_vec, L_MAP_DRAIN_BYTES_OVERFLOW_%out_vec
L_MAP_DRAIN_BYTES_OVERFLOW_%out_vec:
    panic(1307)
L_MAP_DRAIN_BYTES_OK_%out_vec:
    __map_drain_has_slots_%out_vec = ne __map_drain_slots_%out_vec, 0
    br __map_drain_has_slots_%out_vec -> L_MAP_DRAIN_CLEAR_SLOTS_%out_vec, L_MAP_DRAIN_FINISH_%out_vec

L_MAP_DRAIN_CLEAR_SLOTS_%out_vec:
    call @sa_mem_set(&__map_drain_slots_%out_vec, 0, __map_drain_bytes_%out_vec)
    jmp L_MAP_DRAIN_FINISH_%out_vec

L_MAP_DRAIN_FINISH_%out_vec:
    store %map_reg+HashMap_len, 0 as u64
    store %map_reg+HashMap_tombs, 0 as u64
    !__map_drain_has_slots_%out_vec
    !__map_drain_bytes_ok_%out_vec
    !__map_drain_bytes_%out_vec
    !__map_drain_done_%out_vec
    !__map_drain_idx_%out_vec
    !__map_drain_cap_%out_vec
    !__map_drain_slots_%out_vec
    !__map_drain_cap_hint_ok_%out_vec
    !__map_drain_cap_hint_%out_vec
    !__map_drain_len_%out_vec
[END_MACRO]

[MACRO] MAP_EXTRACT_IF %out_len, %out_vec, %map_reg, %pred_fn
    __map_extract_slots_%out_len = load %map_reg+HashMap_slots as ptr
    __map_extract_cap_%out_len = load %map_reg+HashMap_cap as u64
    __map_extract_len_%out_len = load %map_reg+HashMap_len as u64
    __map_extract_tombs_start_%out_len = load %map_reg+HashMap_tombs as u64
    EXPAND NUM_U64_CHECKED_ADD __map_extract_cap_hint_ok_%out_len, __map_extract_cap_hint_%out_len, __map_extract_len_%out_len, __map_extract_len_%out_len
    br __map_extract_cap_hint_ok_%out_len -> L_MAP_EXTRACT_CAP_HINT_OK_%out_len, L_MAP_EXTRACT_CAP_HINT_OVERFLOW_%out_len
L_MAP_EXTRACT_CAP_HINT_OVERFLOW_%out_len:
    panic(1308)
L_MAP_EXTRACT_CAP_HINT_OK_%out_len:
    EXPAND VEC_WITH_CAPACITY_U64 %out_vec, __map_extract_cap_hint_%out_len
    __map_extract_len_slot_%out_len = stack_alloc 8
    __map_extract_tombs_slot_%out_len = stack_alloc 8
    store __map_extract_len_slot_%out_len+0, __map_extract_len_%out_len as u64
    store __map_extract_tombs_slot_%out_len+0, __map_extract_tombs_start_%out_len as u64
    __map_extract_idx_slot_%out_len = stack_alloc 8
    store __map_extract_idx_slot_%out_len+0, 0 as u64
    jmp L_MAP_EXTRACT_HEAD_%out_len

L_MAP_EXTRACT_HEAD_%out_len:
    __map_extract_idx_%out_len = load __map_extract_idx_slot_%out_len+0 as u64
    __map_extract_done_%out_len = eq __map_extract_idx_%out_len, __map_extract_cap_%out_len
    br __map_extract_done_%out_len -> L_MAP_EXTRACT_DONE_%out_len, L_MAP_EXTRACT_BODY_%out_len

L_MAP_EXTRACT_BODY_%out_len:
    __map_extract_slot_off_%out_len = mul __map_extract_idx_%out_len, HashMapSlot_SIZE
    __map_extract_slot_%out_len = ptr_add __map_extract_slots_%out_len, __map_extract_slot_off_%out_len
    __map_extract_state_%out_len = load __map_extract_slot_%out_len+HashMapSlot_state as u8
    __map_extract_filled_%out_len = eq __map_extract_state_%out_len, HashMap_STATE_FILLED
    br __map_extract_filled_%out_len -> L_MAP_EXTRACT_CHECK_%out_len, L_MAP_EXTRACT_NEXT_%out_len

L_MAP_EXTRACT_CHECK_%out_len:
    __map_extract_key_%out_len = load __map_extract_slot_%out_len+HashMapSlot_key as ptr
    __map_extract_value_ptr_%out_len = ptr_add __map_extract_slot_%out_len, HashMapSlot_value
    __map_extract_pred_%out_len = call %pred_fn(__map_extract_key_%out_len, __map_extract_value_ptr_%out_len)
    __map_extract_take_%out_len = ne __map_extract_pred_%out_len, 0
    br __map_extract_take_%out_len -> L_MAP_EXTRACT_TAKE_%out_len, L_MAP_EXTRACT_KEEP_%out_len

L_MAP_EXTRACT_KEEP_%out_len:
    !__map_extract_take_%out_len
    !__map_extract_pred_%out_len
    !__map_extract_value_ptr_%out_len
    !__map_extract_key_%out_len
    jmp L_MAP_EXTRACT_NEXT_%out_len

L_MAP_EXTRACT_TAKE_%out_len:
    __map_extract_value_%out_len = load __map_extract_slot_%out_len+HashMapSlot_value as ptr
    __map_extract_key_bits_%out_len = bitcast __map_extract_key_%out_len as u64
    __map_extract_value_bits_%out_len = bitcast __map_extract_value_%out_len as u64
    EXPAND VEC_PUSH_U64 %out_vec, __map_extract_key_bits_%out_len
    EXPAND VEC_PUSH_U64 %out_vec, __map_extract_value_bits_%out_len
    __map_extract_cur_len_%out_len = load __map_extract_len_slot_%out_len+0 as u64
    __map_extract_cur_tombs_%out_len = load __map_extract_tombs_slot_%out_len+0 as u64
    __map_extract_next_len_%out_len = sub __map_extract_cur_len_%out_len, 1
    __map_extract_next_tombs_%out_len = add __map_extract_cur_tombs_%out_len, 1
    store __map_extract_len_slot_%out_len+0, __map_extract_next_len_%out_len as u64
    store __map_extract_tombs_slot_%out_len+0, __map_extract_next_tombs_%out_len as u64
    store __map_extract_slot_%out_len+HashMapSlot_hash, 0 as u64
    store __map_extract_slot_%out_len+HashMapSlot_key, 0 as ptr
    store __map_extract_slot_%out_len+HashMapSlot_value, 0 as ptr
    store __map_extract_slot_%out_len+HashMapSlot_state, HashMap_STATE_TOMB as u8
    !__map_extract_next_tombs_%out_len
    !__map_extract_next_len_%out_len
    !__map_extract_cur_tombs_%out_len
    !__map_extract_cur_len_%out_len
    !__map_extract_value_bits_%out_len
    !__map_extract_key_bits_%out_len
    !__map_extract_take_%out_len
    !__map_extract_pred_%out_len
    !__map_extract_value_%out_len
    !__map_extract_value_ptr_%out_len
    !__map_extract_key_%out_len
    jmp L_MAP_EXTRACT_NEXT_%out_len

L_MAP_EXTRACT_NEXT_%out_len:
    __map_extract_next_idx_%out_len = add __map_extract_idx_%out_len, 1
    store __map_extract_idx_slot_%out_len+0, __map_extract_next_idx_%out_len as u64
    !__map_extract_next_idx_%out_len
    !__map_extract_filled_%out_len
    !__map_extract_state_%out_len
    !__map_extract_slot_%out_len
    !__map_extract_slot_off_%out_len
    !__map_extract_done_%out_len
    !__map_extract_idx_%out_len
    jmp L_MAP_EXTRACT_HEAD_%out_len

L_MAP_EXTRACT_DONE_%out_len:
    %out_len = load __map_extract_len_slot_%out_len+0 as u64
    __map_extract_tombs_%out_len = load __map_extract_tombs_slot_%out_len+0 as u64
    store %map_reg+HashMap_len, %out_len as u64
    store %map_reg+HashMap_tombs, __map_extract_tombs_%out_len as u64
    !__map_extract_done_%out_len
    !__map_extract_idx_%out_len
    !__map_extract_tombs_%out_len
    !__map_extract_tombs_start_%out_len
    !__map_extract_cap_hint_ok_%out_len
    !__map_extract_cap_hint_%out_len
    !__map_extract_len_%out_len
    !__map_extract_cap_%out_len
    !__map_extract_slots_%out_len
[END_MACRO]

[MACRO] MAP_PUT %map_reg, %key, %value
    call @sa_map_put(&%map_reg, &%key, &%value)
[END_MACRO]

[MACRO] MAP_GET %out_value, %map_reg, %key
    %out_value = call @sa_map_get(&%map_reg, &%key)
[END_MACRO]

[MACRO] MAP_TRY_GET %out_ok, %out_value, %map_reg, %key
    __map_try_get_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_map_try_get(&%map_reg, &%key, &__map_try_get_slot_%out_ok)
    %out_value = load __map_try_get_slot_%out_ok+0 as ptr
[END_MACRO]

[MACRO] MAP_GET_KEY_VALUE %out_ok, %out_key, %out_value, %map_reg, %key
    __map_kv_key_slot_%out_ok = stack_alloc 8
    __map_kv_value_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_map_try_get_key_value(&%map_reg, &%key, &__map_kv_key_slot_%out_ok, &__map_kv_value_slot_%out_ok)
    %out_key = load __map_kv_key_slot_%out_ok+0 as ptr
    %out_value = load __map_kv_value_slot_%out_ok+0 as ptr
[END_MACRO]

[MACRO] MAP_GET_MUT_PTR %out_ok, %out_ptr, %map_reg, %key
    __map_mut_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_map_get_mut_ptr(&%map_reg, &%key, &__map_mut_slot_%out_ok)
    %out_ptr = load __map_mut_slot_%out_ok+0 as ptr
[END_MACRO]

[MACRO] MAP_TRY_GET_DISJOINT_MUT_PTRS %out_ok, %out_ptr_a, %out_ptr_b, %map_reg, %key_a, %key_b
    __map_disjoint_mut_a_slot_%out_ok = stack_alloc 8
    __map_disjoint_mut_b_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_map_try_get_disjoint_mut_ptrs(&%map_reg, &%key_a, &%key_b, &__map_disjoint_mut_a_slot_%out_ok, &__map_disjoint_mut_b_slot_%out_ok)
    %out_ptr_a = load __map_disjoint_mut_a_slot_%out_ok+0 as ptr
    %out_ptr_b = load __map_disjoint_mut_b_slot_%out_ok+0 as ptr
[END_MACRO]

// Rust method-name aliases over checked disjoint mutable value-slot pointers.
[MACRO] MAP_GET_DISJOINT_MUT_PTRS %out_ok, %out_ptr_a, %out_ptr_b, %map_reg, %key_a, %key_b
    EXPAND MAP_TRY_GET_DISJOINT_MUT_PTRS %out_ok, %out_ptr_a, %out_ptr_b, %map_reg, %key_a, %key_b
[END_MACRO]

[MACRO] MAP_GET_DISJOINT_MUT %out_ok, %out_ptr_a, %out_ptr_b, %map_reg, %key_a, %key_b
    EXPAND MAP_TRY_GET_DISJOINT_MUT_PTRS %out_ok, %out_ptr_a, %out_ptr_b, %map_reg, %key_a, %key_b
[END_MACRO]

[MACRO] MAP_INSERT %out_replaced, %out_old_value, %map_reg, %key, %value
    __map_insert_old_slot_%out_replaced = stack_alloc 8
    %out_replaced = call @sa_map_insert(&%map_reg, &%key, &%value, &__map_insert_old_slot_%out_replaced)
    %out_old_value = load __map_insert_old_slot_%out_replaced+0 as ptr
[END_MACRO]

[MACRO] MAP_TRY_INSERT %out_inserted, %out_value_ptr, %map_reg, %key, %value
    __map_try_insert_ptr_slot_%out_inserted = stack_alloc 8
    %out_inserted = call @sa_map_try_insert(&%map_reg, &%key, &%value, &__map_try_insert_ptr_slot_%out_inserted)
    %out_value_ptr = load __map_try_insert_ptr_slot_%out_inserted+0 as ptr
[END_MACRO]

[MACRO] MAP_ENTRY_OR_INSERT %out_inserted, %out_value_ptr, %map_reg, %key, %value
    EXPAND MAP_TRY_INSERT %out_inserted, %out_value_ptr, %map_reg, %key, %value
[END_MACRO]

// Rust method-name bare alias for the common entry path (or_insert).
[MACRO] MAP_ENTRY %out_inserted, %out_value_ptr, %map_reg, %key, %value
    EXPAND MAP_ENTRY_OR_INSERT %out_inserted, %out_value_ptr, %map_reg, %key, %value
[END_MACRO]

[MACRO] MAP_OR_INSERT %out_inserted, %out_value_ptr, %map_reg, %key, %value
    EXPAND MAP_ENTRY_OR_INSERT %out_inserted, %out_value_ptr, %map_reg, %key, %value
[END_MACRO]

// Concrete entry-style helpers over try-insert / get-mut-ptr.
// Default inserted value is a null pointer (0). and_modify stores only when present.

[MACRO] MAP_ENTRY_OR_DEFAULT %out_inserted, %out_value_ptr, %map_reg, %key
    __map_entry_default_%out_inserted = add 0, 0
    EXPAND MAP_ENTRY_OR_INSERT %out_inserted, %out_value_ptr, %map_reg, %key, __map_entry_default_%out_inserted
    !__map_entry_default_%out_inserted
[END_MACRO]

[MACRO] MAP_ENTRY_AND_MODIFY %out_ok, %map_reg, %key, %value
    __map_and_mod_ptr_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_map_get_mut_ptr(&%map_reg, &%key, &__map_and_mod_ptr_slot_%out_ok)
    __map_and_mod_ptr_%out_ok = load __map_and_mod_ptr_slot_%out_ok+0 as ptr
    __map_and_mod_has_%out_ok = eq %out_ok, 1
    br __map_and_mod_has_%out_ok -> L_MAP_ENTRY_AND_MODIFY_SET_%out_ok, L_MAP_ENTRY_AND_MODIFY_SKIP_%out_ok
L_MAP_ENTRY_AND_MODIFY_SET_%out_ok:
    store __map_and_mod_ptr_%out_ok+0, %value as ptr
    !__map_and_mod_has_%out_ok
    !__map_and_mod_ptr_%out_ok
    jmp L_MAP_ENTRY_AND_MODIFY_END_%out_ok
L_MAP_ENTRY_AND_MODIFY_SKIP_%out_ok:
    !__map_and_mod_has_%out_ok
    !__map_and_mod_ptr_%out_ok
    jmp L_MAP_ENTRY_AND_MODIFY_END_%out_ok
L_MAP_ENTRY_AND_MODIFY_END_%out_ok:
[END_MACRO]

[MACRO] MAP_KEYS %out_vec, %map_reg
    %out_vec = call @sa_map_keys_vec(&%map_reg)
[END_MACRO]

[MACRO] MAP_VALUES %out_vec, %map_reg
    %out_vec = call @sa_map_values_vec(&%map_reg)
[END_MACRO]

[MACRO] MAP_INTO_KEYS %out_vec, %map_reg
    EXPAND MAP_KEYS %out_vec, %map_reg
    EXPAND MAP_CLEAR %map_reg
[END_MACRO]

[MACRO] MAP_INTO_VALUES %out_vec, %map_reg
    EXPAND MAP_VALUES %out_vec, %map_reg
    EXPAND MAP_CLEAR %map_reg
[END_MACRO]

[MACRO] MAP_VALUES_MUT_PTRS %out_vec, %map_reg
    %out_vec = call @sa_map_value_mut_ptrs_vec(&%map_reg)
[END_MACRO]

[MACRO] MAP_VALUES_MUT %out_vec, %map_reg
    EXPAND MAP_VALUES_MUT_PTRS %out_vec, %map_reg
[END_MACRO]

[MACRO] MAP_ITER %out_vec, %map_reg
    %out_vec = call @sa_map_iter_vec(&%map_reg)
[END_MACRO]

[MACRO] MAP_ITER_MUT_PTRS %out_vec, %map_reg
    %out_vec = call @sa_map_iter_mut_ptrs_vec(&%map_reg)
[END_MACRO]

// Rust method-name alias: HashMap::iter_mut (eager raw value-slot pointer materialization).
[MACRO] MAP_ITER_MUT %out_vec, %map_reg
    EXPAND MAP_ITER_MUT_PTRS %out_vec, %map_reg
[END_MACRO]

[MACRO] MAP_REF_INTO_ITER %out_vec, %map_reg
    EXPAND MAP_ITER %out_vec, %map_reg
[END_MACRO]

[MACRO] MAP_MUT_REF_INTO_ITER %out_vec, %map_reg
    EXPAND MAP_ITER_MUT_PTRS %out_vec, %map_reg
[END_MACRO]

[MACRO] MAP_INTO_ITER %out_vec, %map_reg
    EXPAND MAP_DRAIN %out_vec, %map_reg
[END_MACRO]

[MACRO] MAP_REMOVE_ENTRY %out_ok, %out_key, %out_value, %map_reg, %key
    __map_remove_key_slot_%out_ok = stack_alloc 8
    __map_remove_value_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_map_remove_entry(&%map_reg, &%key, &__map_remove_key_slot_%out_ok, &__map_remove_value_slot_%out_ok)
    %out_key = load __map_remove_key_slot_%out_ok+0 as ptr
    %out_value = load __map_remove_value_slot_%out_ok+0 as ptr
[END_MACRO]

[MACRO] MAP_DEL %out_value, %map_reg, %key
    %out_value = call @sa_map_del(&%map_reg, &%key)
[END_MACRO]

[MACRO] MAP_FREE %map_reg
    call @sa_map_free(^%map_reg)
[END_MACRO]

[MACRO] MAP_LIT1 %out_map, %key1, %value1
    EXPAND MAP_NEW %out_map
    EXPAND MAP_PUT %out_map, %key1, %value1
[END_MACRO]

[MACRO] MAP_LIT2 %out_map, %key1, %value1, %key2, %value2
    EXPAND MAP_NEW %out_map
    EXPAND MAP_PUT %out_map, %key1, %value1
    EXPAND MAP_PUT %out_map, %key2, %value2
[END_MACRO]

[MACRO] MAP_LIT3 %out_map, %key1, %value1, %key2, %value2, %key3, %value3
    EXPAND MAP_NEW %out_map
    EXPAND MAP_PUT %out_map, %key1, %value1
    EXPAND MAP_PUT %out_map, %key2, %value2
    EXPAND MAP_PUT %out_map, %key3, %value3
[END_MACRO]

// Rust Default-style empty map constructor alias.

[MACRO] MAP_DEFAULT %out_map
    EXPAND MAP_NEW %out_map
[END_MACRO]
