    br done -> L_MAP_VALUES_DONE, L_MAP_VALUES_BODY

L_MAP_VALUES_BODY:
    slot_off = mul idx, HashMapSlot_SIZE
    slot = ptr_add slots, slot_off
    state = load slot+HashMapSlot_state as u8
    filled = eq state, HashMap_STATE_FILLED
    br filled -> L_MAP_VALUES_PUSH, L_MAP_VALUES_NEXT

L_MAP_VALUES_PUSH:
    value = load slot+HashMapSlot_value as ptr
    value_bits = bitcast value as u64
    out_vec = call @sa_vec_push(^out_vec, value_bits, 8)
    !value_bits
    !value
    jmp L_MAP_VALUES_NEXT

L_MAP_VALUES_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as u64
    !next_idx
    !filled
    !state
    !slot
    !slot_off
    !done
    !idx
    jmp L_MAP_VALUES_HEAD

L_MAP_VALUES_DONE:
    !done
    !idx
    !cap
    !slots
    !len
    !map
    return out_vec

@export sa_map_value_mut_ptrs_vec(&map: ptr) -> ^ptr:
L_ENTRY:
    len = load map+HashMap_len as u64
