[MACRO] BTREE_SET_IS_SUBSET %out_ok, %set_reg, %other_set
    %out_ok = call @sa_btree_set_is_subset(&%set_reg, &%other_set)
[END_MACRO]

[MACRO] BTREE_SET_IS_SUPERSET %out_ok, %set_reg, %other_set
    %out_ok = call @sa_btree_set_is_superset(&%set_reg, &%other_set)
[END_MACRO]

[MACRO] BTREE_SET_APPEND %set_reg, %other_set
    call @sa_btree_set_append(&%set_reg, &%other_set)
[END_MACRO]

[MACRO] BTREE_SET_SPLIT_OFF %out_set, %set_reg, %key_reg
    %out_set = call @sa_btree_set_split_off(&%set_reg, &%key_reg)
[END_MACRO]

[MACRO] BTREE_SET_RANGE %out_set, %set_reg, %start_key, %end_key
    %out_set = call @sa_btree_set_range(&%set_reg, &%start_key, &%end_key)
[END_MACRO]

[MACRO] BTREE_SET_UNION %out_set, %set_reg, %other_set
    %out_set = call @sa_btree_set_union(&%set_reg, &%other_set)
[END_MACRO]

[MACRO] BTREE_SET_INTERSECTION %out_set, %set_reg, %other_set
    %out_set = call @sa_btree_set_intersection(&%set_reg, &%other_set)
[END_MACRO]

[MACRO] BTREE_SET_DIFFERENCE %out_set, %set_reg, %other_set
    %out_set = call @sa_btree_set_difference(&%set_reg, &%other_set)
[END_MACRO]

[MACRO] BTREE_SET_SYMMETRIC_DIFFERENCE %out_set, %set_reg, %other_set
    %out_set = call @sa_btree_set_symmetric_difference(&%set_reg, &%other_set)
[END_MACRO]

[MACRO] BTREE_SET_BITOR %out_set, %set_reg, %other_set
    EXPAND BTREE_SET_UNION %out_set, %set_reg, %other_set
[END_MACRO]

[MACRO] BTREE_SET_BITAND %out_set, %set_reg, %other_set
    EXPAND BTREE_SET_INTERSECTION %out_set, %set_reg, %other_set
[END_MACRO]

[MACRO] BTREE_SET_SUB %out_set, %set_reg, %other_set
    EXPAND BTREE_SET_DIFFERENCE %out_set, %set_reg, %other_set
[END_MACRO]

[MACRO] BTREE_SET_BITXOR %out_set, %set_reg, %other_set
    EXPAND BTREE_SET_SYMMETRIC_DIFFERENCE %out_set, %set_reg, %other_set
[END_MACRO]

[MACRO] BTREE_SET_ITER %out_vec, %set_reg
    %out_vec = call @sa_btree_set_iter_vec(&%set_reg)
[END_MACRO]

[MACRO] BTREE_SET_REF_INTO_ITER %out_vec, %set_reg
    EXPAND BTREE_SET_ITER %out_vec, %set_reg
[END_MACRO]

[MACRO] BTREE_SET_INTO_ITER %out_vec, %set_reg
    EXPAND BTREE_SET_ITER %out_vec, %set_reg
    EXPAND BTREE_SET_CLEAR %set_reg
[END_MACRO]

[MACRO] BTREE_SET_LIT1 %out_set, %key1
    EXPAND BTREE_SET_NEW %out_set
    EXPAND BTREE_SET_INSERT __btree_set_lit1_ok_1_%out_set, %out_set, %key1
    !__btree_set_lit1_ok_1_%out_set
[END_MACRO]

[MACRO] BTREE_SET_LIT2 %out_set, %key1, %key2
    EXPAND BTREE_SET_NEW %out_set
    EXPAND BTREE_SET_INSERT __btree_set_lit2_ok_1_%out_set, %out_set, %key1
    EXPAND BTREE_SET_INSERT __btree_set_lit2_ok_2_%out_set, %out_set, %key2
    !__btree_set_lit2_ok_1_%out_set
    !__btree_set_lit2_ok_2_%out_set
[END_MACRO]

[MACRO] BTREE_SET_LIT3 %out_set, %key1, %key2, %key3
    EXPAND BTREE_SET_NEW %out_set
    EXPAND BTREE_SET_INSERT __btree_set_lit3_ok_1_%out_set, %out_set, %key1
    EXPAND BTREE_SET_INSERT __btree_set_lit3_ok_2_%out_set, %out_set, %key2
    EXPAND BTREE_SET_INSERT __btree_set_lit3_ok_3_%out_set, %out_set, %key3
    !__btree_set_lit3_ok_1_%out_set
    !__btree_set_lit3_ok_2_%out_set
    !__btree_set_lit3_ok_3_%out_set
[END_MACRO]

// Rust Default-style empty BTreeSet constructor alias.

[MACRO] BTREE_SET_DEFAULT %out_set
    EXPAND BTREE_SET_NEW %out_set
[END_MACRO]
