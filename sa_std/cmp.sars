@import "cmp.sal"
@import "hash.sars"

[MACRO] CMP_ORDERING_IS_LT %out_bool, %ordering
    %out_bool = eq %ordering, CMP_ORDERING_LESS
[END_MACRO]

[MACRO] CMP_ORDERING_IS_EQ %out_bool, %ordering
    %out_bool = eq %ordering, CMP_ORDERING_EQUAL
[END_MACRO]

[MACRO] CMP_ORDERING_IS_GT %out_bool, %ordering
    %out_bool = eq %ordering, CMP_ORDERING_GREATER
[END_MACRO]

[MACRO] CMP_ORDERING_IS_NE %out_bool, %ordering
    __cmp_ordering_is_eq_%out_bool = eq %ordering, CMP_ORDERING_EQUAL
    %out_bool = eq __cmp_ordering_is_eq_%out_bool, 0
    !__cmp_ordering_is_eq_%out_bool
[END_MACRO]

[MACRO] CMP_ORDERING_IS_LE %out_bool, %ordering
    __cmp_ordering_is_lt_%out_bool = eq %ordering, CMP_ORDERING_LESS
    __cmp_ordering_is_eq_%out_bool = eq %ordering, CMP_ORDERING_EQUAL
    %out_bool = or __cmp_ordering_is_lt_%out_bool, __cmp_ordering_is_eq_%out_bool
    !__cmp_ordering_is_eq_%out_bool
    !__cmp_ordering_is_lt_%out_bool
[END_MACRO]

[MACRO] CMP_ORDERING_IS_GE %out_bool, %ordering
    __cmp_ordering_is_gt_%out_bool = eq %ordering, CMP_ORDERING_GREATER
    __cmp_ordering_is_eq_%out_bool = eq %ordering, CMP_ORDERING_EQUAL
    %out_bool = or __cmp_ordering_is_gt_%out_bool, __cmp_ordering_is_eq_%out_bool
    !__cmp_ordering_is_eq_%out_bool
    !__cmp_ordering_is_gt_%out_bool
[END_MACRO]

[MACRO] CMP_ORDERING_THEN %out_ordering, %ordering, %other_ordering
    __cmp_ordering_then_eq_%out_ordering = eq %ordering, CMP_ORDERING_EQUAL
    br __cmp_ordering_then_eq_%out_ordering -> L_CMP_ORDERING_THEN_OTHER_%out_ordering, L_CMP_ORDERING_THEN_SELF_%out_ordering
L_CMP_ORDERING_THEN_OTHER_%out_ordering:
    %out_ordering = add %other_ordering, 0
    !__cmp_ordering_then_eq_%out_ordering
    jmp L_CMP_ORDERING_THEN_DONE_%out_ordering
L_CMP_ORDERING_THEN_SELF_%out_ordering:
    %out_ordering = add %ordering, 0
    !__cmp_ordering_then_eq_%out_ordering
L_CMP_ORDERING_THEN_DONE_%out_ordering:
[END_MACRO]

[MACRO] CMP_ORDERING_THEN_WITH %out_ordering, %ordering, %fn
    __cmp_ordering_then_with_eq_%out_ordering = eq %ordering, CMP_ORDERING_EQUAL
    br __cmp_ordering_then_with_eq_%out_ordering -> L_CMP_ORDERING_THEN_WITH_CALL_%out_ordering, L_CMP_ORDERING_THEN_WITH_SELF_%out_ordering
L_CMP_ORDERING_THEN_WITH_CALL_%out_ordering:
    %out_ordering = call %fn()
    !__cmp_ordering_then_with_eq_%out_ordering
    jmp L_CMP_ORDERING_THEN_WITH_DONE_%out_ordering
L_CMP_ORDERING_THEN_WITH_SELF_%out_ordering:
    %out_ordering = add %ordering, 0
    !__cmp_ordering_then_with_eq_%out_ordering
L_CMP_ORDERING_THEN_WITH_DONE_%out_ordering:
[END_MACRO]

[MACRO] CMP_ORDERING_REVERSE %out_ordering, %ordering
    __cmp_is_less_%out_ordering = eq %ordering, CMP_ORDERING_LESS
    br __cmp_is_less_%out_ordering -> L_CMP_REVERSE_LESS_%out_ordering, L_CMP_REVERSE_CHECK_GREATER_%out_ordering
L_CMP_REVERSE_LESS_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_GREATER
    jmp L_CMP_REVERSE_END_%out_ordering
L_CMP_REVERSE_CHECK_GREATER_%out_ordering:
    __cmp_is_greater_%out_ordering = eq %ordering, CMP_ORDERING_GREATER
    br __cmp_is_greater_%out_ordering -> L_CMP_REVERSE_GREATER_%out_ordering, L_CMP_REVERSE_EQUAL_%out_ordering
L_CMP_REVERSE_GREATER_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_LESS
    !__cmp_is_greater_%out_ordering
    jmp L_CMP_REVERSE_END_%out_ordering
L_CMP_REVERSE_EQUAL_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_EQUAL
    !__cmp_is_greater_%out_ordering
L_CMP_REVERSE_END_%out_ordering:
    !__cmp_is_less_%out_ordering
[END_MACRO]

[MACRO] CMP_COMPARE_U64 %out_ordering, %lhs, %rhs
    __cmp_lt_%out_ordering = ult %lhs, %rhs
    br __cmp_lt_%out_ordering -> L_CMP_COMPARE_U64_LESS_%out_ordering, L_CMP_COMPARE_U64_CHECK_GT_%out_ordering
L_CMP_COMPARE_U64_LESS_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_LESS
    jmp L_CMP_COMPARE_U64_END_%out_ordering
L_CMP_COMPARE_U64_CHECK_GT_%out_ordering:
    __cmp_gt_%out_ordering = ugt %lhs, %rhs
    br __cmp_gt_%out_ordering -> L_CMP_COMPARE_U64_GREATER_%out_ordering, L_CMP_COMPARE_U64_EQUAL_%out_ordering
L_CMP_COMPARE_U64_GREATER_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_GREATER
    !__cmp_gt_%out_ordering
    jmp L_CMP_COMPARE_U64_END_%out_ordering
L_CMP_COMPARE_U64_EQUAL_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_EQUAL
    !__cmp_gt_%out_ordering
L_CMP_COMPARE_U64_END_%out_ordering:
    !__cmp_lt_%out_ordering
[END_MACRO]

// Rust method-name alias over CMP_COMPARE_U64.
[MACRO] CMP_COMPARE %out_ordering, %lhs, %rhs
    EXPAND CMP_COMPARE_U64 %out_ordering, %lhs, %rhs
[END_MACRO]

[MACRO] CMP_COMPARE_I64 %out_ordering, %lhs, %rhs
    __cmp_lt_%out_ordering = slt %lhs, %rhs
    br __cmp_lt_%out_ordering -> L_CMP_COMPARE_I64_LESS_%out_ordering, L_CMP_COMPARE_I64_CHECK_GT_%out_ordering
L_CMP_COMPARE_I64_LESS_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_LESS
    jmp L_CMP_COMPARE_I64_END_%out_ordering
L_CMP_COMPARE_I64_CHECK_GT_%out_ordering:
    __cmp_gt_%out_ordering = sgt %lhs, %rhs
    br __cmp_gt_%out_ordering -> L_CMP_COMPARE_I64_GREATER_%out_ordering, L_CMP_COMPARE_I64_EQUAL_%out_ordering
L_CMP_COMPARE_I64_GREATER_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_GREATER
    !__cmp_gt_%out_ordering
    jmp L_CMP_COMPARE_I64_END_%out_ordering
L_CMP_COMPARE_I64_EQUAL_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_EQUAL
    !__cmp_gt_%out_ordering
L_CMP_COMPARE_I64_END_%out_ordering:
    !__cmp_lt_%out_ordering
[END_MACRO]

[MACRO] CMP_MIN_U64 %out_value, %lhs, %rhs
    __cmp_take_lhs_%out_value = ule %lhs, %rhs
    br __cmp_take_lhs_%out_value -> L_CMP_MIN_U64_LHS_%out_value, L_CMP_MIN_U64_RHS_%out_value
L_CMP_MIN_U64_LHS_%out_value:
    %out_value = add %lhs, 0
    !__cmp_take_lhs_%out_value
    jmp L_CMP_MIN_U64_END_%out_value
L_CMP_MIN_U64_RHS_%out_value:
    %out_value = add %rhs, 0
    !__cmp_take_lhs_%out_value
L_CMP_MIN_U64_END_%out_value:
[END_MACRO]

