    __cmp_min_by_ordering_%out_value = call %compare_fn(%lhs, %rhs)
    __cmp_min_by_take_lhs_%out_value = eq __cmp_min_by_ordering_%out_value, CMP_ORDERING_GREATER
    br __cmp_min_by_take_lhs_%out_value -> L_CMP_MIN_BY_U64_RHS_%out_value, L_CMP_MIN_BY_U64_LHS_%out_value
