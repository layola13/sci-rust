[MACRO] CMP_CLAMP_U64 %out_value, %value, %min_value, %max_value
    __cmp_below_min_%out_value = ult %value, %min_value
    br __cmp_below_min_%out_value -> L_CMP_CLAMP_U64_MIN_%out_value, L_CMP_CLAMP_U64_CHECK_MAX_%out_value
L_CMP_CLAMP_U64_MIN_%out_value:
    %out_value = add %min_value, 0
    jmp L_CMP_CLAMP_U64_END_%out_value
L_CMP_CLAMP_U64_CHECK_MAX_%out_value:
    __cmp_above_max_%out_value = ugt %value, %max_value
    br __cmp_above_max_%out_value -> L_CMP_CLAMP_U64_MAX_%out_value, L_CMP_CLAMP_U64_VALUE_%out_value
L_CMP_CLAMP_U64_MAX_%out_value:
    %out_value = add %max_value, 0
    !__cmp_above_max_%out_value
    jmp L_CMP_CLAMP_U64_END_%out_value
L_CMP_CLAMP_U64_VALUE_%out_value:
    %out_value = add %value, 0
    !__cmp_above_max_%out_value
L_CMP_CLAMP_U64_END_%out_value:
    !__cmp_below_min_%out_value
[END_MACRO]

