// Fixed-capacity VecDeque backed by a circular buffer of raw u64 values.
// This keeps the implementation verifier-friendly and concrete.
@import "core/mem.sars"
@import "core/slice.sal"
@import "core/slice.sars"
@import "alloc/vec.sal"
@import "vec.sars"
@import "num.sars"
@import "vec_deque.sal"
@import "hash.sars"

@export sa_vec_deque_new() -> ^ptr:
L_ENTRY:
    deque = alloc VecDeque_SIZE
    initial_bytes = mul VecDeque_INITIAL_CAP, VecDeque_SLOT_SIZE
    buf = alloc initial_bytes
    call @sa_mem_set(&buf, 0, initial_bytes)
    store deque+VecDeque_buf, buf as ptr
    store deque+VecDeque_cap, VecDeque_INITIAL_CAP as u64
    store deque+VecDeque_head, 0 as u64
    store deque+VecDeque_len, 0 as u64
    ^buf
    !initial_bytes
    return deque

@export sa_vec_deque_with_capacity(capacity: u64) -> ^ptr:
L_ENTRY:
    deque = alloc VecDeque_SIZE
    EXPAND NUM_U64_CHECKED_MUL with_cap_bytes_ok, bytes, capacity, VecDeque_SLOT_SIZE
    br with_cap_bytes_ok -> L_WITH_CAP_BYTES_OK, L_WITH_CAP_OVERFLOW

L_WITH_CAP_OVERFLOW:
    panic(1901)

L_WITH_CAP_BYTES_OK:
    has_bytes = ne bytes, 0
    br has_bytes -> L_WITH_CAP_ALLOC, L_WITH_CAP_EMPTY

L_WITH_CAP_ALLOC:
    buf = alloc bytes
    call @sa_mem_set(&buf, 0, bytes)
    store deque+VecDeque_buf, buf as ptr
    store deque+VecDeque_cap, capacity as u64
    store deque+VecDeque_head, 0 as u64
    store deque+VecDeque_len, 0 as u64
    ^buf
    !with_cap_bytes_ok
    !has_bytes
    !bytes
    !capacity
    return deque

L_WITH_CAP_EMPTY:
    store deque+VecDeque_buf, 0 as ptr
    store deque+VecDeque_cap, 0 as u64
    store deque+VecDeque_head, 0 as u64
    store deque+VecDeque_len, 0 as u64
    !with_cap_bytes_ok
    !has_bytes
    !bytes
    !capacity
    return deque

@export sa_vec_deque_free(^deque: ptr) -> void:
L_ENTRY:
    buf = load deque+VecDeque_buf as ptr
    !buf
    !deque
    return

@export sa_vec_deque_len(&deque: ptr) -> u64:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    !deque
    return len

@export sa_vec_deque_capacity(&deque: ptr) -> u64:
L_ENTRY:
    cap = load deque+VecDeque_cap as u64
    !deque
    return cap

@export sa_vec_deque_is_empty(&deque: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    result = empty as i32
    !len
    !deque
    return result

@vec_deque_next_capacity(needed: u64) -> u64:
L_ENTRY:
    cap_slot = stack_alloc 8
    store cap_slot+0, VecDeque_INITIAL_CAP as u64
    jmp L_NEXT_CAP_HEAD

L_NEXT_CAP_HEAD:
    cap = load cap_slot+0 as u64
    enough = uge cap, needed
    br enough -> L_NEXT_CAP_DONE, L_NEXT_CAP_GROW

L_NEXT_CAP_GROW:
    EXPAND NUM_U64_CHECKED_ADD next_cap_ok, next_cap, cap, cap
    br next_cap_ok -> L_NEXT_CAP_GROW_OK, L_NEXT_CAP_OVERFLOW

L_NEXT_CAP_OVERFLOW:
    panic(1902)

L_NEXT_CAP_GROW_OK:
    store cap_slot+0, next_cap as u64
    !next_cap_ok
    !next_cap
    !enough
    !cap
    jmp L_NEXT_CAP_HEAD

L_NEXT_CAP_DONE:
    !enough
    !needed
    return cap

@vec_deque_realloc(&deque: ptr, target_cap: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    target_zero = eq target_cap, 0
    br target_zero -> L_DEQUE_REALLOC_ZERO, L_DEQUE_REALLOC_ALLOC

L_DEQUE_REALLOC_ZERO:
    old_buf_zero = take deque+VecDeque_buf
    !old_buf_zero
    store deque+VecDeque_buf, 0 as ptr
    store deque+VecDeque_cap, 0 as u64
    store deque+VecDeque_head, 0 as u64
    store deque+VecDeque_len, 0 as u64
    !target_zero
    !len
    !target_cap
    !deque
    return

L_DEQUE_REALLOC_ALLOC:
    old_buf = take deque+VecDeque_buf
    old_cap = load deque+VecDeque_cap as u64
    head = load deque+VecDeque_head as u64
    EXPAND NUM_U64_CHECKED_MUL realloc_bytes_ok, new_bytes, target_cap, VecDeque_SLOT_SIZE
    br realloc_bytes_ok -> L_DEQUE_REALLOC_BYTES_OK, L_DEQUE_REALLOC_OVERFLOW

L_DEQUE_REALLOC_OVERFLOW:
    panic(1903)

L_DEQUE_REALLOC_BYTES_OK:
    new_buf = alloc new_bytes
    call @sa_mem_set(&new_buf, 0, new_bytes)
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as u64
    jmp L_DEQUE_REALLOC_COPY_HEAD

L_DEQUE_REALLOC_COPY_HEAD:
    idx = load idx_slot+0 as u64
    done = eq idx, len
    br done -> L_DEQUE_REALLOC_COPY_DONE, L_DEQUE_REALLOC_COPY_BODY

L_DEQUE_REALLOC_COPY_BODY:
    old_sum = add head, idx
    old_phys = urem old_sum, old_cap
    old_off = mul old_phys, VecDeque_SLOT_SIZE
    old_ptr = ptr_add old_buf, old_off
    new_off = mul idx, VecDeque_SLOT_SIZE
    new_ptr = ptr_add new_buf, new_off
    value = load old_ptr+0 as u64
    store new_ptr+0, value as u64
    next_idx = add idx, 1
    store idx_slot+0, next_idx as u64
    !next_idx
    !value
    !new_ptr
    !new_off
    !old_ptr
    !old_off
    !old_phys
    !old_sum
    !done
    !idx
    jmp L_DEQUE_REALLOC_COPY_HEAD

L_DEQUE_REALLOC_COPY_DONE:
    store deque+VecDeque_buf, new_buf as ptr
    store deque+VecDeque_cap, target_cap as u64
    store deque+VecDeque_head, 0 as u64
    store deque+VecDeque_len, len as u64
    !done
    !idx
    !realloc_bytes_ok
    !new_bytes
    !head
    !old_cap
    !old_buf
    ^new_buf
    !target_zero
    !len
    !target_cap
    !deque
    return

@export sa_vec_deque_reserve(&deque: ptr, additional: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    cap = load deque+VecDeque_cap as u64
    EXPAND NUM_U64_CHECKED_ADD reserve_needed_ok, needed, len, additional
    br reserve_needed_ok -> L_DEQUE_RESERVE_NEEDED_OK, L_DEQUE_RESERVE_OVERFLOW

L_DEQUE_RESERVE_OVERFLOW:
    panic(1904)

L_DEQUE_RESERVE_NEEDED_OK:
    has_room = uge cap, needed
    br has_room -> L_DEQUE_RESERVE_DONE, L_DEQUE_RESERVE_GROW

L_DEQUE_RESERVE_GROW:
    target_cap = call @vec_deque_next_capacity(needed)
    call @vec_deque_realloc(&deque, target_cap)
    !target_cap
    !has_room
    !needed
    !reserve_needed_ok
    !cap
    !len
    !additional
    !deque
    return

L_DEQUE_RESERVE_DONE:
    !has_room
    !needed
    !reserve_needed_ok
    !cap
    !len
    !additional
    !deque
    return

@export sa_vec_deque_reserve_exact(&deque: ptr, additional: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    cap = load deque+VecDeque_cap as u64
    EXPAND NUM_U64_CHECKED_ADD reserve_exact_needed_ok, needed, len, additional
    br reserve_exact_needed_ok -> L_DEQUE_RESERVE_EXACT_NEEDED_OK, L_DEQUE_RESERVE_EXACT_OVERFLOW

L_DEQUE_RESERVE_EXACT_OVERFLOW:
    panic(1905)

L_DEQUE_RESERVE_EXACT_NEEDED_OK:
    has_room = uge cap, needed
    br has_room -> L_DEQUE_RESERVE_EXACT_DONE, L_DEQUE_RESERVE_EXACT_GROW

L_DEQUE_RESERVE_EXACT_GROW:
    call @vec_deque_realloc(&deque, needed)
    !has_room
    !needed
    !reserve_exact_needed_ok
    !cap
    !len
    !additional
    !deque
    return

L_DEQUE_RESERVE_EXACT_DONE:
    !has_room
    !needed
    !reserve_exact_needed_ok
    !cap
    !len
    !additional
    !deque
    return

@export sa_vec_deque_try_reserve(&deque: ptr, additional: u64) -> i32:
L_ENTRY:
    call @sa_vec_deque_reserve(&deque, additional)
    !additional
    !deque
    return 1

@export sa_vec_deque_try_reserve_exact(&deque: ptr, additional: u64) -> i32:
L_ENTRY:
    call @sa_vec_deque_reserve_exact(&deque, additional)
    !additional
    !deque
    return 1

@export sa_vec_deque_shrink_to(&deque: ptr, min_capacity: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    cap = load deque+VecDeque_cap as u64
    keep_len = uge len, min_capacity
    br keep_len -> L_DEQUE_SHRINK_TARGET_LEN, L_DEQUE_SHRINK_TARGET_MIN

L_DEQUE_SHRINK_TARGET_LEN:
    target_cap = add len, 0
    jmp L_DEQUE_SHRINK_CHECK

L_DEQUE_SHRINK_TARGET_MIN:
    target_cap = add min_capacity, 0
    jmp L_DEQUE_SHRINK_CHECK

L_DEQUE_SHRINK_CHECK:
    needs_shrink = ult target_cap, cap
    br needs_shrink -> L_DEQUE_SHRINK_RUN, L_DEQUE_SHRINK_DONE

L_DEQUE_SHRINK_RUN:
    call @vec_deque_realloc(&deque, target_cap)
    !needs_shrink
    !target_cap
    !keep_len
    !cap
    !len
    !min_capacity
    !deque
    return

L_DEQUE_SHRINK_DONE:
    !needs_shrink
    !target_cap
    !keep_len
    !cap
    !len
    !min_capacity
    !deque
    return

@export sa_vec_deque_shrink_to_fit(&deque: ptr) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    call @sa_vec_deque_shrink_to(&deque, len)
    !len
    !deque
    return

@export sa_vec_deque_try_shrink_to(&deque: ptr, min_capacity: u64) -> i32:
L_ENTRY:
    call @sa_vec_deque_shrink_to(&deque, min_capacity)
    !min_capacity
    !deque
    return 1

@export sa_vec_deque_try_shrink_to_fit(&deque: ptr) -> i32:
L_ENTRY:
    call @sa_vec_deque_shrink_to_fit(&deque)
    !deque
    return 1

@vec_deque_force_contiguous(&deque: ptr) -> void:
L_ENTRY:
    head = load deque+VecDeque_head as u64
    already_front = eq head, 0
    br already_front -> L_FORCE_DONE, L_FORCE_RUN

L_FORCE_RUN:
    cap = load deque+VecDeque_cap as u64
    call @vec_deque_realloc(&deque, cap)
    !cap
    !already_front
    !head
    !deque
    return

L_FORCE_DONE:
    !already_front
    !head
    !deque
    return

@export sa_vec_deque_as_slices(&deque: ptr, &out_front_slice: ptr, &out_back_slice: ptr) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_AS_SLICES_EMPTY, L_AS_SLICES_NONEMPTY

L_AS_SLICES_EMPTY:
    store out_front_slice+Slice_ptr, 0 as ptr
    store out_front_slice+Slice_len, 0 as u64
    store out_back_slice+Slice_ptr, 0 as ptr
    store out_back_slice+Slice_len, 0 as u64
    !empty
    !len
    !out_back_slice
    !out_front_slice
    !deque
    return

L_AS_SLICES_NONEMPTY:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    head_off = mul head, VecDeque_SLOT_SIZE
    front_ptr = ptr_add buf, head_off
    front_room = sub cap, head
    one_slice = ule len, front_room
    br one_slice -> L_AS_SLICES_ONE, L_AS_SLICES_TWO

L_AS_SLICES_ONE:
    store out_front_slice+Slice_ptr, front_ptr as ptr
    store out_front_slice+Slice_len, len as u64
    store out_back_slice+Slice_ptr, 0 as ptr
    store out_back_slice+Slice_len, 0 as u64
    !one_slice
    !front_room
    !front_ptr
    !head_off
    !cap
    !head
    !buf
    !empty
    !len
    !out_back_slice
    !out_front_slice
    !deque
    return

L_AS_SLICES_TWO:
    back_len = sub len, front_room
    store out_front_slice+Slice_ptr, front_ptr as ptr
    store out_front_slice+Slice_len, front_room as u64
    store out_back_slice+Slice_ptr, buf as ptr
    store out_back_slice+Slice_len, back_len as u64
    !back_len
    !one_slice
    !front_room
    !front_ptr
    !head_off
    !cap
    !head
    !buf
    !empty
    !len
    !out_back_slice
    !out_front_slice
    !deque
    return

@export sa_vec_deque_as_mut_slices(&deque: ptr, &out_front_slice: ptr, &out_back_slice: ptr) -> void:
L_ENTRY:
    call @sa_vec_deque_as_slices(&deque, &out_front_slice, &out_back_slice)
    !out_back_slice
    !out_front_slice
    !deque
    return

@export sa_vec_deque_make_contiguous(&deque: ptr, &out_slice: ptr) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_MAKE_CONTIG_EMPTY, L_MAKE_CONTIG_CHECK

L_MAKE_CONTIG_EMPTY:
    store out_slice+Slice_ptr, 0 as ptr
    store out_slice+Slice_len, 0 as u64
    !empty
    !len
    !out_slice
    !deque
    return

L_MAKE_CONTIG_CHECK:
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    front_room = sub cap, head
    wrapped = ugt len, front_room
    br wrapped -> L_MAKE_CONTIG_REALLOC, L_MAKE_CONTIG_VIEW

L_MAKE_CONTIG_REALLOC:
    call @vec_deque_realloc(&deque, cap)
    new_buf = load deque+VecDeque_buf as ptr
    store out_slice+Slice_ptr, new_buf as ptr
    store out_slice+Slice_len, len as u64
    !new_buf
    !wrapped
    !front_room
    !cap
    !head
    !empty
    !len
    !out_slice
    !deque
    return

L_MAKE_CONTIG_VIEW:
    buf = load deque+VecDeque_buf as ptr
    head_off = mul head, VecDeque_SLOT_SIZE
    data_ptr = ptr_add buf, head_off
    store out_slice+Slice_ptr, data_ptr as ptr
    store out_slice+Slice_len, len as u64
    !data_ptr
    !head_off
    !buf
    !wrapped
    !front_room
    !cap
    !head
    !empty
    !len
    !out_slice
    !deque
    return

@export sa_vec_deque_get(&deque: ptr, index: u64) -> u64:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_range = ult index, len
    br in_range -> L_GET_HIT, L_GET_MISS
L_GET_HIT:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    head_plus = add head, index
    phys_index = urem head_plus, cap
    off = mul phys_index, VecDeque_SLOT_SIZE
    slot = ptr_add buf, off
    value = load slot+0 as u64
    !slot
    !off
    !head_plus
    !phys_index
    !buf
    !head
    !cap
    !index
    !len
    !in_range
    !deque
    return value
L_GET_MISS:
    !index
    !len
    !in_range
    !deque
    return 0

@export sa_vec_deque_try_get(&deque: ptr, index: u64, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_range = ult index, len
    br in_range -> L_TRY_GET_HIT, L_TRY_GET_MISS

L_TRY_GET_HIT:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    head_plus = add head, index
    phys_index = urem head_plus, cap
    off = mul phys_index, VecDeque_SLOT_SIZE
    slot = ptr_add buf, off
    value = load slot+0 as u64
    store out_value_slot+0, value as u64
    !value
    !slot
    !off
    !phys_index
    !head_plus
    !cap
    !head
    !buf
    !in_range
    !len
    !index
    !out_value_slot
    !deque
    return 1

L_TRY_GET_MISS:
    store out_value_slot+0, 0 as u64
    !in_range
    !len
    !index
    !out_value_slot
    !deque
    return 0

@export sa_vec_deque_try_get_mut_ptr(&deque: ptr, index: u64, &out_ptr_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_range = ult index, len
    br in_range -> L_GET_MUT_HIT, L_GET_MUT_MISS

L_GET_MUT_HIT:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    head_plus = add head, index
    phys_index = urem head_plus, cap
    off = mul phys_index, VecDeque_SLOT_SIZE
    slot = ptr_add buf, off
    store out_ptr_slot+0, slot as ptr
    !slot
    !off
    !phys_index
    !head_plus
    !cap
    !head
    !buf
    !in_range
    !len
    !index
    !out_ptr_slot
    !deque
    return 1

L_GET_MUT_MISS:
    store out_ptr_slot+0, 0 as ptr
    !in_range
    !len
    !index
    !out_ptr_slot
    !deque
    return 0

@export sa_vec_deque_try_front_mut_ptr(&deque: ptr, &out_ptr_slot: ptr) -> i32:
L_ENTRY:
    ok = call @sa_vec_deque_try_get_mut_ptr(&deque, 0, &out_ptr_slot)
    !out_ptr_slot
    !deque
    return ok

@export sa_vec_deque_try_back_mut_ptr(&deque: ptr, &out_ptr_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_BACK_MUT_EMPTY, L_BACK_MUT_READY

L_BACK_MUT_READY:
    last = sub len, 1
    ok = call @sa_vec_deque_try_get_mut_ptr(&deque, last, &out_ptr_slot)
    !last
    !empty
    !len
    !out_ptr_slot
    !deque
    return ok

L_BACK_MUT_EMPTY:
    store out_ptr_slot+0, 0 as ptr
    !empty
    !len
    !out_ptr_slot
    !deque
    return 0

@export sa_vec_deque_set(&deque: ptr, index: u64, value: u64) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_range = ult index, len
    br in_range -> L_SET_HIT, L_SET_MISS

L_SET_HIT:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    head_plus = add head, index
    phys_index = urem head_plus, cap
    off = mul phys_index, VecDeque_SLOT_SIZE
    slot = ptr_add buf, off
    store slot+0, value as u64
    !slot
    !off
    !phys_index
    !head_plus
    !cap
    !head
    !buf
    !in_range
    !len
    !value
    !index
    !deque
    return 1

L_SET_MISS:
    !in_range
    !len
    !value
    !index
    !deque
    return 0

@export sa_vec_deque_contains(&deque: ptr, needle: u64) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as u64
    jmp L_CONTAINS_HEAD

L_CONTAINS_HEAD:
    idx = load idx_slot+0 as u64
    done = eq idx, len
    br done -> L_CONTAINS_MISS, L_CONTAINS_BODY

L_CONTAINS_BODY:
    head_plus = add head, idx
    phys_index = urem head_plus, cap
    off = mul phys_index, VecDeque_SLOT_SIZE
    slot = ptr_add buf, off
    value = load slot+0 as u64
    matched = eq value, needle
    br matched -> L_CONTAINS_HIT, L_CONTAINS_NEXT

L_CONTAINS_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as u64
    !next_idx
    !matched
    !value
    !slot
    !off
    !phys_index
    !head_plus
    !done
    !idx
    jmp L_CONTAINS_HEAD

L_CONTAINS_HIT:
    !matched
    !value
    !slot
    !off
    !phys_index
    !head_plus
    !done
    !idx
    !cap
    !head
    !buf
    !len
    !needle
    !deque
    return 1

L_CONTAINS_MISS:
    !done
    !idx
    !cap
    !head
    !buf
    !len
    !needle
    !deque
    return 0

@export sa_vec_deque_swap(&deque: ptr, left: u64, right: u64) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    left_ok = ult left, len
    right_ok = ult right, len
    both_ok = and left_ok, right_ok
    br both_ok -> L_SWAP_READY, L_SWAP_MISS

L_SWAP_READY:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    left_sum = add head, left
    left_phys = urem left_sum, cap
    left_off = mul left_phys, VecDeque_SLOT_SIZE
    left_ptr = ptr_add buf, left_off
    right_sum = add head, right
    right_phys = urem right_sum, cap
    right_off = mul right_phys, VecDeque_SLOT_SIZE
    right_ptr = ptr_add buf, right_off
    left_value = load left_ptr+0 as u64
    right_value = load right_ptr+0 as u64
    store left_ptr+0, right_value as u64
    store right_ptr+0, left_value as u64
    !right_value
    !left_value
    !right_ptr
    !right_off
    !right_phys
    !right_sum
    !left_ptr
    !left_off
    !left_phys
    !left_sum
    !cap
    !head
    !buf
    !both_ok
    !right_ok
    !left_ok
    !len
    !right
    !left
    !deque
    return 1

L_SWAP_MISS:
    !both_ok
    !right_ok
    !left_ok
    !len
    !right
    !left
    !deque
    return 0

@export sa_vec_deque_try_insert(&deque: ptr, index: u64, value: u64) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_bounds = ule index, len
    br in_bounds -> L_INSERT_READY, L_INSERT_MISS

L_INSERT_READY:
    call @sa_vec_deque_reserve(&deque, 1)
    call @vec_deque_force_contiguous(&deque)
    buf = load deque+VecDeque_buf as ptr
    idx_slot = stack_alloc 8
    store idx_slot+0, len as u64
    jmp L_INSERT_SHIFT_HEAD

L_INSERT_SHIFT_HEAD:
    idx = load idx_slot+0 as u64
    done = ule idx, index
    br done -> L_INSERT_STORE, L_INSERT_SHIFT_BODY

L_INSERT_SHIFT_BODY:
    src_idx = sub idx, 1
    src_off = mul src_idx, VecDeque_SLOT_SIZE
    src_ptr = ptr_add buf, src_off
    dst_off = mul idx, VecDeque_SLOT_SIZE
    dst_ptr = ptr_add buf, dst_off
    shifted = load src_ptr+0 as u64
    store dst_ptr+0, shifted as u64
    store idx_slot+0, src_idx as u64
    !shifted
    !dst_ptr
    !dst_off
    !src_ptr
    !src_off
    !src_idx
    !done
    !idx
    jmp L_INSERT_SHIFT_HEAD

L_INSERT_STORE:
    insert_off = mul index, VecDeque_SLOT_SIZE
    insert_ptr = ptr_add buf, insert_off
    store insert_ptr+0, value as u64
    next_len = add len, 1
    store deque+VecDeque_len, next_len as u64
    store deque+VecDeque_head, 0 as u64
    !next_len
    !insert_ptr
    !insert_off
    !done
    !idx
    !buf
    !in_bounds
    !len
    !value
    !index
    !deque
    return 1

L_INSERT_MISS:
    !in_bounds
    !len
    !value
    !index
    !deque
    return 0

@export sa_vec_deque_try_remove(&deque: ptr, index: u64, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_bounds = ult index, len
    br in_bounds -> L_REMOVE_READY, L_REMOVE_MISS

L_REMOVE_READY:
    call @vec_deque_force_contiguous(&deque)
    buf = load deque+VecDeque_buf as ptr
    remove_off = mul index, VecDeque_SLOT_SIZE
    remove_ptr = ptr_add buf, remove_off
    removed = load remove_ptr+0 as u64
    last_index = sub len, 1
    idx_slot = stack_alloc 8
    store idx_slot+0, index as u64
    jmp L_REMOVE_SHIFT_HEAD

L_REMOVE_SHIFT_HEAD:
    idx = load idx_slot+0 as u64
    done = uge idx, last_index
    br done -> L_REMOVE_STORE, L_REMOVE_SHIFT_BODY

L_REMOVE_SHIFT_BODY:
    src_idx = add idx, 1
    src_off = mul src_idx, VecDeque_SLOT_SIZE
    src_ptr = ptr_add buf, src_off
    dst_off = mul idx, VecDeque_SLOT_SIZE
    dst_ptr = ptr_add buf, dst_off
    shifted = load src_ptr+0 as u64
    store dst_ptr+0, shifted as u64
    store idx_slot+0, src_idx as u64
    !shifted
    !dst_ptr
    !dst_off
    !src_ptr
    !src_off
    !src_idx
    !done
    !idx
    jmp L_REMOVE_SHIFT_HEAD

L_REMOVE_STORE:
    next_len = sub len, 1
    store deque+VecDeque_len, next_len as u64
    store deque+VecDeque_head, 0 as u64
    store out_value_slot+0, removed as u64
    !next_len
    !done
    !idx
    !last_index
    !removed
    !remove_ptr
    !remove_off
    !buf
    !in_bounds
    !len
    !index
    !out_value_slot
    !deque
    return 1

L_REMOVE_MISS:
    store out_value_slot+0, 0 as u64
    !in_bounds
    !len
    !index
    !out_value_slot
    !deque
    return 0

@export sa_vec_deque_try_swap_remove_front(&deque: ptr, index: u64, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_bounds = ult index, len
    br in_bounds -> L_SWAP_REMOVE_FRONT_READY, L_SWAP_REMOVE_FRONT_MISS

L_SWAP_REMOVE_FRONT_READY:
    removed = call @sa_vec_deque_get(&deque, index)
    front_value = call @sa_vec_deque_front(&deque)
    ptr_slot = stack_alloc 8
    ptr_ok = call @sa_vec_deque_try_get_mut_ptr(&deque, index, &ptr_slot)
    slot = load ptr_slot+0 as ptr
    store slot+0, front_value as u64
    pop_slot = stack_alloc 8
    pop_ok = call @sa_vec_deque_try_pop_front(&deque, &pop_slot)
    store out_value_slot+0, removed as u64
    !pop_ok
    !slot
    !ptr_ok
    !front_value
    !removed
    !in_bounds
    !len
    !index
    !out_value_slot
    !deque
    return 1

L_SWAP_REMOVE_FRONT_MISS:
    store out_value_slot+0, 0 as u64
    !in_bounds
    !len
    !index
    !out_value_slot
    !deque
    return 0

@export sa_vec_deque_try_swap_remove_back(&deque: ptr, index: u64, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_bounds = ult index, len
    br in_bounds -> L_SWAP_REMOVE_BACK_READY, L_SWAP_REMOVE_BACK_MISS

L_SWAP_REMOVE_BACK_READY:
    removed = call @sa_vec_deque_get(&deque, index)
    back_value = call @sa_vec_deque_back(&deque)
    ptr_slot = stack_alloc 8
    ptr_ok = call @sa_vec_deque_try_get_mut_ptr(&deque, index, &ptr_slot)
    slot = load ptr_slot+0 as ptr
    store slot+0, back_value as u64
    pop_slot = stack_alloc 8
    pop_ok = call @sa_vec_deque_try_pop_back(&deque, &pop_slot)
    store out_value_slot+0, removed as u64
    !pop_ok
    !slot
    !ptr_ok
    !back_value
    !removed
    !in_bounds
    !len
    !index
    !out_value_slot
    !deque
    return 1

L_SWAP_REMOVE_BACK_MISS:
    store out_value_slot+0, 0 as u64
    !in_bounds
    !len
    !index
    !out_value_slot
    !deque
    return 0

@export sa_vec_deque_push_back(&deque: ptr, value: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    cap = load deque+VecDeque_cap as u64
    room = ult len, cap
    br room -> L_PUSH_BACK_OK, L_PUSH_BACK_FULL
L_PUSH_BACK_OK:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    tail_sum = add head, len
    tail_index = urem tail_sum, cap
    tail_off = mul tail_index, VecDeque_SLOT_SIZE
    tail_ptr = ptr_add buf, tail_off
    store tail_ptr+0, value as u64
    next_len = add len, 1
    store deque+VecDeque_len, next_len as u64
    !tail_ptr
    !tail_off
    !tail_index
    !tail_sum
    !next_len
    !room
    !buf
    !head
    !cap
    !len
    !value
    !deque
    return
L_PUSH_BACK_FULL:
    call @sa_vec_deque_reserve(&deque, 1)
    !room
    !cap
    !len
    jmp L_ENTRY

@export sa_vec_deque_push_front(&deque: ptr, value: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    cap = load deque+VecDeque_cap as u64
    room = ult len, cap
    br room -> L_PUSH_FRONT_OK, L_PUSH_FRONT_FULL
L_PUSH_FRONT_OK:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap_minus_one = sub cap, 1
    head_plus = add head, cap_minus_one
    new_head = urem head_plus, cap
    head_off = mul new_head, VecDeque_SLOT_SIZE
    head_ptr = ptr_add buf, head_off
    store head_ptr+0, value as u64
    next_len = add len, 1
    store deque+VecDeque_head, new_head as u64
    store deque+VecDeque_len, next_len as u64
    !head_ptr
    !head_off
    !new_head
    !cap_minus_one
    !head_plus
    !room
    !buf
    !head
    !cap
    !next_len
    !len
    !value
    !deque
    return
L_PUSH_FRONT_FULL:
    call @sa_vec_deque_reserve(&deque, 1)
    !room
    !cap
    !len
    jmp L_ENTRY

@export sa_vec_deque_try_pop_front(&deque: ptr, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_POP_FRONT_EMPTY, L_POP_FRONT_READY
L_POP_FRONT_READY:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    head_off = mul head, VecDeque_SLOT_SIZE
    head_ptr = ptr_add buf, head_off
    value = load head_ptr+0 as u64
    next_head = add head, 1
    next_head2 = urem next_head, cap
L_POP_FRONT_STORE:
    next_len = sub len, 1
    store out_value_slot+0, value as u64
    store deque+VecDeque_len, next_len as u64
    store deque+VecDeque_head, next_head2 as u64
    !next_head2
    !next_head
    !next_len
    !value
    !head_ptr
    !head_off
    !head
    !cap
    !buf
    !len
    !out_value_slot
    !deque
    return 1
L_POP_FRONT_EMPTY:
    store out_value_slot+0, 0 as u64
    !empty
    !len
    !out_value_slot
    !deque
    return 0

@export sa_vec_deque_try_pop_back(&deque: ptr, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_POP_BACK_EMPTY, L_POP_BACK_READY
L_POP_BACK_READY:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    last_index = sub len, 1
    tail_sum = add head, last_index
    tail_index = urem tail_sum, cap
    tail_off = mul tail_index, VecDeque_SLOT_SIZE
    tail_ptr = ptr_add buf, tail_off
    value = load tail_ptr+0 as u64
    next_len = sub len, 1
L_POP_BACK_STORE:
    store out_value_slot+0, value as u64
    store deque+VecDeque_len, next_len as u64
    store deque+VecDeque_head, head as u64
    !tail_sum
    !tail_index
    !tail_ptr
    !tail_off
    !last_index
    !next_len
    !value
    !head
    !cap
    !buf
    !len
    !out_value_slot
    !deque
    return 1
L_POP_BACK_EMPTY:
    store out_value_slot+0, 0 as u64
    !empty
    !len
    !out_value_slot
    !deque
    return 0

@export sa_vec_deque_front(&deque: ptr) -> u64:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_FRONT_EMPTY, L_FRONT_READY
L_FRONT_READY:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    head_off = mul head, VecDeque_SLOT_SIZE
    head_ptr = ptr_add buf, head_off
    value = load head_ptr+0 as u64
    !head_ptr
    !head_off
    !head
    !buf
    !empty
    !len
    !deque
    return value
L_FRONT_EMPTY:
    !empty
    !len
    !deque
    return 0

@export sa_vec_deque_back(&deque: ptr) -> u64:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_BACK_EMPTY, L_BACK_READY
L_BACK_READY:
    buf = load deque+VecDeque_buf as ptr
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    last_index = sub len, 1
    tail_sum = add head, last_index
    tail_index = urem tail_sum, cap
    tail_off = mul tail_index, VecDeque_SLOT_SIZE
    tail_ptr = ptr_add buf, tail_off
    value = load tail_ptr+0 as u64
    !tail_ptr
    !tail_off
    !tail_index
    !tail_sum
    !last_index
    !cap
    !head
    !buf
    !empty
    !len
    !deque
    return value
L_BACK_EMPTY:
    !empty
    !len
    !deque
    return 0

@export sa_vec_deque_try_front(&deque: ptr, &out_value_slot: ptr) -> i32:
L_ENTRY:
    ok = call @sa_vec_deque_try_get(&deque, 0, &out_value_slot)
    !out_value_slot
    !deque
    return ok

@export sa_vec_deque_try_back(&deque: ptr, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    empty = eq len, 0
    br empty -> L_TRY_BACK_EMPTY, L_TRY_BACK_READY

L_TRY_BACK_READY:
    last = sub len, 1
    ok = call @sa_vec_deque_try_get(&deque, last, &out_value_slot)
    !last
    !empty
    !len
    !out_value_slot
    !deque
    return ok

L_TRY_BACK_EMPTY:
    store out_value_slot+0, 0 as u64
    !empty
    !len
    !out_value_slot
    !deque
    return 0

@export sa_vec_deque_clear(&deque: ptr) -> void:
L_ENTRY:
    buf = load deque+VecDeque_buf as ptr
    cap = load deque+VecDeque_cap as u64
    EXPAND NUM_U64_CHECKED_MUL clear_bytes_ok, bytes, cap, VecDeque_SLOT_SIZE
    br clear_bytes_ok -> L_CLEAR_BYTES_OK, L_CLEAR_BYTES_OVERFLOW

L_CLEAR_BYTES_OVERFLOW:
    panic(1906)

L_CLEAR_BYTES_OK:
    has_buf = ne buf, 0
    br has_buf -> L_CLEAR_BUF, L_CLEAR_SKIP
L_CLEAR_BUF:
    call @sa_mem_set(&buf, 0, bytes)
    !bytes
    !clear_bytes_ok
    store deque+VecDeque_head, 0 as u64
    store deque+VecDeque_len, 0 as u64
    !has_buf
    !buf
    !cap
    !deque
    return
L_CLEAR_SKIP:
    !bytes
    !clear_bytes_ok
    store deque+VecDeque_head, 0 as u64
    store deque+VecDeque_len, 0 as u64
    !has_buf
    !buf
    !cap
    !deque
    return

@export sa_vec_deque_rotate_left(&deque: ptr, count: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    short = ule len, 1
    br short -> L_ROTATE_LEFT_DONE_SHORT, L_ROTATE_LEFT_RUN
L_ROTATE_LEFT_RUN:
    shift = urem count, len
    no_move = eq shift, 0
    br no_move -> L_ROTATE_LEFT_DONE_RUN, L_ROTATE_LEFT_BODY
L_ROTATE_LEFT_BODY:
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    next_sum = add head, shift
    next_head = urem next_sum, cap
    store deque+VecDeque_head, next_head as u64
    !next_sum
    !next_head
    !shift
    !cap
    !head
    !no_move
    !short
    !len
    !count
    !deque
    return
L_ROTATE_LEFT_DONE_SHORT:
    !short
    !len
    !count
    !deque
    return
L_ROTATE_LEFT_DONE_RUN:
    !no_move
    !shift
    !short
    !len
    !count
    !deque
    return

@export sa_vec_deque_rotate_right(&deque: ptr, count: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    short = ule len, 1
    br short -> L_ROTATE_RIGHT_DONE_SHORT, L_ROTATE_RIGHT_RUN
L_ROTATE_RIGHT_RUN:
    shift = urem count, len
    back_shift = sub len, shift
    no_move = eq shift, 0
    br no_move -> L_ROTATE_RIGHT_DONE_RUN, L_ROTATE_RIGHT_BODY
L_ROTATE_RIGHT_BODY:
    head = load deque+VecDeque_head as u64
    cap = load deque+VecDeque_cap as u64
    next_sum = add head, back_shift
    next_head = urem next_sum, cap
    store deque+VecDeque_head, next_head as u64
    !next_sum
    !next_head
    !back_shift
    !shift
    !cap
    !head
    !no_move
    !short
    !len
    !count
    !deque
    return
L_ROTATE_RIGHT_DONE_SHORT:
    !short
    !len
    !count
    !deque
    return
L_ROTATE_RIGHT_DONE_RUN:
    !no_move
    !back_shift
    !shift
    !short
    !len
    !count
    !deque
    return

@export sa_vec_deque_truncate(&deque: ptr, new_len: u64) -> void:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    should_shrink = ult new_len, len
    br should_shrink -> L_TRUNCATE_RUN, L_TRUNCATE_DONE

L_TRUNCATE_RUN:
    store deque+VecDeque_len, new_len as u64
    !should_shrink
    !len
    !new_len
    !deque
    return

L_TRUNCATE_DONE:
    !should_shrink
    !len
    !new_len
    !deque
    return

// Rust VecDeque::truncate_front: keep only the last `new_len` elements.
@export sa_vec_deque_truncate_front(&deque: ptr, new_len: u64) -> void:
L_ENTRY:
    target_slot = stack_alloc 8
    pop_slot = stack_alloc 8
    store target_slot+0, new_len as u64
    jmp L_TRUNCATE_FRONT_HEAD

L_TRUNCATE_FRONT_HEAD:
    len = load deque+VecDeque_len as u64
    target = load target_slot+0 as u64
    done = ule len, target
    br done -> L_TRUNCATE_FRONT_DONE, L_TRUNCATE_FRONT_BODY

L_TRUNCATE_FRONT_BODY:
    pop_ok = call @sa_vec_deque_try_pop_front(&deque, &pop_slot)
    !pop_ok
    !done
    !target
    !len
    jmp L_TRUNCATE_FRONT_HEAD

L_TRUNCATE_FRONT_DONE:
    !done
    !target
    !len
    !new_len
    !deque
    return

@export sa_vec_deque_try_split_off(&deque: ptr, index: u64, &out_deque_slot: ptr) -> i32:
L_ENTRY:
    len = load deque+VecDeque_len as u64
    in_bounds = ule index, len
    br in_bounds -> L_SPLIT_READY, L_SPLIT_MISS

L_SPLIT_READY:
    tail_len = sub len, index
    out_deque = call @sa_vec_deque_with_capacity(tail_len)
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as u64
    jmp L_SPLIT_COPY_HEAD

L_SPLIT_COPY_HEAD:
    idx = load idx_slot+0 as u64
    done = eq idx, tail_len
    br done -> L_SPLIT_STORE, L_SPLIT_COPY_BODY

L_SPLIT_COPY_BODY:
    src_index = add index, idx
    value = call @sa_vec_deque_get(&deque, src_index)
    call @sa_vec_deque_push_back(&out_deque, value)
    next_idx = add idx, 1
    store idx_slot+0, next_idx as u64
    !next_idx
    !value
    !src_index
    !done
    !idx
    jmp L_SPLIT_COPY_HEAD

L_SPLIT_STORE:
    store deque+VecDeque_len, index as u64
    store out_deque_slot+0, out_deque as ptr
    !out_deque
    !done
    !idx
    !tail_len
    !in_bounds
    !len
    !index
    !out_deque_slot
    !deque
    return 1

L_SPLIT_MISS:
    store out_deque_slot+0, 0 as ptr
    !in_bounds
    !len
    !index
    !out_deque_slot
    !deque
    return 0

@export sa_vec_deque_append(&deque: ptr, &other: ptr) -> void:
L_ENTRY:
    other_len = load other+VecDeque_len as u64
    call @sa_vec_deque_reserve(&deque, other_len)
    value_slot = stack_alloc 8
    !other_len
    jmp L_APPEND_LOOP

L_APPEND_LOOP:
    ok = call @sa_vec_deque_try_pop_front(&other, &value_slot)
    br ok -> L_APPEND_PUSH, L_APPEND_DONE

L_APPEND_PUSH:
    value = load value_slot+0 as u64
    call @sa_vec_deque_push_back(&deque, value)
    !value
    !ok
    jmp L_APPEND_LOOP

L_APPEND_DONE:
    !ok
    !other
    !deque
    return

[MACRO] VEC_DEQUE_NEW %out_deque
    %out_deque = call @sa_vec_deque_new()
[END_MACRO]

[MACRO] VEC_DEQUE_WITH_CAPACITY %out_deque, %capacity
    %out_deque = call @sa_vec_deque_with_capacity(%capacity)
[END_MACRO]

[MACRO] VEC_DEQUE_TRY_WITH_CAPACITY %out_ok, %out_deque, %capacity
    EXPAND VEC_DEQUE_WITH_CAPACITY %out_deque, %capacity
    %out_ok = ne %out_deque, 0
[END_MACRO]

[MACRO] VEC_DEQUE_FREE %deque_reg
    call @sa_vec_deque_free(^%deque_reg)
[END_MACRO]

[MACRO] VEC_DEQUE_LEN %out_len, %deque_reg
    %out_len = call @sa_vec_deque_len(&%deque_reg)
[END_MACRO]

[MACRO] VEC_DEQUE_CAPACITY %out_cap, %deque_reg
    %out_cap = call @sa_vec_deque_capacity(&%deque_reg)
[END_MACRO]

[MACRO] VEC_DEQUE_IS_EMPTY %out_flag, %deque_reg
    %out_flag = call @sa_vec_deque_is_empty(&%deque_reg)
[END_MACRO]
[MACRO] VEC_DEQUE_EXTRA_CAPACITY %out_extra, %deque_reg
    __vec_deque_ec_cap_%out_extra = call @sa_vec_deque_capacity(&%deque_reg)
    __vec_deque_ec_len_%out_extra = call @sa_vec_deque_len(&%deque_reg)
    %out_extra = sub __vec_deque_ec_cap_%out_extra, __vec_deque_ec_len_%out_extra
    !__vec_deque_ec_len_%out_extra
    !__vec_deque_ec_cap_%out_extra
[END_MACRO]


[MACRO] VEC_DEQUE_GET %out_value, %deque_reg, %index
    %out_value = call @sa_vec_deque_get(&%deque_reg, %index)
[END_MACRO]

[MACRO] VEC_DEQUE_TRY_GET %out_ok, %out_value, %deque_reg, %index
    __vec_deque_get_slot_%out_ok = stack_alloc 8
    __vec_deque_get_ok_%out_ok = call @sa_vec_deque_try_get(&%deque_reg, %index, &__vec_deque_get_slot_%out_ok)
