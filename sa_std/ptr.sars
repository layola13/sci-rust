@import "core/mem.sars"
@import "ptr.sal"

[MACRO] PTR_NULL %out_ptr
    %out_ptr = 0 as ptr
[END_MACRO]

[MACRO] PTR_IS_NULL %out_bool, %ptr_reg
    __ptr_null_%out_bool = 0 as ptr
    %out_bool = eq %ptr_reg, __ptr_null_%out_bool
    !__ptr_null_%out_bool
[END_MACRO]

[MACRO] PTR_IS_NONNULL %out_bool, %ptr_reg
    __ptr_null_%out_bool = 0 as ptr
    %out_bool = ne %ptr_reg, __ptr_null_%out_bool
    !__ptr_null_%out_bool
[END_MACRO]

[MACRO] PTR_EQ %out_bool, %lhs_ptr, %rhs_ptr
    %out_bool = eq %lhs_ptr, %rhs_ptr
[END_MACRO]

[MACRO] PTR_NE %out_bool, %lhs_ptr, %rhs_ptr
    %out_bool = ne %lhs_ptr, %rhs_ptr
[END_MACRO]

[MACRO] PTR_ADDR %out_addr, %ptr_reg
    %out_addr = bitcast %ptr_reg as u64
[END_MACRO]

[MACRO] PTR_EXPOSE_ADDR %out_addr, %ptr_reg
    EXPAND PTR_ADDR %out_addr, %ptr_reg
[END_MACRO]

[MACRO] PTR_EXPOSE_PROVENANCE %out_addr, %ptr_reg
    EXPAND PTR_ADDR %out_addr, %ptr_reg
[END_MACRO]

[MACRO] PTR_CAST %out_ptr, %ptr_reg
    %out_ptr = ptr_add %ptr_reg, 0
[END_MACRO]

[MACRO] PTR_CAST_CONST %out_ptr, %ptr_reg
    %out_ptr = ptr_add %ptr_reg, 0
[END_MACRO]

[MACRO] PTR_CAST_MUT %out_ptr, %ptr_reg
    %out_ptr = ptr_add %ptr_reg, 0
[END_MACRO]

[MACRO] PTR_OFFSET_BYTES %out_ptr, %ptr_reg, %byte_offset
    %out_ptr = ptr_add %ptr_reg, %byte_offset
[END_MACRO]

[MACRO] PTR_BYTE_ADD %out_ptr, %ptr_reg, %byte_offset
    %out_ptr = ptr_add %ptr_reg, %byte_offset
[END_MACRO]

[MACRO] PTR_BYTE_SUB %out_ptr, %ptr_reg, %byte_offset
    __ptr_sub_offset_%out_ptr = sub 0, %byte_offset
    %out_ptr = ptr_add %ptr_reg, __ptr_sub_offset_%out_ptr
    !__ptr_sub_offset_%out_ptr
[END_MACRO]

[MACRO] PTR_WRAPPING_BYTE_ADD %out_ptr, %ptr_reg, %byte_offset
    EXPAND PTR_BYTE_ADD %out_ptr, %ptr_reg, %byte_offset
[END_MACRO]

[MACRO] PTR_WRAPPING_BYTE_SUB %out_ptr, %ptr_reg, %byte_offset
    EXPAND PTR_BYTE_SUB %out_ptr, %ptr_reg, %byte_offset
[END_MACRO]

[MACRO] PTR_OFFSET_FROM_BYTES %out_offset, %ptr_reg, %base_ptr
    __ptr_offset_addr_%out_offset = bitcast %ptr_reg as u64
    __ptr_offset_base_%out_offset = bitcast %base_ptr as u64
    %out_offset = sub __ptr_offset_addr_%out_offset, __ptr_offset_base_%out_offset
    !__ptr_offset_base_%out_offset
    !__ptr_offset_addr_%out_offset
[END_MACRO]

[MACRO] PTR_OFFSET_FROM_U64 %out_offset, %ptr_reg, %base_ptr
    EXPAND PTR_OFFSET_FROM_BYTES __ptr_offset_bytes_%out_offset, %ptr_reg, %base_ptr
    %out_offset = udiv __ptr_offset_bytes_%out_offset, 8
    !__ptr_offset_bytes_%out_offset
[END_MACRO]

// Rust method-name alias over PTR_OFFSET_FROM_U64.
[MACRO] PTR_OFFSET_FROM %out_offset, %ptr_reg, %base_ptr
    EXPAND PTR_OFFSET_FROM_U64 %out_offset, %ptr_reg, %base_ptr
[END_MACRO]

[MACRO] PTR_BYTE_OFFSET_FROM_UNSIGNED %out_offset, %ptr_reg, %base_ptr
    EXPAND PTR_OFFSET_FROM_BYTES %out_offset, %ptr_reg, %base_ptr
[END_MACRO]

[MACRO] PTR_OFFSET_FROM_UNSIGNED_U64 %out_offset, %ptr_reg, %base_ptr
    EXPAND PTR_OFFSET_FROM_U64 %out_offset, %ptr_reg, %base_ptr
[END_MACRO]

// Rust method-name alias over PTR_OFFSET_FROM_UNSIGNED_U64.
[MACRO] PTR_OFFSET_FROM_UNSIGNED %out_offset, %ptr_reg, %base_ptr
    EXPAND PTR_OFFSET_FROM_UNSIGNED_U64 %out_offset, %ptr_reg, %base_ptr
[END_MACRO]

[MACRO] PTR_OFFSET_U64 %out_ptr, %ptr_reg, %index
    __ptr_u64_off_%out_ptr = mul %index, 8
    %out_ptr = ptr_add %ptr_reg, __ptr_u64_off_%out_ptr
    !__ptr_u64_off_%out_ptr
[END_MACRO]

// Rust method-name alias over PTR_OFFSET_U64.
[MACRO] PTR_OFFSET %out_ptr, %ptr_reg, %index
    EXPAND PTR_OFFSET_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

[MACRO] PTR_ADD_U64 %out_ptr, %ptr_reg, %index
    EXPAND PTR_OFFSET_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

// Rust method-name alias over PTR_ADD_U64.
[MACRO] PTR_ADD %out_ptr, %ptr_reg, %index
    EXPAND PTR_ADD_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

[MACRO] PTR_SUB_U64 %out_ptr, %ptr_reg, %index
    __ptr_u64_sub_off_%out_ptr = mul %index, 8
    __ptr_u64_sub_neg_%out_ptr = sub 0, __ptr_u64_sub_off_%out_ptr
    %out_ptr = ptr_add %ptr_reg, __ptr_u64_sub_neg_%out_ptr
    !__ptr_u64_sub_neg_%out_ptr
    !__ptr_u64_sub_off_%out_ptr
[END_MACRO]

// Rust method-name alias over PTR_SUB_U64.
[MACRO] PTR_SUB %out_ptr, %ptr_reg, %index
    EXPAND PTR_SUB_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

[MACRO] PTR_WRAPPING_ADD_U64 %out_ptr, %ptr_reg, %index
    EXPAND PTR_ADD_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

// Rust method-name alias over PTR_WRAPPING_ADD_U64.
[MACRO] PTR_WRAPPING_ADD %out_ptr, %ptr_reg, %index
    EXPAND PTR_WRAPPING_ADD_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

[MACRO] PTR_WRAPPING_SUB_U64 %out_ptr, %ptr_reg, %index
    EXPAND PTR_SUB_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

// Rust method-name alias over PTR_WRAPPING_SUB_U64.
[MACRO] PTR_WRAPPING_SUB %out_ptr, %ptr_reg, %index
    EXPAND PTR_WRAPPING_SUB_U64 %out_ptr, %ptr_reg, %index
[END_MACRO]

[MACRO] PTR_IS_ALIGNED_TO %out_bool, %ptr_reg, %align
    __ptr_addr_%out_bool = bitcast %ptr_reg as u64
    __ptr_rem_%out_bool = rem __ptr_addr_%out_bool, %align
    %out_bool = eq __ptr_rem_%out_bool, 0
    !__ptr_rem_%out_bool
    !__ptr_addr_%out_bool
[END_MACRO]

[MACRO] PTR_GUARANTEED_EQ %out_ok, %out_bool, %lhs_ptr, %rhs_ptr
    %out_bool = eq %lhs_ptr, %rhs_ptr
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] PTR_GUARANTEED_NE %out_ok, %out_bool, %lhs_ptr, %rhs_ptr
    %out_bool = ne %lhs_ptr, %rhs_ptr
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] PTR_READ_U64 %out_value, %ptr_reg
    %out_value = load %ptr_reg+0 as u64
[END_MACRO]

// Rust method-name alias over PTR_READ_U64.
[MACRO] PTR_READ %out_value, %ptr_reg
    EXPAND PTR_READ_U64 %out_value, %ptr_reg
[END_MACRO]

[MACRO] PTR_READ_UNALIGNED_U64 %out_value, %ptr_reg
    %out_value = load %ptr_reg+0 as u64
[END_MACRO]

// Rust method-name alias over PTR_READ_UNALIGNED_U64.
[MACRO] PTR_READ_UNALIGNED %out_value, %ptr_reg
    EXPAND PTR_READ_UNALIGNED_U64 %out_value, %ptr_reg
[END_MACRO]

[MACRO] PTR_READ_VOLATILE_U64 %out_value, %ptr_reg
    %out_value = load %ptr_reg+0 as u64
[END_MACRO]

// Rust method-name alias over PTR_READ_VOLATILE_U64.
[MACRO] PTR_READ_VOLATILE %out_value, %ptr_reg
    EXPAND PTR_READ_VOLATILE_U64 %out_value, %ptr_reg
[END_MACRO]

[MACRO] PTR_READ_VOLATILE_I32 %out_value, %ptr_reg
    %out_value = load %ptr_reg+0 as i32
[END_MACRO]

[MACRO] PTR_READ_U8 %out_value, %ptr_reg
    %out_value = load %ptr_reg+0 as u8
[END_MACRO]

[MACRO] PTR_READ_UNALIGNED_U8 %out_value, %ptr_reg
    %out_value = load %ptr_reg+0 as u8
[END_MACRO]

[MACRO] PTR_READ_VOLATILE_U8 %out_value, %ptr_reg
    %out_value = load %ptr_reg+0 as u8
[END_MACRO]

[MACRO] PTR_WRITE_U64 %ptr_reg, %value
    store %ptr_reg+0, %value as u64
[END_MACRO]

// Rust method-name alias over PTR_WRITE_U64.
[MACRO] PTR_WRITE %ptr_reg, %value
    EXPAND PTR_WRITE_U64 %ptr_reg, %value
[END_MACRO]

[MACRO] PTR_WRITE_UNALIGNED_U64 %ptr_reg, %value
    store %ptr_reg+0, %value as u64
[END_MACRO]

// Rust method-name alias over PTR_WRITE_UNALIGNED_U64.
[MACRO] PTR_WRITE_UNALIGNED %ptr_reg, %value
    EXPAND PTR_WRITE_UNALIGNED_U64 %ptr_reg, %value
[END_MACRO]

[MACRO] PTR_WRITE_VOLATILE_U64 %ptr_reg, %value
    store %ptr_reg+0, %value as u64
[END_MACRO]

// Rust method-name alias over PTR_WRITE_VOLATILE_U64.
[MACRO] PTR_WRITE_VOLATILE %ptr_reg, %value
    EXPAND PTR_WRITE_VOLATILE_U64 %ptr_reg, %value
[END_MACRO]

[MACRO] PTR_WRITE_U8 %ptr_reg, %value
    store %ptr_reg+0, %value as u8
[END_MACRO]

[MACRO] PTR_WRITE_UNALIGNED_U8 %ptr_reg, %value
    store %ptr_reg+0, %value as u8
[END_MACRO]

[MACRO] PTR_WRITE_VOLATILE_U8 %ptr_reg, %value
    store %ptr_reg+0, %value as u8
[END_MACRO]

[MACRO] PTR_SWAP_U64 %lhs_ptr, %rhs_ptr
    __ptr_swap_lhs_%lhs_ptr = load %lhs_ptr+0 as u64
    __ptr_swap_rhs_%lhs_ptr = load %rhs_ptr+0 as u64
    store %lhs_ptr+0, __ptr_swap_rhs_%lhs_ptr as u64
    store %rhs_ptr+0, __ptr_swap_lhs_%lhs_ptr as u64
    !__ptr_swap_rhs_%lhs_ptr
    !__ptr_swap_lhs_%lhs_ptr
[END_MACRO]

// Rust method-name alias over PTR_SWAP_U64.
[MACRO] PTR_SWAP %lhs_ptr, %rhs_ptr
    EXPAND PTR_SWAP_U64 %lhs_ptr, %rhs_ptr
[END_MACRO]

[MACRO] PTR_SWAP_NONOVERLAPPING_U64 %lhs_ptr, %rhs_ptr
    EXPAND PTR_SWAP_U64 %lhs_ptr, %rhs_ptr
[END_MACRO]

// Rust method-name alias over PTR_SWAP_NONOVERLAPPING_U64.
[MACRO] PTR_SWAP_NONOVERLAPPING %lhs_ptr, %rhs_ptr
    EXPAND PTR_SWAP_NONOVERLAPPING_U64 %lhs_ptr, %rhs_ptr
[END_MACRO]

[MACRO] PTR_REPLACE_U64 %out_old, %ptr_reg, %new_value
    %out_old = load %ptr_reg+0 as u64
    store %ptr_reg+0, %new_value as u64
[END_MACRO]

// Rust method-name alias over PTR_REPLACE_U64.
[MACRO] PTR_REPLACE %out_old, %ptr_reg, %new_value
    EXPAND PTR_REPLACE_U64 %out_old, %ptr_reg, %new_value
[END_MACRO]

[MACRO] PTR_TAKE_U64 %out_old, %ptr_reg
    %out_old = load %ptr_reg+0 as u64
    store %ptr_reg+0, 0 as u64
[END_MACRO]

// Rust method-name alias over PTR_TAKE_U64.
[MACRO] PTR_TAKE %out_old, %ptr_reg
    EXPAND PTR_TAKE_U64 %out_old, %ptr_reg
[END_MACRO]

[MACRO] PTR_COPY_BYTES %dst_ptr, %src_ptr, %byte_count
    call @sa_mem_copy(&%dst_ptr, &%src_ptr, %byte_count)
[END_MACRO]

[MACRO] PTR_COPY_NONOVERLAPPING_BYTES %dst_ptr, %src_ptr, %byte_count
    call @sa_mem_copy(&%dst_ptr, &%src_ptr, %byte_count)
[END_MACRO]

[MACRO] PTR_WRITE_BYTES %dst_ptr, %byte_value, %byte_count
    call @sa_mem_set(&%dst_ptr, %byte_value, %byte_count)
[END_MACRO]

[MACRO] PTR_COPY_U64S %dst_ptr, %src_ptr, %count
    __ptr_copy_bytes_%dst_ptr = mul %count, 8
    call @sa_mem_copy(&%dst_ptr, &%src_ptr, __ptr_copy_bytes_%dst_ptr)
    !__ptr_copy_bytes_%dst_ptr
[END_MACRO]

[MACRO] PTR_COPY_NONOVERLAPPING_U64S %dst_ptr, %src_ptr, %count
    __ptr_copy_nonoverlap_bytes_%dst_ptr = mul %count, 8
    call @sa_mem_copy(&%dst_ptr, &%src_ptr, __ptr_copy_nonoverlap_bytes_%dst_ptr)
    !__ptr_copy_nonoverlap_bytes_%dst_ptr
[END_MACRO]

[MACRO] NONNULL_NEW %out_ok, %nonnull_ptr, %ptr_reg
    EXPAND PTR_IS_NONNULL %out_ok, %ptr_reg
    store %nonnull_ptr+NonNull_ptr, %ptr_reg as ptr
[END_MACRO]

[MACRO] NONNULL_NEW_UNCHECKED %nonnull_ptr, %ptr_reg
    store %nonnull_ptr+NonNull_ptr, %ptr_reg as ptr
[END_MACRO]

[MACRO] NONNULL_AS_PTR %out_ptr, %nonnull_ptr
    %out_ptr = load %nonnull_ptr+NonNull_ptr as ptr
[END_MACRO]

[MACRO] NONNULL_AS_REF %out_ptr, %nonnull_ptr
    %out_ptr = load %nonnull_ptr+NonNull_ptr as ptr
[END_MACRO]

[MACRO] NONNULL_AS_MUT %out_ptr, %nonnull_ptr
    %out_ptr = load %nonnull_ptr+NonNull_ptr as ptr
[END_MACRO]

[MACRO] NONNULL_ADDR %out_addr, %nonnull_ptr
    __nonnull_addr_ptr_%out_addr = load %nonnull_ptr+NonNull_ptr as ptr
    EXPAND PTR_ADDR %out_addr, __nonnull_addr_ptr_%out_addr
    !__nonnull_addr_ptr_%out_addr
[END_MACRO]

[MACRO] NONNULL_EXPOSE_PROVENANCE %out_addr, %nonnull_ptr
    EXPAND NONNULL_ADDR %out_addr, %nonnull_ptr
[END_MACRO]

[MACRO] NONNULL_BYTE_ADD %out_nonnull, %nonnull_ptr, %byte_offset
    __nonnull_add_ptr_%out_nonnull = load %nonnull_ptr+NonNull_ptr as ptr
    __nonnull_add_next_%out_nonnull = ptr_add __nonnull_add_ptr_%out_nonnull, %byte_offset
    store %out_nonnull+NonNull_ptr, __nonnull_add_next_%out_nonnull as ptr
    !__nonnull_add_next_%out_nonnull
    !__nonnull_add_ptr_%out_nonnull
[END_MACRO]

[MACRO] NONNULL_BYTE_SUB %out_nonnull, %nonnull_ptr, %byte_offset
    __nonnull_sub_ptr_%out_nonnull = load %nonnull_ptr+NonNull_ptr as ptr
    __nonnull_sub_offset_%out_nonnull = sub 0, %byte_offset
    __nonnull_sub_next_%out_nonnull = ptr_add __nonnull_sub_ptr_%out_nonnull, __nonnull_sub_offset_%out_nonnull
    store %out_nonnull+NonNull_ptr, __nonnull_sub_next_%out_nonnull as ptr
    !__nonnull_sub_next_%out_nonnull
    !__nonnull_sub_offset_%out_nonnull
    !__nonnull_sub_ptr_%out_nonnull
[END_MACRO]

[MACRO] NONNULL_WRAPPING_BYTE_ADD %out_nonnull, %nonnull_ptr, %byte_offset
    EXPAND NONNULL_BYTE_ADD %out_nonnull, %nonnull_ptr, %byte_offset
[END_MACRO]

[MACRO] NONNULL_WRAPPING_BYTE_SUB %out_nonnull, %nonnull_ptr, %byte_offset
    EXPAND NONNULL_BYTE_SUB %out_nonnull, %nonnull_ptr, %byte_offset
[END_MACRO]

[MACRO] NONNULL_ADD_U64 %out_nonnull, %nonnull_ptr, %index
    __nonnull_add_u64_bytes_%out_nonnull = mul %index, 8
    EXPAND NONNULL_BYTE_ADD %out_nonnull, %nonnull_ptr, __nonnull_add_u64_bytes_%out_nonnull
    !__nonnull_add_u64_bytes_%out_nonnull
[END_MACRO]

// Rust method-name alias over NONNULL_ADD_U64.
[MACRO] NONNULL_ADD %out_nonnull, %nonnull_ptr, %index
    EXPAND NONNULL_ADD_U64 %out_nonnull, %nonnull_ptr, %index
[END_MACRO]

[MACRO] NONNULL_SUB_U64 %out_nonnull, %nonnull_ptr, %index
    __nonnull_sub_u64_bytes_%out_nonnull = mul %index, 8
    EXPAND NONNULL_BYTE_SUB %out_nonnull, %nonnull_ptr, __nonnull_sub_u64_bytes_%out_nonnull
    !__nonnull_sub_u64_bytes_%out_nonnull
[END_MACRO]

// Rust method-name alias over NONNULL_SUB_U64.
[MACRO] NONNULL_SUB %out_nonnull, %nonnull_ptr, %index
    EXPAND NONNULL_SUB_U64 %out_nonnull, %nonnull_ptr, %index
[END_MACRO]

[MACRO] NONNULL_WRAPPING_ADD_U64 %out_nonnull, %nonnull_ptr, %index
    EXPAND NONNULL_ADD_U64 %out_nonnull, %nonnull_ptr, %index
[END_MACRO]

// Rust method-name alias over NONNULL_WRAPPING_ADD_U64.
[MACRO] NONNULL_WRAPPING_ADD %out_nonnull, %nonnull_ptr, %index
    EXPAND NONNULL_WRAPPING_ADD_U64 %out_nonnull, %nonnull_ptr, %index
[END_MACRO]

[MACRO] NONNULL_WRAPPING_SUB_U64 %out_nonnull, %nonnull_ptr, %index
    EXPAND NONNULL_SUB_U64 %out_nonnull, %nonnull_ptr, %index
[END_MACRO]

// Rust method-name alias over NONNULL_WRAPPING_SUB_U64.
[MACRO] NONNULL_WRAPPING_SUB %out_nonnull, %nonnull_ptr, %index
    EXPAND NONNULL_WRAPPING_SUB_U64 %out_nonnull, %nonnull_ptr, %index
[END_MACRO]

[MACRO] NONNULL_OFFSET_FROM_BYTES %out_offset, %nonnull_ptr, %base_nonnull
    __nonnull_offset_ptr_%out_offset = load %nonnull_ptr+NonNull_ptr as ptr
    __nonnull_offset_base_%out_offset = load %base_nonnull+NonNull_ptr as ptr
    EXPAND PTR_OFFSET_FROM_BYTES %out_offset, __nonnull_offset_ptr_%out_offset, __nonnull_offset_base_%out_offset
    !__nonnull_offset_base_%out_offset
    !__nonnull_offset_ptr_%out_offset
[END_MACRO]

[MACRO] NONNULL_OFFSET_FROM_U64 %out_offset, %nonnull_ptr, %base_nonnull
    __nonnull_offset_u64_ptr_%out_offset = load %nonnull_ptr+NonNull_ptr as ptr
    __nonnull_offset_u64_base_%out_offset = load %base_nonnull+NonNull_ptr as ptr
    EXPAND PTR_OFFSET_FROM_U64 %out_offset, __nonnull_offset_u64_ptr_%out_offset, __nonnull_offset_u64_base_%out_offset
    !__nonnull_offset_u64_base_%out_offset
    !__nonnull_offset_u64_ptr_%out_offset
[END_MACRO]

// Rust method-name alias over NONNULL_OFFSET_FROM_U64.
[MACRO] NONNULL_OFFSET_FROM %out_offset, %nonnull_ptr, %base_nonnull
    EXPAND NONNULL_OFFSET_FROM_U64 %out_offset, %nonnull_ptr, %base_nonnull
[END_MACRO]

[MACRO] NONNULL_BYTE_OFFSET_FROM_UNSIGNED %out_offset, %nonnull_ptr, %base_nonnull
    EXPAND NONNULL_OFFSET_FROM_BYTES %out_offset, %nonnull_ptr, %base_nonnull
[END_MACRO]

[MACRO] NONNULL_OFFSET_FROM_UNSIGNED_U64 %out_offset, %nonnull_ptr, %base_nonnull
    EXPAND NONNULL_OFFSET_FROM_U64 %out_offset, %nonnull_ptr, %base_nonnull
[END_MACRO]

// Rust method-name alias over NONNULL_OFFSET_FROM_UNSIGNED_U64.
[MACRO] NONNULL_OFFSET_FROM_UNSIGNED %out_offset, %nonnull_ptr, %base_nonnull
    EXPAND NONNULL_OFFSET_FROM_UNSIGNED_U64 %out_offset, %nonnull_ptr, %base_nonnull
[END_MACRO]

[MACRO] NONNULL_IS_NONNULL %out_bool, %nonnull_ptr
    __nonnull_ptr_%out_bool = load %nonnull_ptr+NonNull_ptr as ptr
    EXPAND PTR_IS_NONNULL %out_bool, __nonnull_ptr_%out_bool
