[END_MACRO]

[MACRO] NONNULL_IS_NULL %out_bool, %nonnull_ptr
    __nonnull_ptr_%out_bool = load %nonnull_ptr+NonNull_ptr as ptr
    EXPAND PTR_IS_NULL %out_bool, __nonnull_ptr_%out_bool
    !__nonnull_ptr_%out_bool
[END_MACRO]

[MACRO] NONNULL_IS_ALIGNED_TO %out_bool, %nonnull_ptr, %align
    __nonnull_align_ptr_%out_bool = load %nonnull_ptr+NonNull_ptr as ptr
    EXPAND PTR_IS_ALIGNED_TO %out_bool, __nonnull_align_ptr_%out_bool, %align
    !__nonnull_align_ptr_%out_bool
[END_MACRO]

[MACRO] NONNULL_EQ %out_bool, %lhs_nonnull, %rhs_nonnull
    __nonnull_lhs_%out_bool = load %lhs_nonnull+NonNull_ptr as ptr
    __nonnull_rhs_%out_bool = load %rhs_nonnull+NonNull_ptr as ptr
    %out_bool = eq __nonnull_lhs_%out_bool, __nonnull_rhs_%out_bool
    !__nonnull_rhs_%out_bool
    !__nonnull_lhs_%out_bool
[END_MACRO]

[MACRO] NONNULL_NE %out_bool, %lhs_nonnull, %rhs_nonnull
    __nonnull_lhs_%out_bool = load %lhs_nonnull+NonNull_ptr as ptr
    __nonnull_rhs_%out_bool = load %rhs_nonnull+NonNull_ptr as ptr
    %out_bool = ne __nonnull_lhs_%out_bool, __nonnull_rhs_%out_bool
    !__nonnull_rhs_%out_bool
    !__nonnull_lhs_%out_bool
[END_MACRO]

[MACRO] NONNULL_GUARANTEED_EQ %out_ok, %out_bool, %lhs_nonnull, %rhs_nonnull
    EXPAND NONNULL_EQ %out_bool, %lhs_nonnull, %rhs_nonnull
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] NONNULL_GUARANTEED_NE %out_ok, %out_bool, %lhs_nonnull, %rhs_nonnull
    EXPAND NONNULL_NE %out_bool, %lhs_nonnull, %rhs_nonnull
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] NONNULL_CAST %out_nonnull, %nonnull_ptr
    __nonnull_cast_ptr_%out_nonnull = load %nonnull_ptr+NonNull_ptr as ptr
    store %out_nonnull+NonNull_ptr, __nonnull_cast_ptr_%out_nonnull as ptr
    !__nonnull_cast_ptr_%out_nonnull
[END_MACRO]
