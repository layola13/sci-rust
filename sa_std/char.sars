@import "char.sal"
@import "ascii.sars"

[MACRO] CHAR_IS_VALID_SCALAR %out_bool, %code
    __char_in_max_%out_bool = ule %code, CHAR_MAX
    __char_ge_sur_%out_bool = uge %code, CHAR_SURROGATE_MIN
    __char_le_sur_%out_bool = ule %code, CHAR_SURROGATE_MAX
    __char_is_sur_%out_bool = and __char_ge_sur_%out_bool, __char_le_sur_%out_bool
    __char_not_sur_%out_bool = eq __char_is_sur_%out_bool, 0
    %out_bool = and __char_in_max_%out_bool, __char_not_sur_%out_bool
    !__char_not_sur_%out_bool
    !__char_is_sur_%out_bool
    !__char_le_sur_%out_bool
    !__char_ge_sur_%out_bool
    !__char_in_max_%out_bool
[END_MACRO]

[MACRO] CHAR_FROM_U32 %out_ok, %out_char, %code
    EXPAND CHAR_IS_VALID_SCALAR __char_valid_%out_ok, %code
    br __char_valid_%out_ok -> L_CHAR_FROM_U32_OK_%out_ok, L_CHAR_FROM_U32_ERR_%out_ok

L_CHAR_FROM_U32_OK_%out_ok:
    %out_char = add %code, 0
    %out_ok = add 0, 1
    !__char_valid_%out_ok
    jmp L_CHAR_FROM_U32_END_%out_ok

L_CHAR_FROM_U32_ERR_%out_ok:
    %out_char = add 0, 0
    %out_ok = add 0, 0
    !__char_valid_%out_ok

L_CHAR_FROM_U32_END_%out_ok:
[END_MACRO]

[MACRO] CHAR_FROM_U32_UNCHECKED %out_char, %code
    %out_char = add %code, 0
[END_MACRO]

[MACRO] CHAR_LEN_UTF8 %out_len, %code
    __char_one_%out_len = ule %code, CHAR_UTF8_ONE_MAX
    br __char_one_%out_len -> L_CHAR_LEN_UTF8_ONE_%out_len, L_CHAR_LEN_UTF8_CHECK_TWO_%out_len

L_CHAR_LEN_UTF8_CHECK_TWO_%out_len:
    __char_two_%out_len = ule %code, CHAR_UTF8_TWO_MAX
    br __char_two_%out_len -> L_CHAR_LEN_UTF8_TWO_%out_len, L_CHAR_LEN_UTF8_CHECK_THREE_%out_len

L_CHAR_LEN_UTF8_CHECK_THREE_%out_len:
    __char_three_%out_len = ule %code, CHAR_UTF8_THREE_MAX
    br __char_three_%out_len -> L_CHAR_LEN_UTF8_THREE_%out_len, L_CHAR_LEN_UTF8_FOUR_%out_len

L_CHAR_LEN_UTF8_ONE_%out_len:
    %out_len = add 0, 1
    !__char_one_%out_len
    jmp L_CHAR_LEN_UTF8_END_%out_len

L_CHAR_LEN_UTF8_TWO_%out_len:
    %out_len = add 0, 2
    !__char_two_%out_len
    !__char_one_%out_len
    jmp L_CHAR_LEN_UTF8_END_%out_len

L_CHAR_LEN_UTF8_THREE_%out_len:
    %out_len = add 0, 3
    !__char_three_%out_len
    !__char_two_%out_len
    !__char_one_%out_len
    jmp L_CHAR_LEN_UTF8_END_%out_len

L_CHAR_LEN_UTF8_FOUR_%out_len:
    %out_len = add 0, 4
    !__char_three_%out_len
    !__char_two_%out_len
    !__char_one_%out_len

L_CHAR_LEN_UTF8_END_%out_len:
[END_MACRO]

[MACRO] CHAR_LEN_UTF16 %out_len, %code
    __char_bmp_%out_len = ule %code, CHAR_UTF8_THREE_MAX
    br __char_bmp_%out_len -> L_CHAR_LEN_UTF16_ONE_%out_len, L_CHAR_LEN_UTF16_TWO_%out_len

L_CHAR_LEN_UTF16_ONE_%out_len:
    %out_len = add 0, 1
    !__char_bmp_%out_len
    jmp L_CHAR_LEN_UTF16_END_%out_len

L_CHAR_LEN_UTF16_TWO_%out_len:
    %out_len = add 0, 2
    !__char_bmp_%out_len

L_CHAR_LEN_UTF16_END_%out_len:
[END_MACRO]

[MACRO] CHAR_IS_ASCII %out_bool, %code
    EXPAND ASCII_IS_ASCII %out_bool, %code
[END_MACRO]

[MACRO] CHAR_IS_ASCII_ALPHABETIC %out_bool, %code
    EXPAND ASCII_IS_ALPHABETIC %out_bool, %code
[END_MACRO]

[MACRO] CHAR_IS_ASCII_ALPHANUMERIC %out_bool, %code
    EXPAND ASCII_IS_ALPHANUMERIC %out_bool, %code
[END_MACRO]

[MACRO] CHAR_IS_ASCII_DIGIT %out_bool, %code
    EXPAND ASCII_IS_DIGIT %out_bool, %code
[END_MACRO]

[MACRO] CHAR_IS_ASCII_HEXDIGIT %out_bool, %code
    EXPAND ASCII_IS_HEXDIGIT %out_bool, %code
[END_MACRO]

[MACRO] CHAR_IS_ASCII_WHITESPACE %out_bool, %code
    EXPAND ASCII_IS_WHITESPACE %out_bool, %code
[END_MACRO]

[MACRO] CHAR_TO_ASCII_UPPERCASE %out_code, %code
    EXPAND ASCII_TO_UPPERCASE %out_code, %code
[END_MACRO]

[MACRO] CHAR_TO_ASCII_LOWERCASE %out_code, %code
    EXPAND ASCII_TO_LOWERCASE %out_code, %code
[END_MACRO]

[MACRO] CHAR_EQ_IGNORE_ASCII_CASE %out_bool, %left_code, %right_code
    EXPAND ASCII_EQ_IGNORE_CASE %out_bool, %left_code, %right_code
[END_MACRO]

[MACRO] CHAR_TO_DIGIT %out_ok, %out_value, %code, %radix
    __char_radix_ge_%out_ok = uge %radix, 2
    __char_radix_le_%out_ok = ule %radix, 36
    __char_radix_ok_%out_ok = and __char_radix_ge_%out_ok, __char_radix_le_%out_ok
    br __char_radix_ok_%out_ok -> L_CHAR_TO_DIGIT_CHECK_DEC_%out_ok, L_CHAR_TO_DIGIT_NONE_%out_ok

L_CHAR_TO_DIGIT_CHECK_DEC_%out_ok:
    __char_digit_ge_%out_ok = uge %code, 48
    __char_digit_le_%out_ok = ule %code, 57
    __char_digit_dec_%out_ok = and __char_digit_ge_%out_ok, __char_digit_le_%out_ok
    br __char_digit_dec_%out_ok -> L_CHAR_TO_DIGIT_DEC_%out_ok, L_CHAR_TO_DIGIT_CHECK_ALPHA_%out_ok

L_CHAR_TO_DIGIT_DEC_%out_ok:
    __char_dec_value_%out_ok = sub %code, 48
    __char_dec_in_radix_%out_ok = ult __char_dec_value_%out_ok, %radix
    br __char_dec_in_radix_%out_ok -> L_CHAR_TO_DIGIT_DEC_OK_%out_ok, L_CHAR_TO_DIGIT_DEC_BAD_%out_ok

L_CHAR_TO_DIGIT_DEC_OK_%out_ok:
    %out_value = add __char_dec_value_%out_ok, 0
    %out_ok = add 0, 1
    !__char_dec_in_radix_%out_ok
    !__char_dec_value_%out_ok
    !__char_digit_dec_%out_ok
    !__char_digit_le_%out_ok
    !__char_digit_ge_%out_ok
    !__char_radix_ok_%out_ok
    !__char_radix_le_%out_ok
    !__char_radix_ge_%out_ok
    jmp L_CHAR_TO_DIGIT_END_%out_ok

L_CHAR_TO_DIGIT_DEC_BAD_%out_ok:
    !__char_dec_in_radix_%out_ok
    !__char_dec_value_%out_ok
    jmp L_CHAR_TO_DIGIT_NONE_AFTER_DEC_%out_ok

L_CHAR_TO_DIGIT_CHECK_ALPHA_%out_ok:
    EXPAND ASCII_TO_UPPERCASE __char_upper_%out_ok, %code
    __char_alpha_ge_%out_ok = uge __char_upper_%out_ok, 65
    __char_alpha_le_%out_ok = ule __char_upper_%out_ok, 90
    __char_alpha_%out_ok = and __char_alpha_ge_%out_ok, __char_alpha_le_%out_ok
    br __char_alpha_%out_ok -> L_CHAR_TO_DIGIT_ALPHA_%out_ok, L_CHAR_TO_DIGIT_NONE_ALPHA_%out_ok

L_CHAR_TO_DIGIT_ALPHA_%out_ok:
    __char_alpha_base_%out_ok = sub __char_upper_%out_ok, 65
    __char_alpha_value_%out_ok = add __char_alpha_base_%out_ok, 10
    __char_alpha_in_radix_%out_ok = ult __char_alpha_value_%out_ok, %radix
    br __char_alpha_in_radix_%out_ok -> L_CHAR_TO_DIGIT_ALPHA_OK_%out_ok, L_CHAR_TO_DIGIT_ALPHA_BAD_%out_ok

L_CHAR_TO_DIGIT_ALPHA_OK_%out_ok:
    %out_value = add __char_alpha_value_%out_ok, 0
    %out_ok = add 0, 1
    !__char_alpha_in_radix_%out_ok
    !__char_alpha_value_%out_ok
    !__char_alpha_base_%out_ok
    !__char_alpha_%out_ok
    !__char_alpha_le_%out_ok
    !__char_alpha_ge_%out_ok
    !__char_upper_%out_ok
    !__char_digit_dec_%out_ok
    !__char_digit_le_%out_ok
    !__char_digit_ge_%out_ok
    !__char_radix_ok_%out_ok
    !__char_radix_le_%out_ok
    !__char_radix_ge_%out_ok
    jmp L_CHAR_TO_DIGIT_END_%out_ok

L_CHAR_TO_DIGIT_ALPHA_BAD_%out_ok:
    !__char_alpha_in_radix_%out_ok
    !__char_alpha_value_%out_ok
    !__char_alpha_base_%out_ok
    jmp L_CHAR_TO_DIGIT_NONE_ALPHA_%out_ok

L_CHAR_TO_DIGIT_NONE_ALPHA_%out_ok:
    !__char_alpha_%out_ok
    !__char_alpha_le_%out_ok
    !__char_alpha_ge_%out_ok
    !__char_upper_%out_ok
    jmp L_CHAR_TO_DIGIT_NONE_AFTER_DEC_%out_ok

L_CHAR_TO_DIGIT_NONE_AFTER_DEC_%out_ok:
    !__char_digit_dec_%out_ok
    !__char_digit_le_%out_ok
    !__char_digit_ge_%out_ok

L_CHAR_TO_DIGIT_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__char_radix_ok_%out_ok
    !__char_radix_le_%out_ok
    !__char_radix_ge_%out_ok

L_CHAR_TO_DIGIT_END_%out_ok:
[END_MACRO]

[MACRO] CHAR_IS_DIGIT %out_bool, %code, %radix
    EXPAND CHAR_TO_DIGIT __char_digit_ok_%out_bool, __char_digit_value_%out_bool, %code, %radix
    %out_bool = add __char_digit_ok_%out_bool, 0
    !__char_digit_value_%out_bool
    !__char_digit_ok_%out_bool
[END_MACRO]

[MACRO] CHAR_FROM_DIGIT %out_ok, %out_char, %digit, %radix
    __char_from_radix_ge_%out_ok = uge %radix, 2
    __char_from_radix_le_%out_ok = ule %radix, 36
    __char_from_radix_ok_%out_ok = and __char_from_radix_ge_%out_ok, __char_from_radix_le_%out_ok
    __char_from_in_radix_%out_ok = ult %digit, %radix
    __char_from_ok_%out_ok = and __char_from_radix_ok_%out_ok, __char_from_in_radix_%out_ok
    br __char_from_ok_%out_ok -> L_CHAR_FROM_DIGIT_OK_%out_ok, L_CHAR_FROM_DIGIT_NONE_%out_ok

L_CHAR_FROM_DIGIT_OK_%out_ok:
    __char_from_decimal_%out_ok = ult %digit, 10
    br __char_from_decimal_%out_ok -> L_CHAR_FROM_DIGIT_DEC_%out_ok, L_CHAR_FROM_DIGIT_ALPHA_%out_ok

L_CHAR_FROM_DIGIT_DEC_%out_ok:
    %out_char = add %digit, 48
    %out_ok = add 0, 1
    !__char_from_decimal_%out_ok
    !__char_from_ok_%out_ok
    !__char_from_in_radix_%out_ok
    !__char_from_radix_ok_%out_ok
    !__char_from_radix_le_%out_ok
    !__char_from_radix_ge_%out_ok
    jmp L_CHAR_FROM_DIGIT_END_%out_ok

L_CHAR_FROM_DIGIT_ALPHA_%out_ok:
    __char_from_alpha_base_%out_ok = sub %digit, 10
    %out_char = add __char_from_alpha_base_%out_ok, 97
    %out_ok = add 0, 1
    !__char_from_alpha_base_%out_ok
    !__char_from_decimal_%out_ok
    !__char_from_ok_%out_ok
    !__char_from_in_radix_%out_ok
    !__char_from_radix_ok_%out_ok
    !__char_from_radix_le_%out_ok
    !__char_from_radix_ge_%out_ok
    jmp L_CHAR_FROM_DIGIT_END_%out_ok

L_CHAR_FROM_DIGIT_NONE_%out_ok:
    %out_char = add 0, 0
    %out_ok = add 0, 0
    !__char_from_ok_%out_ok
    !__char_from_in_radix_%out_ok
    !__char_from_radix_ok_%out_ok
    !__char_from_radix_le_%out_ok
    !__char_from_radix_ge_%out_ok

L_CHAR_FROM_DIGIT_END_%out_ok:
[END_MACRO]

[MACRO] CHAR_ESCAPE_UNICODE_WRITE %out_ok, %out_len, %dst_ptr, %dst_len, %code
    EXPAND CHAR_IS_VALID_SCALAR __char_escape_valid_%out_ok, %code
    br __char_escape_valid_%out_ok -> L_CHAR_ESCAPE_CHECK_1_%out_ok, L_CHAR_ESCAPE_FAIL_%out_ok

L_CHAR_ESCAPE_CHECK_1_%out_ok:
    __char_escape_le_1_%out_ok = ule %code, 15
    br __char_escape_le_1_%out_ok -> L_CHAR_ESCAPE_WRITE_1_%out_ok, L_CHAR_ESCAPE_CHECK_2_%out_ok

L_CHAR_ESCAPE_WRITE_1_%out_ok:
    !__char_escape_le_1_%out_ok
    !__char_escape_valid_%out_ok
    EXPAND CHAR_ESCAPE_UNICODE_WRITE_1 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    jmp L_CHAR_ESCAPE_END_%out_ok

L_CHAR_ESCAPE_CHECK_2_%out_ok:
    __char_escape_le_2_%out_ok = ule %code, 255
    br __char_escape_le_2_%out_ok -> L_CHAR_ESCAPE_WRITE_2_%out_ok, L_CHAR_ESCAPE_CHECK_3_%out_ok

L_CHAR_ESCAPE_WRITE_2_%out_ok:
    !__char_escape_le_2_%out_ok
    !__char_escape_le_1_%out_ok
    !__char_escape_valid_%out_ok
    EXPAND CHAR_ESCAPE_UNICODE_WRITE_2 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    jmp L_CHAR_ESCAPE_END_%out_ok

L_CHAR_ESCAPE_CHECK_3_%out_ok:
    __char_escape_le_3_%out_ok = ule %code, 4095
    br __char_escape_le_3_%out_ok -> L_CHAR_ESCAPE_WRITE_3_%out_ok, L_CHAR_ESCAPE_CHECK_4_%out_ok

L_CHAR_ESCAPE_WRITE_3_%out_ok:
    !__char_escape_le_3_%out_ok
    !__char_escape_le_2_%out_ok
    !__char_escape_le_1_%out_ok
    !__char_escape_valid_%out_ok
    EXPAND CHAR_ESCAPE_UNICODE_WRITE_3 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    jmp L_CHAR_ESCAPE_END_%out_ok

L_CHAR_ESCAPE_CHECK_4_%out_ok:
    __char_escape_le_4_%out_ok = ule %code, 65535
    br __char_escape_le_4_%out_ok -> L_CHAR_ESCAPE_WRITE_4_%out_ok, L_CHAR_ESCAPE_CHECK_5_%out_ok

L_CHAR_ESCAPE_WRITE_4_%out_ok:
    !__char_escape_le_4_%out_ok
    !__char_escape_le_3_%out_ok
    !__char_escape_le_2_%out_ok
    !__char_escape_le_1_%out_ok
    !__char_escape_valid_%out_ok
    EXPAND CHAR_ESCAPE_UNICODE_WRITE_4 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    jmp L_CHAR_ESCAPE_END_%out_ok

L_CHAR_ESCAPE_CHECK_5_%out_ok:
    __char_escape_le_5_%out_ok = ule %code, 1048575
    br __char_escape_le_5_%out_ok -> L_CHAR_ESCAPE_WRITE_5_%out_ok, L_CHAR_ESCAPE_WRITE_6_%out_ok

L_CHAR_ESCAPE_WRITE_5_%out_ok:
    !__char_escape_le_5_%out_ok
    !__char_escape_le_4_%out_ok
    !__char_escape_le_3_%out_ok
    !__char_escape_le_2_%out_ok
    !__char_escape_le_1_%out_ok
    !__char_escape_valid_%out_ok
    EXPAND CHAR_ESCAPE_UNICODE_WRITE_5 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    jmp L_CHAR_ESCAPE_END_%out_ok

L_CHAR_ESCAPE_WRITE_6_%out_ok:
    !__char_escape_le_5_%out_ok
    !__char_escape_le_4_%out_ok
    !__char_escape_le_3_%out_ok
    !__char_escape_le_2_%out_ok
    !__char_escape_le_1_%out_ok
    !__char_escape_valid_%out_ok
    EXPAND CHAR_ESCAPE_UNICODE_WRITE_6 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    jmp L_CHAR_ESCAPE_END_%out_ok

L_CHAR_ESCAPE_FAIL_%out_ok:
    %out_len = add 0, 0
    %out_ok = add 0, 0
    !__char_escape_valid_%out_ok

L_CHAR_ESCAPE_END_%out_ok:
[END_MACRO]

[MACRO] CHAR_ESCAPE_UNICODE_WRITE_1 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    __char_escape_fits1_%out_ok = uge %dst_len, 5
    br __char_escape_fits1_%out_ok -> L_CHAR_ESCAPE_WRITE1_OK_%out_ok, L_CHAR_ESCAPE_WRITE1_FAIL_%out_ok

L_CHAR_ESCAPE_WRITE1_OK_%out_ok:
    __char_escape_n0_1_%out_ok = and %code, 15
    EXPAND ASCII_NIBBLE_TO_LOWER_HEX __char_escape_d0_1_%out_ok, __char_escape_n0_1_%out_ok
    store %dst_ptr+0, CHAR_ESCAPE_BACKSLASH as u8
    __char_escape_p1_1_%out_ok = ptr_add %dst_ptr, 1
    __char_escape_p2_1_%out_ok = ptr_add %dst_ptr, 2
    __char_escape_p3_1_%out_ok = ptr_add %dst_ptr, 3
    __char_escape_p4_1_%out_ok = ptr_add %dst_ptr, 4
    store __char_escape_p1_1_%out_ok+0, CHAR_ESCAPE_U as u8
    store __char_escape_p2_1_%out_ok+0, CHAR_ESCAPE_LBRACE as u8
    store __char_escape_p3_1_%out_ok+0, __char_escape_d0_1_%out_ok as u8
    store __char_escape_p4_1_%out_ok+0, CHAR_ESCAPE_RBRACE as u8
    %out_len = add 0, 5
    %out_ok = add 0, 1
    !__char_escape_p4_1_%out_ok
    !__char_escape_p3_1_%out_ok
    !__char_escape_p2_1_%out_ok
    !__char_escape_p1_1_%out_ok
    !__char_escape_d0_1_%out_ok
    !__char_escape_n0_1_%out_ok
    !__char_escape_fits1_%out_ok
    jmp L_CHAR_ESCAPE_WRITE1_END_%out_ok

L_CHAR_ESCAPE_WRITE1_FAIL_%out_ok:
    %out_len = add 0, 0
    %out_ok = add 0, 0
    !__char_escape_fits1_%out_ok

L_CHAR_ESCAPE_WRITE1_END_%out_ok:
[END_MACRO]

[MACRO] CHAR_ESCAPE_UNICODE_WRITE_2 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    __char_escape_fits2_%out_ok = uge %dst_len, 6
    br __char_escape_fits2_%out_ok -> L_CHAR_ESCAPE_WRITE2_OK_%out_ok, L_CHAR_ESCAPE_WRITE2_FAIL_%out_ok

L_CHAR_ESCAPE_WRITE2_OK_%out_ok:
    __char_escape_s4_2_%out_ok = shr %code, 4
    __char_escape_n1_2_%out_ok = and __char_escape_s4_2_%out_ok, 15
    __char_escape_n0_2_%out_ok = and %code, 15
    EXPAND ASCII_NIBBLE_TO_LOWER_HEX __char_escape_d1_2_%out_ok, __char_escape_n1_2_%out_ok
    EXPAND ASCII_NIBBLE_TO_LOWER_HEX __char_escape_d0_2_%out_ok, __char_escape_n0_2_%out_ok
    store %dst_ptr+0, CHAR_ESCAPE_BACKSLASH as u8
    __char_escape_p1_2_%out_ok = ptr_add %dst_ptr, 1
    __char_escape_p2_2_%out_ok = ptr_add %dst_ptr, 2
    __char_escape_p3_2_%out_ok = ptr_add %dst_ptr, 3
    __char_escape_p4_2_%out_ok = ptr_add %dst_ptr, 4
    __char_escape_p5_2_%out_ok = ptr_add %dst_ptr, 5
    store __char_escape_p1_2_%out_ok+0, CHAR_ESCAPE_U as u8
    store __char_escape_p2_2_%out_ok+0, CHAR_ESCAPE_LBRACE as u8
    store __char_escape_p3_2_%out_ok+0, __char_escape_d1_2_%out_ok as u8
    store __char_escape_p4_2_%out_ok+0, __char_escape_d0_2_%out_ok as u8
    store __char_escape_p5_2_%out_ok+0, CHAR_ESCAPE_RBRACE as u8
    %out_len = add 0, 6
    %out_ok = add 0, 1
    !__char_escape_p5_2_%out_ok
    !__char_escape_p4_2_%out_ok
    !__char_escape_p3_2_%out_ok
    !__char_escape_p2_2_%out_ok
    !__char_escape_p1_2_%out_ok
    !__char_escape_d0_2_%out_ok
    !__char_escape_d1_2_%out_ok
    !__char_escape_n0_2_%out_ok
    !__char_escape_n1_2_%out_ok
    !__char_escape_s4_2_%out_ok
    !__char_escape_fits2_%out_ok
    jmp L_CHAR_ESCAPE_WRITE2_END_%out_ok

L_CHAR_ESCAPE_WRITE2_FAIL_%out_ok:
    %out_len = add 0, 0
    %out_ok = add 0, 0
    !__char_escape_fits2_%out_ok

L_CHAR_ESCAPE_WRITE2_END_%out_ok:
[END_MACRO]

[MACRO] CHAR_ESCAPE_UNICODE_WRITE_3 %out_ok, %out_len, %dst_ptr, %dst_len, %code
    __char_escape_fits3_%out_ok = uge %dst_len, 7
    br __char_escape_fits3_%out_ok -> L_CHAR_ESCAPE_WRITE3_OK_%out_ok, L_CHAR_ESCAPE_WRITE3_FAIL_%out_ok

L_CHAR_ESCAPE_WRITE3_OK_%out_ok:
    __char_escape_s8_3_%out_ok = shr %code, 8
    __char_escape_s4_3_%out_ok = shr %code, 4
    __char_escape_n2_3_%out_ok = and __char_escape_s8_3_%out_ok, 15
