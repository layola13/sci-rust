    __char_dec16_high_ge_%out_ok = uge %lead, CHAR_UTF16_HIGH_SURROGATE_MIN
    __char_dec16_high_le_%out_ok = ule %lead, CHAR_UTF16_HIGH_SURROGATE_MAX
    __char_dec16_is_high_%out_ok = and __char_dec16_high_ge_%out_ok, __char_dec16_high_le_%out_ok
    br __char_dec16_is_high_%out_ok -> L_CHAR_DEC16_HIGH_%out_ok, L_CHAR_DEC16_NOT_HIGH_%out_ok

L_CHAR_DEC16_NOT_HIGH_%out_ok:
    __char_dec16_low_ge_alone_%out_ok = uge %lead, CHAR_UTF16_LOW_SURROGATE_MIN
    __char_dec16_low_le_alone_%out_ok = ule %lead, CHAR_UTF16_LOW_SURROGATE_MAX
    __char_dec16_is_low_alone_%out_ok = and __char_dec16_low_ge_alone_%out_ok, __char_dec16_low_le_alone_%out_ok
    br __char_dec16_is_low_alone_%out_ok -> L_CHAR_DEC16_ERR_LOW_%out_ok, L_CHAR_DEC16_BMP_%out_ok

L_CHAR_DEC16_BMP_%out_ok:
    %out_char = add %lead, 0
    %out_units = add 0, 1
    %out_ok = add 0, 1
    !__char_dec16_is_low_alone_%out_ok
    !__char_dec16_low_le_alone_%out_ok
    !__char_dec16_low_ge_alone_%out_ok
    !__char_dec16_is_high_%out_ok
    !__char_dec16_high_le_%out_ok
    !__char_dec16_high_ge_%out_ok
    jmp L_CHAR_DEC16_END_%out_ok

L_CHAR_DEC16_ERR_LOW_%out_ok:
    %out_char = add 0, 0
    %out_units = add 0, 1
    %out_ok = add 0, 0
    !__char_dec16_is_low_alone_%out_ok
    !__char_dec16_low_le_alone_%out_ok
    !__char_dec16_low_ge_alone_%out_ok
    !__char_dec16_is_high_%out_ok
    !__char_dec16_high_le_%out_ok
    !__char_dec16_high_ge_%out_ok
    jmp L_CHAR_DEC16_END_%out_ok

L_CHAR_DEC16_HIGH_%out_ok:
    __char_dec16_trail_ge_%out_ok = uge %trail, CHAR_UTF16_LOW_SURROGATE_MIN
    __char_dec16_trail_le_%out_ok = ule %trail, CHAR_UTF16_LOW_SURROGATE_MAX
    __char_dec16_trail_ok_%out_ok = and __char_dec16_trail_ge_%out_ok, __char_dec16_trail_le_%out_ok
    br __char_dec16_trail_ok_%out_ok -> L_CHAR_DEC16_PAIR_%out_ok, L_CHAR_DEC16_ERR_HIGH_%out_ok

L_CHAR_DEC16_PAIR_%out_ok:
    __char_dec16_high_part_%out_ok = sub %lead, CHAR_UTF16_HIGH_SURROGATE_MIN
    __char_dec16_high_shift_%out_ok = shl __char_dec16_high_part_%out_ok, 10
    __char_dec16_low_part_%out_ok = sub %trail, CHAR_UTF16_LOW_SURROGATE_MIN
    __char_dec16_pair_payload_%out_ok = or __char_dec16_high_shift_%out_ok, __char_dec16_low_part_%out_ok
    %out_char = add __char_dec16_pair_payload_%out_ok, CHAR_UTF16_SUPPLEMENTARY_BASE
    %out_units = add 0, 2
    %out_ok = add 0, 1
    !__char_dec16_pair_payload_%out_ok
    !__char_dec16_low_part_%out_ok
    !__char_dec16_high_shift_%out_ok
    !__char_dec16_high_part_%out_ok
    !__char_dec16_trail_ok_%out_ok
    !__char_dec16_trail_le_%out_ok
    !__char_dec16_trail_ge_%out_ok
    !__char_dec16_is_high_%out_ok
    !__char_dec16_high_le_%out_ok
    !__char_dec16_high_ge_%out_ok
    jmp L_CHAR_DEC16_END_%out_ok

L_CHAR_DEC16_ERR_HIGH_%out_ok:
    %out_char = add 0, 0
    %out_units = add 0, 1
    %out_ok = add 0, 0
    !__char_dec16_trail_ok_%out_ok
    !__char_dec16_trail_le_%out_ok
    !__char_dec16_trail_ge_%out_ok
    !__char_dec16_is_high_%out_ok
    !__char_dec16_high_le_%out_ok
    !__char_dec16_high_ge_%out_ok

L_CHAR_DEC16_END_%out_ok:
[END_MACRO]
