    __bound_u64_as_ref_tag_%dst_bound_ref_ptr = load %src_bound_ptr+BoundU64_tag as u64
    __bound_u64_as_ref_unbounded_%dst_bound_ref_ptr = eq __bound_u64_as_ref_tag_%dst_bound_ref_ptr, BOUND_U64_UNBOUNDED
    store %dst_bound_ref_ptr+BoundU64Ref_tag, __bound_u64_as_ref_tag_%dst_bound_ref_ptr as u64
    br __bound_u64_as_ref_unbounded_%dst_bound_ref_ptr -> L_BOUND_U64_AS_REF_UNBOUNDED_%dst_bound_ref_ptr, L_BOUND_U64_AS_REF_VALUE_%dst_bound_ref_ptr

L_BOUND_U64_AS_REF_VALUE_%dst_bound_ref_ptr:
    __bound_u64_as_ref_ptr_%dst_bound_ref_ptr = ptr_add %src_bound_ptr, BoundU64_value
    store %dst_bound_ref_ptr+BoundU64Ref_ptr, __bound_u64_as_ref_ptr_%dst_bound_ref_ptr as ptr
    !__bound_u64_as_ref_ptr_%dst_bound_ref_ptr
    !__bound_u64_as_ref_unbounded_%dst_bound_ref_ptr
    !__bound_u64_as_ref_tag_%dst_bound_ref_ptr
    jmp L_BOUND_U64_AS_REF_DONE_%dst_bound_ref_ptr

L_BOUND_U64_AS_REF_UNBOUNDED_%dst_bound_ref_ptr:
    store %dst_bound_ref_ptr+BoundU64Ref_ptr, 0 as u64
    !__bound_u64_as_ref_unbounded_%dst_bound_ref_ptr
    !__bound_u64_as_ref_tag_%dst_bound_ref_ptr

L_BOUND_U64_AS_REF_DONE_%dst_bound_ref_ptr:
[END_MACRO]

[MACRO] BOUND_U64_AS_MUT %dst_bound_ref_ptr, %src_bound_ptr
    EXPAND BOUND_U64_AS_REF %dst_bound_ref_ptr, %src_bound_ptr
[END_MACRO]

[MACRO] BOUND_U64_REF_TAG %out_tag, %bound_ref_ptr
    %out_tag = load %bound_ref_ptr+BoundU64Ref_tag as u64
[END_MACRO]

[MACRO] BOUND_U64_REF_PTR %out_ptr, %bound_ref_ptr
    %out_ptr = load %bound_ref_ptr+BoundU64Ref_ptr as ptr
[END_MACRO]

[MACRO] BOUND_U64_REF_COPIED %dst_bound_ptr, %src_bound_ref_ptr
    __bound_u64_ref_copied_tag_%dst_bound_ptr = load %src_bound_ref_ptr+BoundU64Ref_tag as u64
    __bound_u64_ref_copied_unbounded_%dst_bound_ptr = eq __bound_u64_ref_copied_tag_%dst_bound_ptr, BOUND_U64_UNBOUNDED
    store %dst_bound_ptr+BoundU64_tag, __bound_u64_ref_copied_tag_%dst_bound_ptr as u64
    br __bound_u64_ref_copied_unbounded_%dst_bound_ptr -> L_BOUND_U64_REF_COPIED_UNBOUNDED_%dst_bound_ptr, L_BOUND_U64_REF_COPIED_VALUE_%dst_bound_ptr

L_BOUND_U64_REF_COPIED_VALUE_%dst_bound_ptr:
    __bound_u64_ref_copied_ptr_%dst_bound_ptr = load %src_bound_ref_ptr+BoundU64Ref_ptr as ptr
    __bound_u64_ref_copied_value_%dst_bound_ptr = load __bound_u64_ref_copied_ptr_%dst_bound_ptr+0 as u64
    store %dst_bound_ptr+BoundU64_value, __bound_u64_ref_copied_value_%dst_bound_ptr as u64
    !__bound_u64_ref_copied_value_%dst_bound_ptr
    !__bound_u64_ref_copied_ptr_%dst_bound_ptr
    !__bound_u64_ref_copied_unbounded_%dst_bound_ptr
    !__bound_u64_ref_copied_tag_%dst_bound_ptr
    jmp L_BOUND_U64_REF_COPIED_DONE_%dst_bound_ptr

L_BOUND_U64_REF_COPIED_UNBOUNDED_%dst_bound_ptr:
    store %dst_bound_ptr+BoundU64_value, 0 as u64
    !__bound_u64_ref_copied_unbounded_%dst_bound_ptr
    !__bound_u64_ref_copied_tag_%dst_bound_ptr

L_BOUND_U64_REF_COPIED_DONE_%dst_bound_ptr:
[END_MACRO]

[MACRO] BOUND_U64_REF_CLONED %dst_bound_ptr, %src_bound_ref_ptr
    EXPAND BOUND_U64_REF_COPIED %dst_bound_ptr, %src_bound_ref_ptr
[END_MACRO]

[MACRO] BOUND_U64_IS_UNBOUNDED %out_bool, %bound_ptr
    __bound_tag_%out_bool = load %bound_ptr+BoundU64_tag as u64
    %out_bool = eq __bound_tag_%out_bool, BOUND_U64_UNBOUNDED
    !__bound_tag_%out_bool
[END_MACRO]

[MACRO] BOUND_U64_IS_INCLUDED %out_bool, %bound_ptr
    __bound_tag_%out_bool = load %bound_ptr+BoundU64_tag as u64
    %out_bool = eq __bound_tag_%out_bool, BOUND_U64_INCLUDED
    !__bound_tag_%out_bool
[END_MACRO]

[MACRO] BOUND_U64_IS_EXCLUDED %out_bool, %bound_ptr
    __bound_tag_%out_bool = load %bound_ptr+BoundU64_tag as u64
    %out_bool = eq __bound_tag_%out_bool, BOUND_U64_EXCLUDED
    !__bound_tag_%out_bool
[END_MACRO]

[MACRO] BOUND_U64_CONTAINS_START %out_bool, %bound_ptr, %item
    __bound_start_tag_%out_bool = load %bound_ptr+BoundU64_tag as u64
    __bound_start_unbounded_%out_bool = eq __bound_start_tag_%out_bool, BOUND_U64_UNBOUNDED
    br __bound_start_unbounded_%out_bool -> L_BOUND_START_TRUE_%out_bool, L_BOUND_START_CHECK_%out_bool

L_BOUND_START_CHECK_%out_bool:
    __bound_start_value_%out_bool = load %bound_ptr+BoundU64_value as u64
    __bound_start_included_%out_bool = eq __bound_start_tag_%out_bool, BOUND_U64_INCLUDED
    br __bound_start_included_%out_bool -> L_BOUND_START_INCLUDED_%out_bool, L_BOUND_START_EXCLUDED_%out_bool

L_BOUND_START_INCLUDED_%out_bool:
    %out_bool = ule __bound_start_value_%out_bool, %item
    !__bound_start_included_%out_bool
    !__bound_start_value_%out_bool
    !__bound_start_unbounded_%out_bool
    !__bound_start_tag_%out_bool
    jmp L_BOUND_START_END_%out_bool

L_BOUND_START_EXCLUDED_%out_bool:
    %out_bool = ult __bound_start_value_%out_bool, %item
    !__bound_start_included_%out_bool
    !__bound_start_value_%out_bool
    !__bound_start_unbounded_%out_bool
    !__bound_start_tag_%out_bool
    jmp L_BOUND_START_END_%out_bool

L_BOUND_START_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__bound_start_unbounded_%out_bool
    !__bound_start_tag_%out_bool

L_BOUND_START_END_%out_bool:
[END_MACRO]

[MACRO] BOUND_U64_CONTAINS_END %out_bool, %bound_ptr, %item
    __bound_end_tag_%out_bool = load %bound_ptr+BoundU64_tag as u64
    __bound_end_unbounded_%out_bool = eq __bound_end_tag_%out_bool, BOUND_U64_UNBOUNDED
    br __bound_end_unbounded_%out_bool -> L_BOUND_END_TRUE_%out_bool, L_BOUND_END_CHECK_%out_bool

L_BOUND_END_CHECK_%out_bool:
    __bound_end_value_%out_bool = load %bound_ptr+BoundU64_value as u64
    __bound_end_included_%out_bool = eq __bound_end_tag_%out_bool, BOUND_U64_INCLUDED
    br __bound_end_included_%out_bool -> L_BOUND_END_INCLUDED_%out_bool, L_BOUND_END_EXCLUDED_%out_bool

L_BOUND_END_INCLUDED_%out_bool:
    %out_bool = ule %item, __bound_end_value_%out_bool
    !__bound_end_included_%out_bool
    !__bound_end_value_%out_bool
    !__bound_end_unbounded_%out_bool
    !__bound_end_tag_%out_bool
    jmp L_BOUND_END_END_%out_bool

L_BOUND_END_EXCLUDED_%out_bool:
    %out_bool = ult %item, __bound_end_value_%out_bool
    !__bound_end_included_%out_bool
    !__bound_end_value_%out_bool
    !__bound_end_unbounded_%out_bool
    !__bound_end_tag_%out_bool
    jmp L_BOUND_END_END_%out_bool

L_BOUND_END_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__bound_end_unbounded_%out_bool
    !__bound_end_tag_%out_bool

L_BOUND_END_END_%out_bool:
[END_MACRO]

[MACRO] BOUND_U64_RANGE_CONTAINS %out_bool, %start_bound_ptr, %end_bound_ptr, %item
    EXPAND BOUND_U64_CONTAINS_START __bound_range_start_%out_bool, %start_bound_ptr, %item
    EXPAND BOUND_U64_CONTAINS_END __bound_range_end_%out_bool, %end_bound_ptr, %item
    %out_bool = and __bound_range_start_%out_bool, __bound_range_end_%out_bool
    !__bound_range_end_%out_bool
    !__bound_range_start_%out_bool
[END_MACRO]

[MACRO] BOUND_U64_RANGE_IS_EMPTY %out_bool, %start_bound_ptr, %end_bound_ptr
    __bound_u64_empty_start_tag_%out_bool = load %start_bound_ptr+BoundU64_tag as u64
    __bound_u64_empty_end_tag_%out_bool = load %end_bound_ptr+BoundU64_tag as u64
    __bound_u64_empty_start_unbounded_%out_bool = eq __bound_u64_empty_start_tag_%out_bool, BOUND_U64_UNBOUNDED
    __bound_u64_empty_end_unbounded_%out_bool = eq __bound_u64_empty_end_tag_%out_bool, BOUND_U64_UNBOUNDED
    __bound_u64_empty_unbounded_%out_bool = or __bound_u64_empty_start_unbounded_%out_bool, __bound_u64_empty_end_unbounded_%out_bool
    br __bound_u64_empty_unbounded_%out_bool -> L_BOUND_U64_EMPTY_FALSE_%out_bool, L_BOUND_U64_EMPTY_CHECK_%out_bool

L_BOUND_U64_EMPTY_CHECK_%out_bool:
    __bound_u64_empty_start_value_%out_bool = load %start_bound_ptr+BoundU64_value as u64
    __bound_u64_empty_end_value_%out_bool = load %end_bound_ptr+BoundU64_value as u64
    __bound_u64_empty_start_included_%out_bool = eq __bound_u64_empty_start_tag_%out_bool, BOUND_U64_INCLUDED
    __bound_u64_empty_end_included_%out_bool = eq __bound_u64_empty_end_tag_%out_bool, BOUND_U64_INCLUDED
    __bound_u64_empty_both_included_%out_bool = and __bound_u64_empty_start_included_%out_bool, __bound_u64_empty_end_included_%out_bool
    br __bound_u64_empty_both_included_%out_bool -> L_BOUND_U64_EMPTY_INCLUDED_%out_bool, L_BOUND_U64_EMPTY_STRICT_%out_bool

L_BOUND_U64_EMPTY_INCLUDED_%out_bool:
    __bound_u64_empty_valid_inc_%out_bool = ule __bound_u64_empty_start_value_%out_bool, __bound_u64_empty_end_value_%out_bool
    %out_bool = eq __bound_u64_empty_valid_inc_%out_bool, 0
    !__bound_u64_empty_valid_inc_%out_bool
    !__bound_u64_empty_both_included_%out_bool
    !__bound_u64_empty_end_included_%out_bool
    !__bound_u64_empty_start_included_%out_bool
    !__bound_u64_empty_end_value_%out_bool
    !__bound_u64_empty_start_value_%out_bool
    !__bound_u64_empty_unbounded_%out_bool
    !__bound_u64_empty_end_unbounded_%out_bool
    !__bound_u64_empty_start_unbounded_%out_bool
    !__bound_u64_empty_end_tag_%out_bool
    !__bound_u64_empty_start_tag_%out_bool
    jmp L_BOUND_U64_EMPTY_DONE_%out_bool

L_BOUND_U64_EMPTY_STRICT_%out_bool:
    __bound_u64_empty_valid_strict_%out_bool = ult __bound_u64_empty_start_value_%out_bool, __bound_u64_empty_end_value_%out_bool
    %out_bool = eq __bound_u64_empty_valid_strict_%out_bool, 0
    !__bound_u64_empty_valid_strict_%out_bool
    !__bound_u64_empty_both_included_%out_bool
    !__bound_u64_empty_end_included_%out_bool
    !__bound_u64_empty_start_included_%out_bool
    !__bound_u64_empty_end_value_%out_bool
    !__bound_u64_empty_start_value_%out_bool
    !__bound_u64_empty_unbounded_%out_bool
    !__bound_u64_empty_end_unbounded_%out_bool
    !__bound_u64_empty_start_unbounded_%out_bool
    !__bound_u64_empty_end_tag_%out_bool
    !__bound_u64_empty_start_tag_%out_bool
    jmp L_BOUND_U64_EMPTY_DONE_%out_bool

L_BOUND_U64_EMPTY_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__bound_u64_empty_unbounded_%out_bool
    !__bound_u64_empty_end_unbounded_%out_bool
    !__bound_u64_empty_start_unbounded_%out_bool
    !__bound_u64_empty_end_tag_%out_bool
    !__bound_u64_empty_start_tag_%out_bool

L_BOUND_U64_EMPTY_DONE_%out_bool:
[END_MACRO]

