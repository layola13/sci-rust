    store %control_flow_ptr+ControlFlowU64_value, %value as u64
[END_MACRO]

// Rust method-name alias over CONTROL_FLOW_CONTINUE_U64.
[MACRO] CONTROL_FLOW_CONTINUE %control_flow_ptr, %value
