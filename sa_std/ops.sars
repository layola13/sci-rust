    __control_flow_map_break_mapped_%out_control_flow_ptr = call %map_fn(__control_flow_map_break_value_%out_control_flow_ptr)
    store %out_control_flow_ptr+ControlFlowU64_tag, CONTROL_FLOW_BREAK as u64
    store %out_control_flow_ptr+ControlFlowU64_value, __control_flow_map_break_mapped_%out_control_flow_ptr as u64
    !__control_flow_map_break_mapped_%out_control_flow_ptr
    !__control_flow_map_break_is_break_%out_control_flow_ptr
