L_BOUND_U64_MAP_UNBOUNDED_%dst_bound_ptr:
    store %dst_bound_ptr+BoundU64_tag, BOUND_U64_UNBOUNDED as u64
    store %dst_bound_ptr+BoundU64_value, 0 as u64
    !__bound_u64_map_unbounded_%dst_bound_ptr
    !__bound_u64_map_tag_%dst_bound_ptr

L_BOUND_U64_MAP_DONE_%dst_bound_ptr:
[END_MACRO]

