    __bound_u64_map_mapped_%dst_bound_ptr = call %map_fn(__bound_u64_map_value_%dst_bound_ptr)
    store %dst_bound_ptr+BoundU64_tag, __bound_u64_map_tag_%dst_bound_ptr as u64
    store %dst_bound_ptr+BoundU64_value, __bound_u64_map_mapped_%dst_bound_ptr as u64
    !__bound_u64_map_mapped_%dst_bound_ptr
    !__bound_u64_map_value_%dst_bound_ptr
    !__bound_u64_map_unbounded_%dst_bound_ptr
    !__bound_u64_map_tag_%dst_bound_ptr
