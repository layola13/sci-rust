[END_MACRO]

[MACRO] ERROR_REF_IS_INTERRUPTED %out_bool, %error_ref
    EXPAND ERROR_REF_CODE_EQ %out_bool, %error_ref, ERROR_CODE_INTERRUPTED
[END_MACRO]

[MACRO] ERROR_REF_IS_CONNECTION_REFUSED %out_bool, %error_ref
    EXPAND ERROR_REF_CODE_EQ %out_bool, %error_ref, ERROR_CODE_CONNECTION_REFUSED
[END_MACRO]

[MACRO] ERROR_REF_IS_CONNECTION_RESET %out_bool, %error_ref
