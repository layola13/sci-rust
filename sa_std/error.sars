[END_MACRO]

[MACRO] ERROR_REF_IS_CONNECTION_ABORTED %out_bool, %error_ref
    EXPAND ERROR_REF_CODE_EQ %out_bool, %error_ref, ERROR_CODE_CONNECTION_ABORTED
[END_MACRO]

[MACRO] ERROR_REF_IS_NOT_CONNECTED %out_bool, %error_ref
