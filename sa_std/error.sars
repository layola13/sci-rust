    EXPAND ERROR_REF_CODE_EQ %out_bool, %error_ref, ERROR_CODE_BROKEN_PIPE
[END_MACRO]

[MACRO] ERROR_REF_IS_ALREADY_EXISTS %out_bool, %error_ref
    EXPAND ERROR_REF_CODE_EQ %out_bool, %error_ref, ERROR_CODE_ALREADY_EXISTS
