[END_MACRO]

[MACRO] ERROR_REF_IS_ADDR_IN_USE %out_bool, %error_ref
    EXPAND ERROR_REF_CODE_EQ %out_bool, %error_ref, ERROR_CODE_ADDR_IN_USE
[END_MACRO]

[MACRO] ERROR_REF_IS_ADDR_NOT_AVAILABLE %out_bool, %error_ref
