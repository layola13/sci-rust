@import "dtls.sal"
@import "dtls.sai"

[MACRO] DTLS_SUPPORTED %out_status, %out_supported
    __dtls_supported_%out_status = stack_alloc 4
    %out_status = call @sa_std_dtls_supported(&__dtls_supported_%out_status)
    %out_supported = load __dtls_supported_%out_status+0 as u32
[END_MACRO]

[MACRO] DTLS_SERVER_CTX_CREATE %out_status, %out_ctx, %cert_path, %cert_path_len, %key_path, %key_path_len
    __dtls_ctx_%out_status = stack_alloc 8
    %out_status = call @sa_std_dtls_server_ctx_create(&%cert_path, %cert_path_len, &%key_path, %key_path_len, &__dtls_ctx_%out_status)
    %out_ctx = load __dtls_ctx_%out_status+0 as u64
[END_MACRO]

[MACRO] DTLS_SERVER_CTX_FREE %out_status, %ctx
    %out_status = call @sa_std_dtls_server_ctx_free(%ctx)
[END_MACRO]

[MACRO] DTLS_SERVER_ACCEPT %out_status, %out_ssl, %ctx, %fd
    __dtls_ssl_%out_status = stack_alloc 8
    %out_status = call @sa_std_dtls_server_accept(%ctx, %fd, &__dtls_ssl_%out_status)
    %out_ssl = load __dtls_ssl_%out_status+0 as u64
[END_MACRO]

[MACRO] DTLS_SERVER_READ %out_status, %out_read, %ssl, %buf, %cap
    __dtls_read_len_%out_status = stack_alloc 8
    %out_status = call @sa_std_dtls_server_read(%ssl, &%buf, %cap, &__dtls_read_len_%out_status)
    %out_read = load __dtls_read_len_%out_status+0 as u64
[END_MACRO]

[MACRO] DTLS_SERVER_WRITE %out_status, %out_written, %ssl, %buf, %len
    __dtls_written_%out_status = stack_alloc 8
    %out_status = call @sa_std_dtls_server_write(%ssl, &%buf, %len, &__dtls_written_%out_status)
    %out_written = load __dtls_written_%out_status+0 as u64
[END_MACRO]

[MACRO] DTLS_SERVER_CLOSE %out_status, %ssl
    %out_status = call @sa_std_dtls_server_close(%ssl)
[END_MACRO]

[MACRO] DTLS_STATUS_JSON %out_status, %out_buffer
    __dtls_status_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_dtls_status_json(&__dtls_status_handle_%out_status)
    %out_buffer = load __dtls_status_handle_%out_status+0 as u64
[END_MACRO]

// buffer handle accessors (sci convention)

[MACRO] DTLS_BUFFER_DATA %out_ptr, %buffer
    %out_ptr = call @sa_std_dtls_buffer_data(%buffer)
[END_MACRO]

[MACRO] DTLS_BUFFER_LEN %out_len, %buffer
    %out_len = call @sa_std_dtls_buffer_len(%buffer)
[END_MACRO]

[MACRO] DTLS_BUFFER_FREE %out_status, %buffer
    %out_status = call @sa_std_dtls_buffer_free(^%buffer)
[END_MACRO]
