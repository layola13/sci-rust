[MACRO] LINKED_LIST_RETAIN %out_len, %list_reg, %pred_fn
    EXPAND LINKED_LIST_NEW __ll_ret_keep_%out_len
    jmp L_LL_RET_HEAD_%out_len
L_LL_RET_HEAD_%out_len:
    EXPAND LINKED_LIST_TRY_POP_FRONT __ll_ret_ok_%out_len, __ll_ret_val_%out_len, %list_reg
    br __ll_ret_ok_%out_len -> L_LL_RET_BODY_%out_len, L_LL_RET_DONE_%out_len
L_LL_RET_BODY_%out_len:
    __ll_ret_keep_flag_%out_len = call %pred_fn(__ll_ret_val_%out_len)
    __ll_ret_keep_it_%out_len = ne __ll_ret_keep_flag_%out_len, 0
    br __ll_ret_keep_it_%out_len -> L_LL_RET_KEEP_%out_len, L_LL_RET_DROP_%out_len
L_LL_RET_KEEP_%out_len:
    EXPAND LINKED_LIST_PUSH_BACK __ll_ret_keep_%out_len, __ll_ret_val_%out_len
    jmp L_LL_RET_NEXT_%out_len
L_LL_RET_DROP_%out_len:
    jmp L_LL_RET_NEXT_%out_len
L_LL_RET_NEXT_%out_len:
    !__ll_ret_keep_it_%out_len
    !__ll_ret_keep_flag_%out_len
    !__ll_ret_val_%out_len
    !__ll_ret_ok_%out_len
    jmp L_LL_RET_HEAD_%out_len
L_LL_RET_DONE_%out_len:
    EXPAND LINKED_LIST_APPEND %list_reg, __ll_ret_keep_%out_len
    EXPAND LINKED_LIST_LEN %out_len, %list_reg
    !__ll_ret_val_%out_len
    !__ll_ret_ok_%out_len
    !__ll_ret_keep_%out_len
[END_MACRO]

