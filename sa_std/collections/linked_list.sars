[MACRO] LINKED_LIST_POP_FRONT_IF %out_ok, %out_value, %list_reg, %pred_fn
    EXPAND LINKED_LIST_TRY_FRONT __ll_pfi_fok_%out_ok, __ll_pfi_fval_%out_ok, %list_reg
    br __ll_pfi_fok_%out_ok -> L_LL_PFI_CHECK_%out_ok, L_LL_PFI_EMPTY_%out_ok
L_LL_PFI_CHECK_%out_ok:
    __ll_pfi_pred_%out_ok = call %pred_fn(__ll_pfi_fval_%out_ok)
    __ll_pfi_take_%out_ok = ne __ll_pfi_pred_%out_ok, 0
    br __ll_pfi_take_%out_ok -> L_LL_PFI_TAKE_%out_ok, L_LL_PFI_KEEP_%out_ok
L_LL_PFI_TAKE_%out_ok:
    EXPAND LINKED_LIST_TRY_POP_FRONT %out_ok, %out_value, %list_reg
    !__ll_pfi_take_%out_ok
    !__ll_pfi_pred_%out_ok
    !__ll_pfi_fval_%out_ok
    !__ll_pfi_fok_%out_ok
    jmp L_LL_PFI_END_%out_ok
L_LL_PFI_KEEP_%out_ok:
    %out_ok = 0
    %out_value = 0
    !__ll_pfi_take_%out_ok
    !__ll_pfi_pred_%out_ok
    !__ll_pfi_fval_%out_ok
    !__ll_pfi_fok_%out_ok
    jmp L_LL_PFI_END_%out_ok
L_LL_PFI_EMPTY_%out_ok:
    %out_ok = 0
    %out_value = 0
    !__ll_pfi_fval_%out_ok
    !__ll_pfi_fok_%out_ok
L_LL_PFI_END_%out_ok:
[END_MACRO]

[MACRO] LINKED_LIST_POP_BACK_IF %out_ok, %out_value, %list_reg, %pred_fn
    EXPAND LINKED_LIST_TRY_BACK __ll_pbi_bok_%out_ok, __ll_pbi_bval_%out_ok, %list_reg
    br __ll_pbi_bok_%out_ok -> L_LL_PBI_CHECK_%out_ok, L_LL_PBI_EMPTY_%out_ok
L_LL_PBI_CHECK_%out_ok:
    __ll_pbi_pred_%out_ok = call %pred_fn(__ll_pbi_bval_%out_ok)
    __ll_pbi_take_%out_ok = ne __ll_pbi_pred_%out_ok, 0
    br __ll_pbi_take_%out_ok -> L_LL_PBI_TAKE_%out_ok, L_LL_PBI_KEEP_%out_ok
L_LL_PBI_TAKE_%out_ok:
    EXPAND LINKED_LIST_TRY_POP_BACK %out_ok, %out_value, %list_reg
    !__ll_pbi_take_%out_ok
    !__ll_pbi_pred_%out_ok
    !__ll_pbi_bval_%out_ok
    !__ll_pbi_bok_%out_ok
    jmp L_LL_PBI_END_%out_ok
L_LL_PBI_KEEP_%out_ok:
    %out_ok = 0
    %out_value = 0
    !__ll_pbi_take_%out_ok
    !__ll_pbi_pred_%out_ok
    !__ll_pbi_bval_%out_ok
    !__ll_pbi_bok_%out_ok
    jmp L_LL_PBI_END_%out_ok
L_LL_PBI_EMPTY_%out_ok:
    %out_ok = 0
    %out_value = 0
    !__ll_pbi_bval_%out_ok
    !__ll_pbi_bok_%out_ok
L_LL_PBI_END_%out_ok:
[END_MACRO]

// Cursor-style raw node pointers (not Rust Cursor safety).
[MACRO] LINKED_LIST_CURSOR_FRONT %out_ok, %out_node, %list_reg
    %out_node = load %list_reg+LinkedList_head as ptr
    __ll_cf_null_%out_ok = 0 as ptr
    %out_ok = ne %out_node, __ll_cf_null_%out_ok
    !__ll_cf_null_%out_ok
[END_MACRO]

[MACRO] LINKED_LIST_CURSOR_BACK %out_ok, %out_node, %list_reg
    %out_node = load %list_reg+LinkedList_tail as ptr
    __ll_cb_null_%out_ok = 0 as ptr
    %out_ok = ne %out_node, __ll_cb_null_%out_ok
    !__ll_cb_null_%out_ok
[END_MACRO]

[MACRO] LINKED_LIST_CURSOR_NEXT %out_ok, %out_node, %node_reg
    %out_node = load %node_reg+LinkedListNode_next as ptr
    __ll_cn_null_%out_ok = 0 as ptr
    %out_ok = ne %out_node, __ll_cn_null_%out_ok
    !__ll_cn_null_%out_ok
[END_MACRO]

[MACRO] LINKED_LIST_CURSOR_PREV %out_ok, %out_node, %node_reg
    %out_node = load %node_reg+LinkedListNode_prev as ptr
    __ll_cp_null_%out_ok = 0 as ptr
    %out_ok = ne %out_node, __ll_cp_null_%out_ok
    !__ll_cp_null_%out_ok
[END_MACRO]

[MACRO] LINKED_LIST_CURSOR_VALUE %out_value, %node_reg
    %out_value = load %node_reg+LinkedListNode_value as u64
[END_MACRO]

[MACRO] LINKED_LIST_CURSOR_SET_VALUE %node_reg, %value
    store %node_reg+LinkedListNode_value, %value as u64
[END_MACRO]

[MACRO] LINKED_LIST_EXTRACT_IF %out_len, %out_list, %list_reg, %pred_fn
    EXPAND LINKED_LIST_NEW %out_list
    EXPAND LINKED_LIST_NEW __ll_ei_keep_%out_len
    jmp L_LL_EI_HEAD_%out_len
L_LL_EI_HEAD_%out_len:
    EXPAND LINKED_LIST_TRY_POP_FRONT __ll_ei_ok_%out_len, __ll_ei_val_%out_len, %list_reg
    br __ll_ei_ok_%out_len -> L_LL_EI_BODY_%out_len, L_LL_EI_DONE_%out_len
L_LL_EI_BODY_%out_len:
    __ll_ei_pred_%out_len = call %pred_fn(__ll_ei_val_%out_len)
    __ll_ei_take_%out_len = ne __ll_ei_pred_%out_len, 0
    br __ll_ei_take_%out_len -> L_LL_EI_TAKE_%out_len, L_LL_EI_KEEP_%out_len
L_LL_EI_TAKE_%out_len:
    EXPAND LINKED_LIST_PUSH_BACK %out_list, __ll_ei_val_%out_len
    jmp L_LL_EI_NEXT_%out_len
L_LL_EI_KEEP_%out_len:
    EXPAND LINKED_LIST_PUSH_BACK __ll_ei_keep_%out_len, __ll_ei_val_%out_len
    jmp L_LL_EI_NEXT_%out_len
L_LL_EI_NEXT_%out_len:
    !__ll_ei_take_%out_len
    !__ll_ei_pred_%out_len
    !__ll_ei_val_%out_len
    !__ll_ei_ok_%out_len
    jmp L_LL_EI_HEAD_%out_len
L_LL_EI_DONE_%out_len:
    EXPAND LINKED_LIST_APPEND %list_reg, __ll_ei_keep_%out_len
    EXPAND LINKED_LIST_LEN %out_len, %out_list
    !__ll_ei_val_%out_len
    !__ll_ei_ok_%out_len
    !__ll_ei_keep_%out_len
[END_MACRO]

[MACRO] LINKED_LIST_FROM_ARRAY %out_list, %array_ptr, %length
    EXPAND LINKED_LIST_NEW %out_list
    __ll_fa_i_slot_%out_list = stack_alloc 8
    store __ll_fa_i_slot_%out_list+0, 0 as u64
    jmp L_LL_FA_HEAD_%out_list
L_LL_FA_HEAD_%out_list:
    __ll_fa_i_%out_list = load __ll_fa_i_slot_%out_list+0 as u64
    __ll_fa_done_%out_list = eq __ll_fa_i_%out_list, %length
    br __ll_fa_done_%out_list -> L_LL_FA_DONE_%out_list, L_LL_FA_BODY_%out_list
L_LL_FA_BODY_%out_list:
    __ll_fa_off_%out_list = mul __ll_fa_i_%out_list, 8
    __ll_fa_ptr_%out_list = ptr_add %array_ptr, __ll_fa_off_%out_list
    __ll_fa_val_%out_list = load __ll_fa_ptr_%out_list+0 as u64
    EXPAND LINKED_LIST_PUSH_BACK %out_list, __ll_fa_val_%out_list
    __ll_fa_ni_%out_list = add __ll_fa_i_%out_list, 1
    store __ll_fa_i_slot_%out_list+0, __ll_fa_ni_%out_list as u64
    !__ll_fa_ni_%out_list
    !__ll_fa_val_%out_list
    !__ll_fa_ptr_%out_list
    !__ll_fa_off_%out_list
    !__ll_fa_done_%out_list
    !__ll_fa_i_%out_list
    jmp L_LL_FA_HEAD_%out_list
L_LL_FA_DONE_%out_list:
    !__ll_fa_done_%out_list
    !__ll_fa_i_%out_list
[END_MACRO]

[MACRO] LINKED_LIST_INSERT_AFTER %list_reg, %node_reg, %value
    call @sa_linked_list_insert_after(&%list_reg, %node_reg, %value)
[END_MACRO]

[MACRO] LINKED_LIST_INSERT_BEFORE %list_reg, %node_reg, %value
