[END_MACRO]

[MACRO] LINKED_LIST_CLONE %out_list, %list_reg
    %out_list = call @sa_linked_list_clone(&%list_reg)
[END_MACRO]

[MACRO] LINKED_LIST_EQ %out_bool, %left_list, %right_list
    %out_bool = call @sa_linked_list_eq(&%left_list, &%right_list)
[END_MACRO]

[MACRO] LINKED_LIST_NE %out_bool, %left_list, %right_list
    __ll_ne_eq_%out_bool = call @sa_linked_list_eq(&%left_list, &%right_list)
    %out_bool = eq __ll_ne_eq_%out_bool, 0
    !__ll_ne_eq_%out_bool
[END_MACRO]
