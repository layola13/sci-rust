    !__num_u32_next_mul_rhs_%out_ok
    !__num_u32_next_mul_value_%out_ok
    jmp L_NUM_U32_NEXT_MUL_END_%out_ok

L_NUM_U32_NEXT_MUL_ALIGNED_%out_ok:
    %out_value = add __num_u32_next_mul_value_%out_ok, 0
    %out_ok = add 0, 1
    !__num_u32_next_mul_aligned_%out_ok
    !__num_u32_next_mul_rem_%out_ok
    !__num_u32_next_mul_zero_rhs_%out_ok
    !__num_u32_next_mul_rhs_%out_ok
    !__num_u32_next_mul_value_%out_ok
    jmp L_NUM_U32_NEXT_MUL_END_%out_ok

L_NUM_U32_NEXT_MUL_ZERO_RHS_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_u32_next_mul_zero_rhs_%out_ok
    !__num_u32_next_mul_rhs_%out_ok
    !__num_u32_next_mul_value_%out_ok

L_NUM_U32_NEXT_MUL_END_%out_ok:
[END_MACRO]

