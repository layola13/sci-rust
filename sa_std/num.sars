    __num_uw_cmul_rhs_bit_%out_low = and __num_uw_cmul_rhs_%out_low, 1
    __num_uw_cmul_selected_low_%out_low = mul __num_uw_cmul_term_low_%out_low, __num_uw_cmul_rhs_bit_%out_low
    __num_uw_cmul_selected_high_%out_low = mul __num_uw_cmul_term_high_%out_low, __num_uw_cmul_rhs_bit_%out_low
    __num_uw_cmul_sum_low_raw_%out_low = add __num_uw_cmul_acc_low_%out_low, __num_uw_cmul_selected_low_%out_low
    __num_uw_cmul_sum_low_%out_low = and __num_uw_cmul_sum_low_raw_%out_low, %mask
    __num_uw_cmul_carry_low_%out_low = ult __num_uw_cmul_sum_low_%out_low, __num_uw_cmul_acc_low_%out_low
    __num_uw_cmul_sum_high_raw_%out_low = add __num_uw_cmul_acc_high_%out_low, __num_uw_cmul_selected_high_%out_low
    __num_uw_cmul_sum_high_mid_%out_low = and __num_uw_cmul_sum_high_raw_%out_low, %mask
    __num_uw_cmul_sum_high_plus_carry_%out_low = add __num_uw_cmul_sum_high_mid_%out_low, __num_uw_cmul_carry_low_%out_low
    __num_uw_cmul_sum_high_%out_low = and __num_uw_cmul_sum_high_plus_carry_%out_low, %mask
    __num_uw_cmul_term_carry_%out_low = lshr __num_uw_cmul_term_low_%out_low, __num_uw_cmul_top_shift_%out_low
    __num_uw_cmul_next_term_low_raw_%out_low = shl __num_uw_cmul_term_low_%out_low, 1
    __num_uw_cmul_next_term_low_%out_low = and __num_uw_cmul_next_term_low_raw_%out_low, %mask
    __num_uw_cmul_next_term_high_raw_%out_low = shl __num_uw_cmul_term_high_%out_low, 1
    __num_uw_cmul_next_term_high_or_%out_low = or __num_uw_cmul_next_term_high_raw_%out_low, __num_uw_cmul_term_carry_%out_low
    __num_uw_cmul_next_term_high_%out_low = and __num_uw_cmul_next_term_high_or_%out_low, %mask
    __num_uw_cmul_next_rhs_%out_low = lshr __num_uw_cmul_rhs_%out_low, 1
    __num_uw_cmul_next_idx_%out_low = add __num_uw_cmul_idx_%out_low, 1
    store __num_uw_cmul_acc_low_slot_%out_low+0, __num_uw_cmul_sum_low_%out_low as u64
    store __num_uw_cmul_acc_high_slot_%out_low+0, __num_uw_cmul_sum_high_%out_low as u64
    store __num_uw_cmul_term_low_slot_%out_low+0, __num_uw_cmul_next_term_low_%out_low as u64
    store __num_uw_cmul_term_high_slot_%out_low+0, __num_uw_cmul_next_term_high_%out_low as u64
    store __num_uw_cmul_rhs_slot_%out_low+0, __num_uw_cmul_next_rhs_%out_low as u64
    store __num_uw_cmul_idx_slot_%out_low+0, __num_uw_cmul_next_idx_%out_low as u64
