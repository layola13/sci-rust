    br __num_u64_strict_shr_ok_%out_value -> L_NUM_U64_STRICT_SHR_OK_%out_value, L_NUM_U64_STRICT_SHR_PANIC_%out_value

L_NUM_U64_STRICT_SHR_PANIC_%out_value:
    panic(2213)

L_NUM_U64_STRICT_SHR_OK_%out_value:
    !__num_u64_strict_shr_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_SHL %out_value, %value, %shift
    __num_wshl_shift_%out_value = urem %shift, NUM_U64_BITS
    %out_value = shl %value, __num_wshl_shift_%out_value
    !__num_wshl_shift_%out_value
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_SHR %out_value, %value, %shift
    __num_wshr_shift_%out_value = urem %shift, NUM_U64_BITS
    %out_value = lshr %value, __num_wshr_shift_%out_value
    !__num_wshr_shift_%out_value
[END_MACRO]

[MACRO] NUM_U64_IS_POWER_OF_TWO %out_bool, %value
    __num_pow2_nonzero_%out_bool = ne %value, 0
    __num_pow2_prev_%out_bool = sub %value, 1
    __num_pow2_masked_%out_bool = and %value, __num_pow2_prev_%out_bool
    __num_pow2_single_%out_bool = eq __num_pow2_masked_%out_bool, 0
    %out_bool = and __num_pow2_nonzero_%out_bool, __num_pow2_single_%out_bool
    !__num_pow2_single_%out_bool
    !__num_pow2_masked_%out_bool
    !__num_pow2_prev_%out_bool
    !__num_pow2_nonzero_%out_bool
[END_MACRO]

[MACRO] NUM_U64_ABS_DIFF %out_value, %lhs, %rhs
    __num_absdiff_take_lhs_%out_value = uge %lhs, %rhs
    br __num_absdiff_take_lhs_%out_value -> L_NUM_U64_ABS_DIFF_LHS_%out_value, L_NUM_U64_ABS_DIFF_RHS_%out_value

L_NUM_U64_ABS_DIFF_LHS_%out_value:
    %out_value = sub %lhs, %rhs
    !__num_absdiff_take_lhs_%out_value
    jmp L_NUM_U64_ABS_DIFF_END_%out_value

L_NUM_U64_ABS_DIFF_RHS_%out_value:
    %out_value = sub %rhs, %lhs
    !__num_absdiff_take_lhs_%out_value

L_NUM_U64_ABS_DIFF_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_MIDPOINT %out_value, %lhs, %rhs
    __num_mid_and_%out_value = and %lhs, %rhs
    __num_mid_xor_%out_value = xor %lhs, %rhs
    __num_mid_half_%out_value = lshr __num_mid_xor_%out_value, 1
    %out_value = add __num_mid_and_%out_value, __num_mid_half_%out_value
    !__num_mid_half_%out_value
    !__num_mid_xor_%out_value
    !__num_mid_and_%out_value
[END_MACRO]

[MACRO] NUM_U64_ISQRT %out_value, %value
    __num_u64_isqrt_zero_%out_value = eq %value, 0
    br __num_u64_isqrt_zero_%out_value -> L_NUM_U64_ISQRT_ZERO_%out_value, L_NUM_U64_ISQRT_INIT_%out_value

L_NUM_U64_ISQRT_INIT_%out_value:
    __num_u64_isqrt_lo_slot_%out_value = stack_alloc 8
    __num_u64_isqrt_hi_slot_%out_value = stack_alloc 8
    __num_u64_isqrt_hi_init_%out_value = shl 1, 32
    store __num_u64_isqrt_lo_slot_%out_value+0, 1 as u64
    store __num_u64_isqrt_hi_slot_%out_value+0, __num_u64_isqrt_hi_init_%out_value as u64
    !__num_u64_isqrt_hi_init_%out_value
    !__num_u64_isqrt_zero_%out_value
    jmp L_NUM_U64_ISQRT_HEAD_%out_value

L_NUM_U64_ISQRT_HEAD_%out_value:
    __num_u64_isqrt_lo_%out_value = load __num_u64_isqrt_lo_slot_%out_value+0 as u64
    __num_u64_isqrt_hi_%out_value = load __num_u64_isqrt_hi_slot_%out_value+0 as u64
    __num_u64_isqrt_more_%out_value = ult __num_u64_isqrt_lo_%out_value, __num_u64_isqrt_hi_%out_value
    br __num_u64_isqrt_more_%out_value -> L_NUM_U64_ISQRT_BODY_%out_value, L_NUM_U64_ISQRT_DONE_%out_value

L_NUM_U64_ISQRT_BODY_%out_value:
    __num_u64_isqrt_sum_%out_value = add __num_u64_isqrt_lo_%out_value, __num_u64_isqrt_hi_%out_value
    __num_u64_isqrt_mid_%out_value = lshr __num_u64_isqrt_sum_%out_value, 1
    __num_u64_isqrt_quot_%out_value = udiv %value, __num_u64_isqrt_mid_%out_value
    __num_u64_isqrt_keep_mid_%out_value = ule __num_u64_isqrt_mid_%out_value, __num_u64_isqrt_quot_%out_value
    br __num_u64_isqrt_keep_mid_%out_value -> L_NUM_U64_ISQRT_KEEP_%out_value, L_NUM_U64_ISQRT_DROP_%out_value

L_NUM_U64_ISQRT_KEEP_%out_value:
    __num_u64_isqrt_next_lo_%out_value = add __num_u64_isqrt_mid_%out_value, 1
    store __num_u64_isqrt_lo_slot_%out_value+0, __num_u64_isqrt_next_lo_%out_value as u64
    !__num_u64_isqrt_next_lo_%out_value
    !__num_u64_isqrt_keep_mid_%out_value
    !__num_u64_isqrt_quot_%out_value
    !__num_u64_isqrt_mid_%out_value
    !__num_u64_isqrt_sum_%out_value
    !__num_u64_isqrt_more_%out_value
    !__num_u64_isqrt_hi_%out_value
    !__num_u64_isqrt_lo_%out_value
    jmp L_NUM_U64_ISQRT_HEAD_%out_value

L_NUM_U64_ISQRT_DROP_%out_value:
    store __num_u64_isqrt_hi_slot_%out_value+0, __num_u64_isqrt_mid_%out_value as u64
    !__num_u64_isqrt_keep_mid_%out_value
    !__num_u64_isqrt_quot_%out_value
    !__num_u64_isqrt_mid_%out_value
    !__num_u64_isqrt_sum_%out_value
    !__num_u64_isqrt_more_%out_value
    !__num_u64_isqrt_hi_%out_value
    !__num_u64_isqrt_lo_%out_value
    jmp L_NUM_U64_ISQRT_HEAD_%out_value

L_NUM_U64_ISQRT_DONE_%out_value:
    %out_value = sub __num_u64_isqrt_lo_%out_value, 1
    !__num_u64_isqrt_more_%out_value
    !__num_u64_isqrt_hi_%out_value
    !__num_u64_isqrt_lo_%out_value
    jmp L_NUM_U64_ISQRT_END_%out_value

L_NUM_U64_ISQRT_ZERO_%out_value:
    %out_value = add 0, 0
    !__num_u64_isqrt_zero_%out_value

L_NUM_U64_ISQRT_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_ROTATE_LEFT %out_value, %value, %shift
    __num_rotl_shift_%out_value = urem %shift, NUM_U64_BITS
    __num_rotl_zero_%out_value = eq __num_rotl_shift_%out_value, 0
    br __num_rotl_zero_%out_value -> L_NUM_U64_ROTL_ZERO_%out_value, L_NUM_U64_ROTL_BODY_%out_value

