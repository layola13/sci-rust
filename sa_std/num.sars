L_NUM_U64_LOW_ONE_SOME_%out_ok:
    EXPAND NUM_U64_TRAILING_ZEROS %out_index, %value
    %out_ok = add 0, 1
    !__num_low_one_zero_%out_ok
    jmp L_NUM_U64_LOW_ONE_END_%out_ok

L_NUM_U64_LOW_ONE_NONE_%out_ok:
