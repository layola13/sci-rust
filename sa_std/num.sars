    __num_sw_ov_rem_euclid_zero_%out_value = eq %rhs, 0
    br __num_sw_ov_rem_euclid_zero_%out_value -> L_NUM_SW_OV_REM_EUCLID_ZERO_%out_value, L_NUM_SW_OV_REM_EUCLID_NEG_ONE_CHECK_%out_value

