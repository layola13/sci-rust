[MACRO] NUM_U32_FROM_BE_BYTES %out_value, %src_ptr
    __num_u32_be_b0_%out_value = load %src_ptr+0 as u8
    __num_u32_be_b1_%out_value = load %src_ptr+1 as u8
    __num_u32_be_b2_%out_value = load %src_ptr+2 as u8
    __num_u32_be_b3_%out_value = load %src_ptr+3 as u8
    __num_u32_be_s0_%out_value = shl __num_u32_be_b0_%out_value, 24
    __num_u32_be_s1_%out_value = shl __num_u32_be_b1_%out_value, 16
    __num_u32_be_s2_%out_value = shl __num_u32_be_b2_%out_value, 8
    __num_u32_be_01_%out_value = or __num_u32_be_s0_%out_value, __num_u32_be_s1_%out_value
    __num_u32_be_23_%out_value = or __num_u32_be_s2_%out_value, __num_u32_be_b3_%out_value
    %out_value = or __num_u32_be_01_%out_value, __num_u32_be_23_%out_value
