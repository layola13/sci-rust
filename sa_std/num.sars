[MACRO] NUM_U64_REVERSE_BITS %out_value, %value
    __num_rev_idx_slot_%out_value = stack_alloc 8
    __num_rev_acc_slot_%out_value = stack_alloc 8
    __num_rev_value_slot_%out_value = stack_alloc 8
    store __num_rev_idx_slot_%out_value+0, 0 as u64
    store __num_rev_acc_slot_%out_value+0, 0 as u64
    store __num_rev_value_slot_%out_value+0, %value as u64
    jmp L_NUM_U64_REV_HEAD_%out_value

L_NUM_U64_REV_HEAD_%out_value:
    __num_rev_idx_%out_value = load __num_rev_idx_slot_%out_value+0 as u64
    __num_rev_done_%out_value = eq __num_rev_idx_%out_value, NUM_U64_BITS
    br __num_rev_done_%out_value -> L_NUM_U64_REV_DONE_%out_value, L_NUM_U64_REV_BODY_%out_value

L_NUM_U64_REV_BODY_%out_value:
    __num_rev_acc_%out_value = load __num_rev_acc_slot_%out_value+0 as u64
    __num_rev_value_%out_value = load __num_rev_value_slot_%out_value+0 as u64
    __num_rev_bit_%out_value = and __num_rev_value_%out_value, 1
    __num_rev_shifted_%out_value = shl __num_rev_acc_%out_value, 1
    __num_rev_next_acc_%out_value = or __num_rev_shifted_%out_value, __num_rev_bit_%out_value
    __num_rev_next_value_%out_value = lshr __num_rev_value_%out_value, 1
    __num_rev_next_idx_%out_value = add __num_rev_idx_%out_value, 1
    store __num_rev_acc_slot_%out_value+0, __num_rev_next_acc_%out_value as u64
    store __num_rev_value_slot_%out_value+0, __num_rev_next_value_%out_value as u64
    store __num_rev_idx_slot_%out_value+0, __num_rev_next_idx_%out_value as u64
    !__num_rev_next_idx_%out_value
    !__num_rev_next_value_%out_value
    !__num_rev_next_acc_%out_value
    !__num_rev_shifted_%out_value
    !__num_rev_bit_%out_value
    !__num_rev_value_%out_value
    !__num_rev_acc_%out_value
    !__num_rev_done_%out_value
    !__num_rev_idx_%out_value
    jmp L_NUM_U64_REV_HEAD_%out_value

L_NUM_U64_REV_DONE_%out_value:
    %out_value = load __num_rev_acc_slot_%out_value+0 as u64
    !__num_rev_done_%out_value
    !__num_rev_idx_%out_value
[END_MACRO]

[MACRO] NUM_U8_REVERSE_BITS %out_value, %value
    __num_u8_rev_value_%out_value = and %value, NUM_U8_MAX
    EXPAND NUM_U64_REVERSE_BITS __num_u8_rev_raw_%out_value, __num_u8_rev_value_%out_value
    %out_value = lshr __num_u8_rev_raw_%out_value, 56
    !__num_u8_rev_raw_%out_value
    !__num_u8_rev_value_%out_value
[END_MACRO]

[MACRO] NUM_U16_REVERSE_BITS %out_value, %value
