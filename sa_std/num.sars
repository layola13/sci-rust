    br __num_i8_div_zero_%out_ok -> L_NUM_I8_DIV_FAIL_%out_ok, L_NUM_I8_DIV_MIN_CHECK_%out_ok

L_NUM_I8_DIV_MIN_CHECK_%out_ok:
    __num_i8_div_lhs_min_%out_ok = eq %lhs, NUM_I8_MIN
    __num_i8_div_rhs_neg_one_%out_ok = eq %rhs, -1
    __num_i8_div_over_%out_ok = and __num_i8_div_lhs_min_%out_ok, __num_i8_div_rhs_neg_one_%out_ok
    br __num_i8_div_over_%out_ok -> L_NUM_I8_DIV_OVER_%out_ok, L_NUM_I8_DIV_OK_%out_ok

L_NUM_I8_DIV_OK_%out_ok:
    %out_value = sdiv %lhs, %rhs
    %out_ok = add 0, 1
    !__num_i8_div_over_%out_ok
    !__num_i8_div_rhs_neg_one_%out_ok
    !__num_i8_div_lhs_min_%out_ok
    !__num_i8_div_zero_%out_ok
    jmp L_NUM_I8_DIV_END_%out_ok

L_NUM_I8_DIV_OVER_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_i8_div_over_%out_ok
    !__num_i8_div_rhs_neg_one_%out_ok
    !__num_i8_div_lhs_min_%out_ok
    !__num_i8_div_zero_%out_ok
    jmp L_NUM_I8_DIV_END_%out_ok

L_NUM_I8_DIV_FAIL_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_i8_div_zero_%out_ok

L_NUM_I8_DIV_END_%out_ok:
[END_MACRO]

