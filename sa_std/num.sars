    __num_iso_high_zero_%out_value = eq %value, 0
    br __num_iso_high_zero_%out_value -> L_NUM_U64_ISO_HIGH_ZERO_%out_value, L_NUM_U64_ISO_HIGH_VALUE_%out_value

L_NUM_U64_ISO_HIGH_VALUE_%out_value:
    EXPAND NUM_U64_LEADING_ZEROS __num_iso_high_lz_%out_value, %value
    __num_iso_high_index_%out_value = sub 63, __num_iso_high_lz_%out_value
    %out_value = shl 1, __num_iso_high_index_%out_value
    !__num_iso_high_index_%out_value
    !__num_iso_high_lz_%out_value
    !__num_iso_high_zero_%out_value
    jmp L_NUM_U64_ISO_HIGH_END_%out_value

L_NUM_U64_ISO_HIGH_ZERO_%out_value:
    %out_value = add 0, 0
    !__num_iso_high_zero_%out_value

L_NUM_U64_ISO_HIGH_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_ISOLATE_LOWEST_ONE %out_value, %value
    __num_iso_low_neg_%out_value = sub 0, %value
    %out_value = and %value, __num_iso_low_neg_%out_value
    !__num_iso_low_neg_%out_value
