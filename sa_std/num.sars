    %out_index = sub 63, __num_high_one_lz_%out_ok
    %out_ok = add 0, 1
    !__num_high_one_lz_%out_ok
    !__num_high_one_zero_%out_ok
    jmp L_NUM_U64_HIGH_ONE_END_%out_ok

L_NUM_U64_HIGH_ONE_NONE_%out_ok:
    %out_index = add 0, 0
    %out_ok = add 0, 0
    !__num_high_one_zero_%out_ok

L_NUM_U64_HIGH_ONE_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_LOWEST_ONE %out_ok, %out_index, %value
    __num_low_one_zero_%out_ok = eq %value, 0
