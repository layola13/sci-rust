[MACRO] NUM_U64_CHECKED_ADD %out_ok, %out_value, %lhs, %rhs
    __num_add_sum_%out_ok = add %lhs, %rhs
    __num_add_overflow_%out_ok = ult __num_add_sum_%out_ok, %lhs
    br __num_add_overflow_%out_ok -> L_NUM_U64_ADD_OVERFLOW_%out_ok, L_NUM_U64_ADD_OK_%out_ok

L_NUM_U64_ADD_OK_%out_ok:
    %out_value = add __num_add_sum_%out_ok, 0
    %out_ok = add 0, 1
    !__num_add_overflow_%out_ok
    !__num_add_sum_%out_ok
    jmp L_NUM_U64_ADD_END_%out_ok

L_NUM_U64_ADD_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_add_overflow_%out_ok
    !__num_add_sum_%out_ok

L_NUM_U64_ADD_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_SUB %out_ok, %out_value, %lhs, %rhs
    __num_sub_ok_%out_ok = ule %rhs, %lhs
    br __num_sub_ok_%out_ok -> L_NUM_U64_SUB_OK_%out_ok, L_NUM_U64_SUB_UNDERFLOW_%out_ok

L_NUM_U64_SUB_OK_%out_ok:
    %out_value = sub %lhs, %rhs
    %out_ok = add 0, 1
    !__num_sub_ok_%out_ok
    jmp L_NUM_U64_SUB_END_%out_ok

L_NUM_U64_SUB_UNDERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_sub_ok_%out_ok

L_NUM_U64_SUB_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_MUL %out_ok, %out_value, %lhs, %rhs
    __num_mul_rhs_zero_%out_ok = eq %rhs, 0
    br __num_mul_rhs_zero_%out_ok -> L_NUM_U64_MUL_ZERO_%out_ok, L_NUM_U64_MUL_COMPUTE_%out_ok

L_NUM_U64_MUL_COMPUTE_%out_ok:
    __num_mul_product_%out_ok = mul %lhs, %rhs
    __num_mul_roundtrip_%out_ok = udiv __num_mul_product_%out_ok, %rhs
    __num_mul_ok_%out_ok = eq __num_mul_roundtrip_%out_ok, %lhs
    br __num_mul_ok_%out_ok -> L_NUM_U64_MUL_OK_%out_ok, L_NUM_U64_MUL_OVERFLOW_%out_ok

L_NUM_U64_MUL_OK_%out_ok:
    %out_value = add __num_mul_product_%out_ok, 0
    %out_ok = add 0, 1
    !__num_mul_ok_%out_ok
    !__num_mul_roundtrip_%out_ok
    !__num_mul_product_%out_ok
    !__num_mul_rhs_zero_%out_ok
    jmp L_NUM_U64_MUL_END_%out_ok

L_NUM_U64_MUL_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_mul_ok_%out_ok
    !__num_mul_roundtrip_%out_ok
    !__num_mul_product_%out_ok
    !__num_mul_rhs_zero_%out_ok
    jmp L_NUM_U64_MUL_END_%out_ok

L_NUM_U64_MUL_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 1
    !__num_mul_rhs_zero_%out_ok

L_NUM_U64_MUL_END_%out_ok:
[END_MACRO]

