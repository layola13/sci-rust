    __wrapping_u32_lt_right_raw_%out_bool = load %right_ptr+WrappingU32_value as u64
    __wrapping_u32_lt_left_%out_bool = and __wrapping_u32_lt_left_raw_%out_bool, NUM_U32_MAX
    __wrapping_u32_lt_right_%out_bool = and __wrapping_u32_lt_right_raw_%out_bool, NUM_U32_MAX
    %out_bool = ult __wrapping_u32_lt_left_%out_bool, __wrapping_u32_lt_right_%out_bool
