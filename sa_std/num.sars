[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_ADD %out_value, %out_overflow, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_ADD __num_u64_ov_add_ok_%out_value, __num_u64_ov_add_value_%out_value, %lhs, %rhs
    EXPAND NUM_U64_WRAPPING_ADD %out_value, %lhs, %rhs
    %out_overflow = eq __num_u64_ov_add_ok_%out_value, 0
    !__num_u64_ov_add_value_%out_value
    !__num_u64_ov_add_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_SUB %out_value, %out_overflow, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_SUB __num_u64_ov_sub_ok_%out_value, __num_u64_ov_sub_value_%out_value, %lhs, %rhs
    EXPAND NUM_U64_WRAPPING_SUB %out_value, %lhs, %rhs
    %out_overflow = eq __num_u64_ov_sub_ok_%out_value, 0
