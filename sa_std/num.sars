[END_MACRO]

[MACRO] NUM_I64_SIGNUM %out_value, %value
    __num_sign_neg_%out_value = slt %value, 0
    br __num_sign_neg_%out_value -> L_NUM_I64_SIGN_NEG_%out_value, L_NUM_I64_SIGN_CHECK_POS_%out_value

L_NUM_I64_SIGN_NEG_%out_value:
    %out_value = sub 0, 1
    !__num_sign_neg_%out_value
    jmp L_NUM_I64_SIGN_END_%out_value

L_NUM_I64_SIGN_CHECK_POS_%out_value:
    __num_sign_pos_%out_value = sgt %value, 0
    br __num_sign_pos_%out_value -> L_NUM_I64_SIGN_POS_%out_value, L_NUM_I64_SIGN_ZERO_%out_value

L_NUM_I64_SIGN_POS_%out_value:
    %out_value = add 0, 1
    !__num_sign_pos_%out_value
    !__num_sign_neg_%out_value
    jmp L_NUM_I64_SIGN_END_%out_value

L_NUM_I64_SIGN_ZERO_%out_value:
    %out_value = add 0, 0
    !__num_sign_pos_%out_value
    !__num_sign_neg_%out_value

L_NUM_I64_SIGN_END_%out_value:
[END_MACRO]

