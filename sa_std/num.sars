    store __saturating_u64_pow_acc_slot_%out_ptr+0, __saturating_u64_pow_mul_value_%out_ptr as u64
    store __saturating_u64_pow_idx_slot_%out_ptr+0, __saturating_u64_pow_next_idx_%out_ptr as u64
    !__saturating_u64_pow_next_idx_%out_ptr
    !__saturating_u64_pow_mul_ok_%out_ptr
    !__saturating_u64_pow_mul_value_%out_ptr
