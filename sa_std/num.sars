[MACRO] NUM_UNSIGNED_CHECKED_SIGNED_DIFF_WIDTH %out_ok, %out_value, %lhs, %rhs, %positive_limit, %negative_magnitude_limit
    __num_signed_diff_lhs_ge_%out_ok = uge %lhs, %rhs
    br __num_signed_diff_lhs_ge_%out_ok -> L_NUM_SIGNED_DIFF_POS_%out_ok, L_NUM_SIGNED_DIFF_NEG_%out_ok

L_NUM_SIGNED_DIFF_POS_%out_ok:
    __num_signed_diff_pos_%out_ok = sub %lhs, %rhs
    %out_ok = ule __num_signed_diff_pos_%out_ok, %positive_limit
    %out_value = mul %out_ok, __num_signed_diff_pos_%out_ok
    !__num_signed_diff_pos_%out_ok
    !__num_signed_diff_lhs_ge_%out_ok
    jmp L_NUM_SIGNED_DIFF_END_%out_ok

L_NUM_SIGNED_DIFF_NEG_%out_ok:
    __num_signed_diff_neg_mag_%out_ok = sub %rhs, %lhs
    %out_ok = ule __num_signed_diff_neg_mag_%out_ok, %negative_magnitude_limit
    __num_signed_diff_neg_%out_ok = sub 0, __num_signed_diff_neg_mag_%out_ok
    %out_value = mul %out_ok, __num_signed_diff_neg_%out_ok
    !__num_signed_diff_neg_%out_ok
    !__num_signed_diff_neg_mag_%out_ok
    !__num_signed_diff_lhs_ge_%out_ok

L_NUM_SIGNED_DIFF_END_%out_ok:
[END_MACRO]

