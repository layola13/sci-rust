[MACRO] NUM_UNSIGNED_WIDTH_SATURATING_CAST_SIGNED %out_value, %value, %mask, %signed_max
    __num_usat_cast_masked_%out_value = and %value, %mask
    __num_usat_cast_in_range_%out_value = ule __num_usat_cast_masked_%out_value, %signed_max
    br __num_usat_cast_in_range_%out_value -> L_NUM_UNSIGNED_SAT_CAST_VALUE_%out_value, L_NUM_UNSIGNED_SAT_CAST_MAX_%out_value

L_NUM_UNSIGNED_SAT_CAST_VALUE_%out_value:
    %out_value = add __num_usat_cast_masked_%out_value, 0
    !__num_usat_cast_in_range_%out_value
    !__num_usat_cast_masked_%out_value
    jmp L_NUM_UNSIGNED_SAT_CAST_END_%out_value

L_NUM_UNSIGNED_SAT_CAST_MAX_%out_value:
    %out_value = add 0, %signed_max
    !__num_usat_cast_in_range_%out_value
    !__num_usat_cast_masked_%out_value

L_NUM_UNSIGNED_SAT_CAST_END_%out_value:
[END_MACRO]

[MACRO] NUM_UNSIGNED_WIDTH_CHECKED_CAST_SIGNED %out_ok, %out_value, %value, %mask, %signed_max
    __num_uchecked_cast_masked_%out_ok = and %value, %mask
    __num_uchecked_cast_in_range_%out_ok = ule __num_uchecked_cast_masked_%out_ok, %signed_max
    br __num_uchecked_cast_in_range_%out_ok -> L_NUM_UNSIGNED_CHECKED_CAST_SOME_%out_ok, L_NUM_UNSIGNED_CHECKED_CAST_NONE_%out_ok

L_NUM_UNSIGNED_CHECKED_CAST_SOME_%out_ok:
    %out_value = add __num_uchecked_cast_masked_%out_ok, 0
    %out_ok = add 0, 1
    !__num_uchecked_cast_in_range_%out_ok
    !__num_uchecked_cast_masked_%out_ok
    jmp L_NUM_UNSIGNED_CHECKED_CAST_END_%out_ok

L_NUM_UNSIGNED_CHECKED_CAST_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_uchecked_cast_in_range_%out_ok
    !__num_uchecked_cast_masked_%out_ok

L_NUM_UNSIGNED_CHECKED_CAST_END_%out_ok:
[END_MACRO]

[MACRO] NUM_SIGNED_WIDTH_SATURATING_CAST_UNSIGNED %out_value, %value, %mask
    __num_isat_cast_nonnegative_%out_value = sge %value, 0
    br __num_isat_cast_nonnegative_%out_value -> L_NUM_SIGNED_SAT_CAST_VALUE_%out_value, L_NUM_SIGNED_SAT_CAST_ZERO_%out_value

L_NUM_SIGNED_SAT_CAST_VALUE_%out_value:
    %out_value = and %value, %mask
    !__num_isat_cast_nonnegative_%out_value
    jmp L_NUM_SIGNED_SAT_CAST_END_%out_value

L_NUM_SIGNED_SAT_CAST_ZERO_%out_value:
