[MACRO] NUM_U64_CHECKED_ILOG2 %out_ok, %out_value, %value
    __num_u64_ilog2_zero_%out_ok = eq %value, 0
    br __num_u64_ilog2_zero_%out_ok -> L_NUM_U64_ILOG2_NONE_%out_ok, L_NUM_U64_ILOG2_SOME_%out_ok

L_NUM_U64_ILOG2_SOME_%out_ok:
    EXPAND NUM_U64_LEADING_ZEROS __num_u64_ilog2_lz_%out_ok, %value
    %out_value = sub 63, __num_u64_ilog2_lz_%out_ok
    %out_ok = add 0, 1
    !__num_u64_ilog2_lz_%out_ok
    !__num_u64_ilog2_zero_%out_ok
    jmp L_NUM_U64_ILOG2_END_%out_ok

L_NUM_U64_ILOG2_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_u64_ilog2_zero_%out_ok

L_NUM_U64_ILOG2_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_ILOG2 %out_value, %value
    EXPAND NUM_U64_CHECKED_ILOG2 __num_u64_ilog2_ok_%out_value, %out_value, %value
    !__num_u64_ilog2_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_CHECKED_ILOG %out_ok, %out_value, %value, %base
    __num_u64_ilog_value_zero_%out_ok = eq %value, 0
    __num_u64_ilog_base_small_%out_ok = ult %base, 2
    __num_u64_ilog_invalid_%out_ok = or __num_u64_ilog_value_zero_%out_ok, __num_u64_ilog_base_small_%out_ok
    br __num_u64_ilog_invalid_%out_ok -> L_NUM_U64_ILOG_NONE_%out_ok, L_NUM_U64_ILOG_INIT_%out_ok

L_NUM_U64_ILOG_INIT_%out_ok:
    __num_u64_ilog_work_slot_%out_ok = stack_alloc 8
    __num_u64_ilog_count_slot_%out_ok = stack_alloc 8
    store __num_u64_ilog_work_slot_%out_ok+0, %value as u64
    store __num_u64_ilog_count_slot_%out_ok+0, 0 as u64
    jmp L_NUM_U64_ILOG_HEAD_%out_ok

L_NUM_U64_ILOG_HEAD_%out_ok:
    __num_u64_ilog_work_%out_ok = load __num_u64_ilog_work_slot_%out_ok+0 as u64
    __num_u64_ilog_done_%out_ok = ult __num_u64_ilog_work_%out_ok, %base
    br __num_u64_ilog_done_%out_ok -> L_NUM_U64_ILOG_DONE_%out_ok, L_NUM_U64_ILOG_STEP_%out_ok

L_NUM_U64_ILOG_STEP_%out_ok:
    __num_u64_ilog_next_work_%out_ok = udiv __num_u64_ilog_work_%out_ok, %base
    __num_u64_ilog_count_%out_ok = load __num_u64_ilog_count_slot_%out_ok+0 as u64
    __num_u64_ilog_next_count_%out_ok = add __num_u64_ilog_count_%out_ok, 1
    store __num_u64_ilog_work_slot_%out_ok+0, __num_u64_ilog_next_work_%out_ok as u64
    store __num_u64_ilog_count_slot_%out_ok+0, __num_u64_ilog_next_count_%out_ok as u64
    !__num_u64_ilog_next_count_%out_ok
    !__num_u64_ilog_count_%out_ok
    !__num_u64_ilog_next_work_%out_ok
    !__num_u64_ilog_done_%out_ok
    !__num_u64_ilog_work_%out_ok
    jmp L_NUM_U64_ILOG_HEAD_%out_ok

L_NUM_U64_ILOG_DONE_%out_ok:
    %out_value = load __num_u64_ilog_count_slot_%out_ok+0 as u64
    %out_ok = add 0, 1
    !__num_u64_ilog_done_%out_ok
    !__num_u64_ilog_work_%out_ok
    !__num_u64_ilog_invalid_%out_ok
    !__num_u64_ilog_base_small_%out_ok
    !__num_u64_ilog_value_zero_%out_ok
    jmp L_NUM_U64_ILOG_END_%out_ok

L_NUM_U64_ILOG_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_u64_ilog_invalid_%out_ok
    !__num_u64_ilog_base_small_%out_ok
    !__num_u64_ilog_value_zero_%out_ok

L_NUM_U64_ILOG_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_ILOG %out_value, %value, %base
    EXPAND NUM_U64_CHECKED_ILOG __num_u64_ilog_ok_%out_value, %out_value, %value, %base
    !__num_u64_ilog_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_CHECKED_ILOG10 %out_ok, %out_value, %value
