L_NUM_UW_CMUL_DONE_%out_low:
    __num_uw_cmul_prod_low_%out_low = load __num_uw_cmul_acc_low_slot_%out_low+0 as u64
    __num_uw_cmul_prod_high_%out_low = load __num_uw_cmul_acc_high_slot_%out_low+0 as u64
    __num_uw_cmul_carry_value_%out_low = and %carry, %mask
    __num_uw_cmul_add_value_%out_low = and %addend, %mask
    __num_uw_cmul_with_carry_raw_%out_low = add __num_uw_cmul_prod_low_%out_low, __num_uw_cmul_carry_value_%out_low
    __num_uw_cmul_with_carry_low_%out_low = and __num_uw_cmul_with_carry_raw_%out_low, %mask
    __num_uw_cmul_with_carry_high_bit_%out_low = ult __num_uw_cmul_with_carry_low_%out_low, __num_uw_cmul_prod_low_%out_low
    __num_uw_cmul_high_after_carry_raw_%out_low = add __num_uw_cmul_prod_high_%out_low, __num_uw_cmul_with_carry_high_bit_%out_low
    __num_uw_cmul_high_after_carry_%out_low = and __num_uw_cmul_high_after_carry_raw_%out_low, %mask
    __num_uw_cmul_with_add_raw_%out_low = add __num_uw_cmul_with_carry_low_%out_low, __num_uw_cmul_add_value_%out_low
    %out_low = and __num_uw_cmul_with_add_raw_%out_low, %mask
    __num_uw_cmul_with_add_high_bit_%out_low = ult %out_low, __num_uw_cmul_with_carry_low_%out_low
    __num_uw_cmul_out_high_raw_%out_low = add __num_uw_cmul_high_after_carry_%out_low, __num_uw_cmul_with_add_high_bit_%out_low
    %out_high = and __num_uw_cmul_out_high_raw_%out_low, %mask
