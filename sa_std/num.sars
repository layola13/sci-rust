    __wrapping_u32_eq_left_%out_bool = load %left_ptr+WrappingU32_value as u64
    __wrapping_u32_eq_right_%out_bool = load %right_ptr+WrappingU32_value as u64
    __wrapping_u32_eq_left_masked_%out_bool = and __wrapping_u32_eq_left_%out_bool, NUM_U32_MAX
    __wrapping_u32_eq_right_masked_%out_bool = and __wrapping_u32_eq_right_%out_bool, NUM_U32_MAX
    %out_bool = eq __wrapping_u32_eq_left_masked_%out_bool, __wrapping_u32_eq_right_masked_%out_bool
    !__wrapping_u32_eq_right_masked_%out_bool
    !__wrapping_u32_eq_left_masked_%out_bool
