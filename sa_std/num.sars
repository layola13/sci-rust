[MACRO] SATURATING_I64_POW %out_ptr, %src_ptr, %exp
    __saturating_i64_pow_base_%out_ptr = load %src_ptr+SaturatingI64_value as i64
    __saturating_i64_pow_acc_slot_%out_ptr = stack_alloc 8
    __saturating_i64_pow_idx_slot_%out_ptr = stack_alloc 8
    store __saturating_i64_pow_acc_slot_%out_ptr+0, 1 as i64
    store __saturating_i64_pow_idx_slot_%out_ptr+0, 0 as u64
    jmp L_SATURATING_I64_POW_HEAD_%out_ptr

L_SATURATING_I64_POW_HEAD_%out_ptr:
    __saturating_i64_pow_idx_%out_ptr = load __saturating_i64_pow_idx_slot_%out_ptr+0 as u64
    __saturating_i64_pow_done_%out_ptr = eq __saturating_i64_pow_idx_%out_ptr, %exp
    br __saturating_i64_pow_done_%out_ptr -> L_SATURATING_I64_POW_DONE_%out_ptr, L_SATURATING_I64_POW_BODY_%out_ptr

L_SATURATING_I64_POW_BODY_%out_ptr:
    __saturating_i64_pow_acc_%out_ptr = load __saturating_i64_pow_acc_slot_%out_ptr+0 as i64
    EXPAND NUM_I64_CHECKED_MUL __saturating_i64_pow_mul_ok_%out_ptr, __saturating_i64_pow_mul_value_%out_ptr, __saturating_i64_pow_acc_%out_ptr, __saturating_i64_pow_base_%out_ptr
    br __saturating_i64_pow_mul_ok_%out_ptr -> L_SATURATING_I64_POW_STEP_OK_%out_ptr, L_SATURATING_I64_POW_OVERFLOW_%out_ptr

L_SATURATING_I64_POW_STEP_OK_%out_ptr:
    __saturating_i64_pow_next_idx_%out_ptr = add __saturating_i64_pow_idx_%out_ptr, 1
    store __saturating_i64_pow_acc_slot_%out_ptr+0, __saturating_i64_pow_mul_value_%out_ptr as i64
    store __saturating_i64_pow_idx_slot_%out_ptr+0, __saturating_i64_pow_next_idx_%out_ptr as u64
    !__saturating_i64_pow_next_idx_%out_ptr
    !__saturating_i64_pow_mul_ok_%out_ptr
    !__saturating_i64_pow_mul_value_%out_ptr
    !__saturating_i64_pow_acc_%out_ptr
    !__saturating_i64_pow_done_%out_ptr
    !__saturating_i64_pow_idx_%out_ptr
    jmp L_SATURATING_I64_POW_HEAD_%out_ptr

L_SATURATING_I64_POW_OVERFLOW_%out_ptr:
    __saturating_i64_pow_base_neg_%out_ptr = slt __saturating_i64_pow_base_%out_ptr, 0
