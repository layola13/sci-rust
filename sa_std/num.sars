    %out_value = lshr __num_u32_rev_raw_%out_value, 32
    !__num_u32_rev_raw_%out_value
    !__num_u32_rev_value_%out_value
[END_MACRO]

[MACRO] NUM_U64_SWAP_BYTES %out_value, %value
    __num_swap_idx_slot_%out_value = stack_alloc 8
    __num_swap_acc_slot_%out_value = stack_alloc 8
    store __num_swap_idx_slot_%out_value+0, 0 as u64
    store __num_swap_acc_slot_%out_value+0, 0 as u64
    jmp L_NUM_U64_SWAP_HEAD_%out_value

L_NUM_U64_SWAP_HEAD_%out_value:
    __num_swap_idx_%out_value = load __num_swap_idx_slot_%out_value+0 as u64
    __num_swap_done_%out_value = eq __num_swap_idx_%out_value, 8
    br __num_swap_done_%out_value -> L_NUM_U64_SWAP_DONE_%out_value, L_NUM_U64_SWAP_BODY_%out_value

L_NUM_U64_SWAP_BODY_%out_value:
    __num_swap_acc_%out_value = load __num_swap_acc_slot_%out_value+0 as u64
    __num_swap_src_shift_%out_value = mul __num_swap_idx_%out_value, 8
    __num_swap_byte_raw_%out_value = lshr %value, __num_swap_src_shift_%out_value
    __num_swap_byte_%out_value = and __num_swap_byte_raw_%out_value, 255
    __num_swap_inv_idx_%out_value = sub 7, __num_swap_idx_%out_value
    __num_swap_dst_shift_%out_value = mul __num_swap_inv_idx_%out_value, 8
    __num_swap_shifted_%out_value = shl __num_swap_byte_%out_value, __num_swap_dst_shift_%out_value
    __num_swap_next_acc_%out_value = or __num_swap_acc_%out_value, __num_swap_shifted_%out_value
    __num_swap_next_idx_%out_value = add __num_swap_idx_%out_value, 1
    store __num_swap_acc_slot_%out_value+0, __num_swap_next_acc_%out_value as u64
    store __num_swap_idx_slot_%out_value+0, __num_swap_next_idx_%out_value as u64
    !__num_swap_next_idx_%out_value
    !__num_swap_next_acc_%out_value
    !__num_swap_shifted_%out_value
    !__num_swap_dst_shift_%out_value
    !__num_swap_inv_idx_%out_value
    !__num_swap_byte_%out_value
    !__num_swap_byte_raw_%out_value
    !__num_swap_src_shift_%out_value
    !__num_swap_acc_%out_value
    !__num_swap_done_%out_value
    !__num_swap_idx_%out_value
    jmp L_NUM_U64_SWAP_HEAD_%out_value

L_NUM_U64_SWAP_DONE_%out_value:
    %out_value = load __num_swap_acc_slot_%out_value+0 as u64
    !__num_swap_done_%out_value
    !__num_swap_idx_%out_value
[END_MACRO]

[MACRO] NUM_U64_TO_BE %out_value, %value
    EXPAND NUM_U64_SWAP_BYTES %out_value, %value
[END_MACRO]

[MACRO] NUM_U64_FROM_BE %out_value, %value
    EXPAND NUM_U64_SWAP_BYTES %out_value, %value
[END_MACRO]

[MACRO] NUM_U64_TO_LE %out_value, %value
    %out_value = add %value, 0
[END_MACRO]

[MACRO] NUM_U64_FROM_LE %out_value, %value
    %out_value = add %value, 0
[END_MACRO]

[MACRO] NUM_U64_WRITE_BE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    __num_u64_be_fits_%out_ok = uge %dst_len, 8
    br __num_u64_be_fits_%out_ok -> L_NUM_U64_WRITE_BE_BYTES_OK_%out_ok, L_NUM_U64_WRITE_BE_BYTES_FAIL_%out_ok

L_NUM_U64_WRITE_BE_BYTES_OK_%out_ok:
    __num_u64_be_b0_%out_ok = lshr %value, 56
    __num_u64_be_b1_raw_%out_ok = lshr %value, 48
    __num_u64_be_b1_%out_ok = and __num_u64_be_b1_raw_%out_ok, 255
    __num_u64_be_b2_raw_%out_ok = lshr %value, 40
    __num_u64_be_b2_%out_ok = and __num_u64_be_b2_raw_%out_ok, 255
    __num_u64_be_b3_raw_%out_ok = lshr %value, 32
    __num_u64_be_b3_%out_ok = and __num_u64_be_b3_raw_%out_ok, 255
    __num_u64_be_b4_raw_%out_ok = lshr %value, 24
    __num_u64_be_b4_%out_ok = and __num_u64_be_b4_raw_%out_ok, 255
    __num_u64_be_b5_raw_%out_ok = lshr %value, 16
    __num_u64_be_b5_%out_ok = and __num_u64_be_b5_raw_%out_ok, 255
    __num_u64_be_b6_raw_%out_ok = lshr %value, 8
    __num_u64_be_b6_%out_ok = and __num_u64_be_b6_raw_%out_ok, 255
    __num_u64_be_b7_%out_ok = and %value, 255
    __num_u64_be_p1_%out_ok = ptr_add %dst_ptr, 1
    __num_u64_be_p2_%out_ok = ptr_add %dst_ptr, 2
    __num_u64_be_p3_%out_ok = ptr_add %dst_ptr, 3
    __num_u64_be_p4_%out_ok = ptr_add %dst_ptr, 4
    __num_u64_be_p5_%out_ok = ptr_add %dst_ptr, 5
    __num_u64_be_p6_%out_ok = ptr_add %dst_ptr, 6
    __num_u64_be_p7_%out_ok = ptr_add %dst_ptr, 7
    store %dst_ptr+0, __num_u64_be_b0_%out_ok as u8
    store __num_u64_be_p1_%out_ok+0, __num_u64_be_b1_%out_ok as u8
    store __num_u64_be_p2_%out_ok+0, __num_u64_be_b2_%out_ok as u8
    store __num_u64_be_p3_%out_ok+0, __num_u64_be_b3_%out_ok as u8
    store __num_u64_be_p4_%out_ok+0, __num_u64_be_b4_%out_ok as u8
    store __num_u64_be_p5_%out_ok+0, __num_u64_be_b5_%out_ok as u8
    store __num_u64_be_p6_%out_ok+0, __num_u64_be_b6_%out_ok as u8
    store __num_u64_be_p7_%out_ok+0, __num_u64_be_b7_%out_ok as u8
    %out_ok = add 0, 1
    !__num_u64_be_p7_%out_ok
    !__num_u64_be_p6_%out_ok
    !__num_u64_be_p5_%out_ok
    !__num_u64_be_p4_%out_ok
    !__num_u64_be_p3_%out_ok
    !__num_u64_be_p2_%out_ok
    !__num_u64_be_p1_%out_ok
    !__num_u64_be_b7_%out_ok
    !__num_u64_be_b6_%out_ok
    !__num_u64_be_b6_raw_%out_ok
    !__num_u64_be_b5_%out_ok
    !__num_u64_be_b5_raw_%out_ok
    !__num_u64_be_b4_%out_ok
    !__num_u64_be_b4_raw_%out_ok
    !__num_u64_be_b3_%out_ok
    !__num_u64_be_b3_raw_%out_ok
    !__num_u64_be_b2_%out_ok
    !__num_u64_be_b2_raw_%out_ok
    !__num_u64_be_b1_%out_ok
    !__num_u64_be_b1_raw_%out_ok
    !__num_u64_be_b0_%out_ok
    !__num_u64_be_fits_%out_ok
    jmp L_NUM_U64_WRITE_BE_BYTES_END_%out_ok

L_NUM_U64_WRITE_BE_BYTES_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__num_u64_be_fits_%out_ok

L_NUM_U64_WRITE_BE_BYTES_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_WRITE_LE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    __num_u64_le_fits_%out_ok = uge %dst_len, 8
    br __num_u64_le_fits_%out_ok -> L_NUM_U64_WRITE_LE_BYTES_OK_%out_ok, L_NUM_U64_WRITE_LE_BYTES_FAIL_%out_ok

