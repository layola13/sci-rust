    __nonzero_signed_le_left_%out_bool = load %left_nz+%field as i64
    __nonzero_signed_le_right_%out_bool = load %right_nz+%field as i64
    %out_bool = sle __nonzero_signed_le_left_%out_bool, __nonzero_signed_le_right_%out_bool
    !__nonzero_signed_le_right_%out_bool
