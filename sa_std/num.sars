    __num_iwrap_div_rhs_neg_one_%out_value = eq %rhs, -1
    __num_iwrap_div_over_%out_value = and __num_iwrap_div_lhs_min_%out_value, __num_iwrap_div_rhs_neg_one_%out_value
    br __num_iwrap_div_over_%out_value -> L_NUM_I64_WRAP_DIV_MIN_%out_value, L_NUM_I64_WRAP_DIV_NORMAL_%out_value

