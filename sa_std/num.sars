    !__num_i32_wrem_over_%out_value
    !__num_i32_wrem_neg_one_%out_value
    !__num_i32_wrem_min_%out_value
    jmp L_NUM_I32_WRAP_REM_END_%out_value

L_NUM_I32_WRAP_REM_ZERO_%out_value:
    %out_value = add 0, 0
    !__num_i32_wrem_over_%out_value
    !__num_i32_wrem_neg_one_%out_value
