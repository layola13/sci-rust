    __wrapping_u32_tz_zero_%out_count = eq __wrapping_u32_tz_value_%out_count, 0
    br __wrapping_u32_tz_zero_%out_count -> L_WRAPPING_U32_TRAILING_ZEROS_ZERO_%out_count, L_WRAPPING_U32_TRAILING_ZEROS_BODY_%out_count

