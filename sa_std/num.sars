[MACRO] NUM_UNSIGNED_WIDTH_CARRYING_ADD %out_value, %out_carry, %lhs, %rhs, %carry, %mask
    __num_uw_cadd_lhs_%out_value = and %lhs, %mask
    __num_uw_cadd_rhs_%out_value = and %rhs, %mask
    __num_uw_cadd_sum_raw_%out_value = add __num_uw_cadd_lhs_%out_value, __num_uw_cadd_rhs_%out_value
    __num_uw_cadd_sum_%out_value = and __num_uw_cadd_sum_raw_%out_value, %mask
    __num_uw_cadd_over1_%out_value = ult __num_uw_cadd_sum_%out_value, __num_uw_cadd_lhs_%out_value
    __num_uw_cadd_carry_bit_%out_value = ne %carry, 0
    __num_uw_cadd_with_carry_raw_%out_value = add __num_uw_cadd_sum_%out_value, __num_uw_cadd_carry_bit_%out_value
    %out_value = and __num_uw_cadd_with_carry_raw_%out_value, %mask
    __num_uw_cadd_over2_%out_value = ult %out_value, __num_uw_cadd_sum_%out_value
