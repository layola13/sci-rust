[MACRO] NUM_SIGNED_WIDTH_OVERFLOWING_DIV %out_value, %out_overflow, %lhs, %rhs, %min, %div_zero_panic
    __num_sw_ov_div_zero_%out_value = eq %rhs, 0
    br __num_sw_ov_div_zero_%out_value -> L_NUM_SW_OV_DIV_ZERO_%out_value, L_NUM_SW_OV_DIV_CHECK_%out_value

L_NUM_SW_OV_DIV_CHECK_%out_value:
    __num_sw_ov_div_lhs_min_%out_value = eq %lhs, %min
    __num_sw_ov_div_rhs_neg_one_%out_value = eq %rhs, -1
    __num_sw_ov_div_over_%out_value = and __num_sw_ov_div_lhs_min_%out_value, __num_sw_ov_div_rhs_neg_one_%out_value
    br __num_sw_ov_div_over_%out_value -> L_NUM_SW_OV_DIV_OVER_%out_value, L_NUM_SW_OV_DIV_NORMAL_%out_value

L_NUM_SW_OV_DIV_NORMAL_%out_value:
    %out_value = sdiv %lhs, %rhs
    %out_overflow = add 0, 0
    !__num_sw_ov_div_over_%out_value
    !__num_sw_ov_div_rhs_neg_one_%out_value
    !__num_sw_ov_div_lhs_min_%out_value
    !__num_sw_ov_div_zero_%out_value
    jmp L_NUM_SW_OV_DIV_END_%out_value

L_NUM_SW_OV_DIV_OVER_%out_value:
    %out_value = add 0, %min
    %out_overflow = add 0, 1
    !__num_sw_ov_div_over_%out_value
    !__num_sw_ov_div_rhs_neg_one_%out_value
    !__num_sw_ov_div_lhs_min_%out_value
    !__num_sw_ov_div_zero_%out_value
    jmp L_NUM_SW_OV_DIV_END_%out_value

L_NUM_SW_OV_DIV_ZERO_%out_value:
    panic(%div_zero_panic)

L_NUM_SW_OV_DIV_END_%out_value:
[END_MACRO]

[MACRO] NUM_SIGNED_WIDTH_OVERFLOWING_REM %out_value, %out_overflow, %lhs, %rhs, %min, %rem_zero_panic
    __num_sw_ov_rem_zero_%out_value = eq %rhs, 0
    br __num_sw_ov_rem_zero_%out_value -> L_NUM_SW_OV_REM_ZERO_%out_value, L_NUM_SW_OV_REM_NEG_ONE_CHECK_%out_value

L_NUM_SW_OV_REM_NEG_ONE_CHECK_%out_value:
    __num_sw_ov_rem_rhs_neg_one_%out_value = eq %rhs, -1
    br __num_sw_ov_rem_rhs_neg_one_%out_value -> L_NUM_SW_OV_REM_NEG_ONE_%out_value, L_NUM_SW_OV_REM_NORMAL_%out_value

L_NUM_SW_OV_REM_NORMAL_%out_value:
    %out_value = srem %lhs, %rhs
    %out_overflow = add 0, 0
    !__num_sw_ov_rem_rhs_neg_one_%out_value
    !__num_sw_ov_rem_zero_%out_value
    jmp L_NUM_SW_OV_REM_END_%out_value

L_NUM_SW_OV_REM_NEG_ONE_%out_value:
    __num_sw_ov_rem_lhs_min_%out_value = eq %lhs, %min
    %out_value = add 0, 0
    %out_overflow = add __num_sw_ov_rem_lhs_min_%out_value, 0
    !__num_sw_ov_rem_lhs_min_%out_value
    !__num_sw_ov_rem_rhs_neg_one_%out_value
    !__num_sw_ov_rem_zero_%out_value
    jmp L_NUM_SW_OV_REM_END_%out_value

L_NUM_SW_OV_REM_ZERO_%out_value:
    panic(%rem_zero_panic)

L_NUM_SW_OV_REM_END_%out_value:
[END_MACRO]

[MACRO] NUM_SIGNED_WIDTH_OVERFLOWING_DIV_EUCLID %out_value, %out_overflow, %lhs, %rhs, %min, %div_zero_panic
    __num_sw_ov_div_euclid_zero_%out_value = eq %rhs, 0
    br __num_sw_ov_div_euclid_zero_%out_value -> L_NUM_SW_OV_DIV_EUCLID_ZERO_%out_value, L_NUM_SW_OV_DIV_EUCLID_CHECK_%out_value

L_NUM_SW_OV_DIV_EUCLID_CHECK_%out_value:
    __num_sw_ov_div_euclid_lhs_min_%out_value = eq %lhs, %min
    __num_sw_ov_div_euclid_rhs_neg_one_%out_value = eq %rhs, -1
    __num_sw_ov_div_euclid_over_%out_value = and __num_sw_ov_div_euclid_lhs_min_%out_value, __num_sw_ov_div_euclid_rhs_neg_one_%out_value
    br __num_sw_ov_div_euclid_over_%out_value -> L_NUM_SW_OV_DIV_EUCLID_OVER_%out_value, L_NUM_SW_OV_DIV_EUCLID_COMPUTE_%out_value

L_NUM_SW_OV_DIV_EUCLID_COMPUTE_%out_value:
    __num_sw_ov_div_euclid_q_%out_value = sdiv %lhs, %rhs
    __num_sw_ov_div_euclid_r_%out_value = srem %lhs, %rhs
    __num_sw_ov_div_euclid_r_neg_%out_value = slt __num_sw_ov_div_euclid_r_%out_value, 0
    br __num_sw_ov_div_euclid_r_neg_%out_value -> L_NUM_SW_OV_DIV_EUCLID_ADJUST_%out_value, L_NUM_SW_OV_DIV_EUCLID_OK_%out_value

L_NUM_SW_OV_DIV_EUCLID_ADJUST_%out_value:
    __num_sw_ov_div_euclid_rhs_pos_%out_value = sgt %rhs, 0
    br __num_sw_ov_div_euclid_rhs_pos_%out_value -> L_NUM_SW_OV_DIV_EUCLID_DEC_%out_value, L_NUM_SW_OV_DIV_EUCLID_INC_%out_value

L_NUM_SW_OV_DIV_EUCLID_DEC_%out_value:
    %out_value = sub __num_sw_ov_div_euclid_q_%out_value, 1
    %out_overflow = add 0, 0
    !__num_sw_ov_div_euclid_rhs_pos_%out_value
    !__num_sw_ov_div_euclid_r_neg_%out_value
    !__num_sw_ov_div_euclid_r_%out_value
    !__num_sw_ov_div_euclid_q_%out_value
    !__num_sw_ov_div_euclid_over_%out_value
    !__num_sw_ov_div_euclid_rhs_neg_one_%out_value
    !__num_sw_ov_div_euclid_lhs_min_%out_value
    !__num_sw_ov_div_euclid_zero_%out_value
    jmp L_NUM_SW_OV_DIV_EUCLID_END_%out_value

L_NUM_SW_OV_DIV_EUCLID_INC_%out_value:
    %out_value = add __num_sw_ov_div_euclid_q_%out_value, 1
    %out_overflow = add 0, 0
    !__num_sw_ov_div_euclid_rhs_pos_%out_value
    !__num_sw_ov_div_euclid_r_neg_%out_value
    !__num_sw_ov_div_euclid_r_%out_value
    !__num_sw_ov_div_euclid_q_%out_value
    !__num_sw_ov_div_euclid_over_%out_value
    !__num_sw_ov_div_euclid_rhs_neg_one_%out_value
    !__num_sw_ov_div_euclid_lhs_min_%out_value
    !__num_sw_ov_div_euclid_zero_%out_value
    jmp L_NUM_SW_OV_DIV_EUCLID_END_%out_value

L_NUM_SW_OV_DIV_EUCLID_OK_%out_value:
    %out_value = add __num_sw_ov_div_euclid_q_%out_value, 0
    %out_overflow = add 0, 0
    !__num_sw_ov_div_euclid_r_neg_%out_value
    !__num_sw_ov_div_euclid_r_%out_value
    !__num_sw_ov_div_euclid_q_%out_value
    !__num_sw_ov_div_euclid_over_%out_value
    !__num_sw_ov_div_euclid_rhs_neg_one_%out_value
    !__num_sw_ov_div_euclid_lhs_min_%out_value
    !__num_sw_ov_div_euclid_zero_%out_value
    jmp L_NUM_SW_OV_DIV_EUCLID_END_%out_value

L_NUM_SW_OV_DIV_EUCLID_OVER_%out_value:
    %out_value = add 0, %min
    %out_overflow = add 0, 1
    !__num_sw_ov_div_euclid_over_%out_value
    !__num_sw_ov_div_euclid_rhs_neg_one_%out_value
    !__num_sw_ov_div_euclid_lhs_min_%out_value
    !__num_sw_ov_div_euclid_zero_%out_value
    jmp L_NUM_SW_OV_DIV_EUCLID_END_%out_value

L_NUM_SW_OV_DIV_EUCLID_ZERO_%out_value:
    panic(%div_zero_panic)

L_NUM_SW_OV_DIV_EUCLID_END_%out_value:
