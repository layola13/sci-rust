    __nonzero_signed_ge_left_%out_bool = load %left_nz+%field as i64
    __nonzero_signed_ge_right_%out_bool = load %right_nz+%field as i64
    %out_bool = sge __nonzero_signed_ge_left_%out_bool, __nonzero_signed_ge_right_%out_bool
    !__nonzero_signed_ge_right_%out_bool
