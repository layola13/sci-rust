    __num_tz_mask_%out_count = shl 1, __num_tz_idx_%out_count
    __num_tz_masked_%out_count = and %value, __num_tz_mask_%out_count
    __num_tz_seen_one_%out_count = ne __num_tz_masked_%out_count, 0
    br __num_tz_seen_one_%out_count -> L_NUM_U64_TZ_FOUND_%out_count, L_NUM_U64_TZ_NEXT_%out_count

L_NUM_U64_TZ_NEXT_%out_count:
    __num_tz_next_%out_count = add __num_tz_idx_%out_count, 1
    store __num_tz_idx_slot_%out_count+0, __num_tz_next_%out_count as u64
    !__num_tz_next_%out_count
    !__num_tz_seen_one_%out_count
    !__num_tz_masked_%out_count
    !__num_tz_mask_%out_count
    !__num_tz_done_%out_count
    !__num_tz_idx_%out_count
