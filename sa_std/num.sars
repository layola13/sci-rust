L_SATURATING_U64_POW_DONE_%out_ptr:
    __saturating_u64_pow_result_%out_ptr = load __saturating_u64_pow_acc_slot_%out_ptr+0 as u64
    EXPAND SATURATING_U64_NEW %out_ptr, __saturating_u64_pow_result_%out_ptr
