    __num_i16_se_masked_%out_value = and %value, NUM_U16_MAX
    __num_i16_se_negative_%out_value = uge __num_i16_se_masked_%out_value, 32768
    br __num_i16_se_negative_%out_value -> L_NUM_I16_SIGN_EXTEND_NEG_%out_value, L_NUM_I16_SIGN_EXTEND_POS_%out_value

L_NUM_I16_SIGN_EXTEND_NEG_%out_value:
    %out_value = sub __num_i16_se_masked_%out_value, 65536
    !__num_i16_se_negative_%out_value
    !__num_i16_se_masked_%out_value
