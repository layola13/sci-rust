[MACRO] WRAPPING_U32_GT %out_bool, %left_ptr, %right_ptr
    __wrapping_u32_gt_left_raw_%out_bool = load %left_ptr+WrappingU32_value as u64
    __wrapping_u32_gt_right_raw_%out_bool = load %right_ptr+WrappingU32_value as u64
    __wrapping_u32_gt_left_%out_bool = and __wrapping_u32_gt_left_raw_%out_bool, NUM_U32_MAX
