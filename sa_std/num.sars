    !__num_u32_swap_01_%out_value
    !__num_u32_swap_s2_%out_value
    !__num_u32_swap_s1_%out_value
    !__num_u32_swap_s0_%out_value
    !__num_u32_swap_b3_%out_value
    !__num_u32_swap_b3_raw_%out_value
    !__num_u32_swap_b2_%out_value
    !__num_u32_swap_b2_raw_%out_value
    !__num_u32_swap_b1_%out_value
    !__num_u32_swap_b1_raw_%out_value
    !__num_u32_swap_b0_%out_value
