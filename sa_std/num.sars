    !__wrapping_u32_ne_eq_%out_bool
[END_MACRO]

[MACRO] WRAPPING_U32_CMP %out_ordering, %left_ptr, %right_ptr
    __wrapping_u32_cmp_left_raw_%out_ordering = load %left_ptr+WrappingU32_value as u64
    __wrapping_u32_cmp_right_raw_%out_ordering = load %right_ptr+WrappingU32_value as u64
    __wrapping_u32_cmp_left_%out_ordering = and __wrapping_u32_cmp_left_raw_%out_ordering, NUM_U32_MAX
    __wrapping_u32_cmp_right_%out_ordering = and __wrapping_u32_cmp_right_raw_%out_ordering, NUM_U32_MAX
    __wrapping_u32_cmp_lt_%out_ordering = ult __wrapping_u32_cmp_left_%out_ordering, __wrapping_u32_cmp_right_%out_ordering
    br __wrapping_u32_cmp_lt_%out_ordering -> L_WRAPPING_U32_CMP_LESS_%out_ordering, L_WRAPPING_U32_CMP_CHECK_GT_%out_ordering

L_WRAPPING_U32_CMP_LESS_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_LESS
    jmp L_WRAPPING_U32_CMP_DONE_%out_ordering

L_WRAPPING_U32_CMP_CHECK_GT_%out_ordering:
    __wrapping_u32_cmp_gt_%out_ordering = ugt __wrapping_u32_cmp_left_%out_ordering, __wrapping_u32_cmp_right_%out_ordering
    br __wrapping_u32_cmp_gt_%out_ordering -> L_WRAPPING_U32_CMP_GREATER_%out_ordering, L_WRAPPING_U32_CMP_EQUAL_%out_ordering

L_WRAPPING_U32_CMP_GREATER_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_GREATER
    !__wrapping_u32_cmp_gt_%out_ordering
    jmp L_WRAPPING_U32_CMP_DONE_%out_ordering

L_WRAPPING_U32_CMP_EQUAL_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_EQUAL
    !__wrapping_u32_cmp_gt_%out_ordering

L_WRAPPING_U32_CMP_DONE_%out_ordering:
    !__wrapping_u32_cmp_lt_%out_ordering
    !__wrapping_u32_cmp_right_%out_ordering
    !__wrapping_u32_cmp_left_%out_ordering
    !__wrapping_u32_cmp_right_raw_%out_ordering
    !__wrapping_u32_cmp_left_raw_%out_ordering
[END_MACRO]

