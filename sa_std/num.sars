    __num_uw_cmul_idx_%out_low = load __num_uw_cmul_idx_slot_%out_low+0 as u64
    __num_uw_cmul_done_%out_low = eq __num_uw_cmul_idx_%out_low, %bits
    br __num_uw_cmul_done_%out_low -> L_NUM_UW_CMUL_DONE_%out_low, L_NUM_UW_CMUL_BODY_%out_low

L_NUM_UW_CMUL_BODY_%out_low:
    __num_uw_cmul_rhs_%out_low = load __num_uw_cmul_rhs_slot_%out_low+0 as u64
