[END_MACRO]

[MACRO] NUM_I64_CHECKED_ISQRT %out_ok, %out_value, %value
    __num_i64_isqrt_negative_%out_ok = slt %value, 0
    br __num_i64_isqrt_negative_%out_ok -> L_NUM_I64_ISQRT_NONE_%out_ok, L_NUM_I64_ISQRT_SOME_%out_ok

L_NUM_I64_ISQRT_SOME_%out_ok:
    EXPAND NUM_U64_ISQRT %out_value, %value
    %out_ok = add 0, 1
    !__num_i64_isqrt_negative_%out_ok
    jmp L_NUM_I64_ISQRT_END_%out_ok

L_NUM_I64_ISQRT_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_i64_isqrt_negative_%out_ok

L_NUM_I64_ISQRT_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_ISQRT %out_value, %value
    EXPAND NUM_I64_CHECKED_ISQRT __num_i64_isqrt_ok_%out_value, %out_value, %value
    br __num_i64_isqrt_ok_%out_value -> L_NUM_I64_DIRECT_ISQRT_OK_%out_value, L_NUM_I64_DIRECT_ISQRT_PANIC_%out_value

L_NUM_I64_DIRECT_ISQRT_PANIC_%out_value:
    panic(2203)

L_NUM_I64_DIRECT_ISQRT_OK_%out_value:
    !__num_i64_isqrt_ok_%out_value
[END_MACRO]

[MACRO] NUM_I64_MIDPOINT %out_value, %lhs, %rhs
    __num_imid_lhs_nonneg_%out_value = sge %lhs, 0
    __num_imid_rhs_nonneg_%out_value = sge %rhs, 0
    __num_imid_same_sign_%out_value = eq __num_imid_lhs_nonneg_%out_value, __num_imid_rhs_nonneg_%out_value
    br __num_imid_same_sign_%out_value -> L_NUM_I64_MID_SAME_SIGN_%out_value, L_NUM_I64_MID_MIXED_SIGN_%out_value

L_NUM_I64_MID_SAME_SIGN_%out_value:
    __num_imid_half_lhs_%out_value = sdiv %lhs, 2
    __num_imid_half_rhs_%out_value = sdiv %rhs, 2
    __num_imid_rem_lhs_%out_value = srem %lhs, 2
    __num_imid_rem_rhs_%out_value = srem %rhs, 2
    __num_imid_rem_sum_%out_value = add __num_imid_rem_lhs_%out_value, __num_imid_rem_rhs_%out_value
    __num_imid_rem_half_%out_value = sdiv __num_imid_rem_sum_%out_value, 2
    __num_imid_half_sum_%out_value = add __num_imid_half_lhs_%out_value, __num_imid_half_rhs_%out_value
    %out_value = add __num_imid_half_sum_%out_value, __num_imid_rem_half_%out_value
    !__num_imid_half_sum_%out_value
    !__num_imid_rem_half_%out_value
    !__num_imid_rem_sum_%out_value
    !__num_imid_rem_rhs_%out_value
    !__num_imid_rem_lhs_%out_value
    !__num_imid_half_rhs_%out_value
    !__num_imid_half_lhs_%out_value
    !__num_imid_same_sign_%out_value
    !__num_imid_rhs_nonneg_%out_value
    !__num_imid_lhs_nonneg_%out_value
    jmp L_NUM_I64_MID_END_%out_value

L_NUM_I64_MID_MIXED_SIGN_%out_value:
    __num_imid_sum_%out_value = add %lhs, %rhs
    %out_value = sdiv __num_imid_sum_%out_value, 2
    !__num_imid_sum_%out_value
    !__num_imid_same_sign_%out_value
    !__num_imid_rhs_nonneg_%out_value
    !__num_imid_lhs_nonneg_%out_value

L_NUM_I64_MID_END_%out_value:
[END_MACRO]

[MACRO] NUM_I64_POW %out_value, %base, %exp
    __num_ipow_idx_slot_%out_value = stack_alloc 8
    __num_ipow_acc_slot_%out_value = stack_alloc 8
    store __num_ipow_idx_slot_%out_value+0, 0 as u64
    store __num_ipow_acc_slot_%out_value+0, 1 as i64
    jmp L_NUM_I64_POW_HEAD_%out_value

L_NUM_I64_POW_HEAD_%out_value:
    __num_ipow_idx_%out_value = load __num_ipow_idx_slot_%out_value+0 as u64
    __num_ipow_done_%out_value = eq __num_ipow_idx_%out_value, %exp
    br __num_ipow_done_%out_value -> L_NUM_I64_POW_DONE_%out_value, L_NUM_I64_POW_BODY_%out_value

L_NUM_I64_POW_BODY_%out_value:
    __num_ipow_acc_%out_value = load __num_ipow_acc_slot_%out_value+0 as i64
    __num_ipow_next_acc_%out_value = mul __num_ipow_acc_%out_value, %base
    __num_ipow_next_idx_%out_value = add __num_ipow_idx_%out_value, 1
    store __num_ipow_acc_slot_%out_value+0, __num_ipow_next_acc_%out_value as i64
    store __num_ipow_idx_slot_%out_value+0, __num_ipow_next_idx_%out_value as u64
    !__num_ipow_next_idx_%out_value
    !__num_ipow_next_acc_%out_value
    !__num_ipow_acc_%out_value
    !__num_ipow_done_%out_value
    !__num_ipow_idx_%out_value
    jmp L_NUM_I64_POW_HEAD_%out_value

L_NUM_I64_POW_DONE_%out_value:
    %out_value = load __num_ipow_acc_slot_%out_value+0 as i64
    !__num_ipow_done_%out_value
    !__num_ipow_idx_%out_value
[END_MACRO]

[MACRO] NUM_I64_CHECKED_POW %out_ok, %out_value, %base, %exp
    __num_ichecked_pow_idx_slot_%out_ok = stack_alloc 8
    __num_ichecked_pow_acc_slot_%out_ok = stack_alloc 8
    store __num_ichecked_pow_idx_slot_%out_ok+0, 0 as u64
    store __num_ichecked_pow_acc_slot_%out_ok+0, 1 as i64
    jmp L_NUM_I64_CHECKED_POW_HEAD_%out_ok

L_NUM_I64_CHECKED_POW_HEAD_%out_ok:
    __num_ichecked_pow_idx_%out_ok = load __num_ichecked_pow_idx_slot_%out_ok+0 as u64
    __num_ichecked_pow_done_%out_ok = eq __num_ichecked_pow_idx_%out_ok, %exp
    br __num_ichecked_pow_done_%out_ok -> L_NUM_I64_CHECKED_POW_DONE_%out_ok, L_NUM_I64_CHECKED_POW_BODY_%out_ok

L_NUM_I64_CHECKED_POW_BODY_%out_ok:
    __num_ichecked_pow_acc_%out_ok = load __num_ichecked_pow_acc_slot_%out_ok+0 as i64
    EXPAND NUM_I64_CHECKED_MUL __num_ichecked_pow_mul_ok_%out_ok, __num_ichecked_pow_mul_value_%out_ok, __num_ichecked_pow_acc_%out_ok, %base
    br __num_ichecked_pow_mul_ok_%out_ok -> L_NUM_I64_CHECKED_POW_STEP_%out_ok, L_NUM_I64_CHECKED_POW_OVERFLOW_%out_ok

L_NUM_I64_CHECKED_POW_STEP_%out_ok:
    __num_ichecked_pow_next_idx_%out_ok = add __num_ichecked_pow_idx_%out_ok, 1
    store __num_ichecked_pow_acc_slot_%out_ok+0, __num_ichecked_pow_mul_value_%out_ok as i64
    store __num_ichecked_pow_idx_slot_%out_ok+0, __num_ichecked_pow_next_idx_%out_ok as u64
    !__num_ichecked_pow_next_idx_%out_ok
    !__num_ichecked_pow_mul_value_%out_ok
    !__num_ichecked_pow_mul_ok_%out_ok
    !__num_ichecked_pow_acc_%out_ok
    !__num_ichecked_pow_done_%out_ok
    !__num_ichecked_pow_idx_%out_ok
    jmp L_NUM_I64_CHECKED_POW_HEAD_%out_ok

L_NUM_I64_CHECKED_POW_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_ichecked_pow_mul_value_%out_ok
    !__num_ichecked_pow_mul_ok_%out_ok
    !__num_ichecked_pow_acc_%out_ok
    !__num_ichecked_pow_done_%out_ok
    !__num_ichecked_pow_idx_%out_ok
    jmp L_NUM_I64_CHECKED_POW_END_%out_ok

L_NUM_I64_CHECKED_POW_DONE_%out_ok:
    %out_value = load __num_ichecked_pow_acc_slot_%out_ok+0 as i64
    %out_ok = add 0, 1
    !__num_ichecked_pow_done_%out_ok
    !__num_ichecked_pow_idx_%out_ok

L_NUM_I64_CHECKED_POW_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_STRICT_POW %out_value, %base, %exp
    EXPAND NUM_I64_CHECKED_POW __num_istrict_pow_ok_%out_value, %out_value, %base, %exp
    br __num_istrict_pow_ok_%out_value -> L_NUM_I64_STRICT_POW_OK_%out_value, L_NUM_I64_STRICT_POW_PANIC_%out_value

L_NUM_I64_STRICT_POW_PANIC_%out_value:
    panic(2204)

L_NUM_I64_STRICT_POW_OK_%out_value:
    !__num_istrict_pow_ok_%out_value
[END_MACRO]

[MACRO] NUM_I8_SIGN_EXTEND %out_value, %value
    __num_i8_se_masked_%out_value = and %value, NUM_U8_MAX
    __num_i8_se_negative_%out_value = uge __num_i8_se_masked_%out_value, 128
    br __num_i8_se_negative_%out_value -> L_NUM_I8_SIGN_EXTEND_NEG_%out_value, L_NUM_I8_SIGN_EXTEND_POS_%out_value

L_NUM_I8_SIGN_EXTEND_NEG_%out_value:
    %out_value = sub __num_i8_se_masked_%out_value, 256
    !__num_i8_se_negative_%out_value
    !__num_i8_se_masked_%out_value
    jmp L_NUM_I8_SIGN_EXTEND_END_%out_value

L_NUM_I8_SIGN_EXTEND_POS_%out_value:
    %out_value = add __num_i8_se_masked_%out_value, 0
    !__num_i8_se_negative_%out_value
    !__num_i8_se_masked_%out_value

L_NUM_I8_SIGN_EXTEND_END_%out_value:
[END_MACRO]

