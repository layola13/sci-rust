    !__num_u64_ov_sub_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_MUL %out_value, %out_overflow, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_MUL __num_u64_ov_mul_ok_%out_value, __num_u64_ov_mul_value_%out_value, %lhs, %rhs
    EXPAND NUM_U64_WRAPPING_MUL %out_value, %lhs, %rhs
    %out_overflow = eq __num_u64_ov_mul_ok_%out_value, 0
    !__num_u64_ov_mul_value_%out_value
    !__num_u64_ov_mul_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_POW %out_value, %out_overflow, %base, %exp
    EXPAND NUM_U64_CHECKED_POW __num_u64_ov_pow_ok_%out_value, __num_u64_ov_pow_value_%out_value, %base, %exp
    EXPAND NUM_U64_POW %out_value, %base, %exp
    %out_overflow = eq __num_u64_ov_pow_ok_%out_value, 0
    !__num_u64_ov_pow_value_%out_value
    !__num_u64_ov_pow_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_DIV %out_value, %out_overflow, %lhs, %rhs
    EXPAND NUM_UNSIGNED_WIDTH_OVERFLOWING_DIV %out_value, %out_overflow, %lhs, %rhs, NUM_U64_MAX
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_DIV_EUCLID %out_value, %out_overflow, %lhs, %rhs
