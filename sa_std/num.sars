    __saturating_i64_pow_exp_odd_%out_ptr = eq __saturating_i64_pow_exp_low_%out_ptr, 1
    __saturating_i64_pow_sat_min_%out_ptr = and __saturating_i64_pow_base_neg_%out_ptr, __saturating_i64_pow_exp_odd_%out_ptr
    br __saturating_i64_pow_sat_min_%out_ptr -> L_SATURATING_I64_POW_MIN_%out_ptr, L_SATURATING_I64_POW_MAX_%out_ptr

L_SATURATING_I64_POW_MIN_%out_ptr:
    EXPAND SATURATING_I64_NEW %out_ptr, NUM_I64_MIN
    !__saturating_i64_pow_sat_min_%out_ptr
    !__saturating_i64_pow_exp_odd_%out_ptr
    !__saturating_i64_pow_exp_low_%out_ptr
    !__saturating_i64_pow_base_neg_%out_ptr
    !__saturating_i64_pow_mul_ok_%out_ptr
    !__saturating_i64_pow_mul_value_%out_ptr
    !__saturating_i64_pow_acc_%out_ptr
    !__saturating_i64_pow_done_%out_ptr
    !__saturating_i64_pow_idx_%out_ptr
    jmp L_SATURATING_I64_POW_END_%out_ptr

L_SATURATING_I64_POW_MAX_%out_ptr:
