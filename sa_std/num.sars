    !__num_isat_cast_nonnegative_%out_value

L_NUM_SIGNED_SAT_CAST_END_%out_value:
[END_MACRO]

[MACRO] NUM_SIGNED_WIDTH_CHECKED_CAST_UNSIGNED %out_ok, %out_value, %value, %mask
    __num_ichecked_cast_nonnegative_%out_ok = sge %value, 0
    br __num_ichecked_cast_nonnegative_%out_ok -> L_NUM_SIGNED_CHECKED_CAST_SOME_%out_ok, L_NUM_SIGNED_CHECKED_CAST_NONE_%out_ok

L_NUM_SIGNED_CHECKED_CAST_SOME_%out_ok:
    %out_value = and %value, %mask
    %out_ok = add 0, 1
    !__num_ichecked_cast_nonnegative_%out_ok
