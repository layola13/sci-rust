    __wrapping_u32_next_pow_keep_%out_ptr = and __wrapping_u32_next_pow_ok_%out_ptr, __wrapping_u32_next_pow_in_range_%out_ptr
    br __wrapping_u32_next_pow_keep_%out_ptr -> L_WRAPPING_U32_NEXT_POWER_VALUE_%out_ptr, L_WRAPPING_U32_NEXT_POWER_ZERO_%out_ptr

