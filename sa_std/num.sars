    __num_u64_le_b1_%out_ok = and __num_u64_le_b1_raw_%out_ok, 255
    __num_u64_le_b2_raw_%out_ok = lshr %value, 16
    __num_u64_le_b2_%out_ok = and __num_u64_le_b2_raw_%out_ok, 255
    __num_u64_le_b3_raw_%out_ok = lshr %value, 24
    __num_u64_le_b3_%out_ok = and __num_u64_le_b3_raw_%out_ok, 255
    __num_u64_le_b4_raw_%out_ok = lshr %value, 32
    __num_u64_le_b4_%out_ok = and __num_u64_le_b4_raw_%out_ok, 255
    __num_u64_le_b5_raw_%out_ok = lshr %value, 40
    __num_u64_le_b5_%out_ok = and __num_u64_le_b5_raw_%out_ok, 255
    __num_u64_le_b6_raw_%out_ok = lshr %value, 48
    __num_u64_le_b6_%out_ok = and __num_u64_le_b6_raw_%out_ok, 255
    __num_u64_le_b7_%out_ok = lshr %value, 56
    __num_u64_le_p1_%out_ok = ptr_add %dst_ptr, 1
