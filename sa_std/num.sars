    !__sat_i64_div_over_%out_ptr
    !__sat_i64_div_rhs_neg_one_%out_ptr
    !__sat_i64_div_lhs_min_%out_ptr
    !__sat_i64_div_rhs_%out_ptr
    !__sat_i64_div_lhs_%out_ptr
    jmp L_SATURATING_I64_DIV_DONE_%out_ptr

L_SATURATING_I64_DIV_MAX_%out_ptr:
    EXPAND SATURATING_I64_NEW %out_ptr, NUM_I64_MAX
    !__sat_i64_div_over_%out_ptr
    !__sat_i64_div_rhs_neg_one_%out_ptr
    !__sat_i64_div_lhs_min_%out_ptr
    !__sat_i64_div_rhs_%out_ptr
    !__sat_i64_div_lhs_%out_ptr

L_SATURATING_I64_DIV_DONE_%out_ptr:
[END_MACRO]

