    br %div_ok -> L_NUM_DIV_EXACT_CHECK_%out_ok, L_NUM_DIV_EXACT_NONE_%out_ok

L_NUM_DIV_EXACT_CHECK_%out_ok:
    __num_div_exact_product_%out_ok = mul %quotient, %rhs
    %out_ok = eq __num_div_exact_product_%out_ok, %lhs
    %out_value = mul %out_ok, %quotient
    !__num_div_exact_product_%out_ok
    jmp L_NUM_DIV_EXACT_END_%out_ok

L_NUM_DIV_EXACT_NONE_%out_ok:
    %out_ok = add 0, 0
    %out_value = add 0, 0

L_NUM_DIV_EXACT_END_%out_ok:
[END_MACRO]

