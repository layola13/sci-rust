L_SATURATING_I64_POW_DONE_%out_ptr:
    __saturating_i64_pow_result_%out_ptr = load __saturating_i64_pow_acc_slot_%out_ptr+0 as i64
    EXPAND SATURATING_I64_NEW %out_ptr, __saturating_i64_pow_result_%out_ptr
    !__saturating_i64_pow_result_%out_ptr
