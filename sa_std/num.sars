L_NUM_U64_TZ_FOUND_%out_count:
    %out_count = add __num_tz_idx_%out_count, 0
    !__num_tz_seen_one_%out_count
    !__num_tz_masked_%out_count
    !__num_tz_mask_%out_count
    !__num_tz_done_%out_count
    !__num_tz_idx_%out_count
    jmp L_NUM_U64_TZ_END_%out_count

L_NUM_U64_TZ_ALL_%out_count:
