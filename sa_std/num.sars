@import "num.sal"
@import "hash.sars"
@import "cmp.sal"

[MACRO] NONZERO_UNSIGNED_EQ_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_unsigned_eq_left_%out_bool = load %left_nz+%field as u64
    __nonzero_unsigned_eq_right_%out_bool = load %right_nz+%field as u64
    %out_bool = eq __nonzero_unsigned_eq_left_%out_bool, __nonzero_unsigned_eq_right_%out_bool
    !__nonzero_unsigned_eq_right_%out_bool
    !__nonzero_unsigned_eq_left_%out_bool
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_NE_FIELD %out_bool, %left_nz, %right_nz, %field
    EXPAND NONZERO_UNSIGNED_EQ_FIELD __nonzero_unsigned_ne_eq_%out_bool, %left_nz, %right_nz, %field
    %out_bool = eq __nonzero_unsigned_ne_eq_%out_bool, 0
    !__nonzero_unsigned_ne_eq_%out_bool
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_CMP_FIELD %out_ordering, %left_nz, %right_nz, %field
    __nonzero_unsigned_cmp_left_%out_ordering = load %left_nz+%field as u64
    __nonzero_unsigned_cmp_right_%out_ordering = load %right_nz+%field as u64
    __nonzero_unsigned_cmp_lt_%out_ordering = ult __nonzero_unsigned_cmp_left_%out_ordering, __nonzero_unsigned_cmp_right_%out_ordering
    br __nonzero_unsigned_cmp_lt_%out_ordering -> L_NONZERO_UNSIGNED_CMP_LESS_%out_ordering, L_NONZERO_UNSIGNED_CMP_CHECK_GT_%out_ordering
L_NONZERO_UNSIGNED_CMP_LESS_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_LESS
    jmp L_NONZERO_UNSIGNED_CMP_DONE_%out_ordering
L_NONZERO_UNSIGNED_CMP_CHECK_GT_%out_ordering:
    __nonzero_unsigned_cmp_gt_%out_ordering = ugt __nonzero_unsigned_cmp_left_%out_ordering, __nonzero_unsigned_cmp_right_%out_ordering
    br __nonzero_unsigned_cmp_gt_%out_ordering -> L_NONZERO_UNSIGNED_CMP_GREATER_%out_ordering, L_NONZERO_UNSIGNED_CMP_EQUAL_%out_ordering
L_NONZERO_UNSIGNED_CMP_GREATER_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_GREATER
    !__nonzero_unsigned_cmp_gt_%out_ordering
    jmp L_NONZERO_UNSIGNED_CMP_DONE_%out_ordering
L_NONZERO_UNSIGNED_CMP_EQUAL_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_EQUAL
    !__nonzero_unsigned_cmp_gt_%out_ordering
L_NONZERO_UNSIGNED_CMP_DONE_%out_ordering:
    !__nonzero_unsigned_cmp_lt_%out_ordering
    !__nonzero_unsigned_cmp_right_%out_ordering
    !__nonzero_unsigned_cmp_left_%out_ordering
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_LT_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_unsigned_lt_left_%out_bool = load %left_nz+%field as u64
    __nonzero_unsigned_lt_right_%out_bool = load %right_nz+%field as u64
    %out_bool = ult __nonzero_unsigned_lt_left_%out_bool, __nonzero_unsigned_lt_right_%out_bool
    !__nonzero_unsigned_lt_right_%out_bool
    !__nonzero_unsigned_lt_left_%out_bool
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_LE_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_unsigned_le_left_%out_bool = load %left_nz+%field as u64
    __nonzero_unsigned_le_right_%out_bool = load %right_nz+%field as u64
    %out_bool = ule __nonzero_unsigned_le_left_%out_bool, __nonzero_unsigned_le_right_%out_bool
    !__nonzero_unsigned_le_right_%out_bool
    !__nonzero_unsigned_le_left_%out_bool
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_GT_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_unsigned_gt_left_%out_bool = load %left_nz+%field as u64
    __nonzero_unsigned_gt_right_%out_bool = load %right_nz+%field as u64
    %out_bool = ugt __nonzero_unsigned_gt_left_%out_bool, __nonzero_unsigned_gt_right_%out_bool
    !__nonzero_unsigned_gt_right_%out_bool
    !__nonzero_unsigned_gt_left_%out_bool
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_GE_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_unsigned_ge_left_%out_bool = load %left_nz+%field as u64
    __nonzero_unsigned_ge_right_%out_bool = load %right_nz+%field as u64
    %out_bool = uge __nonzero_unsigned_ge_left_%out_bool, __nonzero_unsigned_ge_right_%out_bool
    !__nonzero_unsigned_ge_right_%out_bool
    !__nonzero_unsigned_ge_left_%out_bool
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_MIN_FIELD %out_nz, %left_nz, %right_nz, %field
    __nonzero_unsigned_min_left_%out_nz = load %left_nz+%field as u64
    __nonzero_unsigned_min_right_%out_nz = load %right_nz+%field as u64
    __nonzero_unsigned_min_take_left_%out_nz = ule __nonzero_unsigned_min_left_%out_nz, __nonzero_unsigned_min_right_%out_nz
    br __nonzero_unsigned_min_take_left_%out_nz -> L_NONZERO_UNSIGNED_MIN_LEFT_%out_nz, L_NONZERO_UNSIGNED_MIN_RIGHT_%out_nz
L_NONZERO_UNSIGNED_MIN_LEFT_%out_nz:
    store %out_nz+%field, __nonzero_unsigned_min_left_%out_nz as u64
    !__nonzero_unsigned_min_take_left_%out_nz
    jmp L_NONZERO_UNSIGNED_MIN_DONE_%out_nz
L_NONZERO_UNSIGNED_MIN_RIGHT_%out_nz:
    store %out_nz+%field, __nonzero_unsigned_min_right_%out_nz as u64
    !__nonzero_unsigned_min_take_left_%out_nz
L_NONZERO_UNSIGNED_MIN_DONE_%out_nz:
    !__nonzero_unsigned_min_right_%out_nz
    !__nonzero_unsigned_min_left_%out_nz
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_MAX_FIELD %out_nz, %left_nz, %right_nz, %field
    __nonzero_unsigned_max_left_%out_nz = load %left_nz+%field as u64
    __nonzero_unsigned_max_right_%out_nz = load %right_nz+%field as u64
    __nonzero_unsigned_max_take_left_%out_nz = uge __nonzero_unsigned_max_left_%out_nz, __nonzero_unsigned_max_right_%out_nz
    br __nonzero_unsigned_max_take_left_%out_nz -> L_NONZERO_UNSIGNED_MAX_LEFT_%out_nz, L_NONZERO_UNSIGNED_MAX_RIGHT_%out_nz
L_NONZERO_UNSIGNED_MAX_LEFT_%out_nz:
    store %out_nz+%field, __nonzero_unsigned_max_left_%out_nz as u64
    !__nonzero_unsigned_max_take_left_%out_nz
    jmp L_NONZERO_UNSIGNED_MAX_DONE_%out_nz
L_NONZERO_UNSIGNED_MAX_RIGHT_%out_nz:
    store %out_nz+%field, __nonzero_unsigned_max_right_%out_nz as u64
    !__nonzero_unsigned_max_take_left_%out_nz
L_NONZERO_UNSIGNED_MAX_DONE_%out_nz:
    !__nonzero_unsigned_max_right_%out_nz
    !__nonzero_unsigned_max_left_%out_nz
[END_MACRO]

[MACRO] NONZERO_SIGNED_EQ_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_signed_eq_left_%out_bool = load %left_nz+%field as i64
    __nonzero_signed_eq_right_%out_bool = load %right_nz+%field as i64
    %out_bool = eq __nonzero_signed_eq_left_%out_bool, __nonzero_signed_eq_right_%out_bool
    !__nonzero_signed_eq_right_%out_bool
    !__nonzero_signed_eq_left_%out_bool
[END_MACRO]

[MACRO] NONZERO_SIGNED_NE_FIELD %out_bool, %left_nz, %right_nz, %field
    EXPAND NONZERO_SIGNED_EQ_FIELD __nonzero_signed_ne_eq_%out_bool, %left_nz, %right_nz, %field
    %out_bool = eq __nonzero_signed_ne_eq_%out_bool, 0
    !__nonzero_signed_ne_eq_%out_bool
[END_MACRO]

[MACRO] NONZERO_SIGNED_CMP_FIELD %out_ordering, %left_nz, %right_nz, %field
    __nonzero_signed_cmp_left_%out_ordering = load %left_nz+%field as i64
    __nonzero_signed_cmp_right_%out_ordering = load %right_nz+%field as i64
    __nonzero_signed_cmp_lt_%out_ordering = slt __nonzero_signed_cmp_left_%out_ordering, __nonzero_signed_cmp_right_%out_ordering
    br __nonzero_signed_cmp_lt_%out_ordering -> L_NONZERO_SIGNED_CMP_LESS_%out_ordering, L_NONZERO_SIGNED_CMP_CHECK_GT_%out_ordering
L_NONZERO_SIGNED_CMP_LESS_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_LESS
    jmp L_NONZERO_SIGNED_CMP_DONE_%out_ordering
L_NONZERO_SIGNED_CMP_CHECK_GT_%out_ordering:
    __nonzero_signed_cmp_gt_%out_ordering = sgt __nonzero_signed_cmp_left_%out_ordering, __nonzero_signed_cmp_right_%out_ordering
    br __nonzero_signed_cmp_gt_%out_ordering -> L_NONZERO_SIGNED_CMP_GREATER_%out_ordering, L_NONZERO_SIGNED_CMP_EQUAL_%out_ordering
L_NONZERO_SIGNED_CMP_GREATER_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_GREATER
    !__nonzero_signed_cmp_gt_%out_ordering
    jmp L_NONZERO_SIGNED_CMP_DONE_%out_ordering
L_NONZERO_SIGNED_CMP_EQUAL_%out_ordering:
    %out_ordering = add 0, CMP_ORDERING_EQUAL
    !__nonzero_signed_cmp_gt_%out_ordering
L_NONZERO_SIGNED_CMP_DONE_%out_ordering:
    !__nonzero_signed_cmp_lt_%out_ordering
    !__nonzero_signed_cmp_right_%out_ordering
    !__nonzero_signed_cmp_left_%out_ordering
[END_MACRO]

[MACRO] NONZERO_SIGNED_LT_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_signed_lt_left_%out_bool = load %left_nz+%field as i64
    __nonzero_signed_lt_right_%out_bool = load %right_nz+%field as i64
    %out_bool = slt __nonzero_signed_lt_left_%out_bool, __nonzero_signed_lt_right_%out_bool
    !__nonzero_signed_lt_right_%out_bool
    !__nonzero_signed_lt_left_%out_bool
[END_MACRO]

