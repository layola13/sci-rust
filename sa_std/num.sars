    !__nonzero_signed_min_left_%out_nz
[END_MACRO]

[MACRO] NONZERO_SIGNED_MAX_FIELD %out_nz, %left_nz, %right_nz, %field
    __nonzero_signed_max_left_%out_nz = load %left_nz+%field as i64
    __nonzero_signed_max_right_%out_nz = load %right_nz+%field as i64
    __nonzero_signed_max_take_left_%out_nz = sge __nonzero_signed_max_left_%out_nz, __nonzero_signed_max_right_%out_nz
    br __nonzero_signed_max_take_left_%out_nz -> L_NONZERO_SIGNED_MAX_LEFT_%out_nz, L_NONZERO_SIGNED_MAX_RIGHT_%out_nz
L_NONZERO_SIGNED_MAX_LEFT_%out_nz:
    store %out_nz+%field, __nonzero_signed_max_left_%out_nz as i64
    !__nonzero_signed_max_take_left_%out_nz
