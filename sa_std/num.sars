[MACRO] NUM_SIGNED_DIV_FLOOR_RESULT_OR_PANIC %out_value, %div_ok, %quotient, %lhs, %rhs
    br %div_ok -> L_NUM_SIGNED_DIV_FLOOR_COMPUTE_%out_value, L_NUM_SIGNED_DIV_FLOOR_PANIC_%out_value

L_NUM_SIGNED_DIV_FLOOR_PANIC_%out_value:
    panic(2208)

L_NUM_SIGNED_DIV_FLOOR_COMPUTE_%out_value:
    __num_signed_div_floor_rem_%out_value = srem %lhs, %rhs
    __num_signed_div_floor_has_rem_%out_value = ne __num_signed_div_floor_rem_%out_value, 0
    __num_signed_div_floor_lhs_neg_%out_value = slt %lhs, 0
    __num_signed_div_floor_rhs_neg_%out_value = slt %rhs, 0
    __num_signed_div_floor_signs_differ_%out_value = ne __num_signed_div_floor_lhs_neg_%out_value, __num_signed_div_floor_rhs_neg_%out_value
    __num_signed_div_floor_correct_%out_value = and __num_signed_div_floor_has_rem_%out_value, __num_signed_div_floor_signs_differ_%out_value
    %out_value = sub %quotient, __num_signed_div_floor_correct_%out_value
    !__num_signed_div_floor_correct_%out_value
    !__num_signed_div_floor_signs_differ_%out_value
    !__num_signed_div_floor_rhs_neg_%out_value
    !__num_signed_div_floor_lhs_neg_%out_value
    !__num_signed_div_floor_has_rem_%out_value
    !__num_signed_div_floor_rem_%out_value
[END_MACRO]

