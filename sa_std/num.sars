    %out_value = udiv %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_REM_EUCLID %out_value, %lhs, %rhs
    %out_value = urem %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_CHECKED_DIV_EUCLID %out_ok, %out_value, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_DIV %out_ok, %out_value, %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_STRICT_DIV_EUCLID %out_value, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_DIV_EUCLID __num_u64_strict_div_euclid_ok_%out_value, %out_value, %lhs, %rhs
    br __num_u64_strict_div_euclid_ok_%out_value -> L_NUM_U64_STRICT_DIV_EUCLID_OK_%out_value, L_NUM_U64_STRICT_DIV_EUCLID_PANIC_%out_value

L_NUM_U64_STRICT_DIV_EUCLID_PANIC_%out_value:
    panic(2210)

L_NUM_U64_STRICT_DIV_EUCLID_OK_%out_value:
    !__num_u64_strict_div_euclid_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_CHECKED_REM_EUCLID %out_ok, %out_value, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_REM %out_ok, %out_value, %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_STRICT_REM_EUCLID %out_value, %lhs, %rhs
