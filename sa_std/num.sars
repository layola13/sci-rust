    __saturating_u64_pow_idx_slot_%out_ptr = stack_alloc 8
    store __saturating_u64_pow_acc_slot_%out_ptr+0, 1 as u64
    store __saturating_u64_pow_idx_slot_%out_ptr+0, 0 as u64
