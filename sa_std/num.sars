    __num_rotl_right_%out_value = sub NUM_U64_BITS, __num_rotl_shift_%out_value
    __num_rotl_left_part_%out_value = shl %value, __num_rotl_shift_%out_value
    __num_rotl_right_part_%out_value = lshr %value, __num_rotl_right_%out_value
