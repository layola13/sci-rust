[MACRO] NUM_U64_COUNT_ONES %out_count, %value
    __num_count_idx_slot_%out_count = stack_alloc 8
    __num_count_value_slot_%out_count = stack_alloc 8
    __num_count_count_slot_%out_count = stack_alloc 8
    store __num_count_idx_slot_%out_count+0, 0 as u64
    store __num_count_value_slot_%out_count+0, %value as u64
    store __num_count_count_slot_%out_count+0, 0 as u64
    jmp L_NUM_U64_COUNT_HEAD_%out_count

L_NUM_U64_COUNT_HEAD_%out_count:
    __num_count_idx_%out_count = load __num_count_idx_slot_%out_count+0 as u64
    __num_count_done_%out_count = eq __num_count_idx_%out_count, NUM_U64_BITS
    br __num_count_done_%out_count -> L_NUM_U64_COUNT_DONE_%out_count, L_NUM_U64_COUNT_BODY_%out_count

L_NUM_U64_COUNT_BODY_%out_count:
    __num_count_value_%out_count = load __num_count_value_slot_%out_count+0 as u64
    __num_count_acc_%out_count = load __num_count_count_slot_%out_count+0 as u64
    __num_count_bit_%out_count = and __num_count_value_%out_count, 1
    __num_count_next_acc_%out_count = add __num_count_acc_%out_count, __num_count_bit_%out_count
    __num_count_next_value_%out_count = lshr __num_count_value_%out_count, 1
    __num_count_next_idx_%out_count = add __num_count_idx_%out_count, 1
    store __num_count_count_slot_%out_count+0, __num_count_next_acc_%out_count as u64
    store __num_count_value_slot_%out_count+0, __num_count_next_value_%out_count as u64
    store __num_count_idx_slot_%out_count+0, __num_count_next_idx_%out_count as u64
    !__num_count_next_idx_%out_count
    !__num_count_next_value_%out_count
    !__num_count_next_acc_%out_count
    !__num_count_bit_%out_count
    !__num_count_acc_%out_count
    !__num_count_value_%out_count
    !__num_count_done_%out_count
    !__num_count_idx_%out_count
    jmp L_NUM_U64_COUNT_HEAD_%out_count

L_NUM_U64_COUNT_DONE_%out_count:
    %out_count = load __num_count_count_slot_%out_count+0 as u64
    !__num_count_done_%out_count
    !__num_count_idx_%out_count
[END_MACRO]

[MACRO] NUM_U64_COUNT_ZEROS %out_count, %value
    EXPAND NUM_U64_COUNT_ONES __num_count_ones_%out_count, %value
    %out_count = sub NUM_U64_BITS, __num_count_ones_%out_count
    !__num_count_ones_%out_count
[END_MACRO]

[MACRO] NUM_U64_POW %out_value, %base, %exp
    __num_pow_idx_slot_%out_value = stack_alloc 8
    __num_pow_acc_slot_%out_value = stack_alloc 8
    store __num_pow_idx_slot_%out_value+0, 0 as u64
    store __num_pow_acc_slot_%out_value+0, 1 as u64
    jmp L_NUM_U64_POW_HEAD_%out_value

L_NUM_U64_POW_HEAD_%out_value:
    __num_pow_idx_%out_value = load __num_pow_idx_slot_%out_value+0 as u64
    __num_pow_done_%out_value = eq __num_pow_idx_%out_value, %exp
    br __num_pow_done_%out_value -> L_NUM_U64_POW_DONE_%out_value, L_NUM_U64_POW_BODY_%out_value

L_NUM_U64_POW_BODY_%out_value:
    __num_pow_acc_%out_value = load __num_pow_acc_slot_%out_value+0 as u64
    __num_pow_next_acc_%out_value = mul __num_pow_acc_%out_value, %base
    __num_pow_next_idx_%out_value = add __num_pow_idx_%out_value, 1
    store __num_pow_acc_slot_%out_value+0, __num_pow_next_acc_%out_value as u64
    store __num_pow_idx_slot_%out_value+0, __num_pow_next_idx_%out_value as u64
    !__num_pow_next_idx_%out_value
    !__num_pow_next_acc_%out_value
    !__num_pow_acc_%out_value
    !__num_pow_done_%out_value
    !__num_pow_idx_%out_value
    jmp L_NUM_U64_POW_HEAD_%out_value

L_NUM_U64_POW_DONE_%out_value:
    %out_value = load __num_pow_acc_slot_%out_value+0 as u64
    !__num_pow_done_%out_value
    !__num_pow_idx_%out_value
[END_MACRO]

[MACRO] NUM_U64_CHECKED_POW %out_ok, %out_value, %base, %exp
    __num_checked_pow_idx_slot_%out_ok = stack_alloc 8
    __num_checked_pow_acc_slot_%out_ok = stack_alloc 8
    store __num_checked_pow_idx_slot_%out_ok+0, 0 as u64
    store __num_checked_pow_acc_slot_%out_ok+0, 1 as u64
    jmp L_NUM_U64_CHECKED_POW_HEAD_%out_ok

L_NUM_U64_CHECKED_POW_HEAD_%out_ok:
    __num_checked_pow_idx_%out_ok = load __num_checked_pow_idx_slot_%out_ok+0 as u64
    __num_checked_pow_done_%out_ok = eq __num_checked_pow_idx_%out_ok, %exp
    br __num_checked_pow_done_%out_ok -> L_NUM_U64_CHECKED_POW_DONE_%out_ok, L_NUM_U64_CHECKED_POW_BODY_%out_ok

L_NUM_U64_CHECKED_POW_BODY_%out_ok:
    __num_checked_pow_acc_%out_ok = load __num_checked_pow_acc_slot_%out_ok+0 as u64
    EXPAND NUM_U64_CHECKED_MUL __num_checked_pow_mul_ok_%out_ok, __num_checked_pow_mul_value_%out_ok, __num_checked_pow_acc_%out_ok, %base
    br __num_checked_pow_mul_ok_%out_ok -> L_NUM_U64_CHECKED_POW_STEP_%out_ok, L_NUM_U64_CHECKED_POW_OVERFLOW_%out_ok

L_NUM_U64_CHECKED_POW_STEP_%out_ok:
    __num_checked_pow_next_idx_%out_ok = add __num_checked_pow_idx_%out_ok, 1
    store __num_checked_pow_acc_slot_%out_ok+0, __num_checked_pow_mul_value_%out_ok as u64
    store __num_checked_pow_idx_slot_%out_ok+0, __num_checked_pow_next_idx_%out_ok as u64
    !__num_checked_pow_next_idx_%out_ok
    !__num_checked_pow_mul_value_%out_ok
    !__num_checked_pow_mul_ok_%out_ok
    !__num_checked_pow_acc_%out_ok
    !__num_checked_pow_done_%out_ok
    !__num_checked_pow_idx_%out_ok
    jmp L_NUM_U64_CHECKED_POW_HEAD_%out_ok

L_NUM_U64_CHECKED_POW_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_checked_pow_mul_value_%out_ok
    !__num_checked_pow_mul_ok_%out_ok
    !__num_checked_pow_acc_%out_ok
    !__num_checked_pow_done_%out_ok
    !__num_checked_pow_idx_%out_ok
    jmp L_NUM_U64_CHECKED_POW_END_%out_ok

L_NUM_U64_CHECKED_POW_DONE_%out_ok:
    %out_value = load __num_checked_pow_acc_slot_%out_ok+0 as u64
    %out_ok = add 0, 1
    !__num_checked_pow_done_%out_ok
    !__num_checked_pow_idx_%out_ok

L_NUM_U64_CHECKED_POW_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_STRICT_POW %out_value, %base, %exp
    EXPAND NUM_U64_CHECKED_POW __num_strict_pow_ok_%out_value, %out_value, %base, %exp
    br __num_strict_pow_ok_%out_value -> L_NUM_U64_STRICT_POW_OK_%out_value, L_NUM_U64_STRICT_POW_PANIC_%out_value

L_NUM_U64_STRICT_POW_PANIC_%out_value:
    panic(2204)

L_NUM_U64_STRICT_POW_OK_%out_value:
    !__num_strict_pow_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_LEADING_ZEROS %out_count, %value
    __num_lz_idx_slot_%out_count = stack_alloc 8
    store __num_lz_idx_slot_%out_count+0, 0 as u64
    jmp L_NUM_U64_LZ_HEAD_%out_count

L_NUM_U64_LZ_HEAD_%out_count:
    __num_lz_idx_%out_count = load __num_lz_idx_slot_%out_count+0 as u64
    __num_lz_done_%out_count = eq __num_lz_idx_%out_count, NUM_U64_BITS
    br __num_lz_done_%out_count -> L_NUM_U64_LZ_ALL_%out_count, L_NUM_U64_LZ_BODY_%out_count

L_NUM_U64_LZ_BODY_%out_count:
    __num_lz_bit_index_%out_count = sub 63, __num_lz_idx_%out_count
    __num_lz_mask_%out_count = shl 1, __num_lz_bit_index_%out_count
    __num_lz_masked_%out_count = and %value, __num_lz_mask_%out_count
    __num_lz_seen_one_%out_count = ne __num_lz_masked_%out_count, 0
    br __num_lz_seen_one_%out_count -> L_NUM_U64_LZ_FOUND_%out_count, L_NUM_U64_LZ_NEXT_%out_count

L_NUM_U64_LZ_NEXT_%out_count:
    __num_lz_next_%out_count = add __num_lz_idx_%out_count, 1
    store __num_lz_idx_slot_%out_count+0, __num_lz_next_%out_count as u64
    !__num_lz_next_%out_count
    !__num_lz_seen_one_%out_count
    !__num_lz_masked_%out_count
    !__num_lz_mask_%out_count
    !__num_lz_bit_index_%out_count
    !__num_lz_done_%out_count
    !__num_lz_idx_%out_count
    jmp L_NUM_U64_LZ_HEAD_%out_count

L_NUM_U64_LZ_FOUND_%out_count:
    %out_count = add __num_lz_idx_%out_count, 0
    !__num_lz_seen_one_%out_count
    !__num_lz_masked_%out_count
    !__num_lz_mask_%out_count
    !__num_lz_bit_index_%out_count
    !__num_lz_done_%out_count
    !__num_lz_idx_%out_count
    jmp L_NUM_U64_LZ_END_%out_count

L_NUM_U64_LZ_ALL_%out_count:
    %out_count = add 0, NUM_U64_BITS
    !__num_lz_done_%out_count
    !__num_lz_idx_%out_count

L_NUM_U64_LZ_END_%out_count:
[END_MACRO]

[MACRO] NUM_U64_TRAILING_ZEROS %out_count, %value
    __num_tz_idx_slot_%out_count = stack_alloc 8
