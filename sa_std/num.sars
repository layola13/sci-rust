[MACRO] SATURATING_I64_DIV %out_ptr, %lhs_ptr, %rhs_ptr
    __sat_i64_div_lhs_%out_ptr = load %lhs_ptr+SaturatingI64_value as i64
    __sat_i64_div_rhs_%out_ptr = load %rhs_ptr+SaturatingI64_value as i64
    __sat_i64_div_lhs_min_%out_ptr = eq __sat_i64_div_lhs_%out_ptr, NUM_I64_MIN
    __sat_i64_div_rhs_neg_one_%out_ptr = eq __sat_i64_div_rhs_%out_ptr, -1
    __sat_i64_div_over_%out_ptr = and __sat_i64_div_lhs_min_%out_ptr, __sat_i64_div_rhs_neg_one_%out_ptr
    br __sat_i64_div_over_%out_ptr -> L_SATURATING_I64_DIV_MAX_%out_ptr, L_SATURATING_I64_DIV_NORMAL_%out_ptr

L_SATURATING_I64_DIV_NORMAL_%out_ptr:
    __sat_i64_div_result_%out_ptr = sdiv __sat_i64_div_lhs_%out_ptr, __sat_i64_div_rhs_%out_ptr
    EXPAND SATURATING_I64_NEW %out_ptr, __sat_i64_div_result_%out_ptr
