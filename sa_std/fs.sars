[MACRO] FS_DIR_BUILDER_NEW %out_recursive, %out_mode
    %out_recursive = add 0, 0
    %out_mode = add 0, 493
[END_MACRO]

[MACRO] FS_DIR_BUILDER_WITH_RECURSIVE %out_recursive, %out_mode, %in_recursive, %in_mode, %flag
    __fs_dir_builder_flag_is_zero_%out_recursive = eq %flag, 0
    br __fs_dir_builder_flag_is_zero_%out_recursive -> L_FS_DIR_BUILDER_ZERO_%out_recursive, L_FS_DIR_BUILDER_NONZERO_%out_recursive
L_FS_DIR_BUILDER_ZERO_%out_recursive:
    %out_recursive = add 0, 0
    %out_mode = add 0, %in_mode
    !__fs_dir_builder_flag_is_zero_%out_recursive
    jmp L_FS_DIR_BUILDER_WITH_RECURSIVE_END_%out_recursive
L_FS_DIR_BUILDER_NONZERO_%out_recursive:
    %out_recursive = add 0, 1
    %out_mode = add 0, %in_mode
    !__fs_dir_builder_flag_is_zero_%out_recursive
    jmp L_FS_DIR_BUILDER_WITH_RECURSIVE_END_%out_recursive
L_FS_DIR_BUILDER_WITH_RECURSIVE_END_%out_recursive:
[END_MACRO]

[MACRO] FS_DIR_BUILDER_WITH_MODE %out_recursive, %out_mode, %in_recursive, %in_mode, %new_mode
