[MACRO] FS_PERMISSIONS_FROM_MODE %out_permissions, %mode
    store %out_permissions+SaFsPermissions_mode, %mode as u32
[END_MACRO]

[MACRO] FS_PERMISSIONS_MODE %out_mode, %permissions
    %out_mode = load %permissions+SaFsPermissions_mode as u32
[END_MACRO]

[MACRO] FS_PERMISSIONS_SET_MODE %permissions, %mode
    store %permissions+SaFsPermissions_mode, %mode as u32
[END_MACRO]

// Concrete Permissions object helpers over the SaFsPermissions mode slot.
// readonly checks/clears the POSIX write bits (0222); set_readonly(false)
// sets owner-write (0200), matching Rust's Unix Permissions::set_readonly.

[MACRO] FS_PERMISSIONS_NEW %out_permissions
    store %out_permissions+SaFsPermissions_mode, 0 as u32
[END_MACRO]

// Rust-style Default alias over FS_PERMISSIONS_NEW.
[MACRO] FS_PERMISSIONS_DEFAULT %out_permissions
    EXPAND FS_PERMISSIONS_NEW %out_permissions
[END_MACRO]

[MACRO] FS_METADATA_PERMISSIONS %out_permissions, %metadata
    __fs_meta_perm_mode_%out_permissions = call @sa_fs_metadata_st_mode(%metadata)
    store %out_permissions+SaFsPermissions_mode, __fs_meta_perm_mode_%out_permissions as u32
    !__fs_meta_perm_mode_%out_permissions
[END_MACRO]

[MACRO] FS_PERMISSIONS_READONLY %out_flag, %permissions
    __fs_perm_mode_%out_flag = load %permissions+SaFsPermissions_mode as u32
    __fs_perm_write_%out_flag = and __fs_perm_mode_%out_flag, SA_FS_PERM_WRITE_BITS
    __fs_perm_is_ro_%out_flag = eq __fs_perm_write_%out_flag, 0
    %out_flag = add 0, __fs_perm_is_ro_%out_flag
    !__fs_perm_is_ro_%out_flag
    !__fs_perm_write_%out_flag
    !__fs_perm_mode_%out_flag
[END_MACRO]

[MACRO] FS_PERMISSIONS_SET_READONLY %permissions, %flag
    __fs_perm_mode_%permissions = load %permissions+SaFsPermissions_mode as u32
    __fs_perm_is_ro_%permissions = ne %flag, 0
    __fs_perm_is_rw_%permissions = eq %flag, 0
    __fs_perm_clear_bits_%permissions = mul SA_FS_PERM_WRITE_BITS, __fs_perm_is_ro_%permissions
    __fs_perm_mask_%permissions = xor __fs_perm_clear_bits_%permissions, 4294967295
    __fs_perm_cleared_%permissions = and __fs_perm_mode_%permissions, __fs_perm_mask_%permissions
    __fs_perm_owner_bits_%permissions = mul SA_FS_PERM_OWNER_WRITE, __fs_perm_is_rw_%permissions
    __fs_perm_new_mode_%permissions = or __fs_perm_cleared_%permissions, __fs_perm_owner_bits_%permissions
    store %permissions+SaFsPermissions_mode, __fs_perm_new_mode_%permissions as u32
    !__fs_perm_new_mode_%permissions
    !__fs_perm_owner_bits_%permissions
    !__fs_perm_cleared_%permissions
    !__fs_perm_mask_%permissions
    !__fs_perm_clear_bits_%permissions
    !__fs_perm_is_rw_%permissions
    !__fs_perm_is_ro_%permissions
    !__fs_perm_mode_%permissions
[END_MACRO]

[MACRO] FS_SET_PERMISSIONS_OBJ %out_status, %path, %path_len, %permissions
    __fs_set_perm_mode_%out_status = load %permissions+SaFsPermissions_mode as u32
    %out_status = call @sa_fs_set_permissions(&%path, %path_len, __fs_set_perm_mode_%out_status)
    !__fs_set_perm_mode_%out_status
[END_MACRO]

