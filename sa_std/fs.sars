[MACRO] FS_DIR_BUILDER_CREATE %out_status, %recursive, %mode, %path, %path_len
    __fs_dir_builder_is_nonrecursive_%out_status = eq %recursive, 0
    br __fs_dir_builder_is_nonrecursive_%out_status -> L_FS_DIR_BUILDER_NONRECURSIVE_%out_status, L_FS_DIR_BUILDER_RECURSIVE_%out_status
L_FS_DIR_BUILDER_NONRECURSIVE_%out_status:
    EXPAND FS_CREATE_DIR_MODE %out_status, %path, %path_len, %mode
