// Concrete FileTimes builder over two propagating SSA millisecond timestamps.
// Applies through the existing FS_SET_TIMES_MS / sa_fs_set_times_ms FFI.

[MACRO] FS_FILE_TIMES_NEW %out_accessed_ms, %out_modified_ms
    %out_accessed_ms = add 0, 0
    %out_modified_ms = add 0, 0
[END_MACRO]

// Rust-style Default alias over FS_FILE_TIMES_NEW (0,0 timestamps).
[MACRO] FS_FILE_TIMES_DEFAULT %out_accessed_ms, %out_modified_ms
    EXPAND FS_FILE_TIMES_NEW %out_accessed_ms, %out_modified_ms
[END_MACRO]

[MACRO] FS_FILE_TIMES_WITH_ACCESSED %out_accessed_ms, %out_modified_ms, %in_accessed_ms, %in_modified_ms, %accessed_ms
    %out_accessed_ms = add 0, %accessed_ms
    %out_modified_ms = add 0, %in_modified_ms
[END_MACRO]

[MACRO] FS_FILE_TIMES_WITH_MODIFIED %out_accessed_ms, %out_modified_ms, %in_accessed_ms, %in_modified_ms, %modified_ms
    %out_accessed_ms = add 0, %in_accessed_ms
    %out_modified_ms = add 0, %modified_ms
[END_MACRO]

[MACRO] FS_FILE_TIMES_SET %out_status, %path, %path_len, %accessed_ms, %modified_ms
    EXPAND FS_SET_TIMES_MS %out_status, %path, %path_len, %accessed_ms, %modified_ms
[END_MACRO]

[MACRO] FS_METADATA_FILE_TIMES %out_accessed_ms, %out_modified_ms, %metadata
    %out_accessed_ms = call @sa_fs_metadata_accessed_ms(%metadata)
    %out_modified_ms = call @sa_fs_metadata_modified_ms(%metadata)
[END_MACRO]
