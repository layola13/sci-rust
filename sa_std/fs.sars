[MACRO] FS_OPEN_OPTIONS_BUILDER_WITH_NOFOLLOW %out_flags, %out_mode, %out_custom, %in_flags, %in_mode, %in_custom, %flag
    __fs_oob_nofollow_zero_%out_flags = eq %flag, 0
    br __fs_oob_nofollow_zero_%out_flags -> L_FS_OOB_NOFOLLOW_KEEP_%out_flags, L_FS_OOB_NOFOLLOW_OR_%out_flags
L_FS_OOB_NOFOLLOW_KEEP_%out_flags:
    %out_flags = add 0, %in_flags
    %out_mode = add 0, %in_mode
    %out_custom = add 0, %in_custom
    !__fs_oob_nofollow_zero_%out_flags
    jmp L_FS_OOB_NOFOLLOW_END_%out_flags
L_FS_OOB_NOFOLLOW_OR_%out_flags:
    %out_flags = add 0, %in_flags
    %out_mode = add 0, %in_mode
    %out_custom = or %in_custom, SA_FS_CUSTOM_NOFOLLOW
    !__fs_oob_nofollow_zero_%out_flags
    jmp L_FS_OOB_NOFOLLOW_END_%out_flags
L_FS_OOB_NOFOLLOW_END_%out_flags:
[END_MACRO]

