    jmp L_FS_DIR_BUILDER_END_%out_status
L_FS_DIR_BUILDER_RECURSIVE_%out_status:
    EXPAND FS_CREATE_DIR_ALL_MODE %out_status, %path, %path_len, %mode
    !__fs_dir_builder_is_nonrecursive_%out_status
