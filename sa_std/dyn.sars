// sci-rust P1.1a: dyn trait-object macros (Rust edition).
//
// A `dyn` fat pointer is 16 bytes: [data_ptr:8][vtable_ptr:8].
// These macros lower trait-object construction and dispatch to the existing
// vtable + call_indirect machinery with zero compiler changes.
//
// Object-safety contract (enforced by the verifier since P1.1a):
// every vtable slot method must take its receiver by borrow (`&self: ptr`).

#def Dyn_SIZE = 16
#def Dyn_DATA = +0
#def Dyn_VTABLE = +8

[MACRO] DYN_NEW %out_dyn, %data_ptr, %vtable_const
    %out_dyn = alloc Dyn_SIZE
    store %out_dyn+Dyn_DATA, %data_ptr as ptr
    store %out_dyn+Dyn_VTABLE, %vtable_const as ptr
[END_MACRO]

[MACRO] DYN_DATA %out_data, %dyn
    %out_data = load %dyn+Dyn_DATA as ptr
[END_MACRO]

[MACRO] DYN_VTABLE %out_vtable, %dyn
    %out_vtable = load %dyn+Dyn_VTABLE as ptr
[END_MACRO]

[MACRO] DYN_FREE %dyn
    __dyn_data_%dyn = load %dyn+Dyn_DATA as ptr
    __dyn_vtable_%dyn = load %dyn+Dyn_VTABLE as ptr
    !__dyn_data_%dyn
    !__dyn_vtable_%dyn
    !%dyn
[END_MACRO]

// sci-rust P1.1b-light: trait declaration/impl sugar.
//
// A trait is a named method set; an impl binds concrete @functions into a
// `@const VT = vtable { ... }`. The verifier enforces object-safety
// (receiver by borrow) at vtable-collection time, so these macros are pure
// documentation + layout sugar with zero compiler changes.
//
// Usage:
//   #trait Draw { draw }              -> documents method set { draw }
//   @button_draw(&self: ptr) -> i32:  -> concrete method (borrow receiver)
//   #impl Draw for Button { draw = @button_draw }
//     -> expands to: @const Button_Draw_VT = vtable { draw = @button_draw }
//
// NOTE: #trait/#impl are comments for now (parsed as #def-compatible docs);
// the normative artifact remains the @const vtable below them. A future
// heavy slice may promote them to first-class LineKind with registry checks.

// #trait Draw { draw }: method set = { draw }; receiver must be &self: ptr.
// #impl Draw for Button: Button_Draw_VT = vtable { draw = @button_draw }

[MACRO] TRAIT_DISPATCH %out_result, %dyn, %vtable_slot_offset, %call_args
    __trait_vtable_%out_result = load %dyn+Dyn_VTABLE as ptr
    __trait_data_%out_result = load %dyn+Dyn_DATA as ptr
    __trait_fn_%out_result = load __trait_vtable_%out_result+%vtable_slot_offset as ptr
    %out_result = call_indirect __trait_fn_%out_result(%call_args)
    !__trait_fn_%out_result
    !__trait_vtable_%out_result
    !__trait_data_%out_result
[END_MACRO]
