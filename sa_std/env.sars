@import "core/slice.sal"
@import "env.sai"

[MACRO] ENV_GET %out_buf, %key_slice
    __env_get_key_ptr_%out_buf = load %key_slice+Slice_ptr as ptr
    __env_get_key_len_%out_buf = load %key_slice+Slice_len as u64
    EXPAND ENV_GET_PTR %out_buf, __env_get_key_ptr_%out_buf, __env_get_key_len_%out_buf
    !__env_get_key_len_%out_buf
    !__env_get_key_ptr_%out_buf
[END_MACRO]

[MACRO] ENV_GET_PTR %out_buf, %key_ptr, %key_len
    %out_buf = call @sa_env_get(%key_ptr, %key_len)
[END_MACRO]

[MACRO] ENV_CURRENT_DIR %out_buf
    %out_buf = call @sa_env_current_dir()
[END_MACRO]

[MACRO] ENV_SET_CURRENT_DIR %out_status, %path_slice
    __env_set_cwd_ptr_%out_status = load %path_slice+Slice_ptr as ptr
    __env_set_cwd_len_%out_status = load %path_slice+Slice_len as u64
    %out_status = call @sa_env_set_current_dir(__env_set_cwd_ptr_%out_status, __env_set_cwd_len_%out_status)
    !__env_set_cwd_len_%out_status
    !__env_set_cwd_ptr_%out_status
[END_MACRO]

[MACRO] ENV_TEMP_DIR %out_buf
    %out_buf = call @sa_env_temp_dir()
[END_MACRO]

[MACRO] ENV_CURRENT_EXE %out_buf
    %out_buf = call @sa_env_current_exe()
[END_MACRO]

[MACRO] ENV_TRY_HOME_DIR %out_ok, %out_buf
    %out_buf = call @sa_env_home_dir()
    %out_ok = ne %out_buf, 0
[END_MACRO]

[MACRO] ENV_ARGS_JSON %out_buf
    %out_buf = call @sa_env_args_json()
[END_MACRO]

[MACRO] ENV_VARS_JSON %out_buf
    %out_buf = call @sa_env_vars_json()
[END_MACRO]

[MACRO] ENV_SPLIT_PATHS_JSON %out_buf, %path_list_slice
    __env_split_paths_ptr_%out_buf = load %path_list_slice+Slice_ptr as ptr
    __env_split_paths_len_%out_buf = load %path_list_slice+Slice_len as u64
    EXPAND ENV_SPLIT_PATHS_JSON_PTR %out_buf, __env_split_paths_ptr_%out_buf, __env_split_paths_len_%out_buf
    !__env_split_paths_len_%out_buf
    !__env_split_paths_ptr_%out_buf
[END_MACRO]

[MACRO] ENV_SPLIT_PATHS_JSON_PTR %out_buf, %path_list_ptr, %path_list_len
    %out_buf = call @sa_env_split_paths_json(%path_list_ptr, %path_list_len)
[END_MACRO]

[MACRO] ENV_JOIN_PATHS_JSON %out_buf, %paths_json_slice
    __env_join_paths_ptr_%out_buf = load %paths_json_slice+Slice_ptr as ptr
    __env_join_paths_len_%out_buf = load %paths_json_slice+Slice_len as u64
    EXPAND ENV_JOIN_PATHS_JSON_PTR %out_buf, __env_join_paths_ptr_%out_buf, __env_join_paths_len_%out_buf
    !__env_join_paths_len_%out_buf
    !__env_join_paths_ptr_%out_buf
[END_MACRO]

[MACRO] ENV_JOIN_PATHS_JSON_PTR %out_buf, %paths_json_ptr, %paths_json_len
    %out_buf = call @sa_env_join_paths_json(%paths_json_ptr, %paths_json_len)
[END_MACRO]

[MACRO] ENV_XDG_DATA_HOME_DIR %out_buf
    %out_buf = call @sa_env_xdg_data_home_dir()
[END_MACRO]

[MACRO] ENV_XDG_CONFIG_HOME_DIR %out_buf
    %out_buf = call @sa_env_xdg_config_home_dir()
[END_MACRO]

[MACRO] ENV_XDG_STATE_HOME_DIR %out_buf
    %out_buf = call @sa_env_xdg_state_home_dir()
[END_MACRO]

[MACRO] ENV_XDG_CACHE_HOME_DIR %out_buf
    %out_buf = call @sa_env_xdg_cache_home_dir()
[END_MACRO]

[MACRO] ENV_XDG_DATA_DIRS %out_buf
    %out_buf = call @sa_env_xdg_data_dirs()
[END_MACRO]

[MACRO] ENV_XDG_CONFIG_DIRS %out_buf
    %out_buf = call @sa_env_xdg_config_dirs()
[END_MACRO]

[MACRO] ENV_TRY_GET %out_ok, %out_buf, %key_slice
    __env_try_get_key_ptr_%out_ok = load %key_slice+Slice_ptr as ptr
    __env_try_get_key_len_%out_ok = load %key_slice+Slice_len as u64
    EXPAND ENV_TRY_GET_PTR %out_ok, %out_buf, __env_try_get_key_ptr_%out_ok, __env_try_get_key_len_%out_ok
    !__env_try_get_key_len_%out_ok
    !__env_try_get_key_ptr_%out_ok
[END_MACRO]

[MACRO] ENV_TRY_GET_PTR %out_ok, %out_buf, %key_ptr, %key_len
    __env_try_get_status_%out_ok = call @sa_env_has(%key_ptr, %key_len)
    __env_try_get_exists_%out_ok = eq __env_try_get_status_%out_ok, 0
    br __env_try_get_exists_%out_ok -> L_ENV_TRY_GET_HIT_%out_ok, L_ENV_TRY_GET_MISS_%out_ok

L_ENV_TRY_GET_HIT_%out_ok:
    %out_buf = call @sa_env_get(%key_ptr, %key_len)
    %out_ok = add 0, 1
    !__env_try_get_exists_%out_ok
    !__env_try_get_status_%out_ok
    jmp L_ENV_TRY_GET_END_%out_ok

L_ENV_TRY_GET_MISS_%out_ok:
    %out_buf = add 0, 0
    %out_ok = add 0, 0
    !__env_try_get_exists_%out_ok
    !__env_try_get_status_%out_ok

L_ENV_TRY_GET_END_%out_ok:
[END_MACRO]

[MACRO] ENV_HAS %out_flag, %key_slice
    __env_has_key_ptr_%out_flag = load %key_slice+Slice_ptr as ptr
    __env_has_key_len_%out_flag = load %key_slice+Slice_len as u64
    EXPAND ENV_HAS_PTR %out_flag, __env_has_key_ptr_%out_flag, __env_has_key_len_%out_flag
    !__env_has_key_len_%out_flag
    !__env_has_key_ptr_%out_flag
[END_MACRO]

[MACRO] ENV_HAS_PTR %out_status, %key_ptr, %key_len
    %out_status = call @sa_env_has(%key_ptr, %key_len)
[END_MACRO]

[MACRO] ENV_SET_VAR %out_status, %key_slice, %value_slice
    __env_set_key_ptr_%out_status = load %key_slice+Slice_ptr as ptr
    __env_set_key_len_%out_status = load %key_slice+Slice_len as u64
    __env_set_value_ptr_%out_status = load %value_slice+Slice_ptr as ptr
    __env_set_value_len_%out_status = load %value_slice+Slice_len as u64
    EXPAND ENV_SET_VAR_PTR %out_status, __env_set_key_ptr_%out_status, __env_set_key_len_%out_status, __env_set_value_ptr_%out_status, __env_set_value_len_%out_status
    !__env_set_value_len_%out_status
    !__env_set_value_ptr_%out_status
    !__env_set_key_len_%out_status
    !__env_set_key_ptr_%out_status
[END_MACRO]

[MACRO] ENV_SET_VAR_PTR %out_status, %key_ptr, %key_len, %value_ptr, %value_len
    %out_status = call @sa_env_set_var(%key_ptr, %key_len, %value_ptr, %value_len)
[END_MACRO]

[MACRO] ENV_REMOVE_VAR %out_status, %key_slice
    __env_remove_key_ptr_%out_status = load %key_slice+Slice_ptr as ptr
    __env_remove_key_len_%out_status = load %key_slice+Slice_len as u64
    EXPAND ENV_REMOVE_VAR_PTR %out_status, __env_remove_key_ptr_%out_status, __env_remove_key_len_%out_status
    !__env_remove_key_len_%out_status
    !__env_remove_key_ptr_%out_status
[END_MACRO]

[MACRO] ENV_REMOVE_VAR_PTR %out_status, %key_ptr, %key_len
    %out_status = call @sa_env_remove_var(%key_ptr, %key_len)
[END_MACRO]

[MACRO] ENV_STATUS_IS_OK %out_bool, %status
    %out_bool = eq %status, 0
[END_MACRO]

[MACRO] ENV_EXISTS %out_bool, %key_slice
    __env_exists_key_ptr_%out_bool = load %key_slice+Slice_ptr as ptr
    __env_exists_key_len_%out_bool = load %key_slice+Slice_len as u64
    EXPAND ENV_EXISTS_PTR %out_bool, __env_exists_key_ptr_%out_bool, __env_exists_key_len_%out_bool
    !__env_exists_key_len_%out_bool
    !__env_exists_key_ptr_%out_bool
[END_MACRO]

[MACRO] ENV_EXISTS_PTR %out_bool, %key_ptr, %key_len
    __env_exists_status_%out_bool = call @sa_env_has(%key_ptr, %key_len)
    %out_bool = eq __env_exists_status_%out_bool, 0
    !__env_exists_status_%out_bool
[END_MACRO]

[MACRO] ENV_BUFFER_DATA %out_ptr, %buffer
    %out_ptr = call @sa_env_buffer_data(%buffer)
[END_MACRO]

[MACRO] ENV_BUFFER_LEN %out_len, %buffer
    %out_len = call @sa_env_buffer_len(%buffer)
[END_MACRO]

[MACRO] ENV_BUFFER_AS_SLICE %out_slice, %buffer
    __env_slice_ptr_%out_slice = call @sa_env_buffer_data(%buffer)
    __env_slice_len_%out_slice = call @sa_env_buffer_len(%buffer)
    store %out_slice+Slice_ptr, __env_slice_ptr_%out_slice as ptr
    store %out_slice+Slice_len, __env_slice_len_%out_slice as u64
    !__env_slice_len_%out_slice
    !__env_slice_ptr_%out_slice
[END_MACRO]

[MACRO] ENV_GET_PARTS %out_buffer, %out_ptr, %out_len, %key_slice
    __env_parts_key_ptr_%out_buffer = load %key_slice+Slice_ptr as ptr
    __env_parts_key_len_%out_buffer = load %key_slice+Slice_len as u64
    EXPAND ENV_GET_PARTS_PTR %out_buffer, %out_ptr, %out_len, __env_parts_key_ptr_%out_buffer, __env_parts_key_len_%out_buffer
    !__env_parts_key_len_%out_buffer
    !__env_parts_key_ptr_%out_buffer
[END_MACRO]

[MACRO] ENV_GET_PARTS_PTR %out_buffer, %out_ptr, %out_len, %key_ptr, %key_len
    EXPAND ENV_GET_PTR %out_buffer, %key_ptr, %key_len
    %out_ptr = call @sa_env_buffer_data(%out_buffer)
    %out_len = call @sa_env_buffer_len(%out_buffer)
[END_MACRO]

[MACRO] ENV_GET_SLICE %out_buffer, %out_slice, %key_slice
    __env_get_slice_key_ptr_%out_buffer = load %key_slice+Slice_ptr as ptr
    __env_get_slice_key_len_%out_buffer = load %key_slice+Slice_len as u64
    EXPAND ENV_GET_SLICE_PTR %out_buffer, %out_slice, __env_get_slice_key_ptr_%out_buffer, __env_get_slice_key_len_%out_buffer
    !__env_get_slice_key_len_%out_buffer
    !__env_get_slice_key_ptr_%out_buffer
[END_MACRO]

[MACRO] ENV_GET_SLICE_PTR %out_buffer, %out_slice, %key_ptr, %key_len
    EXPAND ENV_GET_PTR %out_buffer, %key_ptr, %key_len
    EXPAND ENV_BUFFER_AS_SLICE %out_slice, %out_buffer
[END_MACRO]

[MACRO] ENV_TRY_GET_SLICE %out_ok, %out_buffer, %out_slice, %key_slice
    __env_try_slice_key_ptr_%out_ok = load %key_slice+Slice_ptr as ptr
    __env_try_slice_key_len_%out_ok = load %key_slice+Slice_len as u64
    EXPAND ENV_TRY_GET_SLICE_PTR %out_ok, %out_buffer, %out_slice, __env_try_slice_key_ptr_%out_ok, __env_try_slice_key_len_%out_ok
    !__env_try_slice_key_len_%out_ok
    !__env_try_slice_key_ptr_%out_ok
[END_MACRO]

[MACRO] ENV_TRY_GET_SLICE_PTR %out_ok, %out_buffer, %out_slice, %key_ptr, %key_len
    __env_try_slice_status_%out_ok = call @sa_env_has(%key_ptr, %key_len)
    __env_try_slice_exists_%out_ok = eq __env_try_slice_status_%out_ok, 0
    br __env_try_slice_exists_%out_ok -> L_ENV_TRY_GET_SLICE_HIT_%out_ok, L_ENV_TRY_GET_SLICE_MISS_%out_ok

L_ENV_TRY_GET_SLICE_HIT_%out_ok:
    %out_buffer = call @sa_env_get(%key_ptr, %key_len)
    EXPAND ENV_BUFFER_AS_SLICE %out_slice, %out_buffer
    %out_ok = add 0, 1
    !__env_try_slice_exists_%out_ok
    !__env_try_slice_status_%out_ok
    jmp L_ENV_TRY_GET_SLICE_END_%out_ok

L_ENV_TRY_GET_SLICE_MISS_%out_ok:
    %out_buffer = add 0, 0
    store %out_slice+Slice_ptr, 0 as ptr
    store %out_slice+Slice_len, 0 as u64
    %out_ok = add 0, 0
    !__env_try_slice_exists_%out_ok
    !__env_try_slice_status_%out_ok

L_ENV_TRY_GET_SLICE_END_%out_ok:
[END_MACRO]

[MACRO] ENV_BUFFER_FREE %out_ok, %buffer
    %out_ok = call @sa_env_buffer_free(^%buffer)
[END_MACRO]

// Rust-named aliases over the existing current-process env facade.

[MACRO] ENV_VAR %out_buf, %key_slice
    EXPAND ENV_GET %out_buf, %key_slice
[END_MACRO]

[MACRO] ENV_VAR_OS %out_ok, %out_buf, %key_slice
    EXPAND ENV_TRY_GET %out_ok, %out_buf, %key_slice
[END_MACRO]

[MACRO] ENV_ARGS %out_buf
    EXPAND ENV_ARGS_JSON %out_buf
[END_MACRO]

[MACRO] ENV_VARS %out_buf
    EXPAND ENV_VARS_JSON %out_buf
[END_MACRO]

// Rust/std naming aliases for current working directory and home queries.
[MACRO] ENV_CWD_GET %out_buf
    EXPAND ENV_CURRENT_DIR %out_buf
[END_MACRO]

[MACRO] ENV_CWD_SET %out_status, %path_slice
    EXPAND ENV_SET_CURRENT_DIR %out_status, %path_slice
[END_MACRO]

[MACRO] ENV_HOME %out_buf
    EXPAND ENV_TRY_HOME_DIR __env_home_ok_%out_buf, %out_buf
    !__env_home_ok_%out_buf
[END_MACRO]

[MACRO] ENV_RUST_ARGS %out_buf
    EXPAND ENV_ARGS %out_buf
[END_MACRO]

[MACRO] ENV_RUST_VARS %out_buf
    EXPAND ENV_VARS %out_buf
[END_MACRO]
[MACRO] ENV_SPLIT_PATHS %out_buf, %path_list_slice
    EXPAND ENV_SPLIT_PATHS_JSON %out_buf, %path_list_slice
[END_MACRO]

[MACRO] ENV_JOIN_PATHS %out_buf, %paths_json_slice
    EXPAND ENV_JOIN_PATHS_JSON %out_buf, %paths_json_slice
[END_MACRO]

[MACRO] ENV_HOME_DIR %out_ok, %out_buf
    EXPAND ENV_TRY_HOME_DIR %out_ok, %out_buf
[END_MACRO]

// Rust-named Os-style aliases over the existing JSON/buffer process env facade.
// These intentionally return the same owned env buffers as ENV_ARGS/ENV_VARS rather
// than true OsString iterators.

[MACRO] ENV_ARGS_OS %out_buf
    EXPAND ENV_ARGS_JSON %out_buf
[END_MACRO]

[MACRO] ENV_VARS_OS %out_buf
    EXPAND ENV_VARS_JSON %out_buf
[END_MACRO]

[MACRO] ENV_SPLIT_PATHS_OS %out_buf, %path_list_slice
    EXPAND ENV_SPLIT_PATHS_JSON %out_buf, %path_list_slice
[END_MACRO]

[MACRO] ENV_JOIN_PATHS_OS %out_buf, %paths_json_slice
    EXPAND ENV_JOIN_PATHS_JSON %out_buf, %paths_json_slice
[END_MACRO]


// Extra rust-named aliases for common env path queries.

[MACRO] ENV_TEMP_DIR_OS %out_buf
    EXPAND ENV_TEMP_DIR %out_buf
[END_MACRO]

[MACRO] ENV_CURRENT_EXE_OS %out_buf
    EXPAND ENV_CURRENT_EXE %out_buf
[END_MACRO]

[MACRO] ENV_CURRENT_DIR_OS %out_buf
    EXPAND ENV_CURRENT_DIR %out_buf
[END_MACRO]

[MACRO] ENV_SET_CURRENT_DIR_OS %out_status, %path_slice
    EXPAND ENV_SET_CURRENT_DIR %out_status, %path_slice
[END_MACRO]

[MACRO] ENV_SET_VAR_OS %out_status, %key_slice, %value_slice
    EXPAND ENV_SET_VAR %out_status, %key_slice, %value_slice
[END_MACRO]

[MACRO] ENV_REMOVE_VAR_OS %out_status, %key_slice
    EXPAND ENV_REMOVE_VAR %out_status, %key_slice
[END_MACRO]

[MACRO] ENV_HOME_DIR_OS %out_ok, %out_buf
    EXPAND ENV_HOME_DIR %out_ok, %out_buf
[END_MACRO]

// Os-style aliases over existing XDG directory/buffer helpers.

[MACRO] ENV_XDG_DATA_HOME_DIR_OS %out_buf
    EXPAND ENV_XDG_DATA_HOME_DIR %out_buf
[END_MACRO]

[MACRO] ENV_XDG_CONFIG_HOME_DIR_OS %out_buf
    EXPAND ENV_XDG_CONFIG_HOME_DIR %out_buf
[END_MACRO]

[MACRO] ENV_XDG_STATE_HOME_DIR_OS %out_buf
    EXPAND ENV_XDG_STATE_HOME_DIR %out_buf
[END_MACRO]

[MACRO] ENV_XDG_CACHE_HOME_DIR_OS %out_buf
    EXPAND ENV_XDG_CACHE_HOME_DIR %out_buf
[END_MACRO]

[MACRO] ENV_XDG_DATA_DIRS_OS %out_buf
    EXPAND ENV_XDG_DATA_DIRS %out_buf
[END_MACRO]

[MACRO] ENV_XDG_CONFIG_DIRS_OS %out_buf
    EXPAND ENV_XDG_CONFIG_DIRS %out_buf
[END_MACRO]
