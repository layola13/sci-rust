// Concrete mutex/spinlock macros built on atomic xchg and release unlock.
@import "mutex.sal"
@import "../time.sars"
@import "../time.sai"

@__mutex_lock_spin(lock: ptr) -> void:
L_MUTEX_LOCK_INIT:
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64

L_MUTEX_LOCK_TRY:
    prev = atomic_rmw_xchg lock+Mutex_lock, 1 as u64 acq_rel
    free = eq prev, 0
    br free -> L_MUTEX_LOCK_DONE, L_MUTEX_LOCK_WAIT

L_MUTEX_LOCK_WAIT:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    backoff_at_limit = uge backoff_ns, 1024
    br backoff_at_limit -> L_MUTEX_LOCK_KEEP_BACKOFF, L_MUTEX_LOCK_GROW_BACKOFF

L_MUTEX_LOCK_GROW_BACKOFF:
    next_backoff = shl backoff_ns, 1
    store backoff_slot+0, next_backoff as u64
    !next_backoff
    !backoff_at_limit
    !backoff_ns
    !free
    !prev
    jmp L_MUTEX_LOCK_TRY

L_MUTEX_LOCK_KEEP_BACKOFF:
    !backoff_at_limit
    !backoff_ns
    !free
    !prev
    jmp L_MUTEX_LOCK_TRY

L_MUTEX_LOCK_DONE:
    !free
    !prev
    return

[MACRO] MUTEX_NEW %out_mutex
    %out_mutex = alloc Mutex_SIZE
    store %out_mutex+Mutex_lock, 0 as u64
[END_MACRO]

[MACRO] MUTEX_NEW_I32 %out_mutex, %value
    %out_mutex = alloc 16
    store %out_mutex+Mutex_lock, 0 as u64
    store %out_mutex+Mutex_data, %value as i32
[END_MACRO]

[MACRO] MUTEX_LOCK %lock_ptr
    call @__mutex_lock_spin(%lock_ptr)
[END_MACRO]

[MACRO] MUTEX_TRY_LOCK %out_ok, %lock_ptr
    __mutex_try_prev_%out_ok = atomic_rmw_xchg %lock_ptr+Mutex_lock, 1 as u64 acq_rel
    %out_ok = eq __mutex_try_prev_%out_ok, 0
    !__mutex_try_prev_%out_ok
[END_MACRO]

[MACRO] MUTEX_IS_LOCKED %out_bool, %lock_ptr
    __mutex_state_%out_bool = atomic_load %lock_ptr+Mutex_lock as u64 acquire
    %out_bool = ne __mutex_state_%out_bool, 0
    !__mutex_state_%out_bool
[END_MACRO]

[MACRO] MUTEX_UNLOCK %lock_ptr
    atomic_store %lock_ptr+Mutex_lock, 0 as u64 release
[END_MACRO]

[MACRO] MUTEX_TRY_UNLOCK %out_ok, %lock_ptr
    __mutex_unlock_state_%out_ok, %out_ok = cmpxchg %lock_ptr+Mutex_lock, 1, 0 as u64 acq_rel acquire
    !__mutex_unlock_state_%out_ok
[END_MACRO]

[MACRO] MUTEX_FORCE_UNLOCKED %lock_ptr
    atomic_store %lock_ptr+Mutex_lock, 0 as u64 release
[END_MACRO]

[MACRO] MUTEX_FREE %lock_ptr
    !%lock_ptr
[END_MACRO]

[MACRO] MUTEX_DEFAULT %out_mutex
    EXPAND MUTEX_NEW %out_mutex
[END_MACRO]

// Rust-style into_inner for MUTEX_NEW_I32 layout: returns stored i32 and releases lock word.
[MACRO] MUTEX_INTO_INNER_I32 %out_value, %mutex_reg
    %out_value = load %mutex_reg+Mutex_data as i32
    atomic_store %mutex_reg+Mutex_lock, 0 as u64 release
[END_MACRO]

// Guard layout helper: store mutex ptr in guard for unlock symmetry.
[MACRO] MUTEX_GUARD_NEW %out_guard, %mutex_reg
    %out_guard = alloc MutexGuard_SIZE
    store %out_guard+MutexGuard_mutex, %mutex_reg as ptr
[END_MACRO]

[MACRO] MUTEX_GUARD_UNLOCK %guard_reg
    __mutex_guard_ptr_%guard_reg = load %guard_reg+MutexGuard_mutex as ptr
    EXPAND MUTEX_UNLOCK __mutex_guard_ptr_%guard_reg
    !__mutex_guard_ptr_%guard_reg
[END_MACRO]


[MACRO] MUTEX_GET_MUT_I32 %out_ptr, %mutex_reg
    %out_ptr = ptr_add %mutex_reg, Mutex_data
[END_MACRO]

@__mutex_try_lock_timeout_ns(lock: ptr, timeout_ns: u64) -> i32:
L_ENTRY:
    start = call @sa_time_instant_ns()
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64
    jmp L_MT_TRY
L_MT_TRY:
    prev = atomic_rmw_xchg lock+Mutex_lock, 1 as u64 acq_rel
    free = eq prev, 0
    !prev
    br free -> L_MT_OK, L_MT_CHECK
L_MT_OK:
    !lock
    !free
    !start
    !timeout_ns
    return 1
L_MT_CHECK:
    !free
    now = call @sa_time_instant_ns()
    elapsed = sub now, start
    timed_out = uge elapsed, timeout_ns
    !now
    !elapsed
    br timed_out -> L_MT_TIMEOUT, L_MT_BACKOFF
L_MT_BACKOFF:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    at_limit = uge backoff_ns, 1024
    br at_limit -> L_MT_KEEP, L_MT_GROW
L_MT_GROW:
    next = shl backoff_ns, 1
    store backoff_slot+0, next as u64
    !next
    !at_limit
    !backoff_ns
    !timed_out
    jmp L_MT_TRY
L_MT_KEEP:
    !at_limit
    !backoff_ns
    !timed_out
    jmp L_MT_TRY
L_MT_TIMEOUT:
    !lock
    !timed_out
    !start
    !timeout_ns
    return 0

[MACRO] MUTEX_TRY_LOCK_TIMEOUT_NS %out_ok, %lock_ptr, %timeout_ns
    %out_ok = call @__mutex_try_lock_timeout_ns(%lock_ptr, %timeout_ns)
[END_MACRO]

[MACRO] MUTEX_TRY_LOCK_TIMEOUT_MS %out_ok, %lock_ptr, %timeout_ms
    EXPAND TIME_CHECKED_MUL_NS __mutex_timeout_ms_ok_%out_ok, __mutex_timeout_ns_%out_ok, %timeout_ms, Time_NS_PER_MS
    br __mutex_timeout_ms_ok_%out_ok -> L_MUTEX_TIMEOUT_MS_OK_%out_ok, L_MUTEX_TIMEOUT_MS_FAIL_%out_ok
L_MUTEX_TIMEOUT_MS_OK_%out_ok:
    EXPAND MUTEX_TRY_LOCK_TIMEOUT_NS %out_ok, %lock_ptr, __mutex_timeout_ns_%out_ok
    !__mutex_timeout_ms_ok_%out_ok
    !__mutex_timeout_ns_%out_ok
    jmp L_MUTEX_TIMEOUT_MS_DONE_%out_ok
L_MUTEX_TIMEOUT_MS_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__mutex_timeout_ms_ok_%out_ok
    !__mutex_timeout_ns_%out_ok
L_MUTEX_TIMEOUT_MS_DONE_%out_ok:
[END_MACRO]
