// Unbounded channel backed by LinkedList + Mutex (single-producer multi not optimized).
// Models supportable unbounded mpsc semantics without growable ring complexity.
@import "mpsc_list.sal"
@import "mutex.sars"
@import "../collections/linked_list.sars"
@import "mpsc.sal"
@import "../time.sai"

@sa_mpsc_list_new() -> ^ptr:
L_ENTRY:
    chan = alloc MpscList_SIZE
    EXPAND MUTEX_NEW mtx
    EXPAND LINKED_LIST_NEW list
    store chan+MpscList_mutex, mtx as ptr
    store chan+MpscList_list, list as ptr
    return chan

@sa_mpsc_list_send(&chan: ptr, value: u64) -> void:
L_ENTRY:
    mtx = load chan+MpscList_mutex as ptr
    list = load chan+MpscList_list as ptr
    null_ptr = 0 as ptr
    disconnected = eq mtx, null_ptr
    br disconnected -> L_SEND_DISCONNECTED, L_SEND_LOCK
L_SEND_LOCK:
    EXPAND MUTEX_LOCK mtx
    EXPAND LINKED_LIST_PUSH_BACK list, value
    EXPAND MUTEX_UNLOCK mtx
    !disconnected
    !null_ptr
    !list
    !mtx
    !value
    return
L_SEND_DISCONNECTED:
    !disconnected
    !null_ptr
    !list
    !mtx
    !value
    return

@sa_mpsc_list_try_recv(&chan: ptr, &out_value: ptr) -> i32:
L_ENTRY:
    mtx = load chan+MpscList_mutex as ptr
    list = load chan+MpscList_list as ptr
    null_ptr = 0 as ptr
    disconnected = eq mtx, null_ptr
    br disconnected -> L_RECV_DISCONNECTED, L_RECV_LOCK
L_RECV_LOCK:
    EXPAND MUTEX_LOCK mtx
    ok = call @sa_linked_list_try_pop_front(&list, &out_value)
    EXPAND MUTEX_UNLOCK mtx
    !disconnected
    !null_ptr
    !list
    !mtx
    !chan
    !out_value
    return ok
L_RECV_DISCONNECTED:
    store out_value+0, 0 as u64
    !disconnected
    !null_ptr
    !list
    !mtx
    !chan
    !out_value
    return 0

@sa_mpsc_list_free(&chan: ptr) -> void:
L_ENTRY:
    list = load chan+MpscList_list as ptr
    mtx = load chan+MpscList_mutex as ptr
    null_ptr = 0 as ptr
    closed = eq mtx, null_ptr
    br closed -> L_FREE_ALREADY, L_FREE_CLOSE
L_FREE_ALREADY:
    !mtx
    !closed
    !null_ptr
    jmp L_FREE_DONE
L_FREE_CLOSE:
    EXPAND LINKED_LIST_FREE list
    EXPAND MUTEX_FREE mtx
    store chan+MpscList_list, null_ptr as ptr
    store chan+MpscList_mutex, null_ptr as ptr
    !closed
    !null_ptr
    jmp L_FREE_DONE
L_FREE_DONE:
    !chan
    return
@sa_mpsc_list_try_recv_timeout(&chan: ptr, &out_value: ptr, timeout_ns: u64) -> i32:
L_ENTRY:
    start = call @sa_time_instant_ns()
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64
L_TRY:
    ok = call @sa_mpsc_list_try_recv(&chan, &out_value)
    br ok -> L_OK, L_CHECK
L_OK:
    !ok
    !start
    !timeout_ns
    !chan
    !out_value
    return 1
L_CHECK:
    now = call @sa_time_instant_ns()
    elapsed = sub now, start
    timed_out = uge elapsed, timeout_ns
    br timed_out -> L_TIMEOUT, L_BACKOFF
L_BACKOFF:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    at_limit = uge backoff_ns, 1024
    br at_limit -> L_KEEP, L_GROW
L_GROW:
    next_backoff = shl backoff_ns, 1
    store backoff_slot+0, next_backoff as u64
    !next_backoff
    !at_limit
    !backoff_ns
    !timed_out
    !elapsed
    !now
    !ok
    jmp L_TRY
L_KEEP:
    !at_limit
    !backoff_ns
    !timed_out
    !elapsed
    !now
    !ok
    jmp L_TRY
L_TIMEOUT:
    !timed_out
    !elapsed
    !now
    !ok
    !start
    !timeout_ns
    !chan
    !out_value
    return 0

[MACRO] MPSC_LIST_NEW %out_chan
    %out_chan = call @sa_mpsc_list_new()
[END_MACRO]

[MACRO] MPSC_LIST_SEND %chan, %value
    call @sa_mpsc_list_send(&%chan, %value)
[END_MACRO]

[MACRO] MPSC_LIST_TRY_RECV %out_ok, %out_value, %chan
    __mpl_slot_%out_ok = stack_alloc 8
    store __mpl_slot_%out_ok+0, 0 as u64
    %out_ok = call @sa_mpsc_list_try_recv(&%chan, &__mpl_slot_%out_ok)
    %out_value = load __mpl_slot_%out_ok+0 as u64
[END_MACRO]

[MACRO] MPSC_LIST_TRY_RECV_TIMEOUT_NS %out_ok, %out_value, %chan, %timeout_ns
    __mpl_timeout_slot_%out_ok = stack_alloc 8
    store __mpl_timeout_slot_%out_ok+0, 0 as u64
    %out_ok = call @sa_mpsc_list_try_recv_timeout(&%chan, &__mpl_timeout_slot_%out_ok, %timeout_ns)
    %out_value = load __mpl_timeout_slot_%out_ok+0 as u64
[END_MACRO]

[MACRO] MPSC_LIST_TRY_RECV_TIMEOUT_MS %out_ok, %out_value, %chan, %timeout_ms
    EXPAND NUM_U64_CHECKED_MUL __mpl_timeout_mul_ok_%out_ok, __mpl_timeout_ns_%out_ok, %timeout_ms, 1000000
    br __mpl_timeout_mul_ok_%out_ok -> L_MPSC_LIST_TIMEOUT_MS_OK_%out_ok, L_MPSC_LIST_TIMEOUT_MS_FAIL_%out_ok
L_MPSC_LIST_TIMEOUT_MS_OK_%out_ok:
    EXPAND MPSC_LIST_TRY_RECV_TIMEOUT_NS %out_ok, %out_value, %chan, __mpl_timeout_ns_%out_ok
    !__mpl_timeout_ns_%out_ok
    !__mpl_timeout_mul_ok_%out_ok
    jmp L_MPSC_LIST_TIMEOUT_MS_DONE_%out_ok
L_MPSC_LIST_TIMEOUT_MS_FAIL_%out_ok:
    %out_ok = add 0, 0
    %out_value = add 0, 0
    !__mpl_timeout_ns_%out_ok
    !__mpl_timeout_mul_ok_%out_ok
L_MPSC_LIST_TIMEOUT_MS_DONE_%out_ok:
[END_MACRO]

[MACRO] MPSC_LIST_FREE %chan
    call @sa_mpsc_list_free(&%chan)
[END_MACRO]

[MACRO] MPSC_LIST_DROP %chan
    EXPAND MPSC_LIST_FREE %chan
[END_MACRO]

[MACRO] MPSC_LIST_IS_DISCONNECTED %out_bool, %chan
    __mpl_disc_mtx_%out_bool = load %chan+MpscList_mutex as ptr
    __mpl_disc_list_%out_bool = load %chan+MpscList_list as ptr
    __mpl_disc_null_%out_bool = 0 as ptr
    __mpl_disc_mtx_zero_%out_bool = eq __mpl_disc_mtx_%out_bool, __mpl_disc_null_%out_bool
    __mpl_disc_list_zero_%out_bool = eq __mpl_disc_list_%out_bool, __mpl_disc_null_%out_bool
    %out_bool = and __mpl_disc_mtx_zero_%out_bool, __mpl_disc_list_zero_%out_bool
    !__mpl_disc_list_zero_%out_bool
    !__mpl_disc_mtx_zero_%out_bool
    !__mpl_disc_null_%out_bool
    !__mpl_disc_list_%out_bool
    !__mpl_disc_mtx_%out_bool
[END_MACRO]

[MACRO] MPSC_LIST_LEN %out_len, %chan
    __mpl_len_mtx_%out_len = load %chan+MpscList_mutex as ptr
    __mpl_list_%out_len = load %chan+MpscList_list as ptr
    __mpl_len_null_%out_len = 0 as ptr
    __mpl_len_disconnected_%out_len = eq __mpl_len_mtx_%out_len, __mpl_len_null_%out_len
    br __mpl_len_disconnected_%out_len -> L_MPSC_LIST_LEN_DISCONNECTED_%out_len, L_MPSC_LIST_LEN_LOCK_%out_len
L_MPSC_LIST_LEN_LOCK_%out_len:
    EXPAND MUTEX_LOCK __mpl_len_mtx_%out_len
    EXPAND LINKED_LIST_LEN %out_len, __mpl_list_%out_len
    EXPAND MUTEX_UNLOCK __mpl_len_mtx_%out_len
    !__mpl_len_disconnected_%out_len
    !__mpl_len_null_%out_len
    !__mpl_list_%out_len
    !__mpl_len_mtx_%out_len
    jmp L_MPSC_LIST_LEN_DONE_%out_len
L_MPSC_LIST_LEN_DISCONNECTED_%out_len:
    %out_len = add 0, 0
    !__mpl_len_disconnected_%out_len
    !__mpl_len_null_%out_len
    !__mpl_list_%out_len
    !__mpl_len_mtx_%out_len
L_MPSC_LIST_LEN_DONE_%out_len:
[END_MACRO]

[MACRO] MPSC_LIST_IS_EMPTY %out_bool, %chan
    __mpl_empty_mtx_%out_bool = load %chan+MpscList_mutex as ptr
    __mpl_list_e_%out_bool = load %chan+MpscList_list as ptr
    __mpl_empty_null_%out_bool = 0 as ptr
    __mpl_empty_disconnected_%out_bool = eq __mpl_empty_mtx_%out_bool, __mpl_empty_null_%out_bool
    br __mpl_empty_disconnected_%out_bool -> L_MPSC_LIST_EMPTY_DISCONNECTED_%out_bool, L_MPSC_LIST_EMPTY_LOCK_%out_bool
L_MPSC_LIST_EMPTY_LOCK_%out_bool:
    EXPAND MUTEX_LOCK __mpl_empty_mtx_%out_bool
    EXPAND LINKED_LIST_IS_EMPTY %out_bool, __mpl_list_e_%out_bool
    EXPAND MUTEX_UNLOCK __mpl_empty_mtx_%out_bool
    !__mpl_empty_disconnected_%out_bool
    !__mpl_empty_null_%out_bool
    !__mpl_list_e_%out_bool
    !__mpl_empty_mtx_%out_bool
    jmp L_MPSC_LIST_EMPTY_DONE_%out_bool
L_MPSC_LIST_EMPTY_DISCONNECTED_%out_bool:
    %out_bool = add 0, 1
    !__mpl_empty_disconnected_%out_bool
    !__mpl_empty_null_%out_bool
    !__mpl_list_e_%out_bool
    !__mpl_empty_mtx_%out_bool
L_MPSC_LIST_EMPTY_DONE_%out_bool:
[END_MACRO]
