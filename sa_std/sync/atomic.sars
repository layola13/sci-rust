L_ATOMIC_I8_FETCH_UPDATE_RETRY_%out_ok:
    !__atomic_i8_fetch_update_ok_%out_ok
    !__atomic_i8_fetch_update_cur_%out_ok
    !__atomic_i8_fetch_update_new_%out_ok
