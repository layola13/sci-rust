    __atomic_u8_fetch_update_cur_%out_ok, __atomic_u8_fetch_update_ok_%out_ok = cmpxchg %atomic_ptr+AtomicU8_value, %out_old, __atomic_u8_fetch_update_new_%out_ok as u8 %success_ordering %failure_ordering
    br __atomic_u8_fetch_update_ok_%out_ok -> L_ATOMIC_U8_FETCH_UPDATE_DONE_%out_ok, L_ATOMIC_U8_FETCH_UPDATE_RETRY_%out_ok
L_ATOMIC_U8_FETCH_UPDATE_RETRY_%out_ok:
