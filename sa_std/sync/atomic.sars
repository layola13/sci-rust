@import "atomic.sal"

[MACRO] ATOMIC_FENCE %ordering
    fence %ordering
[END_MACRO]

[MACRO] ATOMIC_ORDERING_NEW %ordering_ptr, %ordering
    store %ordering_ptr+AtomicOrdering_value, %ordering as u8
[END_MACRO]

[MACRO] ATOMIC_ORDERING_GET %out_ordering, %ordering_ptr
    %out_ordering = load %ordering_ptr+AtomicOrdering_value as u8
[END_MACRO]

[MACRO] ATOMIC_ORDERING_IS_LOAD_VALID %out_bool, %ordering
    __atomic_order_load_relaxed_%out_bool = eq %ordering, ATOMIC_ORDERING_RELAXED
    __atomic_order_load_acquire_%out_bool = eq %ordering, ATOMIC_ORDERING_ACQUIRE
    __atomic_order_load_seq_%out_bool = eq %ordering, ATOMIC_ORDERING_SEQ_CST
    __atomic_order_load_ra_%out_bool = or __atomic_order_load_relaxed_%out_bool, __atomic_order_load_acquire_%out_bool
    %out_bool = or __atomic_order_load_ra_%out_bool, __atomic_order_load_seq_%out_bool
    !__atomic_order_load_ra_%out_bool
    !__atomic_order_load_seq_%out_bool
    !__atomic_order_load_acquire_%out_bool
    !__atomic_order_load_relaxed_%out_bool
[END_MACRO]

[MACRO] ATOMIC_ORDERING_IS_STORE_VALID %out_bool, %ordering
    __atomic_order_store_relaxed_%out_bool = eq %ordering, ATOMIC_ORDERING_RELAXED
    __atomic_order_store_release_%out_bool = eq %ordering, ATOMIC_ORDERING_RELEASE
    __atomic_order_store_seq_%out_bool = eq %ordering, ATOMIC_ORDERING_SEQ_CST
    __atomic_order_store_rr_%out_bool = or __atomic_order_store_relaxed_%out_bool, __atomic_order_store_release_%out_bool
    %out_bool = or __atomic_order_store_rr_%out_bool, __atomic_order_store_seq_%out_bool
    !__atomic_order_store_rr_%out_bool
    !__atomic_order_store_seq_%out_bool
    !__atomic_order_store_release_%out_bool
    !__atomic_order_store_relaxed_%out_bool
[END_MACRO]

[MACRO] ATOMIC_ORDERING_IS_FAILURE_VALID %out_bool, %ordering
    EXPAND ATOMIC_ORDERING_IS_LOAD_VALID %out_bool, %ordering
[END_MACRO]

[MACRO] ATOMIC_ORDERING_IS_FENCE_VALID %out_bool, %ordering
    __atomic_order_fence_acquire_%out_bool = eq %ordering, ATOMIC_ORDERING_ACQUIRE
    __atomic_order_fence_release_%out_bool = eq %ordering, ATOMIC_ORDERING_RELEASE
    __atomic_order_fence_acqrel_%out_bool = eq %ordering, ATOMIC_ORDERING_ACQ_REL
    __atomic_order_fence_seq_%out_bool = eq %ordering, ATOMIC_ORDERING_SEQ_CST
    __atomic_order_fence_ar_%out_bool = or __atomic_order_fence_acquire_%out_bool, __atomic_order_fence_release_%out_bool
    __atomic_order_fence_as_%out_bool = or __atomic_order_fence_acqrel_%out_bool, __atomic_order_fence_seq_%out_bool
    %out_bool = or __atomic_order_fence_ar_%out_bool, __atomic_order_fence_as_%out_bool
    !__atomic_order_fence_as_%out_bool
    !__atomic_order_fence_ar_%out_bool
    !__atomic_order_fence_seq_%out_bool
    !__atomic_order_fence_acqrel_%out_bool
    !__atomic_order_fence_release_%out_bool
    !__atomic_order_fence_acquire_%out_bool
[END_MACRO]

[MACRO] ATOMIC_BOOL_INIT %atomic_ptr, %value
    store %atomic_ptr+AtomicBool_value, %value as u8
[END_MACRO]

[MACRO] ATOMIC_BOOL_GET_MUT_PTR %out_ptr, %atomic_ptr
    %out_ptr = ptr_add %atomic_ptr, AtomicBool_value
[END_MACRO]

[MACRO] ATOMIC_BOOL_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
    %out_atomic_ptr = ptr_add %value_ptr, 0
[END_MACRO]

[MACRO] ATOMIC_BOOL_FROM_PTR %out_atomic_ptr, %value_ptr
    EXPAND ATOMIC_BOOL_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
[END_MACRO]

[MACRO] ATOMIC_BOOL_INTO_INNER %out_value, %atomic_ptr
    %out_value = load %atomic_ptr+AtomicBool_value as u8
[END_MACRO]

[MACRO] ATOMIC_BOOL_LOAD %out_value, %atomic_ptr, %ordering
    %out_value = atomic_load %atomic_ptr+AtomicBool_value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_BOOL_STORE %atomic_ptr, %value, %ordering
    atomic_store %atomic_ptr+AtomicBool_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_BOOL_SWAP %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_xchg %atomic_ptr+AtomicBool_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_BOOL_COMPARE_EXCHANGE %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
    %out_old, %out_ok = cmpxchg %atomic_ptr+AtomicBool_value, %expected, %new_value as u8 %success_ordering %failure_ordering
[END_MACRO]

[MACRO] ATOMIC_BOOL_COMPARE_EXCHANGE_WEAK %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
    EXPAND ATOMIC_BOOL_COMPARE_EXCHANGE %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
[END_MACRO]

// fetch_update-style loop over cmpxchg. The update function is a macro-level
// `u8 -> u8` register, not a Rust closure object. Always reports ok=1 when
// the store eventually succeeds (no None-abort path).

[MACRO] ATOMIC_BOOL_FETCH_UPDATE %out_ok, %out_old, %atomic_ptr, %update_fn, %success_ordering, %failure_ordering
    jmp L_ATOMIC_BOOL_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_BOOL_FETCH_UPDATE_HEAD_%out_ok:
    %out_old = atomic_load %atomic_ptr+AtomicBool_value as u8 relaxed
    __atomic_bool_fetch_update_new_%out_ok = call %update_fn(%out_old)
    __atomic_bool_fetch_update_cur_%out_ok, __atomic_bool_fetch_update_ok_%out_ok = cmpxchg %atomic_ptr+AtomicBool_value, %out_old, __atomic_bool_fetch_update_new_%out_ok as u8 %success_ordering %failure_ordering
    br __atomic_bool_fetch_update_ok_%out_ok -> L_ATOMIC_BOOL_FETCH_UPDATE_DONE_%out_ok, L_ATOMIC_BOOL_FETCH_UPDATE_RETRY_%out_ok
L_ATOMIC_BOOL_FETCH_UPDATE_RETRY_%out_ok:
    !__atomic_bool_fetch_update_ok_%out_ok
    !__atomic_bool_fetch_update_cur_%out_ok
    !__atomic_bool_fetch_update_new_%out_ok
    !%out_old
    jmp L_ATOMIC_BOOL_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_BOOL_FETCH_UPDATE_DONE_%out_ok:
    %out_ok = add 0, 1
    !__atomic_bool_fetch_update_ok_%out_ok
    !__atomic_bool_fetch_update_cur_%out_ok
    !__atomic_bool_fetch_update_new_%out_ok
[END_MACRO]

[MACRO] ATOMIC_U8_INIT %atomic_ptr, %value
    store %atomic_ptr+AtomicU8_value, %value as u8
[END_MACRO]

[MACRO] ATOMIC_U8_GET_MUT_PTR %out_ptr, %atomic_ptr
    %out_ptr = ptr_add %atomic_ptr, AtomicU8_value
[END_MACRO]

[MACRO] ATOMIC_U8_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
    %out_atomic_ptr = ptr_add %value_ptr, 0
[END_MACRO]

[MACRO] ATOMIC_U8_FROM_PTR %out_atomic_ptr, %value_ptr
    EXPAND ATOMIC_U8_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
[END_MACRO]

[MACRO] ATOMIC_U8_INTO_INNER %out_value, %atomic_ptr
    %out_value = load %atomic_ptr+AtomicU8_value as u8
[END_MACRO]

[MACRO] ATOMIC_U8_LOAD %out_value, %atomic_ptr, %ordering
    %out_value = atomic_load %atomic_ptr+AtomicU8_value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_STORE %atomic_ptr, %value, %ordering
