    jmp L_ATOMIC_U8_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_U8_FETCH_UPDATE_DONE_%out_ok:
    %out_ok = add 0, 1
    !__atomic_u8_fetch_update_ok_%out_ok
    !__atomic_u8_fetch_update_cur_%out_ok
    !__atomic_u8_fetch_update_new_%out_ok
[END_MACRO]

