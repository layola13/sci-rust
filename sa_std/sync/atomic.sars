// fetch_update-style loop over cmpxchg. The update function is a macro-level
// `i8 -> i8` register, not a Rust closure object. Always reports ok=1 when
// the store eventually succeeds (no None-abort path).

[MACRO] ATOMIC_I8_FETCH_UPDATE %out_ok, %out_old, %atomic_ptr, %update_fn, %success_ordering, %failure_ordering
    jmp L_ATOMIC_I8_FETCH_UPDATE_HEAD_%out_ok
