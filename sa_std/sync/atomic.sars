[MACRO] ATOMIC_ISIZE_GET_MUT_PTR %out_ptr, %atomic_ptr
    %out_ptr = ptr_add %atomic_ptr, AtomicIsize_value
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
    %out_atomic_ptr = ptr_add %value_ptr, 0
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FROM_PTR %out_atomic_ptr, %value_ptr
    EXPAND ATOMIC_ISIZE_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
[END_MACRO]

[MACRO] ATOMIC_ISIZE_INTO_INNER %out_value, %atomic_ptr
    %out_value = load %atomic_ptr+AtomicIsize_value as i64
[END_MACRO]

[MACRO] ATOMIC_ISIZE_LOAD %out_value, %atomic_ptr, %ordering
    %out_value = atomic_load %atomic_ptr+AtomicIsize_value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_STORE %atomic_ptr, %value, %ordering
    atomic_store %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_SWAP %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_xchg %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FETCH_ADD %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_add %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FETCH_SUB %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_sub %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FETCH_AND %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_and %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FETCH_OR %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_or %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FETCH_XOR %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_xor %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FETCH_NAND %out_old, %atomic_ptr, %value, %ordering
    jmp L_ATOMIC_ISIZE_FETCH_NAND_HEAD_%out_old
L_ATOMIC_ISIZE_FETCH_NAND_HEAD_%out_old:
    %out_old = atomic_load %atomic_ptr+AtomicIsize_value as i64 relaxed
    __atomic_isize_nand_and_%out_old = and %out_old, %value
    __atomic_isize_nand_new_%out_old = xor __atomic_isize_nand_and_%out_old, -1
    __atomic_isize_nand_cur_%out_old, __atomic_isize_nand_ok_%out_old = cmpxchg %atomic_ptr+AtomicIsize_value, %out_old, __atomic_isize_nand_new_%out_old as i64 %ordering %ordering
    br __atomic_isize_nand_ok_%out_old -> L_ATOMIC_ISIZE_FETCH_NAND_DONE_%out_old, L_ATOMIC_ISIZE_FETCH_NAND_RETRY_%out_old
L_ATOMIC_ISIZE_FETCH_NAND_RETRY_%out_old:
    !__atomic_isize_nand_ok_%out_old
    !__atomic_isize_nand_cur_%out_old
    !__atomic_isize_nand_new_%out_old
    !__atomic_isize_nand_and_%out_old
    !%out_old
    jmp L_ATOMIC_ISIZE_FETCH_NAND_HEAD_%out_old
L_ATOMIC_ISIZE_FETCH_NAND_DONE_%out_old:
    !__atomic_isize_nand_ok_%out_old
    !__atomic_isize_nand_cur_%out_old
    !__atomic_isize_nand_new_%out_old
    !__atomic_isize_nand_and_%out_old
[END_MACRO]


[MACRO] ATOMIC_ISIZE_FETCH_MIN %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_min %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_FETCH_MAX %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_max %atomic_ptr+AtomicIsize_value, %value as i64 %ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_COMPARE_EXCHANGE %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
    %out_old, %out_ok = cmpxchg %atomic_ptr+AtomicIsize_value, %expected, %new_value as i64 %success_ordering %failure_ordering
[END_MACRO]

[MACRO] ATOMIC_ISIZE_COMPARE_EXCHANGE_WEAK %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
    EXPAND ATOMIC_ISIZE_COMPARE_EXCHANGE %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
[END_MACRO]

// fetch_update-style loop over cmpxchg. The update function is a macro-level
// `i64 -> i64` register, not a Rust closure object. Always reports ok=1 when
// the store eventually succeeds (no None-abort path).

[MACRO] ATOMIC_ISIZE_FETCH_UPDATE %out_ok, %out_old, %atomic_ptr, %update_fn, %success_ordering, %failure_ordering
    jmp L_ATOMIC_ISIZE_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_ISIZE_FETCH_UPDATE_HEAD_%out_ok:
    %out_old = atomic_load %atomic_ptr+AtomicIsize_value as i64 relaxed
    __atomic_isize_fetch_update_new_%out_ok = call %update_fn(%out_old)
    __atomic_isize_fetch_update_cur_%out_ok, __atomic_isize_fetch_update_ok_%out_ok = cmpxchg %atomic_ptr+AtomicIsize_value, %out_old, __atomic_isize_fetch_update_new_%out_ok as i64 %success_ordering %failure_ordering
    br __atomic_isize_fetch_update_ok_%out_ok -> L_ATOMIC_ISIZE_FETCH_UPDATE_DONE_%out_ok, L_ATOMIC_ISIZE_FETCH_UPDATE_RETRY_%out_ok
L_ATOMIC_ISIZE_FETCH_UPDATE_RETRY_%out_ok:
    !__atomic_isize_fetch_update_ok_%out_ok
    !__atomic_isize_fetch_update_cur_%out_ok
    !__atomic_isize_fetch_update_new_%out_ok
    !%out_old
    jmp L_ATOMIC_ISIZE_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_ISIZE_FETCH_UPDATE_DONE_%out_ok:
    %out_ok = add 0, 1
    !__atomic_isize_fetch_update_ok_%out_ok
    !__atomic_isize_fetch_update_cur_%out_ok
    !__atomic_isize_fetch_update_new_%out_ok
[END_MACRO]

[MACRO] ATOMIC_PTR_INIT %atomic_ptr, %value_ptr
    store %atomic_ptr+AtomicPtr_value, %value_ptr as ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_GET_MUT_PTR %out_ptr, %atomic_ptr
    %out_ptr = ptr_add %atomic_ptr, AtomicPtr_value
[END_MACRO]

[MACRO] ATOMIC_PTR_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
    %out_atomic_ptr = ptr_add %value_ptr, 0
[END_MACRO]

[MACRO] ATOMIC_PTR_FROM_PTR %out_atomic_ptr, %value_ptr
    EXPAND ATOMIC_PTR_FROM_MUT_PTR %out_atomic_ptr, %value_ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_INTO_INNER %out_ptr, %atomic_ptr
    %out_ptr = load %atomic_ptr+AtomicPtr_value as ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_LOAD %out_ptr, %atomic_ptr, %ordering
    %out_ptr = atomic_load %atomic_ptr+AtomicPtr_value as ptr %ordering
[END_MACRO]

[MACRO] ATOMIC_PTR_STORE %atomic_ptr, %value_ptr, %ordering
    atomic_store %atomic_ptr+AtomicPtr_value, %value_ptr as ptr %ordering
[END_MACRO]

[MACRO] ATOMIC_PTR_SWAP %out_old_ptr, %atomic_ptr, %value_ptr, %ordering
    jmp L_ATOMIC_PTR_SWAP_HEAD_%out_old_ptr

L_ATOMIC_PTR_SWAP_HEAD_%out_old_ptr:
    __atomic_ptr_swap_expected_%out_old_ptr = atomic_load %atomic_ptr+AtomicPtr_value as ptr relaxed
    %out_old_ptr, __atomic_ptr_swap_ok_%out_old_ptr = cmpxchg %atomic_ptr+AtomicPtr_value, __atomic_ptr_swap_expected_%out_old_ptr, %value_ptr as ptr %ordering relaxed
    br __atomic_ptr_swap_ok_%out_old_ptr -> L_ATOMIC_PTR_SWAP_DONE_%out_old_ptr, L_ATOMIC_PTR_SWAP_RETRY_%out_old_ptr

L_ATOMIC_PTR_SWAP_RETRY_%out_old_ptr:
    !__atomic_ptr_swap_ok_%out_old_ptr
    !__atomic_ptr_swap_expected_%out_old_ptr
    !%out_old_ptr
    jmp L_ATOMIC_PTR_SWAP_HEAD_%out_old_ptr

L_ATOMIC_PTR_SWAP_DONE_%out_old_ptr:
    !__atomic_ptr_swap_ok_%out_old_ptr
    !__atomic_ptr_swap_expected_%out_old_ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_FETCH_BYTE_ADD %out_old_ptr, %atomic_ptr, %byte_offset, %ordering
    jmp L_ATOMIC_PTR_BYTE_ADD_HEAD_%out_old_ptr

L_ATOMIC_PTR_BYTE_ADD_HEAD_%out_old_ptr:
    __atomic_ptr_byte_add_expected_%out_old_ptr = atomic_load %atomic_ptr+AtomicPtr_value as ptr relaxed
    __atomic_ptr_byte_add_new_%out_old_ptr = ptr_add __atomic_ptr_byte_add_expected_%out_old_ptr, %byte_offset
    %out_old_ptr, __atomic_ptr_byte_add_ok_%out_old_ptr = cmpxchg %atomic_ptr+AtomicPtr_value, __atomic_ptr_byte_add_expected_%out_old_ptr, __atomic_ptr_byte_add_new_%out_old_ptr as ptr %ordering relaxed
    br __atomic_ptr_byte_add_ok_%out_old_ptr -> L_ATOMIC_PTR_BYTE_ADD_DONE_%out_old_ptr, L_ATOMIC_PTR_BYTE_ADD_RETRY_%out_old_ptr

L_ATOMIC_PTR_BYTE_ADD_RETRY_%out_old_ptr:
    !__atomic_ptr_byte_add_ok_%out_old_ptr
    !__atomic_ptr_byte_add_new_%out_old_ptr
    !__atomic_ptr_byte_add_expected_%out_old_ptr
    !%out_old_ptr
    jmp L_ATOMIC_PTR_BYTE_ADD_HEAD_%out_old_ptr

L_ATOMIC_PTR_BYTE_ADD_DONE_%out_old_ptr:
    !__atomic_ptr_byte_add_ok_%out_old_ptr
    !__atomic_ptr_byte_add_new_%out_old_ptr
    !__atomic_ptr_byte_add_expected_%out_old_ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_FETCH_BYTE_SUB %out_old_ptr, %atomic_ptr, %byte_offset, %ordering
    jmp L_ATOMIC_PTR_BYTE_SUB_HEAD_%out_old_ptr

L_ATOMIC_PTR_BYTE_SUB_HEAD_%out_old_ptr:
    __atomic_ptr_byte_sub_expected_%out_old_ptr = atomic_load %atomic_ptr+AtomicPtr_value as ptr relaxed
    __atomic_ptr_byte_sub_offset_%out_old_ptr = sub 0, %byte_offset
    __atomic_ptr_byte_sub_new_%out_old_ptr = ptr_add __atomic_ptr_byte_sub_expected_%out_old_ptr, __atomic_ptr_byte_sub_offset_%out_old_ptr
    %out_old_ptr, __atomic_ptr_byte_sub_ok_%out_old_ptr = cmpxchg %atomic_ptr+AtomicPtr_value, __atomic_ptr_byte_sub_expected_%out_old_ptr, __atomic_ptr_byte_sub_new_%out_old_ptr as ptr %ordering relaxed
    br __atomic_ptr_byte_sub_ok_%out_old_ptr -> L_ATOMIC_PTR_BYTE_SUB_DONE_%out_old_ptr, L_ATOMIC_PTR_BYTE_SUB_RETRY_%out_old_ptr

L_ATOMIC_PTR_BYTE_SUB_RETRY_%out_old_ptr:
    !__atomic_ptr_byte_sub_ok_%out_old_ptr
    !__atomic_ptr_byte_sub_new_%out_old_ptr
    !__atomic_ptr_byte_sub_offset_%out_old_ptr
    !__atomic_ptr_byte_sub_expected_%out_old_ptr
    !%out_old_ptr
    jmp L_ATOMIC_PTR_BYTE_SUB_HEAD_%out_old_ptr

L_ATOMIC_PTR_BYTE_SUB_DONE_%out_old_ptr:
    !__atomic_ptr_byte_sub_ok_%out_old_ptr
    !__atomic_ptr_byte_sub_new_%out_old_ptr
    !__atomic_ptr_byte_sub_offset_%out_old_ptr
    !__atomic_ptr_byte_sub_expected_%out_old_ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_FETCH_U64_ADD %out_old_ptr, %atomic_ptr, %count, %ordering
    __atomic_ptr_u64_add_bytes_%out_old_ptr = mul %count, 8
    EXPAND ATOMIC_PTR_FETCH_BYTE_ADD %out_old_ptr, %atomic_ptr, __atomic_ptr_u64_add_bytes_%out_old_ptr, %ordering
    !__atomic_ptr_u64_add_bytes_%out_old_ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_FETCH_U64_SUB %out_old_ptr, %atomic_ptr, %count, %ordering
    __atomic_ptr_u64_sub_bytes_%out_old_ptr = mul %count, 8
    EXPAND ATOMIC_PTR_FETCH_BYTE_SUB %out_old_ptr, %atomic_ptr, __atomic_ptr_u64_sub_bytes_%out_old_ptr, %ordering
    !__atomic_ptr_u64_sub_bytes_%out_old_ptr
[END_MACRO]

[MACRO] ATOMIC_PTR_COMPARE_EXCHANGE %out_old_ptr, %out_ok, %atomic_ptr, %expected_ptr, %new_ptr, %success_ordering, %failure_ordering
    %out_old_ptr, %out_ok = cmpxchg %atomic_ptr+AtomicPtr_value, %expected_ptr, %new_ptr as ptr %success_ordering %failure_ordering
[END_MACRO]

[MACRO] ATOMIC_PTR_COMPARE_EXCHANGE_WEAK %out_old_ptr, %out_ok, %atomic_ptr, %expected_ptr, %new_ptr, %success_ordering, %failure_ordering
    EXPAND ATOMIC_PTR_COMPARE_EXCHANGE %out_old_ptr, %out_ok, %atomic_ptr, %expected_ptr, %new_ptr, %success_ordering, %failure_ordering
[END_MACRO]

// fetch_update-style loop over cmpxchg. The update function is a macro-level
// `ptr -> ptr` register, not a Rust closure object. Always reports ok=1 when
// the store eventually succeeds (no None-abort path).

[MACRO] ATOMIC_PTR_FETCH_UPDATE %out_ok, %out_old, %atomic_ptr, %update_fn, %success_ordering, %failure_ordering
    jmp L_ATOMIC_PTR_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_PTR_FETCH_UPDATE_HEAD_%out_ok:
    %out_old = atomic_load %atomic_ptr+AtomicPtr_value as ptr relaxed
    __atomic_ptr_fetch_update_new_%out_ok = call %update_fn(%out_old)
    __atomic_ptr_fetch_update_cur_%out_ok, __atomic_ptr_fetch_update_ok_%out_ok = cmpxchg %atomic_ptr+AtomicPtr_value, %out_old, __atomic_ptr_fetch_update_new_%out_ok as ptr %success_ordering %failure_ordering
    br __atomic_ptr_fetch_update_ok_%out_ok -> L_ATOMIC_PTR_FETCH_UPDATE_DONE_%out_ok, L_ATOMIC_PTR_FETCH_UPDATE_RETRY_%out_ok
L_ATOMIC_PTR_FETCH_UPDATE_RETRY_%out_ok:
    !__atomic_ptr_fetch_update_ok_%out_ok
    !__atomic_ptr_fetch_update_cur_%out_ok
    !__atomic_ptr_fetch_update_new_%out_ok
    !%out_old
    jmp L_ATOMIC_PTR_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_PTR_FETCH_UPDATE_DONE_%out_ok:
    %out_ok = add 0, 1
    !__atomic_ptr_fetch_update_ok_%out_ok
    !__atomic_ptr_fetch_update_cur_%out_ok
    !__atomic_ptr_fetch_update_new_%out_ok
[END_MACRO]

// Default-style zero initialization helpers (store 0 into existing atomic slots).

[MACRO] ATOMIC_BOOL_DEFAULT %atomic_ptr
    EXPAND ATOMIC_BOOL_INIT %atomic_ptr, 0
[END_MACRO]

[MACRO] ATOMIC_U8_DEFAULT %atomic_ptr
