[END_MACRO]

[MACRO] ATOMIC_U8_SWAP %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_xchg %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_ADD %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_add %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_SUB %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_sub %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_AND %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_and %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_OR %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_or %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_XOR %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_xor %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_NAND %out_old, %atomic_ptr, %value, %ordering
    jmp L_ATOMIC_U8_FETCH_NAND_HEAD_%out_old
L_ATOMIC_U8_FETCH_NAND_HEAD_%out_old:
    %out_old = atomic_load %atomic_ptr+AtomicU8_value as u8 relaxed
    __atomic_u8_nand_and_%out_old = and %out_old, %value
    __atomic_u8_nand_new_%out_old = xor __atomic_u8_nand_and_%out_old, -1
    __atomic_u8_nand_cur_%out_old, __atomic_u8_nand_ok_%out_old = cmpxchg %atomic_ptr+AtomicU8_value, %out_old, __atomic_u8_nand_new_%out_old as u8 %ordering %ordering
    br __atomic_u8_nand_ok_%out_old -> L_ATOMIC_U8_FETCH_NAND_DONE_%out_old, L_ATOMIC_U8_FETCH_NAND_RETRY_%out_old
L_ATOMIC_U8_FETCH_NAND_RETRY_%out_old:
    !__atomic_u8_nand_ok_%out_old
    !__atomic_u8_nand_cur_%out_old
    !__atomic_u8_nand_new_%out_old
    !__atomic_u8_nand_and_%out_old
    !%out_old
    jmp L_ATOMIC_U8_FETCH_NAND_HEAD_%out_old
L_ATOMIC_U8_FETCH_NAND_DONE_%out_old:
    !__atomic_u8_nand_ok_%out_old
    !__atomic_u8_nand_cur_%out_old
    !__atomic_u8_nand_new_%out_old
    !__atomic_u8_nand_and_%out_old
[END_MACRO]


[MACRO] ATOMIC_U8_FETCH_MIN %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_min %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_MAX %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_max %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_UMIN %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_umin %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_FETCH_UMAX %out_old, %atomic_ptr, %value, %ordering
    %out_old = atomic_rmw_umax %atomic_ptr+AtomicU8_value, %value as u8 %ordering
[END_MACRO]

[MACRO] ATOMIC_U8_COMPARE_EXCHANGE %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
    %out_old, %out_ok = cmpxchg %atomic_ptr+AtomicU8_value, %expected, %new_value as u8 %success_ordering %failure_ordering
[END_MACRO]

[MACRO] ATOMIC_U8_COMPARE_EXCHANGE_WEAK %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
    EXPAND ATOMIC_U8_COMPARE_EXCHANGE %out_old, %out_ok, %atomic_ptr, %expected, %new_value, %success_ordering, %failure_ordering
[END_MACRO]

// fetch_update-style loop over cmpxchg. The update function is a macro-level
// `u8 -> u8` register, not a Rust closure object. Always reports ok=1 when
// the store eventually succeeds (no None-abort path).

[MACRO] ATOMIC_U8_FETCH_UPDATE %out_ok, %out_old, %atomic_ptr, %update_fn, %success_ordering, %failure_ordering
    jmp L_ATOMIC_U8_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_U8_FETCH_UPDATE_HEAD_%out_ok:
    %out_old = atomic_load %atomic_ptr+AtomicU8_value as u8 relaxed
