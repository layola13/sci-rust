// fetch_update-style loop over cmpxchg. The update function is a macro-level
// `u16 -> u16` register, not a Rust closure object. Always reports ok=1 when
// the store eventually succeeds (no None-abort path).

[MACRO] ATOMIC_U16_FETCH_UPDATE %out_ok, %out_old, %atomic_ptr, %update_fn, %success_ordering, %failure_ordering
    jmp L_ATOMIC_U16_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_U16_FETCH_UPDATE_HEAD_%out_ok:
    %out_old = atomic_load %atomic_ptr+AtomicU16_value as u16 relaxed
    __atomic_u16_fetch_update_new_%out_ok = call %update_fn(%out_old)
    __atomic_u16_fetch_update_cur_%out_ok, __atomic_u16_fetch_update_ok_%out_ok = cmpxchg %atomic_ptr+AtomicU16_value, %out_old, __atomic_u16_fetch_update_new_%out_ok as u16 %success_ordering %failure_ordering
    br __atomic_u16_fetch_update_ok_%out_ok -> L_ATOMIC_U16_FETCH_UPDATE_DONE_%out_ok, L_ATOMIC_U16_FETCH_UPDATE_RETRY_%out_ok
L_ATOMIC_U16_FETCH_UPDATE_RETRY_%out_ok:
    !__atomic_u16_fetch_update_ok_%out_ok
    !__atomic_u16_fetch_update_cur_%out_ok
    !__atomic_u16_fetch_update_new_%out_ok
    !%out_old
    jmp L_ATOMIC_U16_FETCH_UPDATE_HEAD_%out_ok
L_ATOMIC_U16_FETCH_UPDATE_DONE_%out_ok:
    %out_ok = add 0, 1
    !__atomic_u16_fetch_update_ok_%out_ok
    !__atomic_u16_fetch_update_cur_%out_ok
    !__atomic_u16_fetch_update_new_%out_ok
[END_MACRO]

