// Concrete Condvar subset: notify_one/notify_all + wait with Mutex.
// Spin/backoff based. Single-thread wait_while(false) is non-blocking.
@import "condvar.sal"
@import "mutex.sal"
@import "mutex.sars"
@import "../time.sars"
@import "../time.sai"

@__condvar_dec_waiter(cond: ptr) -> u64:
L_ENTRY:
    waiters = atomic_load cond+Condvar_waiters as u64 acquire
    has_waiter = ne waiters, 0
    br has_waiter -> L_CLAIM, L_EMPTY
L_CLAIM:
    next_waiters = sub waiters, 1
    old_waiters, released = cmpxchg cond+Condvar_waiters, waiters, next_waiters as u64 seq_cst seq_cst
    br released -> L_DONE, L_RETRY
L_RETRY:
    !old_waiters
    !next_waiters
    !released
    !has_waiter
    !waiters
    jmp L_ENTRY
L_EMPTY:
    !has_waiter
    !waiters
    return 0
L_DONE:
    !old_waiters
    !next_waiters
    !released
    !has_waiter
    !waiters
    return 1
@__condvar_wait_spin(cond: ptr, mutex: ptr) -> void:
L_ENTRY:
    old_waiters = atomic_rmw_add cond+Condvar_waiters, 1 as u64 seq_cst
    !old_waiters
    atomic_store mutex+Mutex_lock, 0 as u64 release
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64
    jmp L_SPIN

L_SPIN:
    note = atomic_load cond+Condvar_notify as u64 acquire
    has_note = ne note, 0
    br has_note -> L_NOTIFIED, L_BACKOFF

L_BACKOFF:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    at_limit = uge backoff_ns, 1024
    br at_limit -> L_KEEP, L_GROW

L_GROW:
    next_backoff = shl backoff_ns, 1
    store backoff_slot+0, next_backoff as u64
    !next_backoff
    !at_limit
    !backoff_ns
    !has_note
    !note
    jmp L_SPIN

L_KEEP:
    !at_limit
    !backoff_ns
    !has_note
    !note
    jmp L_SPIN

L_NOTIFIED:
    prev = atomic_rmw_xchg cond+Condvar_notify, 0 as u64 seq_cst
    old_w = call @__condvar_dec_waiter(cond)
    !old_w
    was_all = ugt prev, 1
    br was_all -> L_REARM_ALL, L_RELOCK

L_REARM_ALL:
    atomic_store cond+Condvar_notify, 2 as u64 release
    jmp L_RELOCK

L_RELOCK:
    call @__mutex_lock_spin(mutex)
    !was_all
    !prev
    !has_note
    !note
    return

[MACRO] CONDVAR_NEW %out_cond
    %out_cond = alloc Condvar_SIZE
    store %out_cond+Condvar_waiters, 0 as u64
    store %out_cond+Condvar_notify, 0 as u64
[END_MACRO]

[MACRO] CONDVAR_DEFAULT %out_cond
    EXPAND CONDVAR_NEW %out_cond
[END_MACRO]

[MACRO] CONDVAR_NOTIFY_ONE %cond_reg
    atomic_store %cond_reg+Condvar_notify, 1 as u64 release
[END_MACRO]

[MACRO] CONDVAR_NOTIFY_ALL %cond_reg
    atomic_store %cond_reg+Condvar_notify, 2 as u64 release
[END_MACRO]

[MACRO] CONDVAR_WAIT %cond_reg, %mutex_reg
    call @__condvar_wait_spin(%cond_reg, %mutex_reg)
[END_MACRO]

[MACRO] CONDVAR_WAIT_WHILE %cond_reg, %mutex_reg, %pred_fn
    jmp L_COND_WW_HEAD_%cond_reg
L_COND_WW_HEAD_%cond_reg:
    __cond_ww_keep_%cond_reg = call %pred_fn(%mutex_reg)
    __cond_ww_done_%cond_reg = eq __cond_ww_keep_%cond_reg, 0
    br __cond_ww_done_%cond_reg -> L_COND_WW_DONE_%cond_reg, L_COND_WW_BODY_%cond_reg
L_COND_WW_BODY_%cond_reg:
    call @__condvar_wait_spin(%cond_reg, %mutex_reg)
    !__cond_ww_done_%cond_reg
    !__cond_ww_keep_%cond_reg
    jmp L_COND_WW_HEAD_%cond_reg
L_COND_WW_DONE_%cond_reg:
    !__cond_ww_done_%cond_reg
    !__cond_ww_keep_%cond_reg
[END_MACRO]

[MACRO] CONDVAR_WAITERS %out_count, %cond_reg
    %out_count = atomic_load %cond_reg+Condvar_waiters as u64 acquire
[END_MACRO]

// Timed wait: returns 1 if notified, 0 if timeout. Spins with sleep until deadline.
@__condvar_wait_timeout_ns(cond: ptr, mutex: ptr, timeout_ns: u64) -> u64:
L_ENTRY:
    start = call @sa_time_instant_ns()
    old_waiters = atomic_rmw_add cond+Condvar_waiters, 1 as u64 seq_cst
    !old_waiters
    atomic_store mutex+Mutex_lock, 0 as u64 release
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64
    jmp L_TO_SPIN

L_TO_SPIN:
    note = atomic_load cond+Condvar_notify as u64 acquire
    has_note = ne note, 0
    br has_note -> L_TO_NOTIFIED, L_TO_CHECK

L_TO_CHECK:
    now = call @sa_time_instant_ns()
    elapsed = sub now, start
    timed_out = uge elapsed, timeout_ns
    !now
    !elapsed
    br timed_out -> L_TO_TIMEOUT, L_TO_BACKOFF

L_TO_BACKOFF:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    at_limit = uge backoff_ns, 1024
    br at_limit -> L_TO_KEEP, L_TO_GROW

L_TO_GROW:
    next_backoff = shl backoff_ns, 1
    store backoff_slot+0, next_backoff as u64
    !next_backoff
    !at_limit
    !backoff_ns
    !timed_out
    !has_note
    !note
    jmp L_TO_SPIN

L_TO_KEEP:
    !at_limit
    !backoff_ns
    !timed_out
    !has_note
    !note
    jmp L_TO_SPIN

L_TO_TIMEOUT:
    old_w = call @__condvar_dec_waiter(cond)
    !old_w
    call @__mutex_lock_spin(mutex)
    !timed_out
    !has_note
    !note
    !start
    !timeout_ns
    !cond
    !mutex
    return 0

L_TO_NOTIFIED:
    prev = atomic_rmw_xchg cond+Condvar_notify, 0 as u64 seq_cst
    old_w2 = call @__condvar_dec_waiter(cond)
    !old_w2
    was_all = ugt prev, 1
    br was_all -> L_TO_REARM, L_TO_RELOCK

L_TO_REARM:
    atomic_store cond+Condvar_notify, 2 as u64 release
    jmp L_TO_RELOCK

L_TO_RELOCK:
    call @__mutex_lock_spin(mutex)
    !was_all
    !prev
    !has_note
    !note
    !start
    !timeout_ns
    !cond
    !mutex
    return 1

[MACRO] CONDVAR_WAIT_TIMEOUT_NS %out_notified, %cond_reg, %mutex_reg, %timeout_ns
    %out_notified = call @__condvar_wait_timeout_ns(%cond_reg, %mutex_reg, %timeout_ns)
[END_MACRO]

[MACRO] CONDVAR_WAIT_TIMEOUT_MS %out_notified, %cond_reg, %mutex_reg, %timeout_ms
    EXPAND TIME_CHECKED_MUL_NS __cond_ms_ok_%out_notified, __cond_to_ns_%out_notified, %timeout_ms, Time_NS_PER_MS
    br __cond_ms_ok_%out_notified -> L_CONDVAR_TIMEOUT_MS_OK_%out_notified, L_CONDVAR_TIMEOUT_MS_OVERFLOW_%out_notified
L_CONDVAR_TIMEOUT_MS_OK_%out_notified:
    EXPAND CONDVAR_WAIT_TIMEOUT_NS %out_notified, %cond_reg, %mutex_reg, __cond_to_ns_%out_notified
    !__cond_to_ns_%out_notified
    !__cond_ms_ok_%out_notified
    jmp L_CONDVAR_TIMEOUT_MS_DONE_%out_notified
L_CONDVAR_TIMEOUT_MS_OVERFLOW_%out_notified:
    %out_notified = add 0, 0
    !__cond_to_ns_%out_notified
    !__cond_ms_ok_%out_notified
L_CONDVAR_TIMEOUT_MS_DONE_%out_notified:
[END_MACRO]

[MACRO] CONDVAR_WAIT_TIMEOUT_DURATION_NS %out_notified, %cond_reg, %mutex_reg, %duration_ns
    EXPAND CONDVAR_WAIT_TIMEOUT_NS %out_notified, %cond_reg, %mutex_reg, %duration_ns
[END_MACRO]
