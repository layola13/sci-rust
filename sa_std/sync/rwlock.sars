@import "rwlock.sal"
@import "../time.sai"

@__rwlock_release_read(lock: ptr) -> void:
L_ENTRY:
    readers = atomic_load lock+RwLock_readers as i32 acquire
    had_reader = sgt readers, 0
    br had_reader -> L_RELEASE_CLAIM, L_RELEASE_UNDERFLOW

L_RELEASE_CLAIM:
    next_readers = sub readers, 1
    old_readers, released = cmpxchg lock+RwLock_readers, readers, next_readers as i32 acq_rel acquire
    br released -> L_RELEASE_OK, L_RELEASE_RETRY

L_RELEASE_RETRY:
    !released
    !old_readers
    !next_readers
    !had_reader
    !readers
    jmp L_ENTRY

L_RELEASE_UNDERFLOW:
    !had_reader
    !readers
    panic(1601)

L_RELEASE_OK:
    !released
    !old_readers
    !next_readers
    !had_reader
    !readers
    !lock
    return

[MACRO] RWLOCK_NEW %out_lock
    %out_lock = alloc RwLock_SIZE
    store %out_lock+RwLock_readers, 0 as i32
    store %out_lock+RwLock_writing, 0 as i32
[END_MACRO]

[MACRO] RWLOCK_NEW_I32 %out_lock, %value
    %out_lock = alloc RwLockI32_SIZE
    store %out_lock+RwLock_readers, 0 as i32
    store %out_lock+RwLock_writing, 0 as i32
    store %out_lock+RwLock_data, %value as i32
[END_MACRO]

[MACRO] RWLOCK_READER_COUNT %out_count, %lock_reg
    %out_count = atomic_load %lock_reg+RwLock_readers as i32 acquire
[END_MACRO]

[MACRO] RWLOCK_IS_WRITING %out_bool, %lock_reg
    __rwlock_writing_state_%out_bool = atomic_load %lock_reg+RwLock_writing as i32 acquire
    %out_bool = ne __rwlock_writing_state_%out_bool, 0
    !__rwlock_writing_state_%out_bool
[END_MACRO]

[MACRO] RWLOCK_IS_UNLOCKED %out_bool, %lock_reg
    __rwlock_readers_state_%out_bool = atomic_load %lock_reg+RwLock_readers as i32 acquire
    __rwlock_writing_state_%out_bool = atomic_load %lock_reg+RwLock_writing as i32 acquire
    __rwlock_no_readers_%out_bool = eq __rwlock_readers_state_%out_bool, 0
    __rwlock_no_writer_%out_bool = eq __rwlock_writing_state_%out_bool, 0
    %out_bool = and __rwlock_no_readers_%out_bool, __rwlock_no_writer_%out_bool
    !__rwlock_no_writer_%out_bool
    !__rwlock_no_readers_%out_bool
    !__rwlock_writing_state_%out_bool
    !__rwlock_readers_state_%out_bool
[END_MACRO]

[MACRO] RWLOCK_TRY_READ_NOERR %out_ok, %out_guard, %lock_reg
    __rwlock_read_ok_slot_%out_ok = alloc 8
    __rwlock_read_guard_slot_%out_ok = alloc 8
    __rwlock_read_writing_%out_ok = atomic_load %lock_reg+RwLock_writing as i32 acquire
    __rwlock_read_can_read_%out_ok = eq __rwlock_read_writing_%out_ok, 0
    br __rwlock_read_can_read_%out_ok -> L_RWLOCK_READ_NOERR_OK_%out_ok, L_RWLOCK_READ_NOERR_FAIL_%out_ok
L_RWLOCK_READ_NOERR_OK_%out_ok:
    __rwlock_read_old_%out_ok = atomic_rmw_add %lock_reg+RwLock_readers, 1 as i32 acq_rel
    __rwlock_read_after_writing_%out_ok = atomic_load %lock_reg+RwLock_writing as i32 acquire
    __rwlock_read_still_ok_%out_ok = eq __rwlock_read_after_writing_%out_ok, 0
    br __rwlock_read_still_ok_%out_ok -> L_RWLOCK_READ_NOERR_COMMIT_%out_ok, L_RWLOCK_READ_NOERR_ROLLBACK_%out_ok
L_RWLOCK_READ_NOERR_COMMIT_%out_ok:
    store __rwlock_read_guard_slot_%out_ok+0, %lock_reg as ptr
    store __rwlock_read_ok_slot_%out_ok+0, 1 as u64
    !__rwlock_read_still_ok_%out_ok
    !__rwlock_read_after_writing_%out_ok
    !__rwlock_read_old_%out_ok
    jmp L_RWLOCK_READ_NOERR_DONE_%out_ok
L_RWLOCK_READ_NOERR_ROLLBACK_%out_ok:
    __rwlock_read_rollback_%out_ok = atomic_rmw_sub %lock_reg+RwLock_readers, 1 as i32 acq_rel
    store __rwlock_read_guard_slot_%out_ok+0, 0 as ptr
    store __rwlock_read_ok_slot_%out_ok+0, 0 as u64
    !__rwlock_read_rollback_%out_ok
    !__rwlock_read_still_ok_%out_ok
    !__rwlock_read_after_writing_%out_ok
    !__rwlock_read_old_%out_ok
    jmp L_RWLOCK_READ_NOERR_DONE_%out_ok
L_RWLOCK_READ_NOERR_FAIL_%out_ok:
    store __rwlock_read_guard_slot_%out_ok+0, 0 as ptr
    store __rwlock_read_ok_slot_%out_ok+0, 0 as u64
    jmp L_RWLOCK_READ_NOERR_DONE_%out_ok
L_RWLOCK_READ_NOERR_DONE_%out_ok:
    %out_guard = load __rwlock_read_guard_slot_%out_ok+0 as ptr
    %out_ok = load __rwlock_read_ok_slot_%out_ok+0 as u64
    !__rwlock_read_guard_slot_%out_ok
    !__rwlock_read_ok_slot_%out_ok
    !__rwlock_read_can_read_%out_ok
    !__rwlock_read_writing_%out_ok
[END_MACRO]

[MACRO] RWLOCK_TRY_WRITE_NOERR %out_ok, %out_guard, %lock_reg
    __rwlock_write_ok_slot_%out_ok = alloc 8
    __rwlock_write_guard_slot_%out_ok = alloc 8
    __rwlock_write_writing_%out_ok, __rwlock_write_claim_ok_%out_ok = cmpxchg %lock_reg+RwLock_writing, 0, 1 as i32 acq_rel acquire
    br __rwlock_write_claim_ok_%out_ok -> L_RWLOCK_WRITE_NOERR_CLAIMED_%out_ok, L_RWLOCK_WRITE_NOERR_FAIL_%out_ok
L_RWLOCK_WRITE_NOERR_CLAIMED_%out_ok:
    __rwlock_write_readers_%out_ok = atomic_load %lock_reg+RwLock_readers as i32 acquire
    __rwlock_write_no_readers_%out_ok = eq __rwlock_write_readers_%out_ok, 0
    br __rwlock_write_no_readers_%out_ok -> L_RWLOCK_WRITE_NOERR_OK_%out_ok, L_RWLOCK_WRITE_NOERR_ROLLBACK_%out_ok
L_RWLOCK_WRITE_NOERR_OK_%out_ok:
    store __rwlock_write_guard_slot_%out_ok+0, %lock_reg as ptr
    store __rwlock_write_ok_slot_%out_ok+0, 1 as u64
    !__rwlock_write_no_readers_%out_ok
    !__rwlock_write_readers_%out_ok
    jmp L_RWLOCK_WRITE_NOERR_DONE_%out_ok
L_RWLOCK_WRITE_NOERR_ROLLBACK_%out_ok:
    atomic_store %lock_reg+RwLock_writing, 0 as i32 release
    store __rwlock_write_guard_slot_%out_ok+0, 0 as ptr
    store __rwlock_write_ok_slot_%out_ok+0, 0 as u64
    !__rwlock_write_no_readers_%out_ok
    !__rwlock_write_readers_%out_ok
    jmp L_RWLOCK_WRITE_NOERR_DONE_%out_ok
L_RWLOCK_WRITE_NOERR_FAIL_%out_ok:
    store __rwlock_write_guard_slot_%out_ok+0, 0 as ptr
    store __rwlock_write_ok_slot_%out_ok+0, 0 as u64
    jmp L_RWLOCK_WRITE_NOERR_DONE_%out_ok
L_RWLOCK_WRITE_NOERR_DONE_%out_ok:
    %out_guard = load __rwlock_write_guard_slot_%out_ok+0 as ptr
    %out_ok = load __rwlock_write_ok_slot_%out_ok+0 as u64
    !__rwlock_write_guard_slot_%out_ok
    !__rwlock_write_ok_slot_%out_ok
    !__rwlock_write_claim_ok_%out_ok
    !__rwlock_write_writing_%out_ok
[END_MACRO]

[MACRO] RWLOCK_TRY_READ %out_ok, %out_guard, %lock_reg, %err_label
    __rwlock_writing_%out_ok = atomic_load %lock_reg+RwLock_writing as i32 acquire
    __rwlock_can_read_%out_ok = eq __rwlock_writing_%out_ok, 0
    br __rwlock_can_read_%out_ok -> L_RWLOCK_TRY_READ_OK_%out_ok, L_RWLOCK_TRY_READ_FAIL_%out_ok
L_RWLOCK_TRY_READ_OK_%out_ok:
    __rwlock_readers_%out_ok = atomic_rmw_add %lock_reg+RwLock_readers, 1 as i32 acq_rel
    __rwlock_after_writing_%out_ok = atomic_load %lock_reg+RwLock_writing as i32 acquire
    __rwlock_still_can_read_%out_ok = eq __rwlock_after_writing_%out_ok, 0
    br __rwlock_still_can_read_%out_ok -> L_RWLOCK_TRY_READ_COMMIT_%out_ok, L_RWLOCK_TRY_READ_ROLLBACK_%out_ok
L_RWLOCK_TRY_READ_COMMIT_%out_ok:
    %out_guard = add %lock_reg, 0
    %out_ok = add 0, 1
    !__rwlock_still_can_read_%out_ok
    !__rwlock_after_writing_%out_ok
    !__rwlock_can_read_%out_ok
    !__rwlock_writing_%out_ok
    !__rwlock_readers_%out_ok
    jmp L_RWLOCK_TRY_READ_END_%out_ok
L_RWLOCK_TRY_READ_ROLLBACK_%out_ok:
    __rwlock_rollback_%out_ok = atomic_rmw_sub %lock_reg+RwLock_readers, 1 as i32 acq_rel
    %out_guard = add 0, 0
    %out_ok = add 0, 0
    !__rwlock_rollback_%out_ok
    !__rwlock_still_can_read_%out_ok
    !__rwlock_after_writing_%out_ok
    !__rwlock_can_read_%out_ok
    !__rwlock_writing_%out_ok
    !__rwlock_readers_%out_ok
    jmp %err_label
L_RWLOCK_TRY_READ_FAIL_%out_ok:
    %out_guard = add 0, 0
    %out_ok = add 0, 0
    !__rwlock_can_read_%out_ok
    !__rwlock_writing_%out_ok
    jmp %err_label
L_RWLOCK_TRY_READ_END_%out_ok:
[END_MACRO]

[MACRO] RWLOCK_TRY_WRITE %out_ok, %out_guard, %lock_reg, %err_label
    __rwlock_writing_%out_ok, __rwlock_claim_ok_%out_ok = cmpxchg %lock_reg+RwLock_writing, 0, 1 as i32 acq_rel acquire
    br __rwlock_claim_ok_%out_ok -> L_RWLOCK_TRY_WRITE_CLAIMED_%out_ok, L_RWLOCK_TRY_WRITE_FAIL_%out_ok
L_RWLOCK_TRY_WRITE_CLAIMED_%out_ok:
    __rwlock_readers_%out_ok = atomic_load %lock_reg+RwLock_readers as i32 acquire
    __rwlock_no_readers_%out_ok = eq __rwlock_readers_%out_ok, 0
    br __rwlock_no_readers_%out_ok -> L_RWLOCK_TRY_WRITE_OK_%out_ok, L_RWLOCK_TRY_WRITE_ROLLBACK_%out_ok
L_RWLOCK_TRY_WRITE_OK_%out_ok:
    %out_guard = add %lock_reg, 0
    %out_ok = add 0, 1
    !__rwlock_no_readers_%out_ok
    !__rwlock_readers_%out_ok
    !__rwlock_writing_%out_ok
    !__rwlock_claim_ok_%out_ok
    jmp L_RWLOCK_TRY_WRITE_END_%out_ok
L_RWLOCK_TRY_WRITE_ROLLBACK_%out_ok:
    atomic_store %lock_reg+RwLock_writing, 0 as i32 release
    %out_guard = add 0, 0
    %out_ok = add 0, 0
    !__rwlock_no_readers_%out_ok
    !__rwlock_readers_%out_ok
    !__rwlock_writing_%out_ok
    !__rwlock_claim_ok_%out_ok
    jmp %err_label
L_RWLOCK_TRY_WRITE_FAIL_%out_ok:
    %out_guard = add 0, 0
    %out_ok = add 0, 0
    !__rwlock_writing_%out_ok
    !__rwlock_claim_ok_%out_ok
    jmp %err_label
L_RWLOCK_TRY_WRITE_END_%out_ok:
[END_MACRO]

[MACRO] RWLOCK_RELEASE_READ %lock_reg
    call @__rwlock_release_read(%lock_reg)
[END_MACRO]

[MACRO] RWLOCK_TRY_RELEASE_READ %out_ok, %lock_reg
L_RWLOCK_TRY_RELEASE_READ_ENTRY_%out_ok:
    __rwlock_try_release_read_state_%out_ok = atomic_load %lock_reg+RwLock_readers as i32 acquire
    __rwlock_try_release_read_has_%out_ok = sgt __rwlock_try_release_read_state_%out_ok, 0
    br __rwlock_try_release_read_has_%out_ok -> L_RWLOCK_TRY_RELEASE_READ_CLAIM_%out_ok, L_RWLOCK_TRY_RELEASE_READ_EMPTY_%out_ok
L_RWLOCK_TRY_RELEASE_READ_CLAIM_%out_ok:
    __rwlock_try_release_read_next_%out_ok = sub __rwlock_try_release_read_state_%out_ok, 1
    __rwlock_try_release_read_old_%out_ok, %out_ok = cmpxchg %lock_reg+RwLock_readers, __rwlock_try_release_read_state_%out_ok, __rwlock_try_release_read_next_%out_ok as i32 acq_rel acquire
    br %out_ok -> L_RWLOCK_TRY_RELEASE_READ_DONE_%out_ok, L_RWLOCK_TRY_RELEASE_READ_RETRY_%out_ok
L_RWLOCK_TRY_RELEASE_READ_RETRY_%out_ok:
    !__rwlock_try_release_read_old_%out_ok
    !__rwlock_try_release_read_next_%out_ok
    !__rwlock_try_release_read_has_%out_ok
    !__rwlock_try_release_read_state_%out_ok
    jmp L_RWLOCK_TRY_RELEASE_READ_ENTRY_%out_ok
L_RWLOCK_TRY_RELEASE_READ_EMPTY_%out_ok:
    %out_ok = add 0, 0
L_RWLOCK_TRY_RELEASE_READ_DONE_%out_ok:
    !__rwlock_try_release_read_old_%out_ok
    !__rwlock_try_release_read_next_%out_ok
    !__rwlock_try_release_read_has_%out_ok
    !__rwlock_try_release_read_state_%out_ok
[END_MACRO]
[MACRO] RWLOCK_RELEASE_WRITE %lock_reg
    atomic_store %lock_reg+RwLock_writing, 0 as i32 release
[END_MACRO]

[MACRO] RWLOCK_TRY_RELEASE_WRITE %out_ok, %lock_reg
    __rwlock_release_state_%out_ok, %out_ok = cmpxchg %lock_reg+RwLock_writing, 1, 0 as i32 acq_rel acquire
    !__rwlock_release_state_%out_ok
[END_MACRO]

[MACRO] RWLOCK_FORCE_UNLOCKED %lock_reg
    atomic_store %lock_reg+RwLock_readers, 0 as i32 release
    atomic_store %lock_reg+RwLock_writing, 0 as i32 release
[END_MACRO]

[MACRO] RWLOCK_DEFAULT %out_lock
    EXPAND RWLOCK_NEW %out_lock
[END_MACRO]


@__rwlock_lock_read_spin(lock: ptr) -> void:
L_ENTRY:
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64
    jmp L_TRY
L_TRY:
    writing = atomic_load lock+RwLock_writing as i32 acquire
    busy = ne writing, 0
    !writing
    br busy -> L_BUSY_WAIT, L_CLAIM
L_BUSY_WAIT:
    !busy
    jmp L_WAIT
L_CLAIM:
    !busy
    old = atomic_rmw_add lock+RwLock_readers, 1 as i32 acq_rel
    writing2 = atomic_load lock+RwLock_writing as i32 acquire
    still_busy = ne writing2, 0
    !writing2
    !old
    br still_busy -> L_ROLLBACK, L_DONE
L_ROLLBACK:
    rolled = atomic_rmw_sub lock+RwLock_readers, 1 as i32 acq_rel
    !rolled
    !still_busy
    jmp L_WAIT
L_WAIT:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    at_limit = uge backoff_ns, 1024
    br at_limit -> L_KEEP, L_GROW
L_GROW:
    next = shl backoff_ns, 1
    store backoff_slot+0, next as u64
    !next
    !at_limit
    !backoff_ns
    jmp L_TRY
L_KEEP:
    !at_limit
    !backoff_ns
    jmp L_TRY
L_DONE:
    !still_busy
    !lock
    return

@__rwlock_lock_write_spin(lock: ptr) -> void:
L_ENTRY:
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64
    jmp L_WTRY
L_WTRY:
    old_w, ok = cmpxchg lock+RwLock_writing, 0, 1 as i32 acq_rel acquire
    br ok -> L_WCHECK, L_WFAIL
L_WFAIL:
    !ok
    !old_w
    jmp L_WWAIT
L_WCHECK:
    !ok
    !old_w
    readers = atomic_load lock+RwLock_readers as i32 acquire
    no_readers = eq readers, 0
    !readers
    br no_readers -> L_WDONE, L_WABORT
L_WABORT:
    atomic_store lock+RwLock_writing, 0 as i32 release
    !no_readers
    jmp L_WWAIT
L_WWAIT:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    at_limit = uge backoff_ns, 1024
    br at_limit -> L_WKEEP, L_WGROW
L_WGROW:
    next = shl backoff_ns, 1
    store backoff_slot+0, next as u64
    !next
    !at_limit
    !backoff_ns
    jmp L_WTRY
L_WKEEP:
    !at_limit
    !backoff_ns
    jmp L_WTRY
L_WDONE:
    !no_readers
    !lock
    return

[MACRO] RWLOCK_READ %lock_reg
    call @__rwlock_lock_read_spin(%lock_reg)
[END_MACRO]

[MACRO] RWLOCK_WRITE %lock_reg
    call @__rwlock_lock_write_spin(%lock_reg)
[END_MACRO]

[MACRO] RWLOCK_LOCK_READ %lock_reg
    EXPAND RWLOCK_READ %lock_reg
[END_MACRO]

[MACRO] RWLOCK_LOCK_WRITE %lock_reg
    EXPAND RWLOCK_WRITE %lock_reg
[END_MACRO]
