[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_MUT_PTR %hasher, %ptr
    EXPAND DEFAULT_HASHER_WRITE_PTR %hasher, %ptr
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_UNIT %hasher, %unit
    __hasher_unit_noop_%hasher = add %unit, 0
    !__hasher_unit_noop_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_REF_U64 %hasher, %ptr
    __hasher_ref_u64_value_%hasher = load %ptr+0 as u64
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __hasher_ref_u64_value_%hasher
    !__hasher_ref_u64_value_%hasher
[END_MACRO]

