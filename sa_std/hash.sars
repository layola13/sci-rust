[MACRO] DEFAULT_HASHER_WRITE_BYTES %hasher, %slice_reg
    __hasher_bytes_ptr_%hasher = load %slice_reg+Slice_ptr as ptr
    __hasher_bytes_len_%hasher = load %slice_reg+Slice_len as u64
    __hasher_bytes_idx_slot_%hasher = stack_alloc 8
    store __hasher_bytes_idx_slot_%hasher+0, 0 as u64
    jmp L_HASHER_WRITE_BYTES_HEAD_%hasher

L_HASHER_WRITE_BYTES_HEAD_%hasher:
    __hasher_bytes_idx_%hasher = load __hasher_bytes_idx_slot_%hasher+0 as u64
    __hasher_bytes_done_%hasher = eq __hasher_bytes_idx_%hasher, __hasher_bytes_len_%hasher
    br __hasher_bytes_done_%hasher -> L_HASHER_WRITE_BYTES_DONE_%hasher, L_HASHER_WRITE_BYTES_BODY_%hasher

L_HASHER_WRITE_BYTES_BODY_%hasher:
    __hasher_bytes_item_%hasher = ptr_add __hasher_bytes_ptr_%hasher, __hasher_bytes_idx_%hasher
    __hasher_bytes_value_%hasher = load __hasher_bytes_item_%hasher+0 as u8
    EXPAND DEFAULT_HASHER_WRITE_U8 %hasher, __hasher_bytes_value_%hasher
    __hasher_bytes_next_%hasher = add __hasher_bytes_idx_%hasher, 1
    store __hasher_bytes_idx_slot_%hasher+0, __hasher_bytes_next_%hasher as u64
    !__hasher_bytes_next_%hasher
    !__hasher_bytes_value_%hasher
    !__hasher_bytes_item_%hasher
    !__hasher_bytes_done_%hasher
    !__hasher_bytes_idx_%hasher
    jmp L_HASHER_WRITE_BYTES_HEAD_%hasher

L_HASHER_WRITE_BYTES_DONE_%hasher:
    !__hasher_bytes_done_%hasher
    !__hasher_bytes_idx_%hasher
    !__hasher_bytes_len_%hasher
    !__hasher_bytes_ptr_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE %hasher, %slice_reg
    EXPAND DEFAULT_HASHER_WRITE_BYTES %hasher, %slice_reg
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_STR %hasher, %slice_reg
    EXPAND DEFAULT_HASHER_WRITE_BYTES %hasher, %slice_reg
    EXPAND DEFAULT_HASHER_WRITE_U8 %hasher, 255
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_SLICE_U8 %hasher, %slice_reg
    __hasher_u8_slice_len_%hasher = load %slice_reg+Slice_len as u64
    EXPAND DEFAULT_HASHER_WRITE_LENGTH_PREFIX %hasher, __hasher_u8_slice_len_%hasher
    EXPAND DEFAULT_HASHER_WRITE_BYTES %hasher, %slice_reg
    !__hasher_u8_slice_len_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_SLICE_U64 %hasher, %slice_reg
    __hasher_u64_slice_ptr_%hasher = load %slice_reg+Slice_ptr as ptr
    __hasher_u64_slice_len_%hasher = load %slice_reg+Slice_len as u64
    __hasher_u64_slice_idx_slot_%hasher = stack_alloc 8
    EXPAND DEFAULT_HASHER_WRITE_LENGTH_PREFIX %hasher, __hasher_u64_slice_len_%hasher
    store __hasher_u64_slice_idx_slot_%hasher+0, 0 as u64
    jmp L_HASHER_WRITE_SLICE_U64_HEAD_%hasher

L_HASHER_WRITE_SLICE_U64_HEAD_%hasher:
    __hasher_u64_slice_idx_%hasher = load __hasher_u64_slice_idx_slot_%hasher+0 as u64
    __hasher_u64_slice_done_%hasher = eq __hasher_u64_slice_idx_%hasher, __hasher_u64_slice_len_%hasher
    br __hasher_u64_slice_done_%hasher -> L_HASHER_WRITE_SLICE_U64_DONE_%hasher, L_HASHER_WRITE_SLICE_U64_BODY_%hasher

L_HASHER_WRITE_SLICE_U64_BODY_%hasher:
    __hasher_u64_slice_off_%hasher = mul __hasher_u64_slice_idx_%hasher, 8
    __hasher_u64_slice_item_%hasher = ptr_add __hasher_u64_slice_ptr_%hasher, __hasher_u64_slice_off_%hasher
    __hasher_u64_slice_value_%hasher = load __hasher_u64_slice_item_%hasher+0 as u64
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __hasher_u64_slice_value_%hasher
    __hasher_u64_slice_next_%hasher = add __hasher_u64_slice_idx_%hasher, 1
    store __hasher_u64_slice_idx_slot_%hasher+0, __hasher_u64_slice_next_%hasher as u64
    !__hasher_u64_slice_next_%hasher
    !__hasher_u64_slice_value_%hasher
    !__hasher_u64_slice_item_%hasher
    !__hasher_u64_slice_off_%hasher
    !__hasher_u64_slice_done_%hasher
    !__hasher_u64_slice_idx_%hasher
    jmp L_HASHER_WRITE_SLICE_U64_HEAD_%hasher

L_HASHER_WRITE_SLICE_U64_DONE_%hasher:
    !__hasher_u64_slice_done_%hasher
    !__hasher_u64_slice_idx_%hasher
    !__hasher_u64_slice_len_%hasher
    !__hasher_u64_slice_ptr_%hasher
[END_MACRO]

// Rust method-name alias over DEFAULT_HASHER_WRITE_SLICE_U64.
[MACRO] DEFAULT_HASHER_WRITE_SLICE %hasher, %slice_reg
