@import "option.sal"
@import "result.sal"
@import "slice.sal"
@import "panic.sars"

@const OPTION_UNWRAP_PANIC = utf8:"called Option::unwrap() on a None value"

[MACRO] OPTION_NEW_NONE %out_opt
    %out_opt = alloc Option_SIZE
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
[END_MACRO]

[MACRO] OPTION_NEW_SOME %out_opt, %value
    %out_opt = alloc Option_SIZE
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, %value as u64
[END_MACRO]

// Rust constructor-name bare alias over OPTION_NEW_SOME.
[MACRO] OPTION_SOME %out_opt, %value
    EXPAND OPTION_NEW_SOME %out_opt, %value
[END_MACRO]

// Rust constructor-name bare alias over OPTION_NEW_NONE.
[MACRO] OPTION_NONE %out_opt
    EXPAND OPTION_NEW_NONE %out_opt
[END_MACRO]

[MACRO] OPTION_IS_SOME %out_bool, %opt_reg
    __option_tag_%out_bool = load %opt_reg+Option_tag as u64
    %out_bool = eq __option_tag_%out_bool, Option_SOME
    !__option_tag_%out_bool
[END_MACRO]

[MACRO] OPTION_IS_NONE %out_bool, %opt_reg
    __option_tag_%out_bool = load %opt_reg+Option_tag as u64
    %out_bool = eq __option_tag_%out_bool, Option_NONE
    !__option_tag_%out_bool
[END_MACRO]

[MACRO] OPTION_GET %out_value, %opt_reg
    %out_value = load %opt_reg+Option_value as u64
[END_MACRO]

[MACRO] OPTION_AS_REF %out_opt, %opt_reg
    %out_opt = alloc Option_SIZE
    __option_as_ref_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_as_ref_some_%out_opt = eq __option_as_ref_tag_%out_opt, Option_SOME
    br __option_as_ref_some_%out_opt -> L_OPTION_AS_REF_SOME_%out_opt, L_OPTION_AS_REF_NONE_%out_opt
L_OPTION_AS_REF_SOME_%out_opt:
    __option_as_ref_ptr_%out_opt = ptr_add %opt_reg, Option_value
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __option_as_ref_ptr_%out_opt as ptr
    !__option_as_ref_ptr_%out_opt
    !__option_as_ref_some_%out_opt
    !__option_as_ref_tag_%out_opt
    jmp L_OPTION_AS_REF_END_%out_opt
L_OPTION_AS_REF_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
    !__option_as_ref_some_%out_opt
    !__option_as_ref_tag_%out_opt
L_OPTION_AS_REF_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_AS_MUT %out_opt, %opt_reg
    EXPAND OPTION_AS_REF %out_opt, %opt_reg
[END_MACRO]

[MACRO] OPTION_COPIED_U64 %out_opt, %opt_reg
    %out_opt = alloc Option_SIZE
    __option_copied_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_copied_some_%out_opt = eq __option_copied_tag_%out_opt, Option_SOME
    br __option_copied_some_%out_opt -> L_OPTION_COPIED_SOME_%out_opt, L_OPTION_COPIED_NONE_%out_opt
L_OPTION_COPIED_SOME_%out_opt:
    __option_copied_ptr_%out_opt = load %opt_reg+Option_value as ptr
    __option_copied_value_%out_opt = load __option_copied_ptr_%out_opt+0 as u64
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __option_copied_value_%out_opt as u64
    !__option_copied_value_%out_opt
    !__option_copied_ptr_%out_opt
    !__option_copied_some_%out_opt
    !__option_copied_tag_%out_opt
    jmp L_OPTION_COPIED_END_%out_opt
L_OPTION_COPIED_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
    !__option_copied_some_%out_opt
    !__option_copied_tag_%out_opt
L_OPTION_COPIED_END_%out_opt:
[END_MACRO]

// Rust method-name alias over OPTION_COPIED_U64.
[MACRO] OPTION_COPIED %out_opt, %opt_reg
    EXPAND OPTION_COPIED_U64 %out_opt, %opt_reg
[END_MACRO]

[MACRO] OPTION_CLONED_U64 %out_opt, %opt_reg
    EXPAND OPTION_COPIED_U64 %out_opt, %opt_reg
[END_MACRO]

// Rust method-name alias over OPTION_CLONED_U64.
[MACRO] OPTION_CLONED %out_opt, %opt_reg
    EXPAND OPTION_CLONED_U64 %out_opt, %opt_reg
[END_MACRO]

[MACRO] OPTION_AS_SLICE %out_slice, %opt_reg
    %out_slice = alloc Slice_SIZE
    __option_slice_tag_%out_slice = load %opt_reg+Option_tag as u64
    __option_slice_len_%out_slice = eq __option_slice_tag_%out_slice, Option_SOME
    __option_slice_ptr_%out_slice = ptr_add %opt_reg, Option_value
    store %out_slice+Slice_ptr, __option_slice_ptr_%out_slice as ptr
    store %out_slice+Slice_len, __option_slice_len_%out_slice as u64
    !__option_slice_ptr_%out_slice
    !__option_slice_len_%out_slice
    !__option_slice_tag_%out_slice
[END_MACRO]

[MACRO] OPTION_AS_MUT_SLICE %out_slice, %opt_reg
    EXPAND OPTION_AS_SLICE %out_slice, %opt_reg
[END_MACRO]

[MACRO] OPTION_COPY %out_opt, %opt_reg
    %out_opt = alloc Option_SIZE
    __option_copy_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_copy_value_%out_opt = load %opt_reg+Option_value as u64
    store %out_opt+Option_tag, __option_copy_tag_%out_opt as u64
    store %out_opt+Option_value, __option_copy_value_%out_opt as u64
    !__option_copy_value_%out_opt
    !__option_copy_tag_%out_opt
[END_MACRO]

[MACRO] OPTION_CONTAINS_U64 %out_bool, %opt_reg, %value
    __option_contains_tag_%out_bool = load %opt_reg+Option_tag as u64
    __option_contains_some_%out_bool = eq __option_contains_tag_%out_bool, Option_SOME
    br __option_contains_some_%out_bool -> L_OPTION_CONTAINS_SOME_%out_bool, L_OPTION_CONTAINS_NONE_%out_bool
L_OPTION_CONTAINS_SOME_%out_bool:
    __option_contains_value_%out_bool = load %opt_reg+Option_value as u64
    %out_bool = eq __option_contains_value_%out_bool, %value
    !__option_contains_value_%out_bool
    !__option_contains_some_%out_bool
    !__option_contains_tag_%out_bool
    jmp L_OPTION_CONTAINS_END_%out_bool
L_OPTION_CONTAINS_NONE_%out_bool:
    %out_bool = add 0, 0
    !__option_contains_some_%out_bool
    !__option_contains_tag_%out_bool
L_OPTION_CONTAINS_END_%out_bool:
[END_MACRO]

// Rust method-name alias over OPTION_CONTAINS_U64.
[MACRO] OPTION_CONTAINS %out_bool, %opt_reg, %value
    EXPAND OPTION_CONTAINS_U64 %out_bool, %opt_reg, %value
[END_MACRO]

[MACRO] OPTION_IS_SOME_AND %out_bool, %opt_reg, %pred_fn
    __option_some_and_tag_%out_bool = load %opt_reg+Option_tag as u64
    __option_some_and_some_%out_bool = eq __option_some_and_tag_%out_bool, Option_SOME
    br __option_some_and_some_%out_bool -> L_OPTION_SOME_AND_SOME_%out_bool, L_OPTION_SOME_AND_NONE_%out_bool
L_OPTION_SOME_AND_SOME_%out_bool:
    __option_some_and_value_%out_bool = load %opt_reg+Option_value as u64
    __option_some_and_pred_%out_bool = call %pred_fn(__option_some_and_value_%out_bool)
    %out_bool = ne __option_some_and_pred_%out_bool, 0
    !__option_some_and_pred_%out_bool
    !__option_some_and_value_%out_bool
    !__option_some_and_some_%out_bool
    !__option_some_and_tag_%out_bool
    jmp L_OPTION_SOME_AND_END_%out_bool
L_OPTION_SOME_AND_NONE_%out_bool:
    %out_bool = add 0, 0
    !__option_some_and_some_%out_bool
    !__option_some_and_tag_%out_bool
L_OPTION_SOME_AND_END_%out_bool:
[END_MACRO]

[MACRO] OPTION_IS_NONE_OR %out_bool, %opt_reg, %pred_fn
    __option_none_or_tag_%out_bool = load %opt_reg+Option_tag as u64
    __option_none_or_some_%out_bool = eq __option_none_or_tag_%out_bool, Option_SOME
    br __option_none_or_some_%out_bool -> L_OPTION_NONE_OR_SOME_%out_bool, L_OPTION_NONE_OR_NONE_%out_bool
L_OPTION_NONE_OR_SOME_%out_bool:
    __option_none_or_value_%out_bool = load %opt_reg+Option_value as u64
    __option_none_or_pred_%out_bool = call %pred_fn(__option_none_or_value_%out_bool)
    %out_bool = ne __option_none_or_pred_%out_bool, 0
    !__option_none_or_pred_%out_bool
    !__option_none_or_value_%out_bool
    !__option_none_or_some_%out_bool
    !__option_none_or_tag_%out_bool
    jmp L_OPTION_NONE_OR_END_%out_bool
L_OPTION_NONE_OR_NONE_%out_bool:
    %out_bool = add 0, 1
    !__option_none_or_some_%out_bool
    !__option_none_or_tag_%out_bool
L_OPTION_NONE_OR_END_%out_bool:
[END_MACRO]

[MACRO] OPTION_MAP %out_opt, %opt_reg, %map_fn
    %out_opt = alloc Option_SIZE
    __option_map_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_map_some_%out_opt = eq __option_map_tag_%out_opt, Option_SOME
    br __option_map_some_%out_opt -> L_OPTION_MAP_SOME_%out_opt, L_OPTION_MAP_NONE_%out_opt
L_OPTION_MAP_SOME_%out_opt:
    __option_map_value_%out_opt = load %opt_reg+Option_value as u64
    __option_map_mapped_%out_opt = call %map_fn(__option_map_value_%out_opt)
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __option_map_mapped_%out_opt as u64
    !__option_map_mapped_%out_opt
    !__option_map_value_%out_opt
    !__option_map_some_%out_opt
    !__option_map_tag_%out_opt
    jmp L_OPTION_MAP_END_%out_opt
L_OPTION_MAP_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
    !__option_map_some_%out_opt
    !__option_map_tag_%out_opt
L_OPTION_MAP_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_INSPECT %out_opt, %opt_reg, %inspect_fn
    __option_inspect_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_inspect_some_%out_opt = eq __option_inspect_tag_%out_opt, Option_SOME
    br __option_inspect_some_%out_opt -> L_OPTION_INSPECT_SOME_%out_opt, L_OPTION_INSPECT_NONE_%out_opt
L_OPTION_INSPECT_SOME_%out_opt:
    __option_inspect_value_%out_opt = load %opt_reg+Option_value as u64
    __option_inspect_ignored_%out_opt = call %inspect_fn(__option_inspect_value_%out_opt)
    !__option_inspect_ignored_%out_opt
    !__option_inspect_value_%out_opt
    jmp L_OPTION_INSPECT_COPY_%out_opt
L_OPTION_INSPECT_NONE_%out_opt:
    jmp L_OPTION_INSPECT_COPY_%out_opt
L_OPTION_INSPECT_COPY_%out_opt:
    EXPAND OPTION_COPY %out_opt, %opt_reg
    !__option_inspect_some_%out_opt
    !__option_inspect_tag_%out_opt
[END_MACRO]

[MACRO] OPTION_FILTER %out_opt, %opt_reg, %pred_fn
    %out_opt = alloc Option_SIZE
    __option_filter_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_filter_some_%out_opt = eq __option_filter_tag_%out_opt, Option_SOME
    br __option_filter_some_%out_opt -> L_OPTION_FILTER_CHECK_%out_opt, L_OPTION_FILTER_NONE_%out_opt
L_OPTION_FILTER_CHECK_%out_opt:
    __option_filter_value_%out_opt = load %opt_reg+Option_value as u64
    __option_filter_pred_%out_opt = call %pred_fn(__option_filter_value_%out_opt)
    __option_filter_keep_%out_opt = ne __option_filter_pred_%out_opt, 0
    br __option_filter_keep_%out_opt -> L_OPTION_FILTER_KEEP_%out_opt, L_OPTION_FILTER_DROP_%out_opt
L_OPTION_FILTER_KEEP_%out_opt:
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __option_filter_value_%out_opt as u64
    jmp L_OPTION_FILTER_CHECK_DONE_%out_opt
L_OPTION_FILTER_DROP_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
    jmp L_OPTION_FILTER_CHECK_DONE_%out_opt
L_OPTION_FILTER_CHECK_DONE_%out_opt:
    !__option_filter_keep_%out_opt
    !__option_filter_pred_%out_opt
    !__option_filter_value_%out_opt
    !__option_filter_some_%out_opt
    !__option_filter_tag_%out_opt
    jmp L_OPTION_FILTER_END_%out_opt
L_OPTION_FILTER_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
    !__option_filter_some_%out_opt
    !__option_filter_tag_%out_opt
L_OPTION_FILTER_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_AND %out_opt, %opt_reg, %other_opt
    __option_and_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_and_some_%out_opt = eq __option_and_tag_%out_opt, Option_SOME
    br __option_and_some_%out_opt -> L_OPTION_AND_OTHER_%out_opt, L_OPTION_AND_NONE_%out_opt
L_OPTION_AND_OTHER_%out_opt:
    EXPAND OPTION_COPY %out_opt, %other_opt
    !__option_and_some_%out_opt
    !__option_and_tag_%out_opt
    jmp L_OPTION_AND_END_%out_opt
L_OPTION_AND_NONE_%out_opt:
    EXPAND OPTION_NEW_NONE %out_opt
    !__option_and_some_%out_opt
    !__option_and_tag_%out_opt
L_OPTION_AND_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_OR %out_opt, %opt_reg, %other_opt
    __option_or_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_or_some_%out_opt = eq __option_or_tag_%out_opt, Option_SOME
    br __option_or_some_%out_opt -> L_OPTION_OR_SELF_%out_opt, L_OPTION_OR_OTHER_%out_opt
L_OPTION_OR_SELF_%out_opt:
    EXPAND OPTION_COPY %out_opt, %opt_reg
    !__option_or_some_%out_opt
    !__option_or_tag_%out_opt
    jmp L_OPTION_OR_END_%out_opt
L_OPTION_OR_OTHER_%out_opt:
    EXPAND OPTION_COPY %out_opt, %other_opt
    !__option_or_some_%out_opt
    !__option_or_tag_%out_opt
L_OPTION_OR_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_XOR %out_opt, %left_opt, %right_opt
    %out_opt = alloc Option_SIZE
    __option_xor_left_tag_%out_opt = load %left_opt+Option_tag as u64
    __option_xor_right_tag_%out_opt = load %right_opt+Option_tag as u64
    __option_xor_left_some_%out_opt = eq __option_xor_left_tag_%out_opt, Option_SOME
    __option_xor_right_some_%out_opt = eq __option_xor_right_tag_%out_opt, Option_SOME
    __option_xor_one_%out_opt = xor __option_xor_left_some_%out_opt, __option_xor_right_some_%out_opt
    br __option_xor_one_%out_opt -> L_OPTION_XOR_SOME_%out_opt, L_OPTION_XOR_NONE_%out_opt
L_OPTION_XOR_SOME_%out_opt:
    br __option_xor_left_some_%out_opt -> L_OPTION_XOR_LEFT_%out_opt, L_OPTION_XOR_RIGHT_%out_opt
L_OPTION_XOR_LEFT_%out_opt:
    __option_xor_left_value_%out_opt = load %left_opt+Option_value as u64
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __option_xor_left_value_%out_opt as u64
    !__option_xor_left_value_%out_opt
    jmp L_OPTION_XOR_SOME_DONE_%out_opt
L_OPTION_XOR_RIGHT_%out_opt:
    __option_xor_right_value_%out_opt = load %right_opt+Option_value as u64
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __option_xor_right_value_%out_opt as u64
    !__option_xor_right_value_%out_opt
L_OPTION_XOR_SOME_DONE_%out_opt:
    jmp L_OPTION_XOR_DONE_%out_opt
L_OPTION_XOR_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
L_OPTION_XOR_DONE_%out_opt:
    !__option_xor_one_%out_opt
    !__option_xor_right_some_%out_opt
    !__option_xor_left_some_%out_opt
    !__option_xor_right_tag_%out_opt
    !__option_xor_left_tag_%out_opt
[END_MACRO]

[MACRO] OPTION_AND_THEN %out_opt, %opt_reg, %then_fn
    __option_then_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_then_some_%out_opt = eq __option_then_tag_%out_opt, Option_SOME
    br __option_then_some_%out_opt -> L_OPTION_AND_THEN_SOME_%out_opt, L_OPTION_AND_THEN_NONE_%out_opt
L_OPTION_AND_THEN_SOME_%out_opt:
    __option_then_value_%out_opt = load %opt_reg+Option_value as u64
    %out_opt = call %then_fn(__option_then_value_%out_opt)
    !__option_then_value_%out_opt
    !__option_then_some_%out_opt
    !__option_then_tag_%out_opt
    jmp L_OPTION_AND_THEN_END_%out_opt
L_OPTION_AND_THEN_NONE_%out_opt:
    EXPAND OPTION_NEW_NONE %out_opt
    !__option_then_some_%out_opt
    !__option_then_tag_%out_opt
L_OPTION_AND_THEN_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_OR_ELSE %out_opt, %opt_reg, %else_fn
    __option_or_else_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_or_else_some_%out_opt = eq __option_or_else_tag_%out_opt, Option_SOME
    br __option_or_else_some_%out_opt -> L_OPTION_OR_ELSE_SELF_%out_opt, L_OPTION_OR_ELSE_DEFAULT_%out_opt
L_OPTION_OR_ELSE_SELF_%out_opt:
    EXPAND OPTION_COPY %out_opt, %opt_reg
    !__option_or_else_some_%out_opt
    !__option_or_else_tag_%out_opt
    jmp L_OPTION_OR_ELSE_END_%out_opt
L_OPTION_OR_ELSE_DEFAULT_%out_opt:
    %out_opt = call %else_fn()
    !__option_or_else_some_%out_opt
    !__option_or_else_tag_%out_opt
L_OPTION_OR_ELSE_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_OK_OR %out_res, %opt_reg, %err_value
    %out_res = alloc Result_SIZE
    __option_ok_or_tag_%out_res = load %opt_reg+Option_tag as u64
    __option_ok_or_some_%out_res = eq __option_ok_or_tag_%out_res, Option_SOME
    br __option_ok_or_some_%out_res -> L_OPTION_OK_OR_SOME_%out_res, L_OPTION_OK_OR_NONE_%out_res
L_OPTION_OK_OR_SOME_%out_res:
    __option_ok_or_value_%out_res = load %opt_reg+Option_value as u64
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, __option_ok_or_value_%out_res as u64
    store %out_res+Result_err, 0 as u64
    !__option_ok_or_value_%out_res
    !__option_ok_or_some_%out_res
    !__option_ok_or_tag_%out_res
    jmp L_OPTION_OK_OR_END_%out_res
L_OPTION_OK_OR_NONE_%out_res:
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, %err_value as u64
    !__option_ok_or_some_%out_res
    !__option_ok_or_tag_%out_res
L_OPTION_OK_OR_END_%out_res:
[END_MACRO]

[MACRO] OPTION_OK_OR_ELSE %out_res, %opt_reg, %err_fn
    %out_res = alloc Result_SIZE
    __option_ok_or_else_tag_%out_res = load %opt_reg+Option_tag as u64
    __option_ok_or_else_some_%out_res = eq __option_ok_or_else_tag_%out_res, Option_SOME
    br __option_ok_or_else_some_%out_res -> L_OPTION_OK_OR_ELSE_SOME_%out_res, L_OPTION_OK_OR_ELSE_NONE_%out_res
L_OPTION_OK_OR_ELSE_SOME_%out_res:
    __option_ok_or_else_value_%out_res = load %opt_reg+Option_value as u64
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, __option_ok_or_else_value_%out_res as u64
    store %out_res+Result_err, 0 as u64
    !__option_ok_or_else_value_%out_res
    !__option_ok_or_else_some_%out_res
    !__option_ok_or_else_tag_%out_res
    jmp L_OPTION_OK_OR_ELSE_END_%out_res
L_OPTION_OK_OR_ELSE_NONE_%out_res:
    __option_ok_or_else_err_%out_res = call %err_fn()
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __option_ok_or_else_err_%out_res as u64
    !__option_ok_or_else_err_%out_res
    !__option_ok_or_else_some_%out_res
    !__option_ok_or_else_tag_%out_res
L_OPTION_OK_OR_ELSE_END_%out_res:
[END_MACRO]

[MACRO] OPTION_UNWRAP_OR %out_value, %opt_reg, %default_value
    __option_tag_%out_value = load %opt_reg+Option_tag as u64
    br __option_tag_%out_value -> L_OPTION_UNWRAP_OR_SOME_%out_value, L_OPTION_UNWRAP_OR_NONE_%out_value
L_OPTION_UNWRAP_OR_SOME_%out_value:
    %out_value = load %opt_reg+Option_value as u64
