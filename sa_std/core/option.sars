    __option_get_or_with_tag_%out_ptr = load %opt_reg+Option_tag as u64
    __option_get_or_with_some_%out_ptr = eq __option_get_or_with_tag_%out_ptr, Option_SOME
    br __option_get_or_with_some_%out_ptr -> L_OPTION_GET_OR_WITH_DONE_%out_ptr, L_OPTION_GET_OR_WITH_SET_%out_ptr
L_OPTION_GET_OR_WITH_SET_%out_ptr:
    __option_get_or_with_value_%out_ptr = call %default_fn()
