    !__option_flatten_tag_%out_opt
    jmp L_OPTION_FLATTEN_END_%out_opt
L_OPTION_FLATTEN_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
