[MACRO] OPTION_FLATTEN %out_opt, %opt_reg
    %out_opt = alloc Option_SIZE
    __option_flatten_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_flatten_some_%out_opt = eq __option_flatten_tag_%out_opt, Option_SOME
    br __option_flatten_some_%out_opt -> L_OPTION_FLATTEN_SOME_%out_opt, L_OPTION_FLATTEN_NONE_%out_opt
L_OPTION_FLATTEN_SOME_%out_opt:
    __option_flatten_inner_%out_opt = load %opt_reg+Option_value as ptr
    __option_flatten_inner_tag_%out_opt = load __option_flatten_inner_%out_opt+Option_tag as u64
    __option_flatten_inner_value_%out_opt = load __option_flatten_inner_%out_opt+Option_value as u64
    store %out_opt+Option_tag, __option_flatten_inner_tag_%out_opt as u64
    store %out_opt+Option_value, __option_flatten_inner_value_%out_opt as u64
