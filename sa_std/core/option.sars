    !__option_flatten_tag_%out_opt
L_OPTION_FLATTEN_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_TRANSPOSE %out_res, %opt_reg
    %out_res = alloc Result_SIZE
    __option_transpose_tag_%out_res = load %opt_reg+Option_tag as u64
    __option_transpose_some_%out_res = eq __option_transpose_tag_%out_res, Option_SOME
    br __option_transpose_some_%out_res -> L_OPTION_TRANSPOSE_SOME_%out_res, L_OPTION_TRANSPOSE_NONE_%out_res
L_OPTION_TRANSPOSE_SOME_%out_res:
    __option_transpose_inner_res_%out_res = load %opt_reg+Option_value as ptr
    __option_transpose_inner_tag_%out_res = load __option_transpose_inner_res_%out_res+Result_tag as u64
    __option_transpose_inner_ok_%out_res = eq __option_transpose_inner_tag_%out_res, Result_OK
    br __option_transpose_inner_ok_%out_res -> L_OPTION_TRANSPOSE_OK_%out_res, L_OPTION_TRANSPOSE_ERR_%out_res
L_OPTION_TRANSPOSE_OK_%out_res:
    __option_transpose_ok_value_%out_res = load __option_transpose_inner_res_%out_res+Result_ok as u64
    __option_transpose_ok_opt_%out_res = alloc Option_SIZE
    store __option_transpose_ok_opt_%out_res+Option_tag, Option_SOME as u64
    store __option_transpose_ok_opt_%out_res+Option_value, __option_transpose_ok_value_%out_res as u64
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, __option_transpose_ok_opt_%out_res as ptr
    store %out_res+Result_err, 0 as u64
    !__option_transpose_ok_opt_%out_res
    !__option_transpose_ok_value_%out_res
    !__option_transpose_inner_ok_%out_res
    !__option_transpose_inner_tag_%out_res
    !__option_transpose_inner_res_%out_res
    !__option_transpose_some_%out_res
    !__option_transpose_tag_%out_res
    jmp L_OPTION_TRANSPOSE_END_%out_res
L_OPTION_TRANSPOSE_ERR_%out_res:
    __option_transpose_err_value_%out_res = load __option_transpose_inner_res_%out_res+Result_err as u64
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __option_transpose_err_value_%out_res as u64
    !__option_transpose_err_value_%out_res
    !__option_transpose_inner_ok_%out_res
    !__option_transpose_inner_tag_%out_res
    !__option_transpose_inner_res_%out_res
