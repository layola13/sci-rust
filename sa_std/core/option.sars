[MACRO] OPTION_TAKE_IF %out_opt, %opt_reg, %pred_fn
    __option_take_if_tag_%out_opt = load %opt_reg+Option_tag as u64
    __option_take_if_some_%out_opt = eq __option_take_if_tag_%out_opt, Option_SOME
    br __option_take_if_some_%out_opt -> L_OPTION_TAKE_IF_CHECK_%out_opt, L_OPTION_TAKE_IF_NONE_%out_opt
L_OPTION_TAKE_IF_CHECK_%out_opt:
    __option_take_if_value_%out_opt = load %opt_reg+Option_value as u64
    __option_take_if_pred_%out_opt = call %pred_fn(__option_take_if_value_%out_opt)
    __option_take_if_take_%out_opt = ne __option_take_if_pred_%out_opt, 0
    br __option_take_if_take_%out_opt -> L_OPTION_TAKE_IF_TAKE_%out_opt, L_OPTION_TAKE_IF_KEEP_%out_opt
L_OPTION_TAKE_IF_TAKE_%out_opt:
    EXPAND OPTION_NEW_SOME %out_opt, __option_take_if_value_%out_opt
    EXPAND OPTION_SET_NONE %opt_reg
    jmp L_OPTION_TAKE_IF_CHECK_DONE_%out_opt
L_OPTION_TAKE_IF_KEEP_%out_opt:
    EXPAND OPTION_NEW_NONE %out_opt
    jmp L_OPTION_TAKE_IF_CHECK_DONE_%out_opt
L_OPTION_TAKE_IF_CHECK_DONE_%out_opt:
    !__option_take_if_take_%out_opt
    !__option_take_if_pred_%out_opt
    !__option_take_if_value_%out_opt
    !__option_take_if_some_%out_opt
    !__option_take_if_tag_%out_opt
    jmp L_OPTION_TAKE_IF_END_%out_opt
L_OPTION_TAKE_IF_NONE_%out_opt:
    EXPAND OPTION_NEW_NONE %out_opt
    !__option_take_if_some_%out_opt
    !__option_take_if_tag_%out_opt
L_OPTION_TAKE_IF_END_%out_opt:
[END_MACRO]

[MACRO] OPTION_REPLACE %out_opt, %opt_reg, %value
