    __slice_ub_len_%out_index = load %slice_reg+Slice_len as u64
    __slice_ub_left_slot_%out_index = stack_alloc 8
    __slice_ub_right_slot_%out_index = stack_alloc 8
    store __slice_ub_left_slot_%out_index+0, 0 as u64
    store __slice_ub_right_slot_%out_index+0, __slice_ub_len_%out_index as u64
    jmp L_SLICE_UB_HEAD_%out_index

L_SLICE_UB_HEAD_%out_index:
    __slice_ub_left_%out_index = load __slice_ub_left_slot_%out_index+0 as u64
    __slice_ub_right_%out_index = load __slice_ub_right_slot_%out_index+0 as u64
    __slice_ub_continue_%out_index = ult __slice_ub_left_%out_index, __slice_ub_right_%out_index
    br __slice_ub_continue_%out_index -> L_SLICE_UB_BODY_%out_index, L_SLICE_UB_DONE_%out_index

L_SLICE_UB_BODY_%out_index:
    __slice_ub_span_%out_index = sub __slice_ub_right_%out_index, __slice_ub_left_%out_index
    __slice_ub_half_%out_index = udiv __slice_ub_span_%out_index, 2
    __slice_ub_mid_%out_index = add __slice_ub_left_%out_index, __slice_ub_half_%out_index
    __slice_ub_mid_off_%out_index = mul __slice_ub_mid_%out_index, 8
    __slice_ub_mid_ptr_%out_index = ptr_add __slice_ub_ptr_%out_index, __slice_ub_mid_off_%out_index
    __slice_ub_value_%out_index = load __slice_ub_mid_ptr_%out_index+0 as u64
    __slice_ub_le_%out_index = ule __slice_ub_value_%out_index, %needle
    br __slice_ub_le_%out_index -> L_SLICE_UB_MOVE_RIGHT_%out_index, L_SLICE_UB_MOVE_LEFT_%out_index

L_SLICE_UB_MOVE_RIGHT_%out_index:
    __slice_ub_next_left_%out_index = add __slice_ub_mid_%out_index, 1
    store __slice_ub_left_slot_%out_index+0, __slice_ub_next_left_%out_index as u64
    !__slice_ub_next_left_%out_index
    !__slice_ub_le_%out_index
    !__slice_ub_value_%out_index
    !__slice_ub_mid_ptr_%out_index
    !__slice_ub_mid_off_%out_index
    !__slice_ub_mid_%out_index
    !__slice_ub_half_%out_index
    !__slice_ub_span_%out_index
    !__slice_ub_continue_%out_index
    !__slice_ub_right_%out_index
    !__slice_ub_left_%out_index
    jmp L_SLICE_UB_HEAD_%out_index

L_SLICE_UB_MOVE_LEFT_%out_index:
    store __slice_ub_right_slot_%out_index+0, __slice_ub_mid_%out_index as u64
    !__slice_ub_le_%out_index
    !__slice_ub_value_%out_index
    !__slice_ub_mid_ptr_%out_index
    !__slice_ub_mid_off_%out_index
    !__slice_ub_mid_%out_index
    !__slice_ub_half_%out_index
    !__slice_ub_span_%out_index
    !__slice_ub_continue_%out_index
    !__slice_ub_right_%out_index
    !__slice_ub_left_%out_index
    jmp L_SLICE_UB_HEAD_%out_index

L_SLICE_UB_DONE_%out_index:
    %out_index = add __slice_ub_left_%out_index, 0
    !__slice_ub_continue_%out_index
    !__slice_ub_right_%out_index
    !__slice_ub_left_%out_index
    !__slice_ub_len_%out_index
    !__slice_ub_ptr_%out_index
[END_MACRO]

// Rust method-name alias over SLICE_UPPER_BOUND_U64.
[MACRO] SLICE_UPPER_BOUND %out_index, %slice_reg, %needle
    EXPAND SLICE_UPPER_BOUND_U64 %out_index, %slice_reg, %needle
[END_MACRO]

[MACRO] SLICE_EQUAL_RANGE_U64 %out_start, %out_end, %slice_reg, %needle
    EXPAND SLICE_LOWER_BOUND_U64 %out_start, %slice_reg, %needle
    EXPAND SLICE_UPPER_BOUND_U64 %out_end, %slice_reg, %needle
[END_MACRO]

// Rust method-name alias over SLICE_EQUAL_RANGE_U64.
[MACRO] SLICE_EQUAL_RANGE %out_start, %out_end, %slice_reg, %needle
    EXPAND SLICE_EQUAL_RANGE_U64 %out_start, %out_end, %slice_reg, %needle
[END_MACRO]


[MACRO] SLICE_DEFAULT %slice_reg
    __slice_default_zero_%slice_reg = add 0, 0
    store %slice_reg+Slice_ptr, __slice_default_zero_%slice_reg as ptr
    store %slice_reg+Slice_len, __slice_default_zero_%slice_reg as u64
    !__slice_default_zero_%slice_reg
[END_MACRO]

[MACRO] SLICE_ROTATE_LEFT %out_ok, %slice_reg, %count
    EXPAND SLICE_TRY_ROTATE_LEFT %out_ok, %slice_reg, %count
[END_MACRO]

[MACRO] SLICE_ROTATE_RIGHT %out_ok, %slice_reg, %count
    EXPAND SLICE_TRY_ROTATE_RIGHT %out_ok, %slice_reg, %count
[END_MACRO]
