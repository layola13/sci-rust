// 在栈上或预分配寄存器中初始化 Slice
[MACRO] SLICE_NEW %slice_reg, %data_ptr, %length
    store %slice_reg+Slice_ptr, %data_ptr as ptr
    store %slice_reg+Slice_len, %length as u64
[END_MACRO]

[MACRO] SLICE_GET_PTR %out_ptr, %slice_reg
    %out_ptr = load %slice_reg+Slice_ptr as ptr
[END_MACRO]

[MACRO] SLICE_AS_PTR %out_ptr, %slice_reg
    EXPAND SLICE_GET_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] SLICE_AS_PTR_RANGE %out_start, %out_end, %slice_reg, %elem_size
    __slice_range_ptr_%out_start = load %slice_reg+Slice_ptr as ptr
    __slice_range_len_%out_start = load %slice_reg+Slice_len as u64
    __slice_range_bytes_%out_start = mul __slice_range_len_%out_start, %elem_size
    %out_start = ptr_add __slice_range_ptr_%out_start, 0
    %out_end = ptr_add __slice_range_ptr_%out_start, __slice_range_bytes_%out_start
    !__slice_range_bytes_%out_start
    !__slice_range_len_%out_start
    !__slice_range_ptr_%out_start
[END_MACRO]

[MACRO] SLICE_AS_MUT_PTR_RANGE %out_start, %out_end, %slice_reg, %elem_size
    EXPAND SLICE_AS_PTR_RANGE %out_start, %out_end, %slice_reg, %elem_size
[END_MACRO]

[MACRO] SLICE_AS_PTR_RANGE_U64 %out_start, %out_end, %slice_reg
    EXPAND SLICE_AS_PTR_RANGE %out_start, %out_end, %slice_reg, 8
[END_MACRO]

[MACRO] SLICE_AS_MUT_PTR_RANGE_U64 %out_start, %out_end, %slice_reg
    EXPAND SLICE_AS_MUT_PTR_RANGE %out_start, %out_end, %slice_reg, 8
[END_MACRO]

[MACRO] SLICE_GET_LEN %out_len, %slice_reg
    %out_len = load %slice_reg+Slice_len as u64
[END_MACRO]

[MACRO] SLICE_IS_EMPTY %out_bool, %slice_reg
    __slice_len_%out_bool = load %slice_reg+Slice_len as u64
    %out_bool = eq __slice_len_%out_bool, 0
    !__slice_len_%out_bool
[END_MACRO]

[MACRO] SLICE_GET_U64 %out_value, %slice_reg, %index
    __slice_ptr_%out_value = load %slice_reg+Slice_ptr as ptr
    __slice_off_%out_value = mul %index, 8
    __slice_item_%out_value = ptr_add __slice_ptr_%out_value, __slice_off_%out_value
    %out_value = load __slice_item_%out_value+0 as u64
    !__slice_item_%out_value
    !__slice_off_%out_value
    !__slice_ptr_%out_value
[END_MACRO]

// Rust method-name alias over SLICE_GET_U64.
[MACRO] SLICE_GET %out_value, %slice_reg, %index
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, %index
[END_MACRO]

[MACRO] SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, %index
    __slice_ptr_%out_ptr = load %slice_reg+Slice_ptr as ptr
    __slice_off_%out_ptr = mul %index, 8
    %out_ptr = ptr_add __slice_ptr_%out_ptr, __slice_off_%out_ptr
    !__slice_off_%out_ptr
    !__slice_ptr_%out_ptr
[END_MACRO]

// Rust method-name alias over SLICE_GET_MUT_PTR_U64.
[MACRO] SLICE_GET_MUT_PTR %out_ptr, %slice_reg, %index
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, %index
[END_MACRO]

[MACRO] SLICE_GET_UNCHECKED_U64 %out_value, %slice_reg, %index
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, %index
[END_MACRO]

// Rust method-name alias over SLICE_GET_UNCHECKED_U64.
[MACRO] SLICE_GET_UNCHECKED %out_value, %slice_reg, %index
    EXPAND SLICE_GET_UNCHECKED_U64 %out_value, %slice_reg, %index
[END_MACRO]

[MACRO] SLICE_GET_UNCHECKED_MUT_PTR_U64 %out_ptr, %slice_reg, %index
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, %index
[END_MACRO]

// Rust method-name alias over SLICE_GET_UNCHECKED_MUT_PTR_U64.
[MACRO] SLICE_GET_UNCHECKED_MUT_PTR %out_ptr, %slice_reg, %index
    EXPAND SLICE_GET_UNCHECKED_MUT_PTR_U64 %out_ptr, %slice_reg, %index
[END_MACRO]

[MACRO] SLICE_FIRST_U64 %out_value, %slice_reg
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, 0
[END_MACRO]

// Rust method-name alias over SLICE_FIRST_U64.
[MACRO] SLICE_FIRST %out_value, %slice_reg
    EXPAND SLICE_FIRST_U64 %out_value, %slice_reg
[END_MACRO]

[MACRO] SLICE_FIRST_MUT_PTR_U64 %out_ptr, %slice_reg
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, 0
[END_MACRO]

// Rust method-name alias over SLICE_FIRST_MUT_PTR_U64.
[MACRO] SLICE_FIRST_MUT_PTR %out_ptr, %slice_reg
    EXPAND SLICE_FIRST_MUT_PTR_U64 %out_ptr, %slice_reg
[END_MACRO]

[MACRO] SLICE_TRY_FIRST_U64 %out_ok, %out_value, %slice_reg
    EXPAND SLICE_TRY_GET_U64 %out_ok, %out_value, %slice_reg, 0
[END_MACRO]

// Rust method-name alias over SLICE_TRY_FIRST_U64.
[MACRO] SLICE_TRY_FIRST %out_ok, %out_value, %slice_reg
    EXPAND SLICE_TRY_FIRST_U64 %out_ok, %out_value, %slice_reg
[END_MACRO]

[MACRO] SLICE_LAST_U64 %out_value, %slice_reg
    __slice_len_%out_value = load %slice_reg+Slice_len as u64
    __slice_last_%out_value = sub __slice_len_%out_value, 1
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, __slice_last_%out_value
    !__slice_last_%out_value
    !__slice_len_%out_value
[END_MACRO]

// Rust method-name alias over SLICE_LAST_U64.
[MACRO] SLICE_LAST %out_value, %slice_reg
    EXPAND SLICE_LAST_U64 %out_value, %slice_reg
[END_MACRO]

[MACRO] SLICE_LAST_MUT_PTR_U64 %out_ptr, %slice_reg
    __slice_len_%out_ptr = load %slice_reg+Slice_len as u64
    __slice_last_%out_ptr = sub __slice_len_%out_ptr, 1
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, __slice_last_%out_ptr
    !__slice_last_%out_ptr
    !__slice_len_%out_ptr
[END_MACRO]

// Rust method-name alias over SLICE_LAST_MUT_PTR_U64.
[MACRO] SLICE_LAST_MUT_PTR %out_ptr, %slice_reg
    EXPAND SLICE_LAST_MUT_PTR_U64 %out_ptr, %slice_reg
[END_MACRO]

[MACRO] SLICE_TRY_LAST_U64 %out_ok, %out_value, %slice_reg
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_empty_%out_ok = eq __slice_len_%out_ok, 0
    br __slice_empty_%out_ok -> L_SLICE_TRY_LAST_MISS_%out_ok, L_SLICE_TRY_LAST_HIT_%out_ok

L_SLICE_TRY_LAST_HIT_%out_ok:
    __slice_last_%out_ok = sub __slice_len_%out_ok, 1
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, __slice_last_%out_ok
    %out_ok = add 0, 1
    !__slice_last_%out_ok
    !__slice_empty_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_TRY_LAST_END_%out_ok

L_SLICE_TRY_LAST_MISS_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__slice_empty_%out_ok
    !__slice_len_%out_ok

L_SLICE_TRY_LAST_END_%out_ok:
[END_MACRO]

// Rust method-name alias over SLICE_TRY_LAST_U64.
[MACRO] SLICE_TRY_LAST %out_ok, %out_value, %slice_reg
    EXPAND SLICE_TRY_LAST_U64 %out_ok, %out_value, %slice_reg
[END_MACRO]

[MACRO] SLICE_TRY_GET_U64 %out_ok, %out_value, %slice_reg, %index
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_in_bounds_%out_ok = ult %index, __slice_len_%out_ok
    br __slice_in_bounds_%out_ok -> L_SLICE_TRY_GET_HIT_%out_ok, L_SLICE_TRY_GET_MISS_%out_ok

L_SLICE_TRY_GET_HIT_%out_ok:
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, %index
    %out_ok = add 0, 1
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_TRY_GET_END_%out_ok

L_SLICE_TRY_GET_MISS_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok

L_SLICE_TRY_GET_END_%out_ok:
[END_MACRO]

// Rust method-name alias over SLICE_TRY_GET_U64.
