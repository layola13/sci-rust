@import "../num.sal"

[MACRO] ARC_NEW %out_arc, %value
    %out_arc = alloc ArcBox_SIZE
    store %out_arc+ArcBox_strong, 1 as u64
    store %out_arc+ArcBox_weak, 1 as u64
    store %out_arc+ArcBox_data, %value as u64
[END_MACRO]

// Rust-style Default for concrete Arc<u64>: Arc::new(0).
[MACRO] ARC_DEFAULT_U64 %out_arc
    EXPAND ARC_NEW %out_arc, 0
[END_MACRO]

// Rust method-name alias over ARC_DEFAULT_U64.
[MACRO] ARC_DEFAULT %out_arc
    EXPAND ARC_DEFAULT_U64 %out_arc
[END_MACRO]

[MACRO] ARC_CLONE %arc_reg
    __arc_old_strong_%arc_reg = atomic_rmw_add %arc_reg+ArcBox_strong, 1 as u64 acq_rel
    __arc_strong_overflow_%arc_reg = eq __arc_old_strong_%arc_reg, NUM_U64_MAX
    br __arc_strong_overflow_%arc_reg -> L_ARC_CLONE_OVERFLOW_%arc_reg, L_ARC_CLONE_OK_%arc_reg
L_ARC_CLONE_OVERFLOW_%arc_reg:
    panic(1501)
L_ARC_CLONE_OK_%arc_reg:
    !__arc_strong_overflow_%arc_reg
    !__arc_old_strong_%arc_reg
[END_MACRO]

[MACRO] ARC_CLONE_OUT %out_arc, %arc_reg
    %out_arc = add %arc_reg, 0
    EXPAND ARC_CLONE %out_arc
[END_MACRO]

[MACRO] ARC_GET %out_value, %arc_reg
    %out_value = load %arc_reg+ArcBox_data as u64
[END_MACRO]

[MACRO] ARC_AS_PTR %out_ptr, %arc_reg
    %out_ptr = ptr_add %arc_reg, ArcBox_data
[END_MACRO]

[MACRO] ARC_INTO_RAW %out_ptr, %arc_reg
    %out_ptr = ptr_add %arc_reg, ArcBox_data
[END_MACRO]

[MACRO] ARC_FROM_RAW %out_arc, %raw_ptr
    %out_arc = sub %raw_ptr, ArcBox_data
[END_MACRO]

[MACRO] ARC_INCREMENT_STRONG_COUNT %raw_ptr
    __arc_inc_box_%raw_ptr = sub %raw_ptr, ArcBox_data
    __arc_inc_old_%raw_ptr = atomic_rmw_add __arc_inc_box_%raw_ptr+ArcBox_strong, 1 as u64 acq_rel
    __arc_inc_overflow_%raw_ptr = eq __arc_inc_old_%raw_ptr, NUM_U64_MAX
    br __arc_inc_overflow_%raw_ptr -> L_ARC_INC_STRONG_OVERFLOW_%raw_ptr, L_ARC_INC_STRONG_OK_%raw_ptr
L_ARC_INC_STRONG_OVERFLOW_%raw_ptr:
    panic(1502)
L_ARC_INC_STRONG_OK_%raw_ptr:
    !__arc_inc_overflow_%raw_ptr
    !__arc_inc_old_%raw_ptr
    !__arc_inc_box_%raw_ptr
[END_MACRO]

[MACRO] ARC_DECREMENT_STRONG_COUNT %raw_ptr
    __arc_dec_box_%raw_ptr = sub %raw_ptr, ArcBox_data
    __arc_dec_old_%raw_ptr = atomic_rmw_sub __arc_dec_box_%raw_ptr+ArcBox_strong, 1 as u64 acq_rel
    !__arc_dec_old_%raw_ptr
    !__arc_dec_box_%raw_ptr
[END_MACRO]

[MACRO] ARC_STRONG_COUNT %out_count, %arc_reg
    %out_count = atomic_load %arc_reg+ArcBox_strong as u64 acquire
[END_MACRO]

[MACRO] ARC_WEAK_COUNT %out_count, %arc_reg
    __arc_weak_total_%out_count = atomic_load %arc_reg+ArcBox_weak as u64 acquire
    %out_count = sub __arc_weak_total_%out_count, 1
    !__arc_weak_total_%out_count
[END_MACRO]

[MACRO] ARC_PTR_EQ %out_bool, %left_arc, %right_arc
    %out_bool = eq %left_arc, %right_arc
[END_MACRO]

[MACRO] ARC_GET_MUT %out_ok, %out_ptr, %arc_reg
    __arc_mut_strong_%out_ok = atomic_load %arc_reg+ArcBox_strong as u64 acquire
    __arc_mut_weak_%out_ok = atomic_load %arc_reg+ArcBox_weak as u64 acquire
    __arc_mut_strong_one_%out_ok = eq __arc_mut_strong_%out_ok, 1
    __arc_mut_weak_one_%out_ok = eq __arc_mut_weak_%out_ok, 1
    __arc_mut_unique_%out_ok = and __arc_mut_strong_one_%out_ok, __arc_mut_weak_one_%out_ok
    br __arc_mut_unique_%out_ok -> L_ARC_GET_MUT_OK_%out_ok, L_ARC_GET_MUT_FAIL_%out_ok
L_ARC_GET_MUT_OK_%out_ok:
    %out_ptr = ptr_add %arc_reg, ArcBox_data
    %out_ok = add 0, 1
    jmp L_ARC_GET_MUT_DONE_%out_ok
L_ARC_GET_MUT_FAIL_%out_ok:
    %out_ptr = 0 as ptr
    %out_ok = add 0, 0
L_ARC_GET_MUT_DONE_%out_ok:
    !__arc_mut_unique_%out_ok
    !__arc_mut_weak_one_%out_ok
    !__arc_mut_strong_one_%out_ok
    !__arc_mut_weak_%out_ok
    !__arc_mut_strong_%out_ok
[END_MACRO]

[MACRO] ARC_TRY_UNWRAP %out_ok, %out_value, %arc_reg
    __arc_unwrap_strong_%out_ok = atomic_load %arc_reg+ArcBox_strong as u64 acquire
    __arc_unwrap_unique_%out_ok = eq __arc_unwrap_strong_%out_ok, 1
    br __arc_unwrap_unique_%out_ok -> L_ARC_TRY_UNWRAP_OK_%out_ok, L_ARC_TRY_UNWRAP_FAIL_%out_ok
L_ARC_TRY_UNWRAP_OK_%out_ok:
    %out_value = load %arc_reg+ArcBox_data as u64
    %out_ok = add 0, 1
    jmp L_ARC_TRY_UNWRAP_DONE_%out_ok
L_ARC_TRY_UNWRAP_FAIL_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
L_ARC_TRY_UNWRAP_DONE_%out_ok:
    !__arc_unwrap_unique_%out_ok
    !__arc_unwrap_strong_%out_ok
[END_MACRO]

[MACRO] ARC_MAKE_MUT_U64 %out_ptr, %arc_reg
    %out_ptr = ptr_add %arc_reg, ArcBox_data
[END_MACRO]

// Rust method-name alias over ARC_MAKE_MUT_U64.
[MACRO] ARC_MAKE_MUT %out_ptr, %arc_reg
    EXPAND ARC_MAKE_MUT_U64 %out_ptr, %arc_reg
[END_MACRO]

[MACRO] ARC_UNWRAP_OR_CLONE_U64 %out_value, %arc_reg
    %out_value = load %arc_reg+ArcBox_data as u64
[END_MACRO]

// Rust method-name alias over ARC_UNWRAP_OR_CLONE_U64.
[MACRO] ARC_UNWRAP_OR_CLONE %out_value, %arc_reg
    EXPAND ARC_UNWRAP_OR_CLONE_U64 %out_value, %arc_reg
[END_MACRO]

[MACRO] ARC_DROP %arc_reg, %cleanup_label
    __arc_strong_%arc_reg = atomic_rmw_sub %arc_reg+ArcBox_strong, 1 as u64 acq_rel
    __arc_is_last_%arc_reg = eq __arc_strong_%arc_reg, 1
    br __arc_is_last_%arc_reg -> %cleanup_label, L_ARC_DROP_DONE_%arc_reg
L_ARC_DROP_DONE_%arc_reg:
    !__arc_is_last_%arc_reg
    !__arc_strong_%arc_reg
[END_MACRO]

[MACRO] ARC_DOWNGRADE %out_weak, %arc_reg
    __arc_weak_%out_weak = atomic_rmw_add %arc_reg+ArcBox_weak, 1 as u64 acq_rel
    __arc_weak_overflow_%out_weak = eq __arc_weak_%out_weak, NUM_U64_MAX
    br __arc_weak_overflow_%out_weak -> L_ARC_DOWNGRADE_OVERFLOW_%out_weak, L_ARC_DOWNGRADE_OK_%out_weak
L_ARC_DOWNGRADE_OVERFLOW_%out_weak:
    panic(1503)
L_ARC_DOWNGRADE_OK_%out_weak:
    %out_weak = add %arc_reg, 0
    !__arc_weak_overflow_%out_weak
    !__arc_weak_%out_weak
[END_MACRO]

[MACRO] ARC_WEAK_CLONE %weak_reg
    __weak_old_%weak_reg = atomic_rmw_add %weak_reg+ArcBox_weak, 1 as u64 acq_rel
    __weak_overflow_%weak_reg = eq __weak_old_%weak_reg, NUM_U64_MAX
    br __weak_overflow_%weak_reg -> L_ARC_WEAK_CLONE_OVERFLOW_%weak_reg, L_ARC_WEAK_CLONE_OK_%weak_reg
L_ARC_WEAK_CLONE_OVERFLOW_%weak_reg:
    panic(1504)
L_ARC_WEAK_CLONE_OK_%weak_reg:
    !__weak_overflow_%weak_reg
    !__weak_old_%weak_reg
[END_MACRO]

[MACRO] ARC_WEAK_NEW %out_weak
    %out_weak = alloc ArcBox_SIZE
    store %out_weak+ArcBox_strong, 0 as u64
    store %out_weak+ArcBox_weak, 1 as u64
    store %out_weak+ArcBox_data, 0 as u64
[END_MACRO]

// Rust-style Default alias for Weak::new().
[MACRO] ARC_WEAK_DEFAULT %out_weak
    EXPAND ARC_WEAK_NEW %out_weak
[END_MACRO]

[MACRO] ARC_WEAK_STRONG_COUNT %out_count, %weak_reg
    %out_count = atomic_load %weak_reg+ArcBox_strong as u64 acquire
[END_MACRO]

[MACRO] ARC_WEAK_WEAK_COUNT %out_count, %weak_reg
    __arc_weak_total_%out_count = atomic_load %weak_reg+ArcBox_weak as u64 acquire
    %out_count = sub __arc_weak_total_%out_count, 1
    !__arc_weak_total_%out_count
[END_MACRO]

[MACRO] ARC_WEAK_PTR_EQ %out_bool, %left_weak, %right_weak
    %out_bool = eq %left_weak, %right_weak
[END_MACRO]

[MACRO] ARC_WEAK_DROP %weak_reg, %free_label
    __weak_next_count_%weak_reg = atomic_rmw_sub %weak_reg+ArcBox_weak, 1 as u64 acq_rel
    __weak_is_last_%weak_reg = eq __weak_next_count_%weak_reg, 1
    br __weak_is_last_%weak_reg -> %free_label, L_ARC_WEAK_DROP_DONE_%weak_reg
L_ARC_WEAK_DROP_DONE_%weak_reg:
    !__weak_is_last_%weak_reg
    !__weak_next_count_%weak_reg
[END_MACRO]

[MACRO] ARC_WEAK_UPGRADE %out_arc, %out_ok, %weak_reg
    __weak_strong_%out_arc = atomic_load %weak_reg+ArcBox_strong as u64 acquire
    __weak_is_alive_%out_arc = ne __weak_strong_%out_arc, 0
    br __weak_is_alive_%out_arc -> L_ARC_WEAK_UPGRADE_OK_%out_arc, L_ARC_WEAK_UPGRADE_NONE_%out_arc
L_ARC_WEAK_UPGRADE_OK_%out_arc:
    __weak_next_strong_%out_arc = atomic_rmw_add %weak_reg+ArcBox_strong, 1 as u64 acq_rel
    __weak_upgrade_overflow_%out_arc = eq __weak_next_strong_%out_arc, NUM_U64_MAX
    br __weak_upgrade_overflow_%out_arc -> L_ARC_WEAK_UPGRADE_OVERFLOW_%out_arc, L_ARC_WEAK_UPGRADE_STORE_%out_arc
L_ARC_WEAK_UPGRADE_OVERFLOW_%out_arc:
    panic(1505)
L_ARC_WEAK_UPGRADE_STORE_%out_arc:
    %out_arc = add %weak_reg, 0
    %out_ok = add 0, 1
    !__weak_upgrade_overflow_%out_arc
    !__weak_next_strong_%out_arc
    !__weak_is_alive_%out_arc
    !__weak_strong_%out_arc
    jmp L_ARC_WEAK_UPGRADE_END_%out_arc
L_ARC_WEAK_UPGRADE_NONE_%out_arc:
    %out_arc = add 0, 0
    %out_ok = add 0, 0
    !__weak_is_alive_%out_arc
    !__weak_strong_%out_arc
L_ARC_WEAK_UPGRADE_END_%out_arc:
[END_MACRO]
