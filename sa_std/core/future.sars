@import "future.sal"
@import "waker.sal"
@import "waker.sars"
@import "option.sal"
@import "result.sal"

[MACRO] POLL_PENDING %out_poll
    %out_poll = alloc Poll_SIZE
    store %out_poll+Poll_tag, Poll_PENDING as u64
    store %out_poll+Poll_value, 0 as u64
[END_MACRO]

[MACRO] POLL_READY %out_poll, %value
    %out_poll = alloc Poll_SIZE
    store %out_poll+Poll_tag, Poll_READY as u64
    store %out_poll+Poll_value, %value as u64
[END_MACRO]

[MACRO] POLL_READY_PTR %out_poll, %value_ptr
    %out_poll = alloc Poll_SIZE
    store %out_poll+Poll_tag, Poll_READY as u64
    store %out_poll+Poll_value, %value_ptr as ptr
[END_MACRO]

[MACRO] POLL_SET_PENDING %poll_reg
    store %poll_reg+Poll_tag, Poll_PENDING as u64
    store %poll_reg+Poll_value, 0 as u64
[END_MACRO]

[MACRO] POLL_SET_READY %poll_reg, %value
    store %poll_reg+Poll_tag, Poll_READY as u64
    store %poll_reg+Poll_value, %value as u64
[END_MACRO]

[MACRO] POLL_SET_READY_PTR %poll_reg, %value_ptr
    store %poll_reg+Poll_tag, Poll_READY as u64
    store %poll_reg+Poll_value, %value_ptr as ptr
[END_MACRO]

[MACRO] POLL_IS_READY %out_bool, %poll_reg
    __poll_tag_%out_bool = load %poll_reg+Poll_tag as u64
    %out_bool = eq __poll_tag_%out_bool, Poll_READY
    !__poll_tag_%out_bool
[END_MACRO]

[MACRO] POLL_IS_PENDING %out_bool, %poll_reg
    __poll_tag_%out_bool = load %poll_reg+Poll_tag as u64
    %out_bool = eq __poll_tag_%out_bool, Poll_PENDING
    !__poll_tag_%out_bool
[END_MACRO]

[MACRO] POLL_VALUE %out_value, %poll_reg
    %out_value = load %poll_reg+Poll_value as u64
[END_MACRO]

[MACRO] POLL_VALUE_PTR %out_value, %poll_reg
    %out_value = load %poll_reg+Poll_value as ptr
[END_MACRO]

[MACRO] POLL_MAP %out_poll, %poll_reg, %map_fn
    __poll_map_tag_%out_poll = load %poll_reg+Poll_tag as u64
    __poll_map_ready_%out_poll = eq __poll_map_tag_%out_poll, Poll_READY
    br __poll_map_ready_%out_poll -> L_POLL_MAP_READY_%out_poll, L_POLL_MAP_PENDING_%out_poll
L_POLL_MAP_READY_%out_poll:
    __poll_map_value_%out_poll = load %poll_reg+Poll_value as u64
    __poll_map_mapped_%out_poll = call %map_fn(__poll_map_value_%out_poll)
    EXPAND POLL_READY %out_poll, __poll_map_mapped_%out_poll
    !__poll_map_mapped_%out_poll
    !__poll_map_value_%out_poll
    jmp L_POLL_MAP_DONE_%out_poll
L_POLL_MAP_PENDING_%out_poll:
    EXPAND POLL_PENDING %out_poll
L_POLL_MAP_DONE_%out_poll:
    !__poll_map_ready_%out_poll
    !__poll_map_tag_%out_poll
[END_MACRO]

[MACRO] POLL_RESULT_PENDING %out_poll_res
    %out_poll_res = alloc PollResult_SIZE
    store %out_poll_res+PollResult_poll_tag, Poll_PENDING as u64
    store %out_poll_res+PollResult_result_tag, Result_ERR as u64
    store %out_poll_res+PollResult_ok, 0 as u64
    store %out_poll_res+PollResult_err, 0 as u64
[END_MACRO]

[MACRO] POLL_RESULT_READY_OK %out_poll_res, %value
    %out_poll_res = alloc PollResult_SIZE
    store %out_poll_res+PollResult_poll_tag, Poll_READY as u64
    store %out_poll_res+PollResult_result_tag, Result_OK as u64
    store %out_poll_res+PollResult_ok, %value as u64
    store %out_poll_res+PollResult_err, 0 as u64
[END_MACRO]

[MACRO] POLL_RESULT_READY_ERR %out_poll_res, %err
    %out_poll_res = alloc PollResult_SIZE
    store %out_poll_res+PollResult_poll_tag, Poll_READY as u64
    store %out_poll_res+PollResult_result_tag, Result_ERR as u64
    store %out_poll_res+PollResult_ok, 0 as u64
    store %out_poll_res+PollResult_err, %err as u64
[END_MACRO]

[MACRO] POLL_RESULT_IS_READY %out_bool, %poll_res
    __poll_result_tag_%out_bool = load %poll_res+PollResult_poll_tag as u64
    %out_bool = eq __poll_result_tag_%out_bool, Poll_READY
    !__poll_result_tag_%out_bool
[END_MACRO]

[MACRO] POLL_RESULT_IS_OK %out_bool, %poll_res
    __poll_result_tag_%out_bool = load %poll_res+PollResult_result_tag as u64
    %out_bool = eq __poll_result_tag_%out_bool, Result_OK
    !__poll_result_tag_%out_bool
[END_MACRO]

[MACRO] POLL_RESULT_IS_ERR %out_bool, %poll_res
    __poll_result_tag_%out_bool = load %poll_res+PollResult_result_tag as u64
    %out_bool = eq __poll_result_tag_%out_bool, Result_ERR
    !__poll_result_tag_%out_bool
[END_MACRO]

[MACRO] POLL_RESULT_OK_VALUE %out_value, %poll_res
    %out_value = load %poll_res+PollResult_ok as u64
[END_MACRO]

[MACRO] POLL_RESULT_ERR_VALUE %out_value, %poll_res
    %out_value = load %poll_res+PollResult_err as u64
[END_MACRO]

[MACRO] POLL_RESULT_MAP_OK %out_poll_res, %poll_res, %map_fn
    __poll_result_poll_tag_%out_poll_res = load %poll_res+PollResult_poll_tag as u64
    __poll_result_ready_%out_poll_res = eq __poll_result_poll_tag_%out_poll_res, Poll_READY
    br __poll_result_ready_%out_poll_res -> L_POLL_RESULT_MAP_OK_READY_%out_poll_res, L_POLL_RESULT_MAP_OK_PENDING_%out_poll_res
L_POLL_RESULT_MAP_OK_READY_%out_poll_res:
    __poll_result_tag_%out_poll_res = load %poll_res+PollResult_result_tag as u64
    __poll_result_ok_%out_poll_res = eq __poll_result_tag_%out_poll_res, Result_OK
    br __poll_result_ok_%out_poll_res -> L_POLL_RESULT_MAP_OK_OK_%out_poll_res, L_POLL_RESULT_MAP_OK_ERR_%out_poll_res
L_POLL_RESULT_MAP_OK_OK_%out_poll_res:
    __poll_result_value_%out_poll_res = load %poll_res+PollResult_ok as u64
    __poll_result_mapped_%out_poll_res = call %map_fn(__poll_result_value_%out_poll_res)
    EXPAND POLL_RESULT_READY_OK %out_poll_res, __poll_result_mapped_%out_poll_res
    !__poll_result_mapped_%out_poll_res
    !__poll_result_value_%out_poll_res
    jmp L_POLL_RESULT_MAP_OK_READY_DONE_%out_poll_res
L_POLL_RESULT_MAP_OK_ERR_%out_poll_res:
    __poll_result_err_%out_poll_res = load %poll_res+PollResult_err as u64
    EXPAND POLL_RESULT_READY_ERR %out_poll_res, __poll_result_err_%out_poll_res
    !__poll_result_err_%out_poll_res
L_POLL_RESULT_MAP_OK_READY_DONE_%out_poll_res:
    !__poll_result_ok_%out_poll_res
    !__poll_result_tag_%out_poll_res
    jmp L_POLL_RESULT_MAP_OK_DONE_%out_poll_res
L_POLL_RESULT_MAP_OK_PENDING_%out_poll_res:
    EXPAND POLL_RESULT_PENDING %out_poll_res
L_POLL_RESULT_MAP_OK_DONE_%out_poll_res:
    !__poll_result_ready_%out_poll_res
    !__poll_result_poll_tag_%out_poll_res
[END_MACRO]

[MACRO] POLL_RESULT_MAP_ERR %out_poll_res, %poll_res, %map_fn
    __poll_result_err_poll_tag_%out_poll_res = load %poll_res+PollResult_poll_tag as u64
    __poll_result_err_ready_%out_poll_res = eq __poll_result_err_poll_tag_%out_poll_res, Poll_READY
    br __poll_result_err_ready_%out_poll_res -> L_POLL_RESULT_MAP_ERR_READY_%out_poll_res, L_POLL_RESULT_MAP_ERR_PENDING_%out_poll_res
L_POLL_RESULT_MAP_ERR_READY_%out_poll_res:
    __poll_result_err_tag_%out_poll_res = load %poll_res+PollResult_result_tag as u64
    __poll_result_err_is_err_%out_poll_res = eq __poll_result_err_tag_%out_poll_res, Result_ERR
    br __poll_result_err_is_err_%out_poll_res -> L_POLL_RESULT_MAP_ERR_ERR_%out_poll_res, L_POLL_RESULT_MAP_ERR_OK_%out_poll_res
L_POLL_RESULT_MAP_ERR_ERR_%out_poll_res:
    __poll_result_err_value_%out_poll_res = load %poll_res+PollResult_err as u64
    __poll_result_err_mapped_%out_poll_res = call %map_fn(__poll_result_err_value_%out_poll_res)
    EXPAND POLL_RESULT_READY_ERR %out_poll_res, __poll_result_err_mapped_%out_poll_res
    !__poll_result_err_mapped_%out_poll_res
    !__poll_result_err_value_%out_poll_res
    jmp L_POLL_RESULT_MAP_ERR_READY_DONE_%out_poll_res
L_POLL_RESULT_MAP_ERR_OK_%out_poll_res:
    __poll_result_err_ok_value_%out_poll_res = load %poll_res+PollResult_ok as u64
    EXPAND POLL_RESULT_READY_OK %out_poll_res, __poll_result_err_ok_value_%out_poll_res
    !__poll_result_err_ok_value_%out_poll_res
L_POLL_RESULT_MAP_ERR_READY_DONE_%out_poll_res:
    !__poll_result_err_is_err_%out_poll_res
    !__poll_result_err_tag_%out_poll_res
    jmp L_POLL_RESULT_MAP_ERR_DONE_%out_poll_res
L_POLL_RESULT_MAP_ERR_PENDING_%out_poll_res:
    EXPAND POLL_RESULT_PENDING %out_poll_res
L_POLL_RESULT_MAP_ERR_DONE_%out_poll_res:
    !__poll_result_err_ready_%out_poll_res
    !__poll_result_err_poll_tag_%out_poll_res
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_PENDING %out_poll_res
    %out_poll_res = alloc PollOptionResult_SIZE
    store %out_poll_res+PollOptionResult_poll_tag, Poll_PENDING as u64
    store %out_poll_res+PollOptionResult_option_tag, Option_NONE as u64
    store %out_poll_res+PollOptionResult_result_tag, Result_ERR as u64
    store %out_poll_res+PollOptionResult_ok, 0 as u64
    store %out_poll_res+PollOptionResult_err, 0 as u64
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_READY_NONE %out_poll_res
    %out_poll_res = alloc PollOptionResult_SIZE
    store %out_poll_res+PollOptionResult_poll_tag, Poll_READY as u64
    store %out_poll_res+PollOptionResult_option_tag, Option_NONE as u64
    store %out_poll_res+PollOptionResult_result_tag, Result_ERR as u64
    store %out_poll_res+PollOptionResult_ok, 0 as u64
    store %out_poll_res+PollOptionResult_err, 0 as u64
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_READY_SOME_OK %out_poll_res, %value
    %out_poll_res = alloc PollOptionResult_SIZE
    store %out_poll_res+PollOptionResult_poll_tag, Poll_READY as u64
    store %out_poll_res+PollOptionResult_option_tag, Option_SOME as u64
    store %out_poll_res+PollOptionResult_result_tag, Result_OK as u64
    store %out_poll_res+PollOptionResult_ok, %value as u64
    store %out_poll_res+PollOptionResult_err, 0 as u64
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_READY_SOME_ERR %out_poll_res, %err
    %out_poll_res = alloc PollOptionResult_SIZE
    store %out_poll_res+PollOptionResult_poll_tag, Poll_READY as u64
    store %out_poll_res+PollOptionResult_option_tag, Option_SOME as u64
    store %out_poll_res+PollOptionResult_result_tag, Result_ERR as u64
    store %out_poll_res+PollOptionResult_ok, 0 as u64
    store %out_poll_res+PollOptionResult_err, %err as u64
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_IS_READY %out_bool, %poll_res
    __poll_option_result_tag_%out_bool = load %poll_res+PollOptionResult_poll_tag as u64
    %out_bool = eq __poll_option_result_tag_%out_bool, Poll_READY
    !__poll_option_result_tag_%out_bool
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_IS_SOME %out_bool, %poll_res
    __poll_option_result_tag_%out_bool = load %poll_res+PollOptionResult_option_tag as u64
    %out_bool = eq __poll_option_result_tag_%out_bool, Option_SOME
    !__poll_option_result_tag_%out_bool
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_IS_OK %out_bool, %poll_res
    __poll_option_result_tag_%out_bool = load %poll_res+PollOptionResult_result_tag as u64
    %out_bool = eq __poll_option_result_tag_%out_bool, Result_OK
    !__poll_option_result_tag_%out_bool
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_OK_VALUE %out_value, %poll_res
    %out_value = load %poll_res+PollOptionResult_ok as u64
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_ERR_VALUE %out_value, %poll_res
    %out_value = load %poll_res+PollOptionResult_err as u64
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_MAP_OK %out_poll_res, %poll_res, %map_fn
    __poll_option_ok_poll_tag_%out_poll_res = load %poll_res+PollOptionResult_poll_tag as u64
    __poll_option_ok_ready_%out_poll_res = eq __poll_option_ok_poll_tag_%out_poll_res, Poll_READY
    br __poll_option_ok_ready_%out_poll_res -> L_POLL_OPTION_RESULT_MAP_OK_READY_%out_poll_res, L_POLL_OPTION_RESULT_MAP_OK_PENDING_%out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_READY_%out_poll_res:
    __poll_option_ok_option_tag_%out_poll_res = load %poll_res+PollOptionResult_option_tag as u64
    __poll_option_ok_some_%out_poll_res = eq __poll_option_ok_option_tag_%out_poll_res, Option_SOME
    br __poll_option_ok_some_%out_poll_res -> L_POLL_OPTION_RESULT_MAP_OK_SOME_%out_poll_res, L_POLL_OPTION_RESULT_MAP_OK_NONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_SOME_%out_poll_res:
    __poll_option_ok_result_tag_%out_poll_res = load %poll_res+PollOptionResult_result_tag as u64
    __poll_option_ok_is_ok_%out_poll_res = eq __poll_option_ok_result_tag_%out_poll_res, Result_OK
    br __poll_option_ok_is_ok_%out_poll_res -> L_POLL_OPTION_RESULT_MAP_OK_OK_%out_poll_res, L_POLL_OPTION_RESULT_MAP_OK_ERR_%out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_OK_%out_poll_res:
    __poll_option_ok_value_%out_poll_res = load %poll_res+PollOptionResult_ok as u64
    __poll_option_ok_mapped_%out_poll_res = call %map_fn(__poll_option_ok_value_%out_poll_res)
    EXPAND POLL_OPTION_RESULT_READY_SOME_OK %out_poll_res, __poll_option_ok_mapped_%out_poll_res
    !__poll_option_ok_mapped_%out_poll_res
    !__poll_option_ok_value_%out_poll_res
    jmp L_POLL_OPTION_RESULT_MAP_OK_SOME_DONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_ERR_%out_poll_res:
    __poll_option_ok_err_%out_poll_res = load %poll_res+PollOptionResult_err as u64
    EXPAND POLL_OPTION_RESULT_READY_SOME_ERR %out_poll_res, __poll_option_ok_err_%out_poll_res
    !__poll_option_ok_err_%out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_SOME_DONE_%out_poll_res:
    !__poll_option_ok_is_ok_%out_poll_res
    !__poll_option_ok_result_tag_%out_poll_res
    jmp L_POLL_OPTION_RESULT_MAP_OK_READY_DONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_NONE_%out_poll_res:
    EXPAND POLL_OPTION_RESULT_READY_NONE %out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_READY_DONE_%out_poll_res:
    !__poll_option_ok_some_%out_poll_res
    !__poll_option_ok_option_tag_%out_poll_res
    jmp L_POLL_OPTION_RESULT_MAP_OK_DONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_PENDING_%out_poll_res:
    EXPAND POLL_OPTION_RESULT_PENDING %out_poll_res
L_POLL_OPTION_RESULT_MAP_OK_DONE_%out_poll_res:
    !__poll_option_ok_ready_%out_poll_res
    !__poll_option_ok_poll_tag_%out_poll_res
[END_MACRO]

[MACRO] POLL_OPTION_RESULT_MAP_ERR %out_poll_res, %poll_res, %map_fn
    __poll_option_err_poll_tag_%out_poll_res = load %poll_res+PollOptionResult_poll_tag as u64
    __poll_option_err_ready_%out_poll_res = eq __poll_option_err_poll_tag_%out_poll_res, Poll_READY
    br __poll_option_err_ready_%out_poll_res -> L_POLL_OPTION_RESULT_MAP_ERR_READY_%out_poll_res, L_POLL_OPTION_RESULT_MAP_ERR_PENDING_%out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_READY_%out_poll_res:
    __poll_option_err_option_tag_%out_poll_res = load %poll_res+PollOptionResult_option_tag as u64
    __poll_option_err_some_%out_poll_res = eq __poll_option_err_option_tag_%out_poll_res, Option_SOME
    br __poll_option_err_some_%out_poll_res -> L_POLL_OPTION_RESULT_MAP_ERR_SOME_%out_poll_res, L_POLL_OPTION_RESULT_MAP_ERR_NONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_SOME_%out_poll_res:
    __poll_option_err_result_tag_%out_poll_res = load %poll_res+PollOptionResult_result_tag as u64
    __poll_option_err_is_err_%out_poll_res = eq __poll_option_err_result_tag_%out_poll_res, Result_ERR
    br __poll_option_err_is_err_%out_poll_res -> L_POLL_OPTION_RESULT_MAP_ERR_ERR_%out_poll_res, L_POLL_OPTION_RESULT_MAP_ERR_OK_%out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_ERR_%out_poll_res:
    __poll_option_err_value_%out_poll_res = load %poll_res+PollOptionResult_err as u64
    __poll_option_err_mapped_%out_poll_res = call %map_fn(__poll_option_err_value_%out_poll_res)
    EXPAND POLL_OPTION_RESULT_READY_SOME_ERR %out_poll_res, __poll_option_err_mapped_%out_poll_res
    !__poll_option_err_mapped_%out_poll_res
    !__poll_option_err_value_%out_poll_res
    jmp L_POLL_OPTION_RESULT_MAP_ERR_SOME_DONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_OK_%out_poll_res:
    __poll_option_err_ok_%out_poll_res = load %poll_res+PollOptionResult_ok as u64
    EXPAND POLL_OPTION_RESULT_READY_SOME_OK %out_poll_res, __poll_option_err_ok_%out_poll_res
    !__poll_option_err_ok_%out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_SOME_DONE_%out_poll_res:
    !__poll_option_err_is_err_%out_poll_res
    !__poll_option_err_result_tag_%out_poll_res
    jmp L_POLL_OPTION_RESULT_MAP_ERR_READY_DONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_NONE_%out_poll_res:
    EXPAND POLL_OPTION_RESULT_READY_NONE %out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_READY_DONE_%out_poll_res:
    !__poll_option_err_some_%out_poll_res
    !__poll_option_err_option_tag_%out_poll_res
    jmp L_POLL_OPTION_RESULT_MAP_ERR_DONE_%out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_PENDING_%out_poll_res:
    EXPAND POLL_OPTION_RESULT_PENDING %out_poll_res
L_POLL_OPTION_RESULT_MAP_ERR_DONE_%out_poll_res:
    !__poll_option_err_ready_%out_poll_res
    !__poll_option_err_poll_tag_%out_poll_res
[END_MACRO]

[MACRO] POLL_BRANCH %poll_reg, %ready_label, %pending_label
    __poll_tag_%poll_reg = load %poll_reg+Poll_tag as u64
    __poll_is_ready_%poll_reg = eq __poll_tag_%poll_reg, Poll_READY
    br __poll_is_ready_%poll_reg -> L_POLL_BRANCH_READY_%poll_reg, L_POLL_BRANCH_PENDING_%poll_reg
L_POLL_BRANCH_READY_%poll_reg:
    !__poll_is_ready_%poll_reg
    !__poll_tag_%poll_reg
    jmp %ready_label
L_POLL_BRANCH_PENDING_%poll_reg:
    !__poll_is_ready_%poll_reg
    !__poll_tag_%poll_reg
    jmp %pending_label
[END_MACRO]

[MACRO] CONTEXT_NEW %out_ctx, %waker_reg, %data_ptr
    %out_ctx = alloc Context_SIZE
    store %out_ctx+Context_waker, %waker_reg as ptr
    store %out_ctx+Context_local_waker, %waker_reg as ptr
    store %out_ctx+Context_ext, 0 as ptr
    store %out_ctx+Context_data, %data_ptr as ptr
[END_MACRO]

[MACRO] CONTEXT_FROM_WAKER %out_ctx, %waker_reg
    __context_no_data_%out_ctx = 0 as ptr
    EXPAND CONTEXT_NEW %out_ctx, %waker_reg, __context_no_data_%out_ctx
    !__context_no_data_%out_ctx
[END_MACRO]

[MACRO] CONTEXT_WAKER %out_waker, %ctx_reg
    %out_waker = load %ctx_reg+Context_waker as ptr
[END_MACRO]

[MACRO] CONTEXT_LOCAL_WAKER %out_waker, %ctx_reg
    %out_waker = load %ctx_reg+Context_local_waker as ptr
[END_MACRO]

[MACRO] CONTEXT_EXT %out_ext, %ctx_reg
    %out_ext = load %ctx_reg+Context_ext as ptr
[END_MACRO]

[MACRO] CONTEXT_SET_EXT %ctx_reg, %ext_ptr
    store %ctx_reg+Context_ext, %ext_ptr as ptr
[END_MACRO]

[MACRO] CONTEXT_DATA %out_data, %ctx_reg
    %out_data = load %ctx_reg+Context_data as ptr
[END_MACRO]

[MACRO] CONTEXT_BUILDER_FROM_WAKER %out_builder, %waker_reg
    %out_builder = alloc ContextBuilder_SIZE
    store %out_builder+ContextBuilder_waker, %waker_reg as ptr
    store %out_builder+ContextBuilder_local_waker, %waker_reg as ptr
    store %out_builder+ContextBuilder_ext, 0 as ptr
    store %out_builder+ContextBuilder_data, 0 as ptr
[END_MACRO]

[MACRO] CONTEXT_BUILDER_FROM_CONTEXT %out_builder, %ctx_reg
    __ctx_builder_waker_%out_builder = load %ctx_reg+Context_waker as ptr
    __ctx_builder_local_%out_builder = load %ctx_reg+Context_local_waker as ptr
    __ctx_builder_ext_%out_builder = load %ctx_reg+Context_ext as ptr
    __ctx_builder_data_%out_builder = load %ctx_reg+Context_data as ptr
    %out_builder = alloc ContextBuilder_SIZE
    store %out_builder+ContextBuilder_waker, __ctx_builder_waker_%out_builder as ptr
    store %out_builder+ContextBuilder_local_waker, __ctx_builder_local_%out_builder as ptr
    store %out_builder+ContextBuilder_ext, __ctx_builder_ext_%out_builder as ptr
    store %out_builder+ContextBuilder_data, __ctx_builder_data_%out_builder as ptr
    !__ctx_builder_data_%out_builder
    !__ctx_builder_ext_%out_builder
    !__ctx_builder_local_%out_builder
    !__ctx_builder_waker_%out_builder
[END_MACRO]

[MACRO] CONTEXT_BUILDER_SET_WAKER %builder_reg, %waker_reg
    store %builder_reg+ContextBuilder_waker, %waker_reg as ptr
[END_MACRO]

[MACRO] CONTEXT_BUILDER_SET_LOCAL_WAKER %builder_reg, %local_waker_reg
    store %builder_reg+ContextBuilder_local_waker, %local_waker_reg as ptr
[END_MACRO]

[MACRO] CONTEXT_BUILDER_SET_EXT %builder_reg, %ext_ptr
    store %builder_reg+ContextBuilder_ext, %ext_ptr as ptr
[END_MACRO]

[MACRO] CONTEXT_BUILDER_SET_DATA %builder_reg, %data_ptr
    store %builder_reg+ContextBuilder_data, %data_ptr as ptr
[END_MACRO]

[MACRO] CONTEXT_BUILDER_BUILD %out_ctx, %builder_reg
    __ctx_builder_build_waker_%out_ctx = load %builder_reg+ContextBuilder_waker as ptr
    __ctx_builder_build_local_%out_ctx = load %builder_reg+ContextBuilder_local_waker as ptr
    __ctx_builder_build_ext_%out_ctx = load %builder_reg+ContextBuilder_ext as ptr
    __ctx_builder_build_data_%out_ctx = load %builder_reg+ContextBuilder_data as ptr
    %out_ctx = alloc Context_SIZE
    store %out_ctx+Context_waker, __ctx_builder_build_waker_%out_ctx as ptr
    store %out_ctx+Context_local_waker, __ctx_builder_build_local_%out_ctx as ptr
    store %out_ctx+Context_ext, __ctx_builder_build_ext_%out_ctx as ptr
    store %out_ctx+Context_data, __ctx_builder_build_data_%out_ctx as ptr
    !__ctx_builder_build_data_%out_ctx
    !__ctx_builder_build_ext_%out_ctx
    !__ctx_builder_build_local_%out_ctx
    !__ctx_builder_build_waker_%out_ctx
[END_MACRO]

[MACRO] FUTURE_NEW %out_future, %data_ptr, %vtable_ptr
    %out_future = alloc Future_SIZE
    store %out_future+Future_data, %data_ptr as ptr
    store %out_future+Future_vtable, %vtable_ptr as ptr
[END_MACRO]

[MACRO] FUTURE_READY_STATE_NEW %out_state, %value
    %out_state = alloc ReadyFuture_SIZE
    store %out_state+ReadyFuture_state, 1 as u64
    store %out_state+ReadyFuture_value, %value as u64
[END_MACRO]

[MACRO] FUTURE_PENDING_STATE_NEW %out_state
    %out_state = alloc PendingFuture_SIZE
    store %out_state+PendingFuture_marker, 0 as u64
[END_MACRO]

[MACRO] FUTURE_READY_STATE_INTO_INNER %out_value, %state_reg
    %out_value = load %state_reg+ReadyFuture_value as u64
    store %state_reg+ReadyFuture_state, 0 as u64
[END_MACRO]

[MACRO] FUTURE_READY_POLL_STATE %out_poll, %state_reg
    __future_ready_state_%out_poll = load %state_reg+ReadyFuture_state as u64
    __future_ready_available_%out_poll = eq __future_ready_state_%out_poll, 1
    br __future_ready_available_%out_poll -> L_FUTURE_READY_POLL_READY_%out_poll, L_FUTURE_READY_POLL_EMPTY_%out_poll
L_FUTURE_READY_POLL_READY_%out_poll:
    __future_ready_value_%out_poll = load %state_reg+ReadyFuture_value as u64
    store %state_reg+ReadyFuture_state, 0 as u64
    EXPAND POLL_READY %out_poll, __future_ready_value_%out_poll
    !__future_ready_value_%out_poll
    jmp L_FUTURE_READY_POLL_DONE_%out_poll
L_FUTURE_READY_POLL_EMPTY_%out_poll:
    EXPAND POLL_PENDING %out_poll
L_FUTURE_READY_POLL_DONE_%out_poll:
    !__future_ready_available_%out_poll
    !__future_ready_state_%out_poll
[END_MACRO]

[MACRO] FUTURE_READY_SET_POLL_STATE %out_poll_reg, %state_reg
    __future_ready_set_state_%out_poll_reg = load %state_reg+ReadyFuture_state as u64
    __future_ready_set_available_%out_poll_reg = eq __future_ready_set_state_%out_poll_reg, 1
    br __future_ready_set_available_%out_poll_reg -> L_FUTURE_READY_SET_READY_%out_poll_reg, L_FUTURE_READY_SET_EMPTY_%out_poll_reg
L_FUTURE_READY_SET_READY_%out_poll_reg:
    __future_ready_set_value_%out_poll_reg = load %state_reg+ReadyFuture_value as u64
    store %state_reg+ReadyFuture_state, 0 as u64
    EXPAND POLL_SET_READY %out_poll_reg, __future_ready_set_value_%out_poll_reg
    !__future_ready_set_value_%out_poll_reg
    jmp L_FUTURE_READY_SET_DONE_%out_poll_reg
L_FUTURE_READY_SET_EMPTY_%out_poll_reg:
    EXPAND POLL_SET_PENDING %out_poll_reg
L_FUTURE_READY_SET_DONE_%out_poll_reg:
    !__future_ready_set_available_%out_poll_reg
    !__future_ready_set_state_%out_poll_reg
[END_MACRO]

[MACRO] FUTURE_PENDING_POLL_STATE %out_poll, %state_reg
    EXPAND POLL_PENDING %out_poll
[END_MACRO]

[MACRO] FUTURE_PENDING_SET_POLL_STATE %out_poll_reg, %state_reg
    EXPAND POLL_SET_PENDING %out_poll_reg
[END_MACRO]

[MACRO] FUTURE_POLL_FN_STATE_NEW %out_state, %data_ptr, %vtable_ptr
    %out_state = alloc PollFnFuture_SIZE
    store %out_state+PollFnFuture_data, %data_ptr as ptr
    store %out_state+PollFnFuture_vtable, %vtable_ptr as ptr
[END_MACRO]

[MACRO] FUTURE_POLL_FN_STATE_POLL %out_poll, %state_reg, %ctx_reg
    __future_poll_fn_data_%out_poll = load %state_reg+PollFnFuture_data as ptr
    __future_poll_fn_vtable_%out_poll = load %state_reg+PollFnFuture_vtable as ptr
    __future_poll_fn_%out_poll = load __future_poll_fn_vtable_%out_poll+FuturePollSlot as ptr
    %out_poll = alloc Poll_SIZE
    call_indirect __future_poll_fn_%out_poll(&__future_poll_fn_data_%out_poll, &%ctx_reg, &%out_poll)
    !__future_poll_fn_%out_poll
    !__future_poll_fn_vtable_%out_poll
    !__future_poll_fn_data_%out_poll
[END_MACRO]

[MACRO] FUTURE_PAIR_NEW %out_pair, %left_value, %right_value
    %out_pair = alloc FuturePair_SIZE
    store %out_pair+FuturePair_left, %left_value as u64
    store %out_pair+FuturePair_right, %right_value as u64
[END_MACRO]

[MACRO] FUTURE_PAIR_LEFT %out_value, %pair_reg
    %out_value = load %pair_reg+FuturePair_left as u64
[END_MACRO]

[MACRO] FUTURE_PAIR_RIGHT %out_value, %pair_reg
    %out_value = load %pair_reg+FuturePair_right as u64
[END_MACRO]

[MACRO] FUTURE_EITHER_LEFT %out_either, %value
    %out_either = alloc FutureEither_SIZE
    store %out_either+FutureEither_side, FutureSelect_LEFT as u64
    store %out_either+FutureEither_left, %value as u64
    store %out_either+FutureEither_right, 0 as u64
[END_MACRO]

[MACRO] FUTURE_EITHER_RIGHT %out_either, %value
    %out_either = alloc FutureEither_SIZE
    store %out_either+FutureEither_side, FutureSelect_RIGHT as u64
    store %out_either+FutureEither_left, 0 as u64
    store %out_either+FutureEither_right, %value as u64
[END_MACRO]

[MACRO] FUTURE_EITHER_SIDE %out_side, %either_reg
    %out_side = load %either_reg+FutureEither_side as u64
[END_MACRO]

[MACRO] FUTURE_EITHER_LEFT_VALUE %out_value, %either_reg
    %out_value = load %either_reg+FutureEither_left as u64
[END_MACRO]

[MACRO] FUTURE_EITHER_RIGHT_VALUE %out_value, %either_reg
    %out_value = load %either_reg+FutureEither_right as u64
[END_MACRO]

[MACRO] FUTURE_JOIN2_STATE_NEW %out_state, %left_future, %right_future
    %out_state = alloc FutureJoin2State_SIZE
    store %out_state+FutureJoin2State_left, %left_future as ptr
    store %out_state+FutureJoin2State_right, %right_future as ptr
    store %out_state+FutureJoin2State_left_value, 0 as u64
    store %out_state+FutureJoin2State_right_value, 0 as u64
    store %out_state+FutureJoin2State_left_done, 0 as u64
    store %out_state+FutureJoin2State_right_done, 0 as u64
[END_MACRO]

[MACRO] FUTURE_JOIN2_STATE_POLL %out_poll, %join_state, %ctx_reg
    __future_join_state_left_done_%out_poll = load %join_state+FutureJoin2State_left_done as u64
    __future_join_state_left_pending_%out_poll = eq __future_join_state_left_done_%out_poll, 0
    br __future_join_state_left_pending_%out_poll -> L_FUTURE_JOIN2_STATE_POLL_LEFT_%out_poll, L_FUTURE_JOIN2_STATE_AFTER_LEFT_%out_poll
L_FUTURE_JOIN2_STATE_POLL_LEFT_%out_poll:
    __future_join_state_left_future_%out_poll = load %join_state+FutureJoin2State_left as ptr
    EXPAND FUTURE_POLL __future_join_state_left_poll_%out_poll, __future_join_state_left_future_%out_poll, %ctx_reg
    __future_join_state_left_tag_%out_poll = load __future_join_state_left_poll_%out_poll+Poll_tag as u64
    __future_join_state_left_ready_%out_poll = eq __future_join_state_left_tag_%out_poll, Poll_READY
    br __future_join_state_left_ready_%out_poll -> L_FUTURE_JOIN2_STATE_LEFT_READY_%out_poll, L_FUTURE_JOIN2_STATE_LEFT_PENDING_%out_poll
L_FUTURE_JOIN2_STATE_LEFT_READY_%out_poll:
    __future_join_state_left_value_%out_poll = load __future_join_state_left_poll_%out_poll+Poll_value as u64
    store %join_state+FutureJoin2State_left_value, __future_join_state_left_value_%out_poll as u64
    store %join_state+FutureJoin2State_left_done, 1 as u64
    !__future_join_state_left_value_%out_poll
L_FUTURE_JOIN2_STATE_LEFT_PENDING_%out_poll:
    !__future_join_state_left_ready_%out_poll
    !__future_join_state_left_tag_%out_poll
    !__future_join_state_left_poll_%out_poll
    !__future_join_state_left_future_%out_poll
L_FUTURE_JOIN2_STATE_AFTER_LEFT_%out_poll:
    __future_join_state_right_done_%out_poll = load %join_state+FutureJoin2State_right_done as u64
    __future_join_state_right_pending_%out_poll = eq __future_join_state_right_done_%out_poll, 0
    br __future_join_state_right_pending_%out_poll -> L_FUTURE_JOIN2_STATE_POLL_RIGHT_%out_poll, L_FUTURE_JOIN2_STATE_AFTER_RIGHT_%out_poll
L_FUTURE_JOIN2_STATE_POLL_RIGHT_%out_poll:
    __future_join_state_right_future_%out_poll = load %join_state+FutureJoin2State_right as ptr
    EXPAND FUTURE_POLL __future_join_state_right_poll_%out_poll, __future_join_state_right_future_%out_poll, %ctx_reg
    __future_join_state_right_tag_%out_poll = load __future_join_state_right_poll_%out_poll+Poll_tag as u64
    __future_join_state_right_ready_%out_poll = eq __future_join_state_right_tag_%out_poll, Poll_READY
    br __future_join_state_right_ready_%out_poll -> L_FUTURE_JOIN2_STATE_RIGHT_READY_%out_poll, L_FUTURE_JOIN2_STATE_RIGHT_PENDING_%out_poll
L_FUTURE_JOIN2_STATE_RIGHT_READY_%out_poll:
    __future_join_state_right_value_%out_poll = load __future_join_state_right_poll_%out_poll+Poll_value as u64
    store %join_state+FutureJoin2State_right_value, __future_join_state_right_value_%out_poll as u64
    store %join_state+FutureJoin2State_right_done, 1 as u64
    !__future_join_state_right_value_%out_poll
L_FUTURE_JOIN2_STATE_RIGHT_PENDING_%out_poll:
    !__future_join_state_right_ready_%out_poll
    !__future_join_state_right_tag_%out_poll
    !__future_join_state_right_poll_%out_poll
    !__future_join_state_right_future_%out_poll
L_FUTURE_JOIN2_STATE_AFTER_RIGHT_%out_poll:
    __future_join_state_left_done_now_%out_poll = load %join_state+FutureJoin2State_left_done as u64
    __future_join_state_right_done_now_%out_poll = load %join_state+FutureJoin2State_right_done as u64
    __future_join_state_all_ready_%out_poll = and __future_join_state_left_done_now_%out_poll, __future_join_state_right_done_now_%out_poll
    br __future_join_state_all_ready_%out_poll -> L_FUTURE_JOIN2_STATE_READY_%out_poll, L_FUTURE_JOIN2_STATE_PENDING_%out_poll
L_FUTURE_JOIN2_STATE_READY_%out_poll:
    __future_join_state_left_result_%out_poll = load %join_state+FutureJoin2State_left_value as u64
    __future_join_state_right_result_%out_poll = load %join_state+FutureJoin2State_right_value as u64
    EXPAND FUTURE_PAIR_NEW __future_join_state_pair_%out_poll, __future_join_state_left_result_%out_poll, __future_join_state_right_result_%out_poll
    EXPAND POLL_READY_PTR %out_poll, __future_join_state_pair_%out_poll
    ^__future_join_state_pair_%out_poll
    !__future_join_state_right_result_%out_poll
    !__future_join_state_left_result_%out_poll
    jmp L_FUTURE_JOIN2_STATE_DONE_%out_poll
L_FUTURE_JOIN2_STATE_PENDING_%out_poll:
    EXPAND POLL_PENDING %out_poll
L_FUTURE_JOIN2_STATE_DONE_%out_poll:
    !__future_join_state_all_ready_%out_poll
    !__future_join_state_right_done_now_%out_poll
    !__future_join_state_left_done_now_%out_poll
    !__future_join_state_right_pending_%out_poll
    !__future_join_state_right_done_%out_poll
    !__future_join_state_left_pending_%out_poll
    !__future_join_state_left_done_%out_poll
[END_MACRO]

[MACRO] FUTURE_SELECT2_STATE_NEW %out_state, %left_future, %right_future
    %out_state = alloc FutureSelect2State_SIZE
    store %out_state+FutureSelect2State_left, %left_future as ptr
    store %out_state+FutureSelect2State_right, %right_future as ptr
    store %out_state+FutureSelect2State_winner, FutureSelect_NONE as u64
[END_MACRO]

[MACRO] FUTURE_SELECT2_STATE_POLL %out_poll, %select_state, %ctx_reg
    __future_select_state_winner_%out_poll = load %select_state+FutureSelect2State_winner as u64
    __future_select_state_has_winner_%out_poll = ne __future_select_state_winner_%out_poll, FutureSelect_NONE
    br __future_select_state_has_winner_%out_poll -> L_FUTURE_SELECT2_STATE_DONE_ALREADY_%out_poll, L_FUTURE_SELECT2_STATE_POLL_LEFT_%out_poll
L_FUTURE_SELECT2_STATE_DONE_ALREADY_%out_poll:
    EXPAND POLL_PENDING %out_poll
    jmp L_FUTURE_SELECT2_STATE_DONE_%out_poll
L_FUTURE_SELECT2_STATE_POLL_LEFT_%out_poll:
    __future_select_state_left_%out_poll = load %select_state+FutureSelect2State_left as ptr
    EXPAND FUTURE_POLL __future_select_state_left_poll_%out_poll, __future_select_state_left_%out_poll, %ctx_reg
    __future_select_state_left_tag_%out_poll = load __future_select_state_left_poll_%out_poll+Poll_tag as u64
    __future_select_state_left_ready_%out_poll = eq __future_select_state_left_tag_%out_poll, Poll_READY
    br __future_select_state_left_ready_%out_poll -> L_FUTURE_SELECT2_STATE_LEFT_READY_%out_poll, L_FUTURE_SELECT2_STATE_POLL_RIGHT_%out_poll
L_FUTURE_SELECT2_STATE_LEFT_READY_%out_poll:
    __future_select_state_left_value_%out_poll = load __future_select_state_left_poll_%out_poll+Poll_value as u64
    store %select_state+FutureSelect2State_winner, FutureSelect_LEFT as u64
    EXPAND FUTURE_EITHER_LEFT __future_select_state_either_left_%out_poll, __future_select_state_left_value_%out_poll
    EXPAND POLL_READY_PTR %out_poll, __future_select_state_either_left_%out_poll
    ^__future_select_state_either_left_%out_poll
    !__future_select_state_left_value_%out_poll
    jmp L_FUTURE_SELECT2_STATE_LEFT_DONE_%out_poll
L_FUTURE_SELECT2_STATE_POLL_RIGHT_%out_poll:
    __future_select_state_right_%out_poll = load %select_state+FutureSelect2State_right as ptr
    EXPAND FUTURE_POLL __future_select_state_right_poll_%out_poll, __future_select_state_right_%out_poll, %ctx_reg
    __future_select_state_right_tag_%out_poll = load __future_select_state_right_poll_%out_poll+Poll_tag as u64
    __future_select_state_right_ready_%out_poll = eq __future_select_state_right_tag_%out_poll, Poll_READY
    br __future_select_state_right_ready_%out_poll -> L_FUTURE_SELECT2_STATE_RIGHT_READY_%out_poll, L_FUTURE_SELECT2_STATE_PENDING_%out_poll
L_FUTURE_SELECT2_STATE_RIGHT_READY_%out_poll:
    __future_select_state_right_value_%out_poll = load __future_select_state_right_poll_%out_poll+Poll_value as u64
    store %select_state+FutureSelect2State_winner, FutureSelect_RIGHT as u64
    EXPAND FUTURE_EITHER_RIGHT __future_select_state_either_right_%out_poll, __future_select_state_right_value_%out_poll
    EXPAND POLL_READY_PTR %out_poll, __future_select_state_either_right_%out_poll
    ^__future_select_state_either_right_%out_poll
    !__future_select_state_right_value_%out_poll
    jmp L_FUTURE_SELECT2_STATE_RIGHT_DONE_%out_poll
L_FUTURE_SELECT2_STATE_PENDING_%out_poll:
    EXPAND POLL_PENDING %out_poll
L_FUTURE_SELECT2_STATE_RIGHT_DONE_%out_poll:
    !__future_select_state_right_ready_%out_poll
    !__future_select_state_right_tag_%out_poll
    !__future_select_state_right_poll_%out_poll
    !__future_select_state_right_%out_poll
L_FUTURE_SELECT2_STATE_LEFT_DONE_%out_poll:
    !__future_select_state_left_ready_%out_poll
    !__future_select_state_left_tag_%out_poll
    !__future_select_state_left_poll_%out_poll
    !__future_select_state_left_%out_poll
L_FUTURE_SELECT2_STATE_DONE_%out_poll:
    !__future_select_state_has_winner_%out_poll
    !__future_select_state_winner_%out_poll
[END_MACRO]

[MACRO] FUTURE_GET_DATA %out_data, %future_reg
    %out_data = load %future_reg+Future_data as ptr
[END_MACRO]

[MACRO] FUTURE_GET_VTABLE %out_vtable, %future_reg
    %out_vtable = load %future_reg+Future_vtable as ptr
[END_MACRO]

[MACRO] FUTURE_POLL %out_poll, %future_reg, %ctx_reg
    __future_data_%out_poll = load %future_reg+Future_data as ptr
    __future_vtable_%out_poll = load %future_reg+Future_vtable as ptr
    __future_poll_fn_%out_poll = load __future_vtable_%out_poll+FuturePollSlot as ptr
    %out_poll = alloc Poll_SIZE
    call_indirect __future_poll_fn_%out_poll(&__future_data_%out_poll, &%ctx_reg, &%out_poll)
    !__future_poll_fn_%out_poll
    !__future_vtable_%out_poll
    !__future_data_%out_poll
[END_MACRO]

[MACRO] FUTURE_POLL_BRANCH %out_poll, %future_reg, %ctx_reg, %ready_label, %pending_label
    EXPAND FUTURE_POLL %out_poll, %future_reg, %ctx_reg
    EXPAND POLL_BRANCH %out_poll, %ready_label, %pending_label
[END_MACRO]

[MACRO] FUTURE_JOIN2_POLL %out_poll, %left_future, %right_future, %ctx_reg
    EXPAND FUTURE_POLL __future_join_left_%out_poll, %left_future, %ctx_reg
    EXPAND FUTURE_POLL __future_join_right_%out_poll, %right_future, %ctx_reg
    __future_join_left_ready_%out_poll = load __future_join_left_%out_poll+Poll_tag as u64
    __future_join_right_ready_%out_poll = load __future_join_right_%out_poll+Poll_tag as u64
    __future_join_left_ok_%out_poll = eq __future_join_left_ready_%out_poll, Poll_READY
    __future_join_right_ok_%out_poll = eq __future_join_right_ready_%out_poll, Poll_READY
    __future_join_ready_%out_poll = and __future_join_left_ok_%out_poll, __future_join_right_ok_%out_poll
    br __future_join_ready_%out_poll -> L_FUTURE_JOIN2_READY_%out_poll, L_FUTURE_JOIN2_PENDING_%out_poll
L_FUTURE_JOIN2_READY_%out_poll:
    __future_join_left_value_%out_poll = load __future_join_left_%out_poll+Poll_value as u64
    __future_join_right_value_%out_poll = load __future_join_right_%out_poll+Poll_value as u64
    __future_join_value_%out_poll = add __future_join_left_value_%out_poll, __future_join_right_value_%out_poll
    EXPAND POLL_READY %out_poll, __future_join_value_%out_poll
    !__future_join_value_%out_poll
    !__future_join_right_value_%out_poll
    !__future_join_left_value_%out_poll
    jmp L_FUTURE_JOIN2_DONE_%out_poll
L_FUTURE_JOIN2_PENDING_%out_poll:
    EXPAND POLL_PENDING %out_poll
L_FUTURE_JOIN2_DONE_%out_poll:
    !__future_join_ready_%out_poll
    !__future_join_right_ok_%out_poll
    !__future_join_left_ok_%out_poll
    !__future_join_right_ready_%out_poll
    !__future_join_left_ready_%out_poll
    !__future_join_right_%out_poll
    !__future_join_left_%out_poll
[END_MACRO]

[MACRO] FUTURE_SELECT2_POLL %out_poll, %left_future, %right_future, %ctx_reg, %out_side
    EXPAND FUTURE_POLL __future_select_left_%out_poll, %left_future, %ctx_reg
    __future_select_left_tag_%out_poll = load __future_select_left_%out_poll+Poll_tag as u64
    __future_select_left_ready_%out_poll = eq __future_select_left_tag_%out_poll, Poll_READY
    br __future_select_left_ready_%out_poll -> L_FUTURE_SELECT2_LEFT_%out_poll, L_FUTURE_SELECT2_TRY_RIGHT_%out_poll
L_FUTURE_SELECT2_LEFT_%out_poll:
    __future_select_left_value_%out_poll = load __future_select_left_%out_poll+Poll_value as u64
    EXPAND POLL_READY %out_poll, __future_select_left_value_%out_poll
    %out_side = add FutureSelect_LEFT, 0
    !__future_select_left_value_%out_poll
    jmp L_FUTURE_SELECT2_DONE_LEFT_%out_poll
L_FUTURE_SELECT2_TRY_RIGHT_%out_poll:
    EXPAND FUTURE_POLL __future_select_right_%out_poll, %right_future, %ctx_reg
    __future_select_right_tag_%out_poll = load __future_select_right_%out_poll+Poll_tag as u64
    __future_select_right_ready_%out_poll = eq __future_select_right_tag_%out_poll, Poll_READY
    br __future_select_right_ready_%out_poll -> L_FUTURE_SELECT2_RIGHT_%out_poll, L_FUTURE_SELECT2_PENDING_%out_poll
L_FUTURE_SELECT2_RIGHT_%out_poll:
    __future_select_right_value_%out_poll = load __future_select_right_%out_poll+Poll_value as u64
    EXPAND POLL_READY %out_poll, __future_select_right_value_%out_poll
    %out_side = add FutureSelect_RIGHT, 0
    !__future_select_right_value_%out_poll
    jmp L_FUTURE_SELECT2_DONE_RIGHT_%out_poll
L_FUTURE_SELECT2_PENDING_%out_poll:
    EXPAND POLL_PENDING %out_poll
    %out_side = add FutureSelect_NONE, 0
L_FUTURE_SELECT2_DONE_RIGHT_%out_poll:
    !__future_select_right_ready_%out_poll
    !__future_select_right_tag_%out_poll
    !__future_select_right_%out_poll
L_FUTURE_SELECT2_DONE_LEFT_%out_poll:
    !__future_select_left_ready_%out_poll
    !__future_select_left_tag_%out_poll
    !__future_select_left_%out_poll
[END_MACRO]
