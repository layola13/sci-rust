[MACRO] ASCII_CHAR_ESCAPE_DEFAULT_WRITE %out_ok, %out_len, %dst_ptr, %dst_len, %char_ptr
    __ascii_char_escape_byte_%out_ok = load %char_ptr+AsciiChar_value as u8
    EXPAND ASCII_ESCAPE_DEFAULT_WRITE %out_ok, %out_len, %dst_ptr, %dst_len, __ascii_char_escape_byte_%out_ok
    !__ascii_char_escape_byte_%out_ok
[END_MACRO]

[MACRO] ASCII_NIBBLE_TO_LOWER_HEX %out_byte, %nibble
    __ascii_hex_digit_%out_byte = ult %nibble, 10
    br __ascii_hex_digit_%out_byte -> L_ASCII_HEX_DIGIT_%out_byte, L_ASCII_HEX_ALPHA_%out_byte
L_ASCII_HEX_DIGIT_%out_byte:
    %out_byte = add ASCII_DIGIT_0, %nibble
    !__ascii_hex_digit_%out_byte
    jmp L_ASCII_HEX_END_%out_byte
L_ASCII_HEX_ALPHA_%out_byte:
    __ascii_hex_alpha_base_%out_byte = sub %nibble, 10
    %out_byte = add ASCII_LOWER_A, __ascii_hex_alpha_base_%out_byte
    !__ascii_hex_alpha_base_%out_byte
    !__ascii_hex_digit_%out_byte
L_ASCII_HEX_END_%out_byte:
[END_MACRO]

[MACRO] ASCII_ESCAPE_DEFAULT_WRITE %out_ok, %out_len, %dst_ptr, %dst_len, %byte
    __ascii_escape_pair_slot_%out_ok = stack_alloc 8
    __ascii_escape_is_tab_%out_ok = eq %byte, ASCII_TAB
    br __ascii_escape_is_tab_%out_ok -> L_ASCII_ESCAPE_TAB_%out_ok, L_ASCII_ESCAPE_CHECK_LF_%out_ok

L_ASCII_ESCAPE_CHECK_LF_%out_ok:
    __ascii_escape_is_lf_%out_ok = eq %byte, ASCII_LF
    br __ascii_escape_is_lf_%out_ok -> L_ASCII_ESCAPE_LF_%out_ok, L_ASCII_ESCAPE_CHECK_CR_%out_ok

L_ASCII_ESCAPE_CHECK_CR_%out_ok:
    __ascii_escape_is_cr_%out_ok = eq %byte, ASCII_CR
    br __ascii_escape_is_cr_%out_ok -> L_ASCII_ESCAPE_CR_%out_ok, L_ASCII_ESCAPE_CHECK_BACKSLASH_%out_ok

L_ASCII_ESCAPE_CHECK_BACKSLASH_%out_ok:
    __ascii_escape_is_backslash_%out_ok = eq %byte, ASCII_BACKSLASH
    br __ascii_escape_is_backslash_%out_ok -> L_ASCII_ESCAPE_BACKSLASH_%out_ok, L_ASCII_ESCAPE_CHECK_SINGLE_%out_ok

L_ASCII_ESCAPE_CHECK_SINGLE_%out_ok:
    __ascii_escape_is_single_%out_ok = eq %byte, ASCII_SINGLE_QUOTE
    br __ascii_escape_is_single_%out_ok -> L_ASCII_ESCAPE_SINGLE_%out_ok, L_ASCII_ESCAPE_CHECK_DOUBLE_%out_ok

L_ASCII_ESCAPE_CHECK_DOUBLE_%out_ok:
    __ascii_escape_is_double_%out_ok = eq %byte, ASCII_DOUBLE_QUOTE
    br __ascii_escape_is_double_%out_ok -> L_ASCII_ESCAPE_DOUBLE_%out_ok, L_ASCII_ESCAPE_CHECK_PRINTABLE_%out_ok

L_ASCII_ESCAPE_CHECK_PRINTABLE_%out_ok:
    __ascii_escape_ge_space_%out_ok = uge %byte, ASCII_SPACE
    __ascii_escape_le_tilde_%out_ok = ule %byte, ASCII_GRAPHIC_MAX
    __ascii_escape_printable_%out_ok = and __ascii_escape_ge_space_%out_ok, __ascii_escape_le_tilde_%out_ok
    br __ascii_escape_printable_%out_ok -> L_ASCII_ESCAPE_RAW_%out_ok, L_ASCII_ESCAPE_HEX_%out_ok

L_ASCII_ESCAPE_TAB_%out_ok:
    store __ascii_escape_pair_slot_%out_ok+0, ASCII_ESCAPE_T as u8
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_PAIR_%out_ok

L_ASCII_ESCAPE_LF_%out_ok:
    store __ascii_escape_pair_slot_%out_ok+0, ASCII_ESCAPE_N as u8
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_PAIR_%out_ok

L_ASCII_ESCAPE_CR_%out_ok:
    store __ascii_escape_pair_slot_%out_ok+0, ASCII_ESCAPE_R as u8
    !__ascii_escape_is_cr_%out_ok
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_PAIR_%out_ok

L_ASCII_ESCAPE_BACKSLASH_%out_ok:
    store __ascii_escape_pair_slot_%out_ok+0, ASCII_BACKSLASH as u8
    !__ascii_escape_is_backslash_%out_ok
    !__ascii_escape_is_cr_%out_ok
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_PAIR_%out_ok

L_ASCII_ESCAPE_SINGLE_%out_ok:
    store __ascii_escape_pair_slot_%out_ok+0, ASCII_SINGLE_QUOTE as u8
    !__ascii_escape_is_single_%out_ok
    !__ascii_escape_is_backslash_%out_ok
    !__ascii_escape_is_cr_%out_ok
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_PAIR_%out_ok

L_ASCII_ESCAPE_DOUBLE_%out_ok:
    store __ascii_escape_pair_slot_%out_ok+0, ASCII_DOUBLE_QUOTE as u8
    !__ascii_escape_is_double_%out_ok
    !__ascii_escape_is_single_%out_ok
    !__ascii_escape_is_backslash_%out_ok
    !__ascii_escape_is_cr_%out_ok
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_PAIR_%out_ok

L_ASCII_ESCAPE_PAIR_%out_ok:
    __ascii_pair_fits_%out_ok = uge %dst_len, 2
    br __ascii_pair_fits_%out_ok -> L_ASCII_ESCAPE_PAIR_WRITE_%out_ok, L_ASCII_ESCAPE_PAIR_FAIL_%out_ok
L_ASCII_ESCAPE_PAIR_WRITE_%out_ok:
    __ascii_pair_byte_%out_ok = load __ascii_escape_pair_slot_%out_ok+0 as u8
    store %dst_ptr+0, ASCII_BACKSLASH as u8
    __ascii_pair_p1_%out_ok = ptr_add %dst_ptr, 1
    store __ascii_pair_p1_%out_ok+0, __ascii_pair_byte_%out_ok as u8
    %out_len = add 0, 2
    %out_ok = add 0, 1
    !__ascii_pair_p1_%out_ok
    !__ascii_pair_byte_%out_ok
    !__ascii_pair_fits_%out_ok
    jmp L_ASCII_ESCAPE_END_%out_ok
L_ASCII_ESCAPE_PAIR_FAIL_%out_ok:
    %out_len = add 0, 0
    %out_ok = add 0, 0
    !__ascii_pair_fits_%out_ok
    jmp L_ASCII_ESCAPE_END_%out_ok

L_ASCII_ESCAPE_RAW_%out_ok:
    __ascii_escape_raw_fits_%out_ok = uge %dst_len, 1
    br __ascii_escape_raw_fits_%out_ok -> L_ASCII_ESCAPE_RAW_WRITE_%out_ok, L_ASCII_ESCAPE_FAIL_RAW_%out_ok
L_ASCII_ESCAPE_RAW_WRITE_%out_ok:
    store %dst_ptr+0, %byte as u8
    %out_len = add 0, 1
    %out_ok = add 0, 1
    !__ascii_escape_raw_fits_%out_ok
    !__ascii_escape_printable_%out_ok
    !__ascii_escape_le_tilde_%out_ok
    !__ascii_escape_ge_space_%out_ok
    !__ascii_escape_is_double_%out_ok
    !__ascii_escape_is_single_%out_ok
    !__ascii_escape_is_backslash_%out_ok
    !__ascii_escape_is_cr_%out_ok
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_END_%out_ok
L_ASCII_ESCAPE_FAIL_RAW_%out_ok:
    %out_len = add 0, 0
    %out_ok = add 0, 0
    !__ascii_escape_raw_fits_%out_ok
    !__ascii_escape_printable_%out_ok
    !__ascii_escape_le_tilde_%out_ok
    !__ascii_escape_ge_space_%out_ok
    !__ascii_escape_is_double_%out_ok
    !__ascii_escape_is_single_%out_ok
    !__ascii_escape_is_backslash_%out_ok
    !__ascii_escape_is_cr_%out_ok
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok
    jmp L_ASCII_ESCAPE_END_%out_ok

L_ASCII_ESCAPE_HEX_%out_ok:
    EXPAND ASCII_ESCAPE_DEFAULT_WRITE_HEX %out_ok, %out_len, %dst_ptr, %dst_len, %byte
    !__ascii_escape_printable_%out_ok
    !__ascii_escape_le_tilde_%out_ok
    !__ascii_escape_ge_space_%out_ok
    !__ascii_escape_is_double_%out_ok
    !__ascii_escape_is_single_%out_ok
    !__ascii_escape_is_backslash_%out_ok
    !__ascii_escape_is_cr_%out_ok
    !__ascii_escape_is_lf_%out_ok
    !__ascii_escape_is_tab_%out_ok

L_ASCII_ESCAPE_END_%out_ok:
[END_MACRO]

[MACRO] ASCII_ESCAPE_DEFAULT_WRITE_PAIR %out_ok, %out_len, %dst_ptr, %dst_len, %escaped_byte
    __ascii_pair_fits_%out_ok = uge %dst_len, 2
    br __ascii_pair_fits_%out_ok -> L_ASCII_ESCAPE_PAIR_WRITE_%out_ok, L_ASCII_ESCAPE_PAIR_FAIL_%out_ok
L_ASCII_ESCAPE_PAIR_WRITE_%out_ok:
    store %dst_ptr+0, ASCII_BACKSLASH as u8
    __ascii_pair_p1_%out_ok = ptr_add %dst_ptr, 1
    store __ascii_pair_p1_%out_ok+0, %escaped_byte as u8
    %out_len = add 0, 2
    %out_ok = add 0, 1
    !__ascii_pair_p1_%out_ok
    !__ascii_pair_fits_%out_ok
    jmp L_ASCII_ESCAPE_PAIR_END_%out_ok
L_ASCII_ESCAPE_PAIR_FAIL_%out_ok:
    %out_len = add 0, 0
    %out_ok = add 0, 0
    !__ascii_pair_fits_%out_ok
L_ASCII_ESCAPE_PAIR_END_%out_ok:
[END_MACRO]

[MACRO] ASCII_ESCAPE_DEFAULT_WRITE_HEX %out_ok, %out_len, %dst_ptr, %dst_len, %byte
    __ascii_hex_fits_%out_ok = uge %dst_len, 4
    br __ascii_hex_fits_%out_ok -> L_ASCII_ESCAPE_HEX_WRITE_%out_ok, L_ASCII_ESCAPE_HEX_FAIL_%out_ok
L_ASCII_ESCAPE_HEX_WRITE_%out_ok:
    __ascii_hex_hi_raw_%out_ok = shr %byte, 4
    __ascii_hex_hi_%out_ok = and __ascii_hex_hi_raw_%out_ok, 15
    __ascii_hex_lo_%out_ok = and %byte, 15
    EXPAND ASCII_NIBBLE_TO_LOWER_HEX __ascii_hex_hi_byte_%out_ok, __ascii_hex_hi_%out_ok
    EXPAND ASCII_NIBBLE_TO_LOWER_HEX __ascii_hex_lo_byte_%out_ok, __ascii_hex_lo_%out_ok
    store %dst_ptr+0, ASCII_BACKSLASH as u8
    __ascii_hex_p1_%out_ok = ptr_add %dst_ptr, 1
    __ascii_hex_p2_%out_ok = ptr_add %dst_ptr, 2
    __ascii_hex_p3_%out_ok = ptr_add %dst_ptr, 3
    store __ascii_hex_p1_%out_ok+0, ASCII_ESCAPE_X as u8
    store __ascii_hex_p2_%out_ok+0, __ascii_hex_hi_byte_%out_ok as u8
    store __ascii_hex_p3_%out_ok+0, __ascii_hex_lo_byte_%out_ok as u8
    %out_len = add 0, 4
    %out_ok = add 0, 1
    !__ascii_hex_p3_%out_ok
    !__ascii_hex_p2_%out_ok
    !__ascii_hex_p1_%out_ok
    !__ascii_hex_lo_byte_%out_ok
    !__ascii_hex_hi_byte_%out_ok
    !__ascii_hex_lo_%out_ok
    !__ascii_hex_hi_%out_ok
    !__ascii_hex_hi_raw_%out_ok
    !__ascii_hex_fits_%out_ok
    jmp L_ASCII_ESCAPE_HEX_END_%out_ok
L_ASCII_ESCAPE_HEX_FAIL_%out_ok:
    %out_len = add 0, 0
    %out_ok = add 0, 0
    !__ascii_hex_fits_%out_ok
L_ASCII_ESCAPE_HEX_END_%out_ok:
[END_MACRO]
