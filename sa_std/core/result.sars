@import "result.sal"
@import "option.sal"
@import "panic.sars"

@const RESULT_UNWRAP_PANIC = utf8:"called Result::unwrap() on an Err value"
@const RESULT_UNWRAP_ERR_PANIC = utf8:"called Result::unwrap_err() on an Ok value"

[MACRO] RESULT_NEW_OK %out_res, %value
    %out_res = alloc Result_SIZE
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, %value as u64
    store %out_res+Result_err, 0 as u64
[END_MACRO]

[MACRO] RESULT_NEW_ERR %out_res, %err
    %out_res = alloc Result_SIZE
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, %err as u64
[END_MACRO]

// Rust constructor-name bare alias over RESULT_NEW_OK.
[MACRO] RESULT_OK %out_res, %value
    EXPAND RESULT_NEW_OK %out_res, %value
[END_MACRO]

// Rust constructor-name bare alias over RESULT_NEW_ERR.
[MACRO] RESULT_ERR %out_res, %err
    EXPAND RESULT_NEW_ERR %out_res, %err
[END_MACRO]

[MACRO] RESULT_DEFAULT %out_res
    %out_res = alloc Result_SIZE
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, 0 as u64
[END_MACRO]

[MACRO] RESULT_IS_OK %out_bool, %res_reg
    __result_tag_%out_bool = load %res_reg+Result_tag as u64
    %out_bool = eq __result_tag_%out_bool, Result_OK
    !__result_tag_%out_bool
[END_MACRO]

[MACRO] RESULT_IS_ERR %out_bool, %res_reg
    __result_tag_%out_bool = load %res_reg+Result_tag as u64
    %out_bool = eq __result_tag_%out_bool, Result_ERR
    !__result_tag_%out_bool
[END_MACRO]

[MACRO] RESULT_GET_OK %out_value, %res_reg
    %out_value = load %res_reg+Result_ok as u64
[END_MACRO]

[MACRO] RESULT_GET_ERR %out_value, %res_reg
    %out_value = load %res_reg+Result_err as u64
[END_MACRO]

[MACRO] RESULT_AS_REF %out_res, %res_reg
    %out_res = alloc Result_SIZE
    __result_as_ref_tag_%out_res = load %res_reg+Result_tag as u64
    __result_as_ref_ok_%out_res = eq __result_as_ref_tag_%out_res, Result_OK
    br __result_as_ref_ok_%out_res -> L_RESULT_AS_REF_OK_%out_res, L_RESULT_AS_REF_ERR_%out_res
L_RESULT_AS_REF_OK_%out_res:
    __result_as_ref_ok_ptr_%out_res = ptr_add %res_reg, Result_ok
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, __result_as_ref_ok_ptr_%out_res as ptr
    store %out_res+Result_err, 0 as u64
    !__result_as_ref_ok_ptr_%out_res
    !__result_as_ref_ok_%out_res
    !__result_as_ref_tag_%out_res
    jmp L_RESULT_AS_REF_END_%out_res
L_RESULT_AS_REF_ERR_%out_res:
    __result_as_ref_err_ptr_%out_res = ptr_add %res_reg, Result_err
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __result_as_ref_err_ptr_%out_res as ptr
    !__result_as_ref_err_ptr_%out_res
    !__result_as_ref_ok_%out_res
    !__result_as_ref_tag_%out_res
L_RESULT_AS_REF_END_%out_res:
[END_MACRO]

[MACRO] RESULT_AS_MUT %out_res, %res_reg
    EXPAND RESULT_AS_REF %out_res, %res_reg
[END_MACRO]

[MACRO] RESULT_COPIED_U64 %out_res, %res_reg
    %out_res = alloc Result_SIZE
    __result_copied_tag_%out_res = load %res_reg+Result_tag as u64
    __result_copied_ok_%out_res = eq __result_copied_tag_%out_res, Result_OK
    br __result_copied_ok_%out_res -> L_RESULT_COPIED_OK_%out_res, L_RESULT_COPIED_ERR_%out_res
L_RESULT_COPIED_OK_%out_res:
    __result_copied_ok_ptr_%out_res = load %res_reg+Result_ok as ptr
    __result_copied_ok_value_%out_res = load __result_copied_ok_ptr_%out_res+0 as u64
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, __result_copied_ok_value_%out_res as u64
    store %out_res+Result_err, 0 as u64
    !__result_copied_ok_value_%out_res
    !__result_copied_ok_ptr_%out_res
    !__result_copied_ok_%out_res
    !__result_copied_tag_%out_res
    jmp L_RESULT_COPIED_END_%out_res
L_RESULT_COPIED_ERR_%out_res:
    __result_copied_err_ptr_%out_res = load %res_reg+Result_err as ptr
    __result_copied_err_value_%out_res = load __result_copied_err_ptr_%out_res+0 as u64
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __result_copied_err_value_%out_res as u64
    !__result_copied_err_value_%out_res
    !__result_copied_err_ptr_%out_res
    !__result_copied_ok_%out_res
    !__result_copied_tag_%out_res
L_RESULT_COPIED_END_%out_res:
[END_MACRO]

// Rust method-name alias over RESULT_COPIED_U64.
[MACRO] RESULT_COPIED %out_res, %res_reg
    EXPAND RESULT_COPIED_U64 %out_res, %res_reg
[END_MACRO]

[MACRO] RESULT_CLONED_U64 %out_res, %res_reg
    EXPAND RESULT_COPIED_U64 %out_res, %res_reg
[END_MACRO]

// Rust method-name alias over RESULT_CLONED_U64.
[MACRO] RESULT_CLONED %out_res, %res_reg
    EXPAND RESULT_CLONED_U64 %out_res, %res_reg
[END_MACRO]

[MACRO] RESULT_COPY %out_res, %res_reg
    %out_res = alloc Result_SIZE
    __result_copy_tag_%out_res = load %res_reg+Result_tag as u64
    __result_copy_ok_%out_res = load %res_reg+Result_ok as u64
    __result_copy_err_%out_res = load %res_reg+Result_err as u64
    store %out_res+Result_tag, __result_copy_tag_%out_res as u64
    store %out_res+Result_ok, __result_copy_ok_%out_res as u64
    store %out_res+Result_err, __result_copy_err_%out_res as u64
    !__result_copy_err_%out_res
    !__result_copy_ok_%out_res
    !__result_copy_tag_%out_res
[END_MACRO]

[MACRO] RESULT_IS_OK_AND %out_bool, %res_reg, %pred_fn
    __result_ok_and_tag_%out_bool = load %res_reg+Result_tag as u64
    __result_ok_and_ok_%out_bool = eq __result_ok_and_tag_%out_bool, Result_OK
    br __result_ok_and_ok_%out_bool -> L_RESULT_OK_AND_OK_%out_bool, L_RESULT_OK_AND_ERR_%out_bool
L_RESULT_OK_AND_OK_%out_bool:
    __result_ok_and_value_%out_bool = load %res_reg+Result_ok as u64
    __result_ok_and_pred_%out_bool = call %pred_fn(__result_ok_and_value_%out_bool)
    %out_bool = ne __result_ok_and_pred_%out_bool, 0
    !__result_ok_and_pred_%out_bool
    !__result_ok_and_value_%out_bool
    !__result_ok_and_ok_%out_bool
    !__result_ok_and_tag_%out_bool
    jmp L_RESULT_OK_AND_END_%out_bool
L_RESULT_OK_AND_ERR_%out_bool:
    %out_bool = add 0, 0
    !__result_ok_and_ok_%out_bool
    !__result_ok_and_tag_%out_bool
L_RESULT_OK_AND_END_%out_bool:
[END_MACRO]

[MACRO] RESULT_IS_ERR_AND %out_bool, %res_reg, %pred_fn
    __result_err_and_tag_%out_bool = load %res_reg+Result_tag as u64
    __result_err_and_err_%out_bool = eq __result_err_and_tag_%out_bool, Result_ERR
    br __result_err_and_err_%out_bool -> L_RESULT_ERR_AND_ERR_%out_bool, L_RESULT_ERR_AND_OK_%out_bool
L_RESULT_ERR_AND_ERR_%out_bool:
    __result_err_and_value_%out_bool = load %res_reg+Result_err as u64
    __result_err_and_pred_%out_bool = call %pred_fn(__result_err_and_value_%out_bool)
    %out_bool = ne __result_err_and_pred_%out_bool, 0
    !__result_err_and_pred_%out_bool
    !__result_err_and_value_%out_bool
    !__result_err_and_err_%out_bool
    !__result_err_and_tag_%out_bool
    jmp L_RESULT_ERR_AND_END_%out_bool
L_RESULT_ERR_AND_OK_%out_bool:
    %out_bool = add 0, 0
    !__result_err_and_err_%out_bool
    !__result_err_and_tag_%out_bool
L_RESULT_ERR_AND_END_%out_bool:
[END_MACRO]

[MACRO] RESULT_UNWRAP_OR %out_value, %res_reg, %default_value
    __result_tag_%out_value = load %res_reg+Result_tag as u64
    __result_is_ok_%out_value = eq __result_tag_%out_value, Result_OK
    br __result_is_ok_%out_value -> L_RESULT_UNWRAP_OR_OK_%out_value, L_RESULT_UNWRAP_OR_ERR_%out_value
L_RESULT_UNWRAP_OR_OK_%out_value:
    %out_value = load %res_reg+Result_ok as u64
    !__result_tag_%out_value
    jmp L_RESULT_UNWRAP_OR_END_%out_value
L_RESULT_UNWRAP_OR_ERR_%out_value:
    %out_value = add %default_value, 0
    !__result_tag_%out_value
L_RESULT_UNWRAP_OR_END_%out_value:
[END_MACRO]

[MACRO] RESULT_UNWRAP_OR_ELSE %out_value, %res_reg, %default_fn
    __result_unwrap_else_tag_%out_value = load %res_reg+Result_tag as u64
    __result_unwrap_else_ok_%out_value = eq __result_unwrap_else_tag_%out_value, Result_OK
    br __result_unwrap_else_ok_%out_value -> L_RESULT_UNWRAP_ELSE_OK_%out_value, L_RESULT_UNWRAP_ELSE_ERR_%out_value
L_RESULT_UNWRAP_ELSE_OK_%out_value:
    %out_value = load %res_reg+Result_ok as u64
    !__result_unwrap_else_ok_%out_value
    !__result_unwrap_else_tag_%out_value
    jmp L_RESULT_UNWRAP_ELSE_END_%out_value
L_RESULT_UNWRAP_ELSE_ERR_%out_value:
    __result_unwrap_else_err_%out_value = load %res_reg+Result_err as u64
    %out_value = call %default_fn(__result_unwrap_else_err_%out_value)
    !__result_unwrap_else_err_%out_value
    !__result_unwrap_else_ok_%out_value
    !__result_unwrap_else_tag_%out_value
L_RESULT_UNWRAP_ELSE_END_%out_value:
[END_MACRO]

[MACRO] RESULT_UNWRAP_OR_DEFAULT %out_value, %res_reg
    EXPAND RESULT_UNWRAP_OR %out_value, %res_reg, 0
[END_MACRO]

[MACRO] RESULT_RETURN_ERR %res_reg, %err_value
    store %res_reg+Result_tag, Result_ERR as u64
    store %res_reg+Result_ok, 0 as u64
    store %res_reg+Result_err, %err_value as u64
    return %res_reg
[END_MACRO]

[MACRO] TRY_RESULT %out_value, %res_reg
    __try_result_tag_%out_value = load %res_reg+Result_tag as u64
    __try_result_is_ok_%out_value = eq __try_result_tag_%out_value, Result_OK
    br __try_result_is_ok_%out_value -> L_TRY_RESULT_OK_%out_value, L_TRY_RESULT_ERR_%out_value
L_TRY_RESULT_OK_%out_value:
    %out_value = load %res_reg+Result_ok as u64
    !__try_result_is_ok_%out_value
    !__try_result_tag_%out_value
    jmp L_TRY_RESULT_END_%out_value
L_TRY_RESULT_ERR_%out_value:
    !__try_result_is_ok_%out_value
    !__try_result_tag_%out_value
    return %res_reg
L_TRY_RESULT_END_%out_value:
[END_MACRO]

[MACRO] TRY_RESULT_RETURN %out_value, %res_reg
    EXPAND TRY_RESULT %out_value, %res_reg
[END_MACRO]

[MACRO] RESULT_MAP_OK %out_value, %res_reg, %map_fn
    __result_tag_%out_value = load %res_reg+Result_tag as u64
    __result_is_ok_%out_value = eq __result_tag_%out_value, Result_OK
    br __result_is_ok_%out_value -> L_RESULT_MAP_OK_OK_%out_value, L_RESULT_MAP_OK_ERR_%out_value
L_RESULT_MAP_OK_OK_%out_value:
    __result_value_%out_value = load %res_reg+Result_ok as u64
    %out_value = call %map_fn(__result_value_%out_value)
    !__result_value_%out_value
    !__result_tag_%out_value
    jmp L_RESULT_MAP_OK_END_%out_value
L_RESULT_MAP_OK_ERR_%out_value:
    %out_value = add 0, 0
    !__result_tag_%out_value
L_RESULT_MAP_OK_END_%out_value:
[END_MACRO]

[MACRO] RESULT_MAP %out_res, %res_reg, %map_fn
    %out_res = alloc Result_SIZE
    __result_map_tag_%out_res = load %res_reg+Result_tag as u64
    __result_map_ok_%out_res = eq __result_map_tag_%out_res, Result_OK
    br __result_map_ok_%out_res -> L_RESULT_MAP_OK_%out_res, L_RESULT_MAP_ERR_%out_res
L_RESULT_MAP_OK_%out_res:
    __result_map_value_%out_res = load %res_reg+Result_ok as u64
    __result_map_mapped_%out_res = call %map_fn(__result_map_value_%out_res)
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, __result_map_mapped_%out_res as u64
    store %out_res+Result_err, 0 as u64
    !__result_map_mapped_%out_res
    !__result_map_value_%out_res
    !__result_map_ok_%out_res
    !__result_map_tag_%out_res
    jmp L_RESULT_MAP_END_%out_res
L_RESULT_MAP_ERR_%out_res:
    __result_map_err_%out_res = load %res_reg+Result_err as u64
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __result_map_err_%out_res as u64
    !__result_map_err_%out_res
    !__result_map_ok_%out_res
    !__result_map_tag_%out_res
L_RESULT_MAP_END_%out_res:
[END_MACRO]

[MACRO] RESULT_INSPECT %out_res, %res_reg, %inspect_fn
    __result_inspect_tag_%out_res = load %res_reg+Result_tag as u64
    __result_inspect_ok_%out_res = eq __result_inspect_tag_%out_res, Result_OK
    br __result_inspect_ok_%out_res -> L_RESULT_INSPECT_OK_%out_res, L_RESULT_INSPECT_SKIP_%out_res
L_RESULT_INSPECT_OK_%out_res:
    __result_inspect_value_%out_res = load %res_reg+Result_ok as u64
    __result_inspect_ignored_%out_res = call %inspect_fn(__result_inspect_value_%out_res)
    !__result_inspect_ignored_%out_res
    !__result_inspect_value_%out_res
    jmp L_RESULT_INSPECT_COPY_%out_res
L_RESULT_INSPECT_SKIP_%out_res:
    jmp L_RESULT_INSPECT_COPY_%out_res
L_RESULT_INSPECT_COPY_%out_res:
    EXPAND RESULT_COPY %out_res, %res_reg
    !__result_inspect_ok_%out_res
    !__result_inspect_tag_%out_res
[END_MACRO]

[MACRO] RESULT_INSPECT_ERR %out_res, %res_reg, %inspect_fn
    __result_inspect_err_tag_%out_res = load %res_reg+Result_tag as u64
    __result_inspect_err_is_err_%out_res = eq __result_inspect_err_tag_%out_res, Result_ERR
    br __result_inspect_err_is_err_%out_res -> L_RESULT_INSPECT_ERR_ERR_%out_res, L_RESULT_INSPECT_ERR_SKIP_%out_res
L_RESULT_INSPECT_ERR_ERR_%out_res:
    __result_inspect_err_value_%out_res = load %res_reg+Result_err as u64
    __result_inspect_err_ignored_%out_res = call %inspect_fn(__result_inspect_err_value_%out_res)
    !__result_inspect_err_ignored_%out_res
    !__result_inspect_err_value_%out_res
    jmp L_RESULT_INSPECT_ERR_COPY_%out_res
L_RESULT_INSPECT_ERR_SKIP_%out_res:
    jmp L_RESULT_INSPECT_ERR_COPY_%out_res
L_RESULT_INSPECT_ERR_COPY_%out_res:
    EXPAND RESULT_COPY %out_res, %res_reg
    !__result_inspect_err_is_err_%out_res
    !__result_inspect_err_tag_%out_res
[END_MACRO]

[MACRO] RESULT_MAP_ERR_RESULT %out_res, %res_reg, %map_fn
    %out_res = alloc Result_SIZE
    __result_map_err_tag_%out_res = load %res_reg+Result_tag as u64
    __result_map_err_is_err_%out_res = eq __result_map_err_tag_%out_res, Result_ERR
    br __result_map_err_is_err_%out_res -> L_RESULT_MAP_ERR_RESULT_ERR_%out_res, L_RESULT_MAP_ERR_RESULT_OK_%out_res
L_RESULT_MAP_ERR_RESULT_ERR_%out_res:
    __result_map_err_value_%out_res = load %res_reg+Result_err as u64
    __result_map_err_mapped_%out_res = call %map_fn(__result_map_err_value_%out_res)
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __result_map_err_mapped_%out_res as u64
    !__result_map_err_mapped_%out_res
    !__result_map_err_value_%out_res
    !__result_map_err_is_err_%out_res
    !__result_map_err_tag_%out_res
    jmp L_RESULT_MAP_ERR_RESULT_END_%out_res
L_RESULT_MAP_ERR_RESULT_OK_%out_res:
    __result_map_err_ok_%out_res = load %res_reg+Result_ok as u64
    store %out_res+Result_tag, Result_OK as u64
    store %out_res+Result_ok, __result_map_err_ok_%out_res as u64
    store %out_res+Result_err, 0 as u64
    !__result_map_err_ok_%out_res
    !__result_map_err_is_err_%out_res
    !__result_map_err_tag_%out_res
L_RESULT_MAP_ERR_RESULT_END_%out_res:
[END_MACRO]

[MACRO] RESULT_AND %out_res, %res_reg, %other_res
    __result_and_tag_%out_res = load %res_reg+Result_tag as u64
    __result_and_ok_%out_res = eq __result_and_tag_%out_res, Result_OK
    br __result_and_ok_%out_res -> L_RESULT_AND_OTHER_%out_res, L_RESULT_AND_ERR_%out_res
L_RESULT_AND_OTHER_%out_res:
    EXPAND RESULT_COPY %out_res, %other_res
    !__result_and_ok_%out_res
    !__result_and_tag_%out_res
    jmp L_RESULT_AND_END_%out_res
L_RESULT_AND_ERR_%out_res:
    %out_res = alloc Result_SIZE
    __result_and_err_%out_res = load %res_reg+Result_err as u64
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __result_and_err_%out_res as u64
    !__result_and_err_%out_res
    !__result_and_ok_%out_res
    !__result_and_tag_%out_res
L_RESULT_AND_END_%out_res:
[END_MACRO]

[MACRO] RESULT_OR %out_res, %res_reg, %other_res
    __result_or_tag_%out_res = load %res_reg+Result_tag as u64
    __result_or_ok_%out_res = eq __result_or_tag_%out_res, Result_OK
    br __result_or_ok_%out_res -> L_RESULT_OR_SELF_%out_res, L_RESULT_OR_OTHER_%out_res
L_RESULT_OR_SELF_%out_res:
    EXPAND RESULT_COPY %out_res, %res_reg
    !__result_or_ok_%out_res
    !__result_or_tag_%out_res
    jmp L_RESULT_OR_END_%out_res
L_RESULT_OR_OTHER_%out_res:
    EXPAND RESULT_COPY %out_res, %other_res
    !__result_or_ok_%out_res
    !__result_or_tag_%out_res
L_RESULT_OR_END_%out_res:
[END_MACRO]

[MACRO] RESULT_AND_THEN %out_res, %res_reg, %then_fn
    __result_then_tag_%out_res = load %res_reg+Result_tag as u64
    __result_then_ok_%out_res = eq __result_then_tag_%out_res, Result_OK
    br __result_then_ok_%out_res -> L_RESULT_AND_THEN_OK_%out_res, L_RESULT_AND_THEN_ERR_%out_res
L_RESULT_AND_THEN_OK_%out_res:
    __result_then_value_%out_res = load %res_reg+Result_ok as u64
    %out_res = call %then_fn(__result_then_value_%out_res)
    !__result_then_value_%out_res
    !__result_then_ok_%out_res
    !__result_then_tag_%out_res
    jmp L_RESULT_AND_THEN_END_%out_res
L_RESULT_AND_THEN_ERR_%out_res:
    %out_res = alloc Result_SIZE
    __result_then_err_%out_res = load %res_reg+Result_err as u64
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __result_then_err_%out_res as u64
    !__result_then_err_%out_res
    !__result_then_ok_%out_res
    !__result_then_tag_%out_res
L_RESULT_AND_THEN_END_%out_res:
[END_MACRO]

[MACRO] RESULT_OR_ELSE %out_res, %res_reg, %else_fn
    __result_or_else_tag_%out_res = load %res_reg+Result_tag as u64
    __result_or_else_ok_%out_res = eq __result_or_else_tag_%out_res, Result_OK
    br __result_or_else_ok_%out_res -> L_RESULT_OR_ELSE_SELF_%out_res, L_RESULT_OR_ELSE_DEFAULT_%out_res
L_RESULT_OR_ELSE_SELF_%out_res:
    EXPAND RESULT_COPY %out_res, %res_reg
    !__result_or_else_ok_%out_res
    !__result_or_else_tag_%out_res
    jmp L_RESULT_OR_ELSE_END_%out_res
L_RESULT_OR_ELSE_DEFAULT_%out_res:
    __result_or_else_err_%out_res = load %res_reg+Result_err as u64
    %out_res = call %else_fn(__result_or_else_err_%out_res)
    !__result_or_else_err_%out_res
    !__result_or_else_ok_%out_res
    !__result_or_else_tag_%out_res
L_RESULT_OR_ELSE_END_%out_res:
[END_MACRO]

[MACRO] RESULT_OK_TO_OPTION %out_opt, %res_reg
    %out_opt = alloc Option_SIZE
    __result_ok_option_tag_%out_opt = load %res_reg+Result_tag as u64
    __result_ok_option_ok_%out_opt = eq __result_ok_option_tag_%out_opt, Result_OK
    br __result_ok_option_ok_%out_opt -> L_RESULT_OK_TO_OPTION_SOME_%out_opt, L_RESULT_OK_TO_OPTION_NONE_%out_opt
L_RESULT_OK_TO_OPTION_SOME_%out_opt:
    __result_ok_option_value_%out_opt = load %res_reg+Result_ok as u64
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __result_ok_option_value_%out_opt as u64
    !__result_ok_option_value_%out_opt
    !__result_ok_option_ok_%out_opt
    !__result_ok_option_tag_%out_opt
    jmp L_RESULT_OK_TO_OPTION_END_%out_opt
L_RESULT_OK_TO_OPTION_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
    !__result_ok_option_ok_%out_opt
    !__result_ok_option_tag_%out_opt
L_RESULT_OK_TO_OPTION_END_%out_opt:
[END_MACRO]

[MACRO] RESULT_ERR_TO_OPTION %out_opt, %res_reg
    %out_opt = alloc Option_SIZE
    __result_err_option_tag_%out_opt = load %res_reg+Result_tag as u64
    __result_err_option_err_%out_opt = eq __result_err_option_tag_%out_opt, Result_ERR
    br __result_err_option_err_%out_opt -> L_RESULT_ERR_TO_OPTION_SOME_%out_opt, L_RESULT_ERR_TO_OPTION_NONE_%out_opt
L_RESULT_ERR_TO_OPTION_SOME_%out_opt:
    __result_err_option_value_%out_opt = load %res_reg+Result_err as u64
    store %out_opt+Option_tag, Option_SOME as u64
