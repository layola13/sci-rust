[MACRO] RESULT_UNWRAP %out_value, %res_reg
    __result_tag_%out_value = load %res_reg+Result_tag as u64
    __result_is_ok_%out_value = eq __result_tag_%out_value, Result_OK
    br __result_is_ok_%out_value -> L_RESULT_UNWRAP_OK_%out_value, L_RESULT_UNWRAP_ERR_%out_value
L_RESULT_UNWRAP_OK_%out_value:
    %out_value = load %res_reg+Result_ok as u64
    !__result_tag_%out_value
    !__result_is_ok_%out_value
    jmp L_RESULT_UNWRAP_END_%out_value
L_RESULT_UNWRAP_ERR_%out_value:
    EXPAND PANIC_MSG 17, *RESULT_UNWRAP_PANIC, 39
    %out_value = add 0, 0
    !__result_is_ok_%out_value
    !__result_tag_%out_value
L_RESULT_UNWRAP_END_%out_value:
[END_MACRO]

[MACRO] RESULT_EXPECT %out_value, %res_reg, %msg_ptr, %msg_len
    __result_expect_tag_%out_value = load %res_reg+Result_tag as u64
    __result_expect_ok_%out_value = eq __result_expect_tag_%out_value, Result_OK
    br __result_expect_ok_%out_value -> L_RESULT_EXPECT_OK_%out_value, L_RESULT_EXPECT_ERR_%out_value
L_RESULT_EXPECT_OK_%out_value:
    %out_value = load %res_reg+Result_ok as u64
    !__result_expect_ok_%out_value
    !__result_expect_tag_%out_value
    jmp L_RESULT_EXPECT_END_%out_value
L_RESULT_EXPECT_ERR_%out_value:
    EXPAND PANIC_MSG 17, %msg_ptr, %msg_len
    %out_value = add 0, 0
L_RESULT_EXPECT_END_%out_value:
[END_MACRO]

[MACRO] RESULT_UNWRAP_UNCHECKED %out_value, %res_reg
    %out_value = load %res_reg+Result_ok as u64
[END_MACRO]

[MACRO] RESULT_INTO_OK %out_value, %res_reg
    EXPAND RESULT_UNWRAP %out_value, %res_reg
[END_MACRO]

[MACRO] RESULT_UNWRAP_ERR %out_value, %res_reg
    __result_tag_%out_value = load %res_reg+Result_tag as u64
    __result_is_err_%out_value = eq __result_tag_%out_value, Result_ERR
    br __result_is_err_%out_value -> L_RESULT_UNWRAP_ERR_ERR_%out_value, L_RESULT_UNWRAP_ERR_OK_%out_value
L_RESULT_UNWRAP_ERR_ERR_%out_value:
    %out_value = load %res_reg+Result_err as u64
    !__result_tag_%out_value
    jmp L_RESULT_UNWRAP_ERR_END_%out_value
L_RESULT_UNWRAP_ERR_OK_%out_value:
    EXPAND PANIC_MSG 17, *RESULT_UNWRAP_ERR_PANIC, 42
    %out_value = add 0, 0
L_RESULT_UNWRAP_ERR_END_%out_value:
[END_MACRO]

[MACRO] RESULT_EXPECT_ERR %out_value, %res_reg, %msg_ptr, %msg_len
    __result_expect_err_tag_%out_value = load %res_reg+Result_tag as u64
    __result_expect_err_is_err_%out_value = eq __result_expect_err_tag_%out_value, Result_ERR
    br __result_expect_err_is_err_%out_value -> L_RESULT_EXPECT_ERR_ERR_%out_value, L_RESULT_EXPECT_ERR_OK_%out_value
L_RESULT_EXPECT_ERR_ERR_%out_value:
    %out_value = load %res_reg+Result_err as u64
    !__result_expect_err_is_err_%out_value
    !__result_expect_err_tag_%out_value
    jmp L_RESULT_EXPECT_ERR_END_%out_value
L_RESULT_EXPECT_ERR_OK_%out_value:
    EXPAND PANIC_MSG 17, %msg_ptr, %msg_len
    %out_value = add 0, 0
L_RESULT_EXPECT_ERR_END_%out_value:
[END_MACRO]

[MACRO] RESULT_UNWRAP_ERR_UNCHECKED %out_value, %res_reg
    %out_value = load %res_reg+Result_err as u64
[END_MACRO]

[MACRO] RESULT_INTO_ERR %out_value, %res_reg
    EXPAND RESULT_UNWRAP_ERR %out_value, %res_reg
[END_MACRO]

[MACRO] RESULT_MAP_OR %out_value, %res_reg, %map_fn, %default_value
    __result_tag_%out_value = load %res_reg+Result_tag as u64
    __result_is_ok_%out_value = eq __result_tag_%out_value, Result_OK
    br __result_is_ok_%out_value -> L_RESULT_MAP_OR_OK_%out_value, L_RESULT_MAP_OR_ERR_%out_value
L_RESULT_MAP_OR_OK_%out_value:
    __result_value_%out_value = load %res_reg+Result_ok as u64
    %out_value = call %map_fn(__result_value_%out_value)
    !__result_value_%out_value
    !__result_tag_%out_value
    jmp L_RESULT_MAP_OR_END_%out_value
L_RESULT_MAP_OR_ERR_%out_value:
    %out_value = add %default_value, 0
    !__result_tag_%out_value
L_RESULT_MAP_OR_END_%out_value:
[END_MACRO]

[MACRO] RESULT_MAP_OR_ELSE %out_value, %res_reg, %map_fn, %default_fn
    __result_tag_%out_value = load %res_reg+Result_tag as u64
    __result_is_ok_%out_value = eq __result_tag_%out_value, Result_OK
    br __result_is_ok_%out_value -> L_RESULT_MAP_OR_ELSE_OK_%out_value, L_RESULT_MAP_OR_ELSE_ERR_%out_value
L_RESULT_MAP_OR_ELSE_OK_%out_value:
    __result_value_%out_value = load %res_reg+Result_ok as u64
    %out_value = call %map_fn(__result_value_%out_value)
    !__result_value_%out_value
    !__result_tag_%out_value
    jmp L_RESULT_MAP_OR_ELSE_END_%out_value
L_RESULT_MAP_OR_ELSE_ERR_%out_value:
    %out_value = call %default_fn()
    !__result_tag_%out_value
L_RESULT_MAP_OR_ELSE_END_%out_value:
[END_MACRO]

[MACRO] RESULT_MAP_OR_DEFAULT %out_value, %res_reg, %map_fn
    EXPAND RESULT_MAP_OR %out_value, %res_reg, %map_fn, 0
[END_MACRO]

[MACRO] RESULT_SET_OK %res_reg, %value
    store %res_reg+Result_tag, Result_OK as u64
    store %res_reg+Result_ok, %value as u64
    store %res_reg+Result_err, 0 as u64
[END_MACRO]

[MACRO] RESULT_SET_ERR %res_reg, %err
    store %res_reg+Result_tag, Result_ERR as u64
    store %res_reg+Result_ok, 0 as u64
    store %res_reg+Result_err, %err as u64
[END_MACRO]

[MACRO] RESULT_FLATTEN %out_res, %res_reg
    %out_res = alloc Result_SIZE
    __result_flatten_tag_%out_res = load %res_reg+Result_tag as u64
    __result_flatten_ok_%out_res = eq __result_flatten_tag_%out_res, Result_OK
    br __result_flatten_ok_%out_res -> L_RESULT_FLATTEN_OK_%out_res, L_RESULT_FLATTEN_ERR_%out_res
L_RESULT_FLATTEN_OK_%out_res:
    __result_flatten_inner_%out_res = load %res_reg+Result_ok as ptr
    __result_flatten_inner_tag_%out_res = load __result_flatten_inner_%out_res+Result_tag as u64
    __result_flatten_inner_ok_%out_res = load __result_flatten_inner_%out_res+Result_ok as u64
    __result_flatten_inner_err_%out_res = load __result_flatten_inner_%out_res+Result_err as u64
    store %out_res+Result_tag, __result_flatten_inner_tag_%out_res as u64
    store %out_res+Result_ok, __result_flatten_inner_ok_%out_res as u64
    store %out_res+Result_err, __result_flatten_inner_err_%out_res as u64
    !__result_flatten_inner_err_%out_res
    !__result_flatten_inner_ok_%out_res
    !__result_flatten_inner_tag_%out_res
    !__result_flatten_inner_%out_res
    !__result_flatten_ok_%out_res
    !__result_flatten_tag_%out_res
    jmp L_RESULT_FLATTEN_END_%out_res
L_RESULT_FLATTEN_ERR_%out_res:
    __result_flatten_err_%out_res = load %res_reg+Result_err as u64
    store %out_res+Result_tag, Result_ERR as u64
    store %out_res+Result_ok, 0 as u64
    store %out_res+Result_err, __result_flatten_err_%out_res as u64
    !__result_flatten_err_%out_res
    !__result_flatten_ok_%out_res
    !__result_flatten_tag_%out_res
L_RESULT_FLATTEN_END_%out_res:
[END_MACRO]

[MACRO] RESULT_TRANSPOSE %out_opt, %res_reg
    %out_opt = alloc Option_SIZE
    __result_transpose_tag_%out_opt = load %res_reg+Result_tag as u64
    __result_transpose_ok_%out_opt = eq __result_transpose_tag_%out_opt, Result_OK
    br __result_transpose_ok_%out_opt -> L_RESULT_TRANSPOSE_OK_%out_opt, L_RESULT_TRANSPOSE_ERR_%out_opt
L_RESULT_TRANSPOSE_OK_%out_opt:
    __result_transpose_inner_opt_%out_opt = load %res_reg+Result_ok as ptr
    __result_transpose_inner_tag_%out_opt = load __result_transpose_inner_opt_%out_opt+Option_tag as u64
    __result_transpose_inner_some_%out_opt = eq __result_transpose_inner_tag_%out_opt, Option_SOME
    br __result_transpose_inner_some_%out_opt -> L_RESULT_TRANSPOSE_SOME_%out_opt, L_RESULT_TRANSPOSE_NONE_%out_opt
L_RESULT_TRANSPOSE_SOME_%out_opt:
    __result_transpose_value_%out_opt = load __result_transpose_inner_opt_%out_opt+Option_value as u64
    __result_transpose_result_%out_opt = alloc Result_SIZE
    store __result_transpose_result_%out_opt+Result_tag, Result_OK as u64
    store __result_transpose_result_%out_opt+Result_ok, __result_transpose_value_%out_opt as u64
    store __result_transpose_result_%out_opt+Result_err, 0 as u64
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __result_transpose_result_%out_opt as ptr
    !__result_transpose_result_%out_opt
    !__result_transpose_value_%out_opt
    !__result_transpose_inner_some_%out_opt
    !__result_transpose_inner_tag_%out_opt
    !__result_transpose_inner_opt_%out_opt
    !__result_transpose_ok_%out_opt
    !__result_transpose_tag_%out_opt
    jmp L_RESULT_TRANSPOSE_END_%out_opt
L_RESULT_TRANSPOSE_NONE_%out_opt:
    store %out_opt+Option_tag, Option_NONE as u64
    store %out_opt+Option_value, 0 as u64
    !__result_transpose_inner_some_%out_opt
    !__result_transpose_inner_tag_%out_opt
    !__result_transpose_inner_opt_%out_opt
    !__result_transpose_ok_%out_opt
    !__result_transpose_tag_%out_opt
    jmp L_RESULT_TRANSPOSE_END_%out_opt
L_RESULT_TRANSPOSE_ERR_%out_opt:
    __result_transpose_err_%out_opt = load %res_reg+Result_err as u64
    __result_transpose_err_result_%out_opt = alloc Result_SIZE
    store __result_transpose_err_result_%out_opt+Result_tag, Result_ERR as u64
    store __result_transpose_err_result_%out_opt+Result_ok, 0 as u64
    store __result_transpose_err_result_%out_opt+Result_err, __result_transpose_err_%out_opt as u64
    store %out_opt+Option_tag, Option_SOME as u64
    store %out_opt+Option_value, __result_transpose_err_result_%out_opt as ptr
    !__result_transpose_err_result_%out_opt
    !__result_transpose_err_%out_opt
    !__result_transpose_ok_%out_opt
    !__result_transpose_tag_%out_opt
L_RESULT_TRANSPOSE_END_%out_opt:
[END_MACRO]

[MACRO] RESULT_BRANCH %res_reg, %ok_label, %err_label
    __result_tag_%res_reg = load %res_reg+Result_tag as u64
    __result_is_ok_%res_reg = eq __result_tag_%res_reg, Result_OK
    br __result_is_ok_%res_reg -> %ok_label, %err_label
    !__result_tag_%res_reg
[END_MACRO]

[MACRO] MATCH_RESULT %out_value, %res_reg, %ok_label, %err_label
    __match_result_tag_%out_value = load %res_reg+Result_tag as u64
    __match_result_is_ok_%out_value = eq __match_result_tag_%out_value, Result_OK
    br __match_result_is_ok_%out_value -> L_MATCH_RESULT_OK_%out_value, L_MATCH_RESULT_ERR_%out_value
L_MATCH_RESULT_OK_%out_value:
    %out_value = load %res_reg+Result_ok as u64
    !__match_result_tag_%out_value
    jmp %ok_label
L_MATCH_RESULT_ERR_%out_value:
    %out_value = load %res_reg+Result_err as u64
    !__match_result_tag_%out_value
    jmp %err_label
[END_MACRO]

[MACRO] RESULT_MATCH_OK_ERR %out_value, %res_reg, %ok_label, %err_label
    EXPAND MATCH_RESULT %out_value, %res_reg, %ok_label, %err_label
[END_MACRO]

[MACRO] MATCHES_RESULT %out_bool, %res_reg, %expected_tag
    __matches_result_tag_%out_bool = load %res_reg+Result_tag as u64
    %out_bool = eq __matches_result_tag_%out_bool, %expected_tag
    !__matches_result_tag_%out_bool
[END_MACRO]
