@import "task.sal"
@import "future.sal"
@import "future.sars"

[MACRO] TASK_NEW %out_task, %future_reg, %ctx_reg
    %out_task = alloc Task_SIZE
    store %out_task+Task_future, %future_reg as ptr
    store %out_task+Task_context, %ctx_reg as ptr
    store %out_task+Task_result, 0 as u64
    store %out_task+Task_state, Task_PENDING as u64
[END_MACRO]

[MACRO] TASK_STATE %out_state, %task_reg
    %out_state = load %task_reg+Task_state as u64
[END_MACRO]

[MACRO] TASK_RESULT %out_value, %task_reg
    %out_value = load %task_reg+Task_result as u64
[END_MACRO]

[MACRO] TASK_IS_READY %out_bool, %task_reg
    __task_state_%out_bool = load %task_reg+Task_state as u64
    %out_bool = eq __task_state_%out_bool, Task_READY
    !__task_state_%out_bool
[END_MACRO]

[MACRO] TASK_POLL %out_poll, %task_reg
    __task_future_%out_poll = load %task_reg+Task_future as ptr
    __task_context_%out_poll = load %task_reg+Task_context as ptr
    EXPAND FUTURE_POLL %out_poll, __task_future_%out_poll, __task_context_%out_poll
    __task_poll_tag_%out_poll = load %out_poll+Poll_tag as u64
    __task_poll_ready_%out_poll = eq __task_poll_tag_%out_poll, Poll_READY
    br __task_poll_ready_%out_poll -> L_TASK_POLL_READY_%out_poll, L_TASK_POLL_PENDING_%out_poll
L_TASK_POLL_READY_%out_poll:
    __task_poll_value_%out_poll = load %out_poll+Poll_value as u64
    store %task_reg+Task_result, __task_poll_value_%out_poll as u64
    store %task_reg+Task_state, Task_READY as u64
    !__task_poll_value_%out_poll
    jmp L_TASK_POLL_DONE_%out_poll
L_TASK_POLL_PENDING_%out_poll:
    store %task_reg+Task_state, Task_PENDING as u64
L_TASK_POLL_DONE_%out_poll:
    !__task_poll_ready_%out_poll
    !__task_poll_tag_%out_poll
    !__task_context_%out_poll
    !__task_future_%out_poll
[END_MACRO]

[MACRO] EXECUTOR_NEW %out_executor, %tasks_ptr, %len
    %out_executor = alloc Executor_SIZE
    store %out_executor+Executor_tasks, %tasks_ptr as ptr
    store %out_executor+Executor_len, %len as u64
[END_MACRO]

[MACRO] EXECUTOR_POLL_ONE %out_poll, %executor_reg, %index
    __executor_tasks_%out_poll = load %executor_reg+Executor_tasks as ptr
    __executor_off_%out_poll = mul %index, 8
    __executor_slot_%out_poll = ptr_add __executor_tasks_%out_poll, __executor_off_%out_poll
    __executor_task_%out_poll = load __executor_slot_%out_poll+0 as ptr
    EXPAND TASK_POLL %out_poll, __executor_task_%out_poll
    !__executor_task_%out_poll
    !__executor_slot_%out_poll
    !__executor_off_%out_poll
    !__executor_tasks_%out_poll
[END_MACRO]

[MACRO] EXECUTOR_POLL_READY_COUNT %out_count, %executor_reg
    __executor_tasks_%out_count = load %executor_reg+Executor_tasks as ptr
    __executor_len_%out_count = load %executor_reg+Executor_len as u64
    __executor_index_slot_%out_count = stack_alloc 8
    store __executor_index_slot_%out_count+0, 0 as u64
    __executor_count_slot_%out_count = stack_alloc 8
    store __executor_count_slot_%out_count+0, 0 as u64
    jmp L_EXECUTOR_POLL_ALL_COND_%out_count
L_EXECUTOR_POLL_ALL_COND_%out_count:
    __executor_index_%out_count = load __executor_index_slot_%out_count+0 as u64
    __executor_done_%out_count = eq __executor_index_%out_count, __executor_len_%out_count
    br __executor_done_%out_count -> L_EXECUTOR_POLL_ALL_DONE_%out_count, L_EXECUTOR_POLL_ALL_BODY_%out_count
L_EXECUTOR_POLL_ALL_BODY_%out_count:
    __executor_off_%out_count = mul __executor_index_%out_count, 8
    __executor_slot_%out_count = ptr_add __executor_tasks_%out_count, __executor_off_%out_count
    __executor_task_%out_count = load __executor_slot_%out_count+0 as ptr
    EXPAND TASK_POLL __executor_poll_%out_count, __executor_task_%out_count
    __executor_poll_tag_%out_count = load __executor_poll_%out_count+Poll_tag as u64
    __executor_poll_ready_%out_count = eq __executor_poll_tag_%out_count, Poll_READY
    br __executor_poll_ready_%out_count -> L_EXECUTOR_POLL_ALL_READY_%out_count, L_EXECUTOR_POLL_ALL_NEXT_%out_count
L_EXECUTOR_POLL_ALL_READY_%out_count:
    __executor_count_%out_count = load __executor_count_slot_%out_count+0 as u64
    __executor_next_count_%out_count = add __executor_count_%out_count, 1
    store __executor_count_slot_%out_count+0, __executor_next_count_%out_count as u64
    !__executor_next_count_%out_count
    !__executor_count_%out_count
L_EXECUTOR_POLL_ALL_NEXT_%out_count:
    __executor_next_index_%out_count = add __executor_index_%out_count, 1
    store __executor_index_slot_%out_count+0, __executor_next_index_%out_count as u64
    !__executor_next_index_%out_count
    !__executor_poll_ready_%out_count
    !__executor_poll_tag_%out_count
    !__executor_poll_%out_count
    !__executor_task_%out_count
    !__executor_slot_%out_count
    !__executor_off_%out_count
    !__executor_done_%out_count
    !__executor_index_%out_count
    jmp L_EXECUTOR_POLL_ALL_COND_%out_count
L_EXECUTOR_POLL_ALL_DONE_%out_count:
    %out_count = load __executor_count_slot_%out_count+0 as u64
    !__executor_done_%out_count
    !__executor_index_%out_count
    !__executor_len_%out_count
    !__executor_tasks_%out_count
[END_MACRO]
