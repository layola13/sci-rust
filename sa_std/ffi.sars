@import "ffi.sal"
@import "core/mem.sars"
@import "core/slice.sars"
@import "string.sai"
@import "string.sars"
@import "hash.sars"

[MACRO] CSTR_FROM_PARTS_UNCHECKED %cstr_reg, %ptr_reg, %len_with_nul
    EXPAND SLICE_NEW %cstr_reg, %ptr_reg, %len_with_nul
[END_MACRO]

[MACRO] CSTR_FROM_PTR %cstr_reg, %ptr_reg
    EXPAND CSTR_LEN __cstr_from_ptr_len_%cstr_reg, %ptr_reg
    __cstr_from_ptr_len_nul_%cstr_reg = add __cstr_from_ptr_len_%cstr_reg, 1
    EXPAND SLICE_NEW %cstr_reg, %ptr_reg, __cstr_from_ptr_len_nul_%cstr_reg
    !__cstr_from_ptr_len_nul_%cstr_reg
    !__cstr_from_ptr_len_%cstr_reg
[END_MACRO]

[MACRO] CSTR_LEN %out_len, %ptr_reg
    __cstr_len_slot_%out_len = stack_alloc 8
    store __cstr_len_slot_%out_len+0, 0 as u64
    jmp L_CSTR_LEN_HEAD_%out_len

L_CSTR_LEN_HEAD_%out_len:
    __cstr_len_i_%out_len = load __cstr_len_slot_%out_len+0 as u64
    __cstr_len_p_%out_len = ptr_add %ptr_reg, __cstr_len_i_%out_len
    __cstr_len_b_%out_len = load __cstr_len_p_%out_len+0 as u8
    __cstr_len_done_%out_len = eq __cstr_len_b_%out_len, 0
    br __cstr_len_done_%out_len -> L_CSTR_LEN_DONE_%out_len, L_CSTR_LEN_NEXT_%out_len

L_CSTR_LEN_NEXT_%out_len:
    __cstr_len_next_%out_len = add __cstr_len_i_%out_len, 1
    store __cstr_len_slot_%out_len+0, __cstr_len_next_%out_len as u64
    !__cstr_len_next_%out_len
    !__cstr_len_done_%out_len
    !__cstr_len_b_%out_len
    !__cstr_len_p_%out_len
    !__cstr_len_i_%out_len
    jmp L_CSTR_LEN_HEAD_%out_len

L_CSTR_LEN_DONE_%out_len:
    %out_len = load __cstr_len_slot_%out_len+0 as u64
    !__cstr_len_done_%out_len
    !__cstr_len_b_%out_len
    !__cstr_len_p_%out_len
    !__cstr_len_i_%out_len
[END_MACRO]

[MACRO] CSTR_FROM_BYTES_WITH_NUL %out_status, %cstr_reg, %slice_reg
    __cstr_bytes_ptr_%out_status = load %slice_reg+Slice_ptr as ptr
    __cstr_bytes_len_%out_status = load %slice_reg+Slice_len as u64
    __cstr_bytes_empty_%out_status = eq __cstr_bytes_len_%out_status, 0
    br __cstr_bytes_empty_%out_status -> L_CSTR_BYTES_NOT_TERM_%out_status, L_CSTR_BYTES_SCAN_INIT_%out_status

L_CSTR_BYTES_SCAN_INIT_%out_status:
    __cstr_bytes_idx_slot_%out_status = stack_alloc 8
    store __cstr_bytes_idx_slot_%out_status+0, 0 as u64
    jmp L_CSTR_BYTES_SCAN_HEAD_%out_status

L_CSTR_BYTES_SCAN_HEAD_%out_status:
    __cstr_bytes_idx_%out_status = load __cstr_bytes_idx_slot_%out_status+0 as u64
    __cstr_bytes_done_scan_%out_status = eq __cstr_bytes_idx_%out_status, __cstr_bytes_len_%out_status
    br __cstr_bytes_done_scan_%out_status -> L_CSTR_BYTES_NOT_TERM_SCAN_%out_status, L_CSTR_BYTES_SCAN_BODY_%out_status

L_CSTR_BYTES_SCAN_BODY_%out_status:
    __cstr_bytes_p_%out_status = ptr_add __cstr_bytes_ptr_%out_status, __cstr_bytes_idx_%out_status
    __cstr_bytes_b_%out_status = load __cstr_bytes_p_%out_status+0 as u8
    __cstr_bytes_is_nul_%out_status = eq __cstr_bytes_b_%out_status, 0
    br __cstr_bytes_is_nul_%out_status -> L_CSTR_BYTES_FOUND_NUL_%out_status, L_CSTR_BYTES_SCAN_NEXT_%out_status

L_CSTR_BYTES_SCAN_NEXT_%out_status:
    __cstr_bytes_next_%out_status = add __cstr_bytes_idx_%out_status, 1
    store __cstr_bytes_idx_slot_%out_status+0, __cstr_bytes_next_%out_status as u64
    !__cstr_bytes_next_%out_status
    !__cstr_bytes_is_nul_%out_status
    !__cstr_bytes_b_%out_status
    !__cstr_bytes_p_%out_status
    !__cstr_bytes_done_scan_%out_status
    !__cstr_bytes_idx_%out_status
    jmp L_CSTR_BYTES_SCAN_HEAD_%out_status

L_CSTR_BYTES_FOUND_NUL_%out_status:
    __cstr_bytes_last_index_%out_status = sub __cstr_bytes_len_%out_status, 1
    __cstr_bytes_at_end_%out_status = eq __cstr_bytes_idx_%out_status, __cstr_bytes_last_index_%out_status
    br __cstr_bytes_at_end_%out_status -> L_CSTR_BYTES_OK_%out_status, L_CSTR_BYTES_INTERIOR_%out_status

L_CSTR_BYTES_OK_%out_status:
    EXPAND SLICE_NEW %cstr_reg, __cstr_bytes_ptr_%out_status, __cstr_bytes_len_%out_status
    %out_status = add 0, CSTR_FROM_BYTES_OK
    !__cstr_bytes_at_end_%out_status
    !__cstr_bytes_last_index_%out_status
    !__cstr_bytes_is_nul_%out_status
    !__cstr_bytes_b_%out_status
    !__cstr_bytes_p_%out_status
    !__cstr_bytes_done_scan_%out_status
    !__cstr_bytes_idx_%out_status
    !__cstr_bytes_empty_%out_status
    !__cstr_bytes_len_%out_status
    !__cstr_bytes_ptr_%out_status
    jmp L_CSTR_BYTES_END_%out_status

L_CSTR_BYTES_INTERIOR_%out_status:
    %out_status = add 0, CSTR_FROM_BYTES_INTERIOR_NUL
    __cstr_bytes_null_%out_status = 0 as ptr
    EXPAND SLICE_NEW %cstr_reg, __cstr_bytes_null_%out_status, 0
    !__cstr_bytes_null_%out_status
    !__cstr_bytes_at_end_%out_status
    !__cstr_bytes_last_index_%out_status
    !__cstr_bytes_is_nul_%out_status
    !__cstr_bytes_b_%out_status
    !__cstr_bytes_p_%out_status
    !__cstr_bytes_done_scan_%out_status
    !__cstr_bytes_idx_%out_status
    !__cstr_bytes_empty_%out_status
    !__cstr_bytes_len_%out_status
    !__cstr_bytes_ptr_%out_status
    jmp L_CSTR_BYTES_END_%out_status

L_CSTR_BYTES_NOT_TERM_SCAN_%out_status:
    !__cstr_bytes_done_scan_%out_status
    !__cstr_bytes_idx_%out_status
    jmp L_CSTR_BYTES_NOT_TERM_%out_status

L_CSTR_BYTES_NOT_TERM_%out_status:
    %out_status = add 0, CSTR_FROM_BYTES_NOT_NUL_TERMINATED
    __cstr_bytes_null2_%out_status = 0 as ptr
    EXPAND SLICE_NEW %cstr_reg, __cstr_bytes_null2_%out_status, 0
    !__cstr_bytes_null2_%out_status
    !__cstr_bytes_empty_%out_status
    !__cstr_bytes_len_%out_status
    !__cstr_bytes_ptr_%out_status

L_CSTR_BYTES_END_%out_status:
[END_MACRO]

[MACRO] CSTR_VALIDATE_WITH_NUL_DETAIL %out_status, %out_pos, %slice_reg
    __cstr_detail_ptr_%out_status = load %slice_reg+Slice_ptr as ptr
    __cstr_detail_len_%out_status = load %slice_reg+Slice_len as u64
    __cstr_detail_empty_%out_status = eq __cstr_detail_len_%out_status, 0
    br __cstr_detail_empty_%out_status -> L_CSTR_DETAIL_NOT_TERM_%out_status, L_CSTR_DETAIL_SCAN_INIT_%out_status

L_CSTR_DETAIL_SCAN_INIT_%out_status:
    __cstr_detail_idx_slot_%out_status = stack_alloc 8
    store __cstr_detail_idx_slot_%out_status+0, 0 as u64
    jmp L_CSTR_DETAIL_SCAN_HEAD_%out_status

L_CSTR_DETAIL_SCAN_HEAD_%out_status:
    __cstr_detail_idx_%out_status = load __cstr_detail_idx_slot_%out_status+0 as u64
    __cstr_detail_done_scan_%out_status = eq __cstr_detail_idx_%out_status, __cstr_detail_len_%out_status
    br __cstr_detail_done_scan_%out_status -> L_CSTR_DETAIL_NOT_TERM_SCAN_%out_status, L_CSTR_DETAIL_SCAN_BODY_%out_status

L_CSTR_DETAIL_SCAN_BODY_%out_status:
    __cstr_detail_p_%out_status = ptr_add __cstr_detail_ptr_%out_status, __cstr_detail_idx_%out_status
    __cstr_detail_b_%out_status = load __cstr_detail_p_%out_status+0 as u8
    __cstr_detail_is_nul_%out_status = eq __cstr_detail_b_%out_status, 0
    br __cstr_detail_is_nul_%out_status -> L_CSTR_DETAIL_FOUND_NUL_%out_status, L_CSTR_DETAIL_SCAN_NEXT_%out_status

L_CSTR_DETAIL_SCAN_NEXT_%out_status:
    __cstr_detail_next_%out_status = add __cstr_detail_idx_%out_status, 1
    store __cstr_detail_idx_slot_%out_status+0, __cstr_detail_next_%out_status as u64
    !__cstr_detail_next_%out_status
    !__cstr_detail_is_nul_%out_status
    !__cstr_detail_b_%out_status
    !__cstr_detail_p_%out_status
    !__cstr_detail_done_scan_%out_status
    !__cstr_detail_idx_%out_status
    jmp L_CSTR_DETAIL_SCAN_HEAD_%out_status

L_CSTR_DETAIL_FOUND_NUL_%out_status:
    __cstr_detail_last_index_%out_status = sub __cstr_detail_len_%out_status, 1
    __cstr_detail_at_end_%out_status = eq __cstr_detail_idx_%out_status, __cstr_detail_last_index_%out_status
    br __cstr_detail_at_end_%out_status -> L_CSTR_DETAIL_OK_%out_status, L_CSTR_DETAIL_INTERIOR_%out_status

L_CSTR_DETAIL_OK_%out_status:
    %out_status = add 0, CSTR_FROM_BYTES_OK
    %out_pos = add 0, CSTR_ERROR_POS_NONE
    !__cstr_detail_at_end_%out_status
    !__cstr_detail_last_index_%out_status
    !__cstr_detail_is_nul_%out_status
    !__cstr_detail_b_%out_status
    !__cstr_detail_p_%out_status
    !__cstr_detail_done_scan_%out_status
    !__cstr_detail_idx_%out_status
    !__cstr_detail_empty_%out_status
    !__cstr_detail_len_%out_status
    !__cstr_detail_ptr_%out_status
    jmp L_CSTR_DETAIL_END_%out_status

L_CSTR_DETAIL_INTERIOR_%out_status:
    %out_status = add 0, CSTR_FROM_BYTES_INTERIOR_NUL
    %out_pos = add 0, __cstr_detail_idx_%out_status
    !__cstr_detail_at_end_%out_status
    !__cstr_detail_last_index_%out_status
    !__cstr_detail_is_nul_%out_status
    !__cstr_detail_b_%out_status
    !__cstr_detail_p_%out_status
    !__cstr_detail_done_scan_%out_status
    !__cstr_detail_idx_%out_status
    !__cstr_detail_empty_%out_status
    !__cstr_detail_len_%out_status
    !__cstr_detail_ptr_%out_status
    jmp L_CSTR_DETAIL_END_%out_status

L_CSTR_DETAIL_NOT_TERM_SCAN_%out_status:
    !__cstr_detail_done_scan_%out_status
    !__cstr_detail_idx_%out_status
    jmp L_CSTR_DETAIL_NOT_TERM_%out_status

L_CSTR_DETAIL_NOT_TERM_%out_status:
    %out_status = add 0, CSTR_FROM_BYTES_NOT_NUL_TERMINATED
    %out_pos = add 0, __cstr_detail_len_%out_status
    !__cstr_detail_empty_%out_status
    !__cstr_detail_len_%out_status
    !__cstr_detail_ptr_%out_status

L_CSTR_DETAIL_END_%out_status:
[END_MACRO]

[MACRO] CSTR_FROM_BYTES_UNTIL_NUL %out_ok, %cstr_reg, %slice_reg
    __cstr_until_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __cstr_until_len_%out_ok = load %slice_reg+Slice_len as u64
    __cstr_until_idx_slot_%out_ok = stack_alloc 8
    store __cstr_until_idx_slot_%out_ok+0, 0 as u64
    jmp L_CSTR_UNTIL_HEAD_%out_ok

L_CSTR_UNTIL_HEAD_%out_ok:
    __cstr_until_idx_%out_ok = load __cstr_until_idx_slot_%out_ok+0 as u64
    __cstr_until_done_%out_ok = eq __cstr_until_idx_%out_ok, __cstr_until_len_%out_ok
    br __cstr_until_done_%out_ok -> L_CSTR_UNTIL_MISS_%out_ok, L_CSTR_UNTIL_BODY_%out_ok

L_CSTR_UNTIL_BODY_%out_ok:
    __cstr_until_p_%out_ok = ptr_add __cstr_until_ptr_%out_ok, __cstr_until_idx_%out_ok
    __cstr_until_b_%out_ok = load __cstr_until_p_%out_ok+0 as u8
    __cstr_until_nul_%out_ok = eq __cstr_until_b_%out_ok, 0
    br __cstr_until_nul_%out_ok -> L_CSTR_UNTIL_HIT_%out_ok, L_CSTR_UNTIL_NEXT_%out_ok

L_CSTR_UNTIL_NEXT_%out_ok:
    __cstr_until_next_%out_ok = add __cstr_until_idx_%out_ok, 1
    store __cstr_until_idx_slot_%out_ok+0, __cstr_until_next_%out_ok as u64
    !__cstr_until_next_%out_ok
    !__cstr_until_nul_%out_ok
    !__cstr_until_b_%out_ok
    !__cstr_until_p_%out_ok
    !__cstr_until_done_%out_ok
    !__cstr_until_idx_%out_ok
    jmp L_CSTR_UNTIL_HEAD_%out_ok

L_CSTR_UNTIL_HIT_%out_ok:
    __cstr_until_view_len_%out_ok = add __cstr_until_idx_%out_ok, 1
    EXPAND SLICE_NEW %cstr_reg, __cstr_until_ptr_%out_ok, __cstr_until_view_len_%out_ok
    %out_ok = add 0, 1
    !__cstr_until_view_len_%out_ok
    !__cstr_until_nul_%out_ok
    !__cstr_until_b_%out_ok
    !__cstr_until_p_%out_ok
    !__cstr_until_done_%out_ok
    !__cstr_until_idx_%out_ok
    !__cstr_until_len_%out_ok
    !__cstr_until_ptr_%out_ok
    jmp L_CSTR_UNTIL_END_%out_ok

L_CSTR_UNTIL_MISS_%out_ok:
    __cstr_until_null_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %cstr_reg, __cstr_until_null_%out_ok, 0
    %out_ok = add 0, 0
    !__cstr_until_null_%out_ok
    !__cstr_until_done_%out_ok
    !__cstr_until_idx_%out_ok
    !__cstr_until_len_%out_ok
    !__cstr_until_ptr_%out_ok

L_CSTR_UNTIL_END_%out_ok:
[END_MACRO]

[MACRO] CSTR_COUNT_BYTES %out_len, %cstr_reg
    __cstr_count_len_%out_len = load %cstr_reg+CStr_len as u64
    %out_len = sub __cstr_count_len_%out_len, 1
    !__cstr_count_len_%out_len
[END_MACRO]

[MACRO] CSTR_IS_EMPTY %out_bool, %cstr_reg
    EXPAND CSTR_COUNT_BYTES __cstr_empty_len_%out_bool, %cstr_reg
    %out_bool = eq __cstr_empty_len_%out_bool, 0
    !__cstr_empty_len_%out_bool
[END_MACRO]

[MACRO] CSTR_TO_BYTES_WITH_NUL %out_slice, %cstr_reg
    __cstr_bytes_ptr_%out_slice = load %cstr_reg+CStr_ptr as ptr
    __cstr_bytes_len_%out_slice = load %cstr_reg+CStr_len as u64
    EXPAND SLICE_NEW %out_slice, __cstr_bytes_ptr_%out_slice, __cstr_bytes_len_%out_slice
    !__cstr_bytes_len_%out_slice
    !__cstr_bytes_ptr_%out_slice
[END_MACRO]

[MACRO] CSTR_TO_BYTES %out_slice, %cstr_reg
    __cstr_no_nul_ptr_%out_slice = load %cstr_reg+CStr_ptr as ptr
    __cstr_no_nul_len_with_%out_slice = load %cstr_reg+CStr_len as u64
    __cstr_no_nul_len_%out_slice = sub __cstr_no_nul_len_with_%out_slice, 1
    EXPAND SLICE_NEW %out_slice, __cstr_no_nul_ptr_%out_slice, __cstr_no_nul_len_%out_slice
    !__cstr_no_nul_len_%out_slice
    !__cstr_no_nul_len_with_%out_slice
    !__cstr_no_nul_ptr_%out_slice
[END_MACRO]

[MACRO] CSTR_TO_STR %out_status, %out_slice, %cstr_reg
    EXPAND CSTR_TO_BYTES %out_slice, %cstr_reg
    __cstr_to_str_ptr_%out_status = load %out_slice+Slice_ptr as ptr
    __cstr_to_str_len_%out_status = load %out_slice+Slice_len as u64
    __cstr_to_str_status_%out_status = call @sa_str_utf8_validate(__cstr_to_str_ptr_%out_status, __cstr_to_str_len_%out_status)
    __cstr_to_str_ok_%out_status = eq __cstr_to_str_status_%out_status, 0
    br __cstr_to_str_ok_%out_status -> L_CSTR_TO_STR_OK_%out_status, L_CSTR_TO_STR_BAD_%out_status

L_CSTR_TO_STR_OK_%out_status:
    %out_status = add 0, CSTR_FROM_BYTES_OK
    !__cstr_to_str_ok_%out_status
    !__cstr_to_str_status_%out_status
    !__cstr_to_str_len_%out_status
    !__cstr_to_str_ptr_%out_status
    jmp L_CSTR_TO_STR_END_%out_status

L_CSTR_TO_STR_BAD_%out_status:
    %out_status = add 0, CSTR_TO_STR_INVALID_UTF8
    __cstr_to_str_null_%out_status = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __cstr_to_str_null_%out_status, 0
    !__cstr_to_str_null_%out_status
    !__cstr_to_str_ok_%out_status
    !__cstr_to_str_status_%out_status
    !__cstr_to_str_len_%out_status
    !__cstr_to_str_ptr_%out_status

L_CSTR_TO_STR_END_%out_status:
[END_MACRO]

[MACRO] CSTRING_NEW %out_status, %cstring_reg, %slice_reg
    __cstring_new_src_ptr_%out_status = load %slice_reg+Slice_ptr as ptr
    __cstring_new_src_len_%out_status = load %slice_reg+Slice_len as u64
    __cstring_new_idx_slot_%out_status = stack_alloc 8
    store __cstring_new_idx_slot_%out_status+0, 0 as u64
    jmp L_CSTRING_NEW_SCAN_HEAD_%out_status

L_CSTRING_NEW_SCAN_HEAD_%out_status:
    __cstring_new_idx_%out_status = load __cstring_new_idx_slot_%out_status+0 as u64
    __cstring_new_done_%out_status = eq __cstring_new_idx_%out_status, __cstring_new_src_len_%out_status
    br __cstring_new_done_%out_status -> L_CSTRING_NEW_ALLOC_%out_status, L_CSTRING_NEW_SCAN_BODY_%out_status

L_CSTRING_NEW_SCAN_BODY_%out_status:
    __cstring_new_p_%out_status = ptr_add __cstring_new_src_ptr_%out_status, __cstring_new_idx_%out_status
    __cstring_new_b_%out_status = load __cstring_new_p_%out_status+0 as u8
    __cstring_new_is_nul_%out_status = eq __cstring_new_b_%out_status, 0
    br __cstring_new_is_nul_%out_status -> L_CSTRING_NEW_INTERIOR_%out_status, L_CSTRING_NEW_SCAN_NEXT_%out_status

L_CSTRING_NEW_SCAN_NEXT_%out_status:
    __cstring_new_next_%out_status = add __cstring_new_idx_%out_status, 1
    store __cstring_new_idx_slot_%out_status+0, __cstring_new_next_%out_status as u64
    !__cstring_new_next_%out_status
    !__cstring_new_is_nul_%out_status
    !__cstring_new_b_%out_status
    !__cstring_new_p_%out_status
    !__cstring_new_done_%out_status
    !__cstring_new_idx_%out_status
    jmp L_CSTRING_NEW_SCAN_HEAD_%out_status

L_CSTRING_NEW_ALLOC_%out_status:
    __cstring_new_len_with_%out_status = add __cstring_new_src_len_%out_status, 1
    __cstring_new_dst_%out_status = alloc __cstring_new_len_with_%out_status
    call @sa_mem_copy(&__cstring_new_dst_%out_status, &__cstring_new_src_ptr_%out_status, __cstring_new_src_len_%out_status)
    __cstring_new_nul_p_%out_status = ptr_add __cstring_new_dst_%out_status, __cstring_new_src_len_%out_status
    store __cstring_new_nul_p_%out_status+0, 0 as u8
    EXPAND SLICE_NEW %cstring_reg, __cstring_new_dst_%out_status, __cstring_new_len_with_%out_status
    %out_status = add 0, CSTRING_NEW_OK
    ^__cstring_new_dst_%out_status
    !__cstring_new_nul_p_%out_status
    !__cstring_new_len_with_%out_status
    !__cstring_new_done_%out_status
    !__cstring_new_idx_%out_status
    !__cstring_new_src_len_%out_status
    !__cstring_new_src_ptr_%out_status
    jmp L_CSTRING_NEW_END_%out_status

L_CSTRING_NEW_INTERIOR_%out_status:
    __cstring_new_null_%out_status = 0 as ptr
    EXPAND SLICE_NEW %cstring_reg, __cstring_new_null_%out_status, 0
    %out_status = add 0, CSTRING_NEW_INTERIOR_NUL
    !__cstring_new_null_%out_status
    !__cstring_new_is_nul_%out_status
    !__cstring_new_b_%out_status
    !__cstring_new_p_%out_status
    !__cstring_new_done_%out_status
    !__cstring_new_idx_%out_status
    !__cstring_new_src_len_%out_status
    !__cstring_new_src_ptr_%out_status

L_CSTRING_NEW_END_%out_status:
[END_MACRO]

[MACRO] CSTRING_FROM_BYTES_WITH_NUL %out_status, %cstring_reg, %slice_reg
    __cstring_from_nul_cstr_%out_status = stack_alloc CStr_SIZE
    EXPAND CSTR_FROM_BYTES_WITH_NUL %out_status, __cstring_from_nul_cstr_%out_status, %slice_reg
    __cstring_from_nul_ok_%out_status = eq %out_status, CSTR_FROM_BYTES_OK
    br __cstring_from_nul_ok_%out_status -> L_CSTRING_FROM_NUL_OK_%out_status, L_CSTRING_FROM_NUL_BAD_%out_status

L_CSTRING_FROM_NUL_OK_%out_status:
    EXPAND CSTRING_FROM_BYTES_WITH_NUL_UNCHECKED %cstring_reg, %slice_reg
    !__cstring_from_nul_ok_%out_status
    jmp L_CSTRING_FROM_NUL_END_%out_status

L_CSTRING_FROM_NUL_BAD_%out_status:
    __cstring_from_nul_null_%out_status = 0 as ptr
    EXPAND SLICE_NEW %cstring_reg, __cstring_from_nul_null_%out_status, 0
    !__cstring_from_nul_null_%out_status
    !__cstring_from_nul_ok_%out_status

L_CSTRING_FROM_NUL_END_%out_status:
[END_MACRO]

[MACRO] CSTRING_FROM_BYTES_WITH_NUL_UNCHECKED %cstring_reg, %slice_reg
    __cstring_from_nul_src_ptr_%cstring_reg = load %slice_reg+Slice_ptr as ptr
    __cstring_from_nul_len_%cstring_reg = load %slice_reg+Slice_len as u64
    __cstring_from_nul_dst_%cstring_reg = alloc __cstring_from_nul_len_%cstring_reg
    call @sa_mem_copy(&__cstring_from_nul_dst_%cstring_reg, &__cstring_from_nul_src_ptr_%cstring_reg, __cstring_from_nul_len_%cstring_reg)
    EXPAND SLICE_NEW %cstring_reg, __cstring_from_nul_dst_%cstring_reg, __cstring_from_nul_len_%cstring_reg
    ^__cstring_from_nul_dst_%cstring_reg
    !__cstring_from_nul_len_%cstring_reg
    !__cstring_from_nul_src_ptr_%cstring_reg
[END_MACRO]

[MACRO] CSTRING_AS_CSTR %out_cstr, %cstring_reg
    __cstring_as_ptr_%out_cstr = load %cstring_reg+CString_ptr as ptr
    __cstring_as_len_%out_cstr = load %cstring_reg+CString_len as u64
    EXPAND CSTR_FROM_PARTS_UNCHECKED %out_cstr, __cstring_as_ptr_%out_cstr, __cstring_as_len_%out_cstr
    !__cstring_as_len_%out_cstr
    !__cstring_as_ptr_%out_cstr
[END_MACRO]

[MACRO] CSTRING_AS_BYTES_WITH_NUL %out_slice, %cstring_reg
    __cstring_bytes_cstr_%out_slice = stack_alloc CStr_SIZE
    EXPAND CSTRING_AS_CSTR __cstring_bytes_cstr_%out_slice, %cstring_reg
    EXPAND CSTR_TO_BYTES_WITH_NUL %out_slice, __cstring_bytes_cstr_%out_slice
[END_MACRO]

[MACRO] CSTRING_AS_BYTES %out_slice, %cstring_reg
    __cstring_no_nul_cstr_%out_slice = stack_alloc CStr_SIZE
    EXPAND CSTRING_AS_CSTR __cstring_no_nul_cstr_%out_slice, %cstring_reg
    EXPAND CSTR_TO_BYTES %out_slice, __cstring_no_nul_cstr_%out_slice
[END_MACRO]

[MACRO] CSTRING_TO_STR %out_status, %out_slice, %cstring_reg
    __cstring_to_str_cstr_%out_status = stack_alloc CStr_SIZE
    EXPAND CSTRING_AS_CSTR __cstring_to_str_cstr_%out_status, %cstring_reg
    EXPAND CSTR_TO_STR %out_status, %out_slice, __cstring_to_str_cstr_%out_status
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_CSTR %hasher, %cstr_reg
    __cstr_hash_bytes_%hasher = stack_alloc Slice_SIZE
    EXPAND CSTR_TO_BYTES_WITH_NUL __cstr_hash_bytes_%hasher, %cstr_reg
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 %hasher, __cstr_hash_bytes_%hasher
[END_MACRO]

[MACRO] CSTR_HASH %out_hash, %cstr_reg
    __cstr_hash_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __cstr_hash_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_CSTR __cstr_hash_hasher_%out_hash, %cstr_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __cstr_hash_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_CSTR %out_hash, %builder, %cstr_reg
    __build_hash_one_cstr_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_cstr_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_CSTR __build_hash_one_cstr_hasher_%out_hash, %cstr_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_cstr_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_CSTR %out_hash, %state, %cstr_reg
    __random_state_hash_one_cstr_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_cstr_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_CSTR __random_state_hash_one_cstr_hasher_%out_hash, %cstr_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_cstr_hasher_%out_hash
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_CSTRING %hasher, %cstring_reg
    __cstring_hash_bytes_%hasher = stack_alloc Slice_SIZE
    EXPAND CSTRING_AS_BYTES_WITH_NUL __cstring_hash_bytes_%hasher, %cstring_reg
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 %hasher, __cstring_hash_bytes_%hasher
[END_MACRO]

[MACRO] CSTRING_HASH %out_hash, %cstring_reg
    __cstring_hash_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __cstring_hash_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_CSTRING __cstring_hash_hasher_%out_hash, %cstring_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __cstring_hash_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_CSTRING %out_hash, %builder, %cstring_reg
    __build_hash_one_cstring_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_cstring_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_CSTRING __build_hash_one_cstring_hasher_%out_hash, %cstring_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_cstring_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_CSTRING %out_hash, %state, %cstring_reg
    __random_state_hash_one_cstring_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_cstring_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_CSTRING __random_state_hash_one_cstring_hasher_%out_hash, %cstring_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_cstring_hasher_%out_hash
[END_MACRO]

[MACRO] CSTRING_AS_PTR %out_ptr, %cstring_reg
    %out_ptr = load %cstring_reg+CString_ptr as ptr
[END_MACRO]

[MACRO] CSTRING_COUNT_BYTES %out_len, %cstring_reg
    __cstring_count_cstr_%out_len = stack_alloc CStr_SIZE
    EXPAND CSTRING_AS_CSTR __cstring_count_cstr_%out_len, %cstring_reg
    EXPAND CSTR_COUNT_BYTES %out_len, __cstring_count_cstr_%out_len
[END_MACRO]

[MACRO] CSTRING_IS_EMPTY %out_bool, %cstring_reg
    EXPAND CSTRING_COUNT_BYTES __cstring_empty_len_%out_bool, %cstring_reg
    %out_bool = eq __cstring_empty_len_%out_bool, 0
    !__cstring_empty_len_%out_bool
[END_MACRO]

[MACRO] CSTRING_INTO_RAW %out_ptr, %cstring_reg
    %out_ptr = load %cstring_reg+CString_ptr as ptr
    store %cstring_reg+CString_ptr, 0 as ptr
    store %cstring_reg+CString_len, 0 as u64
[END_MACRO]

[MACRO] CSTRING_FROM_RAW %cstring_reg, %ptr_reg
    EXPAND CSTR_FROM_PTR %cstring_reg, %ptr_reg
[END_MACRO]

[MACRO] CSTRING_FREE %cstring_reg
    __cstring_free_ptr_%cstring_reg = load %cstring_reg+CString_ptr as ptr
    __cstring_free_null_%cstring_reg = 0 as ptr
    __cstring_free_has_%cstring_reg = ne __cstring_free_ptr_%cstring_reg, __cstring_free_null_%cstring_reg
    br __cstring_free_has_%cstring_reg -> L_CSTRING_FREE_DO_%cstring_reg, L_CSTRING_FREE_DONE_%cstring_reg

L_CSTRING_FREE_DO_%cstring_reg:
    !__cstring_free_ptr_%cstring_reg
    jmp L_CSTRING_FREE_AFTER_%cstring_reg

L_CSTRING_FREE_DONE_%cstring_reg:
    !__cstring_free_ptr_%cstring_reg

L_CSTRING_FREE_AFTER_%cstring_reg:
    store %cstring_reg+CString_ptr, 0 as ptr
    store %cstring_reg+CString_len, 0 as u64
    !__cstring_free_has_%cstring_reg
    !__cstring_free_null_%cstring_reg
[END_MACRO]

// Owned CString convenience constructors/clones over the existing byte-buffer facade.

[MACRO] CSTRING_DEFAULT %out_status, %cstring_reg
    __cstring_default_null_%out_status = 0 as ptr
    __cstring_default_slice_%out_status = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW __cstring_default_slice_%out_status, __cstring_default_null_%out_status, 0
    EXPAND CSTRING_NEW %out_status, %cstring_reg, __cstring_default_slice_%out_status
    !__cstring_default_null_%out_status
[END_MACRO]

[MACRO] CSTRING_CLONE %out_status, %out_cstring, %src_cstring
    __cstring_clone_bytes_%out_status = stack_alloc Slice_SIZE
    EXPAND CSTRING_AS_BYTES_WITH_NUL __cstring_clone_bytes_%out_status, %src_cstring
    EXPAND CSTRING_FROM_BYTES_WITH_NUL %out_status, %out_cstring, __cstring_clone_bytes_%out_status
[END_MACRO]

[MACRO] CSTRING_LIT1 %out_status, %out_cstring, %s0
    EXPAND CSTRING_NEW %out_status, %out_cstring, %s0
[END_MACRO]

// Lossy owned-string materialization from CString bytes (excluding trailing NUL).

[MACRO] CSTRING_TO_STRING_LOSSY %out_string, %cstring_reg
    __cstring_lossy_bytes_%out_string = stack_alloc Slice_SIZE
    EXPAND CSTRING_AS_BYTES __cstring_lossy_bytes_%out_string, %cstring_reg
    EXPAND STRING_BUF_FROM_UTF8_LOSSY %out_string, __cstring_lossy_bytes_%out_string
[END_MACRO]

[MACRO] CSTR_TO_STRING_LOSSY %out_string, %cstr_reg
    __cstr_lossy_bytes_%out_string = stack_alloc Slice_SIZE
    EXPAND CSTR_TO_BYTES __cstr_lossy_bytes_%out_string, %cstr_reg
    EXPAND STRING_BUF_FROM_UTF8_LOSSY %out_string, __cstr_lossy_bytes_%out_string
[END_MACRO]

[MACRO] CSTRING_INTO_STRING %out_status, %out_slice, %cstring_reg
    EXPAND CSTRING_TO_STR %out_status, %out_slice, %cstring_reg
[END_MACRO]

[MACRO] CSTRING_AS_C_STR %out_cstr, %cstring_reg
    EXPAND CSTRING_AS_CSTR %out_cstr, %cstring_reg
[END_MACRO]

// Stable std-style aliases for borrowed and owned C strings.
[MACRO] CSTR_FROM_SLICE %out_status, %cstr_reg, %slice_reg
    EXPAND CSTR_FROM_BYTES_WITH_NUL %out_status, %cstr_reg, %slice_reg
[END_MACRO]

[MACRO] CSTR_AS_BYTES_WITH_NUL %out_slice, %cstr_reg
    EXPAND CSTR_TO_BYTES_WITH_NUL %out_slice, %cstr_reg
[END_MACRO]

[MACRO] CSTR_AS_BYTES %out_slice, %cstr_reg
    EXPAND CSTR_TO_BYTES %out_slice, %cstr_reg
[END_MACRO]

[MACRO] CSTR_AS_STR %out_status, %out_slice, %cstr_reg
    EXPAND CSTR_TO_STR %out_status, %out_slice, %cstr_reg
[END_MACRO]

[MACRO] CSTRING_FROM_SLICE %out_status, %cstring_reg, %slice_reg
    EXPAND CSTRING_NEW %out_status, %cstring_reg, %slice_reg
[END_MACRO]

[MACRO] CSTRING_FROM_SLICE_WITH_NUL %out_status, %cstring_reg, %slice_reg
    EXPAND CSTRING_FROM_BYTES_WITH_NUL %out_status, %cstring_reg, %slice_reg
[END_MACRO]

[MACRO] CSTRING_AS_STR %out_status, %out_slice, %cstring_reg
    EXPAND CSTRING_TO_STR %out_status, %out_slice, %cstring_reg
[END_MACRO]

[MACRO] CSTRING_AS_CSTR_VIEW %out_cstr, %cstring_reg
    EXPAND CSTRING_AS_CSTR %out_cstr, %cstring_reg
[END_MACRO]

[MACRO] CSTRING_AS_BYTES_WITH_NUL_VIEW %out_slice, %cstring_reg
    EXPAND CSTRING_AS_BYTES_WITH_NUL %out_slice, %cstring_reg
[END_MACRO]

[MACRO] CSTRING_AS_BYTES_VIEW %out_slice, %cstring_reg
    EXPAND CSTRING_AS_BYTES %out_slice, %cstring_reg
[END_MACRO]