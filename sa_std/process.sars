    EXPAND PROCESS_SPAWN_STREAM_COMMAND_EXT_CHROOT %out_status, %out_process, %out_stdout, %out_stderr, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid, %chroot, %chroot_len, %has_chroot
[END_MACRO]

// Command.output()-style capture over the existing exec_capture ABI.
// Honors has_cwd/cwd only; arg0/process_group/setsid are not applied because
// capture runtime paths do not currently expose those CommandExt fields.

[MACRO] PROCESS_COMMAND_BUILDER_EXEC_CAPTURE %out_status, %out_code, %out_stdout, %out_stderr, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
    __process_cmd_cap_has_cwd_%out_status = ne %has_cwd, 0
    br __process_cmd_cap_has_cwd_%out_status -> L_PROCESS_CMD_CAP_CWD_%out_status, L_PROCESS_CMD_CAP_PLAIN_%out_status

L_PROCESS_CMD_CAP_CWD_%out_status:
    EXPAND PROCESS_EXEC_CAPTURE_CWD %out_status, %out_code, %out_stdout, %out_stderr, %argv, %argv_len, %cwd, %cwd_len
    !__process_cmd_cap_has_cwd_%out_status
    jmp L_PROCESS_CMD_CAP_END_%out_status

L_PROCESS_CMD_CAP_PLAIN_%out_status:
    EXPAND PROCESS_EXEC_CAPTURE %out_status, %out_code, %out_stdout, %out_stderr, %argv, %argv_len
    !__process_cmd_cap_has_cwd_%out_status

L_PROCESS_CMD_CAP_END_%out_status:
[END_MACRO]

[MACRO] PROCESS_COMMAND_BUILDER_OUTPUT %out_status, %output, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
    __process_cmd_out_has_cwd_%output = ne %has_cwd, 0
    br __process_cmd_out_has_cwd_%output -> L_PROCESS_CMD_OUT_CWD_%output, L_PROCESS_CMD_OUT_PLAIN_%output

L_PROCESS_CMD_OUT_CWD_%output:
    EXPAND PROCESS_EXEC_CAPTURE_OUTPUT_CWD %out_status, %output, %argv, %argv_len, %cwd, %cwd_len
    !__process_cmd_out_has_cwd_%output
    jmp L_PROCESS_CMD_OUT_END_%output

L_PROCESS_CMD_OUT_PLAIN_%output:
    EXPAND PROCESS_EXEC_CAPTURE_OUTPUT %out_status, %output, %argv, %argv_len
    !__process_cmd_out_has_cwd_%output

L_PROCESS_CMD_OUT_END_%output:
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDOUT_BYTES %out_ptr, %output
    EXPAND PROCESS_OUTPUT_STDOUT_DATA %out_ptr, %output
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDERR_BYTES %out_ptr, %output
    EXPAND PROCESS_OUTPUT_STDERR_DATA %out_ptr, %output
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDOUT_BYTE_LEN %out_len, %output
    EXPAND PROCESS_OUTPUT_STDOUT_LEN %out_len, %output
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDERR_BYTE_LEN %out_len, %output
    EXPAND PROCESS_OUTPUT_STDERR_LEN %out_len, %output
[END_MACRO]
