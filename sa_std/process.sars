    %out_stderr = load __process_capture_cwd_stderr_slot_%out_stderr+0 as u64
[END_MACRO]

[MACRO] PROCESS_EXEC_CAPTURE_OUTPUT_CWD %out_status, %output, %argv, %argv_len, %cwd, %cwd_len
    __process_capture_cwd_output_status_%output = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_EXEC_CAPTURE_CWD %out_status, __process_capture_cwd_output_code_%output, __process_capture_cwd_output_stdout_handle_%output, __process_capture_cwd_output_stderr_handle_%output, %argv, %argv_len, %cwd, %cwd_len
    EXPAND PROCESS_EXIT_STATUS_NEW __process_capture_cwd_output_status_%output, __process_capture_cwd_output_code_%output
    EXPAND PROCESS_OUTPUT_NEW %output, __process_capture_cwd_output_status_%output, __process_capture_cwd_output_stdout_handle_%output, __process_capture_cwd_output_stderr_handle_%output
    !__process_capture_cwd_output_stderr_handle_%output
    !__process_capture_cwd_output_stdout_handle_%output
    !__process_capture_cwd_output_code_%output
[END_MACRO]

[MACRO] PROCESS_CLOSE %out_status, %process
    %out_status = call @sa_std_process_close(%process)
[END_MACRO]

// Concrete Command-style SSA config builder over PROCESS_*_COMMAND_EXT.
// Builder state is propagating scalar flags only. Callers still pass addressable
// cwd/arg0 buffers into STATUS/SPAWN (use stack_alloc dummies when unused).
// This does not model env maps, pipe Stdio objects, or a heap Command value.

[MACRO] PROCESS_COMMAND_BUILDER_NEW %out_cwd_len, %out_has_cwd, %out_arg0_len, %out_has_arg0, %out_process_group, %out_has_process_group, %out_setsid
    %out_cwd_len = add 0, 0
    %out_has_cwd = add 0, 0
    %out_arg0_len = add 0, 0
    %out_has_arg0 = add 0, 0
    %out_process_group = add 0, 0
    %out_has_process_group = add 0, 0
    %out_setsid = add 0, 0
[END_MACRO]

[MACRO] PROCESS_COMMAND_BUILDER_WITH_CURRENT_DIR %out_cwd_len, %out_has_cwd, %out_arg0_len, %out_has_arg0, %out_process_group, %out_has_process_group, %out_setsid, %in_cwd_len, %in_has_cwd, %in_arg0_len, %in_has_arg0, %in_process_group, %in_has_process_group, %in_setsid, %cwd_len
    %out_cwd_len = add 0, %cwd_len
    %out_has_cwd = add 0, 1
    %out_arg0_len = add 0, %in_arg0_len
    %out_has_arg0 = add 0, %in_has_arg0
    %out_process_group = add 0, %in_process_group
    %out_has_process_group = add 0, %in_has_process_group
    %out_setsid = add 0, %in_setsid
    !%in_cwd_len
    !%in_has_cwd
[END_MACRO]

[MACRO] PROCESS_COMMAND_BUILDER_WITH_ARG0 %out_cwd_len, %out_has_cwd, %out_arg0_len, %out_has_arg0, %out_process_group, %out_has_process_group, %out_setsid, %in_cwd_len, %in_has_cwd, %in_arg0_len, %in_has_arg0, %in_process_group, %in_has_process_group, %in_setsid, %arg0_len
    %out_cwd_len = add 0, %in_cwd_len
    %out_has_cwd = add 0, %in_has_cwd
    %out_arg0_len = add 0, %arg0_len
    %out_has_arg0 = add 0, 1
    %out_process_group = add 0, %in_process_group
    %out_has_process_group = add 0, %in_has_process_group
    %out_setsid = add 0, %in_setsid
    !%in_arg0_len
    !%in_has_arg0
[END_MACRO]

[MACRO] PROCESS_COMMAND_BUILDER_WITH_PROCESS_GROUP %out_cwd_len, %out_has_cwd, %out_arg0_len, %out_has_arg0, %out_process_group, %out_has_process_group, %out_setsid, %in_cwd_len, %in_has_cwd, %in_arg0_len, %in_has_arg0, %in_process_group, %in_has_process_group, %in_setsid, %process_group
    %out_cwd_len = add 0, %in_cwd_len
    %out_has_cwd = add 0, %in_has_cwd
    %out_arg0_len = add 0, %in_arg0_len
    %out_has_arg0 = add 0, %in_has_arg0
    %out_process_group = add 0, %process_group
    %out_has_process_group = add 0, 1
    %out_setsid = add 0, %in_setsid
    !%in_process_group
    !%in_has_process_group
[END_MACRO]

[MACRO] PROCESS_COMMAND_BUILDER_WITH_SETSID %out_cwd_len, %out_has_cwd, %out_arg0_len, %out_has_arg0, %out_process_group, %out_has_process_group, %out_setsid, %in_cwd_len, %in_has_cwd, %in_arg0_len, %in_has_arg0, %in_process_group, %in_has_process_group, %in_setsid, %flag
    __process_cmd_setsid_zero_%out_setsid = eq %flag, 0
    br __process_cmd_setsid_zero_%out_setsid -> L_PROCESS_CMD_SETSID_OFF_%out_setsid, L_PROCESS_CMD_SETSID_ON_%out_setsid
L_PROCESS_CMD_SETSID_OFF_%out_setsid:
    %out_cwd_len = add 0, %in_cwd_len
    %out_has_cwd = add 0, %in_has_cwd
    %out_arg0_len = add 0, %in_arg0_len
    %out_has_arg0 = add 0, %in_has_arg0
    %out_process_group = add 0, %in_process_group
    %out_has_process_group = add 0, %in_has_process_group
    %out_setsid = add 0, 0
    !__process_cmd_setsid_zero_%out_setsid
    jmp L_PROCESS_CMD_SETSID_END_%out_setsid
L_PROCESS_CMD_SETSID_ON_%out_setsid:
    %out_cwd_len = add 0, %in_cwd_len
    %out_has_cwd = add 0, %in_has_cwd
    %out_arg0_len = add 0, %in_arg0_len
    %out_has_arg0 = add 0, %in_has_arg0
    %out_process_group = add 0, %in_process_group
    %out_has_process_group = add 0, %in_has_process_group
    %out_setsid = add 0, 1
    !__process_cmd_setsid_zero_%out_setsid
    jmp L_PROCESS_CMD_SETSID_END_%out_setsid
L_PROCESS_CMD_SETSID_END_%out_setsid:
    !%in_setsid
[END_MACRO]

[MACRO] PROCESS_COMMAND_BUILDER_STATUS %out_status, %out_process, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
    EXPAND PROCESS_RUN_COMMAND_EXT %out_status, %out_process, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
[END_MACRO]

[MACRO] PROCESS_COMMAND_BUILDER_SPAWN %out_status, %out_process, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
