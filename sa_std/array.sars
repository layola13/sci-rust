    EXPAND ARRAY_AS_MUT_SLICE_U64 __array_iter_mut_slice_%out_iter, %array_ptr, %length
    EXPAND ITER_FROM_SLICE %out_iter, __array_iter_mut_slice_%out_iter
[END_MACRO]

