[END_MACRO]

[MACRO] ARRAY_INTO_ITER_U64 %out_iter, %out_vec, %array_ptr, %length
    __array_into_iter_slice_%out_iter = stack_alloc Slice_SIZE
    EXPAND ARRAY_AS_SLICE_U64 __array_into_iter_slice_%out_iter, %array_ptr, %length
    EXPAND VEC_FROM_SLICE_U64 %out_vec, __array_into_iter_slice_%out_iter
    EXPAND VEC_AS_SLICE __array_into_iter_backing_slice_%out_iter, %out_vec
    EXPAND ITER_FROM_SLICE %out_iter, __array_into_iter_backing_slice_%out_iter
    !__array_into_iter_backing_slice_%out_iter
[END_MACRO]

// Rust method-name alias over ARRAY_INTO_ITER_U64.
[MACRO] ARRAY_INTO_ITER %out_iter, %out_vec, %array_ptr, %length
