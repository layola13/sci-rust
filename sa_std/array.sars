[MACRO] ARRAY_ITER_U64 %out_iter, %array_ptr, %length
    __array_iter_slice_%out_iter = stack_alloc Slice_SIZE
    EXPAND ARRAY_AS_SLICE_U64 __array_iter_slice_%out_iter, %array_ptr, %length
    EXPAND ITER_FROM_SLICE %out_iter, __array_iter_slice_%out_iter
[END_MACRO]

