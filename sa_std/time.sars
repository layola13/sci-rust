    EXPAND TIME_SLEEP_NS %duration_ns
[END_MACRO]

[MACRO] TIME_INSTANT_DEFAULT %out_instant_ns
    %out_instant_ns = add 0, 0
[END_MACRO]

[MACRO] TIME_SYSTEM_TIME_DEFAULT %out_system_ns
    EXPAND TIME_SYSTEM_TIME_UNIX_EPOCH %out_system_ns
[END_MACRO]

// Stable std-style aliases for Duration, Instant, and SystemTime operations.
[MACRO] DURATION_ZERO %out_ns
    EXPAND TIME_DURATION_ZERO %out_ns
[END_MACRO]

[MACRO] DURATION_MAX %out_ns
    EXPAND TIME_DURATION_MAX %out_ns
[END_MACRO]

[MACRO] DURATION_FROM_NANOS %out_ns, %nanos
    EXPAND TIME_DURATION_FROM_NANOS %out_ns, %nanos
[END_MACRO]

[MACRO] DURATION_FROM_MICROS %out_ns, %micros
    EXPAND TIME_DURATION_FROM_MICROS %out_ns, %micros
[END_MACRO]

[MACRO] DURATION_FROM_MILLIS %out_ns, %millis
    EXPAND TIME_DURATION_FROM_MILLIS %out_ns, %millis
[END_MACRO]

[MACRO] DURATION_FROM_SECS %out_ns, %secs
    EXPAND TIME_DURATION_FROM_SECS %out_ns, %secs
[END_MACRO]

[MACRO] DURATION_AS_NANOS %out_ns, %duration_ns
    EXPAND TIME_DURATION_AS_NANOS %out_ns, %duration_ns
[END_MACRO]

[MACRO] DURATION_AS_MICROS %out_us, %duration_ns
    EXPAND TIME_DURATION_AS_MICROS %out_us, %duration_ns
