[MACRO] TIME_DURATION_ABS_DIFF_NS %out_ns, %left_ns, %right_ns
    __time_abs_left_ge_%out_ns = uge %left_ns, %right_ns
    br __time_abs_left_ge_%out_ns -> L_TIME_ABS_DIFF_LEFT_%out_ns, L_TIME_ABS_DIFF_RIGHT_%out_ns

L_TIME_ABS_DIFF_LEFT_%out_ns:
    %out_ns = sub %left_ns, %right_ns
    !__time_abs_left_ge_%out_ns
    jmp L_TIME_ABS_DIFF_END_%out_ns

L_TIME_ABS_DIFF_RIGHT_%out_ns:
    %out_ns = sub %right_ns, %left_ns
    !__time_abs_left_ge_%out_ns

L_TIME_ABS_DIFF_END_%out_ns:
[END_MACRO]

[MACRO] TIME_DURATION_ABS_DIFF %out_ns, %left_ns, %right_ns
    EXPAND TIME_DURATION_ABS_DIFF_NS %out_ns, %left_ns, %right_ns
[END_MACRO]

