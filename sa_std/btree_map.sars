[MACRO] BTREE_MAP_REMOVE %out_value, %map_reg, %key_reg
    %out_value = call @sa_btree_map_remove(&%map_reg, &%key_reg)
[END_MACRO]

[MACRO] BTREE_MAP_REMOVE_ENTRY %out_ok, %out_key, %out_value, %map_reg, %key_reg
    %out_key = alloc Slice_SIZE
    __btree_map_remove_value_slot_%out_ok = stack_alloc 8
