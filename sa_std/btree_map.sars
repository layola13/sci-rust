    jmp L_BTREE_MAP_EXTRACT_HEAD_%out_len

L_BTREE_MAP_EXTRACT_CLEAR_HEAD_%out_len:
    __btree_map_extract_clear_slot_%out_len = stack_alloc 8
    __btree_map_extract_kept_len_%out_len = load __btree_map_extract_write_slot_%out_len+0 as u64
    store __btree_map_extract_clear_slot_%out_len+0, __btree_map_extract_kept_len_%out_len as u64
