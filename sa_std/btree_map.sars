    %out_value = load __btree_map_remove_value_slot_%out_ok+0 as u64
[END_MACRO]

[MACRO] BTREE_MAP_INSERT %map_reg, %key_reg, %value
    call @sa_btree_map_insert(&%map_reg, &%key_reg, %value)
[END_MACRO]

[MACRO] BTREE_MAP_INSERT_OLD %out_replaced, %out_old_value, %map_reg, %key_reg, %value
