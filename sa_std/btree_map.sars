L_BTREE_MAP_ENTRY_AND_MODIFY_SET_%out_ok:
    store __btree_and_mod_ptr_%out_ok+0, %value as u64
    !__btree_and_mod_has_%out_ok
    !__btree_and_mod_ptr_%out_ok
    jmp L_BTREE_MAP_ENTRY_AND_MODIFY_END_%out_ok
L_BTREE_MAP_ENTRY_AND_MODIFY_SKIP_%out_ok:
    !__btree_and_mod_has_%out_ok
    !__btree_and_mod_ptr_%out_ok
    jmp L_BTREE_MAP_ENTRY_AND_MODIFY_END_%out_ok
L_BTREE_MAP_ENTRY_AND_MODIFY_END_%out_ok:
[END_MACRO]

[MACRO] BTREE_MAP_KEYS %out_set, %map_reg
    %out_set = call @sa_btree_map_keys_set(&%map_reg)
