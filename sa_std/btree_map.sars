    __btree_map_extract_same_slot_%out_len = eq __btree_map_extract_write_%out_len, __btree_map_extract_read_%out_len
    br __btree_map_extract_same_slot_%out_len -> L_BTREE_MAP_EXTRACT_KEEP_ADVANCE_%out_len, L_BTREE_MAP_EXTRACT_COPY_%out_len

L_BTREE_MAP_EXTRACT_COPY_%out_len:
    __btree_map_extract_write_off_%out_len = mul __btree_map_extract_write_%out_len, BTreeMapEntry_SIZE
    __btree_map_extract_write_entry_%out_len = ptr_add __btree_map_extract_entries_%out_len, __btree_map_extract_write_off_%out_len
    __btree_map_extract_key_ptr_%out_len = load __btree_map_extract_read_entry_%out_len+BTreeMapEntry_key_ptr as ptr
    __btree_map_extract_key_len_%out_len = load __btree_map_extract_read_entry_%out_len+BTreeMapEntry_key_len as u64
    store __btree_map_extract_write_entry_%out_len+BTreeMapEntry_key_ptr, __btree_map_extract_key_ptr_%out_len as ptr
    store __btree_map_extract_write_entry_%out_len+BTreeMapEntry_key_len, __btree_map_extract_key_len_%out_len as u64
    store __btree_map_extract_write_entry_%out_len+BTreeMapEntry_value, __btree_map_extract_value_%out_len as u64
    !__btree_map_extract_key_len_%out_len
