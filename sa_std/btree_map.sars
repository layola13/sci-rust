// Rust method-name alias: BTreeMap::iter_mut (eager raw value-slot pointer materialization).
[MACRO] BTREE_MAP_ITER_MUT %out_vec, %map_reg
    EXPAND BTREE_MAP_ITER_MUT_PTRS %out_vec, %map_reg
[END_MACRO]

[MACRO] BTREE_MAP_REF_INTO_ITER %out_vec, %map_reg
    EXPAND BTREE_MAP_ITER %out_vec, %map_reg
[END_MACRO]

[MACRO] BTREE_MAP_MUT_REF_INTO_ITER %out_vec, %map_reg
    EXPAND BTREE_MAP_ITER_MUT_PTRS %out_vec, %map_reg
[END_MACRO]

[MACRO] BTREE_MAP_INTO_ITER %out_vec, %map_reg
    EXPAND BTREE_MAP_ITER %out_vec, %map_reg
    EXPAND BTREE_MAP_CLEAR %map_reg
[END_MACRO]

[MACRO] BTREE_MAP_POP_FIRST %out_ok, %out_key, %out_value, %map_reg
    %out_key = alloc Slice_SIZE
    __btree_map_pop_first_value_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_btree_map_pop_first(&%map_reg, &%out_key, &__btree_map_pop_first_value_slot_%out_ok)
    %out_value = load __btree_map_pop_first_value_slot_%out_ok+0 as u64
[END_MACRO]

[MACRO] BTREE_MAP_POP_LAST %out_ok, %out_key, %out_value, %map_reg
    %out_key = alloc Slice_SIZE
    __btree_map_pop_last_value_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_btree_map_pop_last(&%map_reg, &%out_key, &__btree_map_pop_last_value_slot_%out_ok)
    %out_value = load __btree_map_pop_last_value_slot_%out_ok+0 as u64
[END_MACRO]

[MACRO] BTREE_MAP_APPEND %map_reg, %other_map
    call @sa_btree_map_append(&%map_reg, &%other_map)
[END_MACRO]

[MACRO] BTREE_MAP_SPLIT_OFF %out_map, %map_reg, %key_reg
    %out_map = call @sa_btree_map_split_off(&%map_reg, &%key_reg)
[END_MACRO]

[MACRO] BTREE_MAP_RANGE %out_map, %map_reg, %start_key, %end_key
    %out_map = call @sa_btree_map_range(&%map_reg, &%start_key, &%end_key)
[END_MACRO]

[MACRO] BTREE_MAP_RANGE_MUT_PTRS %out_vec, %map_reg, %start_key, %end_key
    %out_vec = call @sa_btree_map_range_mut_ptrs_vec(&%map_reg, &%start_key, &%end_key)
[END_MACRO]

// Rust method-name alias: BTreeMap::range_mut (eager raw-pointer materialization).
[MACRO] BTREE_MAP_RANGE_MUT %out_vec, %map_reg, %start_key, %end_key
    EXPAND BTREE_MAP_RANGE_MUT_PTRS %out_vec, %map_reg, %start_key, %end_key
[END_MACRO]

[MACRO] BTREE_MAP_LIT1 %out_map, %key1, %value1
    EXPAND BTREE_MAP_NEW %out_map
    EXPAND BTREE_MAP_INSERT %out_map, %key1, %value1
[END_MACRO]

[MACRO] BTREE_MAP_LIT2 %out_map, %key1, %value1, %key2, %value2
    EXPAND BTREE_MAP_NEW %out_map
    EXPAND BTREE_MAP_INSERT %out_map, %key1, %value1
    EXPAND BTREE_MAP_INSERT %out_map, %key2, %value2
[END_MACRO]

[MACRO] BTREE_MAP_LIT3 %out_map, %key1, %value1, %key2, %value2, %key3, %value3
    EXPAND BTREE_MAP_NEW %out_map
    EXPAND BTREE_MAP_INSERT %out_map, %key1, %value1
    EXPAND BTREE_MAP_INSERT %out_map, %key2, %value2
    EXPAND BTREE_MAP_INSERT %out_map, %key3, %value3
[END_MACRO]

// Rust Default-style empty BTreeMap constructor alias.

[MACRO] BTREE_MAP_DEFAULT %out_map
    EXPAND BTREE_MAP_NEW %out_map
[END_MACRO]
