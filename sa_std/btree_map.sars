    __btree_map_extract_clear_done_%out_len = eq __btree_map_extract_clear_idx_%out_len, __btree_map_extract_len_%out_len
    br __btree_map_extract_clear_done_%out_len -> L_BTREE_MAP_EXTRACT_DONE_%out_len, L_BTREE_MAP_EXTRACT_CLEAR_BODY_%out_len

L_BTREE_MAP_EXTRACT_CLEAR_BODY_%out_len:
