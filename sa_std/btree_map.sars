    __btree_map_extract_clear_entry_%out_len = ptr_add __btree_map_extract_entries_%out_len, __btree_map_extract_clear_off_%out_len
    store __btree_map_extract_clear_entry_%out_len+BTreeMapEntry_key_ptr, 0 as ptr
    store __btree_map_extract_clear_entry_%out_len+BTreeMapEntry_key_len, 0 as u64
    store __btree_map_extract_clear_entry_%out_len+BTreeMapEntry_value, 0 as u64
