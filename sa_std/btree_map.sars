    __btree_map_extract_range_key_idx_%out_len = mul __btree_map_extract_range_idx_%out_len, 8
    __btree_map_extract_range_key_lane_%out_len = ptr_add __btree_map_extract_range_ptr_%out_len, __btree_map_extract_range_key_idx_%out_len
    __btree_map_extract_range_key_bits_%out_len = load __btree_map_extract_range_key_lane_%out_len+0 as u64
