[MACRO] BTREE_MAP_OR_INSERT %out_inserted, %out_value_ptr, %map_reg, %key_reg, %value
    EXPAND BTREE_MAP_ENTRY_OR_INSERT %out_inserted, %out_value_ptr, %map_reg, %key_reg, %value
[END_MACRO]

// Concrete entry-style helpers. Default inserted value is 0 for the u64 map.

[MACRO] BTREE_MAP_ENTRY_OR_DEFAULT %out_inserted, %out_value_ptr, %map_reg, %key_reg
