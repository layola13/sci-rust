[END_MACRO]

[MACRO] BTREE_MAP_ENTRY_AND_MODIFY %out_ok, %map_reg, %key_reg, %value
    __btree_and_mod_ptr_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_btree_map_get_mut_ptr(&%map_reg, &%key_reg, &__btree_and_mod_ptr_slot_%out_ok)
    __btree_and_mod_ptr_%out_ok = load __btree_and_mod_ptr_slot_%out_ok+0 as ptr
    __btree_and_mod_has_%out_ok = eq %out_ok, 1
