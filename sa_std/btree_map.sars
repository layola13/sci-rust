    !__btree_map_extract_same_slot_%out_len
    !__btree_map_extract_write_%out_len
    jmp L_BTREE_MAP_EXTRACT_NEXT_%out_len

L_BTREE_MAP_EXTRACT_NEXT_%out_len:
    __btree_map_extract_next_read_%out_len = add __btree_map_extract_read_%out_len, 1
    store __btree_map_extract_read_slot_%out_len+0, __btree_map_extract_next_read_%out_len as u64
    !__btree_map_extract_next_read_%out_len
