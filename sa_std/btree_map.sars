    !__btree_map_extract_pred_%out_len
    !__btree_map_extract_value_ptr_%out_len
    !__btree_map_extract_read_entry_%out_len
    !__btree_map_extract_read_off_%out_len
    !__btree_map_extract_done_%out_len
