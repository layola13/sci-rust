    store __btree_map_extract_clear_slot_%out_len+0, __btree_map_extract_next_clear_%out_len as u64
    !__btree_map_extract_next_clear_%out_len
    !__btree_map_extract_clear_entry_%out_len
    !__btree_map_extract_clear_off_%out_len
    !__btree_map_extract_clear_done_%out_len
    !__btree_map_extract_clear_idx_%out_len
    jmp L_BTREE_MAP_EXTRACT_CLEAR_LOOP_%out_len

L_BTREE_MAP_EXTRACT_DONE_%out_len:
    %out_len = load __btree_map_extract_write_slot_%out_len+0 as u64
