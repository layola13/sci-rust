[MACRO] VEC_TRY_INSERT %out_ok, %vec_reg, %index, %value, %elem_size
    __vec_insert_view_%out_ok = & %vec_reg
    __vec_insert_len_%out_ok = load __vec_insert_view_%out_ok+Vec_len as u64
    __vec_insert_in_bounds_%out_ok = ule %index, __vec_insert_len_%out_ok
    br __vec_insert_in_bounds_%out_ok -> L_VEC_INSERT_PUSH_%out_ok, L_VEC_INSERT_MISS_%out_ok

L_VEC_INSERT_PUSH_%out_ok:
    !__vec_insert_view_%out_ok
    %vec_reg = call @sa_vec_push(^%vec_reg, 0, %elem_size)
    __vec_insert_view2_%out_ok = & %vec_reg
    __vec_insert_ptr_%out_ok = load __vec_insert_view2_%out_ok+Vec_ptr as ptr
    __vec_insert_pos_slot_%out_ok = stack_alloc 8
    store __vec_insert_pos_slot_%out_ok+0, __vec_insert_len_%out_ok as u64
    jmp L_VEC_INSERT_SHIFT_HEAD_%out_ok

L_VEC_INSERT_SHIFT_HEAD_%out_ok:
    __vec_insert_pos_%out_ok = load __vec_insert_pos_slot_%out_ok+0 as u64
    __vec_insert_more_%out_ok = ugt __vec_insert_pos_%out_ok, %index
    br __vec_insert_more_%out_ok -> L_VEC_INSERT_SHIFT_BODY_%out_ok, L_VEC_INSERT_STORE_%out_ok

L_VEC_INSERT_SHIFT_BODY_%out_ok:
