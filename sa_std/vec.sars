    jmp L_VEC_SWC_SHIFT_HEAD_%out_ok

L_VEC_SWC_COPY_%out_ok:
    !__vec_swc_more_%out_ok
    !__vec_swc_pos_%out_ok
    __vec_swc_copy_slot_%out_ok = stack_alloc 8
    store __vec_swc_copy_slot_%out_ok+0, 0 as u64
    jmp L_VEC_SWC_COPY_HEAD_%out_ok

L_VEC_SWC_COPY_HEAD_%out_ok:
    __vec_swc_copy_i_%out_ok = load __vec_swc_copy_slot_%out_ok+0 as u64
    __vec_swc_copy_done_%out_ok = eq __vec_swc_copy_i_%out_ok, __vec_swc_repl_len_%out_ok
    br __vec_swc_copy_done_%out_ok -> L_VEC_SWC_FINISH_%out_ok, L_VEC_SWC_COPY_BODY_%out_ok

L_VEC_SWC_COPY_BODY_%out_ok:
    __vec_swc_src_off_%out_ok = mul __vec_swc_copy_i_%out_ok, 8
    __vec_swc_src_ip_%out_ok = ptr_add __vec_swc_tmp_ptr_%out_ok, __vec_swc_src_off_%out_ok
    __vec_swc_dst_i_%out_ok = add %start, __vec_swc_copy_i_%out_ok
    __vec_swc_dst_off2_%out_ok = mul __vec_swc_dst_i_%out_ok, 8
    __vec_swc_dst_ip_%out_ok = ptr_add __vec_swc_ptr_%out_ok, __vec_swc_dst_off2_%out_ok
    __vec_swc_byte_%out_ok = load __vec_swc_src_ip_%out_ok+0 as u64
    store __vec_swc_dst_ip_%out_ok+0, __vec_swc_byte_%out_ok as u64
    __vec_swc_copy_next_%out_ok = add __vec_swc_copy_i_%out_ok, 1
    store __vec_swc_copy_slot_%out_ok+0, __vec_swc_copy_next_%out_ok as u64
    !__vec_swc_copy_next_%out_ok
    !__vec_swc_byte_%out_ok
    !__vec_swc_dst_ip_%out_ok
    !__vec_swc_dst_off2_%out_ok
    !__vec_swc_dst_i_%out_ok
    !__vec_swc_src_ip_%out_ok
    !__vec_swc_src_off_%out_ok
    !__vec_swc_copy_done_%out_ok
