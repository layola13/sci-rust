L_VEC_INWC_DONE_%out_ok:
    %out_ok = add 0, 1
    !__vec_inwc_done_%out_ok
    !__vec_inwc_idx_%out_ok
    jmp L_VEC_INWC_END_%out_ok

L_VEC_INWC_NO_ROOM_%out_ok:
    %out_ok = add 0, 0
    !__vec_inwc_room_ok_%out_ok
    !__vec_inwc_new_len_%out_ok
    !__vec_inwc_in_bounds_%out_ok
    !__vec_inwc_cap_%out_ok
