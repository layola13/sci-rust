L_VEC_IFSNWC_SETUP_%out_ok:
    __vec_ifsnwc_src_len_slot_%out_ok = stack_alloc 8
    store __vec_ifsnwc_src_len_slot_%out_ok+0, __vec_ifsnwc_src_len_%out_ok as u64
    __vec_ifsnwc_idx_slot_%out_ok = stack_alloc 8
    store __vec_ifsnwc_idx_slot_%out_ok+0, 0 as u64
    !__vec_ifsnwc_empty_%out_ok
    !__vec_ifsnwc_room_ok_%out_ok
    !__vec_ifsnwc_new_len_%out_ok
    !__vec_ifsnwc_total_%out_ok
    !__vec_ifsnwc_in_bounds_%out_ok
    !__vec_ifsnwc_cap_%out_ok
    !__vec_ifsnwc_len_%out_ok
