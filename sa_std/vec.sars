L_VEC_SWC_SHIFT_HEAD_%out_ok:
    __vec_swc_pos_%out_ok = load __vec_swc_pos_slot_%out_ok+0 as u64
    __vec_swc_more_%out_ok = ugt __vec_swc_pos_%out_ok, %start
