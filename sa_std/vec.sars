    jmp L_VEC_SWC_END_%out_ok

L_VEC_SWC_SHIFT_CHECK_%out_ok:
    !__vec_swc_same_%out_ok
    __vec_swc_suffix_len_%out_ok = sub __vec_swc_after_drain_%out_ok, %start
    __vec_swc_pos_slot_%out_ok = stack_alloc 8
    store __vec_swc_pos_slot_%out_ok+0, __vec_swc_after_drain_%out_ok as u64
