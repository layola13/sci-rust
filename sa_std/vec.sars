    jmp L_VEC_SWC_DRAIN_HEAD_%out_ok

L_VEC_SWC_DRAIN_DONE_%out_ok:
    store __vec_swc_view_%out_ok+Vec_len, __vec_swc_after_drain_%out_ok as u64
    !__vec_swc_done_%out_ok
    !__vec_swc_read_%out_ok
    __vec_swc_same_%out_ok = eq __vec_swc_repl_len_%out_ok, 0
    br __vec_swc_same_%out_ok -> L_VEC_SWC_NO_INSERT_%out_ok, L_VEC_SWC_SHIFT_CHECK_%out_ok

L_VEC_SWC_NO_INSERT_%out_ok:
    %out_ok = add 0, 1
    !__vec_swc_same_%out_ok
    !__vec_swc_end_%out_ok
    !__vec_swc_tmp_ptr_%out_ok
    !__vec_swc_tmp_view_%out_ok
    EXPAND VEC_FREE __vec_swc_tmp_%out_ok
    !__vec_swc_room_ok_%out_ok
    !__vec_swc_new_len_%out_ok
    !__vec_swc_after_drain_%out_ok
    !__vec_swc_len_ok_%out_ok
    !__vec_swc_remaining_%out_ok
    !__vec_swc_start_ok_%out_ok
    !__vec_swc_repl_len_%out_ok
    !__vec_swc_cap_%out_ok
    !__vec_swc_len_%out_ok
    !__vec_swc_ptr_%out_ok
