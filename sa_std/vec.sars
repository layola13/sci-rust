@import "alloc/vec.sal"
@import "alloc/vec.sars"
@import "core/slice.sal"
@import "core/slice.sars"
@import "core/iter.sars"
@import "ptr.sal"
@import "ptr.sars"
@import "hash.sars"

[MACRO] VEC_NEW %out_vec
    %out_vec = call @sa_vec_new()
[END_MACRO]

[MACRO] VEC_DEFAULT %out_vec
    EXPAND VEC_NEW %out_vec
[END_MACRO]

[MACRO] VEC_LEN %out_len, %vec_reg
    %out_len = call @sa_vec_len(&%vec_reg)
[END_MACRO]

[MACRO] VEC_AS_PTR %out_ptr, %vec_reg
    __vec_view_%out_ptr = & %vec_reg
    %out_ptr = load __vec_view_%out_ptr+Vec_ptr as ptr
    !__vec_view_%out_ptr
[END_MACRO]

[MACRO] VEC_AS_MUT_PTR %out_ptr, %vec_reg
    EXPAND VEC_AS_PTR %out_ptr, %vec_reg
[END_MACRO]

[MACRO] VEC_AS_PTR_RANGE %out_start, %out_end, %vec_reg, %elem_size
    EXPAND VEC_AS_SLICE __vec_ptr_range_slice_%out_start, %vec_reg
    EXPAND SLICE_AS_PTR_RANGE %out_start, %out_end, __vec_ptr_range_slice_%out_start, %elem_size
    !__vec_ptr_range_slice_%out_start
[END_MACRO]

[MACRO] VEC_AS_MUT_PTR_RANGE %out_start, %out_end, %vec_reg, %elem_size
    EXPAND VEC_AS_MUT_SLICE __vec_mut_ptr_range_slice_%out_start, %vec_reg
    EXPAND SLICE_AS_MUT_PTR_RANGE %out_start, %out_end, __vec_mut_ptr_range_slice_%out_start, %elem_size
    !__vec_mut_ptr_range_slice_%out_start
[END_MACRO]

[MACRO] VEC_AS_PTR_RANGE_U64 %out_start, %out_end, %vec_reg
    EXPAND VEC_AS_PTR_RANGE %out_start, %out_end, %vec_reg, 8
[END_MACRO]

[MACRO] VEC_AS_MUT_PTR_RANGE_U64 %out_start, %out_end, %vec_reg
    EXPAND VEC_AS_MUT_PTR_RANGE %out_start, %out_end, %vec_reg, 8
[END_MACRO]

[MACRO] VEC_AS_SLICE %out_slice, %vec_reg
    __vec_view_%out_slice = & %vec_reg
    __vec_ptr_%out_slice = load __vec_view_%out_slice+Vec_ptr as ptr
    __vec_len_%out_slice = load __vec_view_%out_slice+Vec_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __vec_ptr_%out_slice, __vec_len_%out_slice
    !__vec_ptr_%out_slice
    !__vec_len_%out_slice
    !__vec_view_%out_slice
[END_MACRO]

[MACRO] VEC_AS_MUT_SLICE %out_slice, %vec_reg
    EXPAND VEC_AS_SLICE %out_slice, %vec_reg
[END_MACRO]

[MACRO] VEC_AS_REF_SLICE %out_slice, %vec_reg
    EXPAND VEC_AS_SLICE %out_slice, %vec_reg
[END_MACRO]

[MACRO] VEC_AS_MUT_REF_SLICE %out_slice, %vec_reg
    EXPAND VEC_AS_MUT_SLICE %out_slice, %vec_reg
[END_MACRO]

[MACRO] VEC_AS_REF_VEC_PTR %out_ptr, %vec_reg
    %out_ptr = & %vec_reg
[END_MACRO]

[MACRO] VEC_AS_MUT_VEC_PTR %out_ptr, %vec_reg
    %out_ptr = & %vec_reg
[END_MACRO]

[MACRO] VEC_DEREF_SLICE %out_slice, %vec_reg
    EXPAND VEC_AS_SLICE %out_slice, %vec_reg
[END_MACRO]

[MACRO] VEC_DEREF_MUT_SLICE %out_slice, %vec_reg
    EXPAND VEC_AS_MUT_SLICE %out_slice, %vec_reg
[END_MACRO]

[MACRO] VEC_ITER_U64 %out_iter, %vec_reg
    EXPAND VEC_AS_SLICE __vec_iter_slice_%out_iter, %vec_reg
    EXPAND ITER_FROM_SLICE %out_iter, __vec_iter_slice_%out_iter
    !__vec_iter_slice_%out_iter
[END_MACRO]

// Rust method-name alias over VEC_ITER_U64.
[MACRO] VEC_ITER %out_iter, %vec_reg
    EXPAND VEC_ITER_U64 %out_iter, %vec_reg
[END_MACRO]

[MACRO] VEC_ITER_MUT_U64 %out_iter, %vec_reg
    EXPAND VEC_AS_MUT_SLICE __vec_iter_mut_slice_%out_iter, %vec_reg
    EXPAND ITER_FROM_SLICE %out_iter, __vec_iter_mut_slice_%out_iter
    !__vec_iter_mut_slice_%out_iter
[END_MACRO]

// Rust method-name alias over VEC_ITER_MUT_U64.
[MACRO] VEC_ITER_MUT %out_iter, %vec_reg
