[MACRO] VEC_TRY_INSERT_FROM_SLICE_N_WITHIN_CAPACITY %out_ok, %vec_reg, %index, %slice_reg, %count, %elem_size
    __vec_ifsnwc_src_len_%out_ok = load %slice_reg+Slice_len as u64
    __vec_ifsnwc_view_%out_ok = & %vec_reg
    __vec_ifsnwc_len_%out_ok = load __vec_ifsnwc_view_%out_ok+Vec_len as u64
    __vec_ifsnwc_cap_%out_ok = load __vec_ifsnwc_view_%out_ok+Vec_cap as u64
    __vec_ifsnwc_in_bounds_%out_ok = ule %index, __vec_ifsnwc_len_%out_ok
    br __vec_ifsnwc_in_bounds_%out_ok -> L_VEC_IFSNWC_ROOM_%out_ok, L_VEC_IFSNWC_MISS_%out_ok

L_VEC_IFSNWC_ROOM_%out_ok:
    __vec_ifsnwc_total_%out_ok = mul __vec_ifsnwc_src_len_%out_ok, %count
    __vec_ifsnwc_new_len_%out_ok = add __vec_ifsnwc_len_%out_ok, __vec_ifsnwc_total_%out_ok
    __vec_ifsnwc_room_ok_%out_ok = ule __vec_ifsnwc_new_len_%out_ok, __vec_ifsnwc_cap_%out_ok
    br __vec_ifsnwc_room_ok_%out_ok -> L_VEC_IFSNWC_EMPTY_CHECK_%out_ok, L_VEC_IFSNWC_NO_ROOM_%out_ok

L_VEC_IFSNWC_EMPTY_CHECK_%out_ok:
    __vec_ifsnwc_empty_%out_ok = eq __vec_ifsnwc_total_%out_ok, 0
    br __vec_ifsnwc_empty_%out_ok -> L_VEC_IFSNWC_EMPTY_HIT_%out_ok, L_VEC_IFSNWC_SETUP_%out_ok

L_VEC_IFSNWC_EMPTY_HIT_%out_ok:
    %out_ok = add 0, 1
