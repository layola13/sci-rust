L_VEC_SWC_LEN_CHECK_%out_ok:
    __vec_swc_remaining_%out_ok = sub __vec_swc_len_%out_ok, %start
    __vec_swc_len_ok_%out_ok = ule %length, __vec_swc_remaining_%out_ok
    br __vec_swc_len_ok_%out_ok -> L_VEC_SWC_ROOM_%out_ok, L_VEC_SWC_MISS_LEN_%out_ok

L_VEC_SWC_ROOM_%out_ok:
    __vec_swc_after_drain_%out_ok = sub __vec_swc_len_%out_ok, %length
    __vec_swc_new_len_%out_ok = add __vec_swc_after_drain_%out_ok, __vec_swc_repl_len_%out_ok
    __vec_swc_room_ok_%out_ok = ule __vec_swc_new_len_%out_ok, __vec_swc_cap_%out_ok
    br __vec_swc_room_ok_%out_ok -> L_VEC_SWC_TEMP_%out_ok, L_VEC_SWC_NO_ROOM_%out_ok

L_VEC_SWC_TEMP_%out_ok:
    EXPAND VEC_WITH_CAPACITY_U64 __vec_swc_tmp_%out_ok, __vec_swc_repl_len_%out_ok
    EXPAND VEC_EXTEND_FROM_SLICE_U64 __vec_swc_tmp_%out_ok, %replacement_slice
    EXPAND VEC_AS_SLICE __vec_swc_tmp_view_%out_ok, __vec_swc_tmp_%out_ok
    __vec_swc_tmp_ptr_%out_ok = load __vec_swc_tmp_view_%out_ok+Slice_ptr as ptr
    EXPAND VEC_WITH_CAPACITY_U64 %out_vec, %length
    __vec_swc_end_%out_ok = add %start, %length
    __vec_swc_read_slot_%out_ok = stack_alloc 8
    __vec_swc_write_slot_%out_ok = stack_alloc 8
    store __vec_swc_read_slot_%out_ok+0, %start as u64
    store __vec_swc_write_slot_%out_ok+0, %start as u64
    jmp L_VEC_SWC_DRAIN_HEAD_%out_ok

L_VEC_SWC_DRAIN_HEAD_%out_ok:
    __vec_swc_read_%out_ok = load __vec_swc_read_slot_%out_ok+0 as u64
    __vec_swc_done_%out_ok = eq __vec_swc_read_%out_ok, __vec_swc_len_%out_ok
    br __vec_swc_done_%out_ok -> L_VEC_SWC_DRAIN_DONE_%out_ok, L_VEC_SWC_DRAIN_BODY_%out_ok

L_VEC_SWC_DRAIN_BODY_%out_ok:
    __vec_swc_read_off_%out_ok = mul __vec_swc_read_%out_ok, 8
    __vec_swc_read_ptr_%out_ok = ptr_add __vec_swc_ptr_%out_ok, __vec_swc_read_off_%out_ok
    __vec_swc_value_%out_ok = load __vec_swc_read_ptr_%out_ok+0 as u64
    __vec_swc_take_%out_ok = ult __vec_swc_read_%out_ok, __vec_swc_end_%out_ok
    br __vec_swc_take_%out_ok -> L_VEC_SWC_TAKE_%out_ok, L_VEC_SWC_KEEP_%out_ok

L_VEC_SWC_TAKE_%out_ok:
    EXPAND VEC_PUSH_U64 %out_vec, __vec_swc_value_%out_ok
    jmp L_VEC_SWC_DRAIN_NEXT_%out_ok

L_VEC_SWC_KEEP_%out_ok:
    __vec_swc_write_%out_ok = load __vec_swc_write_slot_%out_ok+0 as u64
    __vec_swc_write_off_%out_ok = mul __vec_swc_write_%out_ok, 8
    __vec_swc_write_ptr_%out_ok = ptr_add __vec_swc_ptr_%out_ok, __vec_swc_write_off_%out_ok
    store __vec_swc_write_ptr_%out_ok+0, __vec_swc_value_%out_ok as u64
    __vec_swc_next_write_%out_ok = add __vec_swc_write_%out_ok, 1
    store __vec_swc_write_slot_%out_ok+0, __vec_swc_next_write_%out_ok as u64
    !__vec_swc_next_write_%out_ok
    !__vec_swc_write_ptr_%out_ok
    !__vec_swc_write_off_%out_ok
    !__vec_swc_write_%out_ok
    jmp L_VEC_SWC_DRAIN_NEXT_%out_ok

L_VEC_SWC_DRAIN_NEXT_%out_ok:
    __vec_swc_next_read_%out_ok = add __vec_swc_read_%out_ok, 1
    store __vec_swc_read_slot_%out_ok+0, __vec_swc_next_read_%out_ok as u64
    !__vec_swc_next_read_%out_ok
    !__vec_swc_take_%out_ok
    !__vec_swc_value_%out_ok
    !__vec_swc_read_ptr_%out_ok
    !__vec_swc_read_off_%out_ok
    !__vec_swc_done_%out_ok
