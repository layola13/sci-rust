L_VEC_IFSNWC_HEAD_%out_ok:
    __vec_ifsnwc_idx_%out_ok = load __vec_ifsnwc_idx_slot_%out_ok+0 as u64
    __vec_ifsnwc_done_%out_ok = eq __vec_ifsnwc_idx_%out_ok, %count
    br __vec_ifsnwc_done_%out_ok -> L_VEC_IFSNWC_DONE_%out_ok, L_VEC_IFSNWC_BODY_%out_ok

L_VEC_IFSNWC_BODY_%out_ok:
    __vec_ifsnwc_step_%out_ok = load __vec_ifsnwc_src_len_slot_%out_ok+0 as u64
    __vec_ifsnwc_pos_%out_ok = mul __vec_ifsnwc_idx_%out_ok, __vec_ifsnwc_step_%out_ok
    __vec_ifsnwc_at_%out_ok = add %index, __vec_ifsnwc_pos_%out_ok
    EXPAND VEC_TRY_INSERT_FROM_SLICE_WITHIN_CAPACITY __vec_ifsnwc_push_ok_%out_ok, %vec_reg, __vec_ifsnwc_at_%out_ok, %slice_reg, %elem_size
    br __vec_ifsnwc_push_ok_%out_ok -> L_VEC_IFSNWC_NEXT_%out_ok, L_VEC_IFSNWC_FAIL_%out_ok

L_VEC_IFSNWC_NEXT_%out_ok:
    __vec_ifsnwc_next_%out_ok = add __vec_ifsnwc_idx_%out_ok, 1
    store __vec_ifsnwc_idx_slot_%out_ok+0, __vec_ifsnwc_next_%out_ok as u64
    !__vec_ifsnwc_next_%out_ok
    !__vec_ifsnwc_push_ok_%out_ok
    !__vec_ifsnwc_at_%out_ok
    !__vec_ifsnwc_pos_%out_ok
    !__vec_ifsnwc_step_%out_ok
