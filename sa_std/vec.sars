[MACRO] VEC_RESIZE_WITHIN_CAPACITY_U64 %out_ok, %vec_reg, %new_len, %fill_value
    EXPAND VEC_RESIZE_WITHIN_CAPACITY %out_ok, %vec_reg, %new_len, %fill_value, 8
[END_MACRO]

[MACRO] VEC_RESIZE %vec_reg, %new_len, %fill_value, %elem_size
    %vec_reg = call @sa_vec_resize(^%vec_reg, %new_len, %fill_value, %elem_size)
[END_MACRO]

[MACRO] VEC_RESIZE_U64 %vec_reg, %new_len, %fill_value
    EXPAND VEC_RESIZE %vec_reg, %new_len, %fill_value, 8
[END_MACRO]

[MACRO] VEC_RESIZE_WITH_U64 %out_len, %vec_reg, %new_len, %gen_fn
    __vec_resize_with_view_%out_len = & %vec_reg
    __vec_resize_with_len_%out_len = load __vec_resize_with_view_%out_len+Vec_len as u64
    __vec_resize_with_grow_%out_len = ugt %new_len, __vec_resize_with_len_%out_len
    br __vec_resize_with_grow_%out_len -> L_VEC_RESIZE_WITH_GROW_%out_len, L_VEC_RESIZE_WITH_TRUNCATE_%out_len

L_VEC_RESIZE_WITH_TRUNCATE_%out_len:
    call @sa_vec_truncate(&%vec_reg, %new_len)
    %out_len = add %new_len, 0
    !__vec_resize_with_grow_%out_len
    !__vec_resize_with_len_%out_len
    !__vec_resize_with_view_%out_len
    jmp L_VEC_RESIZE_WITH_END_%out_len

L_VEC_RESIZE_WITH_GROW_%out_len:
    __vec_resize_with_additional_%out_len = sub %new_len, __vec_resize_with_len_%out_len
    EXPAND VEC_RESERVE_U64 %vec_reg, __vec_resize_with_additional_%out_len
    __vec_resize_with_idx_slot_%out_len = stack_alloc 8
    store __vec_resize_with_idx_slot_%out_len+0, __vec_resize_with_len_%out_len as u64
    !__vec_resize_with_additional_%out_len
    !__vec_resize_with_grow_%out_len
    !__vec_resize_with_len_%out_len
    !__vec_resize_with_view_%out_len
    jmp L_VEC_RESIZE_WITH_HEAD_%out_len

L_VEC_RESIZE_WITH_HEAD_%out_len:
    __vec_resize_with_idx_%out_len = load __vec_resize_with_idx_slot_%out_len+0 as u64
    __vec_resize_with_done_%out_len = eq __vec_resize_with_idx_%out_len, %new_len
    br __vec_resize_with_done_%out_len -> L_VEC_RESIZE_WITH_DONE_%out_len, L_VEC_RESIZE_WITH_BODY_%out_len

L_VEC_RESIZE_WITH_BODY_%out_len:
    __vec_resize_with_value_%out_len = call %gen_fn()
    EXPAND VEC_PUSH_U64 %vec_reg, __vec_resize_with_value_%out_len
    __vec_resize_with_next_%out_len = add __vec_resize_with_idx_%out_len, 1
    store __vec_resize_with_idx_slot_%out_len+0, __vec_resize_with_next_%out_len as u64
    !__vec_resize_with_next_%out_len
    !__vec_resize_with_value_%out_len
    !__vec_resize_with_done_%out_len
    !__vec_resize_with_idx_%out_len
    jmp L_VEC_RESIZE_WITH_HEAD_%out_len

L_VEC_RESIZE_WITH_DONE_%out_len:
    %out_len = add %new_len, 0
    !__vec_resize_with_done_%out_len
    !__vec_resize_with_idx_%out_len

L_VEC_RESIZE_WITH_END_%out_len:
[END_MACRO]

// Rust method-name alias over VEC_RESIZE_WITH_U64.
[MACRO] VEC_RESIZE_WITH %out_len, %vec_reg, %new_len, %gen_fn
    EXPAND VEC_RESIZE_WITH_U64 %out_len, %vec_reg, %new_len, %gen_fn
[END_MACRO]

[MACRO] VEC_TRY_RESIZE_WITH_WITHIN_CAPACITY_U64 %out_ok, %out_len, %vec_reg, %new_len, %gen_fn
    __vec_rswwc_view_%out_ok = & %vec_reg
    __vec_rswwc_len_%out_ok = load __vec_rswwc_view_%out_ok+Vec_len as u64
    __vec_rswwc_cap_%out_ok = load __vec_rswwc_view_%out_ok+Vec_cap as u64
    __vec_rswwc_shrink_%out_ok = ule %new_len, __vec_rswwc_len_%out_ok
    br __vec_rswwc_shrink_%out_ok -> L_VEC_RSWWC_SHRINK_%out_ok, L_VEC_RSWWC_GROW_CHECK_%out_ok

L_VEC_RSWWC_SHRINK_%out_ok:
    store __vec_rswwc_view_%out_ok+Vec_len, %new_len as u64
    %out_len = add %new_len, 0
    %out_ok = add 0, 1
    !__vec_rswwc_shrink_%out_ok
    !__vec_rswwc_cap_%out_ok
    !__vec_rswwc_len_%out_ok
    !__vec_rswwc_view_%out_ok
    jmp L_VEC_RSWWC_END_%out_ok

L_VEC_RSWWC_GROW_CHECK_%out_ok:
    __vec_rswwc_room_ok_%out_ok = ule %new_len, __vec_rswwc_cap_%out_ok
    br __vec_rswwc_room_ok_%out_ok -> L_VEC_RSWWC_GROW_SETUP_%out_ok, L_VEC_RSWWC_NO_ROOM_%out_ok

L_VEC_RSWWC_GROW_SETUP_%out_ok:
    __vec_rswwc_idx_slot_%out_ok = stack_alloc 8
    store __vec_rswwc_idx_slot_%out_ok+0, __vec_rswwc_len_%out_ok as u64
    !__vec_rswwc_room_ok_%out_ok
    !__vec_rswwc_shrink_%out_ok
    !__vec_rswwc_cap_%out_ok
    !__vec_rswwc_len_%out_ok
    !__vec_rswwc_view_%out_ok
    jmp L_VEC_RSWWC_GROW_HEAD_%out_ok

L_VEC_RSWWC_GROW_HEAD_%out_ok:
    __vec_rswwc_idx_%out_ok = load __vec_rswwc_idx_slot_%out_ok+0 as u64
    __vec_rswwc_done_%out_ok = eq __vec_rswwc_idx_%out_ok, %new_len
    br __vec_rswwc_done_%out_ok -> L_VEC_RSWWC_GROW_DONE_%out_ok, L_VEC_RSWWC_GROW_BODY_%out_ok

L_VEC_RSWWC_GROW_BODY_%out_ok:
    __vec_rswwc_value_%out_ok = call %gen_fn()
    EXPAND VEC_TRY_PUSH_WITHIN_CAPACITY_U64 __vec_rswwc_push_ok_%out_ok, %vec_reg, __vec_rswwc_value_%out_ok
    br __vec_rswwc_push_ok_%out_ok -> L_VEC_RSWWC_GROW_NEXT_%out_ok, L_VEC_RSWWC_GROW_FAIL_%out_ok

L_VEC_RSWWC_GROW_NEXT_%out_ok:
    __vec_rswwc_next_%out_ok = add __vec_rswwc_idx_%out_ok, 1
    store __vec_rswwc_idx_slot_%out_ok+0, __vec_rswwc_next_%out_ok as u64
    !__vec_rswwc_next_%out_ok
    !__vec_rswwc_push_ok_%out_ok
    !__vec_rswwc_value_%out_ok
    !__vec_rswwc_done_%out_ok
    !__vec_rswwc_idx_%out_ok
    jmp L_VEC_RSWWC_GROW_HEAD_%out_ok

L_VEC_RSWWC_GROW_FAIL_%out_ok:
    %out_len = load __vec_rswwc_idx_slot_%out_ok+0 as u64
    %out_ok = add 0, 0
    !__vec_rswwc_push_ok_%out_ok
    !__vec_rswwc_value_%out_ok
    !__vec_rswwc_done_%out_ok
    !__vec_rswwc_idx_%out_ok
    jmp L_VEC_RSWWC_END_%out_ok

L_VEC_RSWWC_GROW_DONE_%out_ok:
    %out_len = add %new_len, 0
    %out_ok = add 0, 1
    !__vec_rswwc_done_%out_ok
    !__vec_rswwc_idx_%out_ok
    jmp L_VEC_RSWWC_END_%out_ok

L_VEC_RSWWC_NO_ROOM_%out_ok:
    %out_len = add __vec_rswwc_len_%out_ok, 0
    %out_ok = add 0, 0
    !__vec_rswwc_room_ok_%out_ok
    !__vec_rswwc_shrink_%out_ok
    !__vec_rswwc_cap_%out_ok
    !__vec_rswwc_len_%out_ok
    !__vec_rswwc_view_%out_ok

L_VEC_RSWWC_END_%out_ok:
[END_MACRO]

// Rust method-name alias over VEC_TRY_RESIZE_WITH_WITHIN_CAPACITY_U64.
[MACRO] VEC_TRY_RESIZE_WITH_WITHIN_CAPACITY %out_ok, %out_len, %vec_reg, %new_len, %gen_fn
