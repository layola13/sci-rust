L_VEC_SWC_SHIFT_BODY_%out_ok:
    __vec_swc_prev_%out_ok = sub __vec_swc_pos_%out_ok, 1
    __vec_swc_prev_off_%out_ok = mul __vec_swc_prev_%out_ok, 8
    __vec_swc_dst_idx_%out_ok = add __vec_swc_prev_%out_ok, __vec_swc_repl_len_%out_ok
    __vec_swc_dst_off_%out_ok = mul __vec_swc_dst_idx_%out_ok, 8
    __vec_swc_prev_ptr_%out_ok = ptr_add __vec_swc_ptr_%out_ok, __vec_swc_prev_off_%out_ok
    __vec_swc_dst_ptr_%out_ok = ptr_add __vec_swc_ptr_%out_ok, __vec_swc_dst_off_%out_ok
    __vec_swc_move_%out_ok = load __vec_swc_prev_ptr_%out_ok+0 as u64
    store __vec_swc_dst_ptr_%out_ok+0, __vec_swc_move_%out_ok as u64
    store __vec_swc_pos_slot_%out_ok+0, __vec_swc_prev_%out_ok as u64
    !__vec_swc_move_%out_ok
    !__vec_swc_dst_ptr_%out_ok
    !__vec_swc_prev_ptr_%out_ok
    !__vec_swc_dst_off_%out_ok
    !__vec_swc_dst_idx_%out_ok
    !__vec_swc_prev_off_%out_ok
