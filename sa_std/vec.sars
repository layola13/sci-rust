[MACRO] VEC_TRY_INSERT_FROM_SLICE_WITHIN_CAPACITY %out_ok, %vec_reg, %index, %slice_reg, %elem_size
    __vec_ifswc_src_len_%out_ok = load %slice_reg+Slice_len as u64
    __vec_ifswc_view_%out_ok = & %vec_reg
    __vec_ifswc_len_%out_ok = load __vec_ifswc_view_%out_ok+Vec_len as u64
    __vec_ifswc_cap_%out_ok = load __vec_ifswc_view_%out_ok+Vec_cap as u64
    __vec_ifswc_in_bounds_%out_ok = ule %index, __vec_ifswc_len_%out_ok
    br __vec_ifswc_in_bounds_%out_ok -> L_VEC_IFSWC_ROOM_%out_ok, L_VEC_IFSWC_MISS_%out_ok

L_VEC_IFSWC_ROOM_%out_ok:
    __vec_ifswc_new_len_%out_ok = add __vec_ifswc_len_%out_ok, __vec_ifswc_src_len_%out_ok
    __vec_ifswc_room_ok_%out_ok = ule __vec_ifswc_new_len_%out_ok, __vec_ifswc_cap_%out_ok
    br __vec_ifswc_room_ok_%out_ok -> L_VEC_IFSWC_EMPTY_%out_ok, L_VEC_IFSWC_NO_ROOM_%out_ok

L_VEC_IFSWC_EMPTY_%out_ok:
    __vec_ifswc_empty_%out_ok = eq __vec_ifswc_src_len_%out_ok, 0
    br __vec_ifswc_empty_%out_ok -> L_VEC_IFSWC_EMPTY_HIT_%out_ok, L_VEC_IFSWC_SHIFT_SETUP_%out_ok

L_VEC_IFSWC_EMPTY_HIT_%out_ok:
    %out_ok = add 0, 1
    !__vec_ifswc_empty_%out_ok
    !__vec_ifswc_room_ok_%out_ok
    !__vec_ifswc_new_len_%out_ok
    !__vec_ifswc_in_bounds_%out_ok
    !__vec_ifswc_cap_%out_ok
    !__vec_ifswc_len_%out_ok
    !__vec_ifswc_view_%out_ok
    !__vec_ifswc_src_len_%out_ok
    jmp L_VEC_IFSWC_END_%out_ok

L_VEC_IFSWC_SHIFT_SETUP_%out_ok:
    __vec_ifswc_ptr_%out_ok = load __vec_ifswc_view_%out_ok+Vec_ptr as ptr
    __vec_ifswc_pos_slot_%out_ok = stack_alloc 8
    store __vec_ifswc_pos_slot_%out_ok+0, __vec_ifswc_len_%out_ok as u64
    jmp L_VEC_IFSWC_SHIFT_HEAD_%out_ok

L_VEC_IFSWC_SHIFT_HEAD_%out_ok:
    __vec_ifswc_pos_%out_ok = load __vec_ifswc_pos_slot_%out_ok+0 as u64
    __vec_ifswc_more_%out_ok = ugt __vec_ifswc_pos_%out_ok, %index
    br __vec_ifswc_more_%out_ok -> L_VEC_IFSWC_SHIFT_BODY_%out_ok, L_VEC_IFSWC_COPY_%out_ok

L_VEC_IFSWC_SHIFT_BODY_%out_ok:
    __vec_ifswc_prev_%out_ok = sub __vec_ifswc_pos_%out_ok, 1
    __vec_ifswc_prev_off_%out_ok = mul __vec_ifswc_prev_%out_ok, %elem_size
    __vec_ifswc_dst_idx_%out_ok = add __vec_ifswc_prev_%out_ok, __vec_ifswc_src_len_%out_ok
    __vec_ifswc_dst_off_%out_ok = mul __vec_ifswc_dst_idx_%out_ok, %elem_size
    __vec_ifswc_prev_ptr_%out_ok = ptr_add __vec_ifswc_ptr_%out_ok, __vec_ifswc_prev_off_%out_ok
    __vec_ifswc_dst_ptr_%out_ok = ptr_add __vec_ifswc_ptr_%out_ok, __vec_ifswc_dst_off_%out_ok
    __vec_ifswc_move_value_%out_ok = load __vec_ifswc_prev_ptr_%out_ok+0 as u64
    store __vec_ifswc_dst_ptr_%out_ok+0, __vec_ifswc_move_value_%out_ok as u64
    store __vec_ifswc_pos_slot_%out_ok+0, __vec_ifswc_prev_%out_ok as u64
    !__vec_ifswc_move_value_%out_ok
    !__vec_ifswc_dst_ptr_%out_ok
    !__vec_ifswc_prev_ptr_%out_ok
    !__vec_ifswc_dst_off_%out_ok
    !__vec_ifswc_dst_idx_%out_ok
    !__vec_ifswc_prev_off_%out_ok
    !__vec_ifswc_prev_%out_ok
    !__vec_ifswc_more_%out_ok
    !__vec_ifswc_pos_%out_ok
    jmp L_VEC_IFSWC_SHIFT_HEAD_%out_ok

L_VEC_IFSWC_COPY_%out_ok:
    __vec_ifswc_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __vec_ifswc_copy_slot_%out_ok = stack_alloc 8
    store __vec_ifswc_copy_slot_%out_ok+0, 0 as u64
    jmp L_VEC_IFSWC_COPY_HEAD_%out_ok

L_VEC_IFSWC_COPY_HEAD_%out_ok:
    __vec_ifswc_copy_idx_%out_ok = load __vec_ifswc_copy_slot_%out_ok+0 as u64
    __vec_ifswc_copy_done_%out_ok = eq __vec_ifswc_copy_idx_%out_ok, __vec_ifswc_src_len_%out_ok
    br __vec_ifswc_copy_done_%out_ok -> L_VEC_IFSWC_STORE_LEN_%out_ok, L_VEC_IFSWC_COPY_BODY_%out_ok

L_VEC_IFSWC_COPY_BODY_%out_ok:
    __vec_ifswc_src_off_%out_ok = mul __vec_ifswc_copy_idx_%out_ok, %elem_size
    __vec_ifswc_dst_idx2_%out_ok = add %index, __vec_ifswc_copy_idx_%out_ok
    __vec_ifswc_dst_off2_%out_ok = mul __vec_ifswc_dst_idx2_%out_ok, %elem_size
    __vec_ifswc_src_i_%out_ok = ptr_add __vec_ifswc_src_ptr_%out_ok, __vec_ifswc_src_off_%out_ok
    __vec_ifswc_dst_i_%out_ok = ptr_add __vec_ifswc_ptr_%out_ok, __vec_ifswc_dst_off2_%out_ok
    __vec_ifswc_value_%out_ok = load __vec_ifswc_src_i_%out_ok+0 as u64
    store __vec_ifswc_dst_i_%out_ok+0, __vec_ifswc_value_%out_ok as u64
    __vec_ifswc_copy_next_%out_ok = add __vec_ifswc_copy_idx_%out_ok, 1
    store __vec_ifswc_copy_slot_%out_ok+0, __vec_ifswc_copy_next_%out_ok as u64
    !__vec_ifswc_copy_next_%out_ok
    !__vec_ifswc_value_%out_ok
    !__vec_ifswc_dst_i_%out_ok
    !__vec_ifswc_src_i_%out_ok
    !__vec_ifswc_dst_off2_%out_ok
    !__vec_ifswc_dst_idx2_%out_ok
    !__vec_ifswc_src_off_%out_ok
    !__vec_ifswc_copy_done_%out_ok
    !__vec_ifswc_copy_idx_%out_ok
    jmp L_VEC_IFSWC_COPY_HEAD_%out_ok

L_VEC_IFSWC_STORE_LEN_%out_ok:
    store __vec_ifswc_view_%out_ok+Vec_len, __vec_ifswc_new_len_%out_ok as u64
    %out_ok = add 0, 1
    !__vec_ifswc_copy_done_%out_ok
    !__vec_ifswc_copy_idx_%out_ok
    !__vec_ifswc_src_ptr_%out_ok
    !__vec_ifswc_more_%out_ok
    !__vec_ifswc_pos_%out_ok
    !__vec_ifswc_ptr_%out_ok
    !__vec_ifswc_empty_%out_ok
    !__vec_ifswc_room_ok_%out_ok
    !__vec_ifswc_new_len_%out_ok
    !__vec_ifswc_in_bounds_%out_ok
    !__vec_ifswc_cap_%out_ok
    !__vec_ifswc_len_%out_ok
    !__vec_ifswc_view_%out_ok
    !__vec_ifswc_src_len_%out_ok
    jmp L_VEC_IFSWC_END_%out_ok

L_VEC_IFSWC_NO_ROOM_%out_ok:
    %out_ok = add 0, 0
    !__vec_ifswc_room_ok_%out_ok
    !__vec_ifswc_new_len_%out_ok
    !__vec_ifswc_in_bounds_%out_ok
    !__vec_ifswc_cap_%out_ok
    !__vec_ifswc_len_%out_ok
    !__vec_ifswc_view_%out_ok
    !__vec_ifswc_src_len_%out_ok
    jmp L_VEC_IFSWC_END_%out_ok

L_VEC_IFSWC_MISS_%out_ok:
    %out_ok = add 0, 0
    !__vec_ifswc_in_bounds_%out_ok
    !__vec_ifswc_cap_%out_ok
    !__vec_ifswc_len_%out_ok
