    !__vec_ifsnwc_push_ok_%out_ok
    !__vec_ifsnwc_at_%out_ok
    !__vec_ifsnwc_pos_%out_ok
    !__vec_ifsnwc_step_%out_ok
    !__vec_ifsnwc_done_%out_ok
    !__vec_ifsnwc_idx_%out_ok
    jmp L_VEC_IFSNWC_END_%out_ok

L_VEC_IFSNWC_DONE_%out_ok:
    %out_ok = add 0, 1
    !__vec_ifsnwc_done_%out_ok
    !__vec_ifsnwc_idx_%out_ok
    jmp L_VEC_IFSNWC_END_%out_ok

L_VEC_IFSNWC_NO_ROOM_%out_ok:
    %out_ok = add 0, 0
    !__vec_ifsnwc_room_ok_%out_ok
    !__vec_ifsnwc_new_len_%out_ok
    !__vec_ifsnwc_total_%out_ok
    !__vec_ifsnwc_in_bounds_%out_ok
    !__vec_ifsnwc_cap_%out_ok
