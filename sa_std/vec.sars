    br __vec_inwc_room_ok_%out_ok -> L_VEC_INWC_SETUP_%out_ok, L_VEC_INWC_NO_ROOM_%out_ok

L_VEC_INWC_SETUP_%out_ok:
    __vec_inwc_idx_slot_%out_ok = stack_alloc 8
    store __vec_inwc_idx_slot_%out_ok+0, 0 as u64
    !__vec_inwc_room_ok_%out_ok
    !__vec_inwc_new_len_%out_ok
    !__vec_inwc_in_bounds_%out_ok
    !__vec_inwc_cap_%out_ok
    !__vec_inwc_len_%out_ok
    !__vec_inwc_view_%out_ok
    jmp L_VEC_INWC_HEAD_%out_ok

L_VEC_INWC_HEAD_%out_ok:
    __vec_inwc_idx_%out_ok = load __vec_inwc_idx_slot_%out_ok+0 as u64
    __vec_inwc_done_%out_ok = eq __vec_inwc_idx_%out_ok, %count
    br __vec_inwc_done_%out_ok -> L_VEC_INWC_DONE_%out_ok, L_VEC_INWC_BODY_%out_ok

L_VEC_INWC_BODY_%out_ok:
    __vec_inwc_pos_%out_ok = add %index, __vec_inwc_idx_%out_ok
    EXPAND VEC_TRY_INSERT_WITHIN_CAPACITY __vec_inwc_push_ok_%out_ok, %vec_reg, __vec_inwc_pos_%out_ok, %value, %elem_size
    br __vec_inwc_push_ok_%out_ok -> L_VEC_INWC_NEXT_%out_ok, L_VEC_INWC_FAIL_%out_ok

L_VEC_INWC_NEXT_%out_ok:
    __vec_inwc_next_%out_ok = add __vec_inwc_idx_%out_ok, 1
    store __vec_inwc_idx_slot_%out_ok+0, __vec_inwc_next_%out_ok as u64
    !__vec_inwc_next_%out_ok
    !__vec_inwc_push_ok_%out_ok
    !__vec_inwc_pos_%out_ok
    !__vec_inwc_done_%out_ok
