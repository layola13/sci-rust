[END_MACRO]

[MACRO] VEC_ITER_DEFAULT_U64 %out_iter
    __vec_iter_default_slice_%out_iter = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW __vec_iter_default_slice_%out_iter, 0, 0
    EXPAND ITER_FROM_SLICE %out_iter, __vec_iter_default_slice_%out_iter
[END_MACRO]

