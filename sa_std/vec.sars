    EXPAND VEC_AS_SLICE __vec_into_iter_slice_%out_iter, %out_vec
    EXPAND ITER_FROM_SLICE %out_iter, __vec_into_iter_slice_%out_iter
    !__vec_into_iter_slice_%out_iter
    !__vec_into_iter_len_%out_iter
    !__vec_into_iter_cap_%out_iter
[END_MACRO]

