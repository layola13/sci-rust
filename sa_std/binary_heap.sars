// Concrete u64 max-heap with grow-on-demand storage.
@import "core/mem.sars"
@import "core/slice.sal"
@import "core/slice.sars"
@import "core/iter.sars"
@import "alloc/vec.sal"
@import "vec.sars"
@import "num.sars"
@import "binary_heap.sal"

@binary_heap_swap(&heap: ptr, lhs: u64, rhs: u64) -> void:
L_ENTRY:
    buf = take heap+BinaryHeap_buf
    lhs_off = mul lhs, BinaryHeap_SLOT_SIZE
    rhs_off = mul rhs, BinaryHeap_SLOT_SIZE
    lhs_ptr = ptr_add buf, lhs_off
    rhs_ptr = ptr_add buf, rhs_off
    lhs_value = load lhs_ptr+0 as u64
    rhs_value = load rhs_ptr+0 as u64
    store lhs_ptr+0, rhs_value as u64
    store rhs_ptr+0, lhs_value as u64
    !lhs_value
    !rhs_value
    !lhs_ptr
    !rhs_ptr
    !lhs_off
    !rhs_off
    !buf
    !rhs
    !lhs
    !heap
    return

@export sa_binary_heap_new() -> ^ptr:
L_ENTRY:
    heap = alloc BinaryHeap_SIZE
    initial_bytes = mul BinaryHeap_INITIAL_CAP, BinaryHeap_SLOT_SIZE
    buf = alloc initial_bytes
    call @sa_mem_set(&buf, 0, initial_bytes)
    store heap+BinaryHeap_buf, buf as ptr
    store heap+BinaryHeap_cap, BinaryHeap_INITIAL_CAP as u64
    store heap+BinaryHeap_len, 0 as u64
    ^buf
    !initial_bytes
    return heap

@binary_heap_next_capacity(requested: u64) -> u64:
L_ENTRY:
    cap = BinaryHeap_INITIAL_CAP
    requested_is_zero = eq requested, 0
    br requested_is_zero -> L_NEXT_CAP_ZERO, L_NEXT_CAP_LOOP

L_NEXT_CAP_LOOP:
    cap_ge_requested = uge cap, requested
    br cap_ge_requested -> L_NEXT_CAP_DONE, L_NEXT_CAP_GROW

L_NEXT_CAP_GROW:
    EXPAND NUM_U64_CHECKED_ADD next_cap_ok, next_cap, cap, cap
    br next_cap_ok -> L_NEXT_CAP_GROW_OK, L_NEXT_CAP_OVERFLOW

L_NEXT_CAP_OVERFLOW:
    panic(1801)

L_NEXT_CAP_GROW_OK:
    cap = next_cap
    !next_cap_ok
    !cap_ge_requested
    jmp L_NEXT_CAP_LOOP

L_NEXT_CAP_DONE:
    !cap_ge_requested
    !requested_is_zero
    !requested
    return cap

L_NEXT_CAP_ZERO:
    !requested_is_zero
    !requested
    return 0

@export sa_binary_heap_with_capacity(cap: u64) -> ^ptr:
L_ENTRY:
    heap = alloc BinaryHeap_SIZE
    target_cap = call @binary_heap_next_capacity(cap)
    target_zero = eq target_cap, 0
    br target_zero -> L_WITH_CAP_EMPTY, L_WITH_CAP_ALLOC

L_WITH_CAP_ALLOC:
    EXPAND NUM_U64_CHECKED_MUL bytes_ok, bytes, target_cap, BinaryHeap_SLOT_SIZE
    br bytes_ok -> L_WITH_CAP_ALLOC_BYTES_OK, L_WITH_CAP_ALLOC_OVERFLOW

L_WITH_CAP_ALLOC_OVERFLOW:
    panic(1802)

L_WITH_CAP_ALLOC_BYTES_OK:
    buf = alloc bytes
    call @sa_mem_set(&buf, 0, bytes)
    store heap+BinaryHeap_buf, buf as ptr
    store heap+BinaryHeap_cap, target_cap as u64
    store heap+BinaryHeap_len, 0 as u64
    ^buf
    !bytes_ok
    !bytes
    !target_zero
    !target_cap
    !cap
    return heap

L_WITH_CAP_EMPTY:
    store heap+BinaryHeap_buf, 0 as ptr
    store heap+BinaryHeap_cap, 0 as u64
    store heap+BinaryHeap_len, 0 as u64
    !target_zero
    !target_cap
    !cap
    return heap

@export sa_binary_heap_try_with_capacity(cap: u64, &out_heap_slot: ptr) -> i32:
L_ENTRY:
    heap = call @sa_binary_heap_with_capacity(cap)
    store out_heap_slot+0, heap as ptr
    !heap
    !out_heap_slot
    !cap
    return 1

@export sa_binary_heap_free(^heap: ptr) -> void:
L_ENTRY:
    buf = take heap+BinaryHeap_buf
    !buf
    !heap
    return

@export sa_binary_heap_len(&heap: ptr) -> u64:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    !heap
    return len

@export sa_binary_heap_capacity(&heap: ptr) -> u64:
L_ENTRY:
    cap = load heap+BinaryHeap_cap as u64
    !heap
    return cap

@export sa_binary_heap_is_empty(&heap: ptr) -> i32:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    empty = eq len, 0
    result = empty as i32
    !len
    !heap
    return result

@export sa_binary_heap_peek(&heap: ptr) -> u64:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    empty = eq len, 0
    br empty -> L_EMPTY, L_HIT

L_HIT:
    buf = take heap+BinaryHeap_buf
    root = load buf+0 as u64
    !buf
    !empty
    !len
    !heap
    return root

L_EMPTY:
    !empty
    !len
    !heap
    return 0

@export sa_binary_heap_try_peek_mut_ptr(&heap: ptr, &out_ptr_slot: ptr) -> i32:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    empty = eq len, 0
    br empty -> L_PEEK_MUT_EMPTY, L_PEEK_MUT_READY

L_PEEK_MUT_READY:
    buf = load heap+BinaryHeap_buf as ptr
    store out_ptr_slot+0, buf as ptr
    !buf
    !empty
    !len
    !heap
    !out_ptr_slot
    return 1

L_PEEK_MUT_EMPTY:
    store out_ptr_slot+0, 0 as ptr
    !empty
    !len
    !heap
    !out_ptr_slot
    return 0

@export sa_binary_heap_try_peek_mut_set_u64(&heap: ptr, value: u64, &out_old_slot: ptr) -> i32:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    empty = eq len, 0
    br empty -> L_PEEK_SET_EMPTY, L_PEEK_SET_READY

L_PEEK_SET_READY:
    buf = take heap+BinaryHeap_buf
    old_value = load buf+0 as u64
    store out_old_slot+0, old_value as u64
    store buf+0, value as u64
    call @binary_heap_sift_down(&heap, 0)
    !old_value
    !buf
    !empty
    !len
    !value
    !heap
    !out_old_slot
    return 1

L_PEEK_SET_EMPTY:
    store out_old_slot+0, 0 as u64
    !empty
    !len
    !value
    !heap
    !out_old_slot
    return 0

@binary_heap_sift_up(&heap: ptr, index: u64) -> void:
L_ENTRY:
    is_root = eq index, 0
    br is_root -> L_DONE_ROOT, L_BODY

L_BODY:
    idx_minus_one = sub index, 1
    parent = udiv idx_minus_one, 2
    buf = take heap+BinaryHeap_buf
    child_off = mul index, BinaryHeap_SLOT_SIZE
    parent_off = mul parent, BinaryHeap_SLOT_SIZE
    child_ptr = ptr_add buf, child_off
    parent_ptr = ptr_add buf, parent_off
    child_value = load child_ptr+0 as u64
    parent_value = load parent_ptr+0 as u64
    should_swap = ugt child_value, parent_value
    br should_swap -> L_SWAP, L_DONE_BODY

L_SWAP:
    call @binary_heap_swap(&heap, parent, index)
    call @binary_heap_sift_up(&heap, parent)
    !should_swap
    !child_value
    !parent_value
    !child_ptr
    !parent_ptr
    !child_off
    !parent_off
    !idx_minus_one
    !buf
    !parent
    !index
    !is_root
    !heap
    return

L_DONE_BODY:
    !should_swap
    !child_value
    !parent_value
    !child_ptr
    !parent_ptr
    !child_off
    !parent_off
    !idx_minus_one
    !buf
    !parent
    !index
    !is_root
    !heap
    return

L_DONE_ROOT:
    !is_root
    !index
    !heap
    return

@binary_heap_sift_down(&heap: ptr, index: u64) -> void:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    left_base = mul index, 2
    left = add left_base, 1
    has_left = ult left, len
    br has_left -> L_BODY, L_DONE_SHORT

L_BODY:
    buf = take heap+BinaryHeap_buf
    parent_off = mul index, BinaryHeap_SLOT_SIZE
    parent_ptr = ptr_add buf, parent_off
    parent_value = load parent_ptr+0 as u64
    left_off = mul left, BinaryHeap_SLOT_SIZE
    left_ptr = ptr_add buf, left_off
    left_value = load left_ptr+0 as u64
    right = add left, 1
    has_right = ult right, len
    br has_right -> L_RIGHT_BRANCH, L_LEFT_ONLY

L_LEFT_ONLY:
    should_swap = ugt left_value, parent_value
    br should_swap -> L_SWAP_LEFT_ONLY, L_DONE_LEFT_ONLY

L_RIGHT_BRANCH:
    right_off = mul right, BinaryHeap_SLOT_SIZE
    right_ptr = ptr_add buf, right_off
    right_value = load right_ptr+0 as u64
    right_bigger = ugt right_value, left_value
    br right_bigger -> L_RIGHT_BIGGER, L_LEFT_BIGGER

L_RIGHT_BIGGER:
    should_swap = ugt right_value, parent_value
    br should_swap -> L_SWAP_RIGHT, L_DONE_RIGHT_BRANCH

L_LEFT_BIGGER:
    should_swap = ugt left_value, parent_value
    br should_swap -> L_SWAP_LEFT_RIGHT, L_DONE_RIGHT_BRANCH

L_SWAP_RIGHT:
    call @binary_heap_swap(&heap, index, right)
    call @binary_heap_sift_down(&heap, right)
    !should_swap
    !right_bigger
    !right_value
    !right_ptr
    !right_off
    !has_right
    !right
    !left_value
    !left_ptr
    !left_off
    !parent_value
    !parent_ptr
    !parent_off
    !buf
    !len
    !left_base
    !left
    !index
    !heap
    return

L_SWAP_LEFT_RIGHT:
    call @binary_heap_swap(&heap, index, left)
    call @binary_heap_sift_down(&heap, left)
    !should_swap
    !right_bigger
    !right_value
    !right_ptr
    !right_off
    !has_right
    !right
    !left_value
    !left_ptr
    !left_off
    !parent_value
    !parent_ptr
    !parent_off
    !buf
    !len
    !left_base
    !left
    !index
    !heap
    return

L_SWAP_LEFT_ONLY:
    call @binary_heap_swap(&heap, index, left)
    call @binary_heap_sift_down(&heap, left)
    !should_swap
    !left_value
    !left_ptr
    !left_off
    !parent_value
    !parent_ptr
    !parent_off
    !buf
    !len
    !left_base
    !left
    !has_left
    !index
    !heap
    return

L_DONE_RIGHT_BRANCH:
    !should_swap
    !right_bigger
    !right_value
    !right_ptr
    !right_off
    !has_right
    !right
    !left_value
    !left_ptr
    !left_off
    !parent_value
    !parent_ptr
    !parent_off
    !buf
    !len
    !left_base
    !left
    !index
    !heap
    return

L_DONE_LEFT_ONLY:
    !should_swap
    !left_value
    !left_ptr
    !left_off
    !parent_value
    !parent_ptr
    !parent_off
    !buf
    !len
    !left_base
    !left
    !has_left
    !index
    !heap
    return

L_DONE_SHORT:
    !has_left
    !left_base
    !left
    !len
    !index
    !heap
    return

@binary_heap_grow(&heap: ptr) -> void:
L_ENTRY:
    old_buf = take heap+BinaryHeap_buf
    old_cap = load heap+BinaryHeap_cap as u64
    old_len = load heap+BinaryHeap_len as u64
    cap_is_zero = eq old_cap, 0
    br cap_is_zero -> L_GROW_INIT, L_GROW_DOUBLE

L_GROW_INIT:
    next_cap_raw = BinaryHeap_INITIAL_CAP
    next_cap = next_cap_raw
    next_cap_ok = add 0, 1
    jmp L_GROW_ALLOC

L_GROW_DOUBLE:
    EXPAND NUM_U64_CHECKED_ADD next_cap_ok, next_cap_raw, old_cap, old_cap
    br next_cap_ok -> L_GROW_DOUBLE_OK, L_GROW_CAP_OVERFLOW

L_GROW_CAP_OVERFLOW:
    panic(1803)

L_GROW_DOUBLE_OK:
    next_cap = next_cap_raw
    jmp L_GROW_ALLOC

L_GROW_ALLOC:
    EXPAND NUM_U64_CHECKED_MUL copy_bytes_ok, copy_bytes, old_len, BinaryHeap_SLOT_SIZE
    br copy_bytes_ok -> L_GROW_COPY_BYTES_OK, L_GROW_COPY_BYTES_OVERFLOW

L_GROW_COPY_BYTES_OVERFLOW:
    panic(1804)

L_GROW_COPY_BYTES_OK:
    EXPAND NUM_U64_CHECKED_MUL new_bytes_ok, new_bytes, next_cap, BinaryHeap_SLOT_SIZE
    br new_bytes_ok -> L_GROW_ALLOC_BYTES_OK, L_GROW_ALLOC_BYTES_OVERFLOW

L_GROW_ALLOC_BYTES_OVERFLOW:
    panic(1805)

L_GROW_ALLOC_BYTES_OK:
    new_buf = alloc new_bytes
    call @sa_mem_copy(&new_buf, &old_buf, copy_bytes)
    !new_bytes_ok
    !copy_bytes_ok
    !copy_bytes
    !new_bytes
    !old_len
    !old_cap
    !cap_is_zero
    !old_buf
    store heap+BinaryHeap_buf, new_buf as ptr
    store heap+BinaryHeap_cap, next_cap as u64
    ^new_buf
    !next_cap_ok
    !next_cap
    !heap
    return

@binary_heap_realloc(&heap: ptr, target_cap: u64) -> void:
L_ENTRY:
    old_buf = take heap+BinaryHeap_buf
    len = load heap+BinaryHeap_len as u64
    target_zero = eq target_cap, 0
    br target_zero -> L_REALLOC_EMPTY, L_REALLOC_ALLOC

L_REALLOC_ALLOC:
    EXPAND NUM_U64_CHECKED_MUL realloc_new_bytes_ok, new_bytes, target_cap, BinaryHeap_SLOT_SIZE
    br realloc_new_bytes_ok -> L_REALLOC_NEW_BYTES_OK, L_REALLOC_NEW_BYTES_OVERFLOW

L_REALLOC_NEW_BYTES_OVERFLOW:
    panic(1806)

L_REALLOC_NEW_BYTES_OK:
    EXPAND NUM_U64_CHECKED_MUL realloc_copy_bytes_ok, copy_bytes, len, BinaryHeap_SLOT_SIZE
    br realloc_copy_bytes_ok -> L_REALLOC_COPY_BYTES_OK, L_REALLOC_COPY_BYTES_OVERFLOW

L_REALLOC_COPY_BYTES_OVERFLOW:
    panic(1807)

L_REALLOC_COPY_BYTES_OK:
    new_buf = alloc new_bytes
    call @sa_mem_set(&new_buf, 0, new_bytes)
    call @sa_mem_copy(&new_buf, &old_buf, copy_bytes)
    !realloc_copy_bytes_ok
    !realloc_new_bytes_ok
    !copy_bytes
    !new_bytes
    !old_buf
    store heap+BinaryHeap_buf, new_buf as ptr
    store heap+BinaryHeap_cap, target_cap as u64
    ^new_buf
    !target_zero
    !len
    !target_cap
    !heap
    return

L_REALLOC_EMPTY:
    !old_buf
    store heap+BinaryHeap_buf, 0 as ptr
    store heap+BinaryHeap_cap, 0 as u64
    store heap+BinaryHeap_len, 0 as u64
    !target_zero
    !len
    !target_cap
    !heap
    return

@export sa_binary_heap_reserve(&heap: ptr, additional: u64) -> void:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    cap = load heap+BinaryHeap_cap as u64
    EXPAND NUM_U64_CHECKED_ADD reserve_needed_ok, needed, len, additional
    br reserve_needed_ok -> L_RESERVE_NEEDED_OK, L_RESERVE_OVERFLOW

L_RESERVE_OVERFLOW:
    panic(1810)

L_RESERVE_NEEDED_OK:
    has_room = uge cap, needed
    br has_room -> L_RESERVE_DONE, L_RESERVE_GROW

L_RESERVE_GROW:
    target_cap = call @binary_heap_next_capacity(needed)
    call @binary_heap_realloc(&heap, target_cap)
    !target_cap
    !has_room
    !needed
    !reserve_needed_ok
    !cap
    !len
    !additional
    !heap
    return

L_RESERVE_DONE:
    !has_room
    !needed
    !reserve_needed_ok
    !cap
    !len
    !additional
    !heap
    return

@export sa_binary_heap_reserve_exact(&heap: ptr, additional: u64) -> void:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    cap = load heap+BinaryHeap_cap as u64
    EXPAND NUM_U64_CHECKED_ADD reserve_exact_needed_ok, needed, len, additional
    br reserve_exact_needed_ok -> L_RESERVE_EXACT_NEEDED_OK, L_RESERVE_EXACT_OVERFLOW

L_RESERVE_EXACT_OVERFLOW:
    panic(1811)

L_RESERVE_EXACT_NEEDED_OK:
    has_room = uge cap, needed
    br has_room -> L_RESERVE_EXACT_DONE, L_RESERVE_EXACT_GROW

L_RESERVE_EXACT_GROW:
    call @binary_heap_realloc(&heap, needed)
    !has_room
    !needed
    !reserve_exact_needed_ok
    !cap
    !len
    !additional
    !heap
    return

L_RESERVE_EXACT_DONE:
    !has_room
    !needed
    !reserve_exact_needed_ok
    !cap
    !len
    !additional
    !heap
    return

@export sa_binary_heap_try_reserve(&heap: ptr, additional: u64) -> i32:
L_ENTRY:
    call @sa_binary_heap_reserve(&heap, additional)
    !additional
    !heap
    return 1

@export sa_binary_heap_try_reserve_exact(&heap: ptr, additional: u64) -> i32:
L_ENTRY:
    call @sa_binary_heap_reserve_exact(&heap, additional)
    !additional
    !heap
    return 1

@export sa_binary_heap_shrink_to(&heap: ptr, min_capacity: u64) -> void:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    cap = load heap+BinaryHeap_cap as u64
    keep_len = uge len, min_capacity
    br keep_len -> L_SHRINK_TO_LEN, L_SHRINK_TO_MIN

L_SHRINK_TO_LEN:
    target_cap = add len, 0
    jmp L_SHRINK_TO_CHECK

L_SHRINK_TO_MIN:
    target_cap = add min_capacity, 0

L_SHRINK_TO_CHECK:
    needs_shrink = ult target_cap, cap
    br needs_shrink -> L_SHRINK_TO_APPLY, L_SHRINK_TO_DONE

L_SHRINK_TO_APPLY:
    call @binary_heap_realloc(&heap, target_cap)
    !needs_shrink
    !target_cap
    !keep_len
    !cap
    !len
    !min_capacity
    !heap
    return

L_SHRINK_TO_DONE:
    !needs_shrink
    !target_cap
    !keep_len
    !cap
    !len
    !min_capacity
    !heap
    return

@export sa_binary_heap_shrink_to_fit(&heap: ptr) -> void:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    cap = load heap+BinaryHeap_cap as u64
    needs_shrink = ne cap, len
    br needs_shrink -> L_SHRINK, L_SHRINK_DONE

L_SHRINK:
    call @binary_heap_realloc(&heap, len)
    !needs_shrink
    !cap
    !len
    !heap
    return

L_SHRINK_DONE:
    !needs_shrink
    !cap
    !len
    !heap
    return

@export sa_binary_heap_as_slice(&heap: ptr, &out_slice: ptr) -> void:
L_ENTRY:
    buf = load heap+BinaryHeap_buf as ptr
    len = load heap+BinaryHeap_len as u64
    store out_slice+Slice_ptr, buf as ptr
    store out_slice+Slice_len, len as u64
    !len
    !buf
    !out_slice
    !heap
    return

@export sa_binary_heap_as_mut_slice(&heap: ptr, &out_slice: ptr) -> void:
L_ENTRY:
    call @sa_binary_heap_as_slice(&heap, &out_slice)
    !out_slice
    !heap
    return

@export sa_binary_heap_into_vec(^heap: ptr) -> ^ptr:
L_ENTRY:
    return heap

@export sa_binary_heap_into_sorted_vec(^heap: ptr) -> ^ptr:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    out_vec = alloc Vec_SIZE
    EXPAND NUM_U64_CHECKED_MUL sort_bytes_ok, bytes, len, BinaryHeap_SLOT_SIZE
    br sort_bytes_ok -> L_SORT_BYTES_OK, L_SORT_BYTES_OVERFLOW

L_SORT_BYTES_OVERFLOW:
    panic(1808)

L_SORT_BYTES_OK:
    has_bytes = ne bytes, 0
    br has_bytes -> L_SORT_ALLOC, L_SORT_EMPTY

L_SORT_ALLOC:
    out_buf = alloc bytes
    call @sa_mem_set(&out_buf, 0, bytes)
    store out_vec+Vec_ptr, out_buf as ptr
    ^out_buf
    jmp L_SORT_INIT

L_SORT_EMPTY:
    store out_vec+Vec_ptr, 0 as ptr
    jmp L_SORT_INIT

L_SORT_INIT:
    store out_vec+Vec_cap, len as u64
    store out_vec+Vec_len, len as u64
    idx_slot = stack_alloc 8
    value_slot = stack_alloc 8
    store idx_slot+0, len as u64
    jmp L_SORT_HEAD

L_SORT_HEAD:
    idx = load idx_slot+0 as u64
    done = eq idx, 0
    br done -> L_SORT_DONE, L_SORT_BODY

L_SORT_BODY:
    next_idx = sub idx, 1
    ok = call @sa_binary_heap_try_pop(&heap, &value_slot)
    value = load value_slot+0 as u64
    out_buf2 = load out_vec+Vec_ptr as ptr
    off = mul next_idx, BinaryHeap_SLOT_SIZE
    slot = ptr_add out_buf2, off
    store slot+0, value as u64
    store idx_slot+0, next_idx as u64
    !slot
    !off
    !out_buf2
    !value
    !ok
    !next_idx
    !done
    !idx
    jmp L_SORT_HEAD

L_SORT_DONE:
    call @sa_binary_heap_free(^heap)
    !done
    !idx
    !has_bytes
    !sort_bytes_ok
    !bytes
    !len
    return out_vec

@export sa_binary_heap_push(&heap: ptr, value: u64) -> void:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    cap = load heap+BinaryHeap_cap as u64
    room = ult len, cap
    br room -> L_INSERT_RELEASE, L_GROW

L_GROW:
    call @binary_heap_grow(&heap)
    !room
    !cap
    !len
    jmp L_INSERT_WRITE

L_INSERT_RELEASE:
    !room
    !cap
    !len
    jmp L_INSERT_WRITE

L_INSERT_WRITE:
    len2 = load heap+BinaryHeap_len as u64
    buf = take heap+BinaryHeap_buf
    slot_off = mul len2, BinaryHeap_SLOT_SIZE
    slot = ptr_add buf, slot_off
    store slot+0, value as u64
    next_len = add len2, 1
    store heap+BinaryHeap_len, next_len as u64
    call @binary_heap_sift_up(&heap, len2)
    !slot
    !slot_off
    !next_len
    !buf
    !len2
    !value
    !heap
    return

@export sa_binary_heap_try_pop(&heap: ptr, &out_value_slot: ptr) -> i32:
L_ENTRY:
    len = load heap+BinaryHeap_len as u64
    empty = eq len, 0
    br empty -> L_EMPTY, L_READY

L_READY:
    buf = take heap+BinaryHeap_buf
    root_ptr = take heap+BinaryHeap_buf
    value = load root_ptr+0 as u64
    last_index = sub len, 1
    last_off = mul last_index, BinaryHeap_SLOT_SIZE
    last_ptr = ptr_add buf, last_off
    last_value = load last_ptr+0 as u64
    next_len = sub len, 1
    store out_value_slot+0, value as u64
    store heap+BinaryHeap_len, next_len as u64
    store root_ptr+0, last_value as u64
    call @binary_heap_sift_down(&heap, 0)
    !last_value
    !last_ptr
    !last_off
    !last_index
    !value
    !root_ptr
    !next_len
    !buf
    !len
    !empty
    !out_value_slot
    !heap
    return 1

L_EMPTY:
    store out_value_slot+0, 0 as u64
    !empty
    !len
    !out_value_slot
    !heap
    return 0

@export sa_binary_heap_clear(&heap: ptr) -> void:
L_ENTRY:
    buf = take heap+BinaryHeap_buf
    cap = load heap+BinaryHeap_cap as u64
    EXPAND NUM_U64_CHECKED_MUL clear_bytes_ok, bytes, cap, BinaryHeap_SLOT_SIZE
    br clear_bytes_ok -> L_CLEAR_BYTES_OK, L_CLEAR_BYTES_OVERFLOW

L_CLEAR_BYTES_OVERFLOW:
    panic(1809)

L_CLEAR_BYTES_OK:
    has_buf = ne buf, 0
    br has_buf -> L_CLEAR_BUF, L_CLEAR_SKIP
L_CLEAR_BUF:
    call @sa_mem_set(&buf, 0, bytes)
    !bytes
    store heap+BinaryHeap_len, 0 as u64
    !has_buf
    !clear_bytes_ok
    !buf
    !cap
    !heap
    return
L_CLEAR_SKIP:
    !bytes
    store heap+BinaryHeap_len, 0 as u64
    !has_buf
    !clear_bytes_ok
    !buf
    !cap
    !heap
    return

@export sa_binary_heap_append(&heap: ptr, &other: ptr) -> void:
L_ENTRY:
    value_slot = stack_alloc 8
    jmp L_APPEND_LOOP

L_APPEND_LOOP:
    ok = call @sa_binary_heap_try_pop(&other, &value_slot)
    br ok -> L_APPEND_PUSH, L_APPEND_DONE

L_APPEND_PUSH:
    value = load value_slot+0 as u64
    call @sa_binary_heap_push(&heap, value)
    !value
    !ok
    jmp L_APPEND_LOOP

L_APPEND_DONE:
    !ok
    !other
    !heap
    return

[MACRO] BINARY_HEAP_NEW %out_heap
    %out_heap = call @sa_binary_heap_new()
[END_MACRO]

[MACRO] BINARY_HEAP_WITH_CAPACITY %out_heap, %cap
    %out_heap = call @sa_binary_heap_with_capacity(%cap)
[END_MACRO]

[MACRO] BINARY_HEAP_TRY_WITH_CAPACITY %out_ok, %out_heap, %cap
    __binary_heap_try_new_slot_%out_ok = stack_alloc 8
    %out_ok = call @sa_binary_heap_try_with_capacity(%cap, &__binary_heap_try_new_slot_%out_ok)
    %out_heap = load __binary_heap_try_new_slot_%out_ok+0 as ptr
[END_MACRO]

