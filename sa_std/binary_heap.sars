    store __binary_heap_retain_clear_slot_%out_len+0, __binary_heap_retain_next_clear_%out_len as u64
    !__binary_heap_retain_next_clear_%out_len
    !__binary_heap_retain_clear_ptr_%out_len
    !__binary_heap_retain_clear_off_%out_len
    !__binary_heap_retain_clear_done_%out_len
    !__binary_heap_retain_clear_idx_%out_len
    jmp L_BINARY_HEAP_RETAIN_CLEAR_LOOP_%out_len

L_BINARY_HEAP_RETAIN_HEAPIFY_INIT_%out_len:
    store %heap_reg+BinaryHeap_len, __binary_heap_retain_kept_len_%out_len as u64
    __binary_heap_retain_too_small_%out_len = ule __binary_heap_retain_kept_len_%out_len, 1
    br __binary_heap_retain_too_small_%out_len -> L_BINARY_HEAP_RETAIN_DONE_%out_len, L_BINARY_HEAP_RETAIN_HEAPIFY_START_%out_len

L_BINARY_HEAP_RETAIN_HEAPIFY_START_%out_len:
    __binary_heap_retain_last_%out_len = sub __binary_heap_retain_kept_len_%out_len, 2
    __binary_heap_retain_parent_%out_len = udiv __binary_heap_retain_last_%out_len, 2
    __binary_heap_retain_heapify_slot_%out_len = stack_alloc 8
    store __binary_heap_retain_heapify_slot_%out_len+0, __binary_heap_retain_parent_%out_len as u64
    jmp L_BINARY_HEAP_RETAIN_HEAPIFY_LOOP_%out_len

L_BINARY_HEAP_RETAIN_HEAPIFY_LOOP_%out_len:
    __binary_heap_retain_heapify_idx_%out_len = load __binary_heap_retain_heapify_slot_%out_len+0 as u64
    call @binary_heap_sift_down(&%heap_reg, __binary_heap_retain_heapify_idx_%out_len)
    __binary_heap_retain_heapify_zero_%out_len = eq __binary_heap_retain_heapify_idx_%out_len, 0
    br __binary_heap_retain_heapify_zero_%out_len -> L_BINARY_HEAP_RETAIN_DONE_FROM_HEAPIFY_%out_len, L_BINARY_HEAP_RETAIN_HEAPIFY_NEXT_%out_len

L_BINARY_HEAP_RETAIN_HEAPIFY_NEXT_%out_len:
    __binary_heap_retain_prev_heapify_%out_len = sub __binary_heap_retain_heapify_idx_%out_len, 1
    store __binary_heap_retain_heapify_slot_%out_len+0, __binary_heap_retain_prev_heapify_%out_len as u64
    !__binary_heap_retain_prev_heapify_%out_len
    !__binary_heap_retain_heapify_zero_%out_len
    !__binary_heap_retain_heapify_idx_%out_len
    jmp L_BINARY_HEAP_RETAIN_HEAPIFY_LOOP_%out_len

L_BINARY_HEAP_RETAIN_DONE_FROM_HEAPIFY_%out_len:
    !__binary_heap_retain_heapify_zero_%out_len
    !__binary_heap_retain_heapify_idx_%out_len
    !__binary_heap_retain_parent_%out_len
    !__binary_heap_retain_last_%out_len
    jmp L_BINARY_HEAP_RETAIN_DONE_%out_len

L_BINARY_HEAP_RETAIN_DONE_%out_len:
    %out_len = load %heap_reg+BinaryHeap_len as u64
    !__binary_heap_retain_too_small_%out_len
    !__binary_heap_retain_clear_done_%out_len
    !__binary_heap_retain_clear_idx_%out_len
    !__binary_heap_retain_kept_len_%out_len
    !__binary_heap_retain_done_%out_len
    !__binary_heap_retain_read_%out_len
    !__binary_heap_retain_len_%out_len
    !__binary_heap_retain_buf_%out_len
[END_MACRO]

// Rust method-name alias: BinaryHeap::retain over concrete u64 predicate helper.
[MACRO] BINARY_HEAP_RETAIN %out_len, %heap_reg, %pred_fn
    EXPAND BINARY_HEAP_RETAIN_U64 %out_len, %heap_reg, %pred_fn
[END_MACRO]

[MACRO] BINARY_HEAP_APPEND %heap_reg, %other_heap_reg
    call @sa_binary_heap_append(&%heap_reg, &%other_heap_reg)
[END_MACRO]

// Concrete u64-named and try/non-try value-form aliases over the existing
// BINARY_HEAP_PUSH / PEEK / TRY_POP / capacity+len primitives. These add no
// new syscall/FFI surface; they only expose Rust-style naming parity and a
// fallible value view (ok,value) for PEEK.

[MACRO] BINARY_HEAP_PUSH_U64 %heap_reg, %value
    EXPAND BINARY_HEAP_PUSH %heap_reg, %value
[END_MACRO]

[MACRO] BINARY_HEAP_PEEK_U64 %out_value, %heap_reg
    EXPAND BINARY_HEAP_PEEK %out_value, %heap_reg
[END_MACRO]

[MACRO] BINARY_HEAP_TRY_PEEK %out_ok, %out_value, %heap_reg
    __binary_heap_try_peek_empty_%out_ok = call @sa_binary_heap_is_empty(&%heap_reg)
    __binary_heap_try_peek_is_empty_%out_ok = eq __binary_heap_try_peek_empty_%out_ok, 1
    br __binary_heap_try_peek_is_empty_%out_ok -> L_BINARY_HEAP_TRY_PEEK_EMPTY_%out_ok, L_BINARY_HEAP_TRY_PEEK_NONEMPTY_%out_ok
L_BINARY_HEAP_TRY_PEEK_EMPTY_%out_ok:
    %out_ok = add 0, 0
    %out_value = add 0, 0
    !__binary_heap_try_peek_empty_%out_ok
    !__binary_heap_try_peek_is_empty_%out_ok
    jmp L_BINARY_HEAP_TRY_PEEK_END_%out_ok
L_BINARY_HEAP_TRY_PEEK_NONEMPTY_%out_ok:
    %out_value = call @sa_binary_heap_peek(&%heap_reg)
    %out_ok = add 0, 1
    !__binary_heap_try_peek_empty_%out_ok
    !__binary_heap_try_peek_is_empty_%out_ok
    jmp L_BINARY_HEAP_TRY_PEEK_END_%out_ok
L_BINARY_HEAP_TRY_PEEK_END_%out_ok:
[END_MACRO]

[MACRO] BINARY_HEAP_TRY_PEEK_U64 %out_ok, %out_value, %heap_reg
    EXPAND BINARY_HEAP_TRY_PEEK %out_ok, %out_value, %heap_reg
[END_MACRO]

[MACRO] BINARY_HEAP_POP %out_value, %heap_reg
    __binary_heap_pop_slot_%out_value = stack_alloc 8
    __binary_heap_pop_ok_%out_value = call @sa_binary_heap_try_pop(&%heap_reg, &__binary_heap_pop_slot_%out_value)
    %out_value = load __binary_heap_pop_slot_%out_value+0 as u64
    !__binary_heap_pop_ok_%out_value
[END_MACRO]

[MACRO] BINARY_HEAP_POP_U64 %out_value, %heap_reg
    EXPAND BINARY_HEAP_POP %out_value, %heap_reg
[END_MACRO]

[MACRO] BINARY_HEAP_EXTRA_CAPACITY %out_extra, %heap_reg
    __binary_heap_ec_cap_%out_extra = call @sa_binary_heap_capacity(&%heap_reg)
    __binary_heap_ec_len_%out_extra = call @sa_binary_heap_len(&%heap_reg)
    %out_extra = sub __binary_heap_ec_cap_%out_extra, __binary_heap_ec_len_%out_extra
    !__binary_heap_ec_len_%out_extra
    !__binary_heap_ec_cap_%out_extra
[END_MACRO]

// Fixed-arity / from-collection constructors over the concrete u64 max-heap.
// FROM_* helpers push each source element through the existing heapify path.

[MACRO] BINARY_HEAP_LIT1 %out_heap, %value1
    EXPAND BINARY_HEAP_NEW %out_heap
    EXPAND BINARY_HEAP_PUSH_U64 %out_heap, %value1
[END_MACRO]

[MACRO] BINARY_HEAP_LIT2 %out_heap, %value1, %value2
    EXPAND BINARY_HEAP_NEW %out_heap
    EXPAND BINARY_HEAP_PUSH_U64 %out_heap, %value1
    EXPAND BINARY_HEAP_PUSH_U64 %out_heap, %value2
[END_MACRO]

[MACRO] BINARY_HEAP_LIT3 %out_heap, %value1, %value2, %value3
    EXPAND BINARY_HEAP_NEW %out_heap
    EXPAND BINARY_HEAP_PUSH_U64 %out_heap, %value1
    EXPAND BINARY_HEAP_PUSH_U64 %out_heap, %value2
    EXPAND BINARY_HEAP_PUSH_U64 %out_heap, %value3
[END_MACRO]

[MACRO] BINARY_HEAP_EXTEND_FROM_SLICE_U64 %heap_reg, %slice_reg
    __bh_ext_len_%heap_reg = load %slice_reg+Slice_len as u64
    __bh_ext_idx_slot_%heap_reg = stack_alloc 8
    store __bh_ext_idx_slot_%heap_reg+0, 0 as u64
    jmp L_BINARY_HEAP_EXTEND_HEAD_%heap_reg
L_BINARY_HEAP_EXTEND_HEAD_%heap_reg:
    __bh_ext_idx_%heap_reg = load __bh_ext_idx_slot_%heap_reg+0 as u64
    __bh_ext_done_%heap_reg = eq __bh_ext_idx_%heap_reg, __bh_ext_len_%heap_reg
    br __bh_ext_done_%heap_reg -> L_BINARY_HEAP_EXTEND_DONE_%heap_reg, L_BINARY_HEAP_EXTEND_BODY_%heap_reg
L_BINARY_HEAP_EXTEND_BODY_%heap_reg:
    EXPAND SLICE_GET_U64 __bh_ext_val_%heap_reg, %slice_reg, __bh_ext_idx_%heap_reg
    EXPAND BINARY_HEAP_PUSH_U64 %heap_reg, __bh_ext_val_%heap_reg
    __bh_ext_next_%heap_reg = add __bh_ext_idx_%heap_reg, 1
    store __bh_ext_idx_slot_%heap_reg+0, __bh_ext_next_%heap_reg as u64
    !__bh_ext_next_%heap_reg
    !__bh_ext_val_%heap_reg
    !__bh_ext_done_%heap_reg
    !__bh_ext_idx_%heap_reg
    jmp L_BINARY_HEAP_EXTEND_HEAD_%heap_reg
L_BINARY_HEAP_EXTEND_DONE_%heap_reg:
    !__bh_ext_done_%heap_reg
    !__bh_ext_idx_%heap_reg
    !__bh_ext_len_%heap_reg
[END_MACRO]

// Rust method-name alias over BINARY_HEAP_EXTEND_FROM_SLICE_U64.
[MACRO] BINARY_HEAP_EXTEND_FROM_SLICE %heap_reg, %slice_reg
    EXPAND BINARY_HEAP_EXTEND_FROM_SLICE_U64 %heap_reg, %slice_reg
[END_MACRO]

[MACRO] BINARY_HEAP_FROM_SLICE_U64 %out_heap, %slice_reg
    EXPAND BINARY_HEAP_NEW %out_heap
    EXPAND BINARY_HEAP_EXTEND_FROM_SLICE_U64 %out_heap, %slice_reg
[END_MACRO]

// Rust method-name alias over BINARY_HEAP_FROM_SLICE_U64.
[MACRO] BINARY_HEAP_FROM_SLICE %out_heap, %slice_reg
    EXPAND BINARY_HEAP_FROM_SLICE_U64 %out_heap, %slice_reg
[END_MACRO]

[MACRO] BINARY_HEAP_FROM_VEC_U64 %out_heap, %vec_reg
    EXPAND VEC_AS_SLICE __bh_from_vec_slice_%out_heap, %vec_reg
    EXPAND BINARY_HEAP_FROM_SLICE_U64 %out_heap, __bh_from_vec_slice_%out_heap
    !__bh_from_vec_slice_%out_heap
[END_MACRO]

// Rust method-name alias over BINARY_HEAP_FROM_VEC_U64.
[MACRO] BINARY_HEAP_FROM_VEC %out_heap, %vec_reg
    EXPAND BINARY_HEAP_FROM_VEC_U64 %out_heap, %vec_reg
[END_MACRO]

[MACRO] BINARY_HEAP_EXTEND_FROM_VEC_U64 %heap_reg, %vec_reg
    EXPAND VEC_AS_SLICE __bh_ext_vec_slice_%heap_reg, %vec_reg
    EXPAND BINARY_HEAP_EXTEND_FROM_SLICE_U64 %heap_reg, __bh_ext_vec_slice_%heap_reg
    !__bh_ext_vec_slice_%heap_reg
[END_MACRO]

// Rust method-name alias over BINARY_HEAP_EXTEND_FROM_VEC_U64.
[MACRO] BINARY_HEAP_EXTEND_FROM_VEC %heap_reg, %vec_reg
    EXPAND BINARY_HEAP_EXTEND_FROM_VEC_U64 %heap_reg, %vec_reg
[END_MACRO]

// Linear membership query over the heap backing slice.
[MACRO] BINARY_HEAP_CONTAINS %out_bool, %heap_reg, %needle
    EXPAND BINARY_HEAP_AS_SLICE __bh_contains_slice_%out_bool, %heap_reg
    EXPAND SLICE_CONTAINS_U64 %out_bool, __bh_contains_slice_%out_bool, %needle
    !__bh_contains_slice_%out_bool
[END_MACRO]
// Rust Default-style empty BinaryHeap constructor alias.

[MACRO] BINARY_HEAP_DEFAULT %out_heap
    EXPAND BINARY_HEAP_NEW %out_heap
[END_MACRO]

// Eager extract_if: materialize matching values into Vec, rebuild heap with non-matching.

// Eager extract_if without consuming heap storage: snapshot via as_slice, then rebuild.
[MACRO] BINARY_HEAP_EXTRACT_IF %out_len, %out_vec, %heap_reg, %pred_fn
    EXPAND VEC_NEW %out_vec
    EXPAND BINARY_HEAP_AS_SLICE __bh_ei_slice_%out_len, %heap_reg
    EXPAND SLICE_GET_LEN __bh_ei_n_%out_len, __bh_ei_slice_%out_len
    EXPAND VEC_NEW __bh_ei_keep_%out_len
    __bh_ei_i_slot_%out_len = stack_alloc 8
    store __bh_ei_i_slot_%out_len+0, 0 as u64
    jmp L_BH_EI_HEAD_%out_len
L_BH_EI_HEAD_%out_len:
    __bh_ei_i_%out_len = load __bh_ei_i_slot_%out_len+0 as u64
    __bh_ei_done_%out_len = eq __bh_ei_i_%out_len, __bh_ei_n_%out_len
    br __bh_ei_done_%out_len -> L_BH_EI_REBUILD_%out_len, L_BH_EI_BODY_%out_len
L_BH_EI_BODY_%out_len:
    EXPAND SLICE_GET_U64 __bh_ei_val_%out_len, __bh_ei_slice_%out_len, __bh_ei_i_%out_len
    __bh_ei_pred_%out_len = call %pred_fn(__bh_ei_val_%out_len)
    __bh_ei_take_%out_len = ne __bh_ei_pred_%out_len, 0
    br __bh_ei_take_%out_len -> L_BH_EI_TAKE_%out_len, L_BH_EI_KEEP_%out_len
L_BH_EI_TAKE_%out_len:
    EXPAND VEC_PUSH_U64 %out_vec, __bh_ei_val_%out_len
    jmp L_BH_EI_NEXT_%out_len
L_BH_EI_KEEP_%out_len:
    EXPAND VEC_PUSH_U64 __bh_ei_keep_%out_len, __bh_ei_val_%out_len
    jmp L_BH_EI_NEXT_%out_len
L_BH_EI_NEXT_%out_len:
    __bh_ei_ni_%out_len = add __bh_ei_i_%out_len, 1
    store __bh_ei_i_slot_%out_len+0, __bh_ei_ni_%out_len as u64
    !__bh_ei_ni_%out_len
    !__bh_ei_take_%out_len
    !__bh_ei_pred_%out_len
    !__bh_ei_val_%out_len
    !__bh_ei_done_%out_len
    !__bh_ei_i_%out_len
    jmp L_BH_EI_HEAD_%out_len
L_BH_EI_REBUILD_%out_len:
    EXPAND BINARY_HEAP_CLEAR %heap_reg
    EXPAND VEC_LEN __bh_ei_kn_%out_len, __bh_ei_keep_%out_len
    store __bh_ei_i_slot_%out_len+0, 0 as u64
    jmp L_BH_EI_PUSH_HEAD_%out_len
L_BH_EI_PUSH_HEAD_%out_len:
    __bh_ei_pi_%out_len = load __bh_ei_i_slot_%out_len+0 as u64
    __bh_ei_pdone_%out_len = eq __bh_ei_pi_%out_len, __bh_ei_kn_%out_len
    br __bh_ei_pdone_%out_len -> L_BH_EI_DONE_%out_len, L_BH_EI_PUSH_BODY_%out_len
L_BH_EI_PUSH_BODY_%out_len:
    EXPAND VEC_GET_U64 __bh_ei_kv_%out_len, __bh_ei_keep_%out_len, __bh_ei_pi_%out_len
    EXPAND BINARY_HEAP_PUSH %heap_reg, __bh_ei_kv_%out_len
    __bh_ei_pni_%out_len = add __bh_ei_pi_%out_len, 1
    store __bh_ei_i_slot_%out_len+0, __bh_ei_pni_%out_len as u64
    !__bh_ei_pni_%out_len
    !__bh_ei_kv_%out_len
    !__bh_ei_pdone_%out_len
    !__bh_ei_pi_%out_len
    jmp L_BH_EI_PUSH_HEAD_%out_len
L_BH_EI_DONE_%out_len:
    EXPAND VEC_LEN %out_len, %out_vec
    EXPAND VEC_FREE __bh_ei_keep_%out_len
    !__bh_ei_pdone_%out_len
    !__bh_ei_pi_%out_len
    !__bh_ei_kn_%out_len
    !__bh_ei_done_%out_len
    !__bh_ei_i_%out_len
    !__bh_ei_n_%out_len
    !__bh_ei_slice_%out_len
[END_MACRO]
