    !__string_buf_spwc_repl_len_%out_ok
    !__string_buf_spwc_cap_%out_ok
    !__string_buf_spwc_old_len_%out_ok
    !__string_buf_spwc_view_%out_ok
    jmp L_STRING_BUF_SPWC_END_%out_ok

L_STRING_BUF_SPWC_MISS_BOUNDARY_%out_ok:
