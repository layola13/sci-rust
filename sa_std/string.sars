    EXPAND SLICE_NEW %out_right, __str_split_checked_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_split_checked_empty_ptr_%out_ok
    !__str_split_checked_left_ok_%out_ok

L_STR_SPLIT_CHECKED_DONE_%out_ok:
