[MACRO] STRING_BUF_TRY_INSERT_STR %out_ok, %string_reg, %index, %insert_slice
    __string_buf_insert_str_len_%out_ok = load %insert_slice+Slice_len as u64
    __string_buf_insert_str_view_%out_ok = & %string_reg
    __string_buf_insert_str_old_len_%out_ok = load __string_buf_insert_str_view_%out_ok+Vec_len as u64
