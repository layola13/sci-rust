[MACRO] STR_TRY_MATCHES_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %match_index
    %out_part = alloc Slice_SIZE
    __str_matches_needle_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_matches_needle_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_matches_needle_needle_ptr_%out_ok = load %needle_slice+Slice_ptr as ptr
    __str_matches_needle_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_matches_needle_scan_slot_%out_ok = stack_alloc 8
    __str_matches_needle_inner_slot_%out_ok = stack_alloc 8
    __str_matches_needle_current_slot_%out_ok = stack_alloc 8
    store __str_matches_needle_scan_slot_%out_ok+0, 0 as u64
    store __str_matches_needle_inner_slot_%out_ok+0, 0 as u64
    store __str_matches_needle_current_slot_%out_ok+0, 0 as u64
    __str_matches_needle_empty_%out_ok = eq __str_matches_needle_needle_len_%out_ok, 0
    br __str_matches_needle_empty_%out_ok -> L_STR_MATCHES_NEEDLE_EMPTY_%out_ok, L_STR_MATCHES_NEEDLE_HEAD_%out_ok

L_STR_MATCHES_NEEDLE_EMPTY_%out_ok:
    __str_matches_needle_empty_zero_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_matches_needle_empty_zero_%out_ok, 0
    %out_ok = add 0, 0
    jmp L_STR_MATCHES_NEEDLE_END_%out_ok

L_STR_MATCHES_NEEDLE_HEAD_%out_ok:
    __str_matches_needle_scan_%out_ok = load __str_matches_needle_scan_slot_%out_ok+0 as u64
    __str_matches_needle_done_%out_ok = eq __str_matches_needle_scan_%out_ok, __str_matches_needle_len_%out_ok
    br __str_matches_needle_done_%out_ok -> L_STR_MATCHES_NEEDLE_FINAL_%out_ok, L_STR_MATCHES_NEEDLE_RANGE_%out_ok

L_STR_MATCHES_NEEDLE_RANGE_%out_ok:
    __str_matches_needle_remaining_%out_ok = sub __str_matches_needle_len_%out_ok, __str_matches_needle_scan_%out_ok
    __str_matches_needle_can_match_%out_ok = uge __str_matches_needle_remaining_%out_ok, __str_matches_needle_needle_len_%out_ok
    br __str_matches_needle_can_match_%out_ok -> L_STR_MATCHES_NEEDLE_INNER_INIT_%out_ok, L_STR_MATCHES_NEEDLE_NEXT_%out_ok

L_STR_MATCHES_NEEDLE_INNER_INIT_%out_ok:
    store __str_matches_needle_inner_slot_%out_ok+0, 0 as u64
    jmp L_STR_MATCHES_NEEDLE_INNER_HEAD_%out_ok

L_STR_MATCHES_NEEDLE_INNER_HEAD_%out_ok:
    __str_matches_needle_inner_%out_ok = load __str_matches_needle_inner_slot_%out_ok+0 as u64
    __str_matches_needle_inner_done_%out_ok = eq __str_matches_needle_inner_%out_ok, __str_matches_needle_needle_len_%out_ok
    br __str_matches_needle_inner_done_%out_ok -> L_STR_MATCHES_NEEDLE_HIT_%out_ok, L_STR_MATCHES_NEEDLE_INNER_BODY_%out_ok

L_STR_MATCHES_NEEDLE_INNER_BODY_%out_ok:
    __str_matches_needle_hay_off_%out_ok = add __str_matches_needle_scan_%out_ok, __str_matches_needle_inner_%out_ok
    __str_matches_needle_hay_ip_%out_ok = ptr_add __str_matches_needle_ptr_%out_ok, __str_matches_needle_hay_off_%out_ok
    __str_matches_needle_needle_ip_%out_ok = ptr_add __str_matches_needle_needle_ptr_%out_ok, __str_matches_needle_inner_%out_ok
    __str_matches_needle_hay_byte_%out_ok = load __str_matches_needle_hay_ip_%out_ok+0 as u8
    __str_matches_needle_needle_byte_%out_ok = load __str_matches_needle_needle_ip_%out_ok+0 as u8
    __str_matches_needle_match_%out_ok = eq __str_matches_needle_hay_byte_%out_ok, __str_matches_needle_needle_byte_%out_ok
    br __str_matches_needle_match_%out_ok -> L_STR_MATCHES_NEEDLE_INNER_NEXT_%out_ok, L_STR_MATCHES_NEEDLE_KEEP_%out_ok

L_STR_MATCHES_NEEDLE_INNER_NEXT_%out_ok:
    __str_matches_needle_inner_next_%out_ok = add __str_matches_needle_inner_%out_ok, 1
    store __str_matches_needle_inner_slot_%out_ok+0, __str_matches_needle_inner_next_%out_ok as u64
    !__str_matches_needle_inner_next_%out_ok
    !__str_matches_needle_match_%out_ok
    !__str_matches_needle_needle_byte_%out_ok
    !__str_matches_needle_hay_byte_%out_ok
    !__str_matches_needle_needle_ip_%out_ok
    !__str_matches_needle_hay_ip_%out_ok
    !__str_matches_needle_hay_off_%out_ok
    !__str_matches_needle_inner_done_%out_ok
    !__str_matches_needle_inner_%out_ok
    jmp L_STR_MATCHES_NEEDLE_INNER_HEAD_%out_ok

L_STR_MATCHES_NEEDLE_HIT_%out_ok:
    __str_matches_needle_current_%out_ok = load __str_matches_needle_current_slot_%out_ok+0 as u64
    __str_matches_needle_target_%out_ok = eq __str_matches_needle_current_%out_ok, %match_index
    br __str_matches_needle_target_%out_ok -> L_STR_MATCHES_NEEDLE_HIT_MATCH_%out_ok, L_STR_MATCHES_NEEDLE_ADVANCE_%out_ok

L_STR_MATCHES_NEEDLE_HIT_MATCH_%out_ok:
    __str_matches_needle_match_ptr_%out_ok = ptr_add __str_matches_needle_ptr_%out_ok, __str_matches_needle_scan_%out_ok
    EXPAND SLICE_NEW %out_part, __str_matches_needle_match_ptr_%out_ok, __str_matches_needle_needle_len_%out_ok
    %out_ok = add 0, 1
    !__str_matches_needle_match_ptr_%out_ok
    !__str_matches_needle_target_%out_ok
    !__str_matches_needle_current_%out_ok
    !__str_matches_needle_inner_done_%out_ok
    !__str_matches_needle_inner_%out_ok
    !__str_matches_needle_can_match_%out_ok
    !__str_matches_needle_remaining_%out_ok
    !__str_matches_needle_done_%out_ok
    !__str_matches_needle_scan_%out_ok
    jmp L_STR_MATCHES_NEEDLE_END_%out_ok

L_STR_MATCHES_NEEDLE_ADVANCE_%out_ok:
    __str_matches_needle_next_current_%out_ok = add __str_matches_needle_current_%out_ok, 1
    __str_matches_needle_after_%out_ok = add __str_matches_needle_scan_%out_ok, __str_matches_needle_needle_len_%out_ok
    store __str_matches_needle_current_slot_%out_ok+0, __str_matches_needle_next_current_%out_ok as u64
    store __str_matches_needle_scan_slot_%out_ok+0, __str_matches_needle_after_%out_ok as u64
    !__str_matches_needle_after_%out_ok
    !__str_matches_needle_next_current_%out_ok
    !__str_matches_needle_target_%out_ok
    !__str_matches_needle_current_%out_ok
    !__str_matches_needle_inner_done_%out_ok
    !__str_matches_needle_inner_%out_ok
    !__str_matches_needle_can_match_%out_ok
    !__str_matches_needle_remaining_%out_ok
    !__str_matches_needle_done_%out_ok
    !__str_matches_needle_scan_%out_ok
    jmp L_STR_MATCHES_NEEDLE_HEAD_%out_ok

L_STR_MATCHES_NEEDLE_KEEP_%out_ok:
    !__str_matches_needle_match_%out_ok
    !__str_matches_needle_needle_byte_%out_ok
    !__str_matches_needle_hay_byte_%out_ok
    !__str_matches_needle_needle_ip_%out_ok
    !__str_matches_needle_hay_ip_%out_ok
    !__str_matches_needle_hay_off_%out_ok
    !__str_matches_needle_inner_done_%out_ok
    !__str_matches_needle_inner_%out_ok
    jmp L_STR_MATCHES_NEEDLE_NEXT_%out_ok

L_STR_MATCHES_NEEDLE_NEXT_%out_ok:
    __str_matches_needle_next_%out_ok = add __str_matches_needle_scan_%out_ok, 1
    store __str_matches_needle_scan_slot_%out_ok+0, __str_matches_needle_next_%out_ok as u64
    !__str_matches_needle_next_%out_ok
    !__str_matches_needle_can_match_%out_ok
    !__str_matches_needle_remaining_%out_ok
    !__str_matches_needle_done_%out_ok
    !__str_matches_needle_scan_%out_ok
    jmp L_STR_MATCHES_NEEDLE_HEAD_%out_ok

L_STR_MATCHES_NEEDLE_FINAL_%out_ok:
    __str_matches_needle_empty_final_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_matches_needle_empty_final_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_matches_needle_empty_final_ptr_%out_ok
    !__str_matches_needle_done_%out_ok
    !__str_matches_needle_scan_%out_ok

L_STR_MATCHES_NEEDLE_END_%out_ok:
    !__str_matches_needle_empty_%out_ok
    !__str_matches_needle_needle_len_%out_ok
    !__str_matches_needle_needle_ptr_%out_ok
    !__str_matches_needle_len_%out_ok
    !__str_matches_needle_ptr_%out_ok
[END_MACRO]

