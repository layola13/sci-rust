[MACRO] STR_SPLIT_N_NEEDLE_COUNT %out_count, %slice_reg, %needle_slice, %split_count
    __str_splitn_count_zero_%out_count = eq %split_count, 0
    br __str_splitn_count_zero_%out_count -> L_STR_SPLITN_COUNT_ZERO_%out_count, L_STR_SPLITN_COUNT_NONZERO_%out_count

L_STR_SPLITN_COUNT_ZERO_%out_count:
    %out_count = add 0, 0
    jmp L_STR_SPLITN_COUNT_END_%out_count

L_STR_SPLITN_COUNT_NONZERO_%out_count:
    __str_splitn_count_needle_len_%out_count = load %needle_slice+Slice_len as u64
    __str_splitn_count_empty_needle_%out_count = eq __str_splitn_count_needle_len_%out_count, 0
    br __str_splitn_count_empty_needle_%out_count -> L_STR_SPLITN_COUNT_EMPTY_NEEDLE_%out_count, L_STR_SPLITN_COUNT_BASE_%out_count

L_STR_SPLITN_COUNT_EMPTY_NEEDLE_%out_count:
    %out_count = add 0, 1
    !__str_splitn_count_empty_needle_%out_count
    !__str_splitn_count_needle_len_%out_count
    jmp L_STR_SPLITN_COUNT_END_%out_count

L_STR_SPLITN_COUNT_BASE_%out_count:
    EXPAND STR_SPLIT_NEEDLE_COUNT __str_splitn_count_base_%out_count, %slice_reg, %needle_slice
    __str_splitn_count_over_%out_count = ugt __str_splitn_count_base_%out_count, %split_count
    br __str_splitn_count_over_%out_count -> L_STR_SPLITN_COUNT_LIMIT_%out_count, L_STR_SPLITN_COUNT_USE_BASE_%out_count

L_STR_SPLITN_COUNT_LIMIT_%out_count:
    %out_count = add %split_count, 0
    !__str_splitn_count_over_%out_count
    !__str_splitn_count_base_%out_count
    !__str_splitn_count_empty_needle_%out_count
    !__str_splitn_count_needle_len_%out_count
    jmp L_STR_SPLITN_COUNT_END_%out_count

L_STR_SPLITN_COUNT_USE_BASE_%out_count:
    %out_count = add __str_splitn_count_base_%out_count, 0
    !__str_splitn_count_over_%out_count
    !__str_splitn_count_base_%out_count
    !__str_splitn_count_empty_needle_%out_count
    !__str_splitn_count_needle_len_%out_count

L_STR_SPLITN_COUNT_END_%out_count:
    !__str_splitn_count_zero_%out_count
[END_MACRO]

