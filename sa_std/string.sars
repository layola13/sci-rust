    EXPAND STRING_BUF_PUSH_STR %string_reg, __string_buf_str_iter_item_%string_reg
    __string_buf_str_iter_next_%string_reg = add __string_buf_str_iter_idx_%string_reg, 1
    store __string_buf_str_iter_idx_slot_%string_reg+0, __string_buf_str_iter_next_%string_reg as u64
    !__string_buf_str_iter_next_%string_reg
    !__string_buf_str_iter_elem_len_%string_reg
    !__string_buf_str_iter_elem_ptr_%string_reg
    !__string_buf_str_iter_elem_%string_reg
    !__string_buf_str_iter_off_%string_reg
    !__string_buf_str_iter_done_%string_reg
