[MACRO] STR_EMPTY %out_slice
    __str_empty_ptr_%out_slice = 0 as ptr
    EXPAND STR_FROM_PARTS %out_slice, __str_empty_ptr_%out_slice, 0
    !__str_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STR_SLICE %out_slice, %src_slice, %start, %length
    __str_src_ptr_%out_slice = load %src_slice+Slice_ptr as ptr
    __str_start_ptr_%out_slice = ptr_add __str_src_ptr_%out_slice, %start
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_start_ptr_%out_slice, %length
    !__str_src_ptr_%out_slice
    !__str_start_ptr_%out_slice
[END_MACRO]

[MACRO] STR_EQ %out_bool, %left_slice, %right_slice
    left_ptr_%out_bool = load %left_slice+Slice_ptr as ptr
    right_ptr_%out_bool = load %right_slice+Slice_ptr as ptr
    left_len_%out_bool = load %left_slice+Slice_len as u64
    right_len_%out_bool = load %right_slice+Slice_len as u64
    same_len_%out_bool = eq left_len_%out_bool, right_len_%out_bool
    idx_slot_%out_bool = stack_alloc 8
    store idx_slot_%out_bool+0, 0 as u64
    br same_len_%out_bool -> L_STR_EQ_HEAD_%out_bool, L_STR_EQ_NE_%out_bool
L_STR_EQ_LOOP_%out_bool:
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_HEAD_%out_bool:
    idx_%out_bool = load idx_slot_%out_bool+0 as u64
    done_%out_bool = eq idx_%out_bool, left_len_%out_bool
    br done_%out_bool -> L_STR_EQ_TRUE_%out_bool, L_STR_EQ_BODY_%out_bool
L_STR_EQ_BODY_%out_bool:
    left_ip_%out_bool = ptr_add left_ptr_%out_bool, idx_%out_bool
    right_ip_%out_bool = ptr_add right_ptr_%out_bool, idx_%out_bool
    left_byte_%out_bool = load left_ip_%out_bool+0 as u8
    right_byte_%out_bool = load right_ip_%out_bool+0 as u8
    bytes_eq_%out_bool = eq left_byte_%out_bool, right_byte_%out_bool
    !left_byte_%out_bool
    !right_byte_%out_bool
    !left_ip_%out_bool
    !right_ip_%out_bool
    br bytes_eq_%out_bool -> L_STR_EQ_NEXT_%out_bool, L_STR_EQ_FALSE_%out_bool
L_STR_EQ_NEXT_%out_bool:
    next_idx_%out_bool = add idx_%out_bool, 1
    store idx_slot_%out_bool+0, next_idx_%out_bool as u64
    !idx_%out_bool
    !done_%out_bool
    !bytes_eq_%out_bool
    !next_idx_%out_bool
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_TRUE_%out_bool:
    %out_bool = add 0, 1
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_FALSE_%out_bool:
    %out_bool = add 0, 0
    !bytes_eq_%out_bool
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_NE_%out_bool:
    %out_bool = add 0, 0
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
L_STR_EQ_END_%out_bool:
[END_MACRO]

[MACRO] STR_CMP %out_ordering, %left_slice, %right_slice
    __str_cmp_left_ptr_%out_ordering = load %left_slice+Slice_ptr as ptr
    __str_cmp_right_ptr_%out_ordering = load %right_slice+Slice_ptr as ptr
    __str_cmp_left_len_%out_ordering = load %left_slice+Slice_len as u64
    __str_cmp_right_len_%out_ordering = load %right_slice+Slice_len as u64
    __str_cmp_idx_slot_%out_ordering = stack_alloc 8
    store __str_cmp_idx_slot_%out_ordering+0, 0 as u64
    jmp L_STR_CMP_HEAD_%out_ordering

L_STR_CMP_HEAD_%out_ordering:
    __str_cmp_idx_%out_ordering = load __str_cmp_idx_slot_%out_ordering+0 as u64
    __str_cmp_left_done_%out_ordering = eq __str_cmp_idx_%out_ordering, __str_cmp_left_len_%out_ordering
    __str_cmp_right_done_%out_ordering = eq __str_cmp_idx_%out_ordering, __str_cmp_right_len_%out_ordering
    br __str_cmp_left_done_%out_ordering -> L_STR_CMP_LEFT_DONE_%out_ordering, L_STR_CMP_LEFT_SOME_%out_ordering

L_STR_CMP_LEFT_SOME_%out_ordering:
    br __str_cmp_right_done_%out_ordering -> L_STR_CMP_GREATER_%out_ordering, L_STR_CMP_BODY_%out_ordering

L_STR_CMP_BODY_%out_ordering:
    __str_cmp_left_item_%out_ordering = ptr_add __str_cmp_left_ptr_%out_ordering, __str_cmp_idx_%out_ordering
    __str_cmp_right_item_%out_ordering = ptr_add __str_cmp_right_ptr_%out_ordering, __str_cmp_idx_%out_ordering
    __str_cmp_left_byte_%out_ordering = load __str_cmp_left_item_%out_ordering+0 as u8
    __str_cmp_right_byte_%out_ordering = load __str_cmp_right_item_%out_ordering+0 as u8
    __str_cmp_less_%out_ordering = ult __str_cmp_left_byte_%out_ordering, __str_cmp_right_byte_%out_ordering
    br __str_cmp_less_%out_ordering -> L_STR_CMP_LESS_LOOP_%out_ordering, L_STR_CMP_CHECK_GREATER_%out_ordering

L_STR_CMP_CHECK_GREATER_%out_ordering:
    __str_cmp_greater_%out_ordering = ugt __str_cmp_left_byte_%out_ordering, __str_cmp_right_byte_%out_ordering
    br __str_cmp_greater_%out_ordering -> L_STR_CMP_GREATER_LOOP_%out_ordering, L_STR_CMP_NEXT_%out_ordering

L_STR_CMP_NEXT_%out_ordering:
    __str_cmp_next_%out_ordering = add __str_cmp_idx_%out_ordering, 1
    store __str_cmp_idx_slot_%out_ordering+0, __str_cmp_next_%out_ordering as u64
    !__str_cmp_next_%out_ordering
    !__str_cmp_greater_%out_ordering
    !__str_cmp_less_%out_ordering
    !__str_cmp_right_byte_%out_ordering
    !__str_cmp_left_byte_%out_ordering
    !__str_cmp_right_item_%out_ordering
    !__str_cmp_left_item_%out_ordering
    !__str_cmp_right_done_%out_ordering
    !__str_cmp_left_done_%out_ordering
    !__str_cmp_idx_%out_ordering
    jmp L_STR_CMP_HEAD_%out_ordering

L_STR_CMP_LEFT_DONE_%out_ordering:
    br __str_cmp_right_done_%out_ordering -> L_STR_CMP_EQUAL_%out_ordering, L_STR_CMP_LESS_%out_ordering

L_STR_CMP_LESS_LOOP_%out_ordering:
    %out_ordering = sub 0, 1
    !__str_cmp_less_%out_ordering
    !__str_cmp_right_byte_%out_ordering
    !__str_cmp_left_byte_%out_ordering
    !__str_cmp_right_item_%out_ordering
    !__str_cmp_left_item_%out_ordering
    !__str_cmp_right_done_%out_ordering
    !__str_cmp_left_done_%out_ordering
    !__str_cmp_idx_%out_ordering
    !__str_cmp_right_len_%out_ordering
    !__str_cmp_left_len_%out_ordering
    !__str_cmp_right_ptr_%out_ordering
    !__str_cmp_left_ptr_%out_ordering
    jmp L_STR_CMP_END_%out_ordering

L_STR_CMP_GREATER_LOOP_%out_ordering:
    %out_ordering = add 0, 1
    !__str_cmp_greater_%out_ordering
    !__str_cmp_less_%out_ordering
    !__str_cmp_right_byte_%out_ordering
    !__str_cmp_left_byte_%out_ordering
    !__str_cmp_right_item_%out_ordering
    !__str_cmp_left_item_%out_ordering
    !__str_cmp_right_done_%out_ordering
    !__str_cmp_left_done_%out_ordering
    !__str_cmp_idx_%out_ordering
    !__str_cmp_right_len_%out_ordering
    !__str_cmp_left_len_%out_ordering
    !__str_cmp_right_ptr_%out_ordering
    !__str_cmp_left_ptr_%out_ordering
    jmp L_STR_CMP_END_%out_ordering

L_STR_CMP_LESS_%out_ordering:
    %out_ordering = sub 0, 1
    !__str_cmp_right_done_%out_ordering
    !__str_cmp_left_done_%out_ordering
    !__str_cmp_idx_%out_ordering
    !__str_cmp_right_len_%out_ordering
    !__str_cmp_left_len_%out_ordering
    !__str_cmp_right_ptr_%out_ordering
    !__str_cmp_left_ptr_%out_ordering
    jmp L_STR_CMP_END_%out_ordering

L_STR_CMP_GREATER_%out_ordering:
    %out_ordering = add 0, 1
    !__str_cmp_right_done_%out_ordering
    !__str_cmp_left_done_%out_ordering
    !__str_cmp_idx_%out_ordering
    !__str_cmp_right_len_%out_ordering
    !__str_cmp_left_len_%out_ordering
    !__str_cmp_right_ptr_%out_ordering
    !__str_cmp_left_ptr_%out_ordering
    jmp L_STR_CMP_END_%out_ordering

L_STR_CMP_EQUAL_%out_ordering:
    %out_ordering = add 0, 0
    !__str_cmp_right_done_%out_ordering
    !__str_cmp_left_done_%out_ordering
    !__str_cmp_idx_%out_ordering
    !__str_cmp_right_len_%out_ordering
    !__str_cmp_left_len_%out_ordering
    !__str_cmp_right_ptr_%out_ordering
    !__str_cmp_left_ptr_%out_ordering

L_STR_CMP_END_%out_ordering:
[END_MACRO]

[MACRO] STR_LT %out_bool, %left_slice, %right_slice
    EXPAND STR_CMP __str_lt_order_%out_bool, %left_slice, %right_slice
    %out_bool = slt __str_lt_order_%out_bool, 0
