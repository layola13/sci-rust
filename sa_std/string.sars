    %out_left = alloc Slice_SIZE
    %out_right = alloc Slice_SIZE
    EXPAND STR_TRY_FIND __str_split_found_%out_ok, __str_split_idx_%out_ok, %slice_reg, %needle_slice
    br __str_split_found_%out_ok -> L_STR_SPLIT_ONCE_HIT_%out_ok, L_STR_SPLIT_ONCE_MISS_%out_ok

L_STR_SPLIT_ONCE_HIT_%out_ok:
    __str_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_right_start_%out_ok = add __str_split_idx_%out_ok, __str_needle_len_%out_ok
    __str_right_len_%out_ok = sub __str_len_%out_ok, __str_right_start_%out_ok
    __str_right_ptr_%out_ok = ptr_add __str_src_ptr_%out_ok, __str_right_start_%out_ok
    EXPAND SLICE_NEW %out_left, __str_src_ptr_%out_ok, __str_split_idx_%out_ok
    EXPAND SLICE_NEW %out_right, __str_right_ptr_%out_ok, __str_right_len_%out_ok
    %out_ok = add 0, 1
    !__str_right_ptr_%out_ok
    !__str_right_len_%out_ok
    !__str_right_start_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_src_ptr_%out_ok
    !__str_split_idx_%out_ok
    !__str_split_found_%out_ok
    jmp L_STR_SPLIT_ONCE_END_%out_ok

L_STR_SPLIT_ONCE_MISS_%out_ok:
    __str_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_left, __str_empty_ptr_%out_ok, 0
    EXPAND SLICE_NEW %out_right, __str_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_empty_ptr_%out_ok
    !__str_split_idx_%out_ok
    !__str_split_found_%out_ok

L_STR_SPLIT_ONCE_END_%out_ok:
[END_MACRO]

