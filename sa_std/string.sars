    __str_line_at_prev_ip_%out_ok = ptr_add __str_line_at_ptr_%out_ok, __str_line_at_prev_%out_ok
    __str_line_at_prev_byte_%out_ok = load __str_line_at_prev_ip_%out_ok+0 as u8
    __str_line_at_is_cr_%out_ok = eq __str_line_at_prev_byte_%out_ok, 13
