[MACRO] STR_TRY_RSPLIT_N_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %split_count, %part_index
    __str_rsplitn_zero_%out_ok = eq %split_count, 0
    br __str_rsplitn_zero_%out_ok -> L_STR_RSPLITN_ZERO_%out_ok, L_STR_RSPLITN_NEEDLE_CHECK_%out_ok

L_STR_RSPLITN_ZERO_%out_ok:
    %out_part = alloc Slice_SIZE
