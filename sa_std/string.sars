[END_MACRO]

[MACRO] STR_FIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
    EXPAND STR_TRY_FIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
[END_MACRO]

[MACRO] STRING_FIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
    EXPAND STR_FIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
[END_MACRO]

[MACRO] STR_TRY_RFIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
    __str_rfind_byte_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_rfind_byte_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_rfind_byte_empty_%out_ok = eq __str_rfind_byte_len_%out_ok, 0
    br __str_rfind_byte_empty_%out_ok -> L_STR_RFIND_BYTE_MISS_EMPTY_%out_ok, L_STR_RFIND_BYTE_INIT_%out_ok

L_STR_RFIND_BYTE_INIT_%out_ok:
    __str_rfind_byte_idx_slot_%out_ok = stack_alloc 8
    __str_rfind_byte_last_%out_ok = sub __str_rfind_byte_len_%out_ok, 1
    store __str_rfind_byte_idx_slot_%out_ok+0, __str_rfind_byte_last_%out_ok as u64
    !__str_rfind_byte_last_%out_ok
    jmp L_STR_RFIND_BYTE_HEAD_%out_ok

L_STR_RFIND_BYTE_HEAD_%out_ok:
    __str_rfind_byte_idx_%out_ok = load __str_rfind_byte_idx_slot_%out_ok+0 as u64
    __str_rfind_byte_ip_%out_ok = ptr_add __str_rfind_byte_ptr_%out_ok, __str_rfind_byte_idx_%out_ok
    __str_rfind_byte_value_%out_ok = load __str_rfind_byte_ip_%out_ok+0 as u8
    __str_rfind_byte_match_%out_ok = eq __str_rfind_byte_value_%out_ok, %byte_value
    br __str_rfind_byte_match_%out_ok -> L_STR_RFIND_BYTE_HIT_%out_ok, L_STR_RFIND_BYTE_NEXT_%out_ok

L_STR_RFIND_BYTE_NEXT_%out_ok:
    __str_rfind_byte_is_zero_%out_ok = eq __str_rfind_byte_idx_%out_ok, 0
    br __str_rfind_byte_is_zero_%out_ok -> L_STR_RFIND_BYTE_MISS_%out_ok, L_STR_RFIND_BYTE_DEC_%out_ok

L_STR_RFIND_BYTE_DEC_%out_ok:
    __str_rfind_byte_prev_%out_ok = sub __str_rfind_byte_idx_%out_ok, 1
    store __str_rfind_byte_idx_slot_%out_ok+0, __str_rfind_byte_prev_%out_ok as u64
    !__str_rfind_byte_prev_%out_ok
    !__str_rfind_byte_is_zero_%out_ok
    !__str_rfind_byte_match_%out_ok
    !__str_rfind_byte_value_%out_ok
    !__str_rfind_byte_ip_%out_ok
    !__str_rfind_byte_idx_%out_ok
    jmp L_STR_RFIND_BYTE_HEAD_%out_ok

L_STR_RFIND_BYTE_HIT_%out_ok:
    %out_ok = add 0, 1
    %out_index = add __str_rfind_byte_idx_%out_ok, 0
    !__str_rfind_byte_match_%out_ok
    !__str_rfind_byte_value_%out_ok
    !__str_rfind_byte_ip_%out_ok
    !__str_rfind_byte_idx_%out_ok
    !__str_rfind_byte_empty_%out_ok
    !__str_rfind_byte_len_%out_ok
    !__str_rfind_byte_ptr_%out_ok
    jmp L_STR_RFIND_BYTE_END_%out_ok

L_STR_RFIND_BYTE_MISS_%out_ok:
    %out_ok = add 0, 0
    %out_index = add 0, 0
    !__str_rfind_byte_is_zero_%out_ok
    !__str_rfind_byte_match_%out_ok
    !__str_rfind_byte_value_%out_ok
    !__str_rfind_byte_ip_%out_ok
    !__str_rfind_byte_idx_%out_ok
    !__str_rfind_byte_empty_%out_ok
    !__str_rfind_byte_len_%out_ok
    !__str_rfind_byte_ptr_%out_ok
    jmp L_STR_RFIND_BYTE_END_%out_ok

L_STR_RFIND_BYTE_MISS_EMPTY_%out_ok:
    %out_ok = add 0, 0
    %out_index = add 0, 0
    !__str_rfind_byte_empty_%out_ok
    !__str_rfind_byte_len_%out_ok
    !__str_rfind_byte_ptr_%out_ok

L_STR_RFIND_BYTE_END_%out_ok:
[END_MACRO]

[MACRO] STRING_TRY_RFIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
    EXPAND STR_TRY_RFIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
[END_MACRO]

[MACRO] STR_RFIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
    EXPAND STR_TRY_RFIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
[END_MACRO]

[MACRO] STRING_RFIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
    EXPAND STR_RFIND_BYTE %out_ok, %out_index, %slice_reg, %byte_value
[END_MACRO]

[MACRO] STR_COUNT_BYTE %out_count, %slice_reg, %byte_value
    __str_count_byte_ptr_%out_count = load %slice_reg+Slice_ptr as ptr
    __str_count_byte_len_%out_count = load %slice_reg+Slice_len as u64
    __str_count_byte_idx_slot_%out_count = stack_alloc 8
    store __str_count_byte_idx_slot_%out_count+0, 0 as u64
    %out_count = add 0, 0
    jmp L_STR_COUNT_BYTE_HEAD_%out_count

L_STR_COUNT_BYTE_HEAD_%out_count:
    __str_count_byte_idx_%out_count = load __str_count_byte_idx_slot_%out_count+0 as u64
    __str_count_byte_done_%out_count = eq __str_count_byte_idx_%out_count, __str_count_byte_len_%out_count
    br __str_count_byte_done_%out_count -> L_STR_COUNT_BYTE_DONE_%out_count, L_STR_COUNT_BYTE_BODY_%out_count

L_STR_COUNT_BYTE_BODY_%out_count:
    __str_count_byte_ip_%out_count = ptr_add __str_count_byte_ptr_%out_count, __str_count_byte_idx_%out_count
    __str_count_byte_value_%out_count = load __str_count_byte_ip_%out_count+0 as u8
    __str_count_byte_match_%out_count = eq __str_count_byte_value_%out_count, %byte_value
    br __str_count_byte_match_%out_count -> L_STR_COUNT_BYTE_INC_%out_count, L_STR_COUNT_BYTE_NEXT_%out_count

L_STR_COUNT_BYTE_INC_%out_count:
    %out_count = add %out_count, 1
    jmp L_STR_COUNT_BYTE_NEXT_%out_count

L_STR_COUNT_BYTE_NEXT_%out_count:
    __str_count_byte_next_%out_count = add __str_count_byte_idx_%out_count, 1
    store __str_count_byte_idx_slot_%out_count+0, __str_count_byte_next_%out_count as u64
    !__str_count_byte_next_%out_count
    !__str_count_byte_match_%out_count
    !__str_count_byte_value_%out_count
    !__str_count_byte_ip_%out_count
    !__str_count_byte_done_%out_count
    !__str_count_byte_idx_%out_count
    jmp L_STR_COUNT_BYTE_HEAD_%out_count

L_STR_COUNT_BYTE_DONE_%out_count:
    !__str_count_byte_done_%out_count
    !__str_count_byte_idx_%out_count
    !__str_count_byte_len_%out_count
    !__str_count_byte_ptr_%out_count
[END_MACRO]

[MACRO] STRING_COUNT_BYTE %out_count, %slice_reg, %byte_value
    EXPAND STR_COUNT_BYTE %out_count, %slice_reg, %byte_value
[END_MACRO]

[MACRO] STR_COUNT %out_count, %slice_reg, %needle_slice
    __str_count_ptr_%out_count = load %slice_reg+Slice_ptr as ptr
    __str_count_len_%out_count = load %slice_reg+Slice_len as u64
    __str_count_needle_ptr_%out_count = load %needle_slice+Slice_ptr as ptr
    __str_count_needle_len_%out_count = load %needle_slice+Slice_len as u64
    __str_count_idx_slot_%out_count = stack_alloc 8
    __str_count_inner_slot_%out_count = stack_alloc 8
    store __str_count_idx_slot_%out_count+0, 0 as u64
    store __str_count_inner_slot_%out_count+0, 0 as u64
    %out_count = add 0, 0
    __str_count_empty_%out_count = eq __str_count_needle_len_%out_count, 0
    br __str_count_empty_%out_count -> L_STR_COUNT_EMPTY_%out_count, L_STR_COUNT_HEAD_%out_count
L_STR_COUNT_EMPTY_%out_count:
    %out_count = add 0, 0
    jmp L_STR_COUNT_END_%out_count
L_STR_COUNT_HEAD_%out_count:
    __str_count_idx_%out_count = load __str_count_idx_slot_%out_count+0 as u64
    __str_count_done_%out_count = eq __str_count_idx_%out_count, __str_count_len_%out_count
    br __str_count_done_%out_count -> L_STR_COUNT_DONE_%out_count, L_STR_COUNT_RANGE_%out_count
L_STR_COUNT_RANGE_%out_count:
    __str_count_remaining_%out_count = sub __str_count_len_%out_count, __str_count_idx_%out_count
    __str_count_can_match_%out_count = uge __str_count_remaining_%out_count, __str_count_needle_len_%out_count
    br __str_count_can_match_%out_count -> L_STR_COUNT_INNER_INIT_%out_count, L_STR_COUNT_NEXT_%out_count
L_STR_COUNT_INNER_INIT_%out_count:
    store __str_count_inner_slot_%out_count+0, 0 as u64
    jmp L_STR_COUNT_INNER_HEAD_%out_count
L_STR_COUNT_INNER_HEAD_%out_count:
    __str_count_inner_%out_count = load __str_count_inner_slot_%out_count+0 as u64
    __str_count_inner_done_%out_count = eq __str_count_inner_%out_count, __str_count_needle_len_%out_count
    br __str_count_inner_done_%out_count -> L_STR_COUNT_HIT_%out_count, L_STR_COUNT_INNER_BODY_%out_count
L_STR_COUNT_INNER_BODY_%out_count:
    __str_count_hay_off_%out_count = add __str_count_idx_%out_count, __str_count_inner_%out_count
    __str_count_hay_ip_%out_count = ptr_add __str_count_ptr_%out_count, __str_count_hay_off_%out_count
    __str_count_needle_ip_%out_count = ptr_add __str_count_needle_ptr_%out_count, __str_count_inner_%out_count
    __str_count_hay_byte_%out_count = load __str_count_hay_ip_%out_count+0 as u8
    __str_count_needle_byte_%out_count = load __str_count_needle_ip_%out_count+0 as u8
    __str_count_match_%out_count = eq __str_count_hay_byte_%out_count, __str_count_needle_byte_%out_count
    br __str_count_match_%out_count -> L_STR_COUNT_INNER_NEXT_%out_count, L_STR_COUNT_KEEP_%out_count
L_STR_COUNT_INNER_NEXT_%out_count:
    __str_count_inner_next_%out_count = add __str_count_inner_%out_count, 1
    store __str_count_inner_slot_%out_count+0, __str_count_inner_next_%out_count as u64
    !__str_count_inner_next_%out_count
    !__str_count_match_%out_count
    !__str_count_needle_byte_%out_count
    !__str_count_hay_byte_%out_count
    !__str_count_needle_ip_%out_count
    !__str_count_hay_ip_%out_count
    !__str_count_hay_off_%out_count
    !__str_count_inner_done_%out_count
    !__str_count_inner_%out_count
    jmp L_STR_COUNT_INNER_HEAD_%out_count
L_STR_COUNT_HIT_%out_count:
    %out_count = add %out_count, 1
    __str_count_next_idx_%out_count = add __str_count_idx_%out_count, __str_count_needle_len_%out_count
    store __str_count_idx_slot_%out_count+0, __str_count_next_idx_%out_count as u64
    !__str_count_next_idx_%out_count
    !__str_count_inner_done_%out_count
    !__str_count_inner_%out_count
    !__str_count_can_match_%out_count
    !__str_count_remaining_%out_count
    !__str_count_done_%out_count
    !__str_count_idx_%out_count
    jmp L_STR_COUNT_HEAD_%out_count
L_STR_COUNT_KEEP_%out_count:
    !__str_count_match_%out_count
    !__str_count_needle_byte_%out_count
    !__str_count_hay_byte_%out_count
    !__str_count_needle_ip_%out_count
    !__str_count_hay_ip_%out_count
    !__str_count_hay_off_%out_count
    !__str_count_inner_done_%out_count
    !__str_count_inner_%out_count
    jmp L_STR_COUNT_NEXT_%out_count
L_STR_COUNT_NEXT_%out_count:
    __str_count_next_%out_count = add __str_count_idx_%out_count, 1
    store __str_count_idx_slot_%out_count+0, __str_count_next_%out_count as u64
    !__str_count_next_%out_count
    !__str_count_can_match_%out_count
    !__str_count_remaining_%out_count
    !__str_count_done_%out_count
    !__str_count_idx_%out_count
    jmp L_STR_COUNT_HEAD_%out_count
L_STR_COUNT_DONE_%out_count:
    !__str_count_done_%out_count
    !__str_count_idx_%out_count
    !__str_count_empty_%out_count
    !__str_count_needle_len_%out_count
    !__str_count_needle_ptr_%out_count
    !__str_count_len_%out_count
    !__str_count_ptr_%out_count
L_STR_COUNT_END_%out_count:
[END_MACRO]

[MACRO] STRING_COUNT %out_count, %slice_reg, %needle_slice
    EXPAND STR_COUNT %out_count, %slice_reg, %needle_slice
[END_MACRO]

