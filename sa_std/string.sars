L_STR_RSPLITN_NEEDLE_CHECK_%out_ok:
    __str_rsplitn_top_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_rsplitn_top_empty_needle_%out_ok = eq __str_rsplitn_top_needle_len_%out_ok, 0
    br __str_rsplitn_top_empty_needle_%out_ok -> L_STR_RSPLITN_EMPTY_NEEDLE_%out_ok, L_STR_RSPLITN_NONEMPTY_NEEDLE_%out_ok

L_STR_RSPLITN_EMPTY_NEEDLE_%out_ok:
    __str_rsplitn_empty_target0_%out_ok = eq %part_index, 0
    br __str_rsplitn_empty_target0_%out_ok -> L_STR_RSPLITN_EMPTY_HIT_%out_ok, L_STR_RSPLITN_EMPTY_MISS_%out_ok

L_STR_RSPLITN_EMPTY_HIT_%out_ok:
