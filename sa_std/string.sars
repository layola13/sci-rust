L_STRING_BUF_SPWC_DRAIN_%out_ok:
    EXPAND STR_TRY_GET_RANGE __string_buf_spwc_range_ok_%out_ok, __string_buf_spwc_range_%out_ok, __string_buf_spwc_bview_%out_ok, %start, %length
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, %length
    EXPAND STRING_BUF_PUSH_STR %out_string, __string_buf_spwc_range_%out_ok
    !__string_buf_spwc_range_%out_ok
    !__string_buf_spwc_range_ok_%out_ok
    !__string_buf_spwc_bview_%out_ok
    !__string_buf_spwc_room_ok_%out_ok
    !__string_buf_spwc_new_len_%out_ok
    !__string_buf_spwc_after_%out_ok
    !__string_buf_spwc_bend_%out_ok
    !__string_buf_spwc_end_%out_ok
    !__string_buf_spwc_bstart_%out_ok
    !__string_buf_spwc_len_ok_%out_ok
    !__string_buf_spwc_tail_%out_ok
    !__string_buf_spwc_start_ok_%out_ok
    !__string_buf_spwc_repl_len_%out_ok
    !__string_buf_spwc_cap_%out_ok
    !__string_buf_spwc_old_len_%out_ok
    !__string_buf_spwc_view_%out_ok
    EXPAND STRING_BUF_TRY_REPLACE_RANGE_WITHIN_CAPACITY %out_ok, %string_reg, %start, %length, %replace_slice
    jmp L_STRING_BUF_SPWC_END_%out_ok

L_STRING_BUF_SPWC_NO_ROOM_%out_ok:
