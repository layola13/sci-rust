[MACRO] STRING_BUF_PUSH_STR %string_reg, %suffix_slice
    __string_buf_suffix_len_%string_reg = load %suffix_slice+Slice_len as u64
    EXPAND STRING_BUF_RESERVE %string_reg, __string_buf_suffix_len_%string_reg
    __string_buf_push_str_view_%string_reg = & %string_reg
    __string_buf_dst_buf_%string_reg = load __string_buf_push_str_view_%string_reg+Vec_ptr as ptr
    __string_buf_dst_len_%string_reg = load __string_buf_push_str_view_%string_reg+Vec_len as u64
    __string_buf_dst_ptr_%string_reg = ptr_add __string_buf_dst_buf_%string_reg, __string_buf_dst_len_%string_reg
    __string_buf_src_ptr_%string_reg = load %suffix_slice+Slice_ptr as ptr
    call @sa_mem_copy(&__string_buf_dst_ptr_%string_reg, &__string_buf_src_ptr_%string_reg, __string_buf_suffix_len_%string_reg)
    __string_buf_next_len_%string_reg = add __string_buf_dst_len_%string_reg, __string_buf_suffix_len_%string_reg
    store __string_buf_push_str_view_%string_reg+Vec_len, __string_buf_next_len_%string_reg as u64
    !__string_buf_next_len_%string_reg
    !__string_buf_src_ptr_%string_reg
    !__string_buf_dst_ptr_%string_reg
    !__string_buf_dst_len_%string_reg
    !__string_buf_dst_buf_%string_reg
    !__string_buf_push_str_view_%string_reg
    !__string_buf_suffix_len_%string_reg
[END_MACRO]

[MACRO] STRING_BUF_TRY_PUSH_STR_WITHIN_CAPACITY %out_ok, %string_reg, %suffix_slice
    __string_buf_pwc_suffix_len_%out_ok = load %suffix_slice+Slice_len as u64
    EXPAND STRING_BUF_CAPACITY_REMAINING __string_buf_pwc_remaining_%out_ok, %string_reg
    __string_buf_pwc_has_room_%out_ok = uge __string_buf_pwc_remaining_%out_ok, __string_buf_pwc_suffix_len_%out_ok
    br __string_buf_pwc_has_room_%out_ok -> L_STRING_BUF_PWC_HIT_%out_ok, L_STRING_BUF_PWC_MISS_%out_ok

L_STRING_BUF_PWC_HIT_%out_ok:
    __string_buf_pwc_view_%out_ok = & %string_reg
    __string_buf_pwc_dst_buf_%out_ok = load __string_buf_pwc_view_%out_ok+Vec_ptr as ptr
    __string_buf_pwc_dst_len_%out_ok = load __string_buf_pwc_view_%out_ok+Vec_len as u64
    __string_buf_pwc_dst_ptr_%out_ok = ptr_add __string_buf_pwc_dst_buf_%out_ok, __string_buf_pwc_dst_len_%out_ok
    __string_buf_pwc_src_ptr_%out_ok = load %suffix_slice+Slice_ptr as ptr
    call @sa_mem_copy(&__string_buf_pwc_dst_ptr_%out_ok, &__string_buf_pwc_src_ptr_%out_ok, __string_buf_pwc_suffix_len_%out_ok)
    __string_buf_pwc_next_len_%out_ok = add __string_buf_pwc_dst_len_%out_ok, __string_buf_pwc_suffix_len_%out_ok
    store __string_buf_pwc_view_%out_ok+Vec_len, __string_buf_pwc_next_len_%out_ok as u64
    %out_ok = add 0, 1
    !__string_buf_pwc_next_len_%out_ok
    !__string_buf_pwc_src_ptr_%out_ok
    !__string_buf_pwc_dst_ptr_%out_ok
    !__string_buf_pwc_dst_len_%out_ok
    !__string_buf_pwc_dst_buf_%out_ok
    !__string_buf_pwc_view_%out_ok
    !__string_buf_pwc_has_room_%out_ok
    !__string_buf_pwc_remaining_%out_ok
    !__string_buf_pwc_suffix_len_%out_ok
    jmp L_STRING_BUF_PWC_DONE_%out_ok

L_STRING_BUF_PWC_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_pwc_has_room_%out_ok
    !__string_buf_pwc_remaining_%out_ok
    !__string_buf_pwc_suffix_len_%out_ok

L_STRING_BUF_PWC_DONE_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_PUSH_STR_WITHIN_CAPACITY %out_ok, %string_reg, %suffix_slice
    EXPAND STRING_BUF_TRY_PUSH_STR_WITHIN_CAPACITY %out_ok, %string_reg, %suffix_slice
[END_MACRO]

[MACRO] STRING_BUF_TRY_PUSH_STR_N_WITHIN_CAPACITY %out_ok, %string_reg, %suffix_slice, %count
    __string_buf_psnwc_suffix_len_%out_ok = load %suffix_slice+Slice_len as u64
    __string_buf_psnwc_total_%out_ok = mul __string_buf_psnwc_suffix_len_%out_ok, %count
