[MACRO] STRING_BUF_TRY_SPLICE_WITHIN_CAPACITY %out_ok, %out_string, %string_reg, %start, %length, %replace_slice
    __string_buf_spwc_view_%out_ok = & %string_reg
    __string_buf_spwc_old_len_%out_ok = load __string_buf_spwc_view_%out_ok+Vec_len as u64
    __string_buf_spwc_cap_%out_ok = load __string_buf_spwc_view_%out_ok+Vec_cap as u64
    __string_buf_spwc_repl_len_%out_ok = load %replace_slice+Slice_len as u64
    __string_buf_spwc_start_ok_%out_ok = ule %start, __string_buf_spwc_old_len_%out_ok
    br __string_buf_spwc_start_ok_%out_ok -> L_STRING_BUF_SPWC_LEN_CHECK_%out_ok, L_STRING_BUF_SPWC_MISS_START_%out_ok

L_STRING_BUF_SPWC_LEN_CHECK_%out_ok:
    __string_buf_spwc_tail_%out_ok = sub __string_buf_spwc_old_len_%out_ok, %start
    __string_buf_spwc_len_ok_%out_ok = ule %length, __string_buf_spwc_tail_%out_ok
    br __string_buf_spwc_len_ok_%out_ok -> L_STRING_BUF_SPWC_BOUNDARY_%out_ok, L_STRING_BUF_SPWC_MISS_LEN_%out_ok

L_STRING_BUF_SPWC_BOUNDARY_%out_ok:
    EXPAND STRING_BUF_AS_STR __string_buf_spwc_bview_%out_ok, %string_reg
    EXPAND STR_IS_CHAR_BOUNDARY __string_buf_spwc_bstart_%out_ok, __string_buf_spwc_bview_%out_ok, %start
    br __string_buf_spwc_bstart_%out_ok -> L_STRING_BUF_SPWC_BOUNDARY_END_%out_ok, L_STRING_BUF_SPWC_MISS_BOUNDARY_%out_ok

L_STRING_BUF_SPWC_BOUNDARY_END_%out_ok:
    __string_buf_spwc_end_%out_ok = add %start, %length
    EXPAND STR_IS_CHAR_BOUNDARY __string_buf_spwc_bend_%out_ok, __string_buf_spwc_bview_%out_ok, __string_buf_spwc_end_%out_ok
    br __string_buf_spwc_bend_%out_ok -> L_STRING_BUF_SPWC_ROOM_%out_ok, L_STRING_BUF_SPWC_MISS_BOUNDARY_END_%out_ok

L_STRING_BUF_SPWC_ROOM_%out_ok:
    __string_buf_spwc_after_%out_ok = sub __string_buf_spwc_old_len_%out_ok, %length
    __string_buf_spwc_new_len_%out_ok = add __string_buf_spwc_after_%out_ok, __string_buf_spwc_repl_len_%out_ok
    __string_buf_spwc_room_ok_%out_ok = ule __string_buf_spwc_new_len_%out_ok, __string_buf_spwc_cap_%out_ok
