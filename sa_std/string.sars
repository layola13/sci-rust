    br __string_buf_icwc_enc_ok_%out_ok -> L_STRING_BUF_ICWC_HIT_%out_ok, L_STRING_BUF_ICWC_MISS_%out_ok

L_STRING_BUF_ICWC_HIT_%out_ok:
