    EXPAND STRING_BUF_FROM_STR %out_string, __bool_to_string_slice_%out_string
    EXPAND STRFMT_FREE __bool_to_string_free_ok_%out_string, __bool_to_string_fmt_%out_string
    !__bool_to_string_free_ok_%out_string
    !__bool_to_string_slice_%out_string
