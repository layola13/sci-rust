[MACRO] STR_TRY_SPLIT_N_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %split_count, %part_index
    __str_splitn_zero_%out_ok = eq %split_count, 0
    br __str_splitn_zero_%out_ok -> L_STR_SPLITN_ZERO_%out_ok, L_STR_SPLITN_NEEDLE_CHECK_%out_ok

L_STR_SPLITN_ZERO_%out_ok:
    %out_part = alloc Slice_SIZE
    __str_splitn_zero_empty_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_splitn_zero_empty_%out_ok, 0
    %out_ok = add 0, 0
    !__str_splitn_zero_empty_%out_ok
    jmp L_STR_SPLITN_TOP_END_%out_ok

L_STR_SPLITN_NEEDLE_CHECK_%out_ok:
    __str_splitn_top_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_splitn_top_empty_needle_%out_ok = eq __str_splitn_top_needle_len_%out_ok, 0
    br __str_splitn_top_empty_needle_%out_ok -> L_STR_SPLITN_EMPTY_NEEDLE_%out_ok, L_STR_SPLITN_NONEMPTY_NEEDLE_%out_ok

L_STR_SPLITN_EMPTY_NEEDLE_%out_ok:
    __str_splitn_empty_target0_%out_ok = eq %part_index, 0
    br __str_splitn_empty_target0_%out_ok -> L_STR_SPLITN_EMPTY_HIT_%out_ok, L_STR_SPLITN_EMPTY_MISS_%out_ok

L_STR_SPLITN_EMPTY_HIT_%out_ok:
    %out_part = alloc Slice_SIZE
    __str_splitn_empty_hay_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_splitn_empty_hay_len_%out_ok = load %slice_reg+Slice_len as u64
    EXPAND SLICE_NEW %out_part, __str_splitn_empty_hay_ptr_%out_ok, __str_splitn_empty_hay_len_%out_ok
    %out_ok = add 0, 1
    !__str_splitn_empty_hay_len_%out_ok
    !__str_splitn_empty_hay_ptr_%out_ok
    !__str_splitn_empty_target0_%out_ok
    !__str_splitn_top_empty_needle_%out_ok
    !__str_splitn_top_needle_len_%out_ok
    jmp L_STR_SPLITN_TOP_END_%out_ok

L_STR_SPLITN_EMPTY_MISS_%out_ok:
    %out_part = alloc Slice_SIZE
    __str_splitn_empty_miss_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_splitn_empty_miss_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_splitn_empty_miss_ptr_%out_ok
    !__str_splitn_empty_target0_%out_ok
    !__str_splitn_top_empty_needle_%out_ok
    !__str_splitn_top_needle_len_%out_ok
    jmp L_STR_SPLITN_TOP_END_%out_ok

L_STR_SPLITN_NONEMPTY_NEEDLE_%out_ok:
    !__str_splitn_top_empty_needle_%out_ok
    !__str_splitn_top_needle_len_%out_ok
    __str_splitn_limit_%out_ok = sub %split_count, 1
    __str_splitn_target_%out_ok = ult %part_index, __str_splitn_limit_%out_ok
    br __str_splitn_target_%out_ok -> L_STR_SPLITN_MATCH_%out_ok, L_STR_SPLITN_FINAL_%out_ok

L_STR_SPLITN_MATCH_%out_ok:
    EXPAND STR_TRY_SPLIT_NEEDLE_AT __str_splitn_found_%out_ok, %out_part, %slice_reg, %needle_slice, %part_index
    %out_ok = add __str_splitn_found_%out_ok, 0
    !__str_splitn_found_%out_ok
    jmp L_STR_SPLITN_END_%out_ok

L_STR_SPLITN_FINAL_%out_ok:
    __str_splitn_last_index_%out_ok = sub %split_count, 1
    __str_splitn_is_final_%out_ok = eq %part_index, __str_splitn_last_index_%out_ok
    br __str_splitn_is_final_%out_ok -> L_STR_SPLITN_FINAL_HIT_%out_ok, L_STR_SPLITN_FINAL_MISS_%out_ok

L_STR_SPLITN_FINAL_HIT_%out_ok:
    __str_splitn_needle_ptr_%out_ok = load %needle_slice+Slice_ptr as ptr
    __str_splitn_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_splitn_hay_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_splitn_hay_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_splitn_empty_needle_%out_ok = eq __str_splitn_needle_len_%out_ok, 0
    __str_splitn_no_split_%out_ok = eq __str_splitn_limit_%out_ok, 0
    __str_splitn_whole_%out_ok = or __str_splitn_empty_needle_%out_ok, __str_splitn_no_split_%out_ok
    br __str_splitn_whole_%out_ok -> L_STR_SPLITN_FINAL_WHOLE_%out_ok, L_STR_SPLITN_FINAL_SCAN_HEAD_%out_ok

L_STR_SPLITN_FINAL_WHOLE_%out_ok:
    %out_part = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_part, __str_splitn_hay_ptr_%out_ok, __str_splitn_hay_len_%out_ok
    %out_ok = add 0, 1
    !__str_splitn_whole_%out_ok
    !__str_splitn_no_split_%out_ok
    !__str_splitn_empty_needle_%out_ok
    !__str_splitn_needle_len_%out_ok
    !__str_splitn_needle_ptr_%out_ok
    !__str_splitn_hay_len_%out_ok
    !__str_splitn_hay_ptr_%out_ok
    jmp L_STR_SPLITN_FINAL_DONE_%out_ok

L_STR_SPLITN_FINAL_SCAN_HEAD_%out_ok:
    __str_splitn_scan_slot_%out_ok = stack_alloc 8
    __str_splitn_match_slot_%out_ok = stack_alloc 8
    __str_splitn_tail_slot_%out_ok = stack_alloc 8
    store __str_splitn_scan_slot_%out_ok+0, 0 as u64
    store __str_splitn_match_slot_%out_ok+0, 0 as u64
    store __str_splitn_tail_slot_%out_ok+0, __str_splitn_hay_len_%out_ok as u64
    jmp L_STR_SPLITN_FINAL_SCAN_LOOP_%out_ok

L_STR_SPLITN_FINAL_SCAN_LOOP_%out_ok:
    __str_splitn_scan_%out_ok = load __str_splitn_scan_slot_%out_ok+0 as u64
    __str_splitn_done_%out_ok = uge __str_splitn_scan_%out_ok, __str_splitn_hay_len_%out_ok
    br __str_splitn_done_%out_ok -> L_STR_SPLITN_FINAL_SCAN_END_%out_ok, L_STR_SPLITN_FINAL_SCAN_BODY_%out_ok

L_STR_SPLITN_FINAL_SCAN_BODY_%out_ok:
    __str_splitn_remaining_%out_ok = sub __str_splitn_hay_len_%out_ok, __str_splitn_scan_%out_ok
    __str_splitn_can_match_%out_ok = uge __str_splitn_remaining_%out_ok, __str_splitn_needle_len_%out_ok
    br __str_splitn_can_match_%out_ok -> L_STR_SPLITN_FINAL_SCAN_MATCH_INIT_%out_ok, L_STR_SPLITN_FINAL_SCAN_NEXT_POS_%out_ok

L_STR_SPLITN_FINAL_SCAN_MATCH_INIT_%out_ok:
    __str_splitn_inner_slot_%out_ok = stack_alloc 8
    store __str_splitn_inner_slot_%out_ok+0, 0 as u64
    jmp L_STR_SPLITN_FINAL_SCAN_MATCH_HEAD_%out_ok

L_STR_SPLITN_FINAL_SCAN_MATCH_HEAD_%out_ok:
    __str_splitn_inner_%out_ok = load __str_splitn_inner_slot_%out_ok+0 as u64
    __str_splitn_inner_done_%out_ok = eq __str_splitn_inner_%out_ok, __str_splitn_needle_len_%out_ok
    br __str_splitn_inner_done_%out_ok -> L_STR_SPLITN_FINAL_SCAN_ON_MATCH_%out_ok, L_STR_SPLITN_FINAL_SCAN_MATCH_BODY_%out_ok

L_STR_SPLITN_FINAL_SCAN_MATCH_BODY_%out_ok:
    __str_splitn_hay_off_%out_ok = add __str_splitn_scan_%out_ok, __str_splitn_inner_%out_ok
    __str_splitn_hay_ip_%out_ok = ptr_add __str_splitn_hay_ptr_%out_ok, __str_splitn_hay_off_%out_ok
    __str_splitn_needle_ip_%out_ok = ptr_add __str_splitn_needle_ptr_%out_ok, __str_splitn_inner_%out_ok
    __str_splitn_hay_byte_%out_ok = load __str_splitn_hay_ip_%out_ok+0 as u8
    __str_splitn_needle_byte_%out_ok = load __str_splitn_needle_ip_%out_ok+0 as u8
    __str_splitn_byte_eq_%out_ok = eq __str_splitn_hay_byte_%out_ok, __str_splitn_needle_byte_%out_ok
    br __str_splitn_byte_eq_%out_ok -> L_STR_SPLITN_FINAL_SCAN_MATCH_NEXT_%out_ok, L_STR_SPLITN_FINAL_SCAN_NEXT_POS_%out_ok

L_STR_SPLITN_FINAL_SCAN_MATCH_NEXT_%out_ok:
    __str_splitn_inner_next_%out_ok = add __str_splitn_inner_%out_ok, 1
    store __str_splitn_inner_slot_%out_ok+0, __str_splitn_inner_next_%out_ok as u64
    !__str_splitn_hay_byte_%out_ok
    !__str_splitn_needle_byte_%out_ok
    !__str_splitn_hay_ip_%out_ok
    !__str_splitn_needle_ip_%out_ok
    !__str_splitn_hay_off_%out_ok
    !__str_splitn_byte_eq_%out_ok
    !__str_splitn_inner_done_%out_ok
    !__str_splitn_inner_%out_ok
    !__str_splitn_inner_next_%out_ok
    jmp L_STR_SPLITN_FINAL_SCAN_MATCH_HEAD_%out_ok

L_STR_SPLITN_FINAL_SCAN_ON_MATCH_%out_ok:
    !__str_splitn_can_match_%out_ok
    !__str_splitn_remaining_%out_ok
    __str_splitn_match_count_%out_ok = load __str_splitn_match_slot_%out_ok+0 as u64
    __str_splitn_target_step_%out_ok = add __str_splitn_match_count_%out_ok, 1
    __str_splitn_target_match_%out_ok = eq __str_splitn_target_step_%out_ok, __str_splitn_limit_%out_ok
    br __str_splitn_target_match_%out_ok -> L_STR_SPLITN_FINAL_SCAN_TAIL_%out_ok, L_STR_SPLITN_FINAL_SCAN_BUMP_MATCH_%out_ok

L_STR_SPLITN_FINAL_SCAN_TAIL_%out_ok:
    __str_splitn_tail_off_%out_ok = add __str_splitn_scan_%out_ok, __str_splitn_needle_len_%out_ok
    store __str_splitn_tail_slot_%out_ok+0, __str_splitn_tail_off_%out_ok as u64
    !__str_splitn_inner_done_%out_ok
    !__str_splitn_inner_%out_ok
    !__str_splitn_match_count_%out_ok
    !__str_splitn_target_step_%out_ok
    !__str_splitn_target_match_%out_ok
    !__str_splitn_tail_off_%out_ok
    jmp L_STR_SPLITN_FINAL_SCAN_END_%out_ok

L_STR_SPLITN_FINAL_SCAN_BUMP_MATCH_%out_ok:
    __str_splitn_match_next_%out_ok = add __str_splitn_match_count_%out_ok, 1
    store __str_splitn_match_slot_%out_ok+0, __str_splitn_match_next_%out_ok as u64
    __str_splitn_after_match_%out_ok = add __str_splitn_scan_%out_ok, __str_splitn_needle_len_%out_ok
    store __str_splitn_scan_slot_%out_ok+0, __str_splitn_after_match_%out_ok as u64
    !__str_splitn_inner_done_%out_ok
    !__str_splitn_inner_%out_ok
    !__str_splitn_done_%out_ok
    !__str_splitn_scan_%out_ok
    !__str_splitn_match_next_%out_ok
    !__str_splitn_after_match_%out_ok
    !__str_splitn_match_count_%out_ok
    !__str_splitn_target_step_%out_ok
    !__str_splitn_target_match_%out_ok
    jmp L_STR_SPLITN_FINAL_SCAN_LOOP_%out_ok

L_STR_SPLITN_FINAL_SCAN_NEXT_POS_%out_ok:
    !__str_splitn_can_match_%out_ok
    !__str_splitn_remaining_%out_ok
    __str_splitn_next_pos_%out_ok = add __str_splitn_scan_%out_ok, 1
    store __str_splitn_scan_slot_%out_ok+0, __str_splitn_next_pos_%out_ok as u64
    !__str_splitn_done_%out_ok
    !__str_splitn_scan_%out_ok
    !__str_splitn_next_pos_%out_ok
    jmp L_STR_SPLITN_FINAL_SCAN_LOOP_%out_ok

L_STR_SPLITN_FINAL_SCAN_END_%out_ok:
    __str_splitn_tail_off_final_%out_ok = load __str_splitn_tail_slot_%out_ok+0 as u64
    EXPAND STR_TRY_GET_SUFFIX __str_splitn_found_final_%out_ok, %out_part, %slice_reg, __str_splitn_tail_off_final_%out_ok
    %out_ok = add __str_splitn_found_final_%out_ok, 0
    !__str_splitn_found_final_%out_ok
    !__str_splitn_tail_off_final_%out_ok
    !__str_splitn_whole_%out_ok
    !__str_splitn_no_split_%out_ok
    !__str_splitn_empty_needle_%out_ok
    !__str_splitn_needle_len_%out_ok
    !__str_splitn_needle_ptr_%out_ok
    !__str_splitn_hay_len_%out_ok
    !__str_splitn_hay_ptr_%out_ok
    jmp L_STR_SPLITN_FINAL_DONE_%out_ok

L_STR_SPLITN_FINAL_DONE_%out_ok:
    !__str_splitn_is_final_%out_ok
    !__str_splitn_last_index_%out_ok
    jmp L_STR_SPLITN_END_%out_ok

L_STR_SPLITN_FINAL_MISS_%out_ok:
    %out_part = alloc Slice_SIZE
    __str_splitn_empty_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_splitn_empty_%out_ok, 0
    %out_ok = add 0, 0
    !__str_splitn_empty_%out_ok
    !__str_splitn_is_final_%out_ok
    !__str_splitn_last_index_%out_ok

L_STR_SPLITN_END_%out_ok:
    !__str_splitn_target_%out_ok
    !__str_splitn_limit_%out_ok
    jmp L_STR_SPLITN_TOP_END_%out_ok

