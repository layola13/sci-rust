[MACRO] STR_ENCODE_CHAR_SLICE %out_slice, %out_valid, %code
    EXPAND CHAR_IS_VALID_SCALAR %out_valid, %code
    __str_char_enc_buf_%out_slice = stack_alloc 4
    store __str_char_enc_buf_%out_slice+0, 0 as u8
    store __str_char_enc_buf_%out_slice+1, 0 as u8
    store __str_char_enc_buf_%out_slice+2, 0 as u8
    store __str_char_enc_buf_%out_slice+3, 0 as u8
    __str_char_enc_cap_%out_slice = add 0, 4
    __str_char_enc_len_slot_%out_slice = stack_alloc 8
    store __str_char_enc_len_slot_%out_slice+0, 0 as u64
    br %out_valid -> L_STR_CHAR_ENC_RUN_%out_slice, L_STR_CHAR_ENC_FAIL_%out_slice
L_STR_CHAR_ENC_RUN_%out_slice:
    __str_char_enc_len_%out_slice = load __str_char_enc_len_slot_%out_slice+0 as u64
    EXPAND CHAR_TRY_ENCODE_UTF8 __str_char_enc_ok_%out_slice, __str_char_enc_len_%out_slice, __str_char_enc_buf_%out_slice, __str_char_enc_cap_%out_slice, %code
    store __str_char_enc_len_slot_%out_slice+0, __str_char_enc_len_%out_slice as u64
    EXPAND STR_FROM_PARTS %out_slice, __str_char_enc_buf_%out_slice, __str_char_enc_len_%out_slice
    !__str_char_enc_ok_%out_slice
    !__str_char_enc_len_%out_slice
    !__str_char_enc_cap_%out_slice
    jmp L_STR_CHAR_ENC_END_%out_slice
L_STR_CHAR_ENC_FAIL_%out_slice:
    EXPAND STR_EMPTY %out_slice
    !__str_char_enc_cap_%out_slice
L_STR_CHAR_ENC_END_%out_slice:
[END_MACRO]

