[MACRO] STRING_BUF_RSPLIT_NEEDLE_COUNT %out_count, %string_reg, %needle_slice
    EXPAND STR_RSPLIT_NEEDLE_COUNT %out_count, %string_reg, %needle_slice
[END_MACRO]

[MACRO] STR_SPLIT_INCLUSIVE_NEEDLE_COUNT %out_count, %slice_reg, %needle_slice
    __str_split_incl_ptr_%out_count = load %slice_reg+Slice_ptr as ptr
    __str_split_incl_len_%out_count = load %slice_reg+Slice_len as u64
    __str_split_incl_needle_len_%out_count = load %needle_slice+Slice_len as u64
    __str_split_incl_empty_needle_%out_count = eq __str_split_incl_needle_len_%out_count, 0
    br __str_split_incl_empty_needle_%out_count -> L_STR_SPLIT_INCL_ZERO_%out_count, L_STR_SPLIT_INCL_CHECK_HAY_%out_count

L_STR_SPLIT_INCL_CHECK_HAY_%out_count:
    __str_split_incl_empty_hay_%out_count = eq __str_split_incl_len_%out_count, 0
    br __str_split_incl_empty_hay_%out_count -> L_STR_SPLIT_INCL_ZERO_HAY_%out_count, L_STR_SPLIT_INCL_COUNT_MATCHES_%out_count

L_STR_SPLIT_INCL_ZERO_%out_count:
    %out_count = add 0, 0
    jmp L_STR_SPLIT_INCL_END_%out_count

L_STR_SPLIT_INCL_ZERO_HAY_%out_count:
    %out_count = add 0, 0
    !__str_split_incl_empty_hay_%out_count
    jmp L_STR_SPLIT_INCL_END_%out_count

L_STR_SPLIT_INCL_COUNT_MATCHES_%out_count:
    EXPAND STR_COUNT __str_split_incl_matches_%out_count, %slice_reg, %needle_slice
    __str_split_incl_no_matches_%out_count = eq __str_split_incl_matches_%out_count, 0
    br __str_split_incl_no_matches_%out_count -> L_STR_SPLIT_INCL_ONE_%out_count, L_STR_SPLIT_INCL_TRAIL_%out_count

L_STR_SPLIT_INCL_ONE_%out_count:
    %out_count = add 0, 1
    !__str_split_incl_no_matches_%out_count
    !__str_split_incl_matches_%out_count
    !__str_split_incl_empty_hay_%out_count
    jmp L_STR_SPLIT_INCL_END_%out_count

L_STR_SPLIT_INCL_TRAIL_%out_count:
    __str_split_incl_trail_start_%out_count = sub __str_split_incl_len_%out_count, __str_split_incl_needle_len_%out_count
    __str_split_incl_trail_ptr_%out_count = ptr_add __str_split_incl_ptr_%out_count, __str_split_incl_trail_start_%out_count
    __str_split_incl_trail_view_%out_count = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW __str_split_incl_trail_view_%out_count, __str_split_incl_trail_ptr_%out_count, __str_split_incl_needle_len_%out_count
    EXPAND STR_EQ __str_split_incl_trail_eq_%out_count, __str_split_incl_trail_view_%out_count, %needle_slice
    br __str_split_incl_trail_eq_%out_count -> L_STR_SPLIT_INCL_USE_MATCHES_%out_count, L_STR_SPLIT_INCL_USE_MATCHES_PLUS_ONE_%out_count

L_STR_SPLIT_INCL_USE_MATCHES_%out_count:
    %out_count = add __str_split_incl_matches_%out_count, 0
    !__str_split_incl_trail_eq_%out_count
    !__str_split_incl_trail_ptr_%out_count
    !__str_split_incl_trail_start_%out_count
    !__str_split_incl_no_matches_%out_count
    !__str_split_incl_matches_%out_count
    !__str_split_incl_empty_hay_%out_count
    jmp L_STR_SPLIT_INCL_END_%out_count

L_STR_SPLIT_INCL_USE_MATCHES_PLUS_ONE_%out_count:
    %out_count = add __str_split_incl_matches_%out_count, 1
    !__str_split_incl_trail_eq_%out_count
    !__str_split_incl_trail_ptr_%out_count
    !__str_split_incl_trail_start_%out_count
    !__str_split_incl_no_matches_%out_count
    !__str_split_incl_matches_%out_count
    !__str_split_incl_empty_hay_%out_count

L_STR_SPLIT_INCL_END_%out_count:
    !__str_split_incl_empty_needle_%out_count
    !__str_split_incl_needle_len_%out_count
    !__str_split_incl_len_%out_count
    !__str_split_incl_ptr_%out_count
[END_MACRO]

[MACRO] STRING_SPLIT_INCLUSIVE_NEEDLE_COUNT %out_count, %slice_reg, %needle_slice
    EXPAND STR_SPLIT_INCLUSIVE_NEEDLE_COUNT %out_count, %slice_reg, %needle_slice
[END_MACRO]

[MACRO] STRING_BUF_SPLIT_INCLUSIVE_NEEDLE_COUNT %out_count, %string_reg, %needle_slice
    EXPAND STR_SPLIT_INCLUSIVE_NEEDLE_COUNT %out_count, %string_reg, %needle_slice
[END_MACRO]

[MACRO] STR_SPLIT_NEEDLE_TERM_COUNT %out_count, %slice_reg, %needle_slice
    __str_term_ptr_%out_count = load %slice_reg+Slice_ptr as ptr
    __str_term_len_%out_count = load %slice_reg+Slice_len as u64
    __str_term_needle_ptr_%out_count = load %needle_slice+Slice_ptr as ptr
    __str_term_needle_len_%out_count = load %needle_slice+Slice_len as u64
    __str_term_empty_needle_%out_count = eq __str_term_needle_len_%out_count, 0
    br __str_term_empty_needle_%out_count -> L_STR_SPLIT_NEEDLE_TERM_EMPTY_NEEDLE_%out_count, L_STR_SPLIT_NEEDLE_TERM_NONEMPTY_NEEDLE_%out_count
L_STR_SPLIT_NEEDLE_TERM_EMPTY_NEEDLE_%out_count:
    %out_count = add 0, 0
    jmp L_STR_SPLIT_NEEDLE_TERM_END_%out_count
L_STR_SPLIT_NEEDLE_TERM_NONEMPTY_NEEDLE_%out_count:
    __str_term_len_zero_%out_count = eq __str_term_len_%out_count, 0
    br __str_term_len_zero_%out_count -> L_STR_SPLIT_NEEDLE_TERM_ZERO_LEN_%out_count, L_STR_SPLIT_NEEDLE_TERM_COUNT_BASE_%out_count
L_STR_SPLIT_NEEDLE_TERM_ZERO_LEN_%out_count:
    %out_count = add 0, 0
    jmp L_STR_SPLIT_NEEDLE_TERM_END_%out_count
L_STR_SPLIT_NEEDLE_TERM_COUNT_BASE_%out_count:
    EXPAND STR_COUNT %out_count, %slice_reg, %needle_slice
    %out_count = add %out_count, 1
    __str_term_scan_end_slot_%out_count = stack_alloc 8
    __str_term_run_slot_%out_count = stack_alloc 8
    store __str_term_scan_end_slot_%out_count+0, __str_term_len_%out_count as u64
    store __str_term_run_slot_%out_count+0, 0 as u64
    jmp L_STR_SPLIT_NEEDLE_TERM_TRAIL_HEAD_%out_count
L_STR_SPLIT_NEEDLE_TERM_TRAIL_HEAD_%out_count:
    __str_term_scan_end_%out_count = load __str_term_scan_end_slot_%out_count+0 as u64
    __str_term_can_trail_%out_count = uge __str_term_scan_end_%out_count, __str_term_needle_len_%out_count
    br __str_term_can_trail_%out_count -> L_STR_SPLIT_NEEDLE_TERM_TRAIL_MATCH_INIT_%out_count, L_STR_SPLIT_NEEDLE_TERM_TRAIL_DONE_%out_count
L_STR_SPLIT_NEEDLE_TERM_TRAIL_MATCH_INIT_%out_count:
    __str_term_trail_off_%out_count = sub __str_term_scan_end_%out_count, __str_term_needle_len_%out_count
    __str_term_trail_ptr_%out_count = ptr_add __str_term_ptr_%out_count, __str_term_trail_off_%out_count
    __str_term_trail_view_%out_count = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW __str_term_trail_view_%out_count, __str_term_trail_ptr_%out_count, __str_term_needle_len_%out_count
    __str_term_trail_eq_%out_count = add 0, 0
    EXPAND STR_EQ __str_term_trail_eq_%out_count, __str_term_trail_view_%out_count, %needle_slice
    br __str_term_trail_eq_%out_count -> L_STR_SPLIT_NEEDLE_TERM_TRAIL_INC_%out_count, L_STR_SPLIT_NEEDLE_TERM_TRAIL_DONE_%out_count
L_STR_SPLIT_NEEDLE_TERM_TRAIL_INC_%out_count:
    __str_term_run_%out_count = load __str_term_run_slot_%out_count+0 as u64
    __str_term_run_next_%out_count = add __str_term_run_%out_count, 1
    store __str_term_run_slot_%out_count+0, __str_term_run_next_%out_count as u64
    __str_term_scan_end_next_%out_count = sub __str_term_scan_end_%out_count, __str_term_needle_len_%out_count
    store __str_term_scan_end_slot_%out_count+0, __str_term_scan_end_next_%out_count as u64
    !__str_term_run_next_%out_count
    !__str_term_run_%out_count
    !__str_term_trail_off_%out_count
    !__str_term_trail_ptr_%out_count
    !__str_term_trail_eq_%out_count
    !__str_term_scan_end_%out_count
    !__str_term_can_trail_%out_count
    jmp L_STR_SPLIT_NEEDLE_TERM_TRAIL_HEAD_%out_count
L_STR_SPLIT_NEEDLE_TERM_TRAIL_DONE_%out_count:
    __str_term_run_final_%out_count = load __str_term_run_slot_%out_count+0 as u64
    %out_count = sub %out_count, __str_term_run_final_%out_count
    !__str_term_run_final_%out_count
    !__str_term_scan_end_%out_count
L_STR_SPLIT_NEEDLE_TERM_END_%out_count:
    !__str_term_needle_len_%out_count
    !__str_term_needle_ptr_%out_count
    !__str_term_len_%out_count
    !__str_term_ptr_%out_count
[END_MACRO]

