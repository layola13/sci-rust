[MACRO] STRING_BUF_TRY_EXTEND_CHARS_U64 %out_ok, %string_reg, %chars_slice
    __string_extend_chars_idx_slot_%out_ok = stack_alloc 8
    store __string_extend_chars_idx_slot_%out_ok+0, 0 as u64
    jmp L_STRING_EXTEND_CHARS_VALIDATE_HEAD_%out_ok

L_STRING_EXTEND_CHARS_VALIDATE_HEAD_%out_ok:
    __string_extend_chars_idx_%out_ok = load __string_extend_chars_idx_slot_%out_ok+0 as u64
    __string_extend_chars_len_%out_ok = load %chars_slice+Slice_len as u64
    __string_extend_chars_validate_done_%out_ok = eq __string_extend_chars_idx_%out_ok, __string_extend_chars_len_%out_ok
    !__string_extend_chars_len_%out_ok
    br __string_extend_chars_validate_done_%out_ok -> L_STRING_EXTEND_CHARS_APPEND_INIT_%out_ok, L_STRING_EXTEND_CHARS_VALIDATE_BODY_%out_ok

