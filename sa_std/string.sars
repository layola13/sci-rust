    __string_buf_isnwc_done_%out_ok = eq __string_buf_isnwc_idx_%out_ok, %count
    br __string_buf_isnwc_done_%out_ok -> L_STRING_BUF_ISNWC_DONE_%out_ok, L_STRING_BUF_ISNWC_BODY_%out_ok

L_STRING_BUF_ISNWC_BODY_%out_ok:
    __string_buf_isnwc_insert_len2_%out_ok = load %insert_slice+Slice_len as u64
    __string_buf_isnwc_pos_%out_ok = mul __string_buf_isnwc_idx_%out_ok, __string_buf_isnwc_insert_len2_%out_ok
    __string_buf_isnwc_at_%out_ok = add %index, __string_buf_isnwc_pos_%out_ok
    EXPAND STRING_BUF_TRY_INSERT_STR_WITHIN_CAPACITY __string_buf_isnwc_push_ok_%out_ok, %string_reg, __string_buf_isnwc_at_%out_ok, %insert_slice
