[MACRO] STRING_BUF_TRY_INSERT_STR_N_WITHIN_CAPACITY %out_ok, %string_reg, %index, %insert_slice, %count
    __string_buf_isnwc_insert_len_%out_ok = load %insert_slice+Slice_len as u64
    __string_buf_isnwc_total_%out_ok = mul __string_buf_isnwc_insert_len_%out_ok, %count
    EXPAND STRING_BUF_CAPACITY_REMAINING __string_buf_isnwc_remaining_%out_ok, %string_reg
    __string_buf_isnwc_room_ok_%out_ok = uge __string_buf_isnwc_remaining_%out_ok, __string_buf_isnwc_total_%out_ok
    br __string_buf_isnwc_room_ok_%out_ok -> L_STRING_BUF_ISNWC_BOUNDARY_%out_ok, L_STRING_BUF_ISNWC_NO_ROOM_%out_ok

L_STRING_BUF_ISNWC_BOUNDARY_%out_ok:
    EXPAND STRING_BUF_AS_STR __string_buf_isnwc_view_%out_ok, %string_reg
    EXPAND STR_IS_CHAR_BOUNDARY __string_buf_isnwc_boundary_%out_ok, __string_buf_isnwc_view_%out_ok, %index
    !__string_buf_isnwc_view_%out_ok
    br __string_buf_isnwc_boundary_%out_ok -> L_STRING_BUF_ISNWC_SETUP_%out_ok, L_STRING_BUF_ISNWC_BAD_BOUNDARY_%out_ok

L_STRING_BUF_ISNWC_SETUP_%out_ok:
    __string_buf_isnwc_idx_slot_%out_ok = stack_alloc 8
    store __string_buf_isnwc_idx_slot_%out_ok+0, 0 as u64
