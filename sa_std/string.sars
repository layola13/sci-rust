[MACRO] STRING_BUF_EXTEND_STR_ITER %string_reg, %str_iter_slice
    __string_buf_str_iter_len_%string_reg = load %str_iter_slice+Slice_len as u64
    __string_buf_str_iter_ptr_%string_reg = load %str_iter_slice+Slice_ptr as ptr
    __string_buf_str_iter_idx_slot_%string_reg = stack_alloc 8
    __string_buf_str_iter_item_%string_reg = stack_alloc Slice_SIZE
    store __string_buf_str_iter_idx_slot_%string_reg+0, 0 as u64
    jmp L_STRING_BUF_STR_ITER_HEAD_%string_reg

L_STRING_BUF_STR_ITER_HEAD_%string_reg:
    __string_buf_str_iter_idx_%string_reg = load __string_buf_str_iter_idx_slot_%string_reg+0 as u64
    __string_buf_str_iter_done_%string_reg = eq __string_buf_str_iter_idx_%string_reg, __string_buf_str_iter_len_%string_reg
    br __string_buf_str_iter_done_%string_reg -> L_STRING_BUF_STR_ITER_DONE_%string_reg, L_STRING_BUF_STR_ITER_BODY_%string_reg

