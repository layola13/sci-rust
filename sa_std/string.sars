    !__string_buf_lit2_len_a_%out_string
[END_MACRO]

[MACRO] STRING_BUF_LIT3 %out_string, %slice_a, %slice_b, %slice_c
    __string_buf_lit3_len_a_%out_string = load %slice_a+Slice_len as u64
    __string_buf_lit3_len_b_%out_string = load %slice_b+Slice_len as u64
    __string_buf_lit3_len_c_%out_string = load %slice_c+Slice_len as u64
    __string_buf_lit3_ab_%out_string = add __string_buf_lit3_len_a_%out_string, __string_buf_lit3_len_b_%out_string
    __string_buf_lit3_total_%out_string = add __string_buf_lit3_ab_%out_string, __string_buf_lit3_len_c_%out_string
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, __string_buf_lit3_total_%out_string
    EXPAND STRING_BUF_PUSH_STR %out_string, %slice_a
    EXPAND STRING_BUF_PUSH_STR %out_string, %slice_b
    EXPAND STRING_BUF_PUSH_STR %out_string, %slice_c
    !__string_buf_lit3_total_%out_string
    !__string_buf_lit3_ab_%out_string
    !__string_buf_lit3_len_c_%out_string
