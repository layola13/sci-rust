[MACRO] STR_TRY_SPLIT_INCLUSIVE_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %part_index
    EXPAND STR_SPLIT_INCLUSIVE_NEEDLE_COUNT __str_split_incl_at_count_%out_ok, %slice_reg, %needle_slice
    __str_split_incl_at_has_%out_ok = ugt __str_split_incl_at_count_%out_ok, %part_index
    br __str_split_incl_at_has_%out_ok -> L_STR_SPLIT_INCL_AT_HIT_%out_ok, L_STR_SPLIT_INCL_AT_MISS_%out_ok

L_STR_SPLIT_INCL_AT_HIT_%out_ok:
    EXPAND STR_TRY_SPLIT_NEEDLE_AT __str_split_incl_at_found_%out_ok, %out_part, %slice_reg, %needle_slice, %part_index
    br __str_split_incl_at_found_%out_ok -> L_STR_SPLIT_INCL_AT_DECIDE_%out_ok, L_STR_SPLIT_INCL_AT_SPLIT_MISS_%out_ok

L_STR_SPLIT_INCL_AT_DECIDE_%out_ok:
    EXPAND STR_MATCHES_NEEDLE_COUNT __str_split_incl_at_matches_%out_ok, %slice_reg, %needle_slice
    __str_split_incl_at_has_delim_%out_ok = ugt __str_split_incl_at_matches_%out_ok, %part_index
    br __str_split_incl_at_has_delim_%out_ok -> L_STR_SPLIT_INCL_AT_EXTEND_%out_ok, L_STR_SPLIT_INCL_AT_KEEP_%out_ok

L_STR_SPLIT_INCL_AT_EXTEND_%out_ok:
    __str_split_incl_at_part_ptr_%out_ok = load %out_part+Slice_ptr as ptr
    __str_split_incl_at_part_len_%out_ok = load %out_part+Slice_len as u64
    __str_split_incl_at_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_split_incl_at_len_%out_ok = add __str_split_incl_at_part_len_%out_ok, __str_split_incl_at_needle_len_%out_ok
    EXPAND SLICE_NEW %out_part, __str_split_incl_at_part_ptr_%out_ok, __str_split_incl_at_len_%out_ok
    %out_ok = add 0, 1
    !__str_split_incl_at_len_%out_ok
    !__str_split_incl_at_needle_len_%out_ok
    !__str_split_incl_at_part_len_%out_ok
    !__str_split_incl_at_part_ptr_%out_ok
    !__str_split_incl_at_has_delim_%out_ok
    !__str_split_incl_at_matches_%out_ok
    !__str_split_incl_at_found_%out_ok
    jmp L_STR_SPLIT_INCL_AT_END_%out_ok

L_STR_SPLIT_INCL_AT_KEEP_%out_ok:
    %out_ok = add 0, 1
    !__str_split_incl_at_has_delim_%out_ok
    !__str_split_incl_at_matches_%out_ok
    !__str_split_incl_at_found_%out_ok
    jmp L_STR_SPLIT_INCL_AT_END_%out_ok

L_STR_SPLIT_INCL_AT_SPLIT_MISS_%out_ok:
    %out_ok = add 0, 0
    !__str_split_incl_at_found_%out_ok
    jmp L_STR_SPLIT_INCL_AT_END_%out_ok

L_STR_SPLIT_INCL_AT_MISS_%out_ok:
    %out_part = alloc Slice_SIZE
    __str_split_incl_at_empty_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_split_incl_at_empty_%out_ok, 0
    %out_ok = add 0, 0
    !__str_split_incl_at_empty_%out_ok

L_STR_SPLIT_INCL_AT_END_%out_ok:
    !__str_split_incl_at_has_%out_ok
    !__str_split_incl_at_count_%out_ok
[END_MACRO]

