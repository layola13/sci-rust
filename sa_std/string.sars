[MACRO] STR_TRY_SUBSTR_RANGE %out_ok, %out_start, %out_end, %hay_slice, %sub_slice
    __str_substr_range_hay_ptr_%out_ok = load %hay_slice+Slice_ptr as ptr
    __str_substr_range_hay_len_%out_ok = load %hay_slice+Slice_len as u64
    __str_substr_range_sub_ptr_%out_ok = load %sub_slice+Slice_ptr as ptr
    __str_substr_range_sub_len_%out_ok = load %sub_slice+Slice_len as u64
    __str_substr_range_hay_addr_%out_ok = bitcast __str_substr_range_hay_ptr_%out_ok as u64
    __str_substr_range_sub_addr_%out_ok = bitcast __str_substr_range_sub_ptr_%out_ok as u64
    __str_substr_range_addr_ok_%out_ok = uge __str_substr_range_sub_addr_%out_ok, __str_substr_range_hay_addr_%out_ok
    br __str_substr_range_addr_ok_%out_ok -> L_STR_SUBSTR_RANGE_START_%out_ok, L_STR_SUBSTR_RANGE_MISS_%out_ok

L_STR_SUBSTR_RANGE_START_%out_ok:
    __str_substr_range_start_%out_ok = sub __str_substr_range_sub_addr_%out_ok, __str_substr_range_hay_addr_%out_ok
    __str_substr_range_start_ok_%out_ok = ule __str_substr_range_start_%out_ok, __str_substr_range_hay_len_%out_ok
    br __str_substr_range_start_ok_%out_ok -> L_STR_SUBSTR_RANGE_END_%out_ok, L_STR_SUBSTR_RANGE_MISS_START_%out_ok

L_STR_SUBSTR_RANGE_END_%out_ok:
    __str_substr_range_remaining_%out_ok = sub __str_substr_range_hay_len_%out_ok, __str_substr_range_start_%out_ok
    __str_substr_range_len_ok_%out_ok = ule __str_substr_range_sub_len_%out_ok, __str_substr_range_remaining_%out_ok
    br __str_substr_range_len_ok_%out_ok -> L_STR_SUBSTR_RANGE_HIT_%out_ok, L_STR_SUBSTR_RANGE_MISS_LEN_%out_ok

L_STR_SUBSTR_RANGE_HIT_%out_ok:
    %out_start = add __str_substr_range_start_%out_ok, 0
    %out_end = add __str_substr_range_start_%out_ok, __str_substr_range_sub_len_%out_ok
    %out_ok = add 0, 1
    !__str_substr_range_len_ok_%out_ok
    !__str_substr_range_remaining_%out_ok
    !__str_substr_range_start_ok_%out_ok
    !__str_substr_range_start_%out_ok
    !__str_substr_range_addr_ok_%out_ok
    !__str_substr_range_sub_addr_%out_ok
    !__str_substr_range_hay_addr_%out_ok
    !__str_substr_range_sub_len_%out_ok
    !__str_substr_range_sub_ptr_%out_ok
    !__str_substr_range_hay_len_%out_ok
    !__str_substr_range_hay_ptr_%out_ok
    jmp L_STR_SUBSTR_RANGE_DONE_%out_ok

L_STR_SUBSTR_RANGE_MISS_LEN_%out_ok:
    %out_start = add 0, 0
    %out_end = add 0, 0
    %out_ok = add 0, 0
    !__str_substr_range_len_ok_%out_ok
    !__str_substr_range_remaining_%out_ok
    !__str_substr_range_start_ok_%out_ok
    !__str_substr_range_start_%out_ok
    !__str_substr_range_addr_ok_%out_ok
    !__str_substr_range_sub_addr_%out_ok
    !__str_substr_range_hay_addr_%out_ok
    !__str_substr_range_sub_len_%out_ok
    !__str_substr_range_sub_ptr_%out_ok
    !__str_substr_range_hay_len_%out_ok
    !__str_substr_range_hay_ptr_%out_ok
    jmp L_STR_SUBSTR_RANGE_DONE_%out_ok

L_STR_SUBSTR_RANGE_MISS_START_%out_ok:
    %out_start = add 0, 0
    %out_end = add 0, 0
    %out_ok = add 0, 0
    !__str_substr_range_start_ok_%out_ok
    !__str_substr_range_start_%out_ok
    !__str_substr_range_addr_ok_%out_ok
    !__str_substr_range_sub_addr_%out_ok
    !__str_substr_range_hay_addr_%out_ok
    !__str_substr_range_sub_len_%out_ok
    !__str_substr_range_sub_ptr_%out_ok
    !__str_substr_range_hay_len_%out_ok
    !__str_substr_range_hay_ptr_%out_ok
    jmp L_STR_SUBSTR_RANGE_DONE_%out_ok

L_STR_SUBSTR_RANGE_MISS_%out_ok:
    %out_start = add 0, 0
    %out_end = add 0, 0
    %out_ok = add 0, 0
    !__str_substr_range_addr_ok_%out_ok
    !__str_substr_range_sub_addr_%out_ok
    !__str_substr_range_hay_addr_%out_ok
    !__str_substr_range_sub_len_%out_ok
    !__str_substr_range_sub_ptr_%out_ok
    !__str_substr_range_hay_len_%out_ok
    !__str_substr_range_hay_ptr_%out_ok

L_STR_SUBSTR_RANGE_DONE_%out_ok:
[END_MACRO]

