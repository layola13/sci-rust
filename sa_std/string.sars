@import "core/slice.sal"
@import "core/slice.sars"
@import "char.sars"
@import "ascii.sars"
@import "vec.sars"
@import "vec.sal"
@import "string.sai"
@import "fmt.sai"
@import "hash.sars"
@import "string_format.sars"

[MACRO] STR_LEN %out_len, %slice_reg
    EXPAND SLICE_GET_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STRING_LEN %out_len, %slice_reg
    EXPAND STR_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STR_PTR %out_ptr, %slice_reg
    EXPAND SLICE_GET_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_MUT_PTR %out_ptr, %slice_reg
    EXPAND STR_AS_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_PTR_RANGE %out_start, %out_end, %slice_reg
    EXPAND SLICE_AS_PTR_RANGE %out_start, %out_end, %slice_reg, 1
[END_MACRO]

[MACRO] STR_AS_MUT_PTR_RANGE %out_start, %out_end, %slice_reg
    EXPAND SLICE_AS_MUT_PTR_RANGE %out_start, %out_end, %slice_reg, 1
[END_MACRO]

[MACRO] STRING_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_PTR %out_ptr, %slice_reg
    EXPAND STRING_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_MUT_PTR %out_ptr, %slice_reg
    EXPAND STR_AS_MUT_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_PTR_RANGE %out_start, %out_end, %slice_reg
    EXPAND STR_AS_PTR_RANGE %out_start, %out_end, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_MUT_PTR_RANGE %out_start, %out_end, %slice_reg
    EXPAND STR_AS_MUT_PTR_RANGE %out_start, %out_end, %slice_reg
[END_MACRO]

[MACRO] STR_AS_BYTES %out_slice, %slice_reg
    __str_ptr_%out_slice = load %slice_reg+Slice_ptr as ptr
    __str_len_%out_slice = load %slice_reg+Slice_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_ptr_%out_slice, __str_len_%out_slice
    !__str_ptr_%out_slice
    !__str_len_%out_slice
[END_MACRO]

[MACRO] STR_AS_MUT_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_AS_ASCII %out_ok, %out_slice, %slice_reg
    %out_slice = alloc Slice_SIZE
    EXPAND ASCII_SLICE_AS_ASCII %out_ok, %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_AS_ASCII_UNCHECKED %out_slice, %slice_reg
    %out_slice = alloc Slice_SIZE
    EXPAND ASCII_SLICE_AS_ASCII_UNCHECKED %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_MUT_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_MUT_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_ASCII %out_ok, %out_slice, %slice_reg
    EXPAND STR_AS_ASCII %out_ok, %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_ASCII_UNCHECKED %out_slice, %slice_reg
    EXPAND STR_AS_ASCII_UNCHECKED %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_BYTES %out_slice, %slice_reg
    EXPAND STRING_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_STR %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_IS_EMPTY %out_bool, %slice_reg
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    %out_bool = eq __str_len_%out_bool, 0
    !__str_len_%out_bool
[END_MACRO]

[MACRO] STRING_IS_EMPTY %out_bool, %slice_reg
    EXPAND STR_IS_EMPTY %out_bool, %slice_reg
[END_MACRO]

[MACRO] STR_FROM_PARTS %out_slice, %data_ptr, %length
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STRING_FROM_PARTS %out_slice, %data_ptr, %length
    EXPAND STR_FROM_PARTS %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STR_TRY_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
    EXPAND STR_IS_UTF8 __str_from_utf8_valid_%out_ok, %bytes_slice
    br __str_from_utf8_valid_%out_ok -> L_STR_FROM_UTF8_OK_%out_ok, L_STR_FROM_UTF8_BAD_%out_ok

L_STR_FROM_UTF8_OK_%out_ok:
    __str_from_utf8_ptr_%out_ok = load %bytes_slice+Slice_ptr as ptr
    __str_from_utf8_len_%out_ok = load %bytes_slice+Slice_len as u64
    EXPAND STR_FROM_PARTS %out_slice, __str_from_utf8_ptr_%out_ok, __str_from_utf8_len_%out_ok
    %out_ok = add 0, 1
    !__str_from_utf8_len_%out_ok
    !__str_from_utf8_ptr_%out_ok
    !__str_from_utf8_valid_%out_ok
    jmp L_STR_FROM_UTF8_DONE_%out_ok

L_STR_FROM_UTF8_BAD_%out_ok:
    __str_from_utf8_empty_ptr_%out_ok = 0 as ptr
    EXPAND STR_FROM_PARTS %out_slice, __str_from_utf8_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_from_utf8_empty_ptr_%out_ok
    !__str_from_utf8_valid_%out_ok

L_STR_FROM_UTF8_DONE_%out_ok:
[END_MACRO]

[MACRO] STR_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
    EXPAND STR_TRY_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STR_TRY_FROM_UTF8_MUT %out_ok, %out_slice, %bytes_slice
    EXPAND STR_TRY_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STR_FROM_UTF8_MUT %out_ok, %out_slice, %bytes_slice
    EXPAND STR_TRY_FROM_UTF8_MUT %out_ok, %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STR_FROM_UTF8_UNCHECKED %out_slice, %bytes_slice
    __str_from_utf8_unchecked_ptr_%out_slice = load %bytes_slice+Slice_ptr as ptr
    __str_from_utf8_unchecked_len_%out_slice = load %bytes_slice+Slice_len as u64
    EXPAND STR_FROM_PARTS %out_slice, __str_from_utf8_unchecked_ptr_%out_slice, __str_from_utf8_unchecked_len_%out_slice
    !__str_from_utf8_unchecked_len_%out_slice
    !__str_from_utf8_unchecked_ptr_%out_slice
[END_MACRO]

[MACRO] STR_FROM_UTF8_UNCHECKED_MUT %out_slice, %bytes_slice
    EXPAND STR_FROM_UTF8_UNCHECKED %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STRING_TRY_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
    EXPAND STR_TRY_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STRING_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
    EXPAND STR_FROM_UTF8 %out_ok, %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STRING_TRY_FROM_UTF8_MUT %out_ok, %out_slice, %bytes_slice
    EXPAND STR_TRY_FROM_UTF8_MUT %out_ok, %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STRING_FROM_UTF8_MUT %out_ok, %out_slice, %bytes_slice
    EXPAND STR_FROM_UTF8_MUT %out_ok, %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STRING_FROM_UTF8_UNCHECKED %out_slice, %bytes_slice
    EXPAND STR_FROM_UTF8_UNCHECKED %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STRING_FROM_UTF8_UNCHECKED_MUT %out_slice, %bytes_slice
    EXPAND STR_FROM_UTF8_UNCHECKED_MUT %out_slice, %bytes_slice
[END_MACRO]

[MACRO] STRING_NEW %out_slice
    __string_empty_ptr_%out_slice = 0 as ptr
    EXPAND STRING_FROM_PARTS %out_slice, __string_empty_ptr_%out_slice, 0
    !__string_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STRING_BUF_NEW %out_string
    EXPAND VEC_WITH_CAPACITY %out_string, 0, 1
[END_MACRO]

[MACRO] STRING_BUF_DEFAULT %out_string
    EXPAND STRING_BUF_NEW %out_string
[END_MACRO]

[MACRO] STRING_BUF_WITH_CAPACITY %out_string, %capacity
    EXPAND VEC_WITH_CAPACITY %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity
    EXPAND VEC_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_FREE %string_reg
    EXPAND VEC_FREE %string_reg
[END_MACRO]

[MACRO] STRING_BUF_DROP_IN_PLACE %string_reg
    __string_buf_drop_ptr_%string_reg = take %string_reg+Vec_ptr
    store %string_reg+Vec_cap, 0 as u64
    store %string_reg+Vec_len, 0 as u64
    !__string_buf_drop_ptr_%string_reg
[END_MACRO]

[MACRO] STRING_BUF_LEN %out_len, %string_reg
    EXPAND VEC_LEN %out_len, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_CAPACITY %out_cap, %string_reg
    EXPAND VEC_CAPACITY %out_cap, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_CAPACITY_REMAINING %out_remaining, %string_reg
    EXPAND VEC_CAPACITY_REMAINING %out_remaining, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_REMAINING_CAPACITY %out_remaining, %string_reg
    EXPAND STRING_BUF_CAPACITY_REMAINING %out_remaining, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_SPARE_CAPACITY_MUT %out_slice, %string_reg
    EXPAND VEC_SPARE_CAPACITY_MUT %out_slice, %string_reg, 1
[END_MACRO]

[MACRO] STRING_BUF_SPLIT_AT_SPARE_MUT %out_init_slice, %out_spare_slice, %string_reg
    EXPAND STRING_BUF_AS_MUT_BYTES %out_init_slice, %string_reg
    EXPAND STRING_BUF_SPARE_CAPACITY_MUT %out_spare_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_INTO_RAW_PARTS %out_ptr, %out_len, %out_cap, %string_reg
    EXPAND VEC_INTO_RAW_PARTS %out_ptr, %out_len, %out_cap, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_FROM_RAW_PARTS %out_string, %ptr, %len, %cap
