    __string_buf_replace_view_%out_ok = & %string_reg
    __string_buf_replace_old_len_%out_ok = load __string_buf_replace_view_%out_ok+Vec_len as u64
    __string_buf_replace_start_ok_%out_ok = ule %start, __string_buf_replace_old_len_%out_ok
    br __string_buf_replace_start_ok_%out_ok -> L_STRING_BUF_REPLACE_LEN_CHECK_%out_ok, L_STRING_BUF_REPLACE_MISS_START_%out_ok

