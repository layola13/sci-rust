[MACRO] STRING_BUF_LIT2 %out_string, %slice_a, %slice_b
    __string_buf_lit2_len_a_%out_string = load %slice_a+Slice_len as u64
    __string_buf_lit2_len_b_%out_string = load %slice_b+Slice_len as u64
    __string_buf_lit2_total_%out_string = add __string_buf_lit2_len_a_%out_string, __string_buf_lit2_len_b_%out_string
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, __string_buf_lit2_total_%out_string
    EXPAND STRING_BUF_PUSH_STR %out_string, %slice_a
    EXPAND STRING_BUF_PUSH_STR %out_string, %slice_b
    !__string_buf_lit2_total_%out_string
