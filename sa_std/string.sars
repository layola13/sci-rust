L_STRING_BUF_PSNWC_HEAD_%out_ok:
    __string_buf_psnwc_idx_%out_ok = load __string_buf_psnwc_idx_slot_%out_ok+0 as u64
    __string_buf_psnwc_done_%out_ok = eq __string_buf_psnwc_idx_%out_ok, %count
    br __string_buf_psnwc_done_%out_ok -> L_STRING_BUF_PSNWC_DONE_%out_ok, L_STRING_BUF_PSNWC_BODY_%out_ok

L_STRING_BUF_PSNWC_BODY_%out_ok:
    EXPAND STRING_BUF_TRY_PUSH_STR_WITHIN_CAPACITY __string_buf_psnwc_push_ok_%out_ok, %string_reg, %suffix_slice
    br __string_buf_psnwc_push_ok_%out_ok -> L_STRING_BUF_PSNWC_NEXT_%out_ok, L_STRING_BUF_PSNWC_FAIL_%out_ok

L_STRING_BUF_PSNWC_NEXT_%out_ok:
    __string_buf_psnwc_next_%out_ok = add __string_buf_psnwc_idx_%out_ok, 1
    store __string_buf_psnwc_idx_slot_%out_ok+0, __string_buf_psnwc_next_%out_ok as u64
    !__string_buf_psnwc_next_%out_ok
    !__string_buf_psnwc_push_ok_%out_ok
    !__string_buf_psnwc_done_%out_ok
    !__string_buf_psnwc_idx_%out_ok
    jmp L_STRING_BUF_PSNWC_HEAD_%out_ok

L_STRING_BUF_PSNWC_FAIL_%out_ok:
