    jmp L_STRING_BUF_PSNWC_END_%out_ok

L_STRING_BUF_PSNWC_DONE_%out_ok:
    %out_ok = add 0, 1
    !__string_buf_psnwc_done_%out_ok
    !__string_buf_psnwc_idx_%out_ok
    jmp L_STRING_BUF_PSNWC_END_%out_ok

L_STRING_BUF_PSNWC_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_psnwc_has_room_%out_ok
    !__string_buf_psnwc_remaining_%out_ok
    !__string_buf_psnwc_total_%out_ok
    !__string_buf_psnwc_suffix_len_%out_ok

L_STRING_BUF_PSNWC_END_%out_ok:
[END_MACRO]

