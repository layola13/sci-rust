[MACRO] STR_TRY_SPLIT_BYTE_AT %out_ok, %out_part, %slice_reg, %byte_value, %part_index
    %out_part = alloc Slice_SIZE
    __str_split_byte_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_split_byte_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_split_byte_scan_slot_%out_ok = stack_alloc 8
    __str_split_byte_start_slot_%out_ok = stack_alloc 8
    __str_split_byte_current_slot_%out_ok = stack_alloc 8
    store __str_split_byte_scan_slot_%out_ok+0, 0 as u64
    store __str_split_byte_start_slot_%out_ok+0, 0 as u64
    store __str_split_byte_current_slot_%out_ok+0, 0 as u64
    jmp L_STR_SPLIT_BYTE_HEAD_%out_ok

L_STR_SPLIT_BYTE_HEAD_%out_ok:
    __str_split_byte_scan_%out_ok = load __str_split_byte_scan_slot_%out_ok+0 as u64
    __str_split_byte_done_%out_ok = eq __str_split_byte_scan_%out_ok, __str_split_byte_len_%out_ok
    br __str_split_byte_done_%out_ok -> L_STR_SPLIT_BYTE_FINAL_%out_ok, L_STR_SPLIT_BYTE_BODY_%out_ok

L_STR_SPLIT_BYTE_BODY_%out_ok:
    __str_split_byte_ip_%out_ok = ptr_add __str_split_byte_ptr_%out_ok, __str_split_byte_scan_%out_ok
    __str_split_byte_value_%out_ok = load __str_split_byte_ip_%out_ok+0 as u8
