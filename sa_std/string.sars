[MACRO] STR_IS_ASCII %out_bool, %slice_reg
    __str_ptr_%out_bool = load %slice_reg+Slice_ptr as ptr
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    %out_bool = call @sa_str_is_ascii(__str_ptr_%out_bool, __str_len_%out_bool)
    !__str_len_%out_bool
    !__str_ptr_%out_bool
[END_MACRO]

