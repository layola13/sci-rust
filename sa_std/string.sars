[MACRO] STR_SPLIT_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %part_index
    EXPAND STR_TRY_SPLIT_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %part_index
[END_MACRO]

[MACRO] STRING_SPLIT_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %part_index
    EXPAND STR_TRY_SPLIT_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %part_index
[END_MACRO]

[MACRO] STRING_BUF_SPLIT_NEEDLE_AT %out_ok, %out_part, %string_reg, %needle_slice, %part_index
    EXPAND STR_TRY_SPLIT_NEEDLE_AT %out_ok, %out_part, %string_reg, %needle_slice, %part_index
[END_MACRO]

[MACRO] STR_TRY_RSPLIT_NEEDLE_AT %out_ok, %out_part, %slice_reg, %needle_slice, %part_index
    EXPAND STR_SPLIT_NEEDLE_COUNT __str_rsplit_needle_count_%out_ok, %slice_reg, %needle_slice
    __str_rsplit_needle_has_%out_ok = ugt __str_rsplit_needle_count_%out_ok, %part_index
    br __str_rsplit_needle_has_%out_ok -> L_STR_RSPLIT_NEEDLE_HIT_%out_ok, L_STR_RSPLIT_NEEDLE_MISS_%out_ok

L_STR_RSPLIT_NEEDLE_HIT_%out_ok:
    __str_rsplit_needle_last_%out_ok = sub __str_rsplit_needle_count_%out_ok, 1
    __str_rsplit_needle_forward_%out_ok = sub __str_rsplit_needle_last_%out_ok, %part_index
    EXPAND STR_TRY_SPLIT_NEEDLE_AT __str_rsplit_needle_found_%out_ok, %out_part, %slice_reg, %needle_slice, __str_rsplit_needle_forward_%out_ok
    %out_ok = add __str_rsplit_needle_found_%out_ok, 0
    !__str_rsplit_needle_found_%out_ok
    !__str_rsplit_needle_forward_%out_ok
    !__str_rsplit_needle_last_%out_ok
    jmp L_STR_RSPLIT_NEEDLE_END_%out_ok

L_STR_RSPLIT_NEEDLE_MISS_%out_ok:
    %out_part = alloc Slice_SIZE
    __str_rsplit_needle_empty_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_rsplit_needle_empty_%out_ok, 0
    %out_ok = add 0, 0
    !__str_rsplit_needle_empty_%out_ok

L_STR_RSPLIT_NEEDLE_END_%out_ok:
    !__str_rsplit_needle_has_%out_ok
    !__str_rsplit_needle_count_%out_ok
[END_MACRO]

