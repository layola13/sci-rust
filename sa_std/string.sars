    %out_ok = add 0, 0
    !__str_rsplitn_empty_miss_ptr_%out_ok
    !__str_rsplitn_empty_target0_%out_ok
    !__str_rsplitn_top_empty_needle_%out_ok
    !__str_rsplitn_top_needle_len_%out_ok
    jmp L_STR_RSPLITN_TOP_END_%out_ok

L_STR_RSPLITN_NONEMPTY_NEEDLE_%out_ok:
    !__str_rsplitn_top_empty_needle_%out_ok
    !__str_rsplitn_top_needle_len_%out_ok
    __str_rsplitn_limit_%out_ok = sub %split_count, 1
    __str_rsplitn_has_%out_ok = ule %part_index, __str_rsplitn_limit_%out_ok
    br __str_rsplitn_has_%out_ok -> L_STR_RSPLITN_HIT_%out_ok, L_STR_RSPLITN_FINAL_MISS_%out_ok

L_STR_RSPLITN_HIT_%out_ok:
    __str_rsplitn_forward_index_%out_ok = sub __str_rsplitn_limit_%out_ok, %part_index
    EXPAND STR_TRY_SPLIT_N_NEEDLE_AT __str_rsplitn_found_%out_ok, %out_part, %slice_reg, %needle_slice, %split_count, __str_rsplitn_forward_index_%out_ok
    %out_ok = add __str_rsplitn_found_%out_ok, 0
    !__str_rsplitn_found_%out_ok
    !__str_rsplitn_forward_index_%out_ok
    jmp L_STR_RSPLITN_END_%out_ok

L_STR_RSPLITN_FINAL_MISS_%out_ok:
    %out_part = alloc Slice_SIZE
    __str_rsplitn_empty_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_rsplitn_empty_%out_ok, 0
    %out_ok = add 0, 0
    !__str_rsplitn_empty_%out_ok

L_STR_RSPLITN_END_%out_ok:
    !__str_rsplitn_has_%out_ok
    !__str_rsplitn_limit_%out_ok
    jmp L_STR_RSPLITN_TOP_END_%out_ok

L_STR_RSPLITN_TOP_END_%out_ok:
    !__str_rsplitn_zero_%out_ok
