    __string_buf_str_iter_elem_%string_reg = ptr_add __string_buf_str_iter_ptr_%string_reg, __string_buf_str_iter_off_%string_reg
    __string_buf_str_iter_elem_ptr_%string_reg = load __string_buf_str_iter_elem_%string_reg+Slice_ptr as ptr
