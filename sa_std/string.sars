    __string_buf_psnwc_has_room_%out_ok = uge __string_buf_psnwc_remaining_%out_ok, __string_buf_psnwc_total_%out_ok
    br __string_buf_psnwc_has_room_%out_ok -> L_STRING_BUF_PSNWC_SETUP_%out_ok, L_STRING_BUF_PSNWC_MISS_%out_ok

L_STRING_BUF_PSNWC_SETUP_%out_ok:
    __string_buf_psnwc_idx_slot_%out_ok = stack_alloc 8
    store __string_buf_psnwc_idx_slot_%out_ok+0, 0 as u64
