    EXPAND SLICE_NEW %out_part, __str_rsplitn_empty_hay_ptr_%out_ok, __str_rsplitn_empty_hay_len_%out_ok
    %out_ok = add 0, 1
    !__str_rsplitn_empty_hay_len_%out_ok
    !__str_rsplitn_empty_hay_ptr_%out_ok
    !__str_rsplitn_empty_target0_%out_ok
    !__str_rsplitn_top_empty_needle_%out_ok
    !__str_rsplitn_top_needle_len_%out_ok
    jmp L_STR_RSPLITN_TOP_END_%out_ok

L_STR_RSPLITN_EMPTY_MISS_%out_ok:
