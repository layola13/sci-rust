    __string_buf_isnwc_next_%out_ok = add __string_buf_isnwc_idx_%out_ok, 1
    store __string_buf_isnwc_idx_slot_%out_ok+0, __string_buf_isnwc_next_%out_ok as u64
    !__string_buf_isnwc_next_%out_ok
    !__string_buf_isnwc_push_ok_%out_ok
    !__string_buf_isnwc_at_%out_ok
    !__string_buf_isnwc_pos_%out_ok
    !__string_buf_isnwc_insert_len2_%out_ok
