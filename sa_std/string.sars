    EXPAND STR_EMPTY __string_buf_drwc_empty_%out_ok
    EXPAND STRING_BUF_TRY_REPLACE_RANGE_WITHIN_CAPACITY %out_ok, %string_reg, %start, %length, __string_buf_drwc_empty_%out_ok
    !__string_buf_drwc_empty_%out_ok
    !__string_buf_drwc_range_%out_ok
    !__string_buf_drwc_range_ok_%out_ok
    !__string_buf_drwc_view_%out_ok
    jmp L_STRING_BUF_DRWC_END_%out_ok

L_STRING_BUF_DRWC_MISS_%out_ok:
    EXPAND STRING_BUF_NEW %out_string
    %out_ok = add 0, 0
    !__string_buf_drwc_range_%out_ok
    !__string_buf_drwc_range_ok_%out_ok
    !__string_buf_drwc_view_%out_ok

L_STRING_BUF_DRWC_END_%out_ok:
