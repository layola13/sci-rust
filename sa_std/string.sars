    EXPAND STR_MATCHES_NEEDLE_COUNT __str_rmatch_indices_count_%out_ok, %slice_reg, %needle_slice
    __str_rmatch_indices_has_%out_ok = ugt __str_rmatch_indices_count_%out_ok, %match_index
