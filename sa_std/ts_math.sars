// ts_math.sa -- thin integer math ops for tsgosa mapping (R3 backport).
//
// i32 语义自成一体（溢出环绕、负指数返 1），f64 extern 不可直映；逐符号移植
// tsgosa sa_math.go 内联循环，调用点只做 import + 单 call。
// 形状证据：移植 saEvalMathPow:180-208（res=1 起逐乘，expo<=0 零次返 1）。

// @ts_math_ipow i32 逐乘幂（expo<=0 返 1；溢出按 i32 环绕，与调用点旧形一致）。
@ts_math_ipow(base: i32, expo: i32) -> i32:
L_IPW_ENTRY:
    res = 1
    ctr = add expo, 0
    jmp L_IPW_TOP
L_IPW_TOP:
    cc = sgt ctr, 0
    br cc -> L_IPW_BODY, L_IPW_END
L_IPW_BODY:
    nr = mul res, base
    res = nr
    nc = sub ctr, 1
    ctr = nc
    jmp L_IPW_TOP
L_IPW_END:
    return res

// @ts_math_isqrt 整数二分开方（返 floor(sqrt)；移植 saEvalMathSqrt:353-412
// 全形：acc=0、lo=1、hi=x，`mid<=x/mid` 取最佳；具名快照留调用点；循环内
// mid 经槽中转（div 消费后分支内复用须 load；分支汇合状态经自赋值对齐）。
@ts_math_isqrt(x: i32) -> i32:
L_ISQ_ENTRY:
    acc = 0
    lo = 1
    hi = add x, 0
    mslot = alloc 8
    jmp L_ISQ_TOP
L_ISQ_TOP:
    c = sle lo, hi
    br c -> L_ISQ_BODY, L_ISQ_END
L_ISQ_BODY:
    d = sub hi, lo
    h = div d, 2
    mid = add lo, h
    store mslot+0, mid as i32
    q = div x, mid
    ok = sle mid, q
    br ok -> L_ISQ_TAKE, L_ISQ_SKIP
L_ISQ_TAKE:
    accm = load mslot+0 as i32
    acc = accm
    midt = load mslot+0 as i32
    loN = add midt, 1
    lo = loN
    hi = hi
    jmp L_ISQ_NEXT
L_ISQ_SKIP:
    acc = acc
    lo = lo
    midt = load mslot+0 as i32
    hiN = sub midt, 1
    hi = hiN
    jmp L_ISQ_NEXT
L_ISQ_NEXT:
    jmp L_ISQ_TOP
L_ISQ_END:
    !mslot
    return acc

// @ts_math_ilog10 十进制位数减一（`>=10` 则 `/=10` 且计数++；移植
// saEvalMathLog10:380-408 全形；调用点种门禁保留）。
@ts_math_ilog10(x: i32) -> i32:
L_L10_ENTRY:
    lacc = 0
    ltmp = add x, 0
    jmp L_L10_TOP
L_L10_TOP:
    c = sge ltmp, 10
    br c -> L_L10_BODY, L_L10_END
L_L10_BODY:
    q = div ltmp, 10
    ltmp = q
    a = add lacc, 1
    lacc = a
    jmp L_L10_TOP
L_L10_END:
    return lacc

// @ts_math_spread_minmax 数组极值（best 初 ∓INT 极值，索引巡回归约；空数组返
// 初值；移植 saEvalMathSpreadMinMax:463-504 全形；分支汇合 best 自赋值对齐）。
@ts_math_spread_minmax(h: ptr, ismax: i32) -> i32:
L_MM_ENTRY:
    ln = load h+8 as u64
    data = load h+0 as ptr
    take_max = ne ismax, 0
    br take_max -> L_MM_MAX, L_MM_MIN
L_MM_MAX:
    best = -2147483648
    jmp L_MM_LOOP
L_MM_MIN:
    best = 2147483647
    jmp L_MM_LOOP
L_MM_LOOP:
    i = 0
    jmp L_MM_TOP
L_MM_TOP:
    c = slt i, ln
    br c -> L_MM_BODY, L_MM_END
L_MM_BODY:
    off = mul i, 4
    addr = add data, off
    elem = load addr+0 as i32
    cmp_max = sgt elem, best
    cmp_min = slt elem, best
    use_max = ne ismax, 0
    br use_max -> L_MM_CMPMAX, L_MM_CMPMIN
L_MM_CMPMAX:
    cmp = add cmp_max, 0
    jmp L_MM_WHICH
L_MM_CMPMIN:
    cmp = add cmp_min, 0
    jmp L_MM_WHICH
L_MM_WHICH:
    take = ne cmp, 0
    br take -> L_MM_TAKE, L_MM_SKIP
L_MM_TAKE:
    nb = add elem, 0
    best = nb
    jmp L_MM_SKIP
L_MM_SKIP:
    best = best
    inext = add i, 1
    i = inext
    jmp L_MM_TOP
L_MM_END:
    return best

// @ts_math_iabs i32 绝对值（分支经槽中转，汇合无 Phi；移植 saEvalMathAbs:76-103 全形）。
@ts_math_iabs(v: i32) -> i32:
L_IABS_ENTRY:
    slot = alloc 8
    c = sge v, 0
    br c -> L_IABS_T, L_IABS_F
L_IABS_T:
    store slot+0, v as i32
    jmp L_IABS_END
L_IABS_F:
    nv = sub 0, v
    store slot+0, nv as i32
    jmp L_IABS_END
L_IABS_END:
    out = load slot+0 as i32
    !slot
    return out

// @ts_math_isign i32 符号（(x>0)-(x<0)，恒精确含 0；移植 saEvalMathSign:127-135 全形）。
@ts_math_isign(v: i32) -> i32:
L_ISGN_ENTRY:
    p = sgt v, 0
    n = slt v, 0
    out = sub p, n
    return out

// @ts_math_imul i32 低 32 位乘（SA mul 即 wrap；移植 saEvalMathImul:157-159 全形）。
@ts_math_imul(a: i32, b: i32) -> i32:
L_IMUL_ENTRY:
    t = mul a, b
    return t

// @ts_math_minmax i32 双参极值（ismax=1 取大；分支经槽中转；移植
// saEvalMathMinMax:275-303 全形；spread 归约另见 spread_minmax）。
@ts_math_minmax(a: i32, b: i32, ismax: i32) -> i32:
L_MNX_ENTRY:
    slot = alloc 8
    take_max = ne ismax, 0
    br take_max -> L_MNX_MAX, L_MNX_MIN
L_MNX_MAX:
    cmpmax = sgt a, b
    br cmpmax -> L_MNX_T, L_MNX_F
L_MNX_MIN:
    cmpmin = slt a, b
    br cmpmin -> L_MNX_T, L_MNX_F
L_MNX_T:
    store slot+0, a as i32
    jmp L_MNX_END
L_MNX_F:
    store slot+0, b as i32
    jmp L_MNX_END
L_MNX_END:
    out = load slot+0 as i32
    !slot
    return out

// @ts_math_rounding 浮点取整（op 0=floor/1=ceil/2=round/3=trunc；移植
// saLowerMathRoundingFloat 全形：ceil 取负、round 先加 0.5、trunc 直转，
// fptosi + 负零碎调整块；整数操作数恒等留调用点）。
@ts_math_rounding(f: f64, op: i32) -> i32:
L_RND_ENTRY:
    is_ceil = eq op, 1
    br is_ceil -> L_RND_CNEG, L_RND_CCHK
L_RND_CNEG:
    fneg = fneg f
    farg = fadd fneg, 0.0
    negate = 1
    jmp L_RND_PRE
L_RND_CCHK:
    is_round = eq op, 2
    br is_round -> L_RND_RND, L_RND_PLAIN
L_RND_RND:
    fh = fadd f, 0.5
    farg = fadd fh, 0.0
    negate = 0
    jmp L_RND_PRE
L_RND_PLAIN:
    farg = fadd f, 0.0
    negate = 0
    jmp L_RND_PRE
L_RND_PRE:
    is_trunc = eq op, 3
    br is_trunc -> L_RND_TDIRECT, L_RND_CONV
L_RND_TDIRECT:
    tout = fptosi farg
    jmp L_RND_NEGCHK
L_RND_CONV:
    t = fptosi farg
    isneg = fcmp_lt farg, 0.0
    back = sitofp t
    isfrac = fcmp_ne farg, back
    need = and isneg, isfrac
    br need -> L_RND_ADJ, L_RND_NOADJ
L_RND_ADJ:
    dec = sub t, 1
    t = dec
    jmp L_RND_END
L_RND_NOADJ:
    t = t
    jmp L_RND_END
L_RND_END:
    tout = add t, 0
    jmp L_RND_NEGCHK
L_RND_NEGCHK:
    negout = ne negate, 0
    br negout -> L_RND_NEGATE, L_RND_PLAINOUT
L_RND_NEGATE:
    out = sub 0, tout
    jmp L_RND_DONE
L_RND_PLAINOUT:
    out = add tout, 0
    jmp L_RND_DONE
L_RND_DONE:
    return out
